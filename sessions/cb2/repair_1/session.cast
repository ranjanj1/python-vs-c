[345.413, "\u001b[H\u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51m order: `forward(token, pos)`.                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 245 +\u001b[38;2;51;51;51m  - FIXED and LOGITS: positions 0..n-1.                                                               \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m \u001b[14G- GENERATE: each forced prompt token, \u001b[53Ghe\u001b[56G each n\u001b[64Gw token.   \u001b[76G    \u001b[81G   \u001b[85G   \u001b[89G        \u001b[98G       \u001b[106G     \u001b[112G  \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m247\u001b[12G\u001b[38;2;51;51;51m- **Weight produc\u001b[30Gs:** one `cblas_sgemv`(Trans)\u001b[60Gper\u001b[64Gcolumn\u001b[71Gblock\u001b[77Gof\u001b[80Gthe\u001b[84Gtransposed,\u001b[96Gblocked\u001b[104Gweights.\u001b[113GT\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m   \u001b[12G\u001b[38;2;51;51;51mhere is no multi-positi\u001b[36Gn `sgemm`\u001b[46G     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G**Attention\u001b[26Gfor the \u001b[35Gurrent \u001b[43Gositio\u001b[50G:**   \u001b[57G    \u001b[62G   \u001b[66G      \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[12G\u001b[38;2;51;51;51m \u001b[14G- B\u001b[18Glow 160 keys: per-"]
[345.415, "h\u001b[38Gad `cbla\u001b[47G_sgemv`.    \u001b[60G   \u001b[64G      \u001b[71G     \u001b[77G  \u001b[80G   \u001b[84G           \u001b[96G       \u001b[104G        \u001b[113G \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m250\u001b[12G\u001b[38;2;51;51;51m  - From 160 keys: two `cblas_sgemm`\u001b[49Gcalls\u001b[55Gover\u001b[60Gthat\u001b[65Gone\u001b[69Gposition's\u001b[80Gheads\u001b[86G(block-diagonal\u001b[102Gqueries).\u001b[112GTh\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m   \u001b[12G\u001b[38;2;51;51;51mis still involves\u001b[30Gonly one query position.\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 251 \u001b[22m - **Element-wise work** uses vDSP/vForce or plain scalar C:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 252 \u001b[22m   - rmsnorm: `vDSP_svesq`\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 253 \u001b[22m   - softmax: `vDSP_maxv`, `vvexpf`, `vDSP_sve`, `vDSP_vsdiv`\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 248 -\u001b[38;2;51;51;51m  - SwiGLU: vDSP/vForce\u001b[48;2;255;199;199m, as described in change 2\u001b[48;2;255;220;220m                                                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 254 +\u001b[38;2;51;51;51m  - SwiGLU: vDSP/vForce                                        "]
[345.416, "                                       \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m5\u001b[16G\u001b[22mR\u001b[18GPE: scalar C, with a cos/sin table built from the reference's exact float expressions\r\u001b[5C\u001b[1B\u001b[2m 256 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 257 \u001b[22m   There are no hand-written matrix loops and no CPU intrinsics.\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[12G\u001b[22m-\u001b[14G**Single thread.** No threads are created and n\u001b[62G thr\u001b[67Gad counts are set.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 253 -\u001b[38;2;51;51;51m- **Memory.** KV cache\u001b[48;2;255;199;199m:\u001b[48;2;255;220;220m lazily zero-filled anonymous mappings\u001b[48;2;255;199;199m.\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mTokenizer\u001b[48;2;255;220;220m strings\u001b[48;2;255;199;199m:\u001b[48;2;255;220;220m one arena.\u001b[48;2;255;199;199m SwiGLU: 2\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m     -\u001b[38;2;51;51;51m\u001b[48;2;255;199;199m048-float tiles (round 3).\u001b[48;2;255;220;220m                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;2"]
[345.417, "20m 259 +\u001b[38;2;51;51;51m- **Memory.** \u001b[48;2;178;255;178mThe \u001b[48;2;220;255;220mKV cache \u001b[48;2;178;255;178muses \u001b[48;2;220;255;220mlazily zero-filled anonymous mappings\u001b[48;2;178;255;178m,\u001b[48;2;220;255;220m \u001b[48;2;178;255;178mand\u001b[48;2;220;255;220m \u001b[48;2;178;255;178mtokenizer \u001b[48;2;220;255;220mstrings \u001b[48;2;178;255;178mlive in \u001b[48;2;220;255;220mo\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m     +\u001b[38;2;51;51;51mne arena.                                                                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 260 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 261 \u001b[22m ## Interface choices where INTERFACE.md is silent (unchanged from v1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 262 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39mBackground\u001b[14Gcommand\u001b[22G\"A/B\u001b[27Gblock\u001b[33Gwidths\u001b[40Gfor\u001b[44Gsgemv-only\u001b[55Gbuild\"\u001b[62Gcompleted\u001b[72G(exit\u001b[78Gcode\u001b[83G0)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gcaps\u001b[14Gof\u001b[17G256,\u001b[22G"]
