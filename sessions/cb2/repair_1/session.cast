[321.985, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm swapping \u001b[38;2;87;105;247mforward_chunk\u001b[39m for a si\u001b[39Ggle-token \u001b[38;2;87;105;247mforward(token, pos)\u001b[39m built on \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m, c\u001b[93Glled once\u001b[103Gper\u001b[107Gposition.\u001b[117GThe\r\u001b[2C\u001b[1Bonly\u001b[8G\u001b[38;2;87;105;247mcblas_sgemm\u001b[20G\u001b[39mleft\u001b[25Gis\u001b[28Gin\u001b[31Glong-context\u001b[44Gattention,\u001b[55Gand\u001b[59Git\u001b[62Ghandles\u001b[70Gone\u001b[74Gquery\u001b[80Gposition\u001b[89Gat\u001b[92Ga\u001b[94Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth checks\u001b[15Gpass. Th\u001b[24G scratch directory in /tmp has been\u001b[60Gcl\u001b[63Gared,\u001b[69Gso\u001b[72GI'll\u001b[77Grun\u001b[81Gthe\u001b[85Gsaved\u001b[91Gcopies\u001b[98Gin\u001b[101G\u001b[38;2;87;105;247mprof/\u001b[107G\u001b[39minstead\u001b[115Gand\r\u001b[2C\u001b[1Brebuild\u001b[11Gthe\u001b[15Gv1\u001b[18Greference\u001b[28Gbinaries\u001b[37Gthe\u001b[41Gcomparison\u001b[52Gscripts\u001b[60Gneed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \r\u001b[1B\u001b["]
[321.986, "39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe compa\u001b[13Gison\u001b[18Gscripts relied \u001b[34Gn v1\u001b[39Gbinaries lost wi\u001b[56Gh th\u001b[61G deleted /tmp directory, so I'm writing\u001b[101Ga\u001b[103Gdriver,\r\u001b[2C\u001b[1Bprof/refdrv.c,\u001b[18Gthat\u001b[23Gcompares\u001b[32Glogits\u001b[39Gand\u001b[43GENCODE\u001b[50Goutput\u001b[57Gdirectly\u001b[66Gagainst\u001b[74Gthe\u001b[78Gsupplied\u001b[87Greference.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the reference wi\u001b[34Gin 3.1e-5 across 300 posi\u001b[60Gions with argmax\u001b[77Gagreeing\u001b[86Geverywhere,\u001b[98Gand\u001b[102GENCODE\u001b[109Gmatches\u001b[117Gon\r\u001b[2C\u001b[1Ball\u001b[7G313\u001b[11Gtexts.\u001b[18GNext\u001b[23GI'll\u001b[28Grun\u001b[32Gthe\u001b[36Gremaining\u001b[46Ginterface\u001b[56Gtests\u001b[62Gand\u001b[66Gtiming.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery interface test passes, and e\u001b[38Gch\u001b[41GLOGITS/FIXED pos\u001b[58Gtion now\u001b[67Gcost\u001b[72G one d\u001b[79Gcod\u001b[83G step, so\u001b[93Gthe timings rise: fixture\r\u001b[2C\u001b[1BLOGITS went from 95 ms to\u001b[29G1.70 s, and FIXED "]
[321.987, "with 1024 ids takes 9.3 s.\u001b[74GSince every\u001b[86Gweight\u001b[93Gproduct\u001b[101Gis\u001b[104Gan\u001b[107G\u001b[38;2;87;105;247msgemv\u001b[113G\u001b[39mnow,\r\u001b[2C\u001b[1BI'll\u001b[8GA/B\u001b[12Gthe\u001b[16Gblock\u001b[22Gwidths\u001b[29Gfor\u001b[33Gthat\u001b[38Grather\u001b[45Gthan\u001b[50Greuse\u001b[56Gthe\u001b[60G\u001b[38;2;87;105;247msgemm\u001b[66G\u001b[39msetting\u001b[74Gof\u001b[77G256.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B A/B block widths for sgemv-only build\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's|/tmp/cb2t/dev.py|/Users/agentla\u001b[53G/pvc/\u001b[61G/pro\u001b[66G/dev.py|' prof/ab.py\u001b[87G&& for bm in 256 384 512; do\u001b[116Gcc \r\u001b[5C\u001b[1B-O3 -mcpu=native -DBLOCK_MAX=$bm -o \u001b[43Gtmp/c\u001b[49G2t/bm$b\u001b[58Gcb2.c -framework Accelerate; done && python3 prof/ab.py 4 \r\u001b[5C\u001b[1B/tmp/c\u001b[13G2\u001b[15G/bm256 /tmp/cb2t/bm384 /tmp/cb2t/bm512\u001b[39m\u001b[40;1H\u001b[38;3H"]
