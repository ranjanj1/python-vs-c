[323.617, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm\u001b[7Gswapping\u001b[16G\u001b[38;2;87;105;247mforward_chunk\u001b[30G\u001b[39mfor\u001b[34Ga\u001b[36Gsingle-token\u001b[49G\u001b[38;2;87;105;247mforward(token, pos)\u001b[69G\u001b[39mbuilt\u001b[75Gon\u001b[78G\u001b[38;2;87;105;247mcblas_sgemv\u001b[39m,\u001b[91Gcalled\u001b[98Gonce\u001b[103Gper\u001b[107Gposition.\u001b[117GThe\r\u001b[1B \u001b[3Gonly \u001b[38;2;87;105;247mcblas_sgemm\u001b[39m left is in long-co\u001b[39Gtext attention, and it handles one query position at \u001b[93G time.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Gchecks\u001b[15Gpass.\u001b[21GThe\u001b[25Gscratch\u001b[33Gdirectory\u001b[43Gin\u001b[46G/tmp\u001b[51Ghas\u001b[55Gbeen\u001b[60Gcleared,\u001b[69Gso\u001b[72GI'll\u001b[77Grun\u001b[81Gthe\u001b[85Gsaved\u001b[91Gcopies\u001b[98Gin\u001b[101G\u001b[38;2;87;105;247mprof/\u001b[107G\u001b[39minstead\u001b[115Gand\r\u001b[1B \u001b[3Grebuild the\u001b[15Gv1 refer\u001b[24Gnce binaries the comparison scripts\u001b[60Gne\u001b[63Gd.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \r\u001b[2C\u001b[1B\u001b[3"]
[323.617, "9m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcomparison\u001b[18Gscripts\u001b[26Grelied\u001b[33Gon\u001b[36Gv1\u001b[39Gbinaries\u001b[48Glost\u001b[53Gwith\u001b[58Gthe\u001b[62Gdeleted\u001b[70G/tmp\u001b[75Gdirectory,\u001b[86Gso\u001b[89GI'm\u001b[93Gwriting\u001b[101Ga\u001b[103Gdriver,\r\u001b[1B \u001b[3Gprof/refd\u001b[13Gv.c,\u001b[18Gthat compares l\u001b[34Ggits\u001b[39Gand ENCODE outpu\u001b[56G dir\u001b[61Gctly against the supplied reference.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits\u001b[10Gmatch\u001b[16Gthe\u001b[20Greference\u001b[30Gwithin\u001b[37G3.1e-5\u001b[44Gacross\u001b[51G300\u001b[55Gpositions\u001b[65Gwith\u001b[70Gargmax\u001b[77Gagreeing\u001b[86Geverywhere,\u001b[98Gand\u001b[102GENCODE\u001b[109Gmatches\u001b[117Gon\r\u001b[1B \u001b[3Gall 313 texts. Next I'll run \u001b[34Ge remaining interface tes\u001b[60Gs and timing.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery\u001b[9Ginterface\u001b[19Gtest\u001b[24Gpasses,\u001b[32Gand\u001b[36Geach\u001b[41GLOGITS/FIXED\u001b[54Gposition\u001b[63Gnow\u001b[67Gcosts\u001b[73Gone\u001b[77Gdecode\u001b[84Gstep,\u001b[90Gso\u001b[93Gthe\u001b[97Gtimings\u001b[105Grise:\u001b[111G"]
[323.618, "fixture\r\u001b[1B \u001b[3GLOGITS went from 95 ms to 1.70 s, \u001b[38Gnd\u001b[41GFIXED with 1024 \u001b[58Gds takes\u001b[67G9.3 \u001b[72G. Sinc\u001b[79G ev\u001b[83Gry weight\u001b[93Gproduct is an \u001b[38;2;87;105;247msgemv\u001b[39m now,\u001b[K\r\u001b[2C\u001b[1BI'll A/B the block widths\u001b[29Gfor that rather than reuse the \u001b[38;2;87;105;247msgemm\u001b[39m setting\u001b[74Gof 256.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m While that runs in the background, I'll update NOTES.md to match the batch-size-1 design.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mGenerating\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
