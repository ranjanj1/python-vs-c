[377.161, "\u001b[H\u001b[3G- The chunked \u001b[38;2;87;105;247mforward_chunk\u001b[39m is\u001b[34Ggon\u001b[38G; in its\u001b[47Gplace\u001b[53Gis\u001b[56G\u001b[38;2;87;105;247mforward(token, pos)\u001b[39m,\u001b[77Ga\u001b[79Gsingle\u001b[86Gforward\u001b[94Gpass\u001b[99Gfor\u001b[103Gone\u001b[107Gposition.\r\u001b[4C\u001b[1BEvery\u001b[11Gweight\u001b[18Gproduct\u001b[26Gis\u001b[29Ga\u001b[31G\u001b[38;2;87;105;247mcblas_sgemv\u001b[39m,\u001b[44Gand\u001b[48Gthat\u001b[53Gposition's\u001b[64GK\u001b[66Gand\u001b[70GV\u001b[72Ggo\u001b[75Gstraight\u001b[84Ginto\u001b[89Gits\u001b[93Grow\u001b[97Gof\u001b[100Gthe\u001b[104GKV\u001b[107Gcache.\r\u001b[2C\u001b[1B- \u001b[1mFIXED and LOGITS\u001b[22m forward\u001b[30Gpositions\u00a00..n-1\u001b[47Gin\u001b[50Gorder.\u001b[57GAfter\u001b[63Geach\u001b[68Gpass\u001b[73Gthey\u001b[78Gtake\u001b[83Gthat\u001b[88Gposition's\u001b[99Gargmax\u001b[106Gor\u001b[109Gwrite\u001b[115Gits\r\u001b[2C\u001b[1B \u001b[5Glogits.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGENERATE\u001b[22m forwa\u001b[20Gds each prompt token one at\u001b[48Ga time, then each\u001b[66Gnew\u001b[70Gtoken, the same way \u001b[91Ghe referenc\u001b[103G's generate\u001b[115Gloop\r\u001b[2C\u001b[1B \u001b[5Gdoes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI removed\u001b[15Geverything\u001b[26Gthat\u001b[31Gexisted\u001b[39Gonly\u001b[44Gfor\u001b[48Gbatching:\u001b[58Gthe\u001b[62Gmulti-position\u001b[77Gbuffers,\u001b[86Gthe\u001b[90Gmulti-row\u001b[100Gattention,\u001b[111Gand\u001b["]
[377.163, "115Gthe\r\u001b[2C\u001b[1B \u001b[5Gmulti-row \u001b[38;2;87;105;247msgemm\u001b[39m path.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOn\u001b[8G \u001b[38;2;87;105;247mcblas_sgemm\u001b[21G\u001b[39mremains,\u001b[30Gin\u001b[33Gattention\u001b[43Gfrom\u001b[48G160\u001b[52Gpositions\u001b[62Gonward.\u001b[70GIt\u001b[73Ghandles\u001b[81Gonly\u001b[86Gthe\u001b[90Gcurrent\u001b[98Gposition's\u001b[109Gheads\r\u001b[2C\u001b[1B \u001b[5Gagainst th\u001b[16G cached keys and values, so\u001b[44Gn\u001b[46G other positions take \u001b[69Gart.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerification\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI \u001b[8Gdded\u001b[13G\u001b[38;2;87;105;247mprof/refdrv.c\u001b[39m, a test driver that\u001b[47Gcompiles the unmodified \u001b[38;2;87;105;247mreference/run.c\u001b[87G\u001b[39mand\u001b[91Gcalls\u001b[97Gits\u001b[101Gown\u001b[105G\u001b[38;2;87;105;247mforward()\u001b[115G\u001b[39mand\r\u001b[4C\u001b[1B\u001b[38;2;87;105;247mencode()\u001b[39m.\u001b[15G\u001b[38;2;87;105;247mprof/cmpref.py\u001b[30G\u001b[39muses\u001b[35Git\u001b[38Gto\u001b[41Gcompare\u001b[49Gagainst\u001b[57Gthe\u001b[61Greference.\r\u001b[2C\u001b[1B- \u001b[1mLOGITS:\u001b[22m over\u001b[18G300\u001b[22Gpositions\u001b[32Gthe\u001b[36Glargest\u001b[44Gdifference\u001b[55Gis\u001b[58G3.1e-5,\u001b[66Gand\u001b[70Gthe\u001b[74Gargmax\u001b[81Gmatches\u001b[89Gat\u001b[92Gall\u00a0300.\r\u001b[4C\u001b[1B\u001b[1mENCODE:\u001b[13G\u001b[22midentical on all\u001b[3"]
[377.164, "0G313 test tex\u001b[43Gs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPIECE and edge cases:\u001b[22m PIECE fix\u001b[37Gures, FIXED/GENERATE consistency, \u001b[38;2;87;105;247mcontext\u001b[79G\u001b[39mstopping\u001b[88Gand\u001b[92Gedge\u001b[97Gcases\u001b[103Gall\u001b[107Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPerformance cost:\u001b[22m each\u001b[26Gposition now\u001b[39Gcos\u001b[44G one\u001b[49Gfull\u001b[54Gread\u001b[59Gof\u001b[62Gthe\u001b[66Gweights,\u001b[75Gabout\u001b[81G7.3\u001b[85Gms\u001b[88Gon\u001b[91Gthis\u001b[96GM1.\u001b[100GThat\u001b[105Gis\u001b[108Gthe\u001b[112Gfloor\u001b[118Gfor\r\u001b[2C\u001b[1Bbatch size 1 with float32 weights. Block widths of 256, 384 and 512\u001b[71Gmeasured \u001b[81Ghe same, so I kept 256.\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502    \u001b[9G  Workload \u001b[21G     \u2502 Before (chunked, \u001b[46Gnvalid)\u001b[54G\u2502   \u001b[59G   \u001b[63G   \u001b[67G   \u001b[71G   Now (batc"]
[377.166, "h size\u001b[90G1)\u001b[93G \u001b[95G    \u001b[100G    \u001b[112G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764        \u2502 1454 ms                   \u2502 about 1680 ms (prompt tokens now cost a full step each) \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73 / FIXED \u00d73 \u2502 about 95 ms               \u2502 about 1.70 s                                            \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
