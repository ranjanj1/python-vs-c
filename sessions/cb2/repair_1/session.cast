[377.504, "\u001b[H\u001b[3G \u001b[5GEv\u001b[8Gry weight product is a\u001b[31G\u001b[38;2;87;105;247mcblas_sgemv\u001b[39m, and that\u001b[53Gposition's K and V go straight int\u001b[88G its row of the KV\u001b[107Gcache.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFIXED and LOGITS\u001b[22m forward positions\u00a00..n-1 in order. After each pass they take tha\u001b[87G positi\u001b[95Gn's argmax or write\u001b[115Gits\r\u001b[2C\u001b[1B \u001b[5Glogits.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGENERATE\u001b[14G\u001b[22mforwards\u001b[23Geach\u001b[28Gprompt\u001b[35Gtoken\u001b[41Gone\u001b[45Gat\u001b[48Ga\u001b[50Gtime,\u001b[56Gthen\u001b[61Geach\u001b[66Gnew\u001b[70Gtoken,\u001b[77Gthe\u001b[81Gsame\u001b[86Gway\u001b[90Gthe\u001b[94Greference's\u001b[106Ggenerate\u001b[115Gloop\r\u001b[2C\u001b[1B \u001b[5Gdoes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI removed\u001b[15Geverything\u001b[26Gthat\u001b[31Gexisted\u001b[39Gonly\u001b[44Gfor\u001b[48Gbatching:\u001b[58Gthe\u001b[62Gmulti-position\u001b[77Gbuffers,\u001b[86Gthe\u001b[90Gmulti-row\u001b[100Gattention,\u001b[111Gand\u001b[115Gthe\r\u001b[2C\u001b[1B \u001b[5Gmulti-row\u001b[15G\u001b[38;2;87;105;247msgemm\u001b[39m path.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOne \u001b[38;2;87;105;247mcblas_\u001b[21G\u001b[39mremains,\u001b[30Gin\u001b[33Gattention\u001b[43Gfrom\u001b[48G160\u001b[52Gpositions\u001b[62Gonward.\u001b[70GIt\u001b[73Ghandles\u001b[81Gonly\u001b[86Gthe\u001b[90Gcurrent\u001b[98Gposition's\u001b[109Ghea"]
[377.506, "ds\r\u001b[2C\u001b[1B \u001b[5Gagainst the cached key\u001b[28G and\u001b[33Gvalues, so n\u001b[46G other positions take par\u001b[72G.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mVerification\r\u001b[2C\u001b[1B\u001b[22m- I added \u001b[38;2;87;105;247mprof/refdrv.c\u001b[39m,\u001b[28Ga\u001b[30Gtest\u001b[35Gdriver\u001b[42Gthat\u001b[47Gcompiles\u001b[56Gthe\u001b[60Gunmodified\u001b[71G\u001b[38;2;87;105;247mreference/run.c\u001b[87G\u001b[39mand\u001b[91Gcalls\u001b[97Gits\u001b[101Gown\u001b[105G\u001b[38;2;87;105;247mforward()\u001b[115G\u001b[39mand\r\u001b[2C\u001b[1B \u001b[5G\u001b[38;2;87;105;247mencode()\u001b[39m. \u001b[38;2;87;105;247mprof/cmpref.py\u001b[30G\u001b[39muses\u001b[35Git to compare again\u001b[55Gt the reference.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLOGITS:\u001b[22m over 300 positions the largest difference is 3.1e-5, a\u001b[68Gd the\u001b[74Gargmax\u001b[81Gmatches\u001b[89Gat\u001b[92Gall\u00a0300.\r\u001b[4C\u001b[1B\u001b[1mENCODE\u001b[13G\u001b[22mid\u001b[16Gntical \u001b[24Gn all 313 test t\u001b[41Gx\u001b[43Gs.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPIECE and edge cases:\u001b[22m PIECE fixtures, FIXED/GENERATE\u001b[58Gconsistency,\u001b[71G\u001b[38;2;87;105;247mcontext\u001b[79G\u001b[39mstopping\u001b[88Gand\u001b[92Gedge\u001b[97Gcases\u001b[103Gall\u001b[107Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mPerformance cost:\u001b[21G\u001b[22meach\u001b[26Gposition\u001b[35Gnow\u001b[39Gcos"]
[377.508, "ts\u001b[45Gone\u001b[49Gfull\u001b[54Gread\u001b[59Gof\u001b[62Gthe\u001b[66Gweights,\u001b[75Gabout\u001b[81G7.3\u001b[85Gms\u001b[88Gon\u001b[91Gthis\u001b[96GM1.\u001b[100GThat\u001b[105Gis\u001b[108Gthe\u001b[112Gfloor\u001b[118Gfor\r\u001b[2C\u001b[1Bbatch size 1 with\u001b[21Gfloat32 we\u001b[32Gghts. Bl\u001b[41Gck widths of\u001b[54G256,\u001b[59G384 and 512 measured the same, so I kept\u001b[100G256.\u001b[105G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502       Workload       \u2502 Before (chunked, invalid) \u2502                   Now (batch size 1)                    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[377.509, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764        \u2502 1454 ms                   \u2502 about 1680 ms (prompt tokens now cost a full step each) \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73 / FIXED \u00d73 \u2502 about 95 ms               \u2502 about 1.70 s                                            \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524"]
