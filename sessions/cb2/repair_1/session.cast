[363.132, "\u001b[H\u001b[7G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m65\u001b[11G\u001b[38;2;51;51;51m-------------------------------------------------------------------------------------------------------\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m  \u001b[11G\u001b[38;2;51;51;51m--     \u001b[19G    \u001b[24G   \u001b[28G \u001b[30G   \u001b[34G  \u001b[37G \u001b[39G    \u001b[44G \u001b[46G \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m66\u001b[11G\u001b[38;2;51;51;51m \u001b[13G    \u001b[18G  \u001b[21G     \u001b[27G     \u001b[33G              \u001b[48G        \u001b[57G \u001b[59G \u001b[61G \u001b[63G  \u001b[66G \u001b[68G  \u001b[71G  \u001b[74G \u001b[76G  \u001b[79G \u001b[81G   \u001b[85G \u001b[87G   \u001b[91G  \u001b[94G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 67 \u001b[22m ## Round 3: profiling and optimisation\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 68 \u001b[22m \u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m69\u001b[11G\u001b[38;2;51;51;51m*(Historical.\u001b[25GThe\u001b[29Gchunked\u001b[37Gprefill\u001b[45Gdescribed\u001b[55Gin\u001b[58Grounds\u001b[65G1\u20133\u001b[69Gviolated\u001b[78Grule\u001b[83G1\u001b[85Gand\u001b[89Gwas\u001b[93Gremoved\u001b[101Gin\u001b[104Ground\u001b[110G4.\u001b[113GP\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m  \u001b[11G\u001b[38;2;51;51;51mrefill, LOGITS and\u001b[30GFIXED figures in these sec\u001b[57Gions are\u001b[66Gnot valid results.)*    \u001b[91G \u001b[93G"]
[363.133, "    \u001b[98G     \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m70\r\u001b[5C\u001b[1B\u001b[49m\u001b[38;2;51;51;51m\u001b[2m 71 \u001b[22m The workloads are the same supplied fixtures, run with `prof/dev.py` and `prof/ab.py` (alternating bina\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m ries, medians) as in round 2. I also used `prof/ttft.py` to measure time to first token against decode \r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m step time for the 3 fixture prompts.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 72 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 73 \u001b[22m ### Environment finding\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mUpdating build notes, final rebuild and checks\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/^python3 check.py --tokens 64 --prompts 3 -- .\\/cb2 # PASS (max logit err ~2.6e-5)/python3 check.py \r\u001b[5C\u001b[1B--tokens 64 --prompts 3 -- .\\/cb2 # PASS (max logit err ~2.4e-5)\\ncc -O2 -o \\/tmp\\/cb2t\\/refdrv prof\\/refdrv.c -lm \r\u001b[5C\u001b[1B\\&\\& python3 prof\\/cmpref.py 300 # vs supplied reference: max diff 3.\u2026\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[363.133, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mUpdate build notes, final rebuild and checks\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22msed -i '' 's/^python3 check.py --tokens 64 --prompts 3 -- .\\/cb2 "]
[363.134, " # PASS (max logit err ~2.6e-5)/python3 check.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m--tokens 64 --prompts 3 -- .\\/cb2  # PASS (max logit err ~2.4e-5)\\ncc -O2 -o \\/tmp\\/cb2t\\/refdrv prof\\/refdrv.c\u001b[116G-lm\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\\&\\& python3 prof\\/cmpref.py 300   # vs supplied reference: max diff 3.1e-5, argmax 300\\/300, ENCODE 0 mismatches/'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mNOTES.md && sed -n 9,14p NOTES.md && ./build.sh\u001b[52G&&\u001b[55Gpython3\u001b[63Gcheck.py\u001b[72G--\u001b[75G./cb2\u001b[81G|\u001b[83Gtail\u001b[88G-1\u001b[91G&&\u001b[94Gpython3\u001b[102Gcheck.py\u001b[111G--tokens\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m64 --prompts\u001b[17G3\u001b[19G--\u001b[22G./cb2\u001b[28G|\u001b[30Gtail\u001b[35G-1\u001b[38G&&\u001b[41Ggrep\u001b[46G-c\u001b[49G\"forward_chunk\\|CHUNK\"\u001b[72Gcb2.c\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[363.135, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1m./build.sh, python3 check.py -- ./cb2\u001b[22m, and \u001b[1mpython3 check.py --tokens 64 --prompts 3 \r\u001b[6C\u001b[1B-- ./cb2\u001b[16G\u001b[22mcommands\u001b[25Gin\u001b[28G\u001b[1m/Users/agentlab/pvc/cb2\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
