[361.247, "\u001b[H     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mhere\u001b[17Gis\u001b[20Gno\u001b[23Gmulti-position\u001b[38G`sgemm`.\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 248 +\u001b[38;2;51;51;51m- **Attention for the current position:**\u001b[54G \u001b[56G      \u001b[63G  \u001b[66G \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 249 +\u001b[38;2;51;51;51m  - Below\u001b[22G160\u001b[26Gkeys:\u001b[32Gper-head\u001b[41G`cblas_sgemv`.\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 250 +\u001b[38;2;51;51;51m  - From 160 keys: two `cblas_sgemm`\u001b[49Gcalls\u001b[55Gover\u001b[60Gthat\u001b[65Gone\u001b[69Gposition's\u001b[80Gheads\u001b[86G(block-diagonal\u001b[102Gqueries).\u001b[112GTh\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m     +\u001b[38;2;51;51;51mis\u001b[15Gstill involves only one\u001b[39Gquery position.    \u001b[59G  \u001b[62G \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 251 \u001b[22m - **Element-wise work** uses vDSP/vForce or plain scalar C:\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 252 \u001b[22m   - rmsnorm: `vDSP_svesq`\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b["]
[361.247, "2m 253 \u001b[22m   - softmax: `vDSP_maxv`, `vvexpf`, `vDSP_sve`, `vDSP_vsdiv`\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 248 -\u001b[38;2;51;51;51m  - SwiGLU: vDSP/vForce\u001b[48;2;255;199;199m, as described in change 2\u001b[48;2;255;220;220m                                                     \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 254 +\u001b[13G\u001b[38;2;51;51;51m -\u001b[16GSwiGLU:\u001b[24GvDSP/vForce   \u001b[39G  \u001b[42G                \u001b[59G        \u001b[68G  \u001b[71G  \u001b[74G   \u001b[78G   \u001b[82G \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 255 \u001b[22m   - RoPE: scalar C, with a cos/sin table built from the reference's exact float expressions\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 256 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 257 \u001b[22m   There are no hand-written matrix loops and no CPU intrinsics.\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 258 \u001b[22m - **Single thread.** No threads are created and no thread counts are set.\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 253 -\u001b[38;2;51;51;51m- **Memory.** KV cache\u001b[48;2;"]
