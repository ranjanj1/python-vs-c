[360.5, "                               \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m60\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 261 \u001b[22m ## Interface choices where INTERFACE.md is silent (unchanged from v1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 262 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39mBackground command \"A/B block widths for sgemv-only build\" completed (exit code\u001b[83G0)\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gcaps\u001b[14Gof\u001b[17G256,\u001b[22G384\u001b[26Gand\u001b[30G512\u001b[34Gperform\u001b[42Gthe\u001b[46Gsame\u001b[51Gwithin\u001b[58Gnoise\u001b[64Gon\u001b[67Gthe\u001b[71Gsequential\u001b[82Gbuild,\u001b[89Gand\u001b[93Gthe\u001b[97Gload\u001b[102Goutliers\u001b[111Gcome\u001b[116Gfrom\r\u001b[2C\u001b[1Bmemory pressure.\u001b[20GI'm\u001b[24Gkeeping\u001b[32G256\u001b[36Gand\u001b[40Gwriting\u001b[48Gup\u001b[51GRound\u001b[57G4\u001b[59Gnext.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.\u001b[17Gd)\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
