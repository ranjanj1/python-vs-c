[115.203, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm\u001b[7Gswapping\u001b[16G\u001b[38;2;87;105;247mforward_chunk\u001b[30G\u001b[39mfor\u001b[34Ga\u001b[36Gsingle-token\u001b[49G\u001b[38;2;87;105;247mforward(token, pos)\u001b[69G\u001b[39mbuilt\u001b[75Gon\u001b[78G\u001b[38;2;87;105;247mcblas_sgemv\u001b[39m,\u001b[91Gcalled\u001b[98Gonce\u001b[103Gper\u001b[107Gposition.\u001b[117GThe\r\u001b[1B \u001b[3Gonly \u001b[38;2;87;105;247mcblas_sgemm\u001b[39m left is in long-context\u001b[44Gattention,\u001b[55Gand\u001b[59Git\u001b[62Ghandles\u001b[70Gone\u001b[74Gquery\u001b[80Gposition\u001b[89Gat\u001b[92Ga\u001b[94Gtime.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Both checks pass. The scratch directory in /tmp has been cleared, so I'll run the saved copies in \u001b[38;2;87;105;247mprof/\u001b[39m instead and\u001b[K\r\u001b[2C\u001b[1Brebuild\u001b[11Gthe\u001b[15Gv1\u001b[18Greference\u001b[28Gbinaries\u001b[37Gthe\u001b[41Gcomparison\u001b[52Gscripts\u001b[60Gneed.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe comparison scripts relied on v1 binaries\u001b[48Glost\u001b[53Gwith\u001b[58Gthe\u001b[62Gdeleted\u001b[70G/tmp\u001b[75Gdirectory,\u001b[86Gso\u001b"]
[115.205, "[89GI'm\u001b[93Gwriting\u001b[101Ga\u001b[103Gdriver,\r\u001b[2C\u001b[1Bprof/refdrv.c,\u001b[18Gthat\u001b[23Gcompares\u001b[32Glogits\u001b[39Gand\u001b[43GENCODE\u001b[50Goutput\u001b[57Gdirectly\u001b[66Gagainst\u001b[74Gthe\u001b[78Gsupplied\u001b[87Greference.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the reference\u001b[30Gwithin\u001b[37G3.1e-5\u001b[44Gacross\u001b[51G300\u001b[55Gpositions\u001b[65Gwith\u001b[70Gargmax\u001b[77Gagreeing\u001b[86Geverywhere,\u001b[98Gand\u001b[102GENCODE\u001b[109Gmatches\u001b[117Gon\r\u001b[2C\u001b[1Ball\u001b[7G313\u001b[11Gtexts.\u001b[18GNext\u001b[23GI'll\u001b[28Grun\u001b[32Gthe\u001b[36Gremaining\u001b[46Ginterface\u001b[56Gtests\u001b[62Gand\u001b[66Gtiming.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mInterface tests and timings for \u001b[36Gequ\u001b[40Gntial build\u001b[52G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 prof/t.py && python3 prof/ctx.py && cp cb2 /tmp/cb2t/v4 && for i in 1 2 3; do python3 prof/dev.py \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m/tmp/cb2t/v4; done && python3 prof/ttft.py /tmp/cb2t/v4\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[115.205, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mInterface tests and timings for sequential build\u001b[51G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3 prof/t.py && python3 prof/ctx.py && cp cb2 /tmp/cb2t/v4 && for i in 1 2 3; do python3 prof/dev.py\r"]
