[0.84, "\u001b[61Gsizes;\u001b[68GI\u001b[70Gkept\u001b[75Git\u001b[78Gbecause\u001b[86Git's\u001b[91Gnever\u001b[97Gslower.\r\u001b[2C\u001b[2B\u001b[1mFinal numbers (medians of 5 alternating runs)\r\u001b[2C\u001b[2B\u001b[22m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[7GWorkload\u001b[19G\u2502\u001b[30Gv2\u001b[42G\u2502\u001b[53Gv3\u001b[65G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GLoad\u001b[10Gto\u001b[13GREADY\u001b[19G\u2502\u001b[21G104.5\u001b[27Gms\u001b[42G\u2502\u001b[44G95.3\u001b[49Gms\u001b[65G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GGENERATE\u001b[14G3\u00d764\u001b[19G\u2502\u001b[21G1454\u001b[26Gms\u001b[29G(\u2248132\u001b[35Gtok/s)\u001b[42G\u2502\u001b[44G1454\u001b[49Gms\u001b[52G(\u2248132\u001b[58Gtok/s)\u001b[65G"]
