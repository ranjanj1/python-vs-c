[75.468, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mn=int(sys.argv[1])\u001b[23Gif\u001b[26Glen(sys.argv)>1\u001b[42Gelse\u001b[47G300\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m i\u001b[6Gs=[1]+[(i*7919)%31000+500 for i in range(n-1)]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m subprocess.run([REF,M,TK,'logits','/tmp/cb2t/ref.f32']+list(map(str,ids)),check=True)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp=subprocess.Popen(['./cb2',M,TK],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True);\u001b[95Gp.stdout.readline()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p.stdin.write('LOGITS /tmp/cb2t/cb2.f32 '+' '.join(map(str,ids))+'\\n');\u001b[76Gp.\u001b[80Gdin.flush();\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m pr\u001b[7Gnt(p.stdout.readline().stri\u001b[35G())\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ma=array.array('f');\u001b[24Ga.frombytes(open('/tmp/cb2t/ref.f32','rb').read())\r\u001b[1B \u001b[2m\u2502\u001b[22m b=array.array('f'); b.frombytes(open('/tmp/cb2t/cb2.f32','rb').read())\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mV=len(a)//n;\u001b[17Gworst=max(max(abs(a[i]-b[i])\u001b[46Gfor\u001b[50Gi\u001b[52Gin\u001b[55Grange(r*V,(r+1)*V))\u001b[75Gfor\u001b[79Gr\u001b[81Gin\u001b[84Grange(n))\r\u001b[1B \u001b[2m\u2502\u001b[22m am_a=[max(range(V),key=lambda j:a[r*V+j]) for r in range(n)]; am_b=[max(ra"]
[75.469, "nge(V),key=lambda j:b[r*V+j]) for r in\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m range(n)]\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m print(f'LOGITS vs reference over {n} positions: max abs diff {worst:.3g}, argmax agreement {sum(x==y for x,y in\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mzip(am_a,am_b))}/{n}')\r\u001b[1B \u001b[2m\u2502\u001b[22m random.seed(7)\u001b[19G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m words=['the','a','Li\u001b[25Gy',' ','  ','dog','ball','!','?','12345','na\u00efve','c\u001b[77Gf\u00e9','\u65e5\u672c\u8a9e','\ud83d\ude00','\\t','\u00fcn\u00efc\u00f6d\u00e9','x'*30,'aa\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22maa','<0x41>','ab','...',',','\u03a9']\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m fx=json.load(open('fixtures.json'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtexts=[t\u001b[13Gfor\u001b[17Gt\u001b[19Gin\u001b[22Gfx['tokenizer']\u001b[38Gif\u001b[41Gt]+[q['text']\u001b[55Gfor\u001b[59Gq\u001b[61Gin\u001b[64Gfx['prompts']]\r\u001b[1B \u001b[2m\u2502\u001b[22m texts+=[''.join(random.choice(words)+random.choice(['',' ']) for\u001b[69G_ \u001b[72Gn ra\u001b[77Gge(random.randint(1,60)))\u001b[103Gfo\u001b[107G_ in\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m range(300)]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtexts+=['\u001b[14G'.join(['dog']*900),\u001b[35G'Once\u001b[41Gupon\u001b[46Ga\u001b[48Gtime,\u001b[54Gthere\u001b[60Gwas\u001b[64Ga\u001b[66Glittle\u001b[73G"]
[75.471, "girl\u001b[78Gnamed\u001b[84GLily.\u001b[90G'*40]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m r=subprocess.run([REF,M,TK,'encode'],input=''.join(t+'\\n'\u001b[62Gfor\u001b[66Gt\u001b[68Gin\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtexts),capture_output=True,text=True).stdout.splitlines()\r\u001b[1B \u001b[2m\u2502\u001b[22m bad=0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for t,want\u001b[15Gin\u001b[18Gzip(t\u001b[24Gxts,r):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write('ENCODE\u001b[30G'+t+'\\n');\u001b[41Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     if p.stdout.readline().rstrip('\\n')!=want:\u001b[51Gbad+=1;\u001b[59Gprint('MISMATCH',repr(t[:50]))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f'ENCODE\u001b[19Gvs\u001b[22Greference:\u001b[33G{len(texts)}\u001b[46Gtexts,\u001b[53G{bad}\u001b[59Gmismatches')\r\u001b[1B \u001b[2m\u2502\u001b[22m p.stdin.write('QUIT\\n'); p.stdin.flush(); p.wai\u001b[52G()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/cmpref.py\u001b[27G300\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
