[360.501, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mNOTES.md\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[360.515, "\u001b[H\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 47 +\u001b[38;2;51;51;51m                                                                                                                   \r\u001b[1B\u001b[38;2;36;138;61m 48 +\u001b[38;2;51;51;51m| workload | round 3 (chunked, invalid) | round 4 (batch 1) |                                                      \r\u001b[1B\u001b[38;2;36;138;61m 49 +\u001b[38;2;51;51;51m|---|---|---|                                                                                                      \r\u001b[1B\u001b[38;2;36;138;61m 50 +\u001b[38;2;51;51;51m| GENERATE 3\u00d764 | 1454 ms | 1672\u20131686 ms |                                                                         \r\u001b[1B\u001b[38;2;36;138;61m 51 +\u001b[38;2;51;51;51m| LOGITS \u00d73 (69/79/82 positions)\u001b[39G|\u001b[41G95\u001b[44Gms\u001b[47G|\u001b[49G1695\u20131706\u001b[59Gms\u001b[62G|\u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 52 +\u001b[38;2;51;51;51m| FIXED \u00d73 | 92 ms | 1690\u20131699 ms |                                                                                \r\u001b[1B\u001b[38;2;36;138;61m 53 +\u001b[38;2;51;51;51m| FIXED 1024 ids | 387 m"]
