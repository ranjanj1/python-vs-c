[363.777, "\u001b[H\u001b[7G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m5\u001b[11G\u001b[38;2;51;51;51m| decode step | 7.3 ms | 7.2\u20137.3 ms |                                                                  \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m56\u001b[11G\u001b[38;2;51;51;51m| load\u001b[18Gto\u001b[21GREADY\u001b[27G|\u001b[29G95\u001b[32Gms\u001b[35G|\u001b[37G98\u2013112\u001b[44Gms\u001b[47G(memory-pressure\u001b[64Goutliers\u001b[73Gup\u001b[76Gto\u001b[79G380\u001b[83Gms)\u001b[87G|\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m57\r\u001b[5C\u001b[1B 58 +\u001b[38;2;51;51;51mGENERATE is slower because its forced prompt tokens (5 + 15 + 18) now each cost a full step.           \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 59 +\u001b[38;2;51;51;51m                                                                                                       \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m0\u001b[12G\u001b[38;2;51;51;51m*Remain\u001b[20Gng limitatio\u001b[33Gs after roun\u001b[46G 4.**   \u001b[55G  \u001b[58G      \u001b[65G   \u001b[69G        \u001b[78G    \u001b[83G \u001b[85G   \u001b[89G   \u001b[93G       \u001b[101G  \u001b[104G     \u001b[110G  \u001b[113G \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m61\u001b[11G\u001b[38;2;51;51;51m- **Every position\u001b[30Gcosts\u001b[36Gone full weight stream** of abou\u001b[70G438 MB at about 59"]
[363.778, "\u001b[89GGB/s,\u001b[95Groughly\u001b[103G7.3\u001b[107Gms\u001b[110Gon\u001b[113Gt\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m  \u001b[11G\u001b[38;2;51;51;51mhis\u001b[15GM1.\u001b[19GThat\u001b[24Gis\u001b[27Gthe\u001b[31Gfloor\u001b[37Gfor\u001b[41Gbatch\u001b[47Gsize\u001b[52G1\u001b[54Gwith\u001b[59Gfloat32\u001b[67Gweights.\u001b[76GLOGITS,\u001b[84GFIXED\u001b[90Gand\u001b[94Gprompt\u001b[101Gprocessing\u001b[112Gno\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m    +\u001b[38;2;51;51;51mw scale linearly at that rate.                                                                         \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 62 +\u001b[38;2;51;51;51m- The round-2 and round-3 analyses of decode (blocked transposed `sgemv` at the bandwidth ceiling, hybr\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m    +\u001b[38;2;51;51;51mid attention, tokenizer, load) still apply. The prefill-GEMM analyses no longer apply.                 \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 63 +\u001b[38;2;51;51;51m- All earlier limitations (numerics within 3.1e-5 of the reference, load page faults, memory pressure o\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m    +\u001b[38;2;51;51;51mn this machine) still apply.                                                                     "]
[363.779, "      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 64 +\u001b[38;2;51;51;51m                                                                                                       \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 65 +\u001b[38;2;51;51;51m-------------------------------------------------------------------------------------------------------\r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m    +\u001b[38;2;51;51;51m--                                                                                                     \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 66 +\u001b[38;2;51;51;51m                                                                                                       \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 67 \u001b[22m ## Round 3: profiling and optimisation\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 68 \u001b[22m \r\u001b[1B\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 69 +\u001b[38;2;51;51;51m*(Historical. The chunked prefill described in rounds 1\u20133 violated rule 1 and was removed in round 4. P\u001b[49m\u001b[39"]
