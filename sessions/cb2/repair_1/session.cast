[111.138, " multi-\u001b[43Gosition batch\u001b[58Gg entirely, so every\u001b[79Gcommand, including prompts, FIXED and\r\u001b[2C\u001b[1BLOGITS,\u001b[11Gruns\u001b[16Gone\u001b[20Gcomplete\u001b[29Gforward\u001b[37Gpass\u001b[42Gper\u001b[46Gposition,\u001b[56Gin\u001b[59Gorder.\u001b[66GI'll\u001b[71Glook\u001b[76Gat\u001b[79Gthe\u001b[83Gcurrent\u001b[91Gforward\u001b[99Gand\u001b[103Gcommand\u001b[111Gcode.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm swapping \u001b[38;2;87;105;247mforward_chunk\u001b[39m for a si\u001b[39Ggle-token \u001b[38;2;87;105;247mforward(token, pos)\u001b[39m built on \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m, c\u001b[93Glled once\u001b[103Gper\u001b[107Gposition.\u001b[117GThe\r\u001b[2C\u001b[1Bonly\u001b[8G\u001b[38;2;87;105;247mcblas_sgemm\u001b[20G\u001b[39mleft\u001b[25Gis\u001b[28Gin\u001b[31Glong-context\u001b[44Gattention,\u001b[55Gand\u001b[59Git\u001b[62Ghandles\u001b[70Gone\u001b[74Gquery\u001b[80Gposition\u001b[89Gat\u001b[92Ga\u001b[94Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth checks\u001b[15Gpass. Th\u001b[24G scratch directory in /tmp has been\u001b[60Gcl\u001b[63Gared,\u001b[69Gso\u001b["]
