[266.959, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPure\u001b[8Greads\u001b[14Ghit\u001b[18G63\u001b[21GGB/s\u001b[26Gbut\u001b[30Gsgemv\u001b[36Gonly\u001b[41Greaches\u001b[49Gabout\u001b[55G35,\u001b[59Gand\u001b[63Gtransposed\u001b[74Gweights\u001b[82Gvary\u001b[87Gfrom\u001b[92G26\u001b[95Gto\u001b[98G46\u001b[101GGB/s\u001b[106Gdepending\u001b[116Gon\r\u001b[1B \u001b[3Go\u001b[5Gtput widt\u001b[15G. I'm\u001b[21Gsweeping\u001b[30Grow cou\u001b[38Gt against column-block width to find the fastest\u001b[87Gbl\u001b[90Gcking.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed,\u001b[15Gcontiguous\u001b[26G256\u2013512-column\u001b[41Gweight\u001b[48Gblocks\u001b[55Glet\u001b[59Gsgemv-Trans\u001b[71Greach\u001b[77Gabout\u001b[83G63\u001b[86GGB/s,\u001b[92Groughly\u001b[100G1.8\u00d7\u001b[105Gthe\u001b[109Gcurrent\r\u001b[1B \u001b[3Grate, for both model widths; I'm ignoring the strided figures since\u001b[71Gcache\u001b[77Ginflates\u001b[86Gthem.\u001b[92GNext I'll pin down th\u001b[114G\u001b[K\r\u001b[2C\u001b[1Bplateau more finely.\u001b[24G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWidths\u001b[10Gof\u001b[13G256\u001b[17Gto\u001b[20G384\u001b[24Gcolumns\u001b[32Ghold\u001b[37Gsteady"]
[266.96, "\u001b[44Gnear\u001b[49G63\u001b[52GGB/s,\u001b[58Gand\u001b[62Gthe\u001b[66Gearlier\u001b[74G512\u001b[78Greading\u001b[86Gdid\u001b[90Gnot\u001b[94Greproduce.\u001b[105GNext\u001b[110GI'll\u001b[115Gstore\r\u001b[1B \u001b[3Gweig\u001b[8Gts transposed in 256\u2013384 column blocks, with sgemv for d\u001b[65Gcode and\u001b[74Gsgemm for prefill.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Grose\u001b[19Gfrom\u001b[24G80\u001b[27Gto\u001b[30G131.5\u001b[36Gtok/s\u001b[42G(1.64\u00d7)\u001b[50Gwith\u001b[55Gthe\u001b[59Gfull\u001b[64Gcheck\u001b[70Gstill\u001b[76Gpassing,\u001b[85Gthough\u001b[92Gload\u001b[97Gtime\u001b[102Gwent\u001b[107Gup\u001b[110Gfrom\u001b[115Gabout\r\u001b[1B \u001b[3G80 to 124 ms b\u001b[18Gcause\u001b[24Gof\u001b[28Ghe transp\u001b[38Gsition\u001b[45G I'm\u001b[50Gadding section timer\u001b[71G to \u001b[38;2;87;105;247mcb2.c\u001b[39m behind \u001b[38;2;87;105;247m-DPROF\u001b[39m so profiling can be\u001b[115G\u001b[K\r\u001b[2C\u001b[1Brepr\u001b[8Gduced.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gproducts\u001b[19Gnow\u001b[23Grun\u001b[27Gnear\u001b[32Gthe\u001b[36G63\u001b[39GGB/s\u001b[44Gread\u001b[49Gceilin"]
