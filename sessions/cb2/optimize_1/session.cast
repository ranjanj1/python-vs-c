[390.142, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Grose\u001b[19Gfrom\u001b[24G80\u001b[27Gto\u001b[30G131.5\u001b[36Gtok/s\u001b[42G(1.64\u00d7)\u001b[50Gwith\u001b[55Gthe\u001b[59Gfull\u001b[64Gcheck\u001b[70Gstill\u001b[76Gpassing,\u001b[85Gthough\u001b[92Gload\u001b[97Gtime\u001b[102Gwent\u001b[107Gup\u001b[110Gfrom\u001b[115Gabout\r\u001b[2C\u001b[1B80 to 124 ms because of the transposition.\u001b[46GI'm\u001b[50Gadding\u001b[57Gsection\u001b[65Gtimers\u001b[72Gto\u001b[75G\u001b[38;2;87;105;247mcb2.c\u001b[81G\u001b[39mbehind\u001b[88G\u001b[38;2;87;105;247m-DPROF\u001b[95G\u001b[39mso\u001b[98Gprofiling\u001b[108Gcan\u001b[112Gbe\r\u001b[2C\u001b[1Breproduced.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gproducts\u001b[19Gnow\u001b[23Grun\u001b[27Gnear\u001b[32Gthe\u001b[36G63\u001b[39GGB/s\u001b[44Gread\u001b[49Gceiling,\u001b[58Gand\u001b[62Gweight\u001b[69Gstreaming\u001b[79Gis\u001b[82Gstill\u001b[88Gabout\u001b[94G96%\u001b[98Gof\u001b[101Gdecode\u001b[108Gtime.\u001b[114GNext\r\u001b[2C\u001b[1BI'm profiling prefill\u001b[25Gand\u001b[29Gload,\u001b[35Gsince\u001b[41GLOGITS\u001b[48Gand\u001b[52GFIXED\u001b[58Geach\u001b[63Gtake\u001b[68Groughly\u001b[76G42\u001b[79Gms\u001b[82Gon\u001b[85G69\u201382\u001b[91Gtokens.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command "]
[390.143, "\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gis\u001b[14Gmostly\u001b[21Gspent\u001b[27Gin\u001b[30Gthe\u001b[34Gweight\u001b[41Gmatmuls\u001b[49G(about\u001b[56G84%,\u001b[61Gonly\u001b[66G~450\u001b[71GGFLOP/s\u001b[79Gat\u001b[82GM\u224876),\u001b[89Gwith\u001b[94GSwiGLU's\u001b[103Gscalar\u001b[110Gexpf\u001b[115Gtaking\r\u001b[2C\u001b[1B9%. I'll benchmark sgemm\u001b[28Glayouts\u001b[36Gfor\u001b[40GM\u224876\u001b[45Gand\u001b[49GM=512\u001b[55Gto\u001b[58Gsee\u001b[62Gwhether\u001b[70Gthe\u001b[74Gblock\u001b[80Glayout\u001b[87Gis\u001b[90Gcosting\u001b[98Gprefill\u001b[106Gtime.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6GM=76,\u001b[12Gthe\u001b[16Gblocked\u001b[24Glayout\u001b[31Ggets\u001b[36Gabout\u001b[42G570\u001b[46GGFLOP/s\u001b[54Gin\u001b[57Gsgemm,\u001b[64Gnearly\u001b[71Gthe\u001b[75Gsame\u001b[80Gas\u001b[83Gthe\u001b[87Goriginal\u001b[96G586,\u001b[101Gso\u001b[104Gprefill\u001b[112Gis\r\u001b[2C\u001b[1Bunaffected. I'm splitting\u001b[29GW1/W3\u001b[35Gand\u001b[39GQ/K/V\u001b[45Ginto\u001b[50Gseparate\u001b[59Gblocked\u001b[67Gmatrices\u001b[76Gnext,\u001b[82Gthen\u001b[87Glooking\u001b[95Gat\u001b[98Gload\u001b[103Gtime.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G"]
