[656.708, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The madvise hints showed\u001b[28Gno\u001b[31Gmeasurable\u001b[42Ggain,\u001b[48Gso\u001b[51GI'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m D\u001b[5Gcode attention runs about 4 ms per token\u001b[46Gagainst\u001b[54Ga\u001b[56Groughly\u001b[64G1.2\u001b[68Gms\u001b[71Gbandwidth\u001b[81Gfloor,\u001b[88Gbecause\u001b[96Gthe\u001b[100Gper-head\u001b[109Gstrided\r\u001b[1C\u001b[1B sgemv \u001b[10Galls are \u001b[20Ghe bottleneck. I'm batching the 12 head queries into one block-diagonal\u001b[92Gmatrix\u001b[99Gso\u001b[102GK\u001b[104Gand\u001b[108GV\u001b[110Gare\u001b[114Geach\r\u001b[1C\u001b[1B read once with contiguous s\u001b[31Gemm calls.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Long-context \u001b[18Gten\u001b[22Gion improved (497\u2192399 ms) but short-context got sl\u001b[73Gghtly worse (38\u219250 ms), and"]
[656.71, " the whole-program\r\u001b[1C\u001b[1B numbe\u001b[9Gs are too noisy to tru\u001b[32Gt. I'll run a fixed-T microbenchmark\u001b[69Gof\u001b[72Gthe\u001b[76Gdecode-attention\u001b[93Gstrategies\u001b[104Gand\u001b[108Galso\u001b[113Gtry\u001b[117Ga\r\u001b[1C\u001b[1B per-he\u001b[10Gd\u001b[13Ggemv\u001b[18Gover a head-major KV layout.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m At\u001b[6GT=1000 every strategy takes 2.8\u20134 ms per token\u001b[53G while reading K/V should \u001b[80Gake about 1.2 ms, so something besides\r\u001b[1C\u001b[1B memory\u001b[10Gdominates. I'l\u001b[25G time the parts of the block-diago\u001b[60Gal path separ\u001b[75Gely.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Break\u001b[9Gdown block-diagonal attention costs\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cb2t && cat > attn2.c <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m#define ACCELERATE_NEW_LAPACK\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m#include <Accelerate/Accelerate.h>\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m#include <stdio.h>\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m#include <stdlib.h>\u001b"]
