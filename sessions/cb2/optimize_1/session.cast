[340.913, "\u001b[H\u001b[3G80\u001b[6Gto\u001b[9G124\u001b[13Gms\u001b[16Gbecause\u001b[24Gof\u001b[27Gthe\u001b[31Gtransposition.\u001b[46GI'm\u001b[50Gadding\u001b[57Gsection\u001b[65Gtimers\u001b[72Gto\u001b[75G\u001b[38;2;87;105;247mcb2.c\u001b[81G\u001b[39mbehind\u001b[88G\u001b[38;2;87;105;247m-DPROF\u001b[95G\u001b[39mso\u001b[98Gprofiling\u001b[108Gcan\u001b[112Gbe\r\u001b[2C\u001b[1Breproduced.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight products now run\u001b[27Gnear the 63 GB/s read ceil\u001b[56G, and weight streaming is st\u001b[85Gll\u001b[88Gabout 96%\u001b[98Gof decode\u001b[108Gtime. Next\r\u001b[2C\u001b[1BI'm profiling\u001b[17Gprefill\u001b[25Gand\u001b[29Gload,\u001b[35Gsince\u001b[41GLOGITS\u001b[48Gand\u001b[52GFIXED\u001b[58Geach\u001b[63Gtake\u001b[68Groughly\u001b[76G42\u001b[79Gms\u001b[82Gon\u001b[85G69\u201382\u001b[91Gtokens.\r\u001b[2C\u001b[4BPrefill is mostly spent\u001b[27Gin the weight matmuls\u001b[49G(about 84%, only ~450 GFLOP/s\u001b[79Gat\u001b[82GM\u224876), with\u001b[94GSwiGLU's scalar expf taking\r\u001b[2C\u001b[1B9%.\u001b[7GI'll be\u001b[15Gchmark sgemm layouts for M\u224876 and M=512 to\u001b[58Gsee whethe\u001b[69G the block layout is costi\u001b[96Gg prefill\u001b[106Gtime.\r\u001b[6C\u001b[2B\u001b[38;2;102;102;102m\u001b[1m2\u001b[22G\u001b[22ms \r\u001b[2C\u001b[2B\u001b["]
[340.914, "39mAt M=76, the blocked layout g\u001b[33Gts about 570 GFLOP/s in sgemm, nearly\u001b[71Gthe same as the original 586, \u001b[102Go prefill is\u001b[115G\u001b[K\r\u001b[2C\u001b[1Bunaffected. I'\u001b[18G splitting W1/W3 and Q/K/V\u001b[45Gi\u001b[47Gto separate block\u001b[65Gd matrices next, then\u001b[87Glooking at\u001b[98Gload time.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mSplitting matrices, vectorize\u001b[33GSwiGLU,\u001b[41Gcausal\u001b[48Grow\u001b[52Ggroups\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/, qkvd, kv_mul, shared_cls;/, kv_mul, shared_cls;/; s/ kv_mul = nh \\/ nkv; qkvd = dim + 2 \\* kvd;/ \r\u001b[1B\u001b[39m \u001b[3G  \u001b[6G\u001b[38;2;102;102;102mkv_mul = nh \\/ nkv;/' cb2.c && ./build.sh && python3 check.py --tokens 64 --prompts 3 -- ./cb2 | tail -4 && python3\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m/tmp/cb2t/cmp.py && for i in 1 2; do python3 /tmp/cb2t/dev.py ./cb2; \u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
