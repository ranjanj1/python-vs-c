[519.132, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6GM=76,\u001b[12Gthe\u001b[16Gblocked\u001b[24Glayout\u001b[31Ggets\u001b[36Gabout\u001b[42G570\u001b[46GGFLOP/s\u001b[54Gin\u001b[57Gsgemm,\u001b[64Gnearly\u001b[71Gthe\u001b[75Gsame\u001b[80Gas\u001b[83Gthe\u001b[87Goriginal\u001b[96G586,\u001b[101Gso\u001b[104Gprefill\u001b[112Gis\r\u001b[1B \u001b[3Gunaffected. I'm splitting W1/W3 and Q/K/V into separate blocked matric\u001b[74Gs next, then\u001b[87Glook\u001b[93Gg at load tim\u001b[107G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Gfell\u001b[19Gto\u001b[22G110\u2013116\u001b[30Gtok/s,\u001b[37Gand\u001b[41Gthe\u001b[45Gclassifier\u001b[56Galso\u001b[61Gslowed\u001b[68Gabout\u001b[74G9%\u001b[77Gdespite\u001b[85Gno\u001b[88Gcode\u001b[93Gchange,\u001b[101Gso\u001b[104Gthis\u001b[109Glooks\u001b[115Glike\r\u001b[1B \u001b[3Gmachine nois\u001b[16G. I'm\u001b[22Gre-running the\u001b[37Gbandwidth probe to\u001b[56Gconfirm.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsizes\u001b[15G320\u2013384\u001b[23Ghave\u001b[28Gbeen"]
[519.132, "\u001b[33Gthe\u001b[37Gonly\u001b[42Gconsistently\u001b[55Gfast\u001b[60Gband,\u001b[66Gand\u001b[70Gall\u001b[74Gmy\u001b[77Gblocks\u001b[84Gfall\u001b[89Gthere,\u001b[96Gso\u001b[99GI'm\u001b[103Grunning\r\u001b[1B \u001b[3Ga\u001b[5Gternating\u001b[15Gbinaries o\u001b[27Gr s\u001b[31Gveral\u001b[37Gruns\u001b[42Gand comparing medians. I'm also\u001b[75Gaking BLOCK_MAX a build-ti\u001b[102Ge opt\u001b[108Gon\u001b[111Gfor\u001b[115Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode\u001b[10Gholds\u001b[16Gat\u001b[19Gabout\u001b[25G126\u001b[29Gtok/s\u001b[35Gacross\u001b[42Gwidths\u001b[49G256\u001b[53Gto\u001b[56G448,\u001b[61Gbut\u001b[65Gwidth\u001b[71G256\u001b[75Gprefills\u001b[84G17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[1B \u001b[3Gd\u001b[5Gfault. Next I'll test whether\u001b[35Gtran\u001b[40Gpos\u001b[44Gng directly\u001b[56Gfrom\u001b[61Gan mmap of the checkpoint be\u001b[90Gts the staging copy\u001b[110Gfor load\r\u001b[2C\u001b[1Btime.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing\u001b[15Gstraight\u001b[24Gfrom\u001b[29Gthe\u001b[33Gmmap\u001b[38Gcuts\u001b[43Gload\u001b[48Gfrom\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103"]
[519.133, "\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1B \u001b[3Git. I'll also try \u001b[38;2;87;105;247mmadvise\u001b[29G\u001b[39mhints on\u001b[38Gthe mapping.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mA/B\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gon\u001b[24Gload\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1B  \u23bf  $ sed 's| if (map == MAP_FAILED) { fprintf(stderr, \"mmap failed\\\\n\"); exit(1); }|&\\n madvise(map, (size_t)fsize, \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mMADV_SEQUENTIAL);\u001b[24Gmadvise(map, (size_t)fsize, MADV_WILLNEED);|' cb2.c\u001b[76G> /\u001b[80Gmp/cb2t/madv.c && gre\u001b[102G -c madvise \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m/tmp/cb2t/madv.c && cc -O3 -mcpu=native -o /tmp/cb2t/madv /tmp/cb2t/madv.c -fr\u2026 (3s \u00b7 2 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+\u001b[13G \u001b[15Go run in ba\u001b[27Gkground)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
