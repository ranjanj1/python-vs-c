[691.399, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gshowed\u001b[28Gno\u001b[31Gmeasurable\u001b[42Ggain,\u001b[48Gso\u001b[51GI'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode\u001b[10Gattention\u001b[20Gruns\u001b[25Gabout\u001b[31G4\u001b[33Gms\u001b[36Gper\u001b[40Gtoken\u001b[46Gagainst\u001b[54Ga\u001b[56Groughly\u001b[64G1.2\u001b[68Gms\u001b[71Gbandwidth\u001b[81Gfloor,\u001b[88Gbecause\u001b[96Gthe\u001b[100Gper-head\u001b[109Gstrided\r\u001b[2C\u001b[1Bsgemv calls are the bottleneck.\u001b[35GI'm\u001b[39Gbatching\u001b[48Gthe\u001b[52G12\u001b[55Ghead\u001b[60Gqueries\u001b[68Ginto\u001b[73Gone\u001b[77Gblock-diagonal\u001b[92Gmatrix\u001b[99Gso\u001b[102GK\u001b[104Gand\u001b[108GV\u001b[110Gare\u001b[114Geach\r\u001b[2C\u001b[1Bread\u001b[8Gonce\u001b[13Gwith\u001b[18Gcontiguous\u001b[29Gsgemm\u001b[35Gcalls.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context\u001b[16Gattention\u001b[26Gimproved\u001b[35G(497\u2192399\u001b[44Gms)\u001b[48Gbut\u001b[52Gshort-context\u001b[66Ggot\u001b[70Gsli"]
[691.401, "ghtly\u001b[79Gworse\u001b[85G(38\u219250\u001b[92Gms),\u001b[97Gand\u001b[101Gthe\u001b[105Gwhole-program\r\u001b[2C\u001b[1Bnumbers are too noisy\u001b[25Gto\u001b[28Gtrust.\u001b[35GI'll\u001b[40Grun\u001b[44Ga\u001b[46Gfixed-T\u001b[54Gmicrobenchmark\u001b[69Gof\u001b[72Gthe\u001b[76Gdecode-attention\u001b[93Gstrategies\u001b[104Gand\u001b[108Galso\u001b[113Gtry\u001b[117Ga\r\u001b[2C\u001b[1Bper-head\u001b[12Gsgemv\u001b[18Gover\u001b[23Ga\u001b[25Ghead-major\u001b[36GKV\u001b[39Glayout.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt T=1000 every strategy\u001b[28Gtakes\u001b[34G2.8\u20134\u001b[40Gms\u001b[43Gper\u001b[47Gtoken,\u001b[54Gwhile\u001b[60Greading\u001b[68GK/V\u001b[72Gshould\u001b[79Gtake\u001b[84Gabout\u001b[90G1.2\u001b[94Gms,\u001b[98Gso\u001b[101Gsomething\u001b[111Gbesides\r\u001b[2C\u001b[1Bmemory\u001b[10Gdominates.\u001b[21GI'll\u001b[26Gtime\u001b[31Gthe\u001b[35Gparts\u001b[41Gof\u001b[44Gthe\u001b[48Gblock-diagonal\u001b[63Gpath\u001b[68Gseparately.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe narrow-N sgemm is the bottleneck,\u001b[42Go I'm\u001b[48Gtrying\u001b[55GQ_blk\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b[85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116G"]
[691.401, "and\r\u001b[1B  I'll compare it with the per-head path\u001b[42Gto\u001b[45Gfind\u001b[50Gthe\u001b[54Gcrossover.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m sh\u001b[12Gl\u001b[14G \u001b[16Gommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe per-head path wins below\u001b[32Gabout\u001b[38GT=160\u001b[44Gand\u001b[48Gthe\u001b[52Gblock-diagonal\u001b[67Gpath\u001b[72Gabove\u001b[78Git,\u001b[82Groughly\u001b[90G25%\u001b[94Gfaster\u001b[101Gat\u001b[104GT=1000,\u001b[112Gso\u001b[115GI'll\r\u001b[2C\u001b[1Bswitch between them at that crossover and keep the per-head\u001b[63Gpath\u001b[68Gfor\u001b[72Gfixture-sized\u001b[86Gworkloads.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m8\u001b[30G1\u001b[39m\u001b[40;1H\u001b[38;3H"]
[691.411, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 4s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
