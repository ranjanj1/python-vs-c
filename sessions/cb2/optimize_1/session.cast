[548.587, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt M=76, the blocked layout gets about 570 GFLOP/s in sgemm, nearly th\u001b[74G same as the\u001b[87Gorig\u001b[93Gal 586, so pr\u001b[107Gfill\u001b[112Gis\r\u001b[2C\u001b[1Bunaffected.\u001b[15GI'm\u001b[19Gsplitting\u001b[29GW1/W3\u001b[35Gand\u001b[39GQ/K/V\u001b[45Ginto\u001b[50Gseparate\u001b[59Gblocked\u001b[67Gmatrices\u001b[76Gnext,\u001b[82Gthen\u001b[87Glooking\u001b[95Gat\u001b[98Gload\u001b[103Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration f\u001b[16Gll to\u001b[22G110\u2013116 tok/s,\u001b[37Gand the classifier\u001b[56Galso slowed\u001b[68Gabout\u001b[74G9%\u001b[77Gdespite\u001b[85Gno\u001b[88Gcode\u001b[93Gchange,\u001b[101Gso\u001b[104Gthis\u001b[109Glooks\u001b[115Glike\r\u001b[2C\u001b[1Bmachine\u001b[11Gnoise.\u001b[18GI'm\u001b[22Gre-running\u001b[33Gthe\u001b[37Gbandwidth\u001b[47Gprobe\u001b[53Gto\u001b[56Gconfirm.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mB\u001b[5Gock sizes\u001b[15G320\u2013384 ha\u001b[27G be\u001b[31Gn the\u001b[37Gonly\u001b[42Gconsistentl"]
