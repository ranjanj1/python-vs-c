[131.388, "\u001b[H\u001b[6G\u001b[38;2;102;102;102m#include <stdlib.h>\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m#include <time.h>\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mstatic double now(){struct timespec t;clock_gettime(CLOCK_MONOTONIC,&t);return t.tv_sec+t.tv_nsec*1e-9;}\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mint main(){\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102msize_t N=96u<<20; f\u2026\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[15G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mFine sweep of block widths 224-704\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[131.389, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/tmp/cb2t\u001b[17G&&\u001b[20Gcat\u001b[24G>\u001b[26Gsweep2.c\u001b[35G<<'EOF'\r\u001b[1B \u001b[2m\u2502\u001b[22m #d\u001b[7Gfine ACCELERATE_NEW_LAPACK\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #include <Accelera\u001b[23Ge/Accelerate.h>\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#include\u001b[13G<stdio.h>\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #include <stdlib.h>\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#include\u001b[13G<time.h>\r\u001b[1B \u001b[2m\u2502\u001b[22m static double now(){\u001b[25Gtruct tim\u001b[35Gspec t;clock_gettime(CLOCK_MONOTONIC,&t);retu\u001b[81Gn t.tv_sec+t.tv_nsec*1e-9;}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m in\u001b[7G main(){\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22msize_t\u001b[13GN=96u<<20;\u001b[24Gfloat*W=aligned_alloc(16384,N*4);\u001b[58Gfor(size_t\u001b[69Gi=0;i<N;i++)W[i]=(i%7)*1e-3f;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   float x[8192],*y=ma"]
[131.39, "lloc(1<<24);\u001b[38Gfor(int\u001b[46Gi=0;i<8192;i++)x[i]=1e-3f;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mint\u001b[10Gns[]={768,2048};\r\u001b[1B \u001b[2m\u2502\u001b[22m   fo\u001b[9G(int\u001b[14Ga=0;a<2;a++){int n=ns[a]; p\u001b[42Gintf(\"n=%d:\",n);\u001b[59G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    for(\u001b[12Gn\u001b[14G db=224;db<=704;db+=32){ size_t per=(size_t)n*db, cnt=N/per;\u001b[75Gdouble b=1e9;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor(int\u001b[16Gr=0;r<5;r++){double\u001b[36Gt=now();for(size_t\u001b[55Gc=0;c<cnt;c++)cblas_sgemv(CblasRowMajor,CblasTrans,n,db,1,W+c*per\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ,db,x,1,0,y+(c*db)%(1<<21),1);t=now()-t;if(t<b)b=t;}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprintf(\"\u001b[17G%d:%.0f\",db,cnt*per*4/b/1e9);}\r\u001b[1B \u001b[2m\u2502\u001b[22m    printf(\"\\n\");}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcc\u001b[7G-O2\u001b[11G-o\u001b[14Gsweep2\u001b[21Gsweep2.c\u001b[30G-framework\u001b[41GAccelerate\u001b[52G&&\u001b[55G./sweep2\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[131.391, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
