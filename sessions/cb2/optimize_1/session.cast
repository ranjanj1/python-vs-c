[763.171, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context attention imp\u001b[30Goved\u001b[35G(497\u2192399\u001b[44Gms) but short-context got slightly worse (38\u219250 m\u001b[94G), and the whole-program\r\u001b[2C\u001b[1Bnumbers are too noisy\u001b[25Gto trust. I'll run a fixed-T\u001b[54Gmicrobenchmark\u001b[69Gof\u001b[72Gthe\u001b[76Gdecode-attention\u001b[93Gstrategies\u001b[104Gand\u001b[108Galso\u001b[113Gtry\u001b[117Ga\r\u001b[2C\u001b[1Bper-head\u001b[12Gsgemv\u001b[18Gover\u001b[23Ga\u001b[25Ghead-major\u001b[36GKV\u001b[39Glayout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt T=1000 every strategy takes 2.8\u20134 ms per token, while reading\u001b[68GK/V shou\u001b[77Gd take\u001b[84Gabout\u001b[90G1.2\u001b[94Gms,\u001b[98Gso\u001b[101Gsomething\u001b[111Gbesides\r\u001b[2C\u001b[1Bmemory\u001b[10Gdominates.\u001b[21GI'll\u001b[26Gtime\u001b[31Gthe\u001b[35Gparts\u001b[41Gof\u001b[44Gthe\u001b[48Gblock-diagonal\u001b[63Gpath\u001b[68Gseparately.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe narrow-N\u001b[16Gsgemm is the bottleneck, so I'm trying Q_blk\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b["]
[763.171, "85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116Gand\r\u001b[2C\u001b[1BI'll\u001b[8Gcompare\u001b[16Git\u001b[19Gwith\u001b[24Gthe\u001b[28Gper-head\u001b[37Gpath\u001b[42Gto\u001b[45Gfind\u001b[50Gthe\u001b[54Gcrossover.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe per-head pa\u001b[20G wins\u001b[26Gbelow about T=160 and the block\u001b[58Gdi\u001b[61Ggon\u001b[65Gl path\u001b[72Gabove it, roughly 25% faster\u001b[101Gat\u001b[104GT=1000,\u001b[112Gso\u001b[115GI'll\r\u001b[2C\u001b[1Bswitch\u001b[10Gbetween\u001b[18Gthem\u001b[23Gat\u001b[26Gthat\u001b[31Gcrossover\u001b[41Gand\u001b[45Gkeep\u001b[50Gthe\u001b[54Gper-head\u001b[63Gpath\u001b[68Gfor\u001b[72Gfixture-sized\u001b[86Gworkloads.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Ghybrid path passes\u001b[26Gall checks, with long-context attention down t\u001b[73G about 394 ms and sho\u001b[95Gt-co\u001b[100Gtext unchanged at 43\r\u001b[2C\u001b[1Bms. Since cmp.py still used the\u001b[35Gold\u001b[39GCHUNK=1\u001b[47Gbinary,\u001b[55GI'm\u001b[59Grebuilding\u001b[70Gfrom\u001b[75Gcurrent\u001b[83Gsource\u001b[90Gand\u001b[94Grerunning\u001b[104Gthe\u001b[108Gcomparison,\r\u001b[2C\u001b"]
[763.172, "[1Bblock-diagonal\u001b[18Gpath\u001b[23Gincluded.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Rebuilding sequential build, cross-compare\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cp /tmp/cb2t/c1\u001b[36G_v1 \u001b[41G& sed 's/#defi\u001b[56Ge CHUNK 512 /#define CHUNK 1 /' \u001b[89Gb2.c > /tmp/cb2t/\u001b[107G1.c && grep -c\r\u001b[5C\u001b[1B\"defi\u001b[12Ge\u001b[14GCHUNK 1 \" /tmp/cb2t/\u001b[35G1.c && cc -O3 -mc\u001b[53Gu=native -o /tmp/cb2t/c1 /tmp/cb2t/c1.c -framework Accelerate && \r\u001b[5C\u001b[1Bpython3 /tmp/cb2t/cmp.py && cat > /tmp/cb2t/cmp2.py <<'EOF'\r\u001b[5C\u001b[1Bimport subp\u2026\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
