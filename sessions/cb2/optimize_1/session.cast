[341.327, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWidths\u001b[10Gof\u001b[13G256\u001b[17Gto\u001b[20G384\u001b[24Gcolumns\u001b[32Ghold\u001b[37Gsteady\u001b[44Gnear\u001b[49G63\u001b[52GGB/s,\u001b[58Gand\u001b[62Gthe\u001b[66Gearlier\u001b[74G512\u001b[78Greading\u001b[86Gdid\u001b[90Gnot\u001b[94Greproduce.\u001b[105GNext\u001b[110GI'll\u001b[115Gstore\r\u001b[1B \u001b[3Gw\u001b[9Gs transposed in 256\u2013384 column blocks, with sgemv for decode and sgemm for prefill.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Grose\u001b[19Gfrom\u001b[24G80\u001b[27Gto\u001b[30G131.5\u001b[36Gtok/s\u001b[42G(1.64\u00d7)\u001b[50Gwith\u001b[55Gthe\u001b[59Gfull\u001b[64Gcheck\u001b[70Gstill\u001b[76Gpassing,\u001b[85Gthough\u001b[92Gload\u001b[97Gtime\u001b[102Gwent\u001b[107Gup\u001b[110Gfrom\u001b[115Gabout\r\u001b[1B \u001b[3G80 to 124 ms becau\u001b[22Ge of\u001b[27Gthe transposition. I'm \u001b[51Gdding section timers to \u001b[38;2;87;105;247mcb2.c\u001b[39m behind \u001b[38;2;87;105;247m-DPROF\u001b[39m so profiling can be\u001b[115G\u001b[K\r\u001b[2C\u001b[1Breproduced.\u001b[K\r\u001b[6C\u001b[2B\u001b[38;2;102;102;102m\u001b[1m1\u001b[22G\u001b["]
[341.328, "22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BWeight products now run near the\u001b[36G63 GB/s read ceiling, and weight streaming is s\u001b[84Gill about 96% of\u001b[101Gdecod\u001b[107G time. Next\r\u001b[2C\u001b[1BI'm profiling prefill a\u001b[27Gd\u001b[29Gload,\u001b[35Gsince LOGITS and FIXED each take roughly\u001b[76G42 ms\u001b[82Gon 69\u201382 tokens.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill is mostly spent in the weight matmuls (about 84%, only ~450 GFLOP/s at M\u224876), with SwiGLU's scalar expf taking\r\u001b[2C\u001b[1B9%. I'll benchmark sgemm layouts for M\u224876 and M=512 to see whether the block\u001b[80Glayout\u001b[87Gis\u001b[90Gcosting\u001b[98Gprefill\u001b[106Gtime.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m At M=76, the blocked layout gets about 570 GFLOP/s in sgemm, nearly the same as the\u001b[87Goriginal\u001b[96G586,\u001b[101Gso\u001b[104Gprefill\u001b[112Gis\r\u001b[1C\u001b[1B unaffected. I'm splitting W1/W3 and Q/K/V into\u001b[50Gseparate\u001b[59Gblocked\u001b[67Gmatrices\u001b[76Gnext,\u001b[82Gthen\u001b[87Glooking\u001b[95Gat\u001b[98Gloa"]
[341.328, "d\u001b[103Gtime.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Build, check, compare\u001b[25Gchunked, tim\u001b[38G, profile\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/, qkvd, kv_mul, shared_cls;/, kv_mul, shared_cls;/; s/ kv_mul = nh \\/ nkv; qkvd = dim + 2 \\* kvd;/ \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mkv_mul = nh \\/ nkv;/' cb2.c && ./build.sh && python3 check.py --tokens 64 --prompts 3 -- ./cb2 | tail -4 && python3\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m/tmp/cb2t/cmp.py && for i in 1 2; do python3 /tmp/cb2t/dev.py ./cb2; \u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;234;138;106mDrizzling\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(5m 30s \u00b7 \u2193\u001b[26G31.3k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[341.329, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
