[770.504, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt T=1000 every strategy\u001b[28Gtakes\u001b[34G2.8\u20134\u001b[40Gms\u001b[43Gper\u001b[47Gtoken,\u001b[54Gwhile\u001b[60Greading\u001b[68GK/V\u001b[72Gshould\u001b[79Gtake\u001b[84Gabout\u001b[90G1.2\u001b[94Gms,\u001b[98Gso\u001b[101Gsomething\u001b[111Gbesides\r\u001b[2C\u001b[1Bmemory\u001b[10Gdominates.\u001b[21GI'll\u001b[26Gtime\u001b[31Gthe\u001b[35Gparts\u001b[41Gof\u001b[44Gthe\u001b[48Gblock-diagonal\u001b[63Gpath\u001b[68Gseparately.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gnarrow-N\u001b[16Gsgemm\u001b[22Gis\u001b[25Gthe\u001b[29Gbottleneck,\u001b[41Gso\u001b[44GI'm\u001b[48Gtrying\u001b[55GQ_blk\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b[85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116Gand\r\u001b[2C\u001b[1BI'll compare it with\u001b[24Gthe\u001b[28Gper-head\u001b[37Gpath\u001b[42Gto\u001b[45Gfind\u001b[50Gthe\u001b[54Gcrossover.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gper-head\u001b[16Gpath\u001b[21Gwins\u001b[26Gbelow\u001b[32Gabout\u001b[38GT=160\u001b[44Gand\u001b[48Gthe\u001b[52Gblock-diagonal\u001b[67Gpath\u001b[72Gabove\u001b[78Git,\u001b[82Groughly\u001b[90G25%\u001b[94Gfaster\u001b[101Gat\u001b[1"]
