[684.856, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m Decode attention runs about 4 ms per token against a roughly 1.2 ms bandwidth floor, because the per-head strided\u001b[K\r\u001b[1C\u001b[1B sgemv calls\u001b[15Gare\u001b[19Gthe\u001b[23Gbottleneck.\u001b[35GI'm\u001b[39Gbatching\u001b[48Gthe\u001b[52G12\u001b[55Ghead\u001b[60Gqueries\u001b[68Ginto\u001b[73Gone\u001b[77Gblock-diagonal\u001b[92Gmatrix\u001b[99Gso\u001b[102GK\u001b[104Gand\u001b[108GV\u001b[110Gare\u001b[114Geach\r\u001b[1C\u001b[1B read once with contiguous sgemm calls.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Long-contex\u001b[15G attention improved\u001b[35G(497\u2192399\u001b[44Gms)\u001b[48Gbut\u001b[52Gshort-context\u001b[66Ggot\u001b[70Gslightly\u001b[79Gworse\u001b[85G(38\u219250\u001b[92Gms),\u001b[97Gand\u001b[101Gthe\u001b[105Gwhole-program\r\u001b[1C\u001b[1B numbe\u001b[9Gs are too noisy to trust. I'll run a fixed-T microbenchmark of th\u001b[75G decode-attention\u001b[93Gstrategies\u001b[104Gand\u001b[108Galso\u001b[113Gtry\u001b[117Ga\r\u001b[1C\u001b[1B per-head sg\u001b[15Gmv over a\u001b[25Ghead-major\u001b[36GKV\u001b[39Glayout.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan"]
[684.858, " \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m At\u001b[6GT=1000 every strategy takes 2.8\u20134 ms per token, while reading K/V should take \u001b[85Gbout 1.2\u001b[94Gms,\u001b[98Gso\u001b[101Gsomething\u001b[111Gbesides\r\u001b[1C\u001b[1B memory\u001b[10Gd\u001b[12Gmina\u001b[17Ges. I'll time the parts of \u001b[45Ghe block-diagonal path separately.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gnarrow-N\u001b[16Gsgemm\u001b[22Gis\u001b[25Gthe\u001b[29Gbottleneck,\u001b[41Gso\u001b[44GI'm\u001b[48Gtrying\u001b[55GQ_blk\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b[85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116Gand\r\u001b[1C\u001b[1B I'll compare it\u001b[19Gwith\u001b[24Gthe\u001b[28Gper-head\u001b[37Gpath\u001b[42Gto\u001b[45Gfind\u001b[50Gthe\u001b[54Gcrossover.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Comparing attention variant\u001b[31G incl. TT scores\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cb2t && python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102ms=open('attn.c').read()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102ms=s.replace('double b"]
