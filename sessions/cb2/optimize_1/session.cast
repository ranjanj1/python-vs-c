[1006.377, "encoder\r\u001b[2C\u001b[1Bagainst\u001b[11Gv1\u001b[14Gon\u001b[17Gmany\u001b[22Grandomised\u001b[33Gtexts.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new encoder now matches\u001b[31Gthe\u001b[35Greference\u001b[45Gon\u001b[48Gall\u001b[52G514\u001b[56Gtest\u001b[61Gtexts,\u001b[68Gand\u001b[72GENCODE\u001b[79Gfor\u001b[83G900\u001b[87Gwords\u001b[93Gfell\u001b[98Gfrom\u001b[103G1608\u001b[108Gms\u001b[111Gto\u001b[114G7.8\u001b[118Gms.\r\u001b[2C\u001b[1BI'm\u001b[7Grunning\u001b[15Gthe\u001b[19Gfull\u001b[24Gvalidation\u001b[35Gsuite\u001b[41Gon\u001b[44Gthe\u001b[48Gfinal\u001b[54Gbuild\u001b[60Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery check passes on\u001b[25Gthe\u001b[29Gfinal\u001b[35Gbuild,\u001b[42Gand\u001b[46Gsince\u001b[52Ggeneration\u001b[63Gtimings\u001b[71Gvary\u001b[76Gbetween\u001b[84Gruns,\u001b[90GI'll\u001b[95Greport\u001b[102Granges.\u001b[110GNext\u001b[115GI'm\r\u001b[2C\u001b[1Bcopying\u001b[11Gthe\u001b[15Gprofiling\u001b[25Gscripts\u001b[33Ginto\u001b[38Gprof/\u001b[44Gand\u001b[48Gupdating\u001b[57GNOTES.md.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[4G\u001b[39mhe supplied mo\u001b[19Gel doesn't exer\u001b[35Gise the "]
