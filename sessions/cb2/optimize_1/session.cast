[1068.494, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat profiling showed\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mDecode is entirely limited by reading the weights.\u001b[56G\u001b[22m97%\u001b[60Gof\u001b[63Gthe\u001b[67Gtime\u001b[72Gwent\u001b[77Gto\u001b[80Gthe\u001b[84Gweight\u001b[91Gmatrix-vector\u001b[105Gproducts,\u001b[115Gwhich\r\u001b[2C\u001b[1B  read memory at only\u001b[25G33\u201337\u001b[31GGB/s.\u001b[37GPlain\u001b[43Gmemory\u001b[50Greads\u001b[56Gon\u001b[59Gthis\u001b[64GM1\u001b[67Greach\u001b[73G63\u001b[76GGB/s.\u001b[82GMy\u001b[85Gv1\u001b[88Gnotes\u001b[94Gsaid\u001b[99G34\u001b[102GGB/s\u001b[107Gwas\u001b[111Gthe\r\u001b[2C\u001b[1B \u001b[5Ghardware limit; that was wrong, and NOTES.md now says s\u001b[61G.\u001b[63G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWeight layout was the cause.\u001b[22m Stored transposed, in\u001b[56Gcon\u001b[60Giguous\u001b[67Gblo\u001b[71Gks 256\u2013384\u001b[82Gcolumns wide, \u001b[38;2;87;105;247msgemv\u001b[102G\u001b[39mreads the w\u001b[114Gights\r\u001b[4C\u001b[1Bat about\u001b[14G63 GB/s.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSmaller costs:\u001b[22m SwiGLU was 9%\u001b[34Gof prompt processing (one scalar\u001b[67G\u001b[38;2;87;105;247mexpf\u001b[39m per element). Long-context attention cost about\u001b[120G4\r\u001b[4C\u001b[1Bms\u001b[8Gper \u001b[13Goken.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTokenizer:\u001b[22m the\u001b[20Greference's merge l\u001b[40Go\u001b[42G took 1.6 s o"]
[1068.496, "n a 900-wo\u001b[66Gd prom\u001b[73Gt.\u001b[76G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChang\u001b[9Gs\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWeights are stored transposed in 256-column blocks\u001b[22m,\u001b[58Gwith\u001b[63Gone\u001b[67GAccelerate\u001b[78Gcall\u001b[83Gper\u001b[87Gblock.\u001b[94GPrompt\u001b[101Gprocessing\u001b[112Gloses\r\u001b[2C\u001b[1B   nothing\u001b[14Gfrom\u001b[19Gthis\u001b[24Glayout.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mQ/K/V and W1/W3 are now separate\u001b[39Gmatrices.\u001b[22m K and V are written dir\u001b[73Gctly\u001b[78Ginto\u001b[83Gthe\u001b[87GKV \u001b[91Gache, and\u001b[101GSwiGLU runs a\u001b[115G a\u001b[118Gfew\r\u001b[5C\u001b[1Bwhole-bu\u001b[15Gfer\u001b[19GvDSP/vForce calls\u001b[37Gin\u001b[40Gthe\u001b[44Greference's\u001b[56Gorder\u001b[62Gof\u001b[65Goperations.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mThe embe\u001b[15Gding tabl\u001b[26Gis read from\u001b[39Gthe transposed classifier\u001b[22m, so\u001b[69Gthe weights are only\u001b[90Gheld in memory once.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLoading transposes straight from an mmap\u001b[22m of th\u001b[53G checkpoint, with n\u001b[73G \u001b[75Gtaging\u001b[82Gcopy.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mAttention over \u001b[22G chunk\u001b[29Gof prompt\u001b[40Gokens skip\u001b[51G the ma\u001b[59Gked-out region.\u001b[22m Everything the\u001b[90Gr\u001b[92Gfere\u001b[97Gce c\u001b[102Gmputes is\u001b"]
[1068.498, "[112Gstill\r\u001b[2C\u001b[1B  \u001b[6Gcomputed.\u001b[K\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mFrom 160 p\u001b[17Gsitions o\u001b[27Gwards, single-token atten\u001b[53Gion handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[22m Th\u001b[112Gadds\u001b[K\r\u001b[5C\u001b[1Bmultiplications\u001b[22Gby\u001b[25Gzero\u001b[30Gbut\u001b[34Gremoves\u001b[42Gnone\u001b[47Gof\u001b[50Gthe\u001b[54Greference's\u001b[66Gwork.\u001b[72GBelow\u001b[78G160\u001b[82Gthe\u001b[86Gold\u001b[90Gper-head\u001b[99Gpath\u001b[104Gis\u001b[107Gkept\u001b[112Gbecause\r\u001b[2C\u001b[1B  \u001b[6Git is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[22m Its \u001b[76Gutput\u001b[82Gis identical to the reference\u001b[112Galgorithm\r\u001b[5C\u001b[1Bon\u001b[9G514 test texts, including\u001b[35Gthe\u001b[39Gfixtures\u001b[48Gand\u001b[52Grandom\u001b[59GUnicode.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[16GWorkload\u001b[36G\u2502\u001b[40Gv1\u001b[46G\u2502\u001b[53Gv2\u001b[61G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[3"]
