[699.692, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context\u001b[16Gattention\u001b[26Gimproved\u001b[35G(497\u2192399\u001b[44Gms)\u001b[48Gbut\u001b[52Gshort-context\u001b[66Ggot\u001b[70Gslightly\u001b[79Gworse\u001b[85G(38\u219250\u001b[92Gms),\u001b[97Gand\u001b[101Gthe\u001b[105Gwhole-program\r\u001b[1B \u001b[3Gnumbers are too noisy to t\u001b[30Gust.\u001b[35GI'll run\u001b[44Ga fixed-T microbenchmark of the decode-attention \u001b[94Gtrategies and also try a\r\u001b[2C\u001b[1Bper-head sgemv over a\u001b[25Ghead-major KV layout.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6GT=1000\u001b[13Gevery\u001b[19Gstrategy\u001b[28Gtakes\u001b[34G2.8\u20134\u001b[40Gms\u001b[43Gper\u001b[47Gtoken,\u001b[54Gwhile\u001b[60Greading\u001b[68GK/V\u001b[72Gshould\u001b[79Gtake\u001b[84Gabout\u001b[90G1.2\u001b[94Gms,\u001b[98Gso\u001b[101Gsomething\u001b[111Gbesides\r\u001b[1B \u001b[3Gmemory dominates. I'll time the parts of the block-diagonal path\u001b[68Gseparate\u001b[77Gy.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gnarrow-N\u001b[16Gsgemm\u001b[22Gis\u001b[25Gthe\u001b[29Gbottleneck,\u001b[41Gso\u001b[44GI'm\u001b[48Gtrying\u001b[55GQ_bl"]
[699.693, "k\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b[85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116Gand\r\u001b[1B \u001b[3GI'll compare\u001b[16Git with the per-head path to find the crossover.\u001b[65G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gper-head\u001b[16Gpath\u001b[21Gwins\u001b[26Gbelow\u001b[32Gabout\u001b[38GT=160\u001b[44Gand\u001b[48Gthe\u001b[52Gblock-diagonal\u001b[67Gpath\u001b[72Gabove\u001b[78Git,\u001b[82Groughly\u001b[90G25%\u001b[94Gfaster\u001b[101Gat\u001b[104GT=1000,\u001b[112Gso\u001b[115GI'll\r\u001b[1B \u001b[3Gswitch between \u001b[20Gem at\u001b[26Gthat crossover and keep the per\u001b[58Ghe\u001b[61Gd p\u001b[65Gth for\u001b[72Gfixture-sized workloads.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mBuilding\u001b[12Ghybrid\u001b[19Gattention,\u001b[30Gchecking,\u001b[40Gprofiling\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mp='/Users/agentlab/pvc/cb2/cb2.c'\r\u001b[5C\u001b[1Bs\u001b[8Gopen(p).read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mdef R(a,b):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mglobal s\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert"]
[699.693, "\u001b[13Ga in s, a; s=s.replace(a,b)\r\u001b[5C\u001b[1BR(''' if\u001b[15G(c\u001b[18G==\u001b[21G1)\u001b[24G{\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m/* All heads at once''',''' if (c == 1 && T < ATT_BLOCKDIAG_MIN) {\r\u001b[8C\u001b[1Bshort context: p\u001b[26Gr-head sgemv over the\u001b[48Gstrided cache rows */\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor (in\u001b[15Gh = 0; h\u001b[24G< n\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to\u001b[17Grun in\u001b[24Gbackground)\u001b[39m\u001b[40;1H\u001b[38;3H"]
