[393.125, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsizes\u001b[15G320\u2013384\u001b[23Ghave\u001b[28Gbeen\u001b[33Gthe\u001b[37Gonly\u001b[42Gconsistently\u001b[55Gfast\u001b[60Gband,\u001b[66Gand\u001b[70Gall\u001b[74Gmy\u001b[77Gblocks\u001b[84Gfall\u001b[89Gthere,\u001b[96Gso\u001b[99GI'm\u001b[103Grunning\r\u001b[1B \u001b[3Galt\u001b[8Gnati\u001b[13Gg binaries\u001b[24Gover several run\u001b[42Gand comparing m\u001b[58Gdians. I'm also making BLOCK_MAX a build-time option f\u001b[113Gr\u001b[115Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/^#define BLOCK_MAX 384$/#ifndef BLOCK_MAX\\n#define BLOCK_MAX 384\\n#endif/' cb2.c && grep -n -A2 \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m\"ifnd\u001b[12Gf BLOCK_MAX\" cb2.c && cat > /tmp/cb2t/ab.py <<'EOF'\r\u001b[5C\u001b[1B# alternate binaries; report median of per-run metrics\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mimport subprocess, sys, statistics, re\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mbins=sys.argv[2:]; n=int(sys.argv[1]\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[393.126, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mA/B block widths with interleaved runs\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m sed -i '' 's/^#define\u001b[26GBLOCK_MAX\u001b[36G384$/#ifndef\u001b[49GBLOCK_MAX\\n#define\u001b[68GBLOCK_MAX\u001b[78G384\\n#endif/'\u001b[92Gcb2.c\u001b[98G&&\u001b["]
[393.128, "101Ggrep\u001b[106G-n\u001b[109G-A2\u001b[113G\"ifndef\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mBLOCK_MAX\"\u001b[15Gcb2.c\u001b[21G&&\u001b[24Gcat\u001b[28G>\u001b[30G/tmp/cb2t/ab.py\u001b[46G<<'EOF'\r\u001b[1B \u001b[2m\u2502\u001b[22m #\u001b[6Galternat\u001b[17Ginaries; report median of per-run metric\u001b[58G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import subproce\u001b[20Gs, sys, statistics, re\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mbins=sys.argv[2:];\u001b[23Gn=int(sys.argv[1]);\u001b[43Gres={b:[]\u001b[53Gfor\u001b[57Gb\u001b[59Gin\u001b[62Gbins}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for i in range(n):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gb\u001b[14Gin\u001b[17Gbins:\r\u001b[1B \u001b[2m\u2502\u001b[22m         out=subprocess.run(['pytho\u001b[39G3','/tmp/cb2t/dev.py',b,'2'],capture_output=True,text=True).std\u001b[103Gu\u001b[105G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G re\u001b[15G[b].append({k:floa\u001b[34G(v) for k,v in re.findall(r'(\\w+)=([\\d.]+)',out)})\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gb\u001b[10Gin\u001b[13Gbins:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     ks=res[b][0].keys()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(b.split('/')[-1],\u001b[32G'\u001b[34G'.join(f\"{k}={statistics.median(r[k]\u001b[71Gfor\u001b[75Gr\u001b[77Gin\u001b[80Gres[b]):.1f}\"\u001b[94Gfor\u001b[98Gk\u001b[100Gin\u001b[103Gks))\r\u001b[1B \u001b[2m\u2502\u001b[22m"]
[393.129, " EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for bm \u001b[13G 256 320 384 448; do cc\u001b[37G-O3 -mcpu=native -DBLOCK_MAX=$bm -o /tmp/cb2t/bm$bm cb2.c -framework Accelerate;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdone;\u001b[10Gpython3\u001b[18G/tmp/cb2t/ab.py\u001b[34G4\u001b[36G/tmp/cb2t/bm256\u001b[52G/tmp/cb2t/bm320\u001b[68G/tmp/cb2t/bm384\u001b[84G/tmp/cb2t/bm448\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for"]
[393.129, " you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
