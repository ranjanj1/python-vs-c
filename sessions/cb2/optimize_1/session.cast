[639.752, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Transpos\u001b[13Gg\u001b[15Gstraight from the mmap\u001b[38Gcuts\u001b[43Gload\u001b[48Gfrom\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1C\u001b[1B it.\u001b[7GI'll also try \u001b[38;2;87;105;247mmadvise\u001b[29G\u001b[39mhints\u001b[35Gon\u001b[38Gthe\u001b[42Gmapping.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gmadvise hints show\u001b[26Gd no mea\u001b[35Gurable ga\u001b[46G, s\u001b[50G I'm dropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Decode\u001b[10Gattention runs \u001b[26Gbout 4 ms per token against a roughly 1.2 ms bandwidth floor, because\u001b[96Gthe\u001b[100Gper-head\u001b[109Gstrided\r\u001b[1C\u001b[1B sgemv\u001b[9Gcalls are the bottleneck. I'm batching\u001b[48Gthe\u001b[5"]
