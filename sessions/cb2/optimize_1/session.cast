[1069.099, "\u001b[H\u001b[5Gat about\u001b[14G63 GB/s.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSmaller costs:\u001b[22m SwiGLU was 9%\u001b[34Gof prompt processing (one scalar\u001b[67G\u001b[38;2;87;105;247mexpf\u001b[39m per element). Long-context attention cost about\u001b[120G4\r\u001b[4C\u001b[1Bms\u001b[8Gper \u001b[13Goken.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTokenizer:\u001b[22m the\u001b[20Greference's merge l\u001b[40Go\u001b[42G took 1.6 s on a 900-wo\u001b[66Gd prom\u001b[73Gt.\u001b[76G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChang\u001b[9Gs\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWeights are stored transposed in 256-column blocks\u001b[22m,\u001b[58Gwith\u001b[63Gone\u001b[67GAccelerate\u001b[78Gcall\u001b[83Gper\u001b[87Gblock.\u001b[94GPrompt\u001b[101Gprocessing\u001b[112Gloses\r\u001b[2C\u001b[1B   nothing\u001b[14Gfrom\u001b[19Gthis\u001b[24Glayout.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mQ/K/V and W1/W3 are now separate\u001b[39Gmatrices.\u001b[22m K and V are written dir\u001b[73Gctly\u001b[78Ginto\u001b[83Gthe\u001b[87GKV \u001b[91Gache, and\u001b[101GSwiGLU runs a\u001b[115G a\u001b[118Gfew\r\u001b[5C\u001b[1Bwhole-bu\u001b[15Gfer\u001b[19GvDSP/vForce calls\u001b[37Gin\u001b[40Gthe\u001b[44Greference's\u001b[56Gorder\u001b[62Gof\u001b[65Goperations.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mThe embe\u001b[15Gding tabl\u001b[26Gis read from\u001b[39Gthe transposed classifier\u001b[22m, so\u001b[69Gthe weights are only\u001b"]
[1069.101, "[90Gheld in memory once.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mLoading transposes straight from an mmap\u001b[22m of th\u001b[53G checkpoint, with n\u001b[73G \u001b[75Gtaging\u001b[82Gcopy.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mAttention over \u001b[22G chunk\u001b[29Gof prompt\u001b[40Gokens skip\u001b[51G the ma\u001b[59Gked-out region.\u001b[22m Everything the\u001b[90Gr\u001b[92Gfere\u001b[97Gce c\u001b[102Gmputes is\u001b[112Gstill\r\u001b[2C\u001b[1B  \u001b[6Gcomputed.\u001b[K\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mFrom 160 p\u001b[17Gsitions o\u001b[27Gwards, single-token atten\u001b[53Gion handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[22m Th\u001b[112Gadds\u001b[K\r\u001b[5C\u001b[1Bmultiplications\u001b[22Gby\u001b[25Gzero\u001b[30Gbut\u001b[34Gremoves\u001b[42Gnone\u001b[47Gof\u001b[50Gthe\u001b[54Greference's\u001b[66Gwork.\u001b[72GBelow\u001b[78G160\u001b[82Gthe\u001b[86Gold\u001b[90Gper-head\u001b[99Gpath\u001b[104Gis\u001b[107Gkept\u001b[112Gbecause\r\u001b[2C\u001b[1B  \u001b[6Git is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[22m Its \u001b[76Gutput\u001b[82Gis identical to the reference\u001b[112Galgorithm\r\u001b[5C\u001b[1Bon\u001b[9G514 test texts, including\u001b[35Gthe\u001b[39Gfixtures\u001b[48Gand\u001b[52Grandom\u001b[59GUnicode.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B"]
[1069.102, "\u001b[1mResults (medians of alternating runs)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[19GWorkload\u001b[43G\u2502\u001b[47Gv1\u001b[53G\u2502\u001b[60Gv2\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[43G\u253c\u001b[53G\u253c\u001b[68G\u2524\r\u001b[4C\u001b[1BGENERATE\u001b[14G3\u00d764, fixture\u001b[28Gprompts\u001b[45G2415\u001b[50Gms\u001b[55G1450\u20131585\u001b[65Gms\r\u001b[4C\u001b[2BLOGITS \u00d73     \u001b[20G       \u001b[28G       \u001b[45G127 ms \u001b[55G97\u2013100 ms\u001b[65G  \r\u001b[4C\u001b[2BFIXED \u00d73 \u001b[47G4\u001b[56G2\u001b[58G97 ms \r\u001b[4C\u001b[2BGEN\u001b[9GRATE\u001b[14G100\u001b[18Gafter\u001b[24Ga\u001b[26G901-token\u001b[36Gprompt\u001b[45G~3.5 \u001b[55G1.3 s\u001b[61G  \r\u001b[4C\u001b[2BENCODE, 90\u001b[16G words \u001b[24G \u001b[26G         \u001b[36G      \u001b[45G1608\u001b[50Gms\u001b[55G7\u001b[57G8\u001b[59Gms\u001b[40;1H\u001b[38;3H"]
[1069.252, "\u001b[H\u001b[3G1. \u001b[1mWeights are stored transposed in 256-column blocks\u001b[22m,\u001b[58Gwith\u001b[63Gone\u001b[67GAccelerate\u001b[78Gcall\u001b[83Gper\u001b[87Gblock.\u001b[94GPrompt\u001b[101Gprocessing\u001b[112Gloses\r\u001b[2C\u001b[1B \u001b[5G nothing from this layout.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mQ/K/V and W1/W3 are now separate matrices.\u001b[49G\u001b[22mK\u001b[51Gand\u001b[55GV\u001b[57Gare\u001b[61Gwritten\u001b[69Gdirectly\u001b[78Ginto\u001b[83Gthe\u001b[87GKV\u001b[90Gcache,\u001b[97Gand\u001b[101GSwiGLU\u001b[108Gruns\u001b[113Gas\u001b[116Ga\u001b[118Gfew\r\u001b[2C\u001b[1B \u001b[5G whole-buffer vDSP/vForce calls in the reference's order of operations.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe embedding table is read from the transposed classifier\u001b[22m,\u001b[66Gso\u001b[69Gthe\u001b[73Gweights\u001b[81Gare\u001b[85Gonly\u001b[90Gheld\u001b[95Gin\u001b[98Gmemory\u001b[105Gonce.\r\u001b[2C\u001b[1B4. \u001b[1mLoading transposes straight from an mmap\u001b[47G\u001b[22mof\u001b[50Gthe\u001b[54Gcheckpoint,\u001b[66Gwith\u001b[71Gno\u001b[74Gstaging\u001b[82Gcopy.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mAtten\u001b[12Gion over a chunk of prompt\u001b[39Gtokens skips the masked-out region.\u001b[22m Everything the reference compute\u001b[108G is\u001b[112Gstill\r\u001b[5C\u001b[1Bc\u001b[8Gmputed.\u001b[K\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mFrom 160 positions o\u001b[27Gwards, si"]
[1069.253, "ngle-\u001b[42Goken attention handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[22m This adds\u001b[K\r\u001b[5C\u001b[1Bmultiplications by ze\u001b[28Go but removes non\u001b[46G of th\u001b[53G refer\u001b[60Gnce's wo\u001b[69Gk. Below\u001b[78G160\u001b[82Gthe\u001b[86Gold\u001b[90Gper-head\u001b[99Gpath\u001b[104Gis\u001b[107Gkept\u001b[112Gbecause\r\u001b[2C\u001b[1B  \u001b[6Git is faster there.\u001b[K\r\u001b[2C\u001b[1B7\u001b[6G\u001b[1mThe tokenizer cache\u001b[26G the merge candidate for each adjacent pair.\u001b[71G\u001b[22mIts output\u001b[82Gis identical\u001b[95Gto\u001b[98Gthe\u001b[102Greference\u001b[112Galgorithm\r\u001b[2C\u001b[1B  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults\u001b[11G(medians of alternating runs)\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502 \u001b[6G             Workload                \u2502   v1    \u2502      v2      \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1069.255, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GGENERATE\u001b[14G3\u00d764,\u001b[20Gfixture\u001b[28Gprompts\u001b[43G\u2502\u001b[45G2415\u001b[50Gms\u001b[53G\u2502\u001b[55G1450\u20131585\u001b[65Gms\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GLOGITS\u001b[12G\u00d73\u001b[43G\u2502\u001b[45G127\u001b[49Gms\u001b[53G\u2502\u001b[55G97\u2013100\u001b[62Gms\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[43G\u253c\u001b[53G\u253c\u001b[68G\u2524\r\u001b[4C\u001b[1BFIXED\u001b[11G\u00d73\u001b[19G        \u001b[45G124 ms\u001b[55G92\u201397 ms\r\u001b[13C\u001b[2B100 after a 901-token\u001b[36Gprompt\u001b[45G~3.\u001b[50Gs \u001b[56G.3 s    \u001b[65G  \r\u001b[4C\u001b[2BENCODE, 900\u001b[17Gwords\u001b[46G608 ms\u001b[55G7.8 ms\u001b[62G  \r\u001b[4C\u001b[2BLoad to READY\u001b[45G73 ms \u001b[55G~105 ms \r\u001b[2C\u001b[1B\u2514\u001b[43G\u2534\u001b[53G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[K\u001b[40;1H\u001b[38;3H"]
[1069.348, "\u001b[H\u001b[3G  \u001b[6Gnothing from this layout.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mQ/K/V and W1/W3 are now separate matrices.\u001b[49G\u001b[22mK\u001b[51Gand\u001b[55GV\u001b[57Gare\u001b[61Gwritten\u001b[69Gdirectly\u001b[78Ginto\u001b[83Gthe\u001b[87GKV\u001b[90Gcache,\u001b[97Gand\u001b[101GSwiGLU\u001b[108Gruns\u001b[113Gas\u001b[116Ga\u001b[118Gfew\r\u001b[2C\u001b[1B  \u001b[6Gwhole-buffer vDSP/vForce calls in the reference's ord\u001b[60Gr of operations.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe embedding table is read from the transposed classifier\u001b[22m, so the weights\u001b[81Gare\u001b[85Gonly\u001b[90Gheld\u001b[95Gin\u001b[98Gmemory\u001b[105Gonce.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mLoading tra\u001b[18Gsposes straight\u001b[39Gan mmap\u001b[22m of the checkpoint\u001b[66Gwith no staging copy.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mAttention over a chunk of prompt\u001b[39Gtokens skips the masked-out region.\u001b[22m Everything the\u001b[90Greference\u001b[100Gcomputes\u001b[109Gis\u001b[112Gstill\r\u001b[2C\u001b[1B  \u001b[6Gcomputed.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mFrom 160 positions onwards, single-token attention handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[107G\u001b[22mThis\u001b[112Gadds\r\u001b[2C\u001b[1B  \u001b[6Gmultiplications by zero but removes none of the ref"]
[1069.35, "erence's work. Below 160 the old per-head path is\u001b[107Gkept\u001b[112Gbecause\r\u001b[5C\u001b[1Bit is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[71G\u001b[22mIts\u001b[75Goutput\u001b[82Gis\u001b[85Gidentical\u001b[95Gto\u001b[98Gthe\u001b[102Greference\u001b[112Galgorithm\r\u001b[2C\u001b[1B  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502               Workload                \u2502   v1    \u2502      v2      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764, fixture prompts        \u2502 2415 ms \u2502 1450\u20131585 ms \u2502\r\u001b[2C\u001b["]
[1069.352, "1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73                             \u2502 127 ms  \u2502 97\u2013100 ms    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED \u00d73                              \u2502 124 ms  \u2502 92\u201397 ms     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 100 after a 901-token prompt \u2502 ~3.5 s  \u2502 1.3 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
