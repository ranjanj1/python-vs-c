[1071.599, "tput.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLittle speed left in decode.\u001b[34G\u001b[22mIt\u001b[37Gnow\u001b[41Greads\u001b[47Gweights\u001b[55Gat\u001b[58G57\u201360\u001b[64GGB/s\u001b[69Gagainst\u001b[77Gthe\u001b[81G63\u001b[84GGB/s\u001b[89Gceiling,\u001b[98Gand\u001b[102Gfurther\u001b[110Ggains\u001b[116Gwould\r\u001b[2C\u001b[1B \u001b[5Gneed to read less data, which \u001b[36Ghe rul\u001b[43Gs don't allow.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSlower load:\u001b[18G\u001b[22mabout 30 ms more\u001b[37Gan v1, because the weights\u001b[64Gare\u001b[68Gtransposed\u001b[79Gonce\u001b[84Gat\u001b[87Gstartup.\r\u001b[4C\u001b[1B\u001b[1mLong contexts:\u001b[22m at\u001b[23Gention\u001b[30Gis still about 2.5\u00d7 slow\u001b[55Gr than memory speed allows.\u001b[K\u001b[40;1H\u001b[38;3H"]
[1071.999, "\u001b[H\u001b[3G  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502               Workload                \u2502   v1    \u2502      v2      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764, fixture prompts        \u2502 2415 ms \u2502 1450\u20131585 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73                             \u2502 127 ms  \u2502 97\u2013100 m"]
[1072.0, "s    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED \u00d73                              \u2502 124 ms  \u2502 92\u201397 ms     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 100 after a 901-token prompt \u2502 ~3.5 s  \u2502 1.3 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ENCODE, 900 words                     \u2502 1608 ms \u2502 7.8 ms       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500"]
[1072.002, "\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY                         \u2502 73 ms   \u2502 ~105 ms      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\r\u001b[2C\u001b[1B\u001b[22m- PIECE matches\u001b[19Gevery\u001b[25Gfixture\u001b[33Gentry.\r\u001b[4C\u001b[1BF\u001b[7GXED\u001b[11Gand GENERATE agree with each\u001b[40Gother.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m stop and th\u001b[30Gedge\u001b[35Gc\u001b[37Gses still\u001b[47Gbehave\u001b[54Gas\u001b[57Gbefore.\r\u001b[4C\u001b[1BLogits over\u001b[17G600 positions a\u001b[33Gree with v1 to within 3.7\u001b[59G-5.\u001b[K\r\u001b[4C\u001b[1BA checkpoint with a separate classifier\u001b[45G(a\u001b[48Gtest copy I built\u001b[66Gand\u001b[70Gthen\u001b[75Gdeleted)\u001b[84Ggives\u001b[90Gbit-identical\u001b[104Goutput.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLittle speed left in decode.\u001b[34G\u001b[22mIt\u001b[37Gnow\u001b[41Greads\u001b[47Gweights\u001b[55Gat\u001b[58G57\u201360\u001b[64GGB/"]
[1072.003, "s\u001b[69Gagainst\u001b[77Gthe\u001b[81G63\u001b[84GGB/s\u001b[89Gceiling,\u001b[98Gand\u001b[102Gfurther\u001b[110Ggains\u001b[116Gwould\r\u001b[2C\u001b[1B \u001b[5Gneed to read less data, which \u001b[36Ghe rul\u001b[43Gs don't allow.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSlower load:\u001b[18G\u001b[22mabout 30 ms more\u001b[37Gan v1, because the weights\u001b[64Gare\u001b[68Gtransposed\u001b[79Gonce\u001b[84Gat\u001b[87Gstartup.\r\u001b[4C\u001b[1B\u001b[1mLong contexts:\u001b[22m at\u001b[23Gention\u001b[30Gis still about 2.5\u00d7 slow\u001b[55Gr than memory speed allows.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTu\u001b[8Ging \u001b[13Goise:\u001b[22m block s\u001b[27Gzes were tuned on\u001b[45Gthis\u001b[50GM1, where benchmark\u001b[70G vary by about\u001b[85G\u00b110%\u001b[90Gbetween\u001b[98Gruns.\u001b[40;1H\u001b[38;3H"]
[1072.348, "\u001b[H\r\u001b[2C\u001b[28B-\u001b[5G\u001b[1mLittle speed left in decode.\u001b[34G\u001b[22mIt\u001b[37Gnow\u001b[41Greads\u001b[47Gweights\u001b[55Gat\u001b[58G57\u201360\u001b[64GGB/s\u001b[69Gagainst\u001b[77Gthe\u001b[81G63\u001b[84GGB/s\u001b[89Gceiling,\u001b[98Gand\u001b[102Gfurther\u001b[110Ggains\u001b[116Gwould\r\u001b[2C\u001b[1B \u001b[5Gneed to read less data, which \u001b[36Ghe rul\u001b[43Gs don't allow.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSlower load:\u001b[18G\u001b[22mabout 30 ms more\u001b[37Gan v1, because the weights\u001b[64Gare\u001b[68Gtransposed\u001b[79Gonce\u001b[84Gat\u001b[87Gstartup.\r\u001b[4C\u001b[1B\u001b[1mLong contexts:\u001b[22m at\u001b[23Gention\u001b[30Gis still about 2.5\u00d7 slow\u001b[55Gr than memory speed allows.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTu\u001b[8Ging \u001b[13Goise:\u001b[22m block s\u001b[27Gzes were tuned on\u001b[45Gthis\u001b[50GM1, where benchmark\u001b[70G vary by about\u001b[85G\u00b110%\u001b[90Gbetween\u001b[98Gruns.\r\u001b[5C\u001b[1B\u001b[1mest coverage:\u001b[22m I only t\u001b[30Gted agai\u001b[39Gst\u001b[42Gthe public fixtures, not the\u001b[71Gfinal gate's inputs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
