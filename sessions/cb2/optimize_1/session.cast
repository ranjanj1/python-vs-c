[1048.928, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mv1\u001b[6Ggenerates\u001b[16G3\u00d764\u001b[21Gin\u001b[24G2415\u001b[29Gms\u001b[32Gagainst\u001b[40Gv2's\u001b[45G1450\u001b[50Gms,\u001b[54Gand\u001b[58Gthe\u001b[62Gtable\u001b[68Gshows\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[103Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[1B \u001b[3Glooks slow\u001b[14Gr\u001b[16Gthan\u001b[21Gthe model work explain\u001b[44G, so I \u001b[52Guspect the ref\u001b[67Grence's O(n\u00b2) BPE merge loop on\u001b[99Gt\u001b[103G900-word prompt,\u001b[K\r\u001b[2C\u001b[1Band I'm timing ENCODE\u001b[25Gon its \u001b[33Gwn\u001b[36Gnext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE\u001b[10Gruns\u001b[15Gat\u001b[18G1.6\u001b[22Gs\u001b[24Gper\u001b[28G900\u001b[32Gwords\u001b[38Gbecause\u001b[46Gthe\u001b[50Gtokenizer's\u001b[62Gmerge\u001b[68Gloop\u001b[73Grescans\u001b[81Gevery\u001b[87Gpair\u001b[92Geach\u001b[97Gpass.\u001b[103GI'm\u001b[107Gcaching\u001b[115Geach\r\u001b[1B \u001b[3Gadjacent pair's merge candidate so\u001b[38Gonly the two neighbour\u001b[62Gof a merge\u001b[73Gg\u001b[75Gt recomputed, then \u001b[96Gecking\u001b[103Gthe\u001b[107Gnew e\u001b[113Gcoder\u001b[K\r\u001b[3C\u001b[1Bgainst v1 on many randomised texts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;1"]
[1048.93, "02mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gnew\u001b[11Gencoder\u001b[19Gnow\u001b[23Gmatches\u001b[31Gthe\u001b[35Greference\u001b[45Gon\u001b[48Gall\u001b[52G514\u001b[56Gtest\u001b[61Gtexts,\u001b[68Gand\u001b[72GENCODE\u001b[79Gfor\u001b[83G900\u001b[87Gwords\u001b[93Gfell\u001b[98Gfrom\u001b[103G1608\u001b[108Gms\u001b[111Gto\u001b[114G7.8\u001b[118Gms.\r\u001b[1B \u001b[3GI'm\u001b[7Grunni\u001b[13Gg the\u001b[19Gfull validation\u001b[35Gsuite on the\u001b[48Gfinal build next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery\u001b[9Gcheck\u001b[15Gpasses\u001b[22Gon\u001b[25Gthe\u001b[29Gfinal\u001b[35Gbuild,\u001b[42Gand\u001b[46Gsince\u001b[52Ggeneration\u001b[63Gtimings\u001b[71Gvary\u001b[76Gbetween\u001b[84Gruns,\u001b[90GI'll\u001b[95Greport\u001b[102Granges.\u001b[110GNext\u001b[115GI'm\r\u001b[1B \u001b[3Gcopying the\u001b[16Grofiling\u001b[25Gscripts into prof/ and updati\u001b[55Gg NOTES.md.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsupplied\u001b[16Gmodel\u001b[22Gdoesn't\u001b[30Gexercise\u001b[39Gthe\u001b[43Gunshared-classifier\u001b[63Gpath,\u001b[69Gso\u001b[72GI'm\u001b[76Gbuilding\u001b[85Ga\u001b[8"]
