[3.575, "\u001b[H\u001b[3G- The argmax from FIXED agrees with the token\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[5C\u001b[1Brocessing 600 positions in groups gives the same logits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[8C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-\u001b[37Goken pr\u001b[45Gmpt\u001b[49Ggives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[28G\u253c\u001b[48G\u2524\r\u001b[4C\u001b[1BLoad\u001b[10Gto\u001b[13GREADY\u001b[30Gabout\u001b[36G0.1\u001b[40Gs\r\u001b[4C\u001b[2BGeneration   \u001b[36G79 tokens/s\r\u001b[4C\u001b[2BFIXED w\u001b[13Gth\u001b[16G1024\u001b[21Gtokens\u001b[36G0.42 s     \r\u001b[2C\u001b[1B\u2514\u001b[28G\u2534\u001b[48G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is limited by memory speed: it reads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b"]
[3.577, "[2C\u001b[1Bhere.\u001b[9GTrying\u001b[16G\u001b[38;2;87;105;247msgemm\u001b[22G\u001b[39minstead,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md doesn'\u001b[55G cover these cases)\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumerics:\u001b[15G\u001b[22mresults\u001b[23Gdiffer\u001b[30Gslightly\u001b[39Gfrom\u001b[44Gthe\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[2C\u001b[1B  greedy generation could in principle pick a different token than the reference.\r\u001b[4C\u001b[1B\u001b[1mStop order:\u001b[22m in GENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[39m is checked fi\u001b[49Gst, then\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m, then \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[77G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[22m \u001b[18G prompt \u001b[27Gonger than 1024 to\u001b[46Gens answers \u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand \u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[2C\u001b[1B \u001b[5Grunning the\u001b[17Gmodel.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mmpty pi\u001b["]
[3.578, "14Gces:\u001b[19G\u001b[22mPIECE pri\u001b[29Gts \u001b[38;2;87;105;247mHEX \u001b[39m with nothi\u001b[48Gg\u001b[51Gfter it for an empty piece. That include\u001b[92G the\u001b[97Graw byte \u001b[38;2;87;105;247m<0x00>\u001b[39m, because\r\u001b[4C\u001b[1Bthe reference treats\u001b[26Gpieces\u001b[33Gas\u001b[36GC\u001b[38Gstrings.\r\u001b[4C\u001b[1B\u001b[1mBad in\u001b[12Gut:\u001b[22m malformed commands, out-of-range ids, and FIXED/LOGITS with more than 1024 ids get an \u001b[38;2;87;105;247mERR \u2026\u001b[39m line.\u001b[114G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m it isn't zero\u001b[29Gd between commands.\u001b[49GEach\u001b[54Gcommand\u001b[62Gwrites\u001b[69Gevery\u001b[75Gposition\u001b[84Gbefore\u001b[91Greading\u001b[99Git,\u001b[103Gso\u001b[106Gnothing\u001b[114Gcarries\r\u001b[2C\u001b[1B \u001b[5Gover.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mScope:\u001b[22m I only tes\u001b[23Ged against th\u001b[37G public fixtures, and the f\u001b[65Gnal\u001b[69Ggate use\u001b[78G other inputs.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GBrewed for 5m 55s \u00b7 done 8:49 AM\u001b[39m\u001b[K\r\u001b[102C\u001b[1B\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
