[992.607, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gat\u001b[14Gfixture\u001b[22Gsize\u001b[27Gdropped\u001b[35Gfrom\u001b[40G614\u001b[44Gto\u001b[47G455\u001b[51Gms,\u001b[55Gand\u001b[59Gthe\u001b[63G1024-token\u001b[74Gcase\u001b[79Gnow\u001b[83Gruns\u001b[88Ginto\u001b[93Gsoftmax\u001b[101Gexp\u001b[105Gwork\u001b[110Gthe\r\u001b[2C\u001b[1Breference also does,\u001b[24Gso\u001b[27GI'm\u001b[31Gstopping\u001b[40Goptimisation\u001b[53Gthere.\u001b[60GNext\u001b[65GI'll\u001b[70Grun\u001b[74Gan\u001b[77Galternating\u001b[89Ghead-to-head\u001b[102Gagainst\u001b[110Gv1\u001b[113Gand\u001b[117Ga\r\u001b[2C\u001b[1Blong-context\u001b[16Gcomparison.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mv1\u001b[6Ggenerates\u001b[16G3\u00d764\u001b[21Gin\u001b[24G2415\u001b[29Gms\u001b[32Gagainst\u001b[40Gv2's\u001b[45G1450\u001b[50Gms,\u001b[54Gand\u001b[58Gthe\u001b[62Gtable\u001b[68Gshows\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[103Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[2C\u001b[1Blooks slower than the\u001b[25Gmodel\u001b[31Gwork\u001b[36Gexplains,\u001b[46Gso\u001b[49GI\u001b[51Gsuspect\u001b[59Gthe\u001b[63Greference's\u001b[75GO(n\u00b2)\u001b[81GBPE\u001b[85Gmerge\u001b[91Gloop\u001b[96Gon\u001b[99Gthe\u001b[103"]
[992.608, "G900-word\u001b[112Gprompt,\r\u001b[2C\u001b[1Band\u001b[7GI'm\u001b[11Gtiming\u001b[18GENCODE\u001b[25Gon\u001b[28Gits\u001b[32Gown\u001b[36Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE runs at 1.6 s\u001b[24Gper\u001b[28G900\u001b[32Gwords\u001b[38Gbecause\u001b[46Gthe\u001b[50Gtokenizer's\u001b[62Gmerge\u001b[68Gloop\u001b[73Grescans\u001b[81Gevery\u001b[87Gpair\u001b[92Geach\u001b[97Gpass.\u001b[103GI'm\u001b[107Gcaching\u001b[115Geach\r\u001b[2C\u001b[1Badjacent\u001b[12Gpair's\u001b[19Gmerge\u001b[25Gcandidate\u001b[35Gso\u001b[38Gonly\u001b[43Gthe\u001b[47Gtwo\u001b[51Gneighbours\u001b[62Gof\u001b[65Ga\u001b[67Gmerge\u001b[73Gget\u001b[77Grecomputed,\u001b[89Gthen\u001b[94Gchecking\u001b[103Gthe\u001b[107Gnew\u001b[111Gencoder\r\u001b[1B \u001b[3Gagainst v1 on many\u001b[22Grandomised texts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The new encoder now matches the reference on all 514 test texts, and ENCODE for 900 words fell from 1608 ms to 7.8 ms.\r\u001b[2C\u001b[1BI'm running the full validation suite on the final build next.\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38"]
[992.61, ";2;0;0;0m\u23fa\u001b[39m Every check passes on the final build, and since generation timings vary between\u001b[84Gruns,\u001b[90GI'll\u001b[95Greport\u001b[102Granges.\u001b[110GNext\u001b[115GI'm\r\u001b[1C\u001b[1B copying the profiling scripts into\u001b[38Gprof/\u001b[44Gand\u001b[48Gupdating\u001b[57GNOTES.md.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Saving\u001b[10Gprofiling s\u001b[22Grip\u001b[26Gs into project\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ mkdir -p prof && cp /tmp/cb2t/{dev.py,ab.py,profrun.sh,bw.c,sweep.c,sweep2.c,gemm.c,attn.c,attn2.c,enc.py,cmp2.py\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m,ctx.py,t.py,longgen.py} prof/ && ls prof && grep -n \"^static\\|^#define\" cb2.c | head -40 && wc -l cb2.c\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2722\u001b[3G\u001b[38;2;238;142;110mDrizzling\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(16m 8s \u00b7 \u2193\u001b[26G58.1k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
