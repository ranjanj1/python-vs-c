[684.554, "1B\u001b[2m\u2502\u001b[22m     t=now()-t; if(t<best[3])best[3]=t; sink+=out[3];\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[7G\u001b[22m}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    printf(''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms=s.replace('head-major\u001b[28Gsgemv\u001b[34G%.3f\u001b[39Gms\\\\n\",T,best[0]*1e3,best[1]*1e3,best[2]*1e3);','head-major\u001b[99Gsgemv\u001b[105G%.3f\u001b[110Gms\r\u001b[1B \u001b[2m\u2502\u001b[22m blockdiag-TT %.3f\\\\n\",T,best[0]*1e3,best[1]*1e3,best[2]*1\u001b[62G3,best[3]*1e3);')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s=s.replace('int\u001b[21GTs[]={8,40,100,300,600,1000};\\n  for(i\u001b[60Gt ti=0;ti<6;ti++)','int\u001b[84GTs[]={8,24,40,64,100,300,1000};\\n\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor(int\u001b[12Gti=0;ti<7;ti++)')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m open('attn.c','w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m cc\u001b[7G-O2 -o attn attn.c -framework Accelerate\u001b[48G&& ./attn\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[684.555, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and allow \u001b[1m/private/tmp/cb2t\u001b[22m access and \u001b[1mpython3 -, cc -O2 -o attn attn.c -framework Accelerate\u001b[22m,\u001b[107Gand\u001b[111G\u001b[1m./attn\r\u001b[6C\u001b[1B\u001b[22mcommands\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
