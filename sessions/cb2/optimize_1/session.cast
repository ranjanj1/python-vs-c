[242.382, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWidths\u001b[10Gof\u001b[13G256\u001b[17Gto\u001b[20G384\u001b[24Gcolumns\u001b[32Ghold\u001b[37Gsteady\u001b[44Gnear\u001b[49G63\u001b[52GGB/s,\u001b[58Gand\u001b[62Gthe\u001b[66Gearlier\u001b[74G512\u001b[78Greading\u001b[86Gdid\u001b[90Gnot\u001b[94Greproduce.\u001b[105GNext\u001b[110GI'll\u001b[115Gstore\r\u001b[1B \u001b[3Gw\u001b[9Gs \u001b[13Gansposed in 256\u2013384\u001b[33Gcolumn blocks, with sgemv\u001b[60Gor decode and sgemm\u001b[80Gfor prefill.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Grose\u001b[19Gfrom\u001b[24G80\u001b[27Gto\u001b[30G131.5\u001b[36Gtok/s\u001b[42G(1.64\u00d7)\u001b[50Gwith\u001b[55Gthe\u001b[59Gfull\u001b[64Gcheck\u001b[70Gstill\u001b[76Gpassing,\u001b[85Gthough\u001b[92Gload\u001b[97Gtime\u001b[102Gwent\u001b[107Gup\u001b[110Gfrom\u001b[115Gabout\r\u001b[1B \u001b[3G80 to 124 ms because of the transposition. I'm adding section timer\u001b[71G to \u001b[38;2;87;105;247mcb2.c\u001b[39m behind \u001b[38;2;87;105;247m-DPROF\u001b[95G\u001b[39ms\u001b[98Gprofiling ca\u001b[111G be\u001b[K\r\u001b[2C\u001b[1Breproduce\u001b[13G.\u001b[K\r\u001b[2C\u001b[4BWeight produ\u001b[16Gts now run near the 63 GB/s read ceiling, and weight \u001b[70Gt\u001b[74Gming is still about 96% of decod"]
[242.382, "e time. Next\r\u001b[2C\u001b[1BI'm profiling prefi\u001b[23Gl and load, s\u001b[37Gnce LOGITS and FIXED each take roughly 42 ms on 69\u201382 tokens.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mProfiling\u001b[13Gprefill\u001b[21G(FIXED)\u001b[29Gsections\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cc -O3\u001b[15G-mcpu=native -DPROF -o /tmp/cb2t/cb2prof cb2.c -framework Accelerate && python3 -c \"\r\u001b[5C\u001b[1Bimport json;fx=json.load(open('fixtures.json'))\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mprint(''.join('FIXED '+' '.join(map(str,p['seq']))+'\\n' for p in fx['prompts']*5)+'QUIT')\" | /tmp/cb2t/cb2prof \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mmodel.bin tokenizer.bin >/dev/null; echo; pyth\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
