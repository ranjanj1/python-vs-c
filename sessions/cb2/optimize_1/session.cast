[515.649, "\u001b[H\r\u001b[2C\u001b[2BBlock sizes 320\u2013384 have been th\u001b[36G only consi\u001b[48Gtently fast ba\u001b[63Gd,\u001b[66Gand all my blocks fall\u001b[89Gthere, so I\u001b[101Gm\u001b[103Grunning\u001b[K\r\u001b[2C\u001b[1Balternating bin\u001b[20Gie\u001b[23G over several runs and comparing medians. I'm also\u001b[74Gmaking BLOCK_MAX a build-time op\u001b[108Gon for\u001b[115Gthat.\r\u001b[6C\u001b[2B\u001b[38;2;102;102;102m\u001b[1m1\u001b[22G\u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BDecode holds\u001b[16Gat about 126 \u001b[30Gok/s acr\u001b[39Gss\u001b[42Gwidths 256 to 448, but width\u001b[71G256\u001b[75Gprefills 17% faster,\u001b[96Gso I'm making it the\r\u001b[2C\u001b[1Bdefault. Next I'll test whether\u001b[35Gtransposing directly from an mmap of the\u001b[76Gcheckpoint\u001b[87Gbeats the staging copy\u001b[110Gfor\u001b[114Gload\r\u001b[2C\u001b[1Btime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing straight f\u001b[26Gom the\u001b[33Gmmap cuts load from\u001b[53Gabout 114 to\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[2C\u001b[1Bit.\u001b[7GI'll\u001b[12Galso\u001b[17Gtry\u001b[21G\u001b[38;2;87;105;247mmadvise\u001b[29G"]
[515.65, "\u001b[39mhints\u001b[35Gon\u001b[38Gthe\u001b[42Gmapping.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mA/B\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gon\u001b[24Gload\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed 's| if (map == MAP_FAILED) { fprintf(stderr, \"mmap failed\\\\n\"); exit(1); }|&\\n madvise(map, (size_t)fsize, \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mMADV_SEQUENTIAL); madvise(map, (size_t)fsize, MADV_WILLNEED);|' cb2.c > /tmp/cb2t/madv.c && grep -c madvise \u001b[115G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m/tmp/cb2t/madv.c && cc -O3 -mcpu=native -o /tmp/cb2t/madv /tmp/cb2t/madv.c -fr\u2026\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode h"]
[515.651, "andles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mA/B madvise hints on load\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m sed 's|    if (map ==\u001b[26GMAP_FAILED)\u001b[38G{\u001b[40Gfprintf(stderr,\u001b[56G\"mmap\u001b[62Gfailed\\\\n\");\u001b[75Gexit(1);\u001b[84G}|&\\n\u001b[93Gmadvise(map,\u001b[106G(size_t)fsize,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mMADV_SEQUENTIAL);\u001b[22Gmadvise(map,\u001b[35G(size_t)fsize,\u001b[50GMADV_WILLNEED);|'\u001b[68Gcb2.c\u001b[74G>\u001b[76G/tmp/cb2t/madv.c\u001b[93G&&\u001b[96Ggrep\u001b[101G-c\u001b[104Gmadvise\r\u001b[1B \u001b[2m\u2502\u001b[22m /tmp/cb2t/madv.c &&\u001b[24Gcc -O3 -mcpu=native -o /tmp/cb2t/madv /\u001b[64Gmp/cb2t/madv.c -fram\u001b[85Gwork Accelerate && cp cb2\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m"]
[515.651, " /tmp/cb2t/mmap && python3 /tmp/cb2\u001b[39G/ab.py 4 /tmp/cb2t/mmap\u001b[63G/tmp/cb2t/madv\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[26G\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gsed\u001b[41G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
