[508.344, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt M=76, the blocked layout gets about 570 GFLOP/s in sgemm, nearly th\u001b[74G same as the\u001b[87Gorig\u001b[93Gal 586, so pr\u001b[107Gfill\u001b[112Gis\r\u001b[2C\u001b[1Bunaffected.\u001b[15GI'm\u001b[19Gsplitting\u001b[29GW1/W3\u001b[35Gand\u001b[39GQ/K/V\u001b[45Ginto\u001b[50Gseparate\u001b[59Gblocked\u001b[67Gmatrices\u001b[76Gnext,\u001b[82Gthen\u001b[87Glooking\u001b[95Gat\u001b[98Gload\u001b[103Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration f\u001b[16Gll to\u001b[22G110\u2013116 tok/s,\u001b[37Gand the classifier\u001b[56Galso slowed\u001b[68Gabout\u001b[74G9%\u001b[77Gdespite\u001b[85Gno\u001b[88Gcode\u001b[93Gchange,\u001b[101Gso\u001b[104Gthis\u001b[109Glooks\u001b[115Glike\r\u001b[2C\u001b[1Bmachine\u001b[11Gnoise.\u001b[18GI'm\u001b[22Gre-running\u001b[33Gthe\u001b[37Gbandwidth\u001b[47Gprobe\u001b[53Gto\u001b[56Gconfirm.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mB\u001b[5Gock sizes\u001b[15G320\u2013384 ha\u001b[27G be\u001b[31Gn the\u001b[37Gonly\u001b[42Gconsistently fast band, and all\u001b[75Gy blocks fall there, so I'\u001b[102G runn\u001b[108Gng\u001b[111"]
[508.345, "G\u001b[K\r\u001b[2C\u001b[1Balternating\u001b[15Gbinaries\u001b[24Gover\u001b[29Gseveral\u001b[37Gruns\u001b[42Gand\u001b[46Gcomparing\u001b[56Gmedians.\u001b[65GI'm\u001b[69Galso\u001b[74Gmaking\u001b[81GBLOCK_MAX\u001b[91Ga\u001b[93Gbuild-time\u001b[104Goption\u001b[111Gfor\u001b[115Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mD\u001b[5Gcode holds at about 126 tok/s\u001b[35Gacro\u001b[40Gs w\u001b[44Gdths 256 to\u001b[56G448,\u001b[61Gbut width 256 prefills 17% f\u001b[90Gster, so I'm making\u001b[110Git the\u001b[K\r\u001b[2C\u001b[1Bdefault.\u001b[12GNext\u001b[17GI'll\u001b[22Gtest\u001b[27Gwhether\u001b[35Gtransposing\u001b[47Gdirectly\u001b[56Gfrom\u001b[61Gan\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[2C\u001b[1Btime.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m A/B mmap-transpose vs pread-staging\u001b[39Gload\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp\u001b[8G'/Users/agentlab/pvc/cb2/cb2.c'\r\u001b[5C\u001b[1Bs=open(p).read()\r\u001b[5C\u001b[1Bdef R(a,b):\r\u001b[5C\u001b[1Bglobal\u001b[13Gs\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert a\u001b[15Gin s, a; s=s.\u001b[29Geplace(a,b)\u001b[3"]
