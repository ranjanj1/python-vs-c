[516.115, "\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6GM=76,\u001b[12Gthe\u001b[16Gblocked\u001b[24Glayout\u001b[31Ggets\u001b[36Gabout\u001b[42G570\u001b[46GGFLOP/s\u001b[54Gin\u001b[57Gsgemm,\u001b[64Gnearly\u001b[71Gthe\u001b[75Gsame\u001b[80Gas\u001b[83Gthe\u001b[87Goriginal\u001b[96G586,\u001b[101Gso\u001b[104Gprefill\u001b[112Gis\r\u001b[2C\u001b[1Bunaffected. I'm splitting\u001b[29GW1/W3\u001b[35Gand\u001b[39GQ/K/V\u001b[45Ginto\u001b[50Gseparate\u001b[59Gblocked\u001b[67Gmatrices\u001b[76Gnext,\u001b[82Gthen\u001b[87Glooking\u001b[95Gat\u001b[98Gload\u001b[103Gtime.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGen\u001b[7Gration\u001b[14Gfell\u001b[19Gto\u001b[22G110\u2013116\u001b[30Gtok/s,\u001b[37Gand\u001b[41Gthe\u001b[45Gclassifier\u001b[56Galso\u001b[61Gslowed\u001b[68Gabout\u001b[74G9%\u001b[77Gdespite\u001b[85Gno\u001b[88Gcode\u001b[93Gchange,\u001b[101Gso\u001b[104Gthis\u001b[109Glooks\u001b[115Glike\r\u001b[2C\u001b[1Bmachine\u001b[11Gnoise.\u001b[18GI'm\u001b[22Gre-running\u001b[33Gthe\u001b[37Gbandwidth\u001b[47Gprobe\u001b[53Gto\u001b[56Gconfirm.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock "]
[516.117, "sizes 320\u2013384 have bee\u001b[32G the only\u001b[42Gcons\u001b[47Gstently\u001b[55Gfast\u001b[60Gband,\u001b[66Gand\u001b[70Gall\u001b[74Gmy\u001b[77Gblocks\u001b[84Gfall\u001b[89Gthere,\u001b[96Gso\u001b[99GI'm\u001b[103Grunning\r\u001b[2C\u001b[1Balternating\u001b[15Gbinaries\u001b[24Gover\u001b[29Gseveral\u001b[37Gruns\u001b[42Gand\u001b[46Gcomparing\u001b[56Gmedians.\u001b[65GI'm\u001b[69Galso\u001b[74Gmaking\u001b[81GBLOCK_MAX\u001b[91Ga\u001b[93Gbuild-time\u001b[104Goption\u001b[111Gfor\u001b[115Gthat.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode holds at about 126 tok/s across widths 256 to 448, but width 256 prefills 17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[2C\u001b[1Bdefault.\u001b[12GNext\u001b[17GI'll\u001b[22Gtest\u001b[27Gwhether\u001b[35Gtransposing\u001b[47Gdirectly\u001b[56Gfrom\u001b[61Gan\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[1B  time.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Transposing straight from the mmap cuts load from about 114 to 103 ms with no effect o"]
[516.118, "n anything else, so I'm keeping\u001b[K\r\u001b[1C\u001b[1B it. I\u001b[9Gll\u001b[12Galso try \u001b[38;2;87;105;247mmadvise\u001b[39m hints on\u001b[38Gthe mapping.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m A\u001b[5GB madvise hints\u001b[21Gon\u001b[24Gload\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed 's| if (map == MAP_FAILED) { fprintf(stderr, \"mmap failed\\\\n\"); exit(1); }|&\\n madvise(map, (size_t)fsize, \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mMADV_SEQUENTIAL); madvise(map, (size_t)fsize, MADV_WILLNEED);|' cb2.c > /tmp/cb2t/madv.c && grep -c madvise \u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102m/tmp/cb2t/madv.c && cc -O3 -mcpu=native -o /tmp/cb2t/madv /tmp/cb2t/madv.c -fr\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[39m \u001b[38;2;219;123;91mDrizzling\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(8m 23s \u00b7 \u2193\u001b[26G36.1k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G    \u001b[37G   \u001b[41G \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
