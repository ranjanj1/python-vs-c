[600.459, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing straight\u001b[24Gfrom\u001b[29Gthe\u001b[33Gmmap\u001b[38Gcuts\u001b[43Gload\u001b[48Gfrom\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[2C\u001b[1Bit.\u001b[7GI'll\u001b[12Galso\u001b[17Gtry\u001b[21G\u001b[38;2;87;105;247mmadvise\u001b[29G\u001b[39mhints\u001b[35Gon\u001b[38Gthe\u001b[42Gmapping.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gshowed\u001b[28Gno\u001b[31Gmeasurable\u001b[42Ggain,\u001b[48Gso\u001b[51GI'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode attention runs about 4 ms per token against\u001b[54Ga\u001b[56Groughly\u001b[64G1.2\u001b[68Gms\u001b[71Gbandwidth\u001b[81Gfloor,\u001b[88Gbecause\u001b[96Gthe\u001b[100Gper-head\u001b[109Gstrided\r\u001b[2C\u001b[1Bsgemv\u001b[9Gcalls\u001b[15Gare\u001b[19Gthe\u001b[23Gbottleneck.\u001b[35GI'm\u001b[39Gbatching\u001b[48Gthe\u001b[52G12\u001b[55Ghead\u001b[60G"]
