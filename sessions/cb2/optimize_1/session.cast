[905.609, "\u001b[H\r\u001b[2C\u001b[2BAll three builds match within 3.7e-5\u001b[40Gover\u001b[45G600 po\u001b[52Gitions, covering the block-diag\u001b[84Gnal decode path and causal row\u001b[K\r\u001b[2C\u001b[1Bgr\u001b[6Gups. I'm re-profiling the fixture-s\u001b[42Gzed\u001b[46Gprefill n\u001b[56Gx\u001b[58G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gat\u001b[14Gfixture\u001b[22Gsize\u001b[27Gdropped\u001b[35Gfrom\u001b[40G614\u001b[44Gto\u001b[47G455\u001b[51Gms,\u001b[55Gand\u001b[59Gthe\u001b[63G1024-token\u001b[74Gcase\u001b[79Gnow\u001b[83Gruns\u001b[88Ginto\u001b[93Gsoftmax\u001b[101Gexp\u001b[105Gwork\u001b[110Gthe\r\u001b[1B \u001b[3Greference also\u001b[18Gdoes,\u001b[24Gso I'm st\u001b[34Gpping optimisation ther\u001b[58G. Next I'l\u001b[69G run an \u001b[78Glternating head-to-head against v1 and a\u001b[K\r\u001b[2C\u001b[1Blong-context compa\u001b[22Gison.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mv1\u001b[6Ggenerates\u001b[16G3\u00d764\u001b[21Gin\u001b[24G2415\u001b[29Gms\u001b[32Gagainst\u001b[40Gv2's\u001b[45G1450\u001b[50Gms,\u001b[54Gand\u001b[58Gthe\u001b[62Gtable\u001b[68Gshows\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[1"]
[905.61, "03Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[1B \u001b[3Glooks slower tha\u001b[20G the mod\u001b[29Gl\u001b[31Gwork \u001b[37Gxplains, so I suspect \u001b[60Ghe refere\u001b[70Gce's \u001b[76G(n\u00b2) BPE merge loop on the\u001b[103G90\u001b[106G-word prompt,\u001b[K\r\u001b[2C\u001b[1Band\u001b[7GI'm timing ENCODE on its \u001b[33Gwn next.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE runs at 1.6 s per 900 words because the tokenizer's merge loop rescans every pair each pass. I'm caching\u001b[115Geach\r\u001b[2C\u001b[1Badjacent pair's merge candidate so only the two neighbours of a merge get recomputed, then checking\u001b[103Gthe\u001b[107Gnew\u001b[111Gencoder\r\u001b[2C\u001b[1Bagainst\u001b[11Gv1\u001b[14Gon\u001b[17Gmany\u001b[22Grandomised\u001b[33Gtexts.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The new encoder now matches the reference\u001b[45Gon\u001b[48Gall\u001b[52G514\u001b[56Gtest\u001b[61Gtexts,\u001b[68Gand\u001b[72GENCODE\u001b[79Gfor\u001b[83G900\u001b[87Gwords\u001b[93Gfell\u001b[98Gfrom\u001b[103G1608\u001b[108Gms\u001b[111Gto\u001b[114G7.8\u001b[118Gms.\r\u001b[1B  I'm running the full validation "]
[905.611, "suite on the final build next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Full final validation and benchmark\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 check.py -- ./cb2 && python3 check.py --tokens 64 --prompts 3 -- ./cb2 | tail -1 && python3 \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m/tmp/cb2t/t.py && python3 /tmp/cb2t/ctx.py && python3 /tmp/cb2t/cmp2.py && cp cb2 /tmp/cb2t/v2 && python3 \u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102m/tmp/cb2t/longgen.py /tmp/cb2t/v1 /tmp/cb2t/v2 && python3 /tmp/cb2t/ab.py 5 /tmp/cb2t/v1 /t\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u273d\u001b[39m \u001b[38;2;223;127;95mDrizzling\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(14m 42s \u00b7 \u2193\u001b[27G57.4k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G    \u001b[37G       \u001b[45G \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[905.611, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
