[344.371, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWidths\u001b[10Gof\u001b[13G256\u001b[17Gto\u001b[20G384\u001b[24Gcolumns\u001b[32Ghold\u001b[37Gsteady\u001b[44Gnear\u001b[49G63\u001b[52GGB/s,\u001b[58Gand\u001b[62Gthe\u001b[66Gearlier\u001b[74G512\u001b[78Greading\u001b[86Gdid\u001b[90Gnot\u001b[94Greproduce.\u001b[105GNext\u001b[110GI'll\u001b[115Gstore\r\u001b[1B \u001b[3Gweig\u001b[8Gts transposed in 256\u2013384 column blocks, with sgemv for d\u001b[65Gcode and\u001b[74Gsgemm for prefill.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Grose\u001b[19Gfrom\u001b[24G80\u001b[27Gto\u001b[30G131.5\u001b[36Gtok/s\u001b[42G(1.64\u00d7)\u001b[50Gwith\u001b[55Gthe\u001b[59Gfull\u001b[64Gcheck\u001b[70Gstill\u001b[76Gpassing,\u001b[85Gthough\u001b[92Gload\u001b[97Gtime\u001b[102Gwent\u001b[107Gup\u001b[110Gfrom\u001b[115Gabout\r\u001b[1B \u001b[3G80 to 124 ms b\u001b[18Gcause\u001b[24Gof\u001b[28Ghe transp\u001b[38Gsition\u001b[45G I'm\u001b[50Gadding section timer\u001b[71G to \u001b[38;2;87;105;247mcb2.c\u001b[39m behind \u001b[38;2;87;105;247m-DPROF\u001b[39m so profiling can be\u001b[115G\u001b[K\r\u001b[2C\u001b[1Brepr\u001b[8Gduced.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;1"]
[344.371, "02;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gproducts\u001b[19Gnow\u001b[23Grun\u001b[27Gnear\u001b[32Gthe\u001b[36G63\u001b[39GGB/s\u001b[44Gread\u001b[49Gceiling,\u001b[58Gand\u001b[62Gweight\u001b[69Gstreaming\u001b[79Gis\u001b[82Gstill\u001b[88Gabout\u001b[94G96%\u001b[98Gof\u001b[101Gdecode\u001b[108Gtime.\u001b[114GNext\r\u001b[1B \u001b[3GI'm profiling prefill and load, since LOGITS and FIXED\u001b[58Geach take roughly 42\u001b[79Gm\u001b[82Gon 69\u201382 tokens.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gis\u001b[14Gmostly\u001b[21Gspent\u001b[27Gin\u001b[30Gthe\u001b[34Gweight\u001b[41Gmatmuls\u001b[49G(about\u001b[56G84%,\u001b[61Gonly\u001b[66G~450\u001b[71GGFLOP/s\u001b[79Gat\u001b[82GM\u224876),\u001b[89Gwith\u001b[94GSwiGLU's\u001b[103Gscalar\u001b[110Gexpf\u001b[115Gtaking\r\u001b[1B \u001b[3G9%. I'\u001b[10Gl benchmark sgemm layouts for M\u224876 and\u001b[49GM=512 to see whether the block layout is costing prefill time.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6GM=76,\u001b[12Gthe\u001b[16Gblocked\u001b[24Glayout\u001b[31Ggets\u001b[36"]
[344.372, "Gabout\u001b[42G570\u001b[46GGFLOP/s\u001b[54Gin\u001b[57Gsgemm,\u001b[64Gnearly\u001b[71Gthe\u001b[75Gsame\u001b[80Gas\u001b[83Gthe\u001b[87Goriginal\u001b[96G586,\u001b[101Gso\u001b[104Gprefill\u001b[112Gis\r\u001b[1B \u001b[3Gunaffected. I'm splitting W1/W3 and Q/K/V into separate blocked matric\u001b[74Gs next, then\u001b[87Glook\u001b[93Gg at load tim\u001b[107G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mBuild,\u001b[10Gcheck,\u001b[17Gcompare\u001b[25Gchunked,\u001b[34Gtime,\u001b[40Gprofile\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ sed -i '' 's/, qkvd, kv_mul, shared_cls;/, kv_mul, shared_cls;/; s/ kv_mul = nh \\/ nkv; qkvd = dim + 2 \\* kvd;/ \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mkv_mul =\u001b[15Gnh\u001b[18G\\/ nkv;/' cb2.c &&\u001b[37G./build.sh &&\u001b[51Gpython3\u001b[59Gc\u001b[61Geck.py --tokens 64 --prompts 3 -- ./cb2\u001b[101G|\u001b[103Gtail -4\u001b[111G&&\u001b[114Gpython3\r\u001b[5C\u001b[1B/tmp/cb2t/cmp.py && for i in 1\u001b[37G2; do pyt\u001b[47Gon3\u001b[51G/tmp/cb2t/dev\u001b[68G./cb2; \u2026\u001b[77G(3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+\u001b[13G \u001b[15Go run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
