[908.628, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gthree\u001b[13Gbuilds\u001b[20Gmatch\u001b[26Gwithin\u001b[33G3.7e-5\u001b[40Gover\u001b[45G600\u001b[49Gpositions,\u001b[60Gcovering\u001b[69Gthe\u001b[73Gblock-diagonal\u001b[88Gdecode\u001b[95Gpath\u001b[100Gand\u001b[104Gcausal\u001b[111Grow\r\u001b[1B \u001b[3Ggroups. I'm re-profiling \u001b[30Ge fixture-sized prefill next.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gat\u001b[14Gfixture\u001b[22Gsize\u001b[27Gdropped\u001b[35Gfrom\u001b[40G614\u001b[44Gto\u001b[47G455\u001b[51Gms,\u001b[55Gand\u001b[59Gthe\u001b[63G1024-token\u001b[74Gcase\u001b[79Gnow\u001b[83Gruns\u001b[88Ginto\u001b[93Gsoftmax\u001b[101Gexp\u001b[105Gwork\u001b[110Gthe\r\u001b[1B \u001b[3Greference also do\u001b[21Gs, so\u001b[27GI'm stopping\u001b[40Goptimisation there. N\u001b[62Gxt I'll ru\u001b[74Gan alternating head-to-head against\u001b[110Gv1 and\u001b[117Ga\r\u001b[2C\u001b[1Blong-context comparison.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mv1\u001b[6Ggenerates\u001b[16G3\u00d764\u001b[21Gin\u001b[24G2415\u001b[29Gms\u001b[32Gagainst\u001b[40Gv2's\u001b[45G1450\u001b[50Gms,\u001b[54Gand\u001b[58Gthe\u001b[62Gtable\u001b[68Gshows"]
[908.629, "\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[103Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[1B \u001b[3Glooks slow\u001b[14Gr\u001b[16Gthan\u001b[21Gthe model work explain\u001b[44G, so I \u001b[52Guspect the ref\u001b[67Grence's O(n\u00b2) BPE merge loop on\u001b[99Gt\u001b[103G900-word prompt,\u001b[K\r\u001b[2C\u001b[1Band I'm timing ENCODE\u001b[25Gon its \u001b[33Gwn\u001b[36Gnext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE\u001b[10Gruns\u001b[15Gat\u001b[18G1.6\u001b[22Gs\u001b[24Gper\u001b[28G900\u001b[32Gwords\u001b[38Gbecause\u001b[46Gthe\u001b[50Gtokenizer's\u001b[62Gmerge\u001b[68Gloop\u001b[73Grescans\u001b[81Gevery\u001b[87Gpair\u001b[92Geach\u001b[97Gpass.\u001b[103GI'm\u001b[107Gcaching\u001b[115Geach\r\u001b[1B \u001b[3Gadjacent pair's merge candidate so\u001b[38Gonly the two neighbour\u001b[62Gof a merge\u001b[73Gg\u001b[75Gt recomputed, then \u001b[96Gecking\u001b[103Gthe\u001b[107Gnew e\u001b[113Gcoder\u001b[K\r\u001b[3C\u001b[1Bgainst v1 on many randomised texts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gnew\u001b[11Gencoder\u001b[19Gnow\u001b[23Gmatches\u001b[31Gthe\u001b[35Greference\u001b[45Gon\u001b[48G"]
