[879.407, "\u001b[H\r\u001b[25B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE runs at 1.6 s per 900\u001b[32Gwords\u001b[38Gbecause\u001b[46Gthe\u001b[50Gtokenizer's\u001b[62Gmerge\u001b[68Gloop\u001b[73Grescans\u001b[81Gevery\u001b[87Gpair\u001b[92Geach\u001b[97Gpass.\u001b[103GI'm\u001b[107Gcaching\u001b[115Geach\r\u001b[2C\u001b[1Badjacent pair's merge candidate so only the two neighbours of a merge get recomputed, then checking the new encoder\u001b[K\r\u001b[2C\u001b[1Bagainst v1 on many randomised\u001b[33Gtexts.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u273d\u001b[3GDrizz\u001b[38;2;245;149;117mlin\u001b[38;2;215;119;87mg\u2026 \u001b[28G\u001b[38;2;102;102;102m4\u001b[30G7\u001b[42G\u001b[38;2;169;169;169mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[879.423, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 12s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[879.44, "\u001b[H\r\u001b[6C\u001b[33B\u001b[38;2;245;149;117mz\u001b[10G\u001b[38;2;215;119;87mn\u001b[39m\u001b[40;1H\u001b[38;3H"]
