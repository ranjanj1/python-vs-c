[645.992, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode holds at about\u001b[25G126\u001b[29Gtok/s\u001b[35Gacross\u001b[42Gwidths\u001b[49G256\u001b[53Gto\u001b[56G448,\u001b[61Gbut\u001b[65Gwidth\u001b[71G256\u001b[75Gprefills\u001b[84G17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[2C\u001b[1Bdefault.\u001b[12GNext\u001b[17GI'll\u001b[22Gtest\u001b[27Gwhether\u001b[35Gtransposing\u001b[47Gdirectly\u001b[56Gfrom\u001b[61Gan\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[1B \u001b[3Gtime.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing\u001b[15Gstraight\u001b[24Gfrom\u001b[29Gthe\u001b[33Gmmap\u001b[38Gcuts\u001b[43Gload\u001b[48Gfrom\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1B \u001b[3Git.\u001b[7GI'll also try\u001b[21G\u001b[38;2;87;105;247mmadvise\u001b[39m hints on th\u001b[42Gm\u001b[44Gpping.\u001b[51G\u001b[K\r\u001b[2C\u001b[4BThe madvis\u001b[14G h\u001b[17Gnts showed no\u001b[31Gmea\u001b[35Gurable gain, so I'm d\u001b[58Gpping\u001b[64Gthem and profiling decode attention\u001b[100Gat long context next.\r\u001b[2C\u001b["]
