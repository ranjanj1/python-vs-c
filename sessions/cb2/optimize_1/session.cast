[329.236, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed, contiguous 256\u2013512-column weight blocks let sgemv-Trans\u001b[71Greach\u001b[77Gabout 63\u001b[86GGB/s,\u001b[92Groughly 1.8\u00d7 the curr\u001b[114Gnt\r\u001b[2C\u001b[1Brate, for both model\u001b[24Gwidths;\u001b[32GI'm\u001b[36Gignoring\u001b[45Gthe\u001b[49Gstrided\u001b[57Gfigures\u001b[65Gsince\u001b[71Gcache\u001b[77Ginflates\u001b[86Gthem.\u001b[92GNext\u001b[97GI'll\u001b[102Gpin\u001b[106Gdown\u001b[111Gthe\r\u001b[2C\u001b[1Bplateau\u001b[11Gmore\u001b[16Gfinely.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWidt\u001b[8Gs of 256 to 384 columns hold steady near 63 GB/s, and th\u001b[65G earlier\u001b[74G512 reading did not\u001b[94Greproduce.\u001b[105GNext\u001b[110GI'll\u001b[115Gstore\r\u001b[2C\u001b[1Bweights\u001b[11Gtransposed\u001b[22Gin\u001b[25G256\u2013384\u001b[33Gcolumn\u001b[40Gblocks,\u001b[48Gwith\u001b[53Gsgemv\u001b[59Gfor\u001b[63Gdecode\u001b[70Gand\u001b[74Gsgemm\u001b[80Gfor\u001b[84Gprefill.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration ros\u001b[18G from\u001b[24G80\u001b[28Go 131.5 t\u001b[38Gk/s (1\u001b[45G64\u00d7)\u001b[50Gwith the full c"]
[329.237, "heck \u001b[71Gtill passing, though load time went up from\u001b[115Gabout\r\u001b[2C\u001b[1B80 t\u001b[8G 124 ms\u001b[16Gbecause\u001b[24Gof\u001b[27Gthe\u001b[31Gtransposition.\u001b[46GI'm\u001b[50Gadding\u001b[57Gsection\u001b[65Gtimers\u001b[72Gto\u001b[75G\u001b[38;2;87;105;247mcb2.c\u001b[81G\u001b[39mbehind\u001b[88G\u001b[38;2;87;105;247m-DPROF\u001b[95G\u001b[39mso\u001b[98Gprofiling\u001b[108Gcan\u001b[112Gbe\r\u001b[2C\u001b[1Breproduced.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight products now run near the 63 GB/s read ceiling,\u001b[58Gand weight streaming\u001b[79Gi\u001b[82Gstill about 96% of\u001b[101Gdecode\u001b[108Gtime.\u001b[114GNext\r\u001b[2C\u001b[1BI'm\u001b[7Gprofiling\u001b[17Gprefill\u001b[25Gand\u001b[29Gload,\u001b[35Gsince\u001b[41GLOGITS\u001b[48Gand\u001b[52GFIXED\u001b[58Geach\u001b[63Gtake\u001b[68Groughly\u001b[76G42\u001b[79Gms\u001b[82Gon\u001b[85G69\u201382\u001b[91Gtokens.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefil\u001b[10G is mostly spent in the weight matmuls\u001b[49G(about 84%, only ~450 GFLOP/s at M\u224876), with SwiGLU's scalar expf\u001b[115Gtaking\r\u001b[2C\u001b[1B9%.\u001b[7GI'll\u001b[12Gbenchmark\u001b[22"]
[329.238, "Gsgemm\u001b[28Glayouts\u001b[36Gfor\u001b[40GM\u224876\u001b[45Gand\u001b[49GM=512\u001b[55Gto\u001b[58Gsee\u001b[62Gwhether\u001b[70Gthe\u001b[74Gblock\u001b[80Glayout\u001b[87Gis\u001b[90Gcosting\u001b[98Gprefill\u001b[106Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt M=76, the blocked layout gets about 570 GFLOP/s in sgemm, nearly th\u001b[74G same as the\u001b[87Gorig\u001b[93Gal 586, so pr\u001b[107Gfill\u001b[112Gis\r\u001b[2C\u001b[1Bunaffected.\u001b[15GI'm\u001b[19Gsplitting\u001b[29GW1/W3\u001b[35Gand\u001b[39GQ/K/V\u001b[45Ginto\u001b[50Gseparate\u001b[59Gblocked\u001b[67Gmatrices\u001b[76Gnext,\u001b[82Gthen\u001b[87Glooking\u001b[95Gat\u001b[98Gload\u001b[103Gtime.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Reading cb2.c\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  cb2.c\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;171;43;63m\u273b\u001b[39m \u001b[38;2;171;43;63mWaiting for API response\u001b[38;2;102;102;102m \u00b7 w\u001b[32Gll\u001b[35Gretry in 2m 40s \u00b7 check you\u001b[63G network\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
