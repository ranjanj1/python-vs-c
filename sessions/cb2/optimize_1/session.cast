[477.215, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m#define\u001b[12GSRC(off,\u001b[21Gcnt)\u001b[26G((const\u001b[34Gfloat\u001b[40G*)(map\u001b[47G+\u001b[49GOFF(off)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#endif\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mR('''\u001b[13Gif\u001b[16G(shared_cls)\u001b[29G{\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G pread_all(fd, tmp, VV\u001b[34G* D * 4, OFF(o_em\u001b[52G));\u001b[56G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G } els\u001b[14G {\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22memb\u001b[16G=\u001b[18Gxalloc(VV\u001b[28G*\u001b[30GD\u001b[32G*\u001b[34G4);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         pread_all(fd,\u001b[26Gemb,\u001b[31GVV\u001b[34G*\u001b[36GD\u001b[38G*\u001b[40G4,\u001b[43GOFF(o_emb));\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mpread_all(fd,\u001b[26Gtmp,\u001b[31GVV\u001b[34G*\u001b[36GD\u001b[38G*\u001b[40G4,\u001b[43GOFF(o_cls));\r\u001b[1B \u001b[2m\u2502\u001b[22m  \u001b[6G  }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     ma\u001b[11G_fill(&cls, \u001b[24Gmp);''','''   \u001b[39Gif (!shared_cls) {\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22memb\u001b[16G=\u001b[18Gxalloc(VV\u001b[28G*\u001b[30GD\u001b[32G*\u001b[34G4);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         pread_all(fd, emb, VV * D\u001b[38G*\u001b[40G4,\u001b[43GOFF(o_emb));\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22m}\r\u001b[1B \u001b[2m\u2502\u001b[22m     mat_fill(&cls, SRC(shared_cls ? o_emb : o_cls, VV * D));''')\u001b["]
