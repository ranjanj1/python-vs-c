[7.245, "\u001b[H\u001b[3G\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502 Load to READY   \u001b[22G      \u2502 about 0.1 s\u001b[42G   \u001b[46G  \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Generation             \u2502 about 79 tokens/s\u001b[48G\u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5GFIXED with 1024 tokens \u2502 about 0.42 s    \u001b[47G \u2502\u001b[K\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is\u001b[17Glimited\u001b[25Gby\u001b[28Gmemory\u001b[35Gspeed:\u001b[42Git\u001b[45Greads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstand"]
[7.246, "alone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere. Trying \u001b[38;2;87;105;247msgemm\u001b[39m instead, or stor\u001b[39Gng\u001b[42Gthe weights transp\u001b[61Gsed,\u001b[66Ggave no gain.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[22m (INTERFACE.md doe\u001b[52Gn't cover these cases)\u001b[K\r\u001b[4C\u001b[1B\u001b[1mNumerics\u001b[15G\u001b[22mresults differ slightly\u001b[39Gfro\u001b[43G the reference because Acc\u001b[70Gl\u001b[73Gate \u001b[78Gums in a different order. On a near-tie,\u001b[K\r\u001b[4C\u001b[1Bgr\u001b[8Gedy\u001b[12Ggeneration\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpick\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[5C\u001b[1B\u001b[1mt\u001b[9G order:\u001b[22m in GENERATE, \u001b[38;2;87;105;247mstop\u001b[39m is\u001b[38Gchecked first, the\u001b[57G \u001b[38;2;87;105;247mmax\u001b[39m,\u001b[63Gthen \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[17G\u001b[22ma\u001b[19Gprompt\u001b[26Glonger\u001b[33Gthan\u001b[38G1024\u001b[43Gtokens\u001b[50Ganswers\u001b[58G\u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand\u001b[78G\u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[1B \u001b[3G  run"]
[7.248, "ning the model.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEmpty pieces:\u001b[19G\u001b[22mPIECE\u001b[25Gprints\u001b[32G\u001b[38;2;87;105;247mHEX \u001b[37G\u001b[39mwith\u001b[42Gnothing\u001b[50Gafter\u001b[56Git\u001b[59Gfor\u001b[63Gan\u001b[66Gempty\u001b[72Gpiece.\u001b[79GThat\u001b[84Gincludes\u001b[93Gthe\u001b[97Graw\u001b[101Gbyte\u001b[106G\u001b[38;2;87;105;247m<0x00>\u001b[39m,\u001b[114Gbecause\r\u001b[1B    the reference treats pieces as C strings.\u001b[K\r\u001b[1B  - \u001b[1mBad input:\u001b[22m malformed commands, out-of-range ids, and FIXED/LOGITS with more than 1024 ids get an \u001b[38;2;87;105;247mERR \u2026\u001b[39m line.\u001b[K\r\u001b[1B  - \u001b[1mKV cache:\u001b[22m it isn't zeroed between commands. Each command writes every position before reading it, so nothing carries\r\u001b[4C\u001b[1Bover.\r\u001b[1B \u001b[3G- \u001b[1mScope:\u001b[12G\u001b[22mI on\u001b[17Gy t\u001b[21Gs\u001b[23Ged against th\u001b[37G public\u001b[45Gfixtures,\u001b[55Gand\u001b[59Gthe\u001b[63Gfinal\u001b[69Ggate\u001b[74Guses\u001b[79Gother\u001b[85Ginputs.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GBrewed for 5m 55s \u00b7 done 8:49 AM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance"]
