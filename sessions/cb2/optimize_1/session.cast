[131.967, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell\u001b[15Gcom\u001b[19Gand \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration is the\u001b[21Gbottleneck\u001b[32Gat\u001b[35Gabout\u001b[41G12.5\u001b[46Gms\u001b[49Gper\u001b[53Gtoken,\u001b[60Groughly\u001b[68G2.4\u001b[72Gs\u001b[74Gof\u001b[77Gthe\u001b[81Gworkload.\u001b[91GI'm\u001b[95Gadding\u001b[102Gsection\u001b[110Gtimers\u001b[117Gto\r\u001b[2C\u001b[1Bbreak that down further\u001b[27Gand\u001b[31Gmeasuring\u001b[41Gthe\u001b[45Graw\u001b[49Gmemory-bandwidth\u001b[66Gceiling\u001b[74Gnext.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Weight streaming takes 97% of generation time, with all five weight products running\u001b[88Gat\u001b[91G33\u201337\u001b[97GGB/s.\u001b[103GI'm\u001b[107Gnext\u001b[112Gtesting\r\u001b[1C\u001b[1B whether 36 GB/s is really the single-core\u001b[45Gceiling\u001b[53Gon\u001b[56Gthis\u001b[61GM1,\u001b[65Gusing\u001b[71Gpure-read\u001b[81Gkernels\u001b[89Gand\u001b[93Gother\u001b[99GAccelerate\u001b[110Groutines.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Pure reads hit 63 GB/s but sgemv only\u001b[41Greaches\u001b[49Gabout\u001b[5"]
