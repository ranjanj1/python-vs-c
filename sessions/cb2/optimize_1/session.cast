[1069.999, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED \u00d73                              \u2502 124 ms  \u2502 92\u201397 ms     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 100 after a 901-token prompt \u2502 ~3.5 s  \u2502 1.3 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ENCODE, 900 words                     \u2502 1608 ms \u2502 7.8 ms       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r"]
[1070.001, "\u001b[2C\u001b[1B\u2502 Load to READY                         \u2502 73 ms   \u2502 ~105 ms      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Gmatches\u001b[19Gevery\u001b[25Gfixture\u001b[33Gentry.\r\u001b[4C\u001b[1BF\u001b[7GXED\u001b[11Gand GENERATE agree with each\u001b[40Gother.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m stop and th\u001b[30Gedge\u001b[35Gc\u001b[37Gses still\u001b[47Gbehave\u001b[54Gas\u001b[57Gbefore.\r\u001b[4C\u001b[1BLogits over\u001b[17G600 positions a\u001b[33Gree with v1 to within 3.7\u001b[59G-5.\u001b[K\u001b[40;1H\u001b[38;3H"]
[1070.358, "\u001b[H\u001b[3G  \u001b[6Gcomputed.\u001b[K\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mFrom 160 position\u001b[25Gonw\u001b[29Grds,\u001b[34Gsingle-token attention handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[107G\u001b[22mThis\u001b[112Gadds\r\u001b[2C\u001b[1B  \u001b[6Gmultiplications by zero but removes none of the reference's work. Below 160 the\u001b[86Gold\u001b[90Gp\u001b[92Gr-h\u001b[96Gad path is kept\u001b[112Gbecause\r\u001b[5C\u001b[1Bit is faster\u001b[19Gthere.\r\u001b[2C\u001b[1B7\u001b[6G\u001b[1mThe tokenizer caches the merge candidate\u001b[47Gfor each adjacent\u001b[65Gpair.\u001b[22m Its output is identical to the reference\u001b[113Glgorithm\r\u001b[5C\u001b[1Bon 514 tes\u001b[17G texts,\u001b[25Gincluding the fixtur\u001b[46Gs and random U\u001b[61Gicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (m\u001b[14Gd\u001b[16Gans\u001b[20Gof alternating runs)\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502               Workload             \u001b[43G\u2502\u001b[47Gv1\u001b[53G\u2502\u001b[60Gv2\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u2500"]
[1070.359, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764, fixture prompts        \u2502 2415 ms \u2502 1450\u20131585 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73                             \u2502 127 ms  \u2502 97\u2013100 ms    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED \u00d73                              \u2502 124 ms  \u2502 92\u201397 ms     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1070.361, "\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 100 after a 901-token prompt \u2502 ~3.5 s  \u2502 1.3 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ENCODE, 900 words                     \u2502 1608 ms \u2502 7.8 ms       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY                         \u2502 73 ms   \u2502 ~105 ms      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- PIECE matches every fixture entry.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GF"]
[1070.361, "IXED\u001b[11Gand\u001b[15GGENERATE\u001b[24Gagree\u001b[30Gwith\u001b[35Geach\u001b[40Gother.\r\u001b[2C\u001b[1B- The \u001b[38;2;87;105;247mcontext\u001b[17G\u001b[39mstop\u001b[22Gand\u001b[26Gthe\u001b[30Gedge\u001b[35Gcases\u001b[41Gstill\u001b[47Gbehave\u001b[54Gas\u001b[57Gbefore.\r\u001b[2C\u001b[1B-\u001b[5GLogits\u001b[12Gover\u001b[17G600\u001b[21Gpositions\u001b[31Gagree\u001b[37Gwith\u001b[42Gv1\u001b[45Gto\u001b[48Gwithin\u001b[55G3.7e-5.\r\u001b[4C\u001b[1BA checkpoint with a\u001b[25Gseparate classifier\u001b[45G(a\u001b[48Gtest\u001b[53Gcopy\u001b[58GI\u001b[60Gbuilt\u001b[66Gand\u001b[70Gthen\u001b[75Gdeleted)\u001b[84Ggives\u001b[90Gbit-identical\u001b[104Goutput.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[1070.458, "\u001b]0;\u25d0 Claude Code\u0007"]
[1070.993, "\u001b[H\r\u001b[4C\u001b[34B\u001b[1mLittle speed left in decode.\u001b[34G\u001b[22mIt\u001b[37Gnow\u001b[41Greads\u001b[47Gweights\u001b[55Gat\u001b[58G57\u201360\u001b[64GGB/s\u001b[69Gagainst\u001b[77Gthe\u001b[81G63\u001b[84GGB/s\u001b[89Gceiling,\u001b[98Gand\u001b[102Gfurther\u001b[110Ggains\u001b[116Gwould\u001b[40;1H\u001b[38;3H"]
[1071.147, "\u001b[H\u001b[6Gmultiplications\u001b[22Gby\u001b[25Gzero\u001b[30Gbut\u001b[34Gremoves\u001b[42Gnone\u001b[47Gof\u001b[50Gthe\u001b[54Greference's\u001b[66Gwork.\u001b[72GBelow\u001b[78G160\u001b[82Gthe\u001b[86Gold\u001b[90Gper-head\u001b[99Gpath\u001b[104Gis\u001b[107Gkept\u001b[112Gbecause\r\u001b[2C\u001b[1B  \u001b[6Git is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[22m Its \u001b[76Gutput\u001b[82Gis identical to the reference\u001b[112Galgorithm\r\u001b[5C\u001b[1Bon\u001b[9G514 test texts, including\u001b[35Gthe\u001b[39Gfixtures\u001b[48Gand\u001b[52Grandom\u001b[59GUnicode.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[19GWorkload\u001b[43G\u2502\u001b[47Gv1\u001b[53G\u2502\u001b[60Gv2\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[43G\u253c\u001b[53G\u253c\u001b[68G\u2524\r\u001b[4C\u001b[1BGENERATE\u001b[14G3\u00d764, fixture\u001b[28Gprompts\u001b[45G2415\u001b[50Gms\u001b[55G1450\u20131585\u001b[65Gms\r\u001b[4C\u001b[2BLOGITS \u00d73     \u001b[20G       \u001b[28G       \u001b[45G127 ms \u001b[55G97\u2013100 ms\u001b[65G  \r"]
[1071.149, "\u001b[4C\u001b[2BFIXED \u00d73 \u001b[47G4\u001b[56G2\u001b[58G97 ms \r\u001b[4C\u001b[2BGEN\u001b[9GRATE\u001b[14G100\u001b[18Gafter\u001b[24Ga\u001b[26G901-token\u001b[36Gprompt\u001b[45G~3.5 \u001b[55G1.3 s\u001b[61G  \r\u001b[4C\u001b[2BENCODE, 90\u001b[16G words \u001b[24G \u001b[26G         \u001b[36G      \u001b[45G1608\u001b[50Gms\u001b[55G7\u001b[57G8\u001b[59Gms\r\u001b[4C\u001b[2BLoad to\u001b[13GREADY    \u001b[45G73 ms  \u001b[55G~105 ms\r\u001b[2C\u001b[1B\u2514\u001b[43G\u2534\u001b[53G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Gmatches\u001b[19Gevery\u001b[25Gfixture\u001b[33Gentry.\r\u001b[2C\u001b[1B- FIXED and\u001b[15GGENERATE\u001b[24Gagree\u001b[30Gwith\u001b[35Geach\u001b[40Gother.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m \u001b[18Gtop and the edg\u001b[34G cases\u001b[41Gstill\u001b[47Gbehave\u001b[54Gas\u001b[57Gbefore.\r\u001b[4C\u001b[1BLogits over 600 positions agre\u001b[36G with v1 to\u001b[48Gwithin\u001b[55G3.7e-5.\r\u001b[4C\u001b[1BA checkpoint with a separate cl\u001b[38Gsifier (a test copy I built\u001b[66Gand\u001b[70Gthen\u001b[75Gdeleted)\u001b[84Ggives\u001b[90Gbit-identical\u001b[104Goutput.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mL\u001b[8Gtle speed left in decode.\u001b[34G\u001b[22mIt\u001b[37Gnow\u001b[41Greads\u001b[47Gweights\u001b[55Gat\u001b[58G57\u201360\u001b[64GGB/s\u001b[69Gagainst\u001b[77Gthe\u001b[81G"]
[1071.149, "63\u001b[84GGB/s\u001b[89Gceiling,\u001b[98Gand\u001b[102Gfurther\u001b[110Ggains\u001b[116Gwould\r\u001b[4C\u001b[1Bneed\u001b[10Gto\u001b[13Gread\u001b[18Gless\u001b[23Gdata,\u001b[29Gwhich\u001b[35Gthe\u001b[39Grules\u001b[45Gdon't\u001b[51Gallow.\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[1071.42, "\u001b]0;\u25d1 Claude Code\u0007"]
[1071.444, "\u001b[H\u001b[6Git is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[71G\u001b[22mIts\u001b[75Goutput\u001b[82Gis\u001b[85Gidentical\u001b[95Gto\u001b[98Gthe\u001b[102Greference\u001b[112Galgorithm\r\u001b[2C\u001b[1B  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502               Workload                \u2502   v1    \u2502      v2      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764, fixture prompts        \u2502 2415 ms \u2502 1450\u20131585 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1071.445, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73                             \u2502 127 ms  \u2502 97\u2013100 ms    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED \u00d73                              \u2502 124 ms  \u2502 92\u201397 ms     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 100 after a 901-token prompt \u2502 ~3.5 s  \u2502 1.3 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ENCODE, 9"]
[1071.447, "00 words                     \u2502 1608 ms \u2502 7.8 ms       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY                         \u2502 73 ms   \u2502 ~105 ms      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\r\u001b[2C\u001b[1B\u001b[22m- PIECE matches\u001b[19Gevery\u001b[25Gfixture\u001b[33Gentry.\r\u001b[4C\u001b[1BF\u001b[7GXED\u001b[11Gand GENERATE agree with each\u001b[40Gother.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m stop and th\u001b[30Gedge\u001b[35Gc\u001b[37Gses still\u001b[47Gbehave\u001b[54Gas\u001b[57Gbefore.\r\u001b[4C\u001b[1BLogits over\u001b[17G600 positions a\u001b[33Gree with v1 to within 3.7\u001b[59G-5.\u001b[K\r\u001b[4C\u001b[1BA checkpoint with a separate classifier\u001b[45G(a\u001b[48Gtest copy I built\u001b[66Gand\u001b[70Gthen\u001b[75Gdeleted)\u001b[84G"]
[1071.448, "gives\u001b[90Gbit-identical\u001b[104Goutput.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLittle speed left in decode.\u001b[34G\u001b[22mIt\u001b[37Gnow\u001b[41Greads\u001b[47Gweights\u001b[55Gat\u001b[58G57\u201360\u001b[64GGB/s\u001b[69Gagainst\u001b[77Gthe\u001b[81G63\u001b[84GGB/s\u001b[89Gceiling,\u001b[98Gand\u001b[102Gfurther\u001b[110Ggains\u001b[116Gwould\r\u001b[2C\u001b[1B \u001b[5Gneed to read less data, which \u001b[36Ghe rul\u001b[43Gs don't allow.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSlower load:\u001b[18G\u001b[22mabout 30 ms more\u001b[37Gan v1, because the weights\u001b[64Gare\u001b[68Gtransposed\u001b[79Gonce\u001b[84Gat\u001b[87Gstartup.\u001b[40;1H\u001b[38;3H"]
