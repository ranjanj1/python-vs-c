[6.49, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BGeneration\u001b[14Gis\u001b[17Glimited\u001b[25Gby\u001b[28Gmemory\u001b[35Gspeed:\u001b[42Git\u001b[45Greads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere. Trying \u001b[38;2;87;105;247msgemm\u001b[39m instead, or storing the weights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[22m (INTERFACE.md doesn't\u001b[56Gcover\u001b[62Gthese\u001b[68Gcases)\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumerics:\u001b[22m results\u001b[23Gdiffer\u001b[30Gslightly\u001b[39Gfrom the\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[2C\u001b[1B  greedy generation could in principle pick a different\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop order:\u001b[22m in GENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[39m is checked\u001b[46Gfirst,\u001b[53Gthen\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m,\u001b[63Gthen\u001b[68G\u001b[38;2;87;105;247mcontext\u001b[39m.\r\u001b[2C\u001b[1B- \u001b[1mEdge cases:\u001b[22m a prompt longer than 1024"]
[6.49, " tokens\u001b[50Ganswers\u001b[58G\u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand\u001b[78G\u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[4C\u001b[1Brunning\u001b[13Gthe\u001b[17Gmodel.\r\u001b[2C\u001b[1B- \u001b[1mEmpty pieces:\u001b[22m PIECE\u001b[25Gprints \u001b[38;2;87;105;247mHEX \u001b[39m with\u001b[42Gnothing aft\u001b[54Gr it for\u001b[64Gn\u001b[66Gempty\u001b[72Gpiece. That include\u001b[93Gthe raw byt\u001b[106G\u001b[38;2;87;105;247m<0x00>\u001b[39m, because\r\u001b[2C\u001b[1B  the\u001b[9Greference treat\u001b[25G pieces a\u001b[35G C strings.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBad input:\u001b[16G\u001b[22mmalformed\u001b[26Gcommands,\u001b[36Gout-of-range\u001b[49Gids,\u001b[54Gand\u001b[58GFIXED/LOGITS\u001b[71Gwith\u001b[76Gmore\u001b[81Gthan\u001b[86G1024\u001b[91Gids\u001b[95Gget\u001b[99Gan\u001b[102G\u001b[38;2;87;105;247mERR \u2026\u001b[108G\u001b[39mline.\r\u001b[2C\u001b[1B- \u001b[1mKV cache:\u001b[22m it isn't zeroed between commands. Each command\u001b[62Gwrit\u001b[67Gs ev\u001b[72Gry\u001b[75Gposition\u001b[84Gbefore\u001b[91Greading\u001b[99Git,\u001b[103Gso\u001b[106Gnothing\u001b[114Gcarries\r\u001b[2C\u001b[1B \u001b[5Gover.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScope:\u001b[12G\u001b[22mI only tested aga\u001b[31Gst the \u001b[39Gublic fixtures, a\u001b[57Gd\u001b[60Ghe final gat\u001b[74Guses oth"]
[6.491, "\u001b[83Gr\u001b[85Ginputs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GBrewed for 5m 55s \u00b7 done 8:49 AM\u001b[39m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mLo\u001b[6Gk for\u001b[12Gdevelopment\u001b[24Gworkload\u001b[33Gfiles\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ls -la; ls reference; ls /Users/Shared/pvc-kit 2>&1 | head\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[6.492, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1B \u001b[38;2;102;102;102mLook for development workload files\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mls\u001b[5G-la;\u001b[10Gls\u001b[13Greference;\u001b[24Gls\u001b[27G/Users/Shared/pvc-kit\u001b[49G2>&1\u001b[54G|\u001b[56Ghead\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[6.492, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gallow\u001b[18Greading\u001b[26Gfrom\u001b[31G\u001b[1m/Users/Shared/pvc-kit\u001b[53G\u001b[22mfrom\u001b[58Gthis\u001b[63Gproject\u001b[103G\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
