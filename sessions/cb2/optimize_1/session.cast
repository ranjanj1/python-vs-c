[594.242, "\u001b[55Ggives every head's\u001b[74Gscores while reading K \u001b[98Gnce,\u001b[103Gco\u001b[106Gt\u001b[108Gguously.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m           \u001b[15G  * att (n_heads x T)\u001b[37G@ V (T x\u001b[46Gkv_dim) then holds\u001b[65Geach head's output in its\u001b[91Gdiagonal block. */\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mfor\u001b[20G(int\u001b[25Gh\u001b[27G=\u001b[29G0;\u001b[32Gh\u001b[34G<\u001b[36Gnh;\u001b[40Gh++)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 cblas_scopy(hs,\u001b[36Gbq\u001b[39G+\u001b[41Gh\u001b[43G*\u001b[45Ghs,\u001b[49G1,\u001b[52Gqblk\u001b[57G+\u001b[59G(size_t)(h\u001b[70G/\u001b[72Gkv_mul)\u001b[80G*\u001b[82Ghs\u001b[85G*\u001b[87Gnh\u001b[90G+\u001b[92Gh,\u001b[95Gnh);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mcblas_sgemm(CblasRowMajor,\u001b[43GCblasNoTrans,\u001b[57GCblasNoTrans,\u001b[71GT,\u001b[74Gnh,\u001b[78Gkvd,\u001b[83G1.0f,\u001b[89Gkc,\u001b[93Gkvd,\u001b[98Gqblk,\u001b[104Gnh,\u001b[108G0.0f,\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G     \u001b[16G  \u001b[19G     \u001b[25G   bsc, nh);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12G    vDSP_m\u001b[23Grans(bsc, 1, b\u001b[38Gtt, 1, nh, T);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[16Gfor\u001b[20G(int\u001b[25Gh\u001b[27G=\u001b[29G0;\u001b[32Gh\u001b[34G<\u001b[36Gnh;\u001b[40Gh++)\u001b[45G{\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mfloat\u001b[26G*row\u001b[31G=\u001b[33Gbatt\u001b[38G+\u001b[40G(size_t)h\u001b[50G*\u001b[52GT;"]
