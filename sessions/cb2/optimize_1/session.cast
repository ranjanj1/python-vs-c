[861.793, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gnarrow-N\u001b[16Gsgemm\u001b[22Gis\u001b[25Gthe\u001b[29Gbottleneck,\u001b[41Gso\u001b[44GI'm\u001b[48Gtrying\u001b[55GQ_blk\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b[85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116Gand\r\u001b[1B \u001b[3GI'll compare\u001b[16Git with the per-head path to find the crossover.\u001b[65G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gper-head\u001b[16Gpath\u001b[21Gwins\u001b[26Gbelow\u001b[32Gabout\u001b[38GT=160\u001b[44Gand\u001b[48Gthe\u001b[52Gblock-diagonal\u001b[67Gpath\u001b[72Gabove\u001b[78Git,\u001b[82Groughly\u001b[90G25%\u001b[94Gfaster\u001b[101Gat\u001b[104GT=1000,\u001b[112Gso\u001b[115GI'll\r\u001b[1B \u001b[3Gswitch between \u001b[20Gem at\u001b[26Gthat crossover and keep the per\u001b[58Ghe\u001b[61Gd p\u001b[65Gth for\u001b[72Gfixture-sized workloads.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Ghybrid\u001b[14Gpath\u001b[19Gpasses\u001b[26Gall\u001b[30Gchecks,\u001b[38Gwith\u001b[43Glong-context\u001b[56Gattention\u001b[66Gdown\u001b[71Gto\u001b[74Gabout\u001b[80G394\u001b[84Gms\u001b[87Gand\u001b[91Gshort-context\u001b["]
[861.794, "105Gunchanged\u001b[115Gat\u001b[118G43\r\u001b[1B \u001b[3Gms.\u001b[7GSince cmp.py still\u001b[26Gused the old CHUNK=1 binary, I'm rebuilding fr\u001b[73Gm current source and \u001b[95Gerun\u001b[100Ging the comparison,\u001b[K\r\u001b[2C\u001b[1Bblock-diagonal path included.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gthree\u001b[13Gbuilds\u001b[20Gmatch\u001b[26Gwithin\u001b[33G3.7e-5\u001b[40Gover\u001b[45G600\u001b[49Gpositions,\u001b[60Gcovering\u001b[69Gthe\u001b[73Gblock-diagonal\u001b[88Gdecode\u001b[95Gpath\u001b[100Gand\u001b[104Gcausal\u001b[111Grow\r\u001b[1B \u001b[3Ggroups. I'm re-profiling \u001b[30Ge fixture-sized prefill next.\u001b[60G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gat\u001b[14Gfixture\u001b[22Gsize\u001b[27Gdropped\u001b[35Gfrom\u001b[40G614\u001b[44Gto\u001b[47G455\u001b[51Gms,\u001b[55Gand\u001b[59Gthe\u001b[63G1024-token\u001b[74Gcase\u001b[79Gnow\u001b[83Gruns\u001b[88Ginto\u001b[93Gsoftmax\u001b[101Gexp\u001b[105Gwork\u001b[110Gthe\r\u001b[1B \u001b[3Greference also do\u001b[21Gs, so\u001b[27GI'm stopping\u001b[40Goptimisation there. N\u001b[62Gxt I'll ru\u001b[74Gan alternating head-to-hea"]
[861.796, "d against\u001b[110Gv1 and\u001b[117Ga\r\u001b[2C\u001b[1Blong-context comparison.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m v1 generates 3\u00d764 in 2415 ms against v2's 1450 ms, and the table shows the rest of the timings. The long GENERATE run\u001b[K\r\u001b[2C\u001b[1Blooks slower than the model work explains,\u001b[46Gso\u001b[49GI\u001b[51Gsuspect\u001b[59Gthe\u001b[63Greference's\u001b[75GO(n\u00b2)\u001b[81GBPE\u001b[85Gmerge\u001b[91Gloop\u001b[96Gon\u001b[99Gthe\u001b[103G900-word\u001b[112Gprompt,\r\u001b[2C\u001b[1Band I'm timing ENCODE on its own\u001b[36Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m3\u001b[29G4\u001b[39m\u001b[40;1H\u001b[38;3H"]
