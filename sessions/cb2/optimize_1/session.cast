[736.364, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mRebuild sequential build, cross-compare\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcp\u001b[7G/tmp/cb2t/c1\u001b[20G/tmp/cb2t/c1_v1\u001b[36G&&\u001b[39Gsed\u001b[43G's/#define\u001b[54GCHUNK\u001b[6"]
[736.366, "0G512\u001b[64G/#define\u001b[73GCHUNK\u001b[79G1\u001b[81G/'\u001b[84Gcb2.c\u001b[90G>\u001b[92G/tmp/cb2t/c1.c\u001b[107G&&\u001b[110Ggrep\u001b[115G-c\r\u001b[1B \u001b[2m\u2502\u001b[22m \"define CHUNK 1 \"\u001b[22G/tmp/cb2t/c1.c && cc -O3 -mcpu=native -o /tmp/cb2t/c1 /tmp/cb2t/c1.c -framework\u001b[102GAccelerate &&\u001b[116G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 /tmp/cb2t/cmp.py && cat > /\u001b[40Gmp/cb2t/cmp2.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsubprocess,\u001b[23Garray\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ids=[1]+[(i*7919)%31000+500\u001b[32Gfor\u001b[36Gi\u001b[38Gin\u001b[41Grange(599)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Grun(exe,tag):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G p=subprocess.Popen([exe,'m\u001b[35Gdel.bin','tokenizer.bin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     p.stdout.readline(); f=f'/tmp/cb2t/{tag}.f32'\u001b[54G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write(f'LOGITS\u001b[31G{f}\u001b[35G'+'\u001b[39G'.join(map(str,ids))+'\\nQUIT\\n');\u001b[73Gp.stdin.flush();\u001b[90Gp.stdout.readline();\u001b[111Gp.wait()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     a=array.array('f');\u001b[28Ga.frombytes(open(f,'rb').read());\u001b[62Greturn\u001b[69Ga\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b"]
[736.368, "[4G\u001b[22ma=run('/tmp/cb2t/c1_v1','v1seq');\u001b[38Gb=run('/tmp/cb2t/c1','v2seq');\u001b[69Gc=run('./cb2','v2chunk')\r\u001b[1B \u001b[2m\u2502\u001b[22m print('new sequential\u001b[26Gvs v1 sequent\u001b[40Gal:', max(abs(x-y) for x,y in zip(\u001b[75G,b)))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print('new chunked   \u001b[26Gv\u001b[28G v1 s\u001b[34Gquential:', max(\u001b[51Gbs(x-y)\u001b[59Gfor x,y in\u001b[70Gzip(a,c)))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G/tmp/cb2t/cmp2.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2"]
