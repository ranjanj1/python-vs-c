[862.446, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mv1\u001b[6Ggenerates\u001b[16G3\u00d764\u001b[21Gin\u001b[24G2415\u001b[29Gms\u001b[32Gagainst\u001b[40Gv2's\u001b[45G1450\u001b[50Gms,\u001b[54Gand\u001b[58Gthe\u001b[62Gtable\u001b[68Gshows\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[103Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[1B \u001b[3Glooks slower\u001b[16Gthan\u001b[21Gthe model work explains, so I suspect the reference's O(n\u00b2) BPE merge loop on the 900-word\u001b[112Gprompt,\r\u001b[2C\u001b[1Band I'm timing\u001b[18GENCODE on i\u001b[30Gs own next.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -c \"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mimport subprocess,time\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mp=subprocess.Popen(['./cb2','model.bin','tokenizer.bin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True); \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mp.stdout.readline()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor txt in [' '.join(['dog']*900), 'Lily and Tom went to the park to play on th"]
[862.447, "e swings', ('Once upon a time, there\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mwas a \u001b[13Gittl\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[15G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mTime\u001b[7GENCODE for lo\u001b[21Gg\u001b[23Gtexts\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[862.449, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m python3 -c \"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import subpr\u001b[17Gcess,time\u001b[27G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p=subprocess.Po\u001b[20Gen(['./cb2','model.bin','tokenizer.bin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdout.readline()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for txt in [' '.join(['dog']*900),\u001b[39G'Lily\u001b[45Gand\u001b[49GTom\u001b[53Gwent\u001b[58Gto\u001b[61Gthe\u001b[65Gpark\u001b[70Gto\u001b[73Gplay\u001b[78Gon\u001b[81Gthe\u001b[85Gswings',\u001b[94G('Once\u001b[101Gupon\u001b[106Ga\u001b[108Gtime,\u001b[114Gthere\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwas\u001b[8Ga\u001b[10Glittle\u001b[17Ggirl\u001b[22Gnamed\u001b[28GLily.\u001b[34G'\u001b[36G*\u001b[38G40)]:\r\u001b[1B \u001b[2m\u2502\u001b[22m  \u001b[6G  t=tim\u001b[14G.perf_counter(); p.stdin.write('ENCODE '+txt+'\\n'); p.\u001b[69Gtdin.flush();\u001b[83Gr=p.stdout.readlin\u001b[102G();\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print(\u001b[11Gen(tx\u001b[17G),'chars',l\u001b[29Gn(r.split())-1,'ids',f'{(time.perf_counter()-t)*1000:.1f} ms')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p.stdin.wr\u001b[15Gte('QUIT\\n'); p.stdin.flush()\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[862.45, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[26G\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
