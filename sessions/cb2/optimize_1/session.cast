[594.753, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Decode holds\u001b[16Gat\u001b[19Gabout\u001b[25G126 tok/\u001b[34G across w\u001b[44Gdths 256 to 448, but\u001b[65Gwidth\u001b[71G256\u001b[75Gprefills\u001b[84G17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[1C\u001b[1B default. Next\u001b[17GI'll\u001b[22Gtest whether\u001b[35Gtransposing\u001b[47Gdirectly\u001b[56Gfrom\u001b[61Gan\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[1C\u001b[1B time.\u001b[16G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Transposing\u001b[15Gstraight from the mmap cuts\u001b[43Gload from about\u001b[59G114 to 103\u001b[70Gms with no effect on anything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1C\u001b[1B it.\u001b[7GI'll\u001b[12Galso try \u001b[38;2;87;105;247mmadvise\u001b[39m hints on the mapping.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gmadvise\u001b[15Ghints sho"]
[594.755, "wed no\u001b[31Gmeasurable gain, so I'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Decode\u001b[10Gattention runs about 4 ms per token \u001b[47Ggainst a roughly 1.2 ms\u001b[71Gbandwi\u001b[78Gth floor, because the per-head strided\r\u001b[1C\u001b[1B sgemv\u001b[9Gcalls\u001b[15Gare\u001b[19Gthe\u001b[23Gbottleneck. I'm\u001b[39Gbatching\u001b[48Gthe\u001b[52G12\u001b[55Ghead\u001b[60Gqueries\u001b[68Ginto\u001b[73Gone\u001b[77Gblock-diagonal\u001b[92Gmatrix\u001b[99Gso\u001b[102GK\u001b[104Gand\u001b[108GV\u001b[110Gare\u001b[114Geach\r\u001b[1C\u001b[1B read\u001b[8Gonce\u001b[13Gwith contiguous\u001b[29Gsgemm calls.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Implement batched single-token attention\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mp='/Users/agentlab/pvc/cb2/cb2.c'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102ms=open(p).read()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mdef R(a,b):\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mglo"]
