[655.985, "Gsc_t\u001b[71G(NH\u001b[75Gx\u001b[77GT)\u001b[80G=\u001b[82Gqb^T\u001b[87G(NH\u001b[91Gx\u001b[93GKVD)\u001b[98GK^T\u001b[102G*/\r\u001b[1B \u001b[2m\u2502\u001b[22m       cblas_sgemm(CblasRowMajor,CblasTran\u001b[46G,C\u001b[49GlasTrans,NH,T,KVD,1,qb,NH,kc,KVD,0,att,T);\u001b[92Gu=now();t\u001b[102G[4]+=u-t;t=u;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       /* al\u001b[16Gernat\u001b[22Gve: gemv over whole K\u001b[44Ggiv\u001b[48Gng sum over all heads (bandwidth probe) */\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       cblas_sgemv(CblasRowM\u001b[35G,CblasN\u001b[43GTrans,T,KVD,1,kc,KVD,q,1,0,sc,1);\u001b[77Gu=now();tt[5]+=u-t;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   const char*nm[]={\"K@qblk\u001b[31Gsgemm\",\"mtrans\",\"softmax\u001b[56Gx12\",\"att@V\u001b[68Gsgemm\",\"alt:\u001b[81Gqblk^T\u001b[88GK^T\u001b[92Gsgemm\",\"probe:\u001b[107GK\u001b[109Ggemv\"};\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mfor(int\u001b[14Gi=0;i<6;i++)printf(\"%-24s\u001b[40G%.3f\u001b[45Gms/token\\n\",nm[i],tt[i]/20*1e3);\r\u001b[1B \u001b[2m\u2502\u001b[22m }\u001b[6G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcc\u001b[7G-O2\u001b[11G-o\u001b[14Gattn2\u001b[20Gattn2.c\u001b[28G-framework\u001b[39GAccelerate\u001b[50G&&\u001b[53G./attn2\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[655.986, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
