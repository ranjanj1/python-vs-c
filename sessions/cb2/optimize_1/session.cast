[991.436, "shows\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[103Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[2C\u001b[1Blooks\u001b[9Gslower\u001b[16Gthan\u001b[21Gthe\u001b[25Gmodel\u001b[31Gwork\u001b[36Gexplains,\u001b[46Gso\u001b[49GI\u001b[51Gsuspect\u001b[59Gthe\u001b[63Greference's\u001b[75GO(n\u00b2)\u001b[81GBPE\u001b[85Gmerge\u001b[91Gloop\u001b[96Gon\u001b[99Gthe\u001b[103G900-word\u001b[112Gprompt,\r\u001b[1B \u001b[3Gand I'm timing ENCODE on it\u001b[32Gown \u001b[37Gext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE runs at 1.6 s\u001b[24Gper\u001b[28G900\u001b[32Gwords\u001b[38Gbecause\u001b[46Gthe\u001b[50Gtokenizer's\u001b[62Gmerge\u001b[68Gloop\u001b[73Grescans\u001b[81Gevery\u001b[87Gpair\u001b[92Geach\u001b[97Gpass.\u001b[103GI'm\u001b[107Gcaching\u001b[115Geach\r\u001b[2C\u001b[1Badjacent\u001b[12Gpair's\u001b[19Gmerge\u001b[25Gcandidate\u001b[35Gso\u001b[38Gonly\u001b[43Gthe\u001b[47Gtwo\u001b[51Gneighbours\u001b[62Gof\u001b[65Ga\u001b[67Gmerge\u001b[73Gget\u001b[77Grecomputed,\u001b[89Gthen\u001b[94Gchecking\u001b[103Gthe\u001b[107Gnew\u001b[111Gencoder\r\u001b[1B \u001b[3Gagainst v1 on many\u001b[22Grandomised texts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new encoder now mat"]
[991.437, "ches\u001b[31Gthe\u001b[35Greference\u001b[45Gon\u001b[48Gall\u001b[52G514\u001b[56Gtest\u001b[61Gtexts,\u001b[68Gand\u001b[72GENCODE\u001b[79Gfor\u001b[83G900\u001b[87Gwords\u001b[93Gfell\u001b[98Gfrom\u001b[103G1608\u001b[108Gms\u001b[111Gto\u001b[114G7.8\u001b[118Gms.\r\u001b[2C\u001b[1BI'm\u001b[7Grunning\u001b[15Gthe\u001b[19Gfull\u001b[24Gvalidation\u001b[35Gsuite\u001b[41Gon\u001b[44Gthe\u001b[48Gfinal\u001b[54Gbuild\u001b[60Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery check passes \u001b[25Gthe\u001b[29Gfi\u001b[32Gal build,\u001b[42Gand\u001b[46Gsince\u001b[52Ggeneration\u001b[63Gtimings\u001b[71Gvary\u001b[76Gbetween\u001b[84Gruns,\u001b[90GI'll\u001b[95Greport\u001b[102Granges.\u001b[110GNext\u001b[115GI'm\r\u001b[1B  copying the profiling scripts into prof/ and updating NOTES.md.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[18C\u001b[2B\u001b[38;2;102;102;102m8\u001b[27G8\u001b[29G0\u001b[39m\u001b[40;1H\u001b[38;3H"]
