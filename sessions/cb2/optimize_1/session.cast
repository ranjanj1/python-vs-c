[854.376, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe narrow-N\u001b[16Gsgemm is the bottleneck, so I'm trying Q_blk\u1d40\u00b7K\u1d40\u001b[65Ginstead,\u001b[74Gwhich\u001b[80Gruns\u001b[85Gfaster\u001b[92Gand\u001b[96Gneeds\u001b[102Gno\u001b[105Gtranspose,\u001b[116Gand\r\u001b[2C\u001b[1BI'll\u001b[8Gcompare\u001b[16Git\u001b[19Gwith\u001b[24Gthe\u001b[28Gper-head\u001b[37Gpath\u001b[42Gto\u001b[45Gfind\u001b[50Gthe\u001b[54Gcrossover.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe per-head pa\u001b[20G wins\u001b[26Gbelow about T=160 and the block\u001b[58Gdi\u001b[61Ggon\u001b[65Gl path\u001b[72Gabove it, roughly 25% faster\u001b[101Gat\u001b[104GT=1000,\u001b[112Gso\u001b[115GI'll\r\u001b[2C\u001b[1Bswitch\u001b[10Gbetween\u001b[18Gthem\u001b[23Gat\u001b[26Gthat\u001b[31Gcrossover\u001b[41Gand\u001b[45Gkeep\u001b[50Gthe\u001b[54Gper-head\u001b[63Gpath\u001b[68Gfor\u001b[72Gfixture-sized\u001b[86Gworkloads.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Ghybrid path passes\u001b[26Gall checks, with long-context attention down t\u001b[73G about 394 ms and sho\u001b[95Gt-co\u001b[100Gtext unchanged at 43\r\u001b[2C\u001b[1Bms. Since cmp.py still used the\u001b"]
[854.377, "[35Gold\u001b[39GCHUNK=1\u001b[47Gbinary,\u001b[55GI'm\u001b[59Grebuilding\u001b[70Gfrom\u001b[75Gcurrent\u001b[83Gsource\u001b[90Gand\u001b[94Grerunning\u001b[104Gthe\u001b[108Gcomparison,\r\u001b[2C\u001b[1Bblock-diagonal\u001b[18Gpath\u001b[23Gincluded.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll three builds match wi\u001b[30Gin 3.7e-5 over 600 positions,\u001b[60Gcovering\u001b[69Gthe\u001b[73Gblock-diagonal\u001b[88Gdecode\u001b[95Gpath\u001b[100Gand\u001b[104Gcausal\u001b[111Grow\r\u001b[2C\u001b[1Bgroups.\u001b[11GI'm\u001b[15Gre-profiling\u001b[28Gthe\u001b[32Gfixture-sized\u001b[46Gprefill\u001b[54Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill at fixtur\u001b[21G size\u001b[27Gdropped from\u001b[40G614 to 455 ms, and th\u001b[62G 1024-toke\u001b[74Gcase now runs into softmax exp work\u001b[110Gthe\u001b[K\r\u001b[2C\u001b[1Breference also does, so I'm\u001b[31Gstopping\u001b[40Goptimisation\u001b[53Gthere.\u001b[60GNext\u001b[65GI'll\u001b[70Grun\u001b[74Gan\u001b[77Galternating\u001b[89Ghead-to-head\u001b[102Gagainst\u001b[110Gv1\u001b[113Gand\u001b[117Ga\r\u001b[2C\u001b[1Blong-context\u001b[16Gcomparison.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;"]
