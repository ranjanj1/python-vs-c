[562.352, "\u001b[10Gholds\u001b[16Gat\u001b[19Gabout\u001b[25G126\u001b[29Gtok/s\u001b[35Gacross\u001b[42Gwidths\u001b[49G256\u001b[53Gto\u001b[56G448,\u001b[61Gbut\u001b[65Gwidth\u001b[71G256\u001b[75Gprefills\u001b[84G17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[1B \u001b[3Gd\u001b[5Gfault. Next I'll test whether\u001b[35Gtran\u001b[40Gpos\u001b[44Gng directly\u001b[56Gfrom\u001b[61Gan mmap of the checkpoint be\u001b[90Gts the staging copy\u001b[110Gfor load\r\u001b[2C\u001b[1Btime.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing\u001b[15Gstraight\u001b[24Gfrom\u001b[29Gthe\u001b[33Gmmap\u001b[38Gcuts\u001b[43Gload\u001b[48Gfrom\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1B \u001b[3Git. I'll also try \u001b[38;2;87;105;247mmadvise\u001b[29G\u001b[39mhints on\u001b[38Gthe mapping.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gshowed\u001b[28Gno\u001b[31Gmeasurable\u001b[42Ggain,\u001b[48Gso\u001b[51GI'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b"]
