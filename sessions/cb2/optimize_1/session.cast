[100.15, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mBad input:\u001b[16G\u001b[22mmalformed\u001b[26Gcommands,\u001b[36Gout-of-range\u001b[49Gids,\u001b[54Gand\u001b[58GFIXED/LOGITS\u001b[71Gwith\u001b[76Gmore\u001b[81Gthan\u001b[86G1024\u001b[91Gids\u001b[95Gget\u001b[99Gan\u001b[102G\u001b[38;2;87;105;247mERR \u2026\u001b[108G\u001b[39mline.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[15G\u001b[22mit\u001b[18Gisn't\u001b[24Gzeroed\u001b[31Gbetween\u001b[39Gcommands.\u001b[49GEach\u001b[54Gcommand\u001b[62Gwrites\u001b[69Gevery\u001b[75Gposition\u001b[84Gbefore\u001b[91Greading\u001b[99Git,\u001b[103Gso\u001b[106Gnothing\u001b[114Gcarries\r\u001b[1B    over.\u001b[K\r\u001b[1B  - \u001b[1mScope:\u001b[22m I only tested against the public fixtures, and the final gate uses other inputs.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GBrewed for 5m 55s \u00b7 done 8:49 AM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record pro"]
[100.152, "filing evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[2B\u001b[49m\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[2C\u001b[2BThe fixture prompts are the only development workloads availab\u001b[66Ge, so\u001b[72GI'm leaving /Users/Share\u001b[97G/pvc-kit untouch\u001b[114Gd and\r\u001b[2C\u001b[1Bch\u001b[6Gc\u001b[8Ging hard\u001b[17Gare and buil\u001b[30Ging a workload\u001b[45Gdriver next.\u001b[K\r\u001b[2C\u001b[4BG\u001b[5Gneration is the bottleneck at abou\u001b[40G 12.5 \u001b[47Gs per token, roughly 2.4 s of \u001b[78Ghe workload.\u001b[91GI'm adding section \u001b[111Gim\u001b[114Grs to\r\u001b[2C\u001b[1Bbr\u001b[6Gak that\u001b[14Gdown\u001b[19Gfurther and measuring th\u001b[45Graw memory-bandwidth ceiling next.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight streaming takes 97% of generation\u001b[44Gtime,\u001b[50Gwith\u001b[55Gall\u001b[59Gfive\u001b[64Gweight\u001b[71Gproducts\u001b[80Grunning\u001b[88Gat\u001b[91G33\u201337\u001b[97GGB/s.\u001b[103GI'm\u001b[107Gnext\u001b[112Gtesting\r\u001b[2C\u001b[1Bwhether 36 GB/s is really the single-core\u001b[45Gceiling\u001b[53Gon\u001b[56Gthis\u001b[61GM1,\u001b[65Gusing\u001b[71Gpure-read\u001b[81G"]
[100.153, "kernels\u001b[89Gand\u001b[93Gother\u001b[99GAccelerate\u001b[110Groutines.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPure reads hit 63 GB/s\u001b[26Gbut\u001b[30Gsgemv\u001b[36Gonly\u001b[41Greaches\u001b[49Gabout\u001b[55G35,\u001b[59Gand\u001b[63Gtransposed\u001b[74Gweights\u001b[82Gvary\u001b[87Gfrom\u001b[92G26\u001b[95Gto\u001b[98G46\u001b[101GGB/s\u001b[106Gdepending\u001b[116Gon\r\u001b[2C\u001b[1Boutput width. I'm sweeping row count against column-block width to find the fastest blocking.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[3GD\u001b[38;2;245;149;117mriz\u001b[38;2;215;119;87mzling\u2026 \u001b[26G\u001b[38;2;102;102;102m7\u001b[28G4\u001b[40G\u001b[38;2;181;181;181mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
