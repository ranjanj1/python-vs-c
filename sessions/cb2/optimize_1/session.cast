[26.222, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B Generation is limited by memory speed: it reads the\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[1C\u001b[1B here. Trying \u001b[38;2;87;105;247msgemm\u001b[39m instead, or storing the weights \u001b[55Grans\u001b[60Gosed, gav\u001b[70G no gain.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md\u001b[48Gdoesn't\u001b[56Gcover\u001b[62Gthese\u001b[68Gcases)\r\u001b[1C\u001b[1B - \u001b[1mNumerics:\u001b[22m r\u001b[17Gsults\u001b[23Gdiffer\u001b[30Gslightly\u001b[39Gfrom\u001b[44Gthe\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[1C\u001b[1B \u001b[5Ggreedy generation\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpick\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[1C\u001b[1B -\u001b[5G\u001b[1mStop order:\u001b[17G\u001b[22min GENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[35G\u001b[39mis\u001b[38Gchecked\u001b[46Gfirst,\u001b[53Gthen\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m,\u001b[63Gthen\u001b[68G\u001b[38;2;87;105;247mcontext\u001b[39m.\r\u001b[1C\u001b[1B -\u001b[5G\u001b[1mEdge cases:\u001b[22m "]
[26.223, "a \u001b[20Grompt longer than 1024 tokens answ\u001b[56Gs \u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand\u001b[78G\u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[1C\u001b[1B \u001b[5Grunning th\u001b[16G model.\r\u001b[1C\u001b[1B - \u001b[1mEmpty pieces:\u001b[19G\u001b[22mPIECE\u001b[25Gprints\u001b[32G\u001b[38;2;87;105;247mHEX \u001b[37G\u001b[39mwith\u001b[42Gnothing\u001b[50Gafter\u001b[56Git\u001b[59Gfor\u001b[63Gan\u001b[66Gempty\u001b[72Gpiece.\u001b[79GThat\u001b[84Gincludes\u001b[93Gthe\u001b[97Graw\u001b[101Gbyte\u001b[106G\u001b[38;2;87;105;247m<0x00>\u001b[39m,\u001b[114Gbecause\r\u001b[1C\u001b[1B \u001b[5Gthe refere\u001b[16Gce treats pi\u001b[29Gces as C strings.\u001b[K\r\u001b[1C\u001b[1B - \u001b[1mBad input:\u001b[22m m\u001b[19Gformed commands,\u001b[36Gout-of-range\u001b[49Gids,\u001b[54Gand\u001b[58GFIXED/LOGITS\u001b[71Gwith\u001b[76Gmore\u001b[81Gthan\u001b[86G1024\u001b[91Gids\u001b[95Gget\u001b[99Gan\u001b[102G\u001b[38;2;87;105;247mERR \u2026\u001b[108G\u001b[39mline.\r\u001b[1C\u001b[1B - \u001b[1mKV cache:\u001b[15G\u001b[22mit\u001b[18Gisn't\u001b[24Gzeroed\u001b[31Gbetween\u001b[39Gcommands.\u001b[49GEach\u001b[54Gcommand\u001b[62Gwrites\u001b[69Gevery\u001b[75Gposition\u001b[84Gbefore\u001b[91Greading\u001b[99Git,\u001b[103Gso\u001b[106Gnothing\u001b[114Gcarries\r\u001b[1C\u001b[1B \u001b[5Gover.\u001b[K\r\u001b[1C\u001b[1B -\u001b[5G\u001b[1mScope:\u001b[12G\u001b["]
