[1068.356, "76Gelement).\u001b[86GLong-context\u001b[99Gattention\u001b[109Gcost\u001b[114Gabout\u001b[120G4\r\u001b[2C\u001b[1B \u001b[5Gms per token.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m the\u001b[20Greference's merge \u001b[39Goop\u001b[43Gtook 1.6 s on a\u001b[59G900-word prompt.\u001b[76G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mWeights are stored transposed in 256-column blocks\u001b[22m,\u001b[58Gwith\u001b[63Gone\u001b[67GAccelerate\u001b[78Gcall\u001b[83Gper\u001b[87Gblock.\u001b[94GPrompt\u001b[101Gprocessing\u001b[112Gloses\r\u001b[2C\u001b[1B \u001b[5G nothing from this layout.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mQ/K/V and W1/W3 are now separate matrices.\u001b[49G\u001b[22mK\u001b[51Gand\u001b[55GV\u001b[57Gare\u001b[61Gwritten\u001b[69Gdirectly\u001b[78Ginto\u001b[83Gthe\u001b[87GKV\u001b[90Gcache,\u001b[97Gand\u001b[101GSwiGLU\u001b[108Gruns\u001b[113Gas\u001b[116Ga\u001b[118Gfew\r\u001b[2C\u001b[1B \u001b[5G whole-buffer vDSP/vForce calls in the reference's order of operations.\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe embedding table is read from the transposed classifier\u001b[22m,\u001b[66Gso\u001b[69Gthe\u001b[73Gweights\u001b[81Gare\u001b[85Gonly\u001b[90Gheld\u001b[95Gin\u001b[98Gmemory\u001b[105Gonce.\r\u001b[2C\u001b[1B4. \u001b[1mLoading transposes straight from an mmap\u001b[47G\u001b[22mof\u001b[50Gthe\u001b[54Gcheckpoint,\u001b[66Gw"]
[1068.358, "ith\u001b[71Gno\u001b[74Gstaging\u001b[82Gcopy.\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mAtten\u001b[12Gion over a chunk of prompt\u001b[39Gtokens skips the masked-out region.\u001b[22m Everything the reference compute\u001b[108G is\u001b[112Gstill\r\u001b[5C\u001b[1Bc\u001b[8Gmputed.\u001b[K\r\u001b[2C\u001b[1B6\u001b[6G\u001b[1mFrom 160 positions o\u001b[27Gwards, single-\u001b[42Goken attention handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[22m This adds\u001b[K\r\u001b[5C\u001b[1Bmultiplications by ze\u001b[28Go but removes non\u001b[46G of th\u001b[53G refer\u001b[60Gnce's wo\u001b[69Gk. Below\u001b[78G160\u001b[82Gthe\u001b[86Gold\u001b[90Gper-head\u001b[99Gpath\u001b[104Gis\u001b[107Gkept\u001b[112Gbecause\r\u001b[2C\u001b[1B  \u001b[6Git is faster there.\u001b[K\r\u001b[2C\u001b[1B7\u001b[6G\u001b[1mThe tokenizer cache\u001b[26G the merge candidate for each adjacent pair.\u001b[71G\u001b[22mIts output\u001b[82Gis identical\u001b[95Gto\u001b[98Gthe\u001b[102Greference\u001b[112Galgorithm\r\u001b[2C\u001b[1B  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults\u001b[11G(medians of alternating runs)\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
