[601.449, "\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsizes\u001b[15G320\u2013384\u001b[23Ghave\u001b[28Gbeen\u001b[33Gthe\u001b[37Gonly\u001b[42Gconsistently\u001b[55Gfast\u001b[60Gband,\u001b[66Gand\u001b[70Gall\u001b[74Gmy\u001b[77Gblocks\u001b[84Gfall\u001b[89Gthere,\u001b[96Gso\u001b[99GI'm\u001b[103Grunning\r\u001b[2C\u001b[1Balternating binaries\u001b[24Gover\u001b[29Gseveral\u001b[37Gruns\u001b[42Gand\u001b[46Gcomparing\u001b[56Gmedians.\u001b[65GI'm\u001b[69Galso\u001b[74Gmaking\u001b[81GBLOCK_MAX\u001b[91Ga\u001b[93Gbuild-time\u001b[104Goption\u001b[111Gfor\u001b[115Gthat.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode holds at about\u001b[25G126\u001b[29Gtok/s\u001b[35Gacross\u001b[42Gwidths\u001b[49G256\u001b[53Gto\u001b[56G448,\u001b[61Gbut\u001b[65Gwidth\u001b[71G256\u001b[75Gprefills\u001b[84G17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[2C\u001b[1Bdefault.\u001b[12GNext\u001b[17GI'll\u001b[22Gtest\u001b[27Gwhether\u001b[35Gtransposing\u001b[47Gdirectly\u001b[56Gfrom\u001b[61Gan\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[1B \u001b[3Gtime.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;1"]
[601.451, "02mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing straight\u001b[24Gfrom the mmap\u001b[38Gcuts load from about\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1B  it. I'll also try \u001b[38;2;87;105;247mmadvise\u001b[39m hints on the mapping.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m The madvise hints showed no measurable gain, so I'm dropping them and profiling decode attention at long context next.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Decode attention runs about 4 ms per token against a roughly 1.2 ms bandwidth floor, because the per-head strided\u001b[K\r\u001b[1C\u001b[1B sgemv calls\u001b[15Gare the bottl\u001b[29Gneck.\u001b[35GI'm batching the 12 head queries\u001b[68Gin\u001b[71Go one block-diagonal matrix so K and V are each\r\u001b[1C\u001b[1B read once with contigu\u001b[26Gus sgemm calls.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m "]
[601.452, "\u001b[39m Checking correctness and profiling long/short decode\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ./build.sh && python3 check.py --tokens 64 --prompts 3 -- ./cb2 | tail -3 && python3 /tmp/cb2t/cmp.py && cc -O3 \r\u001b[5C\u001b[1B-mcpu=native -DPROF -o /tmp/cb2t/cb2prof cb2.c -framework Accelerate && /tmp/cb2t/cb2prof model.bin tokenizer.bin <\r\u001b[1C\u001b[1B\u001b[39m  \u001b[5G \u001b[38;2;102;102;102m/tmp/cb2t/long.txt | tail -1; /tmp/cb2t/profrun.sh cb2.c\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;226;130;98mDrizzling\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(9m 46s \u00b7 \u2193\u001b[26G40.8k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[92G\u001b[39m\u001b[K\r\u001b[6C\u001b[1B                 \u001b[25G         \u001b[35G             \u001b[49G \u001b[51G                  \u001b[70G \u001b[72G    \u001b[77G   \u001b[81G                    \u001b[102G \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[601.453, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
