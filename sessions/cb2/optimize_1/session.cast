[604.479, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsizes\u001b[15G320\u2013384\u001b[23Ghave\u001b[28Gbeen\u001b[33Gthe\u001b[37Gonly\u001b[42Gconsistently\u001b[55Gfast\u001b[60Gband,\u001b[66Gand\u001b[70Gall\u001b[74Gmy\u001b[77Gblocks\u001b[84Gfall\u001b[89Gthere,\u001b[96Gso\u001b[99GI'm\u001b[103Grunning\r\u001b[1B \u001b[3Ga\u001b[5Gternating\u001b[15Gbinaries o\u001b[27Gr s\u001b[31Gveral\u001b[37Gruns\u001b[42Gand comparing medians. I'm also\u001b[75Gaking BLOCK_MAX a build-ti\u001b[102Ge opt\u001b[108Gon\u001b[111Gfor\u001b[115Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode\u001b[10Gholds\u001b[16Gat\u001b[19Gabout\u001b[25G126\u001b[29Gtok/s\u001b[35Gacross\u001b[42Gwidths\u001b[49G256\u001b[53Gto\u001b[56G448,\u001b[61Gbut\u001b[65Gwidth\u001b[71G256\u001b[75Gprefills\u001b[84G17%\u001b[88Gfaster,\u001b[96Gso\u001b[99GI'm\u001b[103Gmaking\u001b[110Git\u001b[113Gthe\r\u001b[1B \u001b[3Gd\u001b[5Gfault. Next I'll test whether\u001b[35Gtran\u001b[40Gpos\u001b[44Gng directly\u001b[56Gfrom\u001b[61Gan mmap of the checkpoint be\u001b[90Gts the staging copy\u001b[110Gfor load\r\u001b[2C\u001b[1Btime.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2"]
[604.48, "C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing\u001b[15Gstraight\u001b[24Gfrom\u001b[29Gthe\u001b[33Gmmap\u001b[38Gcuts\u001b[43Gload\u001b[48Gfrom\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[1B \u001b[3Git. I'll also try \u001b[38;2;87;105;247mmadvise\u001b[29G\u001b[39mhints on\u001b[38Gthe mapping.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gshowed\u001b[28Gno\u001b[31Gmeasurable\u001b[42Ggain,\u001b[48Gso\u001b[51GI'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode\u001b[10Gattention\u001b[20Gruns\u001b[25Gabout\u001b[31G4\u001b[33Gms\u001b[36Gper\u001b[40Gtoken\u001b[46Gagainst\u001b[54Ga\u001b[56Groughly\u001b[64G1.2\u001b[68Gms\u001b[71Gbandwidth\u001b[81Gfloor,\u001b[88Gbecause\u001b[96Gthe\u001b[100Gper-head\u001b[109Gstrided\r\u001b[1B \u001b[3Gsgemv c\u001b[11Glls are the bottleneck. I'm batching the 12 head querie"]
[604.48, "s\u001b[68Ginto one block-diagonal matrix so K and V a\u001b[112Ge \u001b[115Gach\r\u001b[2C\u001b[1Bread once with contiguous sgemm\u001b[35Gcalls.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mChecking\u001b[12Gcorrectness\u001b[24Gand\u001b[28Gprofiling\u001b[38Glong/short\u001b[49Gdecode\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ ./build.sh && python3 check.py --tokens 64 --prompt\u001b[60G 3 -- ./cb2 | tail -3 && python3 /tmp/cb2t/cmp.py && cc -O3 \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m-mcpu=native\u001b[19G-DPROF -o /tmp/cb2t/cb2prof cb2.c -framework Accelerate && /tmp/cb2t/cb2prof model.bin tokenizer.bin\u001b[120G<\r\u001b[5C\u001b[1B/tm\u001b[10G/cb2\u001b[15G/long.txt | tail -1; /\u001b[38Gmp/cb2t/profrun.sh cb2.c (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+\u001b[13G \u001b[15Go run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
