[695.729, "if\u001b[22G(c\u001b[25G==\u001b[28G1)\u001b[31G{\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             /* long\u001b[24Gcontext,\u001b[33Gall\u001b[37Gheads\u001b[43Gat\u001b[46Gonce''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mR('#define\u001b[15GATT_ROWS\u001b[24G64\u001b[27G/*\u001b[30Gquery\u001b[36Grows\u001b[41Gper\u001b[45Gcausal\u001b[52Gattention\u001b[62Ggroup\u001b[68Gin\u001b[71Gchunked\u001b[79Gforward\u001b[87G*/',\r\u001b[1B \u001b[2m\u2502\u001b[22m   '#define ATT_ROWS 64 /* query rows\u001b[41Gper causal attention group in chunked forward */\\n#defi\u001b[98G ATT_BLOCKDIAG_MIN 160\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m /* single-token a\u001b[22Gtention switches \u001b[40Go\u001b[43Ghe all-heads sgemm path\u001b[67Gat\u001b[70Gthis\u001b[75Gmany\u001b[80Gkeys\u001b[85G*/')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen(p,'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m./build.sh\u001b[15G&&\u001b[18Gpython3\u001b[26Gcheck.py\u001b[35G--tokens\u001b[44G64\u001b[47G--prompts\u001b[57G3\u001b[59G--\u001b[62G./cb2\u001b[68G|\u001b[70Gtail\u001b[75G-1\u001b[78G&&\u001b[81Gpython3\u001b[89G/tmp/cb2t/cmp.py\u001b[106G&&\u001b[109Gpython3\r\u001b[1B \u001b[2m\u2502\u001b[22m /tm\u001b[8G/cb2t/ctx.py\u001b[21G&& cc -O3 -mcp\u001b[36G=native\u001b[44G-DPROF -o /tmp/cb2t/cb2\u001b[68Grof\u001b[72Gc\u001b[74G2.c\u001b[78G-framework Accelera\u001b[99G && /tmp/cb2t/cb2prof\r\u001b[1C\u001b[1B\u001b"]
[695.73, "[2m\u2502\u001b[22m model.\u001b[11Gin tokenizer.bin < /tmp/cb2t/lo\u001b[43Gg.txt | tail -1; /tm\u001b[64G/cb2t/profrun.sh cb2.c 2>&1 | grep\u001b[99G-E\u001b[102G\"attention|total\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22"]
