[621.852, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mB\u001b[5Gock sizes\u001b[15G320\u2013384 ha\u001b[27G be\u001b[31Gn the\u001b[37Gonly\u001b[42Gconsistently fast band, and all\u001b[75Gy blocks fall there, so I'\u001b[102G runn\u001b[108Gng\u001b[111G\u001b[K\r\u001b[2C\u001b[1Balternating\u001b[15Gbinaries\u001b[24Gover\u001b[29Gseveral\u001b[37Gruns\u001b[42Gand\u001b[46Gcomparing\u001b[56Gmedians.\u001b[65GI'm\u001b[69Galso\u001b[74Gmaking\u001b[81GBLOCK_MAX\u001b[91Ga\u001b[93Gbuild-time\u001b[104Goption\u001b[111Gfor\u001b[115Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mD\u001b[5Gcode holds at about 126 tok/s\u001b[35Gacro\u001b[40Gs w\u001b[44Gdths 256 to\u001b[56G448,\u001b[61Gbut width 256 prefills 17% f\u001b[90Gster, so I'm making\u001b[110Git the\u001b[K\r\u001b[2C\u001b[1Bdefault.\u001b[12GNext\u001b[17GI'll\u001b[22Gtest\u001b[27Gwhether\u001b[35Gtransposing\u001b[47Gdirectly\u001b[56Gfrom\u001b[61Gan\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[2C\u001b[1Btime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b["]
[621.853, "38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposing straight from\u001b[29Gthe mmap\u001b[38Gcuts load from\u001b[53Gabout\u001b[59G114\u001b[63Gto\u001b[66G103\u001b[70Gms\u001b[73Gwith\u001b[78Gno\u001b[81Geffect\u001b[88Gon\u001b[91Ganything\u001b[100Gelse,\u001b[106Gso\u001b[109GI'm\u001b[113Gkeeping\r\u001b[2C\u001b[1Bit.\u001b[7GI'll\u001b[12Galso\u001b[17Gtry\u001b[21G\u001b[38;2;87;105;247mmadvise\u001b[29G\u001b[39mhints\u001b[35Gon\u001b[38Gthe\u001b[42Gmapping.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmadvise\u001b[15Ghints\u001b[21Gshowed\u001b[28Gno\u001b[31Gmeasurable\u001b[42Ggain,\u001b[48Gso\u001b[51GI'm\u001b[55Gdropping\u001b[64Gthem\u001b[69Gand\u001b[73Gprofiling\u001b[83Gdecode\u001b[90Gattention\u001b[100Gat\u001b[103Glong\u001b[108Gcontext\u001b[116Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDecode \u001b[11Gttention runs about 4 ms per token against a roughly 1.2\u001b[68Gms bandwidth floor, because the per-head st\u001b[112Gid\u001b[115Gd\u001b[K\r\u001b[2C\u001b[1Bsgemv calls are the bottleneck.\u001b[35GI'm batching\u001b[48Gthe\u001b[52G12\u001b[55Ghead\u001b[60Gqueries\u001b[68Ginto\u001b[73Gone\u001b[77Gblock-diagonal\u001b[92Gmatrix\u001b[99Gso\u001b[102GK\u001b"]
