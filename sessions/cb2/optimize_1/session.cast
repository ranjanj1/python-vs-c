[281.438, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Grose\u001b[19Gfrom\u001b[24G80\u001b[27Gto\u001b[30G131.5\u001b[36Gtok/s\u001b[42G(1.64\u00d7)\u001b[50Gwith\u001b[55Gthe\u001b[59Gfull\u001b[64Gcheck\u001b[70Gstill\u001b[76Gpassing,\u001b[85Gthough\u001b[92Gload\u001b[97Gtime\u001b[102Gwent\u001b[107Gup\u001b[110Gfrom\u001b[115Gabout\r\u001b[2C\u001b[1B80 to 124 ms because\u001b[24Gof\u001b[27Gthe\u001b[31Gtransposition.\u001b[46GI'm\u001b[50Gadding\u001b[57Gsection\u001b[65Gtimers\u001b[72Gto\u001b[75G\u001b[38;2;87;105;247mcb2.c\u001b[81G\u001b[39mbehind\u001b[88G\u001b[38;2;87;105;247m-DPROF\u001b[95G\u001b[39mso\u001b[98Gprofiling\u001b[108Gcan\u001b[112Gbe\r\u001b[2C\u001b[1Breproduced.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight products now run near the 63\u001b[39GGB/s\u001b[44Gread\u001b[49Gceiling,\u001b[58Gand\u001b[62Gweight\u001b[69Gstreaming\u001b[79Gis\u001b[82Gstill\u001b[88Gabout\u001b[94G96%\u001b[98Gof\u001b[101Gdecode\u001b[108Gtime.\u001b[114GNext\r\u001b[2C\u001b[1BI'm\u001b[7Gprofiling\u001b[17Gprefill\u001b[25Gand\u001b[29Gload,\u001b[35Gsince\u001b[41GLOGITS\u001b[48Gand\u001b[52GFIXED\u001b[58Geach\u001b[63Gtake\u001b[68Groughly\u001b[76G42\u001b[79Gms\u001b[82Gon\u001b[85G69\u201382\u001b[91Gtokens.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B"]
[281.439, "\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gis\u001b[14Gmostly\u001b[21Gspent\u001b[27Gin\u001b[30Gthe\u001b[34Gweight\u001b[41Gmatmuls\u001b[49G(about\u001b[56G84%,\u001b[61Gonly\u001b[66G~450\u001b[71GGFLOP/s\u001b[79Gat\u001b[82GM\u224876),\u001b[89Gwith\u001b[94GSwiGLU's\u001b[103Gscalar\u001b[110Gexpf\u001b[115Gtaking\r\u001b[2C\u001b[1B9%. I'll benchmark sgemm\u001b[28Glayouts\u001b[36Gfor\u001b[40GM\u224876\u001b[45Gand\u001b[49GM=512\u001b[55Gto\u001b[58Gsee\u001b[62Gwhether\u001b[70Gthe\u001b[74Gblock\u001b[80Glayout\u001b[87Gis\u001b[90Gcosting\u001b[98Gprefill\u001b[106Gtime.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mB\u001b[5Gnc\u001b[8Gmarking sgemm layouts for prefill \u001b[43Ghapes\u001b[49G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cb2t && sed -i '' \u001b[35G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m's/cblas_sgemm(CblasColMajor,CblasTrans,CblasTrans,w,M,n,1,W+L\\*per+(size_t)n\\*j,w,X,n,0,Y+(size_t)j\\*M,w)/cblas_sg\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102memm(Cb\u001b[13GasR\u001b[17GwM\u001b[20Gjor,CblasNoTrans,CblasNoTrans,M,w,n,1,X,n,W+L*per+(size_t)n*j,w,0,Y+(size_t)j*M,w)/' gemm.c && sed -i\r\u001b[5C\u001b[1B'' 's/blocks Yt/blocks contigY/' gemm.c \u2026\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[281.439, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mRerun\u001b[8Gsgemm layou\u001b[21Gben\u001b[25Ghmark\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcd /tmp/cb2t && sed -i ''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m's/cblas_sgemm(CblasColMajor,CblasTrans,CblasTra"]
[281.44, "ns,w,M,n,1,W+L\\*per+(size_t)n\\*j,w,X,n,0,Y+(size_t)j\\*M,w)/cblas_sge\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmm(CblasRowMajor,CblasNoTrans,CblasNoTrans,M,w,n,1,X,n,W+L*per+(size_t)n*j,w,0,Y+(size_t)j*M,w)/'\u001b[102Ggemm.c\u001b[109G&&\u001b[112Gsed\u001b[116G-i\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'' 's/blocks Yt/blocks\u001b[27GcontigY/'\u001b[37Ggemm.c\u001b[44G&&\u001b[47Gcc\u001b[50G-O2\u001b[54G-o\u001b[57Ggemm\u001b[62Ggemm.c\u001b[69G-framework\u001b[80GAccelerate\u001b[91G&&\u001b[94G./gemm\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mCompound command contains cd with write\u001b[44Goperation\u001b[54G-\u001b[56Gmanual\u001b[63Gapproval\u001b[72Grequired\u001b[81Gto\u001b[84Gprevent\u001b[92Gpath\u001b[97Gresolution\u001b[108Gbypass\r\u001b[2B Do you want to proceed?\u001b[26G\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m"]
[281.441, "\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gcd\u001b[40G*\u001b[103G\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
