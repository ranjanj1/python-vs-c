[991.763, "\u001b[H\u001b[3Gv1 generates 3\u00d764 in 2415 ms against\u001b[40Gv2's\u001b[45G1450 m\u001b[52G, and the table shows the rest \u001b[84Gf the timings. The long GENERATE\u001b[117Grun\r\u001b[2C\u001b[1Blo\u001b[6Gks slower than the model work expla\u001b[42Gns,\u001b[46Gso I susp\u001b[56Gc\u001b[58G the\u001b[63Greference's\u001b[75GO(n\u00b2)\u001b[81GBPE\u001b[85Gmerge\u001b[91Gloop\u001b[96Gon\u001b[99Gthe\u001b[103G900-word\u001b[112Gprompt,\r\u001b[2C\u001b[1Band\u001b[7GI'm\u001b[11Gtiming\u001b[18GENCODE\u001b[25Gon\u001b[28Gits\u001b[32Gown\u001b[36Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE runs at\u001b[18G1.6 s\u001b[24Gper 900 w\u001b[34Grds because the tokeniz\u001b[58Gr's merge \u001b[69Goop resc\u001b[78Gns every pair each pass. I'm caching each\r\u001b[2C\u001b[1Badjacent pair's me\u001b[22Gge candidate\u001b[35Gso\u001b[38Gonly\u001b[43Gthe\u001b[47Gtwo\u001b[51Gneighbours\u001b[62Gof\u001b[65Ga\u001b[67Gmerge\u001b[73Gget\u001b[77Grecomputed,\u001b[89Gthen\u001b[94Gchecking\u001b[103Gthe\u001b[107Gnew\u001b[111Gencoder\r\u001b[2C\u001b[1Bagainst\u001b[11Gv1\u001b[14Gon\u001b[17Gmany\u001b[22Grandomised\u001b[33Gtexts.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mT"]
[991.764, "he new encoder \u001b[20Gow match\u001b[29Gs\u001b[31Gthe r\u001b[37Gference on all 514 tes\u001b[60G texts, a\u001b[70Gd ENC\u001b[76GDE for 900 words fell from\u001b[103G16\u001b[106G8 ms to 7.8 ms.\r\u001b[2C\u001b[1BI'm\u001b[7Grunning the full validati\u001b[33Gn suite on\u001b[44Gthe\u001b[48Gfinal\u001b[54Gbuild\u001b[60Gnext.\r\u001b[3C\u001b[4Bvery check\u001b[15Gpasses\u001b[22Gon the final build, and\u001b[46Gsince g\u001b[55Geration timings va\u001b[74Gy betwe\u001b[82Gn \u001b[85Guns, I'll re\u001b[98Gort ranges. Next\u001b[115GI'm\u001b[K\r\u001b[2C\u001b[1Bcopying the profiling\u001b[25Gscripts int\u001b[38Gprof/ and updat\u001b[54Gng NOTES.md.\u001b[67G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mSaving\u001b[10Gprofiling\u001b[20Gscripts\u001b[28Ginto\u001b[33Gproject\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ mkdir -p prof && cp /tmp/cb2t/{dev.py,ab.py,profrun.sh,bw.c,sweep.c,sweep2.c,gemm.c,attn.c,attn2.c,enc.py,cmp2.py\r\u001b[5C\u001b[1B,ctx.py,t.py,longgen.py} prof/ && ls prof && grep -n \"^static\\|^#define\" cb2.c | head -40 && wc -l cb2.c\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
