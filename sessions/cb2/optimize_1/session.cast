[1069.501, "ath is\u001b[107Gkept\u001b[112Gbecause\r\u001b[5C\u001b[1Bit is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[71G\u001b[22mIts\u001b[75Goutput\u001b[82Gis\u001b[85Gidentical\u001b[95Gto\u001b[98Gthe\u001b[102Greference\u001b[112Galgorithm\r\u001b[2C\u001b[1B  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502               Workload                \u2502   v1    \u2502      v2      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764, fixture prompts        \u2502 2415 ms \u2502 1450\u20131585 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1069.503, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73                             \u2502 127 ms  \u2502 97\u2013100 ms    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED \u00d73                              \u2502 124 ms  \u2502 92\u201397 ms     \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 100 after a 901-token prompt \u2502 ~3.5 s  \u2502 1.3 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1069.504, "\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ENCODE, 900 words                     \u2502 1608 ms \u2502 7.8 ms       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY                         \u2502 73 ms   \u2502 ~105 ms      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOther tests\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Gmatches\u001b[19Gevery\u001b[25Gfixture\u001b[33Gentry.\r\u001b[4C\u001b[1BF\u001b[7GXED\u001b[11Gand GENERATE agree with each\u001b[40Gother.\u001b[40;1H\u001b[38;3H\u001b]0;\u25d1 Claude Code\u0007"]
[1069.746, "\u001b[H\u001b[3G  \u001b[6Gwhole-buffer vDSP/vForce calls in the reference's ord\u001b[60Gr of operations.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mThe embedding table is read from the transposed classifier\u001b[22m, so the weights\u001b[81Gare\u001b[85Gonly\u001b[90Gheld\u001b[95Gin\u001b[98Gmemory\u001b[105Gonce.\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mLoading tra\u001b[18Gsposes straight\u001b[39Gan mmap\u001b[22m of the checkpoint\u001b[66Gwith no staging copy.\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mAttention over a chunk of prompt\u001b[39Gtokens skips the masked-out region.\u001b[22m Everything the\u001b[90Greference\u001b[100Gcomputes\u001b[109Gis\u001b[112Gstill\r\u001b[2C\u001b[1B  \u001b[6Gcomputed.\u001b[K\r\u001b[2C\u001b[1B6.\u001b[6G\u001b[1mFrom 160 positions onwards, single-token attention handles all heads with two \u001b[38;2;87;105;247msgemm\u001b[39m calls per layer.\u001b[107G\u001b[22mThis\u001b[112Gadds\r\u001b[2C\u001b[1B  \u001b[6Gmultiplications by zero but removes none of the reference's work. Below 160 the old per-head path is\u001b[107Gkept\u001b[112Gbecause\r\u001b[5C\u001b[1Bit is faster there.\u001b[K\r\u001b[2C\u001b[1B7.\u001b[6G\u001b[1mThe tokenizer caches the merge candidate for each adjacent pair.\u001b[71G\u001b[22mIts\u001b[75Goutput\u001b[82Gis\u001b[85Gidentical\u001b[95Gto\u001b[98Gthe\u001b[102"]
[1069.748, "Greference\u001b[112Galgorithm\r\u001b[2C\u001b[1B  \u001b[6Gon 514 test texts, including the fixtures and random Unicode.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (medians of alternating runs)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502               Workload                \u2502   v1    \u2502      v2      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764, fixture prompts        \u2502 2415 ms \u2502 1450\u20131585 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS \u00d73                            "]
