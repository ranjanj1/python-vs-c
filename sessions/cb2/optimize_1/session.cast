[463.789, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[39m\u001b[40;1H\u001b[38;3H"]
[463.906, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[19G\u001b[38;2;102;102;102m2\u001b[39m\u001b[40;1H\u001b[38;3H"]
[464.001, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gproducts\u001b[19Gnow\u001b[23Grun\u001b[27Gnear\u001b[32Gthe\u001b[36G63\u001b[39GGB/s\u001b[44Gread\u001b[49Gceiling,\u001b[58Gand\u001b[62Gweight\u001b[69Gstreaming\u001b[79Gis\u001b[82Gstill\u001b[88Gabout\u001b[94G96%\u001b[98Gof\u001b[101Gdecode\u001b[108Gtime.\u001b[114GNext\r\u001b[1B \u001b[3GI'm profiling prefill and load, since LOGITS and FIXED\u001b[58Geach take roughly 42\u001b[79Gm\u001b[82Gon 69\u201382 tokens.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gis\u001b[14Gmostly\u001b[21Gspent\u001b[27Gin\u001b[30Gthe\u001b[34Gweight\u001b[41Gmatmuls\u001b[49G(about\u001b[56G84%,\u001b[61Gonly\u001b[66G~450\u001b[71GGFLOP/s\u001b[79Gat\u001b[82GM\u224876),\u001b[89Gwith\u001b[94GSwiGLU's\u001b[103Gscalar\u001b[110Gexpf\u001b[115Gtaking\r\u001b[1B \u001b[3G9%. I'\u001b[10Gl benchmark sgemm layouts for M\u224876 and\u001b[49GM=512 to see whether the block layout is costing prefill time.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6GM=76,\u001b[12Gthe\u001b[16Gblocked\u001b[24Glayout\u001b[31Ggets\u001b[36Gabout\u001b[42G570\u001b[46GGFLOP/s\u001b[54Gin\u001b[57Gsgem"]
[464.002, "m,\u001b[64Gnearly\u001b[71Gthe\u001b[75Gsame\u001b[80Gas\u001b[83Gthe\u001b[87Goriginal\u001b[96G586,\u001b[101Gso\u001b[104Gprefill\u001b[112Gis\r\u001b[1B \u001b[3Gunaffected. I'm splitting W1/W3 and Q/K/V into separate blocked matric\u001b[74Gs next, then\u001b[87Glook\u001b[93Gg at load tim\u001b[107G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mGeneration\u001b[14Gfell\u001b[19Gto\u001b[22G110\u2013116\u001b[30Gtok/s,\u001b[37Gand\u001b[41Gthe\u001b[45Gclassifier\u001b[56Galso\u001b[61Gslowed\u001b[68Gabout\u001b[74G9%\u001b[77Gdespite\u001b[85Gno\u001b[88Gcode\u001b[93Gchange,\u001b[101Gso\u001b[104Gthis\u001b[109Glooks\u001b[115Glike\r\u001b[1B \u001b[3Gmachine nois\u001b[16G. I'm\u001b[22Gre-running the\u001b[37Gbandwidth probe to\u001b[56Gconfirm.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsizes\u001b[15G320\u2013384\u001b[23Ghave\u001b[28Gbeen\u001b[33Gthe\u001b[37Gonly\u001b[42Gconsistently\u001b[55Gfast\u001b[60Gband,\u001b[66Gand\u001b[70Gall\u001b[74Gmy\u001b[77Gblocks\u001b[84Gfall\u001b[89Gthere,\u001b[96Gso\u001b[99GI'm\u001b[103Grunning\r\u001b[1B \u001b[3Ga\u001b[5Gternating\u001b[15Gbinaries o\u001b[27Gr s\u001b[31Gveral\u001b[37Gruns\u001b[42"]
[464.003, "Gand comparing medians. I'm also\u001b[75Gaking BLOCK_MAX a build-ti\u001b[102Ge opt\u001b[108Gon\u001b[111Gfor\u001b[115Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Decode holds at about 126 tok/s across widths 256 to 448, but width 256 prefills 17% faster, so I'm making it the\u001b[K\r\u001b[2C\u001b[1Bdefault. Next I'll test whether transposing directly from an\u001b[64Gmmap\u001b[69Gof\u001b[72Gthe\u001b[76Gcheckpoint\u001b[87Gbeats\u001b[93Gthe\u001b[97Gstaging\u001b[105Gcopy\u001b[110Gfor\u001b[114Gload\r\u001b[2C\u001b[1Btime.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[28C\u001b[2B\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
[464.014, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 7s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[464.03, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[39m\u001b[40;1H\u001b[38;3H"]
[464.235, "\u001b[H\r\u001b[31B\u001b[38;2;102;102;102m \r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m\u001b[40;1H\u001b[38;3H"]
