[897.831, "le\u001b[68Gshows\u001b[74Gthe\u001b[78Grest\u001b[83Gof\u001b[86Gthe\u001b[90Gtimings.\u001b[99GThe\u001b[103Glong\u001b[108GGENERATE\u001b[117Grun\r\u001b[1B \u001b[3Glooks slow\u001b[14Gr\u001b[16Gthan\u001b[21Gthe model work explain\u001b[44G, so I \u001b[52Guspect the ref\u001b[67Grence's O(n\u00b2) BPE merge loop on\u001b[99Gt\u001b[103G900-word prompt,\u001b[K\r\u001b[2C\u001b[1Band I'm timing ENCODE\u001b[25Gon its \u001b[33Gwn\u001b[36Gnext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mENCODE\u001b[10Gruns\u001b[15Gat\u001b[18G1.6\u001b[22Gs\u001b[24Gper\u001b[28G900\u001b[32Gwords\u001b[38Gbecause\u001b[46Gthe\u001b[50Gtokenizer's\u001b[62Gmerge\u001b[68Gloop\u001b[73Grescans\u001b[81Gevery\u001b[87Gpair\u001b[92Geach\u001b[97Gpass.\u001b[103GI'm\u001b[107Gcaching\u001b[115Geach\r\u001b[1B \u001b[3Gadjacent pair's merge candidate so\u001b[38Gonly the two neighbour\u001b[62Gof a merge\u001b[73Gg\u001b[75Gt recomputed, then \u001b[96Gecking\u001b[103Gthe\u001b[107Gnew e\u001b[113Gcoder\u001b[K\r\u001b[3C\u001b[1Bgainst v1 on many randomised texts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mOptimize\u001b[12GBPE\u001b[16Gmerge\u001b[22Gloop\u001b[27Gand\u001b[31Gverify\u001b[38Gidentical\u001b[48Goutput\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ python3 - <<'E"]
