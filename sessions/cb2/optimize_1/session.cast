[0.443, "d,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[2B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md\u001b[48Gdoesn't\u001b[56Gcover\u001b[62Gthese\u001b[68Gcases)\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumerics:\u001b[15G\u001b[22mresults\u001b[23Gdiffer\u001b[30Gslightly\u001b[39Gfrom\u001b[44Gthe\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[4C\u001b[1Bgreedy\u001b[12Ggeneration\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpick\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop order:\u001b[17G\u001b[22min\u001b[20GGENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[35G\u001b[39mis\u001b[38Gchecked\u001b[46Gfirst,\u001b[53Gthen\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m,\u001b[63Gthen\u001b[68G\u001b[38;2;87;105;247mcontext\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[17G\u001b[22ma\u001b[19Gprompt\u001b[26Glonger\u001b[33Gthan\u001b[38G1024\u001b[43Gtokens\u001b[50Ganswers\u001b[58G\u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand\u001b[78G\u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[4C\u001b[1Brunning\u001b[13Gthe\u001b[17Gmodel.\r\u001b[2"]
[0.443, "C\u001b[1B-\u001b[5G\u001b[1mEmpty pieces:\u001b[19G\u001b[22mPIECE\u001b[25Gprints\u001b[32G\u001b[38;2;87;105;247mHEX \u001b[37G\u001b[39mwith\u001b[42Gnothing\u001b[50Gafter\u001b[56Git\u001b[59Gfor\u001b[63Gan\u001b[66Gempty\u001b[72Gpiece.\u001b[79GThat\u001b[84Gincludes\u001b[93Gthe\u001b[97Graw\u001b[101Gbyte\u001b[106G\u001b[38;2;87;105;247m<0x00>\u001b[39m,\u001b[114Gbecause\r\u001b[4C\u001b[1Bthe\u001b[9Greference\u001b[19Gtreats\u001b[26Gpieces\u001b[33Gas\u001b[36GC\u001b[38Gstrings.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBad input:\u001b[16G\u001b[22mmalformed\u001b[26Gcommands,\u001b[36Gout-of-range\u001b[49Gids,\u001b[54Gand\u001b[58GFIXED/LOGITS\u001b[71Gwith\u001b[76Gmore\u001b[81Gthan\u001b[86G1024\u001b[91Gids\u001b[95Gget\u001b[99Gan\u001b[102G\u001b[38;2;87;105;247mERR \u2026\u001b[108G\u001b[39mline.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[15G\u001b[22mit\u001b[18Gisn't\u001b[24Gzeroed\u001b[31Gbetween\u001b[39Gcommands.\u001b[49GEach\u001b[54Gcommand\u001b[62Gwrites\u001b[69Gevery\u001b[75Gposition\u001b[84Gbefore\u001b[91Greading\u001b[99Git,\u001b[103Gso\u001b[106Gnothing\u001b[114Gcarries\r\u001b[4C\u001b[1Bover.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mScope:\u001b[12G\u001b[22mI\u001b[14Gonly\u001b[19Gtested\u001b[26Gagainst\u001b[34Gthe\u001b[38Gpublic\u001b[45Gfixtures,\u001b[55Gand\u001b[59Gthe\u001b[63Gfinal\u001b[69Ggate\u001b[74Guses\u001b[79Gother\u001b[85Ginputs.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GBrewed for 5m 55s \u00b7 done 8:49 AM\r\u001b[102C\u001b[1B\u25cf high \u00b7 /eff"]
