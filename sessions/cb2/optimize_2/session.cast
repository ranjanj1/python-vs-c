[609.805, "\u001b[H\u001b[5Gand\u001b[9Gis 5\u201310% slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLoad is mostly unavoidable.\u001b[33G\u001b[22mAbout\u001b[39G45\u001b[42Gms\u001b[45Gis\u001b[48Gthe\u001b[52Gtranspose\u001b[62Gitself\u001b[69Gand\u001b[73Gabout\u001b[79G35\u001b[82Gms\u001b[85Gis\u001b[88Gpage\u001b[93Gfaults.\u001b[101GThis\u001b[106Gsystem\u001b[113Gdoesn't\r\u001b[2C\u001b[1B \u001b[5Gallow large memory pages, and Accelerate has no f\u001b[55Gster tran\u001b[65Gpose.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttention on short contexts\u001b[22m costs 0.1\u20130.4 m\u001b[50Gper tok\u001b[58Gn, because the\u001b[73GKV\u001b[76Gcache\u001b[82Gis\u001b[85Gpushed\u001b[92Gout\u001b[96Gof\u001b[99Gthe\u001b[103GCPU\u001b[107Gcache\u001b[113Gbefore\r\u001b[2C\u001b[1B \u001b[5Geach layer reads it. I re-tested other cache\u001b[50Glayouts with that eviction simulated: none helps\u001b[99Gat the fixture\u001b[K\r\u001b[4C\u001b[1Blengths, and the\u001b[22Gcurrent switch t\u001b[39G the\u001b[44Gall-heads path a\u001b[61G 160 positions i\u001b[78G still right.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe machine is under heavy memory pressure.\u001b[22m It has abou\u001b[65G\u2013300 MB free and about 3.2\u001b[92GGB\u001b[95Gin\u001b[98Gcompressed\u001b[109Gmemory.\u001b[117GOnce\r\u001b[2C\u001b[1B \u001b[5Gmodel.bin was pushed out of the file cache and\u001b[52Gload t\u001b[59Gok\u001b[62G0.9 "]
[609.807, "s, and\u001b[73Grun-to-run speed drifts ab\u001b[100Gut \u00b110%,\u001b[109Gso every\u001b[K\r\u001b[4C\u001b[1Bc\u001b[7Gmparison u\u001b[18Ged alterna\u001b[29Ging\u001b[33Gruns and\u001b[42Gmedians.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges this round\u001b[22G\u001b[22m(\u001b[38;2;87;105;247mcb2.c\u001b[39m)\r\u001b[2C\u001b[1B1. \u001b[1mLazy\u001b[11GKV cache:\u001b[22m memory the\u001b[32Gsystem\u001b[39Gzero-fills\u001b[50Gon\u001b[53Gfirst\u001b[59Gwrite,\u001b[66Ginstead\u001b[74Gof\u001b[77Gzeroing\u001b[85G75\u001b[88GMB\u001b[91Gat\u001b[94Gload.\u001b[100GIt\u001b[103Gsaves\u001b[109Gload\u001b[114Gtime\r\u001b[2C\u001b[1B  \u001b[6Gand 75 MB of me\u001b[22Gory un\u001b[29Gil\u001b[32Glong contexts fill it. Peak memory stays at 882 MB, because \u001b[93Ghe peak comes during\u001b[114Gload.\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mFaster tokenizer load:\u001b[22m one read \u001b[39Gf the file in\u001b[53Go\u001b[55Ga single string buffer, instead of about\u001b[96G96k small reads and 32k\r\u001b[2C\u001b[1B  \u001b[6Gallocations. Lookups are unch\u001b[36Gnged, and ENCODE still matches the\u001b[71Gre\u001b[74Gerence on \u001b[85Gll 514 test texts.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSwiGLU in small tiles:\u001b[22m no measurable effect at\u001b[53Gfixture siz\u001b[66G; I kept it b\u001b[80Gcause it's never\u001b[97Gslower.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B"]
[609.809, "\u001b[1mFinal numbers (medians of 5 alternating runs)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502   Workload    \u2502          v2          \u2502          v3          \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY \u2502 104.5 ms             \u2502 95.3 ms              \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 3\u00d764 \u2502 1454 ms (\u2248132 tok/s) \u2502 1454 ms (\u2248132 tok/s) \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
