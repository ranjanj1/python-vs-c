[553.559, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad dropped about 8 m\u001b[26G (103 \u2192 95.5 ms) whi\u001b[47Ge\u001b[49GGenerate, LOGITS and FIXED stayed the \u001b[88Game, so SwiGLU tiling doesn't\r\u001b[2C\u001b[1Bm\u001b[5Gtter\u001b[11Gt fixture s\u001b[23Gzes. Load\u001b[33Gis still\u001b[42Gmostly\u001b[49Gtransposition,\u001b[64Gso\u001b[67GI'm\u001b[71Gsplitting\u001b[81Gits\u001b[85Gcost\u001b[90Ginto\u001b[95Gtranspose\u001b[105Gwork,\u001b[111Gsource\r\u001b[2C\u001b[1Bfaults\u001b[10Gand\u001b[14Gdestination\u001b[26Gfaults\u001b[33Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe lo\u001b[10Gd-\u001b[13Gime estimat\u001b[26Gfor the 98 MB classifier comes to about 95\u001b[69Gms, with roughly 45 ms of transposing and\u001b[111G35 ms\u001b[117Gof\r\u001b[2C\u001b[1Bpag\u001b[7G faults, and since\u001b[26GvDSP_mtr\u001b[35Gns can't\u001b[44Gb\u001b[46G tiled differently\u001b[65GI'm\u001b[69Gaccepting\u001b[79Gthat.\u001b[85GNext\u001b[90GI'm\u001b[94Gchecking\u001b[103Gtime\u001b[108Gto\u001b[111Gfirst\r\u001b[2C\u001b[1Btoken\u001b[9Gfor\u001b[13Gthe\u001b[17GGENERATE\u001b[26Gprompts\u001b[34Gagainst\u001b[42Ga\u001b[44Gdecode\u001b[51Gstep.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K"]
[553.56, "\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill costs about 1.3\u20132\u001b[29Gdecode steps (9.4\u201314.4 ms aga\u001b[60Gst a 7.3\u20137.4 ms\u001b[76Gdecode step) because small-M \u001b[38;2;87;105;247msgemm\u001b[39m is less\u001b[K\r\u001b[2C\u001b[1Befficient than \u001b[38;2;87;105;247msgemv\u001b[39m, and\u001b[29Gt\u001b[32Gt ov\u001b[37Grhead looks inherent in Acc\u001b[65Gl\u001b[67Grate for these\u001b[82Gshapes.\u001b[90GI'm\u001b[94Ggoing\u001b[100Gto\u001b[103Gbenchmark\u001b[113GBNNS's\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mBNNSMatMul\u001b[14G\u001b[39mon\u001b[17Gthe\u001b[21Gprefill\u001b[29Gshape\u001b[35Gnext,\u001b[41Gsince\u001b[47Git\u001b[50Gmight\u001b[56Guse\u001b[60Gdifferent\u001b[70Gkernels.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m4\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBNNSM\u001b[9GtMul is 5\u201310% slower with id\u001b[38Gntical results,\u001b[54Gso I'm skipping i\u001b[72G; \u001b[75Ghe decode, pre\u001b[91Gll and \u001b[99Goad\u001b[103Glimits\u001b[110Gare\u001b[114Gall\r\u001b[2C\u001b[1Bhardware-bound.\u001b[19GI'll\u001b[24Gkeep\u001b[29Gthe\u001b[33Gthree\u001b[39Grobust\u001b[46Gchanges\u001b[54Gand\u001b[58Grun\u001b[62Gthe\u001b[66Gfull\u001b[71Gtest\u001b[76Gsuite\u001b[82Gon\u001b[85Gthe\u001b[89Gfinal\u001b[95Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b"]
[553.561, "[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything\u001b[14Gpasses.\u001b[22GLast,\u001b[28Gthe\u001b[32Gfinal\u001b[38GA/B\u001b[42Gagainst\u001b[50Gv2,\u001b[54Gplus\u001b[59Gpeak\u001b[64Gmemory,\u001b[72Gsince\u001b[78Gthe\u001b[82Gmachine\u001b[90Gis\u001b[93Gunder\u001b[99Gmemory\u001b[106Gpressure:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Final A/B, long workloads, peak RSS\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ c\u001b[10G \u001b[14G \u001b[16Gtmp\u001b[20Gcb2t/v3 && python3\u001b[39G/tmp/cb2t/ab.py 5 /\u001b[59Gmp/c\u001b[64G2t/v2 /tmp/cb2t/v3 && python3 /tmp/cb2t/longgen.py \r\u001b[5C\u001b[1B/tmp/cb2t/v2 /tmp/cb2t/v3 && for b in v2 v3; do printf \"$b \"; python3 -c \"\r\u001b[5C\u001b[1Bimport json;fx=json.load(open('fixtures.json'))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mprint(''.join(f\\\"GENERATE 64 {p['text']}\\n\\\" for p in fx['prompts']\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
