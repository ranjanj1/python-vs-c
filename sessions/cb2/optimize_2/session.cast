[610.042, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mAttention on short contexts\u001b[33G\u001b[22mcosts\u001b[39G0.1\u20130.4\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbecause\u001b[69Gthe\u001b[73GKV\u001b[76Gcache\u001b[82Gis\u001b[85Gpushed\u001b[92Gout\u001b[96Gof\u001b[99Gthe\u001b[103GCPU\u001b[107Gcache\u001b[113Gbefore\r\u001b[2C\u001b[1B \u001b[5Geach layer reads it. I re-tested other cache layout\u001b[57G with \u001b[64Ghat eviction simulated:\u001b[88Gnon\u001b[93Ghelps at the\u001b[106Gfix\u001b[110Gure\u001b[K\r\u001b[4C\u001b[1Blengths, and the current switch to the all-heads pa\u001b[57Gh a\u001b[61G 160 positions\u001b[76Gis\u001b[79Gstill\u001b[85Gright.\r\u001b[4C\u001b[1B\u001b[1mThe machine i\u001b[19G under heavy memory pressure.\u001b[22m It has about 160\u2013300 MB\u001b[73Gfree and\u001b[82Gabout 3.2\u001b[92GGB in compressed memory. Once\r\u001b[4C\u001b[1Bmodel.bin was pushed\u001b[26Gout of th\u001b[36G file ca\u001b[45Ghe and l\u001b[54Gad took 0.9 s, and ru\u001b[76G-to-run speed drifts about \u00b110%, so \u001b[113Gvery\r\u001b[4C\u001b[1Bcomparison used alte\u001b[26Gna\u001b[29Ging runs and medians.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges this round\u001b[22m (\u001b[38;2;87;105;247mcb2.c\u001b[39m)\u001b[30G\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mLazy KV cache:\u001b[21G\u001b[22mmemo\u001b[26Gy \u001b[29Ghe system zero-f\u001b[46Gll\u001b[49G on\u001b[53Gfirst\u001b[5"]
[610.042, "9Gwrite,\u001b[66Ginstead\u001b[74Gof\u001b[77Gzeroing\u001b[85G75\u001b[88GMB\u001b[91Gat\u001b[94Gload.\u001b[100GIt\u001b[103Gsaves\u001b[109Gload\u001b[114Gtime\r\u001b[5C\u001b[1Band\u001b[10G75\u001b[13GMB\u001b[16Gof\u001b[19Gmemory\u001b[26Guntil\u001b[32Glong\u001b[37Gcontexts\u001b[46Gfill\u001b[51Git.\u001b[55GPeak\u001b[60Gmemory\u001b[67Gstays\u001b[73Gat\u001b[76G882\u001b[80GMB,\u001b[84Gbecause\u001b[92Gthe\u001b[96Gpeak\u001b[101Gcomes\u001b[107Gduring\u001b[114Gload.\r\u001b[2C\u001b[1B2. \u001b[1mFaster tokenizer load:\u001b[22m one\u001b[33Gread\u001b[38Gof\u001b[41Gthe\u001b[45Gfile\u001b[50Ginto\u001b[55Ga\u001b[57Gsingle\u001b[64Gstring\u001b[71Gbuffer,\u001b[79Ginstead\u001b[87Gof\u001b[90Gabout\u001b[96G96k\u001b[100Gsmall\u001b[106Greads\u001b[112Gand\u001b[116G32k\r\u001b[2C\u001b[1B  \u001b[6Gallocations. Lookups are unchanged, and ENCODE\u001b[53Gstill\u001b[59Gmatches the reference o\u001b[83G all\u001b[88G514 \u001b[93Gest texts.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mSwiGLU in small tiles:\u001b[22m no\u001b[32Gmeasurabl\u001b[42G effect at fixture sizes; I kept it because it'\u001b[90G nev\u001b[95Gr slower.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinal numbers (medians of 5 alternating runs)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500"]
