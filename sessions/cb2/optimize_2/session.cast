[474.304, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11GGEMMs\u001b[17Gare\u001b[21Gnear\u001b[26Gtheir\u001b[32Gkernel\u001b[39Glimit\u001b[45Gand\u001b[49Gdecode\u001b[56Gis\u001b[59Gnear\u001b[64Gmemory\u001b[71Glimit,\u001b[78Gso\u001b[81GI'm\u001b[85Gnow\u001b[89Gmaking\u001b[96Gthree\u001b[102Gsmall\u001b[108Gcuts:\u001b[114Glazy\u001b[119GKV\r\u001b[1B \u001b[3Gcache a\u001b[11Glocation, a \u001b[24Gingle-read tokenizer load, and L1-til\u001b[62Gd SwiGLU.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfull\u001b[12Gcheck\u001b[18Gpasses,\u001b[26Gand\u001b[30GENCODE\u001b[37Gis\u001b[40Gstill\u001b[46Gidentical\u001b[56Gto\u001b[59Gthe\u001b[63Greference\u001b[73Galgorithm\u001b[83Gon\u001b[86Gall\u001b[90G514\u001b[94Gtexts.\u001b[101GNext\u001b[106Gis\u001b[109GA/B\u001b[113Gtiming\r\u001b[1B \u001b[3Gof v2 against the new build:\u001b[32G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad dropped about 8\u001b[24Gms\u001b[27G(103\u001b[32G\u2192\u001b[34G95.5\u001b[39Gms)\u001b[43Gwhile\u001b[49GGenerate,\u001b[59GLOGITS\u001b[66Gand\u001b[70GFIXED\u001b[76Gstayed\u001b[83Gthe\u001b[87Gsame,\u001b[93Gso\u001b[96GSwiGLU\u001b[103Gtiling\u001b[110Gdoesn't\r\u001b[2C\u001b[1Bmatter\u001b[10Gat\u001b[13Gfixture\u001b[21Gsiz"]
[474.306, "es.\u001b[28GLoad\u001b[33Gis\u001b[36Gstill\u001b[42Gmostly\u001b[49Gtransposition,\u001b[64Gso\u001b[67GI'm\u001b[71Gsplitting\u001b[81Gits\u001b[85Gcost\u001b[90Ginto\u001b[95Gtranspose\u001b[105Gwork,\u001b[111Gsource\r\u001b[1B \u001b[3Gfaults and d\u001b[16Gstination\u001b[27Gaul\u001b[31Gs next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe load-time estimate\u001b[26Gfor\u001b[30Gthe\u001b[34G98\u001b[37GMB\u001b[40Gclassifier\u001b[51Gcomes\u001b[57Gto\u001b[60Gabout\u001b[66G95\u001b[69Gms,\u001b[73Gwith\u001b[78Groughly\u001b[86G45\u001b[89Gms\u001b[92Gof\u001b[95Gtransposing\u001b[107Gand\u001b[111G35\u001b[114Gms\u001b[117Gof\r\u001b[2C\u001b[1Bpage\u001b[8Gfaults,\u001b[16Gand\u001b[20Gsince\u001b[26GvDSP_mtrans\u001b[38Gcan't\u001b[44Gbe\u001b[47Gtiled\u001b[53Gdifferently\u001b[65GI'm\u001b[69Gaccepting\u001b[79Gthat.\u001b[85GNext\u001b[90GI'm\u001b[94Gchecking\u001b[103Gtime\u001b[108Gto\u001b[111Gfirst\r\u001b[1B \u001b[3Gtoken for the\u001b[17GGENERATE prompts against\u001b[42Ga decode step.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill costs about 1.3\u20132 decode steps (9.4\u201314.4\u001b[52Gms\u001b[55Gagainst\u001b[63Ga\u001b[65G7.3\u20137.4\u001b[73Gms\u001b[76Gdecode\u001b[83Gstep)\u001b[89Gbecause\u001b[9"]
[474.307, "7Gsmall-M\u001b[105G\u001b[38;2;87;105;247msgemm\u001b[111G\u001b[39mis\u001b[114Gless\r\u001b[1B  efficient than \u001b[38;2;87;105;247msgemv\u001b[39m, and that overhead looks\u001b[49Ginherent\u001b[58Gin\u001b[61GAccelerate\u001b[72Gfor\u001b[76Gthese\u001b[82Gshapes.\u001b[90GI'm\u001b[94Ggoing\u001b[100Gto\u001b[103Gbenchmark\u001b[113GBNNS's\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mBNNSMatMul\u001b[39m on the prefill shape next,\u001b[41Gsince\u001b[47Git\u001b[50Gmight\u001b[56Guse\u001b[60Gdifferent\u001b[70Gkernels.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m4\u001b[22m shell\u001b[15Gcommands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBNNSMatMul is 5\u201310% slower\u001b[30Gwith\u001b[35Gidentical\u001b[45Gresults,\u001b[54Gso\u001b[57GI'm\u001b[61Gskipping\u001b[70Git;\u001b[74Gthe\u001b[78Gdecode,\u001b[86Gprefill\u001b[94Gand\u001b[98Gload\u001b[103Glimits\u001b[110Gare\u001b[114Gall\r\u001b[2C\u001b[1Bhardware-bound. I'll\u001b[24Gkeep\u001b[29Gthe\u001b[33Gthree\u001b[39Grobust\u001b[46Gchanges\u001b[54Gand\u001b[58Grun\u001b[62Gthe\u001b[66Gfull\u001b[71Gtest\u001b[76Gsuite\u001b[82Gon\u001b[85Gthe\u001b[89Gfinal\u001b[95Gbuild.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[9C\u001b[2B\u001b[38;2;245;149;117ming\u001b[28G\u001b[38;2;102;102;102m8\u001b[42G\u001b[38;2;177;177;177mth\u001b[45Gn"]
[474.307, "king with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[474.317, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 11s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
