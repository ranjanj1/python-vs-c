[447.427, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad\u001b[8Gdropped\u001b[16Gabout\u001b[22G8\u001b[24Gms\u001b[27G(103\u001b[32G\u2192\u001b[34G95.5\u001b[39Gms)\u001b[43Gwhile\u001b[49GGenerate,\u001b[59GLOGITS\u001b[66Gand\u001b[70GFIXED\u001b[76Gstayed\u001b[83Gthe\u001b[87Gsame,\u001b[93Gso\u001b[96GSwiGLU\u001b[103Gtiling\u001b[110Gdoesn't\r\u001b[2C\u001b[1Bmatter at fixture sizes.\u001b[28GLoad\u001b[33Gis\u001b[36Gstill\u001b[42Gmostly\u001b[49Gtransposition,\u001b[64Gso\u001b[67GI'm\u001b[71Gsplitting\u001b[81Gits\u001b[85Gcost\u001b[90Ginto\u001b[95Gtranspose\u001b[105Gwork,\u001b[111Gsource\r\u001b[2C\u001b[1Bfaults\u001b[10Gand\u001b[14Gdestination\u001b[26Gfaults\u001b[33Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe load-time estimate\u001b[26Gfor\u001b[30Gthe\u001b[34G98\u001b[37GMB\u001b[40Gclassifier\u001b[51Gcomes\u001b[57Gto\u001b[60Gabout\u001b[66G95\u001b[69Gms,\u001b[73Gwith\u001b[78Groughly\u001b[86G45\u001b[89Gms\u001b[92Gof\u001b[95Gtransposing\u001b[107Gand\u001b[111G35\u001b[114Gms\u001b[117Gof\r\u001b[2C\u001b[1Bpage\u001b[8Gfaults,\u001b[16Gand\u001b[20Gsince\u001b[26GvDSP_mtrans\u001b[38Gcan't\u001b[44Gbe\u001b[47Gtiled\u001b[53Gdifferently\u001b[65GI'm\u001b[69Gaccepting\u001b[79Gthat.\u001b[85GNext\u001b[90GI'm\u001b[94Gchecking\u001b[103Gtim"]
[447.428, "e\u001b[108Gto\u001b[111Gfirst\r\u001b[1B \u001b[3Gt\u001b[5Gken f\u001b[11Gr the GENERATE prompts\u001b[34Gagainst a decode step.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill costs about 1.3\u20132\u001b[29Gdecode\u001b[36Gsteps\u001b[42G(9.4\u201314.4\u001b[52Gms\u001b[55Gagainst\u001b[63Ga\u001b[65G7.3\u20137.4\u001b[73Gms\u001b[76Gdecode\u001b[83Gstep)\u001b[89Gbecause\u001b[97Gsmall-M\u001b[105G\u001b[38;2;87;105;247msgemm\u001b[111G\u001b[39mis\u001b[114Gless\r\u001b[2C\u001b[1Befficient\u001b[13Gthan\u001b[18G\u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[25Gand\u001b[29Gthat\u001b[34Goverhead\u001b[43Glooks\u001b[49Ginherent\u001b[58Gin\u001b[61GAccelerate\u001b[72Gfor\u001b[76Gthese\u001b[82Gshapes.\u001b[90GI'm\u001b[94Ggoing\u001b[100Gto\u001b[103Gbenchmark\u001b[113GBNNS's\r\u001b[1B \u001b[3G\u001b[38;2;87;105;247mBNNSMatMul\u001b[39m on\u001b[17Gthe prefill shape next, since \u001b[48Gt might use\u001b[60Gdifferent kernels.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mReading BNNS layout semantics\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ H=$(xcrun \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m--show-sdk-path)/System/Library/Frameworks/Accelerate.framework/Frameworks/vecLib.framework/Headers/BNNS; sed -n"]
