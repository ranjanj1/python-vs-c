[609.51, "abou\u001b[61G 160\u2013300 MB free and \u001b[83Gbout\u001b[88G3.2 GB in compressed memory.\u001b[117GOnce\r\u001b[4C\u001b[1Bmodel.bin was pushed ou\u001b[30Gof \u001b[34Ghe\u001b[37Gfile cache and load took\u001b[62G0.9\u001b[66Gs, and run-to-run speed drifts\u001b[97Gabout\u001b[103G\u00b110%,\u001b[109Gso\u001b[112Gevery\r\u001b[2C\u001b[1B \u001b[5Gcomparison used alternating runs and medians.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges this round\u001b[22m (\u001b[38;2;87;105;247mcb2.c\u001b[39m)\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mLazy KV cache:\u001b[21G\u001b[22mmemory\u001b[28Gthe\u001b[32Gsystem\u001b[39Gzero-fills\u001b[50Gon\u001b[53Gfirst\u001b[59Gwrite,\u001b[66Ginstead\u001b[74Gof\u001b[77Gzeroing\u001b[85G75\u001b[88GMB\u001b[91Gat\u001b[94Gload.\u001b[100GIt\u001b[103Gsaves\u001b[109Gload\u001b[114Gtime\r\u001b[2C\u001b[1B   and 75 MB of memory until\u001b[32Glong\u001b[37Gcontexts\u001b[46Gfill\u001b[51Git.\u001b[55GPeak\u001b[60Gmemory\u001b[67Gstays\u001b[73Gat\u001b[76G882\u001b[80GMB,\u001b[84Gbecause\u001b[92Gthe\u001b[96Gpeak\u001b[101Gcomes\u001b[107Gduring\u001b[114Gload.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mF\u001b[8Gster tokenizer load:\u001b[22m one read of the fi\u001b[48Ge\u001b[50Gi\u001b[52Gto a single string buffer, instead of about 96k\u001b[100Gsmall reads and 32k\r\u001b[6C\u001b[1Bllocations.\u001b[19GLookups are unchanged, and\u001b[46GENCODE still matches"]
[609.512, "\u001b[67Gthe reference on\u001b[84Gall 514\u001b[93Gest texts.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mSwiGLU\u001b[13Gin small tiles\u001b[29G\u001b[22mno measurable \u001b[44Gf\u001b[46Gect\u001b[50Gat fixture sizes; I kept it because it's never slower.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mFinal numbers (medians of 5 alternating runs)\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[7GWorkload\u001b[19G\u2502\u001b[30Gv2\u001b[42G\u2502\u001b[53Gv3\u001b[65G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[19G\u253c\u001b[42G\u253c\u001b[65G\u2524\r\u001b[4C\u001b[1BLoad to READY\u001b[21G104.5\u001b[27Gms\u001b[30G  \u001b[44G95.3\u001b[49Gms\u001b[53G  \r\u001b[4C\u001b[2BGENERATE 3\u00d764\u001b[22G454 ms (\u2248132\u001b[35Gtok/s)\u001b[44G1454\u001b[52G(\u2248132\u001b[58Gtok/s)\r\u001b[4C\u001b[2BLOGITS \u00d73    \u001b[21G9\u001b[23G.9\u001b[29G     \u001b[35G      \u001b[44G9\u001b[46G.9\u001b[52G     \u001b[58G      \r\u001b[4C\u001b[2BFIXED \u00d73 \u001b[22G2\u001b[24G4\u001b[45G1\u001b[47G7\r\u001b[2C\u001b[1B\u2514\u001b[19G\u2534\u001b[42G\u2534\u001b[65G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI didn't try speculative decoding (drafting tokens and verifying\u001b[68Gthem\u001b[73Gin\u001b[76Gbatches).\u001b[86GIt\u001b[89Gwould"]
