[592.919, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe load-tim\u001b[16G estimate\u001b[27Gor \u001b[31Ghe 98 MB\u001b[40Gclassifier\u001b[51Gcomes\u001b[57Gto\u001b[60Gabout\u001b[66G95\u001b[69Gms,\u001b[73Gwith\u001b[78Groughly\u001b[86G45\u001b[89Gms\u001b[92Gof\u001b[95Gtransposing\u001b[107Gand\u001b[111G35\u001b[114Gms\u001b[117Gof\r\u001b[2C\u001b[1Bpage\u001b[8Gfaults,\u001b[16Gand\u001b[20Gsince\u001b[26GvDSP_mtrans\u001b[38Gcan't\u001b[44Gbe\u001b[47Gtiled\u001b[53Gdifferently\u001b[65GI'm\u001b[69Gaccepting\u001b[79Gthat.\u001b[85GNext\u001b[90GI'm\u001b[94Gchecking\u001b[103Gtime\u001b[108Gto\u001b[111Gfirst\r\u001b[2C\u001b[1Btoken for the GENERATE\u001b[26Gprompts\u001b[34Gagainst\u001b[42Ga\u001b[44Gdecode\u001b[51Gstep.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill costs\u001b[17Gabout 1.3\u20132 decode steps\u001b[42G(9.4\u201314.4 ms against\u001b[63Ga\u001b[65G7.3\u20137.4\u001b[73Gms\u001b[76Gdecode\u001b[83Gstep)\u001b[89Gbecause\u001b[97Gsmall-M\u001b[105G\u001b[38;2;87;105;247msgemm\u001b[111G\u001b[39mis\u001b[114Gless\r\u001b[2C\u001b[1Befficient\u001b[13Gthan\u001b[18G\u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[25Gand\u001b[29Gthat\u001b[34Goverhead\u001b[43Glooks\u001b[49Ginherent\u001b[58Gin\u001b[61GAccelerate"]
