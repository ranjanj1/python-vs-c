[71.77, "\u2502\u001b[4G\u001b[22mcd\u001b[7G/tmp/cb2t\u001b[17G&&\u001b[20Gcp\u001b[23G/Users/agentlab/pvc/cb2/prof/*.c\u001b[56G.\u001b[58G&&\u001b[61Gcat\u001b[65G>\u001b[67Govh.c\u001b[73G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #define ACCELERATE_NEW_LAPACK\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #include <Accelerate/Accelerate.h>\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#include\u001b[13G<st\u001b[17Gio.h>\u001b[23G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #include <stdli\u001b[20G.h>\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #include <time.h>\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m static double now(){struct\u001b[31Gtim\u001b[35Gspec t;clock_gettime(CLOCK_MONOTONIC,&t);return \u001b[84G.tv_sec+\u001b[93G.tv_nsec*1e-9;}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m int main(){\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22msize_t\u001b[13GN=110u<<20;\u001b[25Gfloat*W=aligned_alloc(16384,N*4);\u001b[59Gfor(size_t\u001b[70Gi=0;i<N;i++)W[i]=(i%7)*1e-3f;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   float x[4096],*y=malloc(1<<24),s; for(int i=0;i<4096;i++)x[i]=1e-3f;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   for(int rep=0;rep<3;rep++){\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mdouble\u001b[13Gb=1e9;\u001b[20Gfor(int\u001b[28Gr=0;r<5;r++){double\u001b[48Gt=now();vDSP_sve(W,1,&s,N);t=now()-t;if(t<b)b=t;}\u001b[98Gprintf(\"pure\u001b[111Gread\u001b[116G%.1f\r\u001b[1B"]
[71.771, " \u001b[2m\u2502\u001b[22m GB/s | \",N*4/b/1e9);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m/*\u001b[9Gstreamed\u001b[18G256-wide\u001b[27Gblocks,\u001b[35Gn=768,\u001b[42Gsame\u001b[47Gtotal\u001b[53Gbytes\u001b[59Gas\u001b[62Gmodel\u001b[68G(~438MB)\u001b[77G*/\r\u001b[1B \u001b[2m\u2502\u001b[22m   size_t per=768*256, cnt=N/per; b=1e9;\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m   for(int r=0;r<5;r++){double t=now();for(size_t c=0;c<cnt;c++)cblas_sgemv(CblasRowMajor,CblasTrans,768,256,1,W+c*pe\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m r,256,x,1,0,y+(c*256)%(1<<20),1);t=now()-t;if(t<b)b=t;}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mprintf(\"stream\u001b[21GsgemvT\u001b[28G768x256:\u001b[37G%.1f\u001b[42GGB/s\u001b[47G(%zu\u001b[52Gcalls,\u001b[59G%.2f\u001b[64Gms)\u001b[68G|\u001b[70G\",cnt*per*4/b/1e9,cnt,b*1e3);\r\u001b[1B \u001b[2m\u2502\u001b[22m   /* ove\u001b[13Ghea\u001b[17G: tiny cached block */\u001b[40G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mb=1e9;\u001b[13Gfor(int\u001b[21Gr=0;r<5;r++){double\u001b[41Gt=now();for(int\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m c=0;c<10000;c++)cblas_sgemv(CblasRowMajor,CblasTrans,64,256,1,W,256,x,1,0,y,1);t=now()-t;if(t<b)b=t;}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mprintf(\"cached\u001b[21G64x256\u001b[28Gcall:\u001b[34G%.2f\u001b[39Gus\\n\",b/10000*1e6);}\r\u001b[1B \u001b[2m\u2502\u001b[22m }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m"]
[71.771, "\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcc\u001b[7G-O2\u001b[11G-o\u001b[14Govh\u001b[18Govh.c\u001b[24G-framework\u001b[35GAccelerate\u001b[46G&&\u001b[49G./ovh\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
