[474.408, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe lo\u001b[10Gd-time estimate for the 98 MB classifier\u001b[51Gcomes to about 95 ms,\u001b[73Gwith\u001b[78Groughly\u001b[86G45\u001b[89Gms\u001b[92Gof\u001b[95Gtransposing\u001b[107Gand\u001b[111G35\u001b[114Gms\u001b[117Gof\r\u001b[2C\u001b[1Bpage\u001b[8Gfaults,\u001b[16Gand\u001b[20Gsince\u001b[26GvDSP_mtrans\u001b[38Gcan't\u001b[44Gbe\u001b[47Gtiled\u001b[53Gdifferently\u001b[65GI'm\u001b[69Gaccepting\u001b[79Gthat.\u001b[85GNext\u001b[90GI'm\u001b[94Gchecking\u001b[103Gtime\u001b[108Gto\u001b[111Gfirst\r\u001b[2C\u001b[1Btoken for the GENERATE\u001b[26Gprompts\u001b[34Gagainst\u001b[42Ga\u001b[44Gdecode\u001b[51Gstep.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefill\u001b[11Gcosts\u001b[17Gabout\u001b[23G1.3\u20132\u001b[29Gdecode\u001b[36Gsteps\u001b[42G(9.4\u201314.4\u001b[52Gms\u001b[55Gagainst\u001b[63Ga\u001b[65G7.3\u20137.4\u001b[73Gms\u001b[76Gdecode\u001b[83Gstep)\u001b[89Gbecause\u001b[97Gsmall-M\u001b[105G\u001b[38;2;87;105;247msgemm\u001b[111G\u001b[39mis\u001b[114Gless\r\u001b[2C\u001b[1Befficient than \u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[25Gand\u001b[29Gthat\u001b[34Goverhead\u001b[43Glooks\u001b[49Ginherent\u001b[58Gin\u001b[61GAccelerate\u001b[72Gfor\u001b[76Gthese\u001b[82Gshapes.\u001b[90GI'm\u001b[94Ggoing\u001b[100Gto\u001b[103Gbenchmark\u001b[113GBNNS's\r\u001b[2C\u001b[1"]
[474.409, "B\u001b[38;2;87;105;247mBNNSMatMul\u001b[14G\u001b[39mon\u001b[17Gthe\u001b[21Gprefill\u001b[29Gshape\u001b[35Gnext,\u001b[41Gsince\u001b[47Git\u001b[50Gmight\u001b[56Guse\u001b[60Gdifferent\u001b[70Gkernels.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m4\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBNNSMatMul\u001b[14Gis\u001b[17G5\u201310%\u001b[23Gslower\u001b[30Gwith\u001b[35Gidentical\u001b[45Gresults,\u001b[54Gso\u001b[57GI'm\u001b[61Gskipping\u001b[70Git;\u001b[74Gthe\u001b[78Gdecode,\u001b[86Gprefill\u001b[94Gand\u001b[98Gload\u001b[103Glimits\u001b[110Gare\u001b[114Gall\r\u001b[2C\u001b[1Bhardware-bound. I'll\u001b[24Gkeep\u001b[29Gthe\u001b[33Gthree\u001b[39Grobust\u001b[46Gchanges\u001b[54Gand\u001b[58Grun\u001b[62Gthe\u001b[66Gfull\u001b[71Gtest\u001b[76Gsuite\u001b[82Gon\u001b[85Gthe\u001b[89Gfinal\u001b[95Gbuild.\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m sh\u001b[16Gll co\u001b[22Gmand\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 check.py -- ./cb2 | tail -1 && python3 check.py --tokens 64 --prompts 3 -- ./cb2 && python3 \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102m/tmp/cb2t/t.py && python3 /tmp/cb2t/ctx.py && sed 's/#define CHUNK 512 /#define CHUNK 1 /' cb2.c > /tmp/cb2t/c1.c \r\u001b[5C\u001b[1B&& cc -O3 -mcpu=native -o /tmp/c"]
