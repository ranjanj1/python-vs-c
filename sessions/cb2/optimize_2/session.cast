[509.076, "t\u001b[63Ga\u001b[65G7.3\u20137.4\u001b[73Gms\u001b[76Gdecode\u001b[83Gstep)\u001b[89Gbecause\u001b[97Gsmall-M\u001b[105G\u001b[38;2;87;105;247msgemm\u001b[111G\u001b[39mis\u001b[114Gless\r\u001b[1B \u001b[3Gefficient tha\u001b[17G \u001b[38;2;87;105;247msgemv\u001b[39m, \u001b[26Gnd that overhead\u001b[43Glooks\u001b[49Ginherent\u001b[58Gin\u001b[61GAccelerate\u001b[72Gfor\u001b[76Gthese\u001b[82Gshapes.\u001b[90GI'm\u001b[94Ggoing\u001b[100Gto\u001b[103Gbenchmark\u001b[113GBNNS's\r\u001b[1B  \u001b[38;2;87;105;247mBNNSMatMul\u001b[39m on the prefill shape next, since it might use different kernels.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m4\u001b[22m shell command\u001b[23G \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBNNSMatMul\u001b[14Gis\u001b[17G5\u201310%\u001b[23Gslower\u001b[30Gwith\u001b[35Gidentical\u001b[45Gresults,\u001b[54Gso\u001b[57GI'm\u001b[61Gskipping\u001b[70Git;\u001b[74Gthe\u001b[78Gdecode,\u001b[86Gprefill\u001b[94Gand\u001b[98Gload\u001b[103Glimits\u001b[110Gare\u001b[114Gall\r\u001b[1B  hardware-bound. I'll keep the three robust changes and run the full test suite on the final build.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything passes. Last, the final A/B agai"]
