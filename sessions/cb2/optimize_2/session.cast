[139.662, "\u001b[H\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStarting\u001b[12Ground\u001b[18G3\u001b[20Gby\u001b[23Gre-profiling\u001b[36Gthe\u001b[40Gcurrent\u001b[48Gbuild\u001b[54Gon\u001b[57Gthe\u001b[61Gfixture\u001b[69Gworkloads\u001b[79Gto\u001b[82Gsee\u001b[86Gwhere\u001b[92Gthe\u001b[96Gtime\u001b[101Ggoes\u001b[106Gnow.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmachine\u001b[15Gis\u001b[18Grunning\u001b[26Gslower\u001b[33Gtoday,\u001b[40Gabout\u001b[46G50\u201354\u001b[52GGB/s\u001b[57Gagainst\u001b[65G57\u201360\u001b[71Gearlier.\u001b[80GI'm\u001b[84Gre-measuring\u001b[97Gthe\u001b[101Gpure-read\u001b[111Gceiling\r\u001b[1B \u001b[3Gand\u001b[7Gthe per-call overhead of \u001b[38;2;87;105;247msgemv\u001b[39m to get the current\u001b[57Ggap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmicrobenchmark\u001b[22Ghits\u001b[27G58\u001b[30GGB/s\u001b[35Gand\u001b[39G0.57\u001b[44G\u00b5s\u001b[47Gper\u001b[51Gcall,\u001b[57Gbut\u001b[61Gthe\u001b[65Gprogram\u001b[73Gonly\u001b[78Greaches\u001b[86Gabout\u001b[92G51\u001b[95GGB/s,\u001b[101Gwith\u001b[106Gthe\u001b[110Ggap\u001b[114Ggrowing\r\u001b[1B \u001b[3Galongside matrix size. Next I'll time a matmul-only pass over\u001b[65Gthe "]
[139.663, "program's own weights to see which of the two\u001b[K\r\u001b[2C\u001b[1Bpossible causes i\u001b[21G r\u001b[24Gsponsible.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gprobe\u001b[13Greadings\u001b[22Gare\u001b[26Gnoisy,\u001b[33Gbut\u001b[37Gthe\u001b[41Gbest\u001b[46Grepeat\u001b[53Ghits\u001b[58G60.5\u001b[63GGB/s,\u001b[69Gso\u001b[72Gthe\u001b[76Gdecode\u001b[83Gis\u001b[86Galready\u001b[94Gnear\u001b[99Gthe\u001b[103Ghardware\u001b[112Glimit.\r\u001b[1B \u001b[3GAttention\u001b[14Guns slowe\u001b[24G i\u001b[27G the program than in the microbenchmark because th\u001b[78G weight\u001b[86Gst\u001b[91Gm evicts eac\u001b[104G laye\u001b[110G's KV\u001b[K\r\u001b[2C\u001b[1Bcache, so\u001b[13GI'm re-benchmarking attention with\u001b[52Gca\u001b[55Ghe flushed between lay\u001b[78Grs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mCold-cache\u001b[14Gdecode\u001b[21Gattention\u001b[31Gbenchmark\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cd /tmp/cb2t && cat > attn3.c <<'EOF'\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m#define ACCELERATE_NEW_LAPACK\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102minclude <Accelerate/Accelerate.h>\r\u001b[15C\u001b[1Bstdio.h>\u001b[39m\u001b[K\r\u001b[18C\u001b[1B\u001b[38;2;102;102"]
