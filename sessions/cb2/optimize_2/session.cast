[607.457, "\u001b[H\u001b[7G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m   \u001b[12G\u001b[38;2;51;51;51m---\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m2\u001b[12G\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 133 \u001b[22m ## Round 2: profiling and optimisation\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 134 \u001b[22m \u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[14G\u001b[22m# Development worklo\u001b[35Gds\u001b[38Gused\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThis round gained only\u001b[26G9\u001b[28Gms\u001b[31Gof\u001b[34Gstartup\u001b[42G(load\u001b[48Gto\u001b[51GREADY\u001b[57Gwent\u001b[62Gfrom\u001b[67G104.5\u001b[73Gto\u001b[76G95.3\u001b[81Gms).\u001b[86GEverything\u001b[97Gelse\u001b[102Gis\u001b[105Gunchanged\u001b[115Gwithin\r\u001b[2C\u001b[1Bnoise,\u001b[10Gbecause\u001b[18Gthe\u001b[22Gprogram\u001b[30Gis\u001b[33Gnow\u001b[37Gat\u001b[40Gthis\u001b[45GM1's\u001b[50Ghardware\u001b[59Gand\u001b[63GAccelerate\u001b[74Glimits.\u001b[82GThe\u001b[86Gfinal\u001b[92Gbuild\u001b[98Gpasses\u001b[105Gboth\u001b[110G\u001b[38;2;87;105;247mcheck.py\r\u001b[1B\u001b[39m \u001b[3Grun\u001b[8G(largest logit error 2.6e-5) and al\u001b[44G my\u001b[48Gother tests"]
[607.459, ".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat profiling showed\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGeneration is at the memory-bandwidth ceiling.\u001b[52G\u001b[22mReading\u001b[60Gweights\u001b[68Gis\u001b[71Gabout\u001b[77G96%\u001b[81Gof\u001b[84Gdecode\u001b[91Gtime,\u001b[97Gand\u001b[101Gthe\u001b[105Gbest\u001b[110Gstep\u001b[115Gis\u001b[118G7.3\r\u001b[2C\u001b[1B  ms per token. Reading\u001b[27G438\u001b[31GMB\u001b[34Gat\u001b[37Gthe\u001b[41Gmeasured\u001b[50G59\u201363\u001b[56GGB/s\u001b[61Glimit\u001b[67Gtakes\u001b[73G7.4\u001b[77Gms,\u001b[81Gso\u001b[84Gthere's\u001b[92Gnothing\u001b[100Gmeaningful\u001b[111Gleft\r\u001b[2C\u001b[1B \u001b[5Gwithout reading fewer bytes, which the rules forbi\u001b[56G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrompt processing is at Accelerate's limit for these shapes.\u001b[22m The matrix\u001b[77Gproducts run at about 700 GFLOP/s, which\u001b[118Gis\r\u001b[4C\u001b[1Bthe fastest \u001b[38;2;87;105;247msgemm\u001b[39m g\u001b[25Gts for this layout. Accelerate's\u001b[58Gother\u001b[64Gmatrix-multiply\u001b[80GAPI\u001b[84G(\u001b[38;2;87;105;247mBNNSMatMul\u001b[39m)\u001b[97Ggives\u001b[103Gidentical\u001b[113Gresults\r\u001b[2C\u001b[1B \u001b[5Gand is 5\u201310% slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLoad is mostly unavoidable.\u001b[22m About 45 ms\u001b[45Gis th\u001b[51G tran\u001b[57Gp\u001b[59Gse itself and about 3"]
[607.461, "5 ms is page faults. Th\u001b[104Gs system\u001b[113Gdoesn't\r\u001b[5C\u001b[1Bllow large mem\u001b[21Gry pages,\u001b[31Gand\u001b[35GAccelerate\u001b[46Ghas\u001b[50Gno\u001b[53Gfaster\u001b[60Gtranspose.\r\u001b[4C\u001b[1B\u001b[1mAttention on short contexts\u001b[33G\u001b[22mcosts\u001b[39G0.1\u20130.4 ms per token, because\u001b[69Gthe\u001b[73GKV cache\u001b[82Gi\u001b[85Gpushed out of the CPU cache\u001b[113Gbefore\u001b[K\r\u001b[4C\u001b[1Beach layer reads it. I re-tested other cache\u001b[50Glayouts wi\u001b[61Gh that \u001b[69Gviction\u001b[77Gsimulated:\u001b[88Gnone\u001b[93Ghelps\u001b[99Gat\u001b[102Gthe\u001b[106Gfixture\r\u001b[2C\u001b[1B \u001b[5Glengths, and the current switch to the all-heads\u001b[54Gpath at 160 positions\u001b[76Gis still\u001b[85Grig\u001b[89Gt.\u001b[92G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mThe machine is under heavy memory pressure.\u001b[22m It has abou\u001b[61G 160\u2013300 MB free and \u001b[83Gbout\u001b[88G3.2 GB in compressed memory.\u001b[117GOnce\r\u001b[4C\u001b[1Bmodel.bin was pushed ou\u001b[30Gof \u001b[34Ghe\u001b[37Gfile cache and load took\u001b[62G0.9\u001b[66Gs, and run-to-run speed drifts\u001b[97Gabout\u001b[103G\u00b110%,\u001b[109Gso\u001b[112Gevery\r\u001b[2C\u001b[1B \u001b[5Gcomparison used alternating runs and medians.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges this round\u001b[22m "]
[607.462, "(\u001b[38;2;87;105;247mcb2.c\u001b[39m)\u001b[K\r\u001b[2C\u001b[2B1. \u001b[1mLazy\u001b[11GKV cache:\u001b[22m memory the\u001b[32Gsystem\u001b[39Gzero-fills\u001b[50Gon\u001b[53Gfirst\u001b[59Gwrite,\u001b[66Ginstead\u001b[74Gof\u001b[77Gzeroing\u001b[85G75\u001b[88GMB\u001b[91Gat\u001b[94Gload.\u001b[100GIt\u001b[103Gsaves\u001b[109Gload\u001b[114Gtime\r\u001b[5C\u001b[1Band\u001b[10G75\u001b[13GMB\u001b[16Gof\u001b[19Gmemory\u001b[26Guntil\u001b[32Glong\u001b[37Gcontexts\u001b[46Gfill\u001b[51Git.\u001b[55GPeak\u001b[60Gmemory\u001b[67Gstays\u001b[73Gat\u001b[76G882\u001b[80GMB,\u001b[84Gbecause\u001b[92Gthe\u001b[96Gpeak\u001b[101Gcomes\u001b[107Gduring\u001b[114Gload.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mF\u001b[8Gster tokenizer load:\u001b[22m one read of the fi\u001b[48Ge\u001b[50Gi\u001b[52Gto a single string buffer, instead of about 96k\u001b[100Gsmall reads and 32k\r\u001b[6C\u001b[1Bllocations.\u001b[19GLookups are unchanged, and\u001b[46GENCODE still matches\u001b[67Gthe reference on\u001b[84Gall 514\u001b[93Gest texts.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[K\u001b[40;1H\u001b[38;3H"]
