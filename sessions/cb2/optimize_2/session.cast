[266.232, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load with a warm cache is dominated by transposing the classifier and layers (19 ms and 62 ms), plus smaller setup and\r\u001b[1C\u001b[1B tokenizer costs.\u001b[20GThe\u001b[24G5.3\u001b[28GGB/s\u001b[33Gtranspose\u001b[43Gspeed\u001b[49Glooks\u001b[55Gslow,\u001b[61Gso\u001b[64GI\u001b[66Gsuspect\u001b[74Gpage\u001b[79Gfaults\u001b[86Gand\u001b[90Gwill\u001b[95Gmeasure\u001b[103Gthem\u001b[108Gseparately\r\u001b[1C\u001b[1B next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The memset and transpose speeds\u001b[35Glook\u001b[40Ginconsistent\u001b[53Gwith\u001b[58Gan\u001b[61G8\u001b[63GGB\u001b[66Gmachine\u001b[74Gthat\u001b[79Gheld\u001b[84Gabout\u001b[90G1.3\u001b[94GGB,\u001b[98Gso\u001b[101GI'm\u001b[105Gchecking\u001b[114Gsystem\r\u001b[1C\u001b[1B memory pressur\u001b[18G before trusting t\u001b[37Gese\u001b[41Gnumbers.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Memory pressure \u001b[20Gn this machine (roughly 160\u2013300 MB free, about 3.2 GB compressed, heavy swap) explains the\u001b[111Gcold\r\u001b[1C\u001b[1B reloads and noisy\u001b[21Gtimings,\u001b[30Gso\u001b[33GI'm\u001b[37"]
[266.233, "Gfavoring\u001b[46Grobust\u001b[53Ggains\u001b[59Gand\u001b[63Gcutting\u001b[71Gstartup\u001b[79Gmemory\u001b[86Guse,\u001b[91Gsuch\u001b[96Gas\u001b[99Gthe\u001b[103Gneedless\u001b[112Gmemset\u001b[119Gof\r\u001b[1C\u001b[1B the 75 MB\u001b[13GKV cache. Next I'll check whether Accelerate has a faster\u001b[71Gtranspose than vDSP_mtrans.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Accelerate offers no out-of-place transpose beyond vDSP_mtrans, and superpages\u001b[82Gare\u001b[86Gunavailable\u001b[98Gon\u001b[101Garm64\u001b[107GmacOS,\u001b[114Gso\u001b[117Gthe\r\u001b[1C\u001b[1B remaining load wins are small.\u001b[34GNext I'll benchmark the block-GEMM\u001b[69Gshapes\u001b[76Gused\u001b[81Gin\u001b[84Gprefill,\u001b[93Gcomparing\u001b[103Gin-place\u001b[112Goutput\r\u001b[1C\u001b[1B against a contiguous buffer.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchma\u001b[11Gk\u001b[14Gg\u001b[16Gprefill block sgemm\u001b[36Gshapes\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cb2t && cat > gemm2.c <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m#define ACCELERATE_NEW_LAPACK\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m#include <Acceler"]
