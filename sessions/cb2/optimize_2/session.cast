[209.008, "\u001b[H\r\u001b[6C\u001b[1Bmachine is running\u001b[26Gslower\u001b[33Gtoday, a\u001b[42Gou\u001b[46G50\u201354 GB/s against 57\u201360 earlier. I'm re-measuri\u001b[95Gg the pure-re\u001b[109Gd ce\u001b[114Gl\u001b[116Gng\r\u001b[2C\u001b[1Band the pe\u001b[14G-call \u001b[21Gv\u001b[24Ghead of\u001b[32G\u001b[38;2;87;105;247msgemv\u001b[39m to get\u001b[45Gthe current gap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmicrobenchmark\u001b[22Ghits\u001b[27G58\u001b[30GGB/s\u001b[35Gand\u001b[39G0.57\u001b[44G\u00b5s\u001b[47Gper\u001b[51Gcall,\u001b[57Gbut\u001b[61Gthe\u001b[65Gprogram\u001b[73Gonly\u001b[78Greaches\u001b[86Gabout\u001b[92G51\u001b[95GGB/s,\u001b[101Gwith\u001b[106Gthe\u001b[110Ggap\u001b[114Ggrowing\r\u001b[1B \u001b[3Galongside matrix siz\u001b[24G. N\u001b[28Gxt I'll time a matmul-only\u001b[55Gpass over the program's \u001b[80Gwn weights to\u001b[95Gee which of the two\u001b[K\r\u001b[2C\u001b[1Bpossible causes is responsible.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gprobe\u001b[13Greadings\u001b[22Gare\u001b[26Gnoisy,\u001b[33Gbut\u001b[37Gthe\u001b[41Gbest\u001b[46Grepeat\u001b[53Ghits\u001b[58G60.5\u001b[63GGB/s,\u001b[69Gso\u001b[72Gthe\u001b[76"]
[209.009, "Gdecode\u001b[83Gis\u001b[86Galready\u001b[94Gnear\u001b[99Gthe\u001b[103Ghardware\u001b[112Glimit.\r\u001b[1B \u001b[3GAttent\u001b[10Gon\u001b[13Gruns slower in the program than in the microbenchmark because the weight stream evicts each l\u001b[107Gyer's KV\u001b[K\r\u001b[2C\u001b[1Bcache, so\u001b[13GI'm re-benchmarking\u001b[33Gattention\u001b[43Gwith the cache flu\u001b[62Ghed\u001b[66Gbetw\u001b[71Gen\u001b[74Gl\u001b[76Gy\u001b[78Grs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m With a cold cache, decode attention costs 0.08\u20130.44 ms per token and isn't worth changing, so I'm leaving it.\u001b[113GThe\r\u001b[2C\u001b[1Bbiggest remaining targets are load to READY at about 105 ms and prefill at about 200 ms, and I'm starting with a\r\u001b[2C\u001b[1Bbreakdown of load.\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load with a warm cache is dominated by transposing the classifier and layers (19\u001b[84Gms\u001b[87Gand\u001b[91G62\u001b[94Gms),\u001b[99Gplus\u001b[104Gsmaller\u001b[112Gsetup\u001b[118Gand\r\u001b[1C\u001b[1B tokenizer costs. The 5.3\u001b[28GGB/s\u001b[33Gtranspos"]
