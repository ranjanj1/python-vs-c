[443.259, "on,\u001b[64Gso\u001b[67GI'm\u001b[71Gsplitting\u001b[81Gits\u001b[85Gcost\u001b[90Ginto\u001b[95Gtranspose\u001b[105Gwork,\u001b[111Gsource\r\u001b[1B \u001b[3Gfaults and destina\u001b[22Gion faults n\u001b[35Gxt.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe load-time estimate\u001b[26Gfor\u001b[30Gthe\u001b[34G98\u001b[37GMB\u001b[40Gclassifier\u001b[51Gcomes\u001b[57Gto\u001b[60Gabout\u001b[66G95\u001b[69Gms,\u001b[73Gwith\u001b[78Groughly\u001b[86G45\u001b[89Gms\u001b[92Gof\u001b[95Gtransposing\u001b[107Gand\u001b[111G35\u001b[114Gms\u001b[117Gof\r\u001b[1B  page faults, and\u001b[20Gsince\u001b[26GvDSP_mtrans\u001b[38Gcan't\u001b[44Gbe\u001b[47Gtiled\u001b[53Gdifferently\u001b[65GI'm\u001b[69Gaccepting\u001b[79Gthat.\u001b[85GNext\u001b[90GI'm\u001b[94Gchecking\u001b[103Gtime\u001b[108Gto\u001b[111Gfirst\r\u001b[2C\u001b[1Btoken for the GENERATE prompts against a decode step.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm\u001b[20Gnd \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m Prefill costs about 1.3\u20132 decode steps (9.4\u201314.4 ms against a 7.3\u20137.4 ms decode step) because small-M \u001b[38;2;87;105;247msgemm\u001b[39m is less\u001b[K\r\u001b[1C\u001b[1B efficient than\u001b[18G\u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[25G"]
