[421.663, "\u001b[H\u001b[3Gremaining\u001b[13Gload\u001b[18Gwins\u001b[23Gare\u001b[27Gsmall.\u001b[34GNext\u001b[39GI'll\u001b[44Gbenchmark\u001b[54Gthe\u001b[58Gblock-GEMM\u001b[69Gshapes\u001b[76Gused\u001b[81Gin\u001b[84Gprefill,\u001b[93Gcomparing\u001b[103Gin-place\u001b[112Goutput\r\u001b[1B  against a contiguous buffer.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Prefill GEMMs are near their kernel limit and decode is near memory limit, so I'm now making three small cuts: lazy KV\r\u001b[1C\u001b[1B cache allocation, a single-read tokenizer\u001b[45Gload,\u001b[51Gand\u001b[55GL1-tiled\u001b[64GSwiGLU.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gfull check passes, and ENCODE i\u001b[39G still identical to the reference algorithm on all 514 texts. Next is A/B timing\u001b[K\r\u001b[1C\u001b[1B of v2 against the new build:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load\u001b[8Gdropped\u001b[16Gabout 8 ms (103\u001b[32G\u2192\u001b[34G95.5\u001b[39Gms)\u001b[43Gwh"]
