[217.908, "\u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmemset\u001b[14Gand\u001b[18Gtranspose\u001b[28Gspeeds\u001b[35Glook\u001b[40Ginconsistent\u001b[53Gwith\u001b[58Gan\u001b[61G8\u001b[63GGB\u001b[66Gmachine\u001b[74Gthat\u001b[79Gheld\u001b[84Gabout\u001b[90G1.3\u001b[94GGB,\u001b[98Gso\u001b[101GI'm\u001b[105Gchecking\u001b[114Gsystem\r\u001b[2C\u001b[1Bmemory pressure before\u001b[26Gtrusting\u001b[35Gthese\u001b[41Gnumbers.\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mChecking memory pressure and top pro\u001b[40Ge\u001b[42Gses\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ /usr/bin/memory_pressure 2>/dev/null | grep -E \"free percentage|Pages free|Pages active|Pages \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mwired|compressor|Swapins|Swapouts\" ; /usr/bin/vm_stat | head -12; ps -A -o rss=,comm= 2>/dev/null | sort -rn | head\r\u001b[5C\u001b[1B-8\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
