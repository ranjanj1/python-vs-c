[438.835, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad dropped about 8\u001b[24Gms\u001b[27G(103\u001b[32G\u2192\u001b[34G95.5\u001b[39Gms)\u001b[43Gwhile\u001b[49GGenerate,\u001b[59GLOGITS\u001b[66Gand\u001b[70GFIXED\u001b[76Gstayed\u001b[83Gthe\u001b[87Gsame,\u001b[93Gso\u001b[96GSwiGLU\u001b[103Gtiling\u001b[110Gdoesn't\r\u001b[2C\u001b[1Bmatter\u001b[10Gat\u001b[13Gfixture\u001b[21Gsizes.\u001b[28GLoad\u001b[33Gis\u001b[36Gstill\u001b[42Gmostly\u001b[49Gtransposition,\u001b[64Gso\u001b[67GI'm\u001b[71Gsplitting\u001b[81Gits\u001b[85Gcost\u001b[90Ginto\u001b[95Gtranspose\u001b[105Gwork,\u001b[111Gsource\r\u001b[1B \u001b[3Gfaults and destination\u001b[26Gfaults next.\u001b[39G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gload-time\u001b[17Gestimate\u001b[26Gfor\u001b[30Gthe\u001b[34G98\u001b[37GMB\u001b[40Gclassifier\u001b[51Gcomes\u001b[57Gto\u001b[60Gabout\u001b[66G95\u001b[69Gms,\u001b[73Gwith\u001b[78Groughly\u001b[86G45\u001b[89Gms\u001b[92Gof\u001b[95Gtransposing\u001b[107Gand\u001b[111G35\u001b[114Gms\u001b[117Gof\r\u001b[1B \u001b[3Gpage faults, and \u001b[21Gince\u001b[26GvDSP_mtrans can't be tiled differently I'm a\u001b[71Gcepting \u001b[81Gat. Next\u001b[90GI'm\u001b[94Gchecking time to first\u001b[K\r\u001b[2C\u001b"]
