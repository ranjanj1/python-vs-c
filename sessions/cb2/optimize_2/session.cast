[474.41, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m python3 check.py -- ./cb2\u001b[30G|\u001b[32Gtail\u001b[37G-1\u001b[40G&&\u001b[43Gpython3\u001b[51Gcheck.py\u001b[60G--tokens\u001b[69G64\u001b[72G--prompts\u001b[82G3\u001b[84G--\u001b[87G./cb2\u001b[93G&&\u001b[96Gpython3\u001b[104G/tmp/cb2t/t.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m&&\u001b[7Gpython3\u001b[15G/tmp/cb2t/ctx.py\u001b[32G&&\u001b[35Gsed\u001b[39G's/#define\u001b[50GCHUNK\u001b[56G512\u001b[60G/#define\u001b[69GCHUNK\u001b[75G1\u001b[77G/'\u001b[80Gcb2.c\u001b[86G>\u001b[88G/tmp/cb2t/c1.c\u001b[103G&&\u001b[106Gcc\u001b[109G-O3\r\u001b[1B \u001b[2m\u2502\u001b[22m -mcpu=native\u001b[17G-o /tmp/cb2t/c1 /tmp/cb2t/c1.c -framew\u001b[56Grk Accelerate\u001b[70G&& python3 /tmp/cb2t/cmp2.py && python3\u001b[110G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m /tmp/cb2t/e\u001b[16Gc\u001b[18Gpy | tail -1\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[474.411, "\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
