[268.909, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comma\u001b[21Gd \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFull check passes, with max\u001b[31Glogit\u001b[37Gerror\u001b[43Gabout\u001b[49G2e-5\u001b[54Gagainst\u001b[62Ga\u001b[64Gtolerance\u001b[74Gof\u001b[77G5e-4.\u001b[83GNext\u001b[88GI'm\u001b[92Gchecking\u001b[101GPIECE\u001b[107Gagainst\u001b[115Gthe\r\u001b[2C\u001b[1Bfixture\u001b[11Gpieces,\u001b[19Gedge\u001b[24Gcases\u001b[30G(context\u001b[39Gstop,\u001b[45Gchunk\u001b[51Gboundaries,\u001b[63Gbad\u001b[67Ginput)\u001b[74Gand\u001b[78Gtiming.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All fixtures match and decoding runs at about\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[1B  and whether sgemm beats sgemv at M=1.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Chu\u001b[7Gked and sequential\u001b[26Gpaths\u001b[32Gagree\u001b[38Gto\u001b[41G3.3e-5\u001b[48Gover\u001b[53G600\u001b[57Gpositions,\u001b[68Gwhich\u001b[74Gcrosses\u001b[82Gtwo\u001b[86Gchunk\u001b[92Gboun"]
[268.91, "daries.\u001b[104GNow\u001b[108Gthe\u001b[112Gdecode\r\u001b[1C\u001b[1B speed experiment:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Sgemm at M=1 also reaches about 78 tok/s, so\u001b[48Gdecoding\u001b[57Gis\u001b[60Glimited\u001b[68Gby\u001b[71Gmemory\u001b[78Gbandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[1C\u001b[1B test a layout change, storing the weights transposed and calling sge\u001b[72Gv with Trans.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Benchmarking sgemv bandwidth for\u001b[36Gboth\u001b[41Glayouts\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cb2t && cat > bench.c <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m#define ACCELERATE_NEW_LAPACK\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m#include <Accelerate/Accelerate.h>\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m#include <stdio.h>\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m#include <stdlib.h>\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G \u001b[6G\u001b[38;2;102;102;102m#include <time.h>\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mstatic double now(){struct timespec t;clock_get"]
