[326.626, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfixtures\u001b[16Gmatch\u001b[22Gand\u001b[26Gdecoding\u001b[35Gruns\u001b[40Gat\u001b[43Gabout\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[1B \u001b[3Gand\u001b[7Gwhe\u001b[11Gher sgemm beats sgemv at M=1.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChunked\u001b[11Gand\u001b[15Gsequential\u001b[26Gpaths\u001b[32Gagree\u001b[38Gto\u001b[41G3.3e-5\u001b[48Gover\u001b[53G600\u001b[57Gpositions,\u001b[68Gwhich\u001b[74Gcrosses\u001b[82Gtwo\u001b[86Gchunk\u001b[92Gboundaries.\u001b[104GNow\u001b[108Gthe\u001b[112Gdecode\r\u001b[1B \u001b[3Gspeed experim\u001b[17Gnt:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSgemm\u001b[9Gat\u001b[12GM=1\u001b[16Galso\u001b[21Greaches\u001b[29Gabout\u001b[35G78\u001b[38Gtok/s,\u001b[45Gso\u001b[48Gdecoding\u001b[57Gis\u001b[60Glimited\u001b[68Gby\u001b[71Gmemory\u001b[78Gbandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[1B \u001b[3Gtest a layout chang\u001b[23G, storing \u001b[34Ghe weights\u001b[45Gtransp\u001b[52Gsed and\u001b[60Gcalling\u001b[68Gsge\u001b["]
[326.627, "72Gv with Trans.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Glayouts\u001b[16Grun\u001b[20Gat\u001b[23Gthe\u001b[27Gsame\u001b[32G~34\u001b[36GGB/s,\u001b[42Gwhich\u001b[48Glooks\u001b[54Glike\u001b[59Gthe\u001b[63Gsingle-core\u001b[75Gmemory\u001b[82Gbandwidth\u001b[92Gceiling,\u001b[101Gso\u001b[104GI\u001b[106Gkept\u001b[111Gthe\r\u001b[1B \u001b[3Gcurrent layout. L\u001b[21Gst tuning step\u001b[36Gis the prefi\u001b[49Gl chunk size:\u001b[63G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm\u001b[7Gsetting\u001b[15GCHUNK\u001b[21Gto\u001b[24G512.\u001b[29GThat's\u001b[36Gabout\u001b[42G7%\u001b[45Gfaster\u001b[52Gat\u001b[55G1024\u001b[60Gtokens,\u001b[68Gand\u001b[72Gits\u001b[76Glogits\u001b[83Gbuffer\u001b[90Gis\u001b[93G65\u001b[96GMB.\u001b[100GThen\u001b[105GI'll\u001b[110Grebuild,\r\u001b[1B \u001b[3Gre-ch\u001b[9Gck, and write the notes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mTesting\u001b[11Gcontext-limit\u001b[25Gstop\u001b[30Gbehaviour\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cat > /tmp/cb2t/ctx.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport subpro\u001b[20Gess\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;"]
