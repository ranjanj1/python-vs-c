[323.615, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll fixtures match and decoding\u001b[35Gruns\u001b[40Gat\u001b[43Gabout\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[2C\u001b[1Band\u001b[7Gwhether\u001b[15Gsgemm\u001b[21Gbeats\u001b[27Gsgemv\u001b[33Gat\u001b[36GM=1.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChunked and sequential paths agree to 3.3e-5 over 600 positions, which crosses two chunk boundaries. Now the decode\r\u001b[2C\u001b[1Bspeed experiment:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSgemm\u001b[9Gat\u001b[12GM=1\u001b[16Galso\u001b[21Greaches\u001b[29Gabout\u001b[35G78\u001b[38Gtok/s,\u001b[45Gso\u001b[48Gdecoding\u001b[57Gis\u001b[60Glimited\u001b[68Gby\u001b[71Gmemory\u001b[78Gbandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[1B  test a layout change, storing the weights transposed and calling sgemv with Trans.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r"]
[323.616, "\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Both layouts run at the same ~34 GB/s, which looks like the single-core memory bandwidth ceiling, so I kept the\u001b[K\r\u001b[1C\u001b[1B current layout. Last tuning step\u001b[36Gis\u001b[39Gthe\u001b[43Gprefill\u001b[51Gchunk\u001b[57Gsize:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm setting CHUNK to 512. That's about 7% faster at 1024 token\u001b[66G, and its \u001b[77Gogits buffer is 65\u001b[96GMB.\u001b[100GThen\u001b[105GI'll\u001b[110Grebuild,\r\u001b[1C\u001b[1B re-check,\u001b[13Gand write the\u001b[27Gnotes.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Testing context-limit stop behaviour\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/cb2t/ctx.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mimport subprocess\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mp=subprocess.Popen(['./cb2','model.bin','tokenizer.bin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mp.stdout.readline()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mdef ask(s): p.stdin"]
[323.617, ".write(s+'\\n'); p.stdin.flush(); return p.stdout.readline().rstrip('\\n')\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mfor k in (1015, 1030):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102m\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2736\u001b[39m \u001b[38;2;245;149;117mPercolating\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(5m 5s \u00b7 \u2193\u001b[27G26.2k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G   \u001b[40G   \u001b[44G                        \u001b[69G        \u001b[78G  \u001b[81G                      \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m"]
