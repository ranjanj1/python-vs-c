[295.607, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFull\u001b[8Gcheck\u001b[14Gpasses,\u001b[22Gwith\u001b[27Gmax\u001b[31Glogit\u001b[37Gerror\u001b[43Gabout\u001b[49G2e-5\u001b[54Gagainst\u001b[62Ga\u001b[64Gtolerance\u001b[74Gof\u001b[77G5e-4.\u001b[83GNext\u001b[88GI'm\u001b[92Gchecking\u001b[101GPIECE\u001b[107Gagainst\u001b[115Gthe\r\u001b[2C\u001b[1Bfixture pieces, edge\u001b[24Gcases\u001b[30G(context\u001b[39Gstop,\u001b[45Gchunk\u001b[51Gboundaries,\u001b[63Gbad\u001b[67Ginput)\u001b[74Gand\u001b[78Gtiming.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfixtures\u001b[16Gmatch\u001b[22Gand\u001b[26Gdecoding\u001b[35Gruns\u001b[40Gat\u001b[43Gabout\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[2C\u001b[1Band whether sgemm beats\u001b[27Gsgemv\u001b[33Gat\u001b[36GM=1.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChunked\u001b[11Gand\u001b[15Gsequential\u001b[26Gpaths\u001b[32Gagree\u001b[38Gto\u001b[41G3.3e-5\u001b[48Gover\u001b[53G600\u001b[57Gpositions,\u001b[68Gwhich\u001b[74Gcrosses\u001b[82Gtwo\u001b[86Gchunk\u001b[92Gboundaries.\u001b[104GNow\u001b[108Gthe\u001b[112Gdecode\r\u001b[2C\u001b[1Bspeed experiment:\u001b[K"]
[295.608, "\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSgemm\u001b[9Gat\u001b[12GM=1\u001b[16Galso\u001b[21Greaches\u001b[29Gabout\u001b[35G78\u001b[38Gtok/s,\u001b[45Gso\u001b[48Gdecoding\u001b[57Gis\u001b[60Glimited\u001b[68Gby\u001b[71Gmemory\u001b[78Gbandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[1B \u001b[3Gt\u001b[5Gst a layout change,\u001b[25Gstori\u001b[31Gg\u001b[33Gthe we\u001b[40Gghts transpo\u001b[53Ged\u001b[56Gand\u001b[60Gcalling\u001b[68Gsgemv\u001b[74Gwith\u001b[79GTrans.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Glayouts\u001b[16Grun\u001b[20Gat\u001b[23Gthe\u001b[27Gsame\u001b[32G~34\u001b[36GGB/s,\u001b[42Gwhich\u001b[48Glooks\u001b[54Glike\u001b[59Gthe\u001b[63Gsingle-core\u001b[75Gmemory\u001b[82Gbandwidth\u001b[92Gceiling,\u001b[101Gso\u001b[104GI\u001b[106Gkept\u001b[111Gthe\r\u001b[1B  current layout. Last tuning step is the prefill chunk size:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm setting CHUNK to 512. That's about 7% faster at 1024 tokens, and its logits buffe"]
[295.61, "r is 65 MB. Then I'll rebuild,\u001b[K\r\u001b[1C\u001b[1B re-check, and write the notes.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Rebuilding with CHUNK 512 and\u001b[33Grerun\u001b[39Ging all checks\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/#define CHUNK 256/#define CHUNK 512/' cb2.c && printf '#!/bin/sh\\nset -e\\ncd \"$(dirname \"$0\")\"\\ncc \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m-O3 -mcpu=native -Wall -Wextra -o cb2 cb2.c -framework Accelerate\\n' > build.sh && chmod +x build.sh && ./build.sh \r\u001b[1C\u001b[1B\u001b[39m    \u001b[38;2;102;102;102m&& python3 check.py -- ./cb2 && python3 check.py --tokens 64 --prompts\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2736\u001b[39m \u001b[38;2;245;149;117mPercolating\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(4m 38s \u00b7 \u2193\u001b[28G25.6k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G    \u001b[37G   \u001b[41G \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
