[295.472, "\u001b[H\r\u001b[2C\u001b[3BSgemm at M=1 also reac\u001b[26Ges about 78 tok/s, so decodin\u001b[56G \u001b[58Gs limi\u001b[65Ged by m\u001b[73Gm\u001b[75Gry bandwidth\u001b[88Gat roughly 34 GB/s. Next I'll\u001b[K\r\u001b[2C\u001b[1Btes\u001b[7G a layout chan\u001b[23G, storing th\u001b[36G weights\u001b[45Gtra\u001b[49Gsposed \u001b[57Gnd calling sgemv\u001b[74Gwith Tra\u001b[83Gs\r\u001b[2C\u001b[4BBoth layout\u001b[16Grun at the same ~34 GB/s, which looks like\u001b[59Gthe\u001b[63Gsingle-\u001b[71Gore memory bandwidth\u001b[92Gceiling, so I kept the\u001b[K\r\u001b[2C\u001b[1Bcurrent layout. Last \u001b[25Guning step\u001b[36Gis the\u001b[43Gprefill\u001b[51Gchunk\u001b[57Gsize:\r\u001b[2C\u001b[4BI'm s\u001b[9Gtti\u001b[13Gg\u001b[15GCHUNK \u001b[22Go 512. That's about 7% faster at 1024 toke\u001b[68Gand its logits buffer is 65 MB. Then I'll rebuil\u001b[117G,\r\u001b[2C\u001b[1Bre-check, and write\u001b[23Gthe\u001b[27Gnotes.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRebuilding with CHUNK\u001b[25G512\u001b[29Gand\u001b[33Grerunning\u001b[43Gall\u001b[47Gchecks\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/#define CHUNK 256/#define CHUNK 512/' cb2.c && printf '#!/bin/sh\\nset -e\\ncd \"$(dirname \"$0\")\"\\ncc \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m-O3 -mcpu=native -Wall -Wextra -o cb2"]
[295.473, " cb2.c -framework Accelerate\\n' > build.sh && chmod +x build.sh && ./build.sh \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m&& python3 check.py -- ./cb2 && python3 check.py --tokens 64 --prompts\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mRebuild with CHUNK 512 and rerun all checks\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[295.474, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m sed -i '' 's/#define\u001b[25GCHUNK\u001b[31G256/#define\u001b[43GCHUNK\u001b[49G512/'\u001b[55Gcb2.c\u001b[61G&&\u001b[64Gprintf\u001b[71G'#!/bin/sh\\nset\u001b[87G-e\\ncd\u001b[94G\"$(dirname\u001b[105G\"$0\")\"\\ncc\u001b[116G-O3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-mcpu=native\u001b[17G-Wall\u001b[23G-Wextra\u001b[31G-o\u001b[34Gcb2\u001b[38Gcb2.c\u001b[44G-framework\u001b[55GAccelerate\\n'\u001b[69G>\u001b[71Gbuild.sh\u001b[80G&&\u001b[83Gchmod\u001b[89G+x\u001b[92Gbuild.sh\u001b[101G&&\u001b[104G./build.sh\u001b[115G&&\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 check.py\u001b[21G--\u001b[24G./cb2 && python3 check.py --tokens 64 --prompts\u001b[72G3 -- ./cb2\u001b[83G| tail\u001b[90G-1\u001b[93G&&\u001b[96Gpython3 /tmp/cb2t/cmp.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m && python3 /tmp/cb2\u001b[24G/t.py 2>&1\u001b[35G|\u001b[37Ghead\u001b[42G-6\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[295.474, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gsed\u001b[41G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
