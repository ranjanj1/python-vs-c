[362.894, "2;0;134;179m(const int *ids, int n, FILE *f, int *am)\u001b[38;2;51;51;51m {\r\u001b[5C\u001b[1B\u001b[2m 347 \u001b[22m     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m p0 = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m; p0 < n; p0 += CHUNK) {\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 348 \u001b[22m         \u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m c = n - p0 < CHUNK ? n - p0 : CHUNK;\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m53\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mNOTES.md\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m# CB2 implementation notes\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[11G\u001b[22mechnique: **CB2**. C\u001b[33Gith\u001b[37Gfloat32 arrays, plus Apple Accelerate calls. Sourc\u001b[88G is `cb2.c`, built by `bui\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[22mld.sh` into `./cb2`.\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22mThe \u001b[15Gnly sou\u001b[23Gces used were `reference/run.c`, `RULES.md`, `INTERFACE.md`, `check.py` and the fixtures.\r\u001b[7C\u001b[1B\u001b[2m5\r\u001b[7C\u001b[1B6\u001b[10G\u001b[2"]
[362.895, "2m## Commands run\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m```\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22mcat RULES.md INTERFACE.md check.py; read reference/run.c; inspected fixtures.json and the model header\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +44 lines \u001b[19G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ./build.sh && python3 check.py --tokens 64 --prompts 3 -- ./cb2 | tail -1 && python3 check.py -- ./cb2 | tail -1\u001b[39m\u001b[40;1H\u001b[38;3H"]
