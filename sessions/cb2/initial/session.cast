[372.573, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mPrompts, FIXED and LOGITS:\u001b[22m tokens are proc\u001b[48Gssed\u001b[53Gin groups\u001b[63Gof\u001b[66Gup\u001b[69Gto\u001b[72G512\u001b[76Gwith\u001b[81G\u001b[38;2;87;105;247mcblas_sgemm\u001b[39m.\u001b[94GAttention\u001b[104Galso\u001b[109Guses\u001b[114G\u001b[38;2;87;105;247msgemm\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5Gmasked so each position only s\u001b[36Ge\u001b[39Gitself and \u001b[51Garlier positions.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGenerating one token at a time:\u001b[22m uses \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mOth\u001b[10G numeric s\u001b[21Geps:\u001b[22m norms, softmax and residual adds\u001b[59Guse\u001b[63GvDSP/vForce;\u001b[76GSwiGLU\u001b[83Gand\u001b[87GRoPE\u001b[92Gare\u001b[96Gshort\u001b[102Gplain-C\u001b[110Gloops\u001b[116Gwith\r\u001b[2C\u001b[1B \u001b[5Gthe reference's formulas. No ma\u001b[37Gri\u001b[41Gloops are written\u001b[59Gby hand and no CPU \u001b[79Gntrinsics are used. The program never\u001b[K\r\u001b[4C\u001b[1Bcr\u001b[8Gat\u001b[11Gs thread\u001b[21Gor sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port \u001b[38Gf \u001b[41Ghe\u001b[44Greference.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\r\u001b[2C\u001b[1B\u001b[22m- PIECE output matches every \u001b[38;2;87;105;247m"]
[372.575, "pieces\u001b[39m entry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[4C\u001b[1BThe argmax from FIXED ag\u001b[30Gees with\u001b[39Gthe token ids GENERATE\u001b[62Gproduced.\r\u001b[4C\u001b[1BProcessing\u001b[16G600 positions in groups gives the same logits\u001b[62Gas \u001b[66Going them\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m sto\u001b[21G works: a 1016-token prompt gives\u001b[55G\u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[71G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                        \u2502                   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY          \u2502 about 0.1 s       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[372.576, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Generation             \u2502 about 79 tokens/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED with 1024 tokens \u2502 about 0.42 s      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration\u001b[14Gis\u001b[17Glimited\u001b[25Gby\u001b[28Gmemory\u001b[35Gspeed:\u001b[42Git\u001b[45Greads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bh\u001b[5Gr\u001b[7G. Trying \u001b[38;2;87;105;247msgemm\u001b[39m instead, \u001b[33G storing\u001b[42Gthe weigh\u001b[52Gs transpo\u001b[62Ged,\u001b[66Ggave no gain.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md\u001b[48Gdoesn't\u001b[56Gcover\u001b[62Gthese\u001b[68Gcases)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumerics:\u001b[15G\u001b[22mresults\u001b[23Gdiffer\u001b[30Gslightly\u001b[3"]
[372.577, "9Gfrom\u001b[44Gthe\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[2C\u001b[1B \u001b[5Ggreedy generation\u001b[23Gcould in principle pick a diff\u001b[54Grent token than the r\u001b[76Gference.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop order:\u001b[22m in GENERATE, \u001b[38;2;87;105;247mstop\u001b[39m is ch\u001b[41Gcked first, th\u001b[57G \u001b[38;2;87;105;247mmax\u001b[39m, then \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[K\u001b[40;1H\u001b[38;3H"]
[373.016, "\u001b[H\u001b[5G\u001b[1mGenerating one\u001b[20Gtoken at a time:\u001b[22m uses \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther numeric steps:\u001b[22m norms, softmax and residu\u001b[52Gl adds u\u001b[61Ge vDSP/vForce;\u001b[76GSwiGLU\u001b[83Gand\u001b[87GRoPE\u001b[92Gare\u001b[96Gshort\u001b[102Gplain-C\u001b[110Gloops\u001b[116Gwith\r\u001b[2C\u001b[1B \u001b[5Gthe reference's formulas. No matrix loops are written\u001b[59Gby\u001b[62Ghand\u001b[67Gand\u001b[71Gno\u001b[74GCPU\u001b[78Gintrinsics\u001b[89Gare\u001b[93Gused.\u001b[99GThe\u001b[103Gprogram\u001b[111Gnever\r\u001b[2C\u001b[1B \u001b[5Gcreates threads or sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port of the refe\u001b[50Gnce.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Goutput\u001b[18Gmatches\u001b[26Gevery\u001b[32G\u001b[38;2;87;105;247mpieces\u001b[39G\u001b[39mentry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[2C\u001b[1B- The argmax from FIXED agrees with the token\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[5C\u001b[1Brocessing 600 positions in groups gives the same logits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[8"]
[373.017, "C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-\u001b[37Goken pr\u001b[45Gmpt\u001b[49Ggives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[28G\u253c\u001b[48G\u2524\r\u001b[4C\u001b[1BLoad\u001b[10Gto\u001b[13GREADY\u001b[30Gabout\u001b[36G0.1\u001b[40Gs\r\u001b[4C\u001b[2BGeneration   \u001b[36G79 tokens/s\r\u001b[4C\u001b[2BFIXED w\u001b[13Gth\u001b[16G1024\u001b[21Gtokens\u001b[36G0.42 s     \r\u001b[2C\u001b[1B\u2514\u001b[28G\u2534\u001b[48G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is limited by memory speed: it reads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere.\u001b[9GTrying\u001b[16G\u001b[38;2;87;105;247msgemm\u001b[22G\u001b[39minstead,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md doesn'\u001b[55G cov"]
[373.019, "er these cases)\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mNumer\u001b[11Gcs:\u001b[22m results differ slightly from the\u001b[48Greference b\u001b[60Gcaus\u001b[65G Ac\u001b[69Gel\u001b[72Grate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[4C\u001b[1Bgreedy\u001b[12Ggeneration\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpick\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[4C\u001b[1B\u001b[1mStop order:\u001b[22m in GENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[39m is checked fi\u001b[49Gst, then\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m, then \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[77G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[22m \u001b[18G prompt \u001b[27Gonger than 1024 to\u001b[46Gens answers \u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand \u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[2C\u001b[1B \u001b[5Grunning the\u001b[17Gmodel.\u001b[K\u001b[40;1H\u001b[38;3H"]
[373.412, "\u001b[H\r\u001b[4C\u001b[34B\u001b[1mEmpty pieces:\u001b[19G\u001b[22mPIECE\u001b[25Gprints\u001b[32G\u001b[38;2;87;105;247mHEX \u001b[37G\u001b[39mwith\u001b[42Gnothing\u001b[50Gafter\u001b[56Git\u001b[59Gfor\u001b[63Gan\u001b[66Gempty\u001b[72Gpiece.\u001b[79GThat\u001b[84Gincludes\u001b[93Gthe\u001b[97Graw\u001b[101Gbyte\u001b[106G\u001b[38;2;87;105;247m<0x00>\u001b[39m,\u001b[114Gbecause\u001b[40;1H\u001b[38;3H"]
[373.412, "\u001b]0;\u25d0 Claude Code\u0007"]
[373.672, "\u001b[H\u001b[3G \u001b[5Gthe reference's formulas. No matrix loops are written\u001b[59Gby\u001b[62Ghand\u001b[67Gand\u001b[71Gno\u001b[74GCPU\u001b[78Gintrinsics\u001b[89Gare\u001b[93Gused.\u001b[99GThe\u001b[103Gprogram\u001b[111Gnever\r\u001b[2C\u001b[1B \u001b[5Gcreates threads or sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port of the refe\u001b[50Gnce.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Goutput\u001b[18Gmatches\u001b[26Gevery\u001b[32G\u001b[38;2;87;105;247mpieces\u001b[39G\u001b[39mentry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[2C\u001b[1B- The argmax from FIXED agrees with the token\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[5C\u001b[1Brocessing 600 positions in groups gives the same logits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[8C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-\u001b[37Goken pr\u001b[45Gmpt\u001b[49Ggives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500"]
[373.672, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[28G\u253c\u001b[48G\u2524\r\u001b[4C\u001b[1BLoad\u001b[10Gto\u001b[13GREADY\u001b[30Gabout\u001b[36G0.1\u001b[40Gs\r\u001b[4C\u001b[2BGeneration   \u001b[36G79 tokens/s\r\u001b[4C\u001b[2BFIXED w\u001b[13Gth\u001b[16G1024\u001b[21Gtokens\u001b[36G0.42 s     \r\u001b[2C\u001b[1B\u2514\u001b[28G\u2534\u001b[48G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is limited by memory speed: it reads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere.\u001b[9GTrying\u001b[16G\u001b[38;2;87;105;247msgemm\u001b[22G\u001b[39minstead,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md doesn'\u001b[55G cover these cases)\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mNumer\u001b[11Gcs:\u001b[22m results differ slightly from the\u001b[48Greference b\u001b[60Gcaus\u001b[65G Ac\u001b[69Gel\u001b[72Grate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[4C\u001b[1Bgreedy\u001b[12Ggeneration\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpi"]
[373.673, "ck\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[4C\u001b[1B\u001b[1mStop order:\u001b[22m in GENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[39m is checked fi\u001b[49Gst, then\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m, then \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[77G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[22m \u001b[18G prompt \u001b[27Gonger than 1024 to\u001b[46Gens answers \u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand \u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[2C\u001b[1B \u001b[5Grunning the\u001b[17Gmodel.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mmpty pi\u001b[14Gces:\u001b[19G\u001b[22mPIECE pri\u001b[29Gts \u001b[38;2;87;105;247mHEX \u001b[39m with nothi\u001b[48Gg\u001b[51Gfter it for an empty piece. That include\u001b[92G the\u001b[97Graw byte \u001b[38;2;87;105;247m<0x00>\u001b[39m, because\r\u001b[4C\u001b[1Bthe reference treats\u001b[26Gpieces\u001b[33Gas\u001b[36GC\u001b[38Gstrings.\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[373.969, "\u001b[H\u001b[5Gcr\u001b[8Gat\u001b[11Gs thread\u001b[21Gor sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port \u001b[38Gf \u001b[41Ghe\u001b[44Greference.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\r\u001b[2C\u001b[1B\u001b[22m- PIECE output matches every \u001b[38;2;87;105;247mpieces\u001b[39m entry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[4C\u001b[1BThe argmax from FIXED ag\u001b[30Gees with\u001b[39Gthe token ids GENERATE\u001b[62Gproduced.\r\u001b[4C\u001b[1BProcessing\u001b[16G600 positions in groups gives the same logits\u001b[62Gas \u001b[66Going them\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m sto\u001b[21G works: a 1016-token prompt gives\u001b[55G\u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[71G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                        \u2502                   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[373.97, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY          \u2502 about 0.1 s       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Generation             \u2502 about 79 tokens/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED with 1024 tokens \u2502 about 0.42 s      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration\u001b[14Gis\u001b[17Glimited\u001b[25Gby\u001b[28Gmemory\u001b[35Gspeed:\u001b[42Git\u001b[45Greads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bh\u001b[5Gr\u001b[7G. Trying \u001b[38;2;87;105;247msgemm\u001b[39m instead, \u001b[33G"]
[373.971, " storing\u001b[42Gthe weigh\u001b[52Gs transpo\u001b[62Ged,\u001b[66Ggave no gain.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md\u001b[48Gdoesn't\u001b[56Gcover\u001b[62Gthese\u001b[68Gcases)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNumerics:\u001b[15G\u001b[22mresults\u001b[23Gdiffer\u001b[30Gslightly\u001b[39Gfrom\u001b[44Gthe\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[2C\u001b[1B \u001b[5Ggreedy generation\u001b[23Gcould in principle pick a diff\u001b[54Grent token than the r\u001b[76Gference.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop order:\u001b[22m in GENERATE, \u001b[38;2;87;105;247mstop\u001b[39m is ch\u001b[41Gcked first, th\u001b[57G \u001b[38;2;87;105;247mmax\u001b[39m, then \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mEdge\u001b[10Gcas\u001b[14Gs\u001b[17G\u001b[22ma prompt longer than\u001b[38G1024 tokens answers\u001b[58G\u001b[38;2;87;105;247mDONE 0 contex\u001b[72G\u001b[39m, and\u001b[78G\u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[2C\u001b[1B \u001b[5Grunning the\u001b[17Gmodel.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEmpty pieces:\u001b[22m PIECE\u001b[25Gprints\u001b[32G\u001b[3"]
[373.972, "8;2;87;105;247mHEX \u001b[37G\u001b[39mwith\u001b[42Gnothing\u001b[50Gafter\u001b[56Git\u001b[59Gfor\u001b[63Gan\u001b[66Gempty\u001b[72Gpiece.\u001b[79GThat\u001b[84Gincludes\u001b[93Gthe\u001b[97Graw\u001b[101Gbyte\u001b[106G\u001b[38;2;87;105;247m<0x00>\u001b[39m,\u001b[114Gbecause\r\u001b[2C\u001b[1B \u001b[5Gthe reference\u001b[19Gtreats p\u001b[28Geces as C s\u001b[40Gri\u001b[43Ggs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBad input:\u001b[22m malformed\u001b[26Gcommands,\u001b[36Gout-of-range\u001b[49Gids,\u001b[54Gand\u001b[58GFIXED/LOGITS\u001b[71Gwith\u001b[76Gmore\u001b[81Gthan\u001b[86G1024\u001b[91Gids\u001b[95Gget\u001b[99Gan\u001b[102G\u001b[38;2;87;105;247mERR \u2026\u001b[108G\u001b[39mline.\u001b[40;1H\u001b[38;3H"]
[374.372, "\u001b[H\u001b[5G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Goutput\u001b[18Gmatches\u001b[26Gevery\u001b[32G\u001b[38;2;87;105;247mpieces\u001b[39G\u001b[39mentry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[2C\u001b[1B- The argmax from FIXED agrees with the token\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[5C\u001b[1Brocessing 600 positions in groups gives the same logits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[8C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-\u001b[37Goken pr\u001b[45Gmpt\u001b[49Ggives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[28G\u253c\u001b[48G\u2524\r\u001b[4C\u001b[1BLoad\u001b[10Gto\u001b[13GREADY\u001b[30Gabout\u001b[36G0.1\u001b[40Gs\r\u001b[4C\u001b[2BGeneration   \u001b[36G79 tokens/s\r\u001b[4C\u001b[2BFIXED w\u001b[13Gth\u001b[16G1024\u001b[21Gtokens\u001b[36G0.42 s     \r\u001b[2C\u001b[1B\u2514\u001b[28G\u2534\u001b[48G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b["]
[374.373, "1BGeneration is limited by memory speed: it reads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere.\u001b[9GTrying\u001b[16G\u001b[38;2;87;105;247msgemm\u001b[22G\u001b[39minstead,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md doesn'\u001b[55G cover these cases)\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mNumer\u001b[11Gcs:\u001b[22m results differ slightly from the\u001b[48Greference b\u001b[60Gcaus\u001b[65G Ac\u001b[69Gel\u001b[72Grate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[4C\u001b[1Bgreedy\u001b[12Ggeneration\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpick\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[4C\u001b[1B\u001b[1mStop order:\u001b[22m in GENERATE,\u001b[30G\u001b[38;2;87;105;247mstop\u001b[39m is checked fi\u001b[49Gst, then\u001b[58G\u001b[38;2;87;105;247mmax\u001b[39m, then \u001b[38;2;87;105;247mcontext\u001b[39m.\u001b[77G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[22m \u001b[18G prompt \u001b[27Gonger tha"]
[374.375, "n 1024 to\u001b[46Gens answers \u001b[38;2;87;105;247mDONE 0 context\u001b[39m,\u001b[74Gand \u001b[38;2;87;105;247mGENERATE 0\u001b[89G\u001b[39manswers\u001b[97G\u001b[38;2;87;105;247mDONE 0 max\u001b[108G\u001b[39mwithout\r\u001b[2C\u001b[1B \u001b[5Grunning the\u001b[17Gmodel.\u001b[K\r\u001b[5C\u001b[1B\u001b[1mmpty pi\u001b[14Gces:\u001b[19G\u001b[22mPIECE pri\u001b[29Gts \u001b[38;2;87;105;247mHEX \u001b[39m with nothi\u001b[48Gg\u001b[51Gfter it for an empty piece. That include\u001b[92G the\u001b[97Graw byte \u001b[38;2;87;105;247m<0x00>\u001b[39m, because\r\u001b[4C\u001b[1Bthe reference treats\u001b[26Gpieces\u001b[33Gas\u001b[36GC\u001b[38Gstrings.\r\u001b[4C\u001b[1B\u001b[1mBad in\u001b[12Gut:\u001b[22m malformed commands, out-of-range ids, and FIXED/LOGITS with more than 1024 ids get an \u001b[38;2;87;105;247mERR \u2026\u001b[39m line.\u001b[114G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m it isn't zero\u001b[29Gd between commands.\u001b[49GEach\u001b[54Gcommand\u001b[62Gwrites\u001b[69Gevery\u001b[75Gposition\u001b[84Gbefore\u001b[91Greading\u001b[99Git,\u001b[103Gso\u001b[106Gnothing\u001b[114Gcarries\r\u001b[2C\u001b[1B \u001b[5Gover.\u001b[K\u001b[40;1H\u001b[38;3H"]
