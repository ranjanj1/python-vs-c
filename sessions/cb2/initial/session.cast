[190.883, ";102mRead \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've gone over the rules, interface, harness and reference:\u001b[63Gthe\u001b[67Gmodel\u001b[73Gis\u001b[76G768-dim\u001b[84Gwith\u001b[89G12\u001b[92Glayers\u001b[99Gand\u001b[103Ga\u001b[105G32000-token\r\u001b[2C\u001b[1Bvocab.\u001b[10GI'll\u001b[15Gfuse\u001b[20GQKV\u001b[24Gand\u001b[28GW1/W3\u001b[34Gper\u001b[38Glayer,\u001b[45Grun\u001b[49Gprompts\u001b[57Gthrough\u001b[65GBLAS\u001b[70Gmatrix\u001b[77Gops,\u001b[82Gand\u001b[86Ghandle\u001b[93Gdecode\u001b[100Gwith\u001b[105Gmatrix-vector\r\u001b[1B \u001b[3Gcalls.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(cb2.c)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m461\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mcb2.c\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m/* CB2 port of reference/run.c (llama2.c): C + Apple Accelerate, float32.\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m * Interface: see INTERFACE.md. Matrix work goes through \u001b[38;2;121;93;163mAccelerate\u001b[38;2;51;51;51m \u001b[38;2;0;134;179m(cblas_sgemm / cblas_sgemv)\u001b[38;2;51;51;51m;\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22m "]
