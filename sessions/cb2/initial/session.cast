[273.407, "\u001b[H\r\u001b[2C\u001b[4BThe quick check passes.\u001b[27GRunnin\u001b[34G \u001b[36Gh\u001b[38G full check: all promp\u001b[61Gs and 64 tokens.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFull\u001b[8Gcheck\u001b[14Gpasses,\u001b[22Gwith\u001b[27Gmax\u001b[31Glogit\u001b[37Gerror\u001b[43Gabout\u001b[49G2e-5\u001b[54Gagainst\u001b[62Ga\u001b[64Gtolerance\u001b[74Gof\u001b[77G5e-4.\u001b[83GNext\u001b[88GI'm\u001b[92Gchecking\u001b[101GPIECE\u001b[107Gagainst\u001b[115Gthe\r\u001b[1B \u001b[3Gfixture pi\u001b[14Gces, edge cas\u001b[28Gs (context stop, chunk boundaries,\u001b[63Gbad\u001b[67Ginput) and timing.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfixtures\u001b[16Gmatch\u001b[22Gand\u001b[26Gdecoding\u001b[35Gruns\u001b[40Gat\u001b[43Gabout\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[1B \u001b[3Gand whether\u001b[16Ggemm be\u001b[24Gts sgemv at M=1.\u001b[41G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChunked\u001b[11Gan"]
[273.409, "d\u001b[15Gsequential\u001b[26Gpaths\u001b[32Gagree\u001b[38Gto\u001b[41G3.3e-5\u001b[48Gover\u001b[53G600\u001b[57Gpositions,\u001b[68Gwhich\u001b[74Gcrosses\u001b[82Gtwo\u001b[86Gchunk\u001b[92Gboundaries.\u001b[104GNow\u001b[108Gthe\u001b[112Gdecode\r\u001b[1B \u001b[3Gsp\u001b[6Ged\u001b[9Gexperiment:\u001b[21G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Sgemm at M=1 also reaches about 78 tok/s, so\u001b[48Gdecoding\u001b[57Gis\u001b[60Glimited\u001b[68Gby\u001b[71Gmemory\u001b[78Gbandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[2C\u001b[1Btest a layout change, storing the\u001b[37Gweights\u001b[45Gtransposed\u001b[56Gand\u001b[60Gcalling\u001b[68Gsgemv\u001b[74Gwith\u001b[79GTrans.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth layouts run at the\u001b[27Gsame\u001b[32G~34\u001b[36GGB/s,\u001b[42Gwhich\u001b[48Glooks\u001b[54Glike\u001b[59Gthe\u001b[63Gsingle-core\u001b[75Gmemory\u001b[82Gbandwidth\u001b[92Gceiling,\u001b[101Gso\u001b[104GI\u001b[106Gkept\u001b[111Gthe\r\u001b[2C\u001b[1Bcurrent layout. Last tuning step is the prefill chunk size:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mR"]
