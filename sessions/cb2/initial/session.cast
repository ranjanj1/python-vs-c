[332.21, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfix\u001b[11Gures match and decoding runs at\u001b[43Gabout\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[2C\u001b[1Band\u001b[7Gwhether\u001b[15Gsgemm\u001b[21Gbeats\u001b[27Gsgemv\u001b[33Gat\u001b[36GM=1.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChunked and s\u001b[17Gquential\u001b[26Gpaths\u001b[32Gagree\u001b[38Gto\u001b[41G3.3e-5\u001b[48Gover\u001b[53G600\u001b[57Gpositions,\u001b[68Gwhich\u001b[74Gcrosses\u001b[82Gtwo\u001b[86Gchunk\u001b[92Gboundaries.\u001b[104GNow\u001b[108Gthe\u001b[112Gdecode\r\u001b[2C\u001b[1Bspeed\u001b[9Gexperiment:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSgemm at M=1 also r\u001b[23Gaches abou\u001b[34G 78 tok/s,\u001b[45Gso dec\u001b[52Gding is\u001b[60Glimited\u001b[68Gby \u001b[72Gemory bandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[2C\u001b[1Btest\u001b[8Ga\u001b[10Glayout\u001b[17Gchange,\u001b[25Gstoring\u001b[33Gthe\u001b[37Gweights\u001b[45Gtransposed\u001b[56Gand\u001b[60Gcalling\u001b[68Gsgemv\u001b[74Gwith\u001b[79GTrans.\r\u001b[2C\u001b"]
[332.211, "[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth layouts run \u001b[21Gt the same ~34\u001b[36GGB/s, which \u001b[49Gooks like the\u001b[63Gsingle-core\u001b[75Gmemory\u001b[82Gbandwidth\u001b[92Gceiling,\u001b[101Gso\u001b[104GI\u001b[106Gkept\u001b[111Gthe\r\u001b[2C\u001b[1Bcurrent\u001b[11Glayout.\u001b[19GLast\u001b[24Gtuning\u001b[31Gstep\u001b[36Gis\u001b[39Gthe\u001b[43Gprefill\u001b[51Gchunk\u001b[57Gsize:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm s\u001b[9Gtting CHUNK to 512. That's\u001b[36Gabout\u001b[42G7%\u001b[45Gfaster\u001b[52Gat\u001b[55G1024\u001b[60Gtokens,\u001b[68Gand\u001b[72Gits\u001b[76Glogits\u001b[83Gbuffer\u001b[90Gis\u001b[93G65\u001b[96GMB.\u001b[100GThen\u001b[105GI'll\u001b[110Grebuild,\r\u001b[2C\u001b[1Bre-check,\u001b[13Gand\u001b[17Gwrite\u001b[23Gthe\u001b[27Gnotes.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Testing context-limit stop behaviour\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/\u001b[20Gb2t/ctx.py <<'EOF'\r\u001b[5C\u001b[1Bimport subprocess\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102m=\u001b[9Gubprocess.Pop\u001b[23Gn(['./cb2','model.bin','tokenizer.bin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)\r\u001b"]
