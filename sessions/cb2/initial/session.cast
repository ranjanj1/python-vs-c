[335.196, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mcb2.c\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[335.208, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSgemm at M=1 also reaches\u001b[29Gabout\u001b[35G78\u001b[38Gtok/s,\u001b[45Gso\u001b[48Gdecoding\u001b[57Gis\u001b[60Glimited\u001b[68Gby\u001b[71Gmemory\u001b[78Gbandwidth\u001b[88Gat\u001b[91Groughly\u001b[99G34\u001b[102GGB/s.\u001b[108GNext\u001b[113GI'll\r\u001b[2C\u001b[1Btest\u001b[8Ga\u001b[10Glayout\u001b[17Gchange,\u001b[25Gstoring\u001b[33Gthe\u001b[37Gweights\u001b[45Gtransposed\u001b[56Gand\u001b[60Gcalling\u001b[68Gsgemv\u001b[74Gwith\u001b[79GTrans.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth layouts run at the\u001b[27Gsame\u001b[32G~34\u001b[36GGB/s,\u001b[42Gwhich\u001b[48Glooks\u001b[54Glike\u001b[59Gthe\u001b[63Gsingle-core\u001b[75Gmemory\u001b[82Gbandwidth\u001b[92Gceiling,\u001b[101Gso\u001b[104GI\u001b[106Gkept\u001b[111Gthe\r\u001b[2C\u001b[1Bcurrent\u001b[11Glayout.\u001b[19GLast\u001b[24Gtuning\u001b[31Gstep\u001b[36Gis\u001b[39Gthe\u001b[43Gprefill\u001b[51Gchunk\u001b[57Gsize:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm setting CHUNK to\u001b[24G512.\u001b[29GThat's\u001b[36Gabout\u001b[42G7%\u001b[45Gfaster\u001b[52Gat\u001b[55G1024\u001b[60Gtokens,\u001b[68Gand\u001b[72Gits\u001b[76Glogits\u001b[83Gbuffer\u001b[90Gis\u001b[93G65\u001b[96GMB.\u001b[100GThen\u001b[105GI'll\u001b[110Grebuild,\r\u001b[2C"]
[335.209, "\u001b[1Bre-check,\u001b[13Gand\u001b[17Gwrite\u001b[23Gthe\u001b[27Gnotes.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mContext stopping behaves\u001b[28Gas\u001b[31Gintended.\u001b[41GNext\u001b[46GI'll\u001b[51Gtidy\u001b[56Ga\u001b[58Gstale\u001b[64Gcomment\u001b[72Gand\u001b[76Gwrite\u001b[82GNOTES.md.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(cb2.c)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mcb2.c\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[335.209, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 342 \u001b[22m     \u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m n;\r\u001b[1B\u001b[2m 343 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 344 \u001b[22m \r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 345 -\u001b[38;2;51;51;51m/* forward ids at 0..n-1, chunked; per chunk call sink(logits, first_row, rows) */                                \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 345 +\u001b[38;2;150;152;150m/* forward ids at 0..n-1 in chunks; write logits to f and/or record per-position argmax in am */\u001b[38;2;51;51;51m                  \r\u001b[1B\u001b[49m\u001b[2m 346 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mvoid\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mrun_fixed\u001b[38;2;0;134;179m(const int *ids, int n, FILE *f, int *am)\u001b[38;2;51;51;51m {\r\u001b[1B\u001b[2m 347 \u001b[22m     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m p0 = \u001b[38;2;0;134;179m0\u001b[38;2"]
[335.21, ";51;51;51m; p0 < n; p0 += CHUNK) {\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 348 \u001b[22m         \u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m c = n - p0 < CHUNK ? n - p0 : CHUNK;\u001b[39m\u001b[40;1H\u001b[36;2H"]
