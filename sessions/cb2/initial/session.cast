[371.221, "\u001b[H\u001b[3Gare\u001b[7Gin\u001b[10G\u001b[38;2;87;105;247mNOTES.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works\r\u001b[1B\u001b[22m \u001b[3G- \u001b[1mModel unchanged:\u001b[22m s\u001b[24Gm\u001b[26G float32 weights, architecture,\u001b[58GRoPE,\u001b[64GKV cache layout, greedy argmax\u001b[95G(lowest\u001b[103Gindex\u001b[109Gwins\u001b[114Gties)\r\u001b[4C\u001b[1Band\u001b[9Gstop\u001b[14Grules\u001b[20Gas\u001b[23Gthe\u001b[27Greference.\u001b[38GLogits\u001b[45Gare\u001b[49Gcomputed\u001b[58Gat\u001b[61Gevery\u001b[67Gposition,\u001b[77Gincluding\u001b[87Gthe\u001b[91Gforced\u001b[98Gprompt\u001b[105Gpositions\u001b[115Gin\r\u001b[1B \u001b[3G  GENERATE\u001b[14G\u001b[K\r\u001b[1B  - \u001b[1mWeight layout:\u001b[20G\u001b[22meach layer's weights\u001b[41Gare\u001b[45Gcopied\u001b[52Ginto\u001b[57Gone\u001b[61Galigned\u001b[69Gblock.\u001b[76GThe\u001b[80Gq/k/v\u001b[86Gmatrices\u001b[95Gare\u001b[99Gjoined\u001b[106Ginto\u001b[111Gone,\u001b[116Gand\r\u001b[4C\u001b[1Bso are w1/w3, so each\u001b[27Gtakes\u001b[33Ga\u001b[35Gsingle\u001b[42GAccelerate\u001b[53Gcall.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrompts, FIXED and LOGITS:\u001b[32G\u001b[22mtokens\u001b[39Gare\u001b[43Gprocessed\u001b[53Gin\u001b[56Ggroups\u001b[63Gof\u001b[66Gup\u001b[69Gto\u001b[72G512\u001b[76Gwith\u001b[81G\u001b[38;2;87;105;247mcblas_sgemm\u001b[39m.\u001b[94GAttention\u001b[104Galso\u001b[109Guses\u001b[114G\u001b[38;2;87;105;247msgemm\u001b[39m,\r\u001b[4C\u001b[1Bmasked s"]
[371.222, "o\u001b[15Geach\u001b[20Gposition\u001b[29Gonly\u001b[34Gsees\u001b[39Gitself\u001b[46Gand\u001b[50Gearlier\u001b[58Gpositions.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGenerating one token at a time:\u001b[22m uses \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther numeric steps:\u001b[22m norms, softmax and residual adds use vDSP/vForce; SwiGLU and RoPE are short plain-C loops\u001b[116Gwith\r\u001b[4C\u001b[1Bthe reference's formulas. No matrix loops are written by hand and no CPU\u001b[78Gintrinsics\u001b[89Gare\u001b[93Gused.\u001b[99GThe\u001b[103Gprogram\u001b[111Gnever\r\u001b[4C\u001b[1Bcreates threads or sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port of the reference.\u001b[K\r\u001b[2B \u001b[3G\u001b[1mExtra checks I ran (scripts kept in /tmp)\r\u001b[1B\u001b[22m  - PIECE output matches every \u001b[38;2;87;105;247mpieces\u001b[39G\u001b[39mentry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[2C\u001b[1B-\u001b[5GThe argmax from FIXED agrees with\u001b[39Gthe\u001b[43Gtoken\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[2C\u001b[1B-\u001b[5GProcessing\u001b[16G600\u001b[20Gpositions\u001b[30Gin\u001b[33Ggroups\u001b[40Ggives\u001b[46Gthe\u001b[50Gsame\u001b[55Glogits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b["]
[371.224, "91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[2C\u001b[1B-\u001b[5GThe \u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-token prompt gives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[6G    \u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GLoad to READY          \u2502 about 0.1 s       \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GGeneration\u001b[28G\u2502\u001b[30Gabout\u001b[36G79\u001b[39Gtokens/s\u001b[48G\u2502\r\u001b[1B \u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B  \u2502 FIXED with 1024 tokens \u2502"]
[371.224, " about 0.42 s      \u2502\u001b[K\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[1B\u001b[K\r\u001b[1B  Generation is limited by memory speed: it reads the weights at about 34 GB/s, the same as\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\u001b[40;1H\u001b[38;3H"]
[371.469, "\u001b[H\u001b[3G\u001b[1mHow it works\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mModel unchanged:\u001b[22G\u001b[22msame\u001b[27Gfloat32\u001b[35Gweights,\u001b[44Garchitecture,\u001b[58GRoPE,\u001b[64GKV\u001b[67Gcache\u001b[73Glayout,\u001b[81Ggreedy\u001b[88Gargmax\u001b[95G(lowest\u001b[103Gindex\u001b[109Gwins\u001b[114Gties)\r\u001b[2C\u001b[1B  and stop rules\u001b[20Gas\u001b[23Gthe\u001b[27Greference.\u001b[38GLogits\u001b[45Gare\u001b[49Gcomputed\u001b[58Gat\u001b[61Gevery\u001b[67Gposition,\u001b[77Gincluding\u001b[87Gthe\u001b[91Gforced\u001b[98Gprompt\u001b[105Gpositions\u001b[115Gin\r\u001b[2C\u001b[1B \u001b[5GGENERATE.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWeight layout:\u001b[20G\u001b[22meach lay\u001b[29Gr's weights are\u001b[45Gcopied in\u001b[55Go one\u001b[61Galigned block. The q/k/v matrices are j\u001b[101Gined into \u001b[113Ge, and\r\u001b[4C\u001b[1Bso are w1/w3,\u001b[19Gso\u001b[22Geach\u001b[27Gtakes\u001b[33Ga\u001b[35Gsingle\u001b[42GAccelerate\u001b[53Gcall.\r\u001b[4C\u001b[1B\u001b[1mPromp\u001b[11Gs, FIXED and LOGITS:\u001b[22m tokens are processed in groups of up\u001b[69Gto 512\u001b[76Gwith \u001b[38;2;87;105;247mcblas_sgemm\u001b[39m. Att\u001b[98Gntio\u001b[103G also uses \u001b[38;2;87;105;247msgemm\u001b[39m,\r\u001b[4C\u001b[1Bmasked\u001b[12Gso each position only sees itself and earlier positions.\r\u001b[4C\u001b[1B\u001b[1mGenerating one\u001b[20Gtoken at a time:\u001b[22m "]
[371.471, "uses \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther numeric steps:\u001b[22m norms, softmax and residu\u001b[52Gl adds u\u001b[61Ge vDSP/vForce;\u001b[76GSwiGLU\u001b[83Gand\u001b[87GRoPE\u001b[92Gare\u001b[96Gshort\u001b[102Gplain-C\u001b[110Gloops\u001b[116Gwith\r\u001b[2C\u001b[1B \u001b[5Gthe reference's formulas. No matrix loops are written\u001b[59Gby\u001b[62Ghand\u001b[67Gand\u001b[71Gno\u001b[74GCPU\u001b[78Gintrinsics\u001b[89Gare\u001b[93Gused.\u001b[99GThe\u001b[103Gprogram\u001b[111Gnever\r\u001b[2C\u001b[1B \u001b[5Gcreates threads or sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port of the refe\u001b[50Gnce.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GPIECE\u001b[11Goutput\u001b[18Gmatches\u001b[26Gevery\u001b[32G\u001b[38;2;87;105;247mpieces\u001b[39G\u001b[39mentry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[2C\u001b[1B- The argmax from FIXED agrees with the token\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[5C\u001b[1Brocessing 600 positions in groups gives the same logits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[8C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 10"]
[371.472, "16-\u001b[37Goken pr\u001b[45Gmpt\u001b[49Ggives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[28G\u253c\u001b[48G\u2524\r\u001b[4C\u001b[1BLoad\u001b[10Gto\u001b[13GREADY\u001b[30Gabout\u001b[36G0.1\u001b[40Gs\r\u001b[4C\u001b[2BGeneration   \u001b[36G79 tokens/s\r\u001b[4C\u001b[2BFIXED w\u001b[13Gth\u001b[16G1024\u001b[21Gtokens\u001b[36G0.42 s     \r\u001b[2C\u001b[1B\u2514\u001b[28G\u2534\u001b[48G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is limited by memory speed: it reads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere.\u001b[9GTrying\u001b[16G\u001b[38;2;87;105;247msgemm\u001b[22G\u001b[39minstead,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
