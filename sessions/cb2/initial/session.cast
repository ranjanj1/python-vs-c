[227.945, "7;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdint.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +451 lin\u001b[17Gs \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The quick check\u001b[19Gpasses.\u001b[27GRunning\u001b[35Gthe\u001b[39Gfull\u001b[44Gcheck:\u001b[51Gall\u001b[55Gprompts\u001b[63Gand\u001b[67G64\u001b[70Gtokens.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Full\u001b[8Gcheck passes, with max logit\u001b[37Gerror\u001b[43Gabout \u001b[50Ge-5 against a tolerance of 5e-4. Next I'm checking PIECE against\u001b[115Gthe\r\u001b[1C\u001b[1B fixture pie\u001b[15Ges,\u001b[19Gedge cases\u001b[30G(\u001b[32Gont\u001b[36Gxt stop, chunk boundaries, bad\u001b[67Ginput) and\u001b[78Gtiming.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All\u001b[7Gfixt\u001b[12Gres match and decoding runs at about 79 to"]
[227.947, "k/s; I'm now checking chunked prefill against single-token d\u001b[115Gcoding\r\u001b[1C\u001b[1B and\u001b[7Gwhether sgemm beats sgemv at M=1.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Comparing chunked prefill v\u001b[31G sequential decode\u001b[50Glogits\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed 's/#define CHUNK 256/#define CHUNK 1/' cb2.c > /tmp/cb2t/c1.c && cc -O3 -mcpu=native -o /tmp/cb2t/c1 \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m/tmp/cb2t/c1.c -framework Accelerate && cat > /tmp/cb2t/cmp.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport subprocess, array, sys\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mids=[1]+[(i*7919)%31000+500 for i in range(599)]\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mdef run(exe):\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mp=subprocess.Popen([exe,'mod\u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;234;138;106mPercolating\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(3m 33s \u00b7 \u2193\u001b[28G22.6k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m "]
