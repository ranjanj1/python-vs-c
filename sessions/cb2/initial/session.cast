[322.839, "2m def ask(s): p\u001b[18Gstdin.write(s+'\\n');\u001b[39Gp.stdin.f\u001b[49Gush(); return\u001b[63Gp.stdout.readline().rstrip('\\n')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gk\u001b[10Gin\u001b[13G(1015,\u001b[20G1030):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     txt=' '.join(['dog']*k);\u001b[33Gn=len(ask('ENCODE\u001b[51G'+txt).split())-1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write(f'GENERATE\u001b[33G50\u001b[36G{txt}\\n');\u001b[47Gp.stdin.flush();\u001b[64Gc=0\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G while (l:=p.s\u001b[22Gdout.readline()).s\u001b[41Gartswith('T '): c+=1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print('promp\u001b[21G tok\u001b[26Gns',n,'->',l.strip(),'(expect',max(0,1024-n+1)\u001b[73Gif\u001b[76Gn<=1024\u001b[84Gelse\u001b[89G0,'if\u001b[95Gno\u001b[98Gstop)')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('QUIT\\n');\u001b[29Gp.stdin.flush();\u001b[46Gp.wait()\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 /tmp/cb2t/ctx.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
