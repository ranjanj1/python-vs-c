[372.212, "\u001b[H\r\u001b[4C\u001b[34B\u001b[1mNumerics:\u001b[15G\u001b[22mresults\u001b[23Gdiffer\u001b[30Gslightly\u001b[39Gfrom\u001b[44Gthe\u001b[48Greference\u001b[58Gbecause\u001b[66GAccelerate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\u001b[40;1H\u001b[38;3H"]
[372.326, "\u001b[H\u001b[5Gso are w1/w3,\u001b[19Gso\u001b[22Geach\u001b[27Gtakes\u001b[33Ga\u001b[35Gsingle\u001b[42GAccelerate\u001b[53Gcall.\r\u001b[4C\u001b[1B\u001b[1mPromp\u001b[11Gs, FIXED and LOGITS:\u001b[22m tokens are processed in groups of up\u001b[69Gto 512\u001b[76Gwith \u001b[38;2;87;105;247mcblas_sgemm\u001b[39m. Att\u001b[98Gntio\u001b[103G also uses \u001b[38;2;87;105;247msgemm\u001b[39m,\r\u001b[4C\u001b[1Bmasked\u001b[12Gso each position only sees itself and earlier positions.\r\u001b[4C\u001b[1B\u001b[1mGenerating one\u001b[20Gtoken at a time:\u001b[22m uses \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther numeric steps:\u001b[22m norms, softmax and residu\u001b[52Gl adds u\u001b[61Ge vDSP/vForce;\u001b[76GSwiGLU\u001b[83Gand\u001b[87GRoPE\u001b[92Gare\u001b[96Gshort\u001b[102Gplain-C\u001b[110Gloops\u001b[116Gwith\r\u001b[2C\u001b[1B \u001b[5Gthe reference's formulas. No matrix loops are written\u001b[59Gby\u001b[62Ghand\u001b[67Gand\u001b[71Gno\u001b[74GCPU\u001b[78Gintrinsics\u001b[89Gare\u001b[93Gused.\u001b[99GThe\u001b[103Gprogram\u001b[111Gnever\r\u001b[2C\u001b[1B \u001b[5Gcreates threads or sets thread counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTokenizer:\u001b[22m a line-for-line port of the refe\u001b[50Gnce.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\u001b[22m\u001b[K\r\u001b[2"]
[372.328, "C\u001b[1B-\u001b[5GPIECE\u001b[11Goutput\u001b[18Gmatches\u001b[26Gevery\u001b[32G\u001b[38;2;87;105;247mpieces\u001b[39G\u001b[39mentry\u001b[45Gin\u001b[48Gthe\u001b[52Gfixtures.\r\u001b[2C\u001b[1B- The argmax from FIXED agrees with the token\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[5C\u001b[1Brocessing 600 positions in groups gives the same logits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[8C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-\u001b[37Goken pr\u001b[45Gmpt\u001b[49Ggives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[28G\u253c\u001b[48G\u2524\r\u001b[4C\u001b[1BLoad\u001b[10Gto\u001b[13GREADY\u001b[30Gabout\u001b[36G0.1\u001b[40Gs\r\u001b[4C\u001b[2BGeneration   \u001b[36G79 tokens/s\r\u001b[4C\u001b[2BFIXED w\u001b[13Gth\u001b[16G1024\u001b[21Gtokens\u001b[36G0.42 s     \r\u001b[2C\u001b[1B\u2514\u001b[28G\u2534\u001b[48G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is limited by memory speed: it reads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat"]
[372.329, "\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere.\u001b[9GTrying\u001b[16G\u001b[38;2;87;105;247msgemm\u001b[22G\u001b[39minstead,\u001b[31Gor\u001b[34Gstoring\u001b[42Gthe\u001b[46Gweights\u001b[54Gtransposed,\u001b[66Ggave\u001b[71Gno\u001b[74Ggain.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations and my own choices\u001b[34G\u001b[22m(INTERFACE.md doesn'\u001b[55G cover these cases)\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mNumer\u001b[11Gcs:\u001b[22m results differ slightly from the\u001b[48Greference b\u001b[60Gcaus\u001b[65G Ac\u001b[69Gel\u001b[72Grate\u001b[77Gsums\u001b[82Gin\u001b[85Ga\u001b[87Gdifferent\u001b[97Gorder.\u001b[104GOn\u001b[107Ga\u001b[109Gnear-tie,\r\u001b[4C\u001b[1Bgreedy\u001b[12Ggeneration\u001b[23Gcould\u001b[29Gin\u001b[32Gprinciple\u001b[42Gpick\u001b[47Ga\u001b[49Gdifferent\u001b[59Gtoken\u001b[65Gthan\u001b[70Gthe\u001b[74Greference.\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
