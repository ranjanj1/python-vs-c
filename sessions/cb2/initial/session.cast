[227.212, "\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAl\u001b[6G fixtures\u001b[16Gmatch\u001b[22Gand\u001b[26Gdecoding\u001b[35Gruns\u001b[40Gat\u001b[43Gabout\u001b[49G79\u001b[52Gtok/s;\u001b[59GI'm\u001b[63Gnow\u001b[67Gchecking\u001b[76Gchunked\u001b[84Gprefill\u001b[92Gagainst\u001b[100Gsingle-token\u001b[113Gdecoding\r\u001b[2C\u001b[1Band\u001b[7Gwhether\u001b[15Gsgemm\u001b[21Gbeats\u001b[27Gsgemv\u001b[33Gat\u001b[36GM=1.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Comparing chunked prefill vs\u001b[32Gsequential\u001b[43Gdecode\u001b[50Glogits\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed 's/#define CHUNK 256/#define CHUNK 1/' cb2.c > /tmp/cb2t/c1.c && cc -O3 -mcpu=native -o /tmp/cb2t/c1 \r\u001b[5C\u001b[1B/tmp/cb2t/c1.c -framework Accelerate && cat > /tmp/cb2t/cmp.py <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mimport subprocess, array, sys\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mids=[1]+[(i*7919)%31000+500 for i in range(599)]\r\u001b[5C\u001b[1Bdef run(exe):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp=subprocess.Popen([exe,'mod\u2026\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
