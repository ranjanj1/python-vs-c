[371.871, "\u001b[H\u001b[3G  GENERATE.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mWeight layout:\u001b[22m each layer's weights are cop\u001b[49Ged into one aligned block. The q/k/v mat\u001b[90Gices\u001b[95Gare joined into one, and\r\u001b[4C\u001b[1Bso are w1/w3, so each\u001b[27Gtak\u001b[31Gs a single Accel\u001b[48Grate call.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrompts, FIXED and LOGITS:\u001b[32G\u001b[22mtokens\u001b[39Gare\u001b[43Gprocessed\u001b[53Gin\u001b[56Ggroups\u001b[63Gof\u001b[66Gup\u001b[69Gto\u001b[72G512\u001b[76Gwith\u001b[81G\u001b[38;2;87;105;247mcblas_sgemm\u001b[39m.\u001b[94GAttention\u001b[104Galso\u001b[109Guses\u001b[114G\u001b[38;2;87;105;247msgemm\u001b[39m,\r\u001b[2C\u001b[1B \u001b[5Gmasked so each\u001b[20Gposition only sees itself and earlier posit\u001b[64Go\u001b[66Gs.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mGenerating one token at a time:\u001b[22m uses\u001b[42G\u001b[38;2;87;105;247mcblas_sgemv\u001b[39m.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mOther numeric steps:\u001b[22m norms, softmax and residual adds \u001b[60Gse\u001b[63GvDSP/vF\u001b[71Grce;\u001b[76GSwiGLU and RoPE are short pl\u001b[105Gin-C loops with\r\u001b[4C\u001b[1Bthe reference's formulas. No\u001b[34Gmatrix loops are w\u001b[53Gitten by hand and\u001b[71Gno\u001b[74GCPU\u001b[78Gintrinsics\u001b[89Gare\u001b[93Gused.\u001b[99GThe\u001b[103Gprogram\u001b[111Gnever\r\u001b[2C\u001b[1B \u001b[5Gcreate"]
[371.872, "s threads or sets thread counts.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTok\u001b[9Gnizer:\u001b[22m a line-for-line port of the reference.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra checks I ran (scripts kept in /tmp)\r\u001b[4C\u001b[1B\u001b[22mPIECE output\u001b[18Gmatches every\u001b[32G\u001b[38;2;87;105;247mpieces\u001b[39m entry in the fixtures.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gargmax\u001b[16Gfrom\u001b[21GFIXED\u001b[27Gagrees\u001b[34Gwith\u001b[39Gthe\u001b[43Gtoken\u001b[49Gids\u001b[53GGENERATE\u001b[62Gproduced.\r\u001b[2C\u001b[1B- Processing 600 positions in groups gives\u001b[46Gthe\u001b[50Gsame\u001b[55Glogits\u001b[62Gas\u001b[65Gdoing\u001b[71Gthem\u001b[76Gone\u001b[80Gat\u001b[83Ga\u001b[85Gtime,\u001b[91Gto\u001b[94Gwithin\u001b[101G3.3e-5.\r\u001b[4C\u001b[1BThe \u001b[38;2;87;105;247mcontext\u001b[39m stop works: a 1016-tok\u001b[41G prompt gives \u001b[38;2;87;105;247mDONE 9 context\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed on this machine\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                    \u001b[28G\u2502\u001b[48G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[371.874, "\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Load to READY          \u2502 about 0.1 s       \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Generation             \u2502 about 79 tokens/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED with 1024 tokens \u2502 about 0.42 s      \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BGeneration is limi\u001b[22Ged by\u001b[28Gmemory speed: it\u001b[45Greads\u001b[51Gthe\u001b[55Gweights\u001b[63Gat\u001b[66Gabout\u001b[72G34\u001b[75GGB/s,\u001b[81Gthe\u001b[85Gsame\u001b[90Gas\u001b[93Ga\u001b[95Gstandalone\u001b[106G\u001b[38;2;87;105;247msgemv\u001b[112G\u001b[39mbenchmark\r\u001b[2C\u001b[1Bhere. Trying \u001b[38;2;87;105;247msgemm\u001b[39m instead, or storing the weights\u001b[54Gtransposed,\u001b[66Gg"]
