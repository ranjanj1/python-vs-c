[199.653, "\u001b[H\u001b[3GAll\u001b[7Gf\u001b[9Gur\u001b[12Gk\u001b[14Grn\u001b[17Gl\u001b[19Gvariants come in within the base\u001b[52Gine's\u001b[58G\u00b11\u20132% noise, so non\u001b[78G is a real gain and n\u001b[100G kernel \u001b[109Ghange wil\u001b[119G\u001b[K\r\u001b[2C\u001b[1Bbe adopted. Startup\u001b[23Gbefore\u001b[30GREADY,\u001b[37Gabout\u001b[43G100\u001b[47Gms,\u001b[51Gis\u001b[54Gthe\u001b[58Gone\u001b[62Gremaining\u001b[72Gslack,\u001b[79Gand\u001b[83GI'm\u001b[87Gprofiling\u001b[97Gthe\u001b[101Gload\u001b[106Gphases\u001b[113Gto\u001b[116Gcheck\r\u001b[2C\u001b[1Bthe\u001b[7Gmmap\u001b[12Gpage\u001b[17Gfaults\u001b[24Gand\u001b[28Gthe\u001b[32G\u001b[38;2;87;105;247mmemset\u001b[39G\u001b[39mon\u001b[42Gthe\u001b[46Gpacked\u001b[53Gbuffer.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm-cache startup sp\u001b[25Gnds 28\u201330 ms zeroing a packed buffer\u001b[62Gthat packing overwrites anyway, plus 52\u201365 ms packing\u001b[116Gfrom\u001b[K\r\u001b[11C\u001b[1Band abo\u001b[20Gt 5.5 ms z\u001b[31Groing the KV cache. I'm skipping\u001b[64Gthat\u001b[69Gzeroing\u001b[77Gand\u001b[81Greading\u001b[89Gthe\u001b[93Gcheckpoint\u001b[104Gwith\u001b[109Gpread\u001b[115Gin\r\u001b[2C\u001b[1BL2-sized\u001b[12Gchunks\u001b[19Ginstead,\u001b[28Gto\u001b[31Gavoid\u001b[37Gthe\u001b[41G"]
