[202.675, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm\u001b[8Gstartup\u001b[16Gis\u001b[19Gnow\u001b[23Groughly\u001b[31G71\u201380\u001b[37Gms\u001b[40Gfor\u001b[44Gread-and-pack\u001b[58Gplus\u001b[63G5\u20138\u001b[67Gms\u001b[70Gfor\u001b[74Gallocations,\u001b[87Gdown\u001b[92Gfrom\u001b[97G90\u2013100\u001b[104Gms,\u001b[108Gsince\r\u001b[1B \u001b[3Gpage-fault \u001b[15Gost moved\u001b[25Ginto\u001b[30Gthe\u001b[34Gpack\u001b[39Gstep.\u001b[45GNext\u001b[50GI'll\u001b[55Gmeasure\u001b[63Gend-to-end\u001b[74Gtime\u001b[79Gto\u001b[82GREADY\u001b[88Gand\u001b[92Gtest\u001b[97Gwhether\u001b[105Ga\u001b[107Glarger\u001b[114Gstaging\r\u001b[1B  buffer helps.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup to READY now runs a median 82\u201391 ms with 1\u20132 MB staging, so I'm keeping 2 MB. I'm switching the 75 MB KV\u001b[116Gcache\r\u001b[2C\u001b[1Bto\u001b[6Gcalloc, since fresh pages are already zero and the cost shifts to the few page faults on the positions actually\r\u001b[2C\u001b[1Bused.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[1B\u001b[38;2;102;"]
