[199.631, "2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm-cache\u001b[14Gstartup\u001b[22Gspends\u001b[29G28\u201330\u001b[35Gms\u001b[38Gzeroing\u001b[46Ga\u001b[48Gpacked\u001b[55Gbuffer\u001b[62Gthat\u001b[67Gpacking\u001b[75Goverwrites\u001b[86Ganyway,\u001b[94Gplus\u001b[99G52\u201365\u001b[105Gms\u001b[108Gpacking\u001b[116Gfrom\r\u001b[2C\u001b[1Bthe mmap and about 5.5 ms zeroing the KV cache.\u001b[51GI'm\u001b[55Gskipping\u001b[64Gthat\u001b[69Gzeroing\u001b[77Gand\u001b[81Greading\u001b[89Gthe\u001b[93Gcheckpoint\u001b[104Gwith\u001b[109Gpread\u001b[115Gin\r\u001b[2C\u001b[1BL2-sized\u001b[12Gchunks\u001b[19Ginstead,\u001b[28Gto\u001b[31Gavoid\u001b[37Gthe\u001b[41Gpage\u001b[46Gfaults.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[37G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm\u001b[8Gstartup\u001b[16Gis\u001b[19Gnow\u001b[23Groughly\u001b[31G71\u201380\u001b[37Gms\u001b[40Gfor\u001b[44Gread-and-pack\u001b[58Gplus\u001b[63G5\u20138\u001b[67Gms\u001b[70Gfor\u001b[74Gallocations,\u001b[87Gdown\u001b[92Gfrom\u001b[97G90\u2013100\u001b[104Gms,\u001b[108Gsince\r\u001b[2C\u001b[1Bpage-fault cost moved into the pack\u001b[39Gstep.\u001b[45GNext\u001b[50GI'll\u001b[55Gmeasure\u001b[63Gend-to-end\u001b[74Gtime\u001b[79Gto\u001b[82GREADY\u001b[88Gand\u001b[92Gtest\u001b[97Gwhether\u001b[105Ga\u001b[107Glarger\u001b[114Gstaging\r\u001b[2C\u001b[1Bbuffer\u001b[10Ghelps.\r\u001b[1B\u001b[K\r\u001b[2"]
[199.632, "C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gto\u001b[14GREADY\u001b[20Gnow\u001b[24Gruns\u001b[29Ga\u001b[31Gmedian\u001b[38G82\u201391\u001b[44Gms\u001b[47Gwith\u001b[52G1\u20132\u001b[56GMB\u001b[59Gstaging,\u001b[68Gso\u001b[71GI'm\u001b[75Gkeeping\u001b[83G2\u001b[85GMB.\u001b[89GI'm\u001b[93Gswitching\u001b[103Gthe\u001b[107G75\u001b[110GMB\u001b[113GKV\u001b[116Gcache\r\u001b[2C\u001b[1Bto calloc, since fresh\u001b[26Gpages\u001b[32Gare\u001b[36Galready\u001b[44Gzero\u001b[49Gand\u001b[53Gthe\u001b[57Gcost\u001b[62Gshifts\u001b[69Gto\u001b[72Gthe\u001b[76Gfew\u001b[80Gpage\u001b[85Gfaults\u001b[92Gon\u001b[95Gthe\u001b[99Gpositions\u001b[109Gactually\r\u001b[2C\u001b[1Bused.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[38;3H"]
