[175.584, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfour\u001b[12Gkernel\u001b[19Gvariants\u001b[28Gcome\u001b[33Gin\u001b[36Gwithin\u001b[43Gthe\u001b[47Gbaseline's\u001b[58G\u00b11\u20132%\u001b[64Gnoise,\u001b[71Gso\u001b[74Gnone\u001b[79Gis\u001b[82Ga\u001b[84Greal\u001b[89Ggain\u001b[94Gand\u001b[98Gno\u001b[101Gkernel\u001b[108Gchange\u001b[115Gwill\r\u001b[2C\u001b[1Bbe\u001b[6Gadopted.\u001b[15GStartup\u001b[23Gbefore\u001b[30GREADY,\u001b[37Gabout\u001b[43G100\u001b[47Gms,\u001b[51Gis\u001b[54Gthe\u001b[58Gone\u001b[62Gremaining\u001b[72Gslack,\u001b[79Gand\u001b[83GI'm\u001b[87Gprofiling\u001b[97Gthe\u001b[101Gload\u001b[106Gphases\u001b[113Gto\u001b[116Gcheck\r\u001b[2C\u001b[1Bthe mmap page faults\u001b[24Gand\u001b[28Gthe\u001b[32G\u001b[38;2;87;105;247mmemset\u001b[39G\u001b[39mon\u001b[42Gthe\u001b[46Gpacked\u001b[53Gbuffer.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm-cache startup spen\u001b[28G 28\u201330 ms zeroing a packed buffer\u001b[62Gthat\u001b[67Gpacking\u001b[75Goverwrites\u001b[86Ganyway,\u001b[94Gplus\u001b[99G52\u201365\u001b[105Gms\u001b[108Gpacking\u001b[116Gfrom\r\u001b[2C\u001b[1Bthe\u001b[7Gmmap\u001b[12Gand\u001b[16Gabout\u001b[22G5.5\u001b[26Gms\u001b[29Gzeroing\u001b[37Gthe\u001b[41GKV\u001b[44Gcache.\u001b[51GI'm\u001b[55Gskipping\u001b[64Gthat\u001b[69Gzeroing\u001b[77Gand\u001b[81Greading\u001b[89Gth"]
