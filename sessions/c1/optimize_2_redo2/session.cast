[235.483, "\u001b[H\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m5\u001b[22m lines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[12G\u001b[22m    x = xalloc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); xb = xalloc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); xb2 = xalloc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\r\u001b[8C\u001b[1B\u001b[2m6\u001b[16G\u001b[22mhb = xa\u001b[24Gloc(h * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); hb2\u001b[40G= xalloc(h\u001b[51G* \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); q\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 307 -\u001b[38;2;51;51;51m    key_cache = xalloc(L * cfg.seq_len * kv_dim * 4);                                                 \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m8\u001b[16G\u001b[38;2;51;51;51mvalue_\u001b[23Gache\u001b[28G= xalloc(L\u001b[39G* cfg.seq_len\u001b[53G* kv_dim\u001b[62G* 4);\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 307 +\u001b[38;2;51;51;51m    \u001b[38;2;150;152;150m/* zero-initialised like the reference's calloc; for large sizes calloc\u001b[38;2;51;51;51m     "]
[235.483, "                      \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[16G\u001b[38;2;51;51;51m * hands out fresh zero pages, so only the pages actually used get touched */                     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[16G\u001b[38;2;51;51;51mkey_cache = \u001b[38;2;0;134;179mcalloc\u001b[38;2;51;51;51m(L * cfg.seq_len * kv_dim, \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m));                                      \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m10\u001b[16G\u001b[38;2;51;51;51mvalue_\u001b[23Gache\u001b[28G= \u001b[38;2;0;134;179mcalloc\u001b[38;2;51;51;51m(L\u001b[39G* cfg.seq_len\u001b[53G* kv_dim, \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m));\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m1\u001b[16G\u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m (!key_cache || !value_\u001b[42Gache) { \u001b[38;2;0;134;179mfprintf\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mstderr\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"alloc failed\\n\"\u001b[38;2;51;51;51m);\u001b[85G\u001b[38;2;0;134;179mexit\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m);\u001b[94G}\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 312 \u001b[22m     kcur = xalloc(kv_dim * \u001b[38;2;0"]
[235.484, ";134;179m4\u001b[38;2;51;51;51m); vcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[16G\u001b[22matt = xal\u001b[26Goc(\u001b[30G\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.n_heads * cfg.seq_len * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[16G\u001b[22mlogits = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.vocab_size * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's\u001b[11Gmedian\u001b[18Gis\u001b[21Gdown\u001b[26Gto\u001b[29G78\u001b[32Gms\u001b[35Gand\u001b[39GKV\u001b[42Gallocation\u001b[53Gto\u001b[56G0.1\u001b[60Gms,\u001b[64Gbut\u001b[68Gthe\u001b[72Gdev-workload\u001b[85Gprofile\u001b[93Grose\u001b[98Gslightly\u001b[107Gto\u001b[110G2178\u20132286\r\u001b[1B \u001b[3Gms and on\u001b[13G load \u001b[20Gpiked\u001b[29G153 ms, so the ma\u001b[47Ghine may\u001b[56Gbe noisy. I'm checking the per-section numbers \u001b[104Go see\u001b[110Gwhether the\r\u001b[2C\u001b[1BKV\u001b[6Gpage fau\u001b[15Gts shift\u001b[26Gc\u001b[28Gst into the\u001b[40Gforward pass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b["]
[235.485, "1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7GKV\u001b[10Gpage\u001b[15Gfaults\u001b[22Gadd\u001b[26Gonly\u001b[31Gabout\u001b[37G1\u001b[39Gms\u001b[42Gover\u001b[47G289\u001b[51Gforwards,\u001b[61Gso\u001b[64Gthe\u001b[68Gmatmuls\u001b[76Gmust\u001b[81Gexplain\u001b[89Gthe\u001b[93Gdrift,\u001b[100Gwhich\u001b[106Gis\u001b[109Gprobably\r\u001b[1B \u001b[3Gsystem\u001b[10Gnoise. I'm now ru\u001b[28Gning the\u001b[37Gearlier build\u001b[51G(/tmp/c1v3/A) interleaved wi\u001b[80Gh the current one to confirm.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mInterleave\u001b[14Gold\u001b[18Gand\u001b[22Gnew\u001b[26Gbuilds\u001b[33Gon\u001b[36Gdev\u001b[40Gworkload\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ for r in 1 2 3; do for b in /tmp/c1v3/A ./run_c1_prof; do printf \"%-14s %s\\n\" $b \"$(python3 check.py --tokens 64 \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m--prompts 3 --\u001b[21G$b\u001b[24G2>&1 |\u001b[31Ggrep\u001b[36G-E 'PROFILE|PASS|FAIL' | tr '\\n' ' ')\u001b[74G; done; done (3s \u00b7 2 li\u001b[98Ges)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ct\u001b[10Gl+b to run\u001b[21Gin\u001b[24Gbackground)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
