[22.102, "\u001b[H\u001b[5GTwo code paths this model doesn't use give\u001b[48Gresults\u001b[56Gidentical to the normal build:\u001b[87Ga\u001b[89Gcheckpoint\u001b[100Gwith\u001b[105Ga\u001b[107Gseparate\r\u001b[2C\u001b[1B \u001b[5Gclassifier, an\u001b[21Gthe fallback\u001b[34Gfor\u001b[38Gshapes\u001b[45Gthat\u001b[50Gcan't\u001b[56Gbe\u001b[59Grepacked.\r\u001b[2C\u001b[2B\u001b[1mLimitations:\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLittle headroom left.\u001b[27G\u001b[22mSpeed\u001b[33Gis\u001b[36Gnow\u001b[40Gset\u001b[44Gby\u001b[47Gmemory\u001b[54Gbandwidth,\u001b[65Gabout\u001b[71G60\u001b[74Gof\u001b[77G62\u001b[80GGB/s.\u001b[86GBigger\u001b[93Ggains\u001b[99Gwould\u001b[105Gneed\u001b[110Gfewer\u001b[116Gbytes\r\u001b[2C\u001b[1B  p\u001b[7Gr\u001b[9Gtoken or more cores, and the rules\u001b[44Gforbid\u001b[51Gboth.\r\u001b[4C\u001b[1B\u001b[1mPrompt batching still off.\u001b[32G\u001b[22mProcessing\u001b[43Gall\u001b[47Gprompt\u001b[54Gtokens\u001b[61Gtogether\u001b[70Gwould\u001b[76Gspeed\u001b[82Gup\u001b[85GFIXED,\u001b[92GLOGITS\u001b[99Gand\u001b[103Gprompt\u001b[110Ghandling\u001b[119Ga\r\u001b[2C\u001b[1B \u001b[5Glot. I still\u001b[18Ghaven't\u001b[26Gdone\u001b[31Git,\u001b[35Gbecause\u001b[43Gthe\u001b[47Grules\u001b[53Gsay\u001b[57Gbatch\u001b[63Gsize\u00a01.\r\u001b[4C\u001b[1B\u001b[1mReordered memory layout is a judgement call.\u001b[50G\u001b[22mI\u001b[52Gconsider\u001b[61Gthe\u001b[65Grepacked\u001b[74Gweights\u001b[82Gand\u001b[86Gthe\u001b[90Gh"]
