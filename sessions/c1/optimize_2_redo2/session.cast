[201.881, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22m./build.sh && ./build.sh profile && for i in 1 2 3; do echo QUIT |\u001b[71G./run_c1_prof\u001b[85Gmodel.bin\u001b[95Gtokenizer.bin\u001b[109G2>&1\u001b[114G|\u001b[116Ggrep\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-E \"LOAD (read|alloc\\+zero)\" | tr -s ' ' | tr '\\n' ';'; echo; done;\u001b[72Gfor\u001b[76Gr\u001b[78Gin\u001b[81G1\u001b[83G2;\u001b[86Gdo\u001b[89Gpython3\u001b[97G-I\u001b[100Gtests/loadtime.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"$PWD\" ./run_c1; done; for i in 1 2 3; do python3 check.py\u001b[63G--tokens\u001b[72G64\u001b[75G--prompts\u001b[85G3\u001b[87G--\u001b[90G./run_c1_prof\u001b[104G2>&1\u001b[109G|\u001b[111Ggrep\u001b[116G-E\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"PROFILE|PASS|FAIL\"\u001b[24G|\u001b[26Gtr\u001b[29G'\\n'\u001b[34G'\u001b[36G';\u001b[39Gecho;\u001b[45Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
