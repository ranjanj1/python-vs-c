[174.035, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[39m\u001b[40;1H\u001b[38;3H"]
[174.075, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gbaseline\u001b[16Gholds\u001b[22Gsteady\u001b[29Gat\u001b[32G2146\u20132183\u001b[42Gms\u001b[45Gwith\u001b[50Gmatmuls\u001b[58Gat\u001b[61G96.8%\u001b[67Gand\u001b[71Gabout\u001b[77G60\u001b[80GGB/s,\u001b[86Gleaving\u001b[94Groughly\u001b[102G3%\u001b[105Gof\u001b[108Gheadroom\r\u001b[2C\u001b[1Bunder the 62 GB/s ceiling. Next I'll try three\u001b[50Gcheap\u001b[56Gkernel\u001b[63Gtweaks:\u001b[71Gunrolling\u001b[81Gtwo\u001b[85G16-column\u001b[95Gblocks\u001b[102Gper\u001b[106Giteration,\r\u001b[2C\u001b[1Bnon-temporal\u001b[16Gweight\u001b[23Gloads,\u001b[30Gand\u001b[34Gpaired\u001b[41G32-byte\u001b[49Gloads.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe loop header also\u001b[24Gappears\u001b[32Gin\u001b[35Gthe\u001b[39Grow-major\u001b[49Gfallback\u001b[58Gkernel,\u001b[66Gso\u001b[69Git\u001b[72Gmatched\u001b[80Gtwice.\u001b[87GI'll\u001b[92Ganchor\u001b[99Gon\u001b[102Gthe\u001b[106Gpacked\u001b[113Gkernel's\r\u001b[2C\u001b[1Bspecific\u001b[12Glines.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfour"]
[174.076, "\u001b[12Gkernel\u001b[19Gvariants\u001b[28Gcome\u001b[33Gin\u001b[36Gwithin\u001b[43Gthe\u001b[47Gbaseline's\u001b[58G\u00b11\u20132%\u001b[64Gnoise,\u001b[71Gso\u001b[74Gnone\u001b[79Gis\u001b[82Ga\u001b[84Greal\u001b[89Ggain\u001b[94Gand\u001b[98Gno\u001b[101Gkernel\u001b[108Gchange\u001b[115Gwill\r\u001b[2C\u001b[1Bbe adopted. Startup before READY, about 100 ms,\u001b[51Gis\u001b[54Gthe\u001b[58Gone\u001b[62Gremaining\u001b[72Gslack,\u001b[79Gand\u001b[83GI'm\u001b[87Gprofiling\u001b[97Gthe\u001b[101Gload\u001b[106Gphases\u001b[113Gto\u001b[116Gcheck\r\u001b[2C\u001b[1Bthe\u001b[7Gmmap\u001b[12Gpage\u001b[17Gfaults\u001b[24Gand\u001b[28Gthe\u001b[32G\u001b[38;2;87;105;247mmemset\u001b[39G\u001b[39mon\u001b[42Gthe\u001b[46Gpacked\u001b[53Gbuffer.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm-cache\u001b[14Gstartup\u001b[22Gspends\u001b[29G28\u201330\u001b[35Gms\u001b[38Gzeroing\u001b[46Ga\u001b[48Gpacked\u001b[55Gbuffer\u001b[62Gthat\u001b[67Gpacking\u001b[75Goverwrites\u001b[86Ganyway,\u001b[94Gplus\u001b[99G52\u201365\u001b[105Gms\u001b[108Gpacking\u001b[116Gfrom\r\u001b[1B \u001b[3Gthe mmap and about 5.5 ms zeroing the KV cache.\u001b[51GI'\u001b[54G skipping\u001b[64Gthat\u001b[69Gzeroing\u001b[77Gand\u001b[81Greading\u001b[89Gthe\u001b[93Gcheckpoint\u001b[104Gwith\u001b[109Gpread\u001b[115Gin\r\u001b[1B  L"]
[174.077, "2-sized chunks instead, to\u001b[31Gavoid\u001b[37Gthe\u001b[41Gpage\u001b[46Gfaults.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, \u001b[17Gan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm startup is now roughly 71\u201380 ms for read-and-pack\u001b[58Gplus\u001b[63G5\u20138\u001b[67Gms\u001b[70Gfor\u001b[74Gallocations,\u001b[87Gdown\u001b[92Gfrom\u001b[97G90\u2013100\u001b[104Gms,\u001b[108Gsince\r\u001b[2C\u001b[1Bpage-fault cost moved into the pack step. Next I'll measure\u001b[63Gend-to-end\u001b[74Gtime\u001b[79Gto\u001b[82GREADY\u001b[88Gand\u001b[92Gtest\u001b[97Gwhether\u001b[105Ga\u001b[107Glarger\u001b[114Gstaging\r\u001b[2C\u001b[1Bbuffer helps.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m2\u001b[30G4\u001b[39m\u001b[40;1H\u001b[38;3H"]
[174.089, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 6s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
