[255.558, "median\u001b[18Gis\u001b[21Gdown\u001b[26Gto\u001b[29G78\u001b[32Gms\u001b[35Gand\u001b[39GKV\u001b[42Gallocation\u001b[53Gto\u001b[56G0.1\u001b[60Gms,\u001b[64Gbut\u001b[68Gthe\u001b[72Gdev-workload\u001b[85Gprofile\u001b[93Grose\u001b[98Gslightly\u001b[107Gto\u001b[110G2178\u20132286\r\u001b[1B \u001b[3Gms and on\u001b[13G load \u001b[20Gpiked\u001b[29G153 ms, so the ma\u001b[47Ghine may\u001b[56Gbe noisy. I'm checking the per-section numbers \u001b[104Go see\u001b[110Gwhether the\r\u001b[2C\u001b[1BKV\u001b[6Gpage fau\u001b[15Gts shift\u001b[26Gc\u001b[28Gst into the\u001b[40Gforward pass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7GKV\u001b[10Gpage\u001b[15Gfaults\u001b[22Gadd\u001b[26Gonly\u001b[31Gabout\u001b[37G1\u001b[39Gms\u001b[42Gover\u001b[47G289\u001b[51Gforwards,\u001b[61Gso\u001b[64Gthe\u001b[68Gmatmuls\u001b[76Gmust\u001b[81Gexplain\u001b[89Gthe\u001b[93Gdrift,\u001b[100Gwhich\u001b[106Gis\u001b[109Gprobably\r\u001b[1B \u001b[3Gsystem\u001b[10Gnoise. I'm now ru\u001b[28Gning the\u001b[37Gearlier build\u001b[51G(/tmp/c1v3/A) interleaved wi\u001b[80Gh the current one to confirm.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcurrent\u001b[15Gbuild\u001b[21Gma"]
[255.559, "tches\u001b[29Gor\u001b[32Gslightly\u001b[41Gbeats\u001b[47Gthe\u001b[51Gearlier\u001b[59Gone\u001b[63Gin\u001b[66Ginterleaved\u001b[78Gruns,\u001b[84Gso\u001b[87Gthe\u001b[91Gearlier\u001b[99Gdrift\u001b[105Gwas\u001b[109Gmachine\r\u001b[1B \u001b[3Gnoise. I'm running the full regression suite on\u001b[51Gthe final code\u001b[66Gnext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mFull\u001b[8Gregression\u001b[19Gsuite\u001b[25Gon\u001b[28Gfinal\u001b[34Gcode\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ ./build.sh && python3 check.py\u001b[39G-- ./run_c1 | tail -1 && python3 check.py --tokens 64 --prompts 3 -- ./run_c1 | \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mgrep -E \"error|PASS|FAIL\" | sort\u001b[40Gk5 -g | tail\u001b[53G-2 && python3 -I tests/difftes\u001b[84G.py \"$PWD\" && py\u001b[101Ghon3 \u001b[107GI \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mtests/longctx.py \"$PWD\" 1024 && python3\u001b[46G-I tests/contex\u001b[62G.py \"$PWD\" && mkdir -p /tmp\u2026 (3s\u001b[95G\u00b7 2 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
