[251.917, "\u001b[H\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's median is down to 78 ms and KV allocation to 0.1 ms, but the dev-workload\u001b[85Gprofile\u001b[93Grose\u001b[98Gslightly\u001b[107Gto\u001b[110G2178\u20132286\r\u001b[2C\u001b[1Bms\u001b[6Gand one load spiked to 153 ms, so the machine may be noisy. I'm checking\u001b[79Gthe\u001b[83Gper-section\u001b[95Gnumbers\u001b[103Gto\u001b[106Gsee\u001b[110Gwhether\u001b[118Gthe\r\u001b[2C\u001b[1BKV\u001b[6Gpage faults shifted cost into the forward pass.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe KV page faults add only about 1 ms over 289 forwards, so the matmuls must explain the drift, which is probably\r\u001b[2C\u001b[1Bsystem noise. I'm now running the earlier build (/tmp/c1v3/A) interleaved with the current one to confirm.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe current build matches or slightly beats the earlier one\u001b[63Gin\u001b[66Ginterleaved\u001b[78Gruns,\u001b[84Gso\u001b[87Gthe\u001b[91Gearlier\u001b[99Gdrift\u001b[105Gwas\u001b"]
[251.918, "[109Gmachine\r\u001b[2C\u001b[1Bnoise.\u001b[10GI'm\u001b[14Grunning\u001b[22Gthe\u001b[26Gfull\u001b[31Gregression\u001b[42Gsuite\u001b[48Gon\u001b[51Gthe\u001b[55Gfinal\u001b[61Gcode\u001b[66Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ./build.sh && python3 check.py -- ./run_c1 | tail -1 && python3 check.py --tokens 64 --prompts 3 -- ./run_c1 | \r\u001b[2C\u001b[1B\u001b[39m  \u001b[6G\u001b[38;2;102;102;102mgrep -E \"error|PASS|FAIL\" | sort -k5 -g | tail -2 && python3 -I tests/difftest.py \"$PWD\" && python3 -I \u001b[110G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;102;102;102mtests/longctx.py \"$PWD\" 1024 && python3 -I tests/context.py \"$PWD\" && mkdir -p /tmp\u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
