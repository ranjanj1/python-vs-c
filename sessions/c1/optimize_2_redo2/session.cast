[225.714, "\u001b[20G down\u001b[29G78 ms and KV allo\u001b[47Gation to\u001b[56G0.1 ms, but the dev-workload profile rose sligh\u001b[104Gly to\u001b[110G2178\u20132286\u001b[K\r\u001b[2C\u001b[1Bms\u001b[6Gand one \u001b[15Goad spik\u001b[26Gt\u001b[28G 153 ms, so\u001b[40Gthe machine may\u001b[56Gbe\u001b[59Gnoisy.\u001b[66GI'm\u001b[70Gchecking\u001b[79Gthe\u001b[83Gper-section\u001b[95Gnumbers\u001b[103Gto\u001b[106Gsee\u001b[110Gwhether\u001b[118Gthe\r\u001b[2C\u001b[1BKV\u001b[6Gpage\u001b[11Gfaults\u001b[18Gshifted\u001b[26Gcost\u001b[31Ginto\u001b[36Gthe\u001b[40Gforward\u001b[48Gpass.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Rechecking profile sections for KV page-fault cost\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2 3; do python3 check.py --tokens\u001b[53G64 --prompts 3\u001b[68G-- ./run_c1_prof\u001b[85G2>&1 | grep -E \r\u001b[5C\u001b[1B\"PROFILE|rope|attention|PASS|FAIL\" | tr -s ' ' | tr '\\n' ';'; echo; done\u001b[39m\u001b[40;1H\u001b[38;3H"]
