[405.265, "34;179m4\u001b[38;2;51;51;51m);\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's m\u001b[13Gdian i\u001b[20G down\u001b[29G78 ms and KV allo\u001b[47Gation to\u001b[56G0.1 ms, but the dev-workload profile rose sligh\u001b[104Gly to\u001b[110G2178\u20132286\u001b[K\r\u001b[2C\u001b[1Bms\u001b[6Gand one \u001b[15Goad spik\u001b[26Gt\u001b[28G 153 ms, so\u001b[40Gthe machine may\u001b[56Gbe\u001b[59Gnoisy.\u001b[66GI'm\u001b[70Gchecking\u001b[79Gthe\u001b[83Gper-section\u001b[95Gnumbers\u001b[103Gto\u001b[106Gsee\u001b[110Gwhether\u001b[118Gthe\r\u001b[2C\u001b[1BKV\u001b[6Gpage\u001b[11Gfaults\u001b[18Gshifted\u001b[26Gcost\u001b[31Ginto\u001b[36Gthe\u001b[40Gforward\u001b[48Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe KV\u001b[10Gpage faults add o\u001b[28Gly about\u001b[37G1 ms over 289\u001b[51Gforwards, so the matmuls mus\u001b[80G explain the drift, which is probably\r\u001b[2C\u001b[1Bsystem\u001b[10Gnoise.\u001b[17GI'm\u001b[21Gnow\u001b[25Grunning\u001b[33Gthe\u001b[37Gearlier\u001b[45Gbuild\u001b[51G(/tmp/c1v3/A)\u001b[65Ginterleaved\u001b[77Gwith\u001b[82Gthe\u001b[86Gcurrent\u001b[94Gone\u001b[98Gto\u001b[101Gconfirm.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;1"]
