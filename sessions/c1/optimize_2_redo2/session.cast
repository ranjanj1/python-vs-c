[231.112, ";24;54;145m\"alloc failed\\n\"\u001b[38;2;51;51;51m); \u001b[38;2;0;134;179mexit\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m); }                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 312 \u001b[22m     kcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); vcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 313 \u001b[22m     att = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.n_heads * cfg.seq_len * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 314 \u001b[22m     logits = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.vocab_size * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's\u001b[11Gmedian\u001b[18Gis\u001b[21Gdown\u001b[26Gto\u001b[29G78\u001b[32Gms\u001b[35Gand\u001b[39GKV\u001b[42Gallocation\u001b[53Gto\u001b[56G0.1\u001b[60Gms,\u001b[64Gbut\u001b[68Gthe\u001b[72Gdev-workload\u001b[85Gprofile\u001b[93Grose\u001b[98Gslightly\u001b[107Gto\u001b[110G2178\u20132286\r\u001b[2C\u001b[1Bms and one load spiked\u001b[26Gto\u001b[29G153\u001b[33Gms,\u001b[37Gso\u001b[40Gthe\u001b[4"]
