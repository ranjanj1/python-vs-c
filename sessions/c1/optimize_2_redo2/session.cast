[109.745, "\u001b[H\u001b[3G-\u001b[5GNOTES.md\r\u001b[2C\u001b[1B-\u001b[5Grun_c1.c\r\u001b[1B \u001b[3G- build.sh\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mWorked for 1m 12s \u00b7 done 3:01 PM\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfil\u001b[10G \u001b[12Ghis implementation on th\u001b[37G supplied development workloads. Improve performa\u001b[87Gce with\u001b[95Gn \u001b[98Ghe \u001b[102Game\u001b[106Grules and \r\u001b[1B\u001b[39m  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe p\u001b[9Gevious\u001b[16Gpass\u001b[21Gended\u001b[27Gnear\u001b[32Gthe\u001b[36Gsingle-core\u001b[48Gmemory-bandwidth\u001b[65Gceiling,\u001b[74Gso\u001b[77Gthis\u001b[82Gpass\u001b[87Gstarts\u001b[94Gby\u001b[97Gre-measuring.\u001b[111GFirst\u001b[117GI'll\r\u001b[2C\u001b[1Bestablish\u001b[13Grun-to-run\u001b[24Gnoise\u001b[30Gon\u001b[33Gthe\u001b[37Gdev\u001b[41Gworkload,\u001b[51Gso\u001b[54Gany\u001b[58Gfurther\u001b[66Gchange\u001b[73Gis\u001b[76G"]
[109.746, "judged\u001b[83Gagainst\u001b[91Greal\u001b[96Gvariance,\u001b[106Gnot\u001b[110Gone-off\r\u001b[2C\u001b[1Bnumbers.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe baseline\u001b[16Gholds ste\u001b[27Gy at 2146\u20132183 ms with m\u001b[52Gtmuls\u001b[58Gat\u001b[61G96.8%\u001b[67Gand\u001b[71Gabout\u001b[77G60\u001b[80GGB/s,\u001b[86Gleaving\u001b[94Groughly\u001b[102G3%\u001b[105Gof\u001b[108Gheadroom\r\u001b[2C\u001b[1Bunder\u001b[9Gthe\u001b[13G62\u001b[16GGB/s\u001b[21Gceiling.\u001b[30GNext\u001b[35GI'll\u001b[40Gtry\u001b[44Gthree\u001b[50Gcheap\u001b[56Gkernel\u001b[63Gtweaks:\u001b[71Gunrolling\u001b[81Gtwo\u001b[85G16-column\u001b[95Gblocks\u001b[102Gper\u001b[106Giteration,\r\u001b[2C\u001b[1Bnon-temporal weight loads, and paired 32-byte\u001b[49Gloads.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m3\u001b[22m shell commands \u001b[49G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gloop\u001b[12Gheader\u001b[19Galso\u001b[24Gappears\u001b[32Gin\u001b[35Gthe\u001b[39Grow-major\u001b[49Gfallback\u001b[58Gkernel,\u001b[66Gso\u001b[69Git\u001b[72Gmatched\u001b[80Gtwice.\u001b[87GI'll\u001b[92Ganchor\u001b[99Gon\u001b[102Gthe\u001b[106Gpacked\u001b[113Gkernel's\r\u001b[1B \u001b[3Gspecific\u001b[12Glines.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;1"]
[109.747, "02;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll four kernel variants come in within the baseline's \u00b11\u20132% noise, so none is a real gain and no kernel change will\u001b[K\r\u001b[2C\u001b[1Bbe\u001b[6Gadopted.\u001b[15GStartup\u001b[23Gbefore\u001b[30GREADY,\u001b[37Gabout\u001b[43G100\u001b[47Gms,\u001b[51Gis\u001b[54Gthe\u001b[58Gone\u001b[62Gremaining\u001b[72Gslack,\u001b[79Gand\u001b[83GI'm\u001b[87Gprofiling\u001b[97Gthe\u001b[101Gload\u001b[106Gphases\u001b[113Gto\u001b[116Gcheck\r\u001b[2C\u001b[1Bthe mmap page faults and the \u001b[38;2;87;105;247mmemset\u001b[39m on the packed buffer.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mLocating\u001b[12Gallocation\u001b[23Gand\u001b[27Gload-phase\u001b[38Gcode\r\u001b[2B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;223;127;95mLevitating\u2026\u001b[38;2;215;119;87m \u001b[27G\u001b[38;2;102;102;102m5\u001b[29G8\u001b[38G)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
