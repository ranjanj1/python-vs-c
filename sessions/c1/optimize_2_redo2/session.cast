[418.817, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's median is down to 78 ms and KV allocation to 0.1 ms, but the\u001b[72Gdev-workload\u001b[85Gprofile\u001b[93Grose\u001b[98Gslightly\u001b[107Gto\u001b[110G2178\u20132286\r\u001b[2C\u001b[1Bms\u001b[6Gand one load spiked to 153 ms, so the machine may be noisy.\u001b[66GI'm\u001b[70Gchecking\u001b[79Gthe\u001b[83Gper-section\u001b[95Gnumbers\u001b[103Gto\u001b[106Gsee\u001b[110Gwhether\u001b[118Gthe\r\u001b[2C\u001b[1BKV\u001b[6Gpage\u001b[11Gfaults\u001b[18Gshifted\u001b[26Gcost\u001b[31Ginto\u001b[36Gthe\u001b[40Gforward\u001b[48Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe KV\u001b[10Gpage f\u001b[17Gults ad\u001b[26Gonly about\u001b[37G1 ms over 289 forwards, so the \u001b[69Gatmuls mus\u001b[80G \u001b[82Gx\u001b[84Glain the drift, which\u001b[106Gis probably\u001b[118G\u001b[K\r\u001b[2C\u001b[1Bsystem noise. I'm now running \u001b[34Ghe earlier build (/tmp/c1v3/A)\u001b[65Ginterleaved\u001b[77Gwith\u001b[82Gthe\u001b[86Gcurrent\u001b[94Gone\u001b[98Gto\u001b[101Gconfirm.\r\u001b[6C\u001b[4Bcurrent\u001b[15Gbui\u001b[19Gd m\u001b[23Gtches or slightly beats\u001b[47Gthe\u001b[51Gea\u001b[54Glier"]
