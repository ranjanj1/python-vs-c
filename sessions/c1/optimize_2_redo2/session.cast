[212.959, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mW\u001b[5Grm star\u001b[13Gup is\u001b[19Gn\u001b[21Gw roughly 71\u201380 ms for read-and-pack plus\u001b[63G5\u20138 ms for\u001b[74Gallocations, down\u001b[92Gfrom\u001b[97G90\u2013100 ms, since\u001b[114G\u001b[K\r\u001b[2C\u001b[1Bpage-fault cost\u001b[19Gmoved\u001b[25Ginto\u001b[30Gthe\u001b[34Gpack\u001b[39Gstep.\u001b[45GNext\u001b[50GI'll\u001b[55Gmeasure\u001b[63Gend-to-end\u001b[74Gtime\u001b[79Gto\u001b[82GREADY\u001b[88Gand\u001b[92Gtest\u001b[97Gwhether\u001b[105Ga\u001b[107Glarger\u001b[114Gstaging\r\u001b[2C\u001b[1Bbuffer\u001b[10Ghelps.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup to\u001b[14GREADY\u001b[20Gnow runs a median 82\u201391\u001b[44Gms with 1\u20132 MB \u001b[61Gaging, so I'm ke\u001b[78Gping 2\u001b[85GMB. I'm switching \u001b[104Ghe 75 MB KV cache\r\u001b[2C\u001b[1Bto calloc,\u001b[14Gsince\u001b[20Gfresh\u001b[26Gpages\u001b[32Gare\u001b[36Galready\u001b[44Gzero\u001b[49Gand\u001b[53Gthe\u001b[57Gcost\u001b[62Gshifts\u001b[69Gto\u001b[72Gthe\u001b[76Gfew\u001b[80Gpage\u001b[85Gfaults\u001b[92Gon\u001b[95Gthe\u001b[99Gpositions\u001b[109Gactually\r\u001b[2C\u001b[1Bused.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39"]
