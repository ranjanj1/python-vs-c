[426.501, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything passes. My\u001b[25G\u001b[38;2;87;105;247msort\u001b[30G\u001b[39mpipeline\u001b[39Gdropped\u001b[47Gthe\u001b[51GPASS\u001b[56Gline\u001b[61Gfrom\u001b[66Gthe\u001b[70Gfull\u001b[75Gcheck\u001b[81Goutput,\u001b[89Gso\u001b[92GI'll\u001b[97Grerun\u001b[103Gthat\u001b[108Gone\u001b[112Gplainly\r\u001b[2C\u001b[1Bto\u001b[6Gconfirm.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m | File | Purpose |\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m |---|---|\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[13G\u001b[22m`run_c1.c` | The implementation (single file). |\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 10 -\u001b[38;2;51;51;51m| `build.sh` | `./build.sh` builds `./run_c1` (the submission). `./build.sh profile` builds `./run_c1_p\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m    -\u001b[38;2;51;51;51mrof`: "]
[426.502, "the same code with section timers (\u001b[48;2;255;199;199m`\u001b[48;2;255;220;220m-\u001b[48;2;255;199;199mDPROFILE\u001b[48;2;255;220;220m`\u001b[48;2;255;199;199m),\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mwhich\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mreports\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mto\u001b[48;2;255;220;220m stderr \u001b[48;2;255;199;199mat\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mQUIT\u001b[48;2;255;220;220m. The timers are \r\u001b[6C\u001b[1B\u001b[38;2;207;34;46m  \u001b[11G\u001b[38;2;51;51;51mcompile\u001b[19G out\u001b[24Gof the normal build. |          \u001b[57G    \u001b[62G            \u001b[75G           \u001b[87G        \u001b[96G      \u001b[103G           \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 10 +\u001b[38;2;51;51;51m| `build.sh` | `./build.sh` builds `./run_c1` (the submission). `./build.sh profile` builds `./run_c1_p\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m    +\u001b[38;2;51;51;51mrof`: the same code with \u001b[48;2;178;255;178mforward-pass \u001b[48;2;220;255;220msection timers (\u001b[48;2;178;255;178mreported to stderr at QUIT) and load\u001b[48;2;220;255;220m-\u001b[48;2;178;255;178mphase timers\r\u001b[6C\u001b[1B\u001b[38;2;36;138;6"]
[426.503, "1m\u001b[48;2;220;255;220m  \u001b[11G\u001b[38;2;51;51;51m\u001b[48;2;178;255;178m (\u001b[14GLOAD\u001b[48;2;220;255;220m \u001b[48;2;178;255;178m...`\u001b[24Glines\u001b[48;2;220;255;220m \u001b[48;2;178;255;178mon\u001b[48;2;220;255;220m stderr\u001b[48;2;178;255;178m),\u001b[48;2;220;255;220m \u001b[48;2;178;255;178menabled\u001b[48;2;220;255;220m \u001b[48;2;178;255;178mby `-DPROFILE`\u001b[48;2;220;255;220m. The timers are compiled out of the normal build.\r\u001b[10C\u001b[1B |   \u001b[17G   \u001b[21G    \u001b[26G    \u001b[31G    \u001b[36G                    \u001b[57G      \u001b[64G                                                  \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 11 \u001b[22m | `tests/ref_encode.c` | Differential helper: `#include`s the unmodified `reference/run.c` (with `-DTES\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22m TING`) and prints its `encode()`/`decode()` output. |\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[24G\u001b[22mlogits\u001b[57Gthe unmodified reference `fo\u001b[86Gward()`; writes\u001b[102Gall logits f\r\u001b[10C\u001b[1Bor an id seque\u001b[26Gce. |\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[20G\u001b[22mdi\u001b[23Gftest.py` | Compares ENCODE (2009\u001b[57Gstrings, \u001b[67Gncluding \u001b[77Ga\u001b[79Gdom ASC"]
