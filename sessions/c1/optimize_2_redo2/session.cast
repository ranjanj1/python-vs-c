[410.491, "aved runs, so the earlier d\u001b[101Gif\u001b[104G was machin\u001b[116G\u001b[K\r\u001b[2C\u001b[1Bnoise. I'm running \u001b[23Ghe\u001b[26Gfull\u001b[31Gregression suite\u001b[48Gon the\u001b[55Gfinal\u001b[61Gcode\u001b[66Gnext.\r\u001b[2C\u001b[4BEv\u001b[6Grythin\u001b[13G passes.\u001b[22GMy \u001b[38;2;87;105;247msort\u001b[39m pipeline\u001b[39Gdropp\u001b[45Gd\u001b[47Gthe\u001b[51GPASS line\u001b[61Gfrom the ful\u001b[74G check\u001b[81Goutput,\u001b[89Gso I'll rerun t\u001b[105Gat one plainly\r\u001b[2C\u001b[1Bto confirm.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mConfirming full check\u001b[25Gpasses\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 check.py --tokens 64 --prompts 3 -- ./run_c1 | tail -1\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for "]
