[250.766, "large sizes calloc\u001b[38;2;51;51;51m                           \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 308 +\u001b[38;2;51;51;51m     * hands out fresh zero pages, so only the pages actually used get touched */                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 309 +\u001b[38;2;51;51;51m    key_cache = \u001b[38;2;0;134;179mcalloc\u001b[38;2;51;51;51m(L * cfg.seq_len * kv_dim, \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m));                                      \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m10\u001b[16G\u001b[38;2;51;51;51mvalue_cache = \u001b[38;2;0;134;179mcalloc\u001b[38;2;51;51;51m(L * cfg.seq_len * kv_dim, \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m));         \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m11\u001b[16G\u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m (!key_cache || !value_cache) { \u001b[38;2;0;134;179mfprintf\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mstderr\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"alloc failed\\n\"\u001b[38;2;51;51;51m); \u001b[38;2;0;134;179mexit\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m); }                   \r\u001b[5C\u001b[1B\u001b[49m\u001b["]
[250.767, "2m 312 \u001b[22m     kcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); vcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 313 \u001b[22m     att = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.n_heads * cfg.seq_len * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 314 \u001b[22m     logits = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.vocab_size * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's\u001b[11Gmedian\u001b[18Gis\u001b[21Gdown\u001b[26Gto\u001b[29G78\u001b[32Gms\u001b[35Gand\u001b[39GKV\u001b[42Gallocation\u001b[53Gto\u001b[56G0.1\u001b[60Gms,\u001b[64Gbut\u001b[68Gthe\u001b[72Gdev-workload\u001b[85Gprofile\u001b[93Grose\u001b[98Gslightly\u001b[107Gto\u001b[110G2178\u20132286\r\u001b[2C\u001b[1Bms and one load spiked\u001b[26Gto\u001b[29G153\u001b[33Gms,\u001b[37Gso\u001b[40Gthe\u001b[44Gmachine\u001b[52Gmay\u001b[56Gbe\u001b[59Gnoisy.\u001b[66GI'm\u001b[70Gchecking\u001b[79Gthe\u001b[83Gper-section\u001b[95Gnumbers\u001b[103Gto\u001b[106Gsee\u001b[110Gwhether\u001b[118Gthe\r\u001b[2C\u001b[1BKV\u001b[6Gpage\u001b[11Gfa"]
[250.769, "ults\u001b[18Gshifted\u001b[26Gcost\u001b[31Ginto\u001b[36Gthe\u001b[40Gforward\u001b[48Gpass.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7GKV\u001b[10Gpage\u001b[15Gfaults\u001b[22Gadd\u001b[26Gonly\u001b[31Gabout\u001b[37G1\u001b[39Gms\u001b[42Gover\u001b[47G289\u001b[51Gforwards,\u001b[61Gso\u001b[64Gthe\u001b[68Gmatmuls\u001b[76Gmust\u001b[81Gexplain\u001b[89Gthe\u001b[93Gdrift,\u001b[100Gwhich\u001b[106Gis\u001b[109Gprobably\r\u001b[2C\u001b[1Bsystem noise. I'm now\u001b[25Grunning\u001b[33Gthe\u001b[37Gearlier\u001b[45Gbuild\u001b[51G(/tmp/c1v3/A)\u001b[65Ginterleaved\u001b[77Gwith\u001b[82Gthe\u001b[86Gcurrent\u001b[94Gone\u001b[98Gto\u001b[101Gconfirm.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcurrent\u001b[15Gbuild\u001b[21Gmatches\u001b[29Gor\u001b[32Gslightly\u001b[41Gbeats\u001b[47Gthe\u001b[51Gearlier\u001b[59Gone\u001b[63Gin\u001b[66Ginterleaved\u001b[78Gruns,\u001b[84Gso\u001b[87Gthe\u001b[91Gearlier\u001b[99Gdrift\u001b[105Gwas\u001b[109Gmachine\r\u001b[1B \u001b[3Gnoise. I'm\u001b[14Grunni\u001b[20Gg\u001b[22Gthe\u001b[26Gf\u001b[28Gl\u001b[30G regression suite on\u001b[51Gthe\u001b[55Gfinal\u001b[61Gcode\u001b[66Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell "]
[250.769, "command\u2026\u001b[K\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m6\u001b[29G4\u001b[39m\u001b[40;1H\u001b[38;3H"]
