[218.531, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup to READY now runs a median 82\u201391 ms with 1\u20132 MB staging, so I'm keeping\u001b[83G2\u001b[85GMB.\u001b[89GI'm\u001b[93Gswitching\u001b[103Gthe\u001b[107G75\u001b[110GMB\u001b[113GKV\u001b[116Gcache\r\u001b[2C\u001b[1Bto\u001b[6Gcalloc, since fresh pages are already zero and the cost shifts to the\u001b[76Gfew\u001b[80Gpage\u001b[85Gfaults\u001b[92Gon\u001b[95Gthe\u001b[99Gpositions\u001b[109Gactually\r\u001b[2C\u001b[1Bused.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m5\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m05\u001b[16G\u001b[22mx = xalloc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); xb = xalloc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); xb2 = xalloc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\r\u001b[7C\u001b[1B\u001b[2m06\u001b[16G\u001b[22mhb = xal\u001b[25Goc(h * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); hb2 = xalloc(h\u001b[51G* \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m)"]
