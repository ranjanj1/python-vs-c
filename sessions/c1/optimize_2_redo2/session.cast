[225.713, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup to\u001b[14GREADY\u001b[20Gnow runs a median 82\u201391\u001b[44Gms with 1\u20132 MB \u001b[61Gaging, so I'm ke\u001b[78Gping 2\u001b[85GMB. I'm switching \u001b[104Ghe 75 MB KV cache\r\u001b[2C\u001b[1Bto calloc,\u001b[14Gsince\u001b[20Gfresh\u001b[26Gpages\u001b[32Gare\u001b[36Galready\u001b[44Gzero\u001b[49Gand\u001b[53Gthe\u001b[57Gcost\u001b[62Gshifts\u001b[69Gto\u001b[72Gthe\u001b[76Gfew\u001b[80Gpage\u001b[85Gfaults\u001b[92Gon\u001b[95Gthe\u001b[99Gpositions\u001b[109Gactually\r\u001b[2C\u001b[1Bused.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m5\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[16G\u001b[22mx = xal\u001b[24Goc(d * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); xb =\u001b[40Gxalloc(d *\u001b[51G\u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); xb2\r\u001b[5C\u001b[1B\u001b[2m 306 \u001b[22m     hb = xalloc(h * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); hb2 = xalloc(h * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); q = xalloc(d *"]
[225.713, " \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m7\u001b[16G\u001b[38;2;51;51;51mkey_ca\u001b[23Ghe =\u001b[28Gxalloc(L *\u001b[39Gcfg.seq_len *\u001b[53Gkv_dim *\u001b[62G4);  \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 308 -\u001b[38;2;51;51;51m    value_cache = xalloc(L * cfg.seq_len * kv_dim * 4);                                               \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m7\u001b[16G\u001b[38;2;150;152;150m/* zero-initialised like the reference's calloc; for large sizes calloc\u001b[38;2;51;51;51m                           \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[16G\u001b[38;2;51;51;51m * hands out fresh zero pages, so only the pages actually used get touched */                     \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m09\u001b[16G\u001b[38;2;51;51;51mkey_ca\u001b[23Ghe =\u001b[28G\u001b[38;2;0;134;179mcalloc\u001b[38;2;51;51;51m(L *\u001b[39Gcfg.seq_len *\u001b[53Gkv_dim, \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m));  \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m0\u001b[16G\u001b[38;2;51;51;51mvalue_cache = \u001b[38;2;0;134;179mcalloc\u001b[38;2;51;51;51m(L * \u001b[42Gfg.seq_len * kv_dim, \u001b[3"]
