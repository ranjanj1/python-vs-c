[195.913, "n, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm-cache\u001b[14Gstartup\u001b[22Gspends\u001b[29G28\u201330\u001b[35Gms\u001b[38Gzeroing\u001b[46Ga\u001b[48Gpacked\u001b[55Gbuffer\u001b[62Gthat\u001b[67Gpacking\u001b[75Goverwrites\u001b[86Ganyway,\u001b[94Gplus\u001b[99G52\u201365\u001b[105Gms\u001b[108Gpacking\u001b[116Gfrom\r\u001b[1B \u001b[3Gthe mm\u001b[10Gp and \u001b[17Gbo\u001b[20Gt\u001b[22G5.5 m\u001b[29Gzeroing th\u001b[40G KV cache. I'm\u001b[55Gskipping that zeroing and reading the checkpoint with pread in\u001b[K\r\u001b[2C\u001b[1BL2-sized\u001b[12Gchunks instead, to avoid\u001b[41Gpage faults.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWarm\u001b[8Gstartup\u001b[16Gis\u001b[19Gnow\u001b[23Groughly\u001b[31G71\u201380\u001b[37Gms\u001b[40Gfor\u001b[44Gread-and-pack\u001b[58Gplus\u001b[63G5\u20138\u001b[67Gms\u001b[70Gfor\u001b[74Gallocations,\u001b[87Gdown\u001b[92Gfrom\u001b[97G90\u2013100\u001b[104Gms,\u001b[108Gsince\r\u001b[1B \u001b[3Gp\u001b[5Gge-faul\u001b[13G cost\u001b[19Gm\u001b[21Gved into the pack step. Next I'll measure\u001b[63Gend-to-end\u001b[74Gtime to READY and\u001b[92Gtest\u001b[97Gwhether a larger\u001b[114Gstaging\r\u001b[2C\u001b[1Bbuffer helps.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C"]
