[231.614, "_cache) { \u001b[38;2;0;134;179mfprintf\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mstderr\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"alloc failed\\n\"\u001b[38;2;51;51;51m); \u001b[38;2;0;134;179mexit\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m); }                   \r\u001b[1B\u001b[39m\u001b[49m     \u001b[38;2;51;51;51m\u001b[2m 312 \u001b[22m     kcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m); vcur = xalloc(kv_dim * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\r\u001b[7C\u001b[1B\u001b[2m13\u001b[12G\u001b[22m    att = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.n_heads * cfg.seq_len * \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\r\u001b[7C\u001b[1B\u001b[2m14\u001b[16G\u001b[22mlogits = xalloc((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.vocab_size\u001b[55G* \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m);\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mREADY's median is down to 78 ms and KV allocation to 0.1 ms, but the dev-workload profile rose slightly to 2178\u20132286\r\u001b[2C\u001b[1Bms\u001b[6Gand one load spiked to 153 ms, so the machine may be noisy. I'm c"]
[231.615, "hecking the per-section numbers to see whether\u001b[118Gthe\r\u001b[2C\u001b[1BKV\u001b[6Gpage faults shifted cost into the forward pass.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe KV page faults add only about 1 ms over 289 forwards, so the matmuls\u001b[76Gmust\u001b[81Gexplain\u001b[89Gthe\u001b[93Gdrift,\u001b[100Gwhich\u001b[106Gis\u001b[109Gprobably\r\u001b[2C\u001b[1Bsystem noise. I'm now running the earlier build (/tmp/c1v3/A)\u001b[65Ginterleaved\u001b[77Gwith\u001b[82Gthe\u001b[86Gcurrent\u001b[94Gone\u001b[98Gto\u001b[101Gconfirm.\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mInterleave old and new\u001b[26Gbuilds\u001b[33Gon\u001b[36Gdev\u001b[40Gworkload\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for r in 1 2 3; do for b in /tmp/c1v3/A ./run_c1_prof; do printf \"%-14s %s\\n\" $b \"$(python3 check.py --tokens 64 \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m--prompts 3 -- $b 2>&1 | grep -E 'PROFILE|PASS|FAIL' | tr '\\n' ' ')\"; done; done\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[231.615, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mInterleave old and new builds on dev workload\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m for r\u001b[10Gin 1 2\u001b[17G3; do fo\u001b[26G b \u001b[31G /\u001b[34Gmp/c1v3/A ./run_c1_prof; do printf \"%-14s %s\\n\"\u001b[82G$b \"$(python3 check.py --tokens\u001b[114G64\r\u001b[1C\u001b[1"]
[231.616, "B\u001b[2m\u2502\u001b[4G\u001b[22m--prompts\u001b[14G3\u001b[16G--\u001b[19G$b\u001b[22G2>&1\u001b[27G|\u001b[29Ggrep\u001b[34G-E\u001b[37G'PROFILE|PASS|FAIL'\u001b[57G|\u001b[59Gtr\u001b[62G'\\n'\u001b[67G'\u001b[69G')\";\u001b[74Gdone;\u001b[80Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[2"]
