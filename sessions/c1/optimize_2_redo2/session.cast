[199.654, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;102;102;102m\u2026\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mrun_c1.c\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[199.692, "\u001b[H\u001b[3GWarm startup is\u001b[19Gnow roughly 71\u201380 ms for r\u001b[46Gad-and-pack\u001b[58Gplus 5\u20138 ms for\u001b[74Gallocations, down from 90\u2013100 ms,\u001b[108Gsince\u001b[K\r\u001b[2C\u001b[1Bpage-fault cost moved into\u001b[30Gthe pack step. Next I'll m\u001b[57Gasure \u001b[64Gnd-to-end time\u001b[79Gto READY and test\u001b[97Gw\u001b[100Gther a l\u001b[109Grger staging\r\u001b[2C\u001b[1Bbuffer helps.\u001b[17G\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm\u001b[20Gnd \u001b[39m\u001b[K\r\u001b[2C\u001b[2BStartup to\u001b[14GREADY now run\u001b[29Ga median\u001b[38G82\u201391 ms with 1\u20132 MB staging, so I'm\u001b[75Gke\u001b[78Gping 2 MB. I'm switching the 75 MB KV\u001b[116Gcache\r\u001b[3C\u001b[1Bo calloc, since fresh\u001b[26Gpages are alr\u001b[40Gady\u001b[44Gzero and the cost shifts\u001b[69Gto the few page faul\u001b[90Gs on the positions\u001b[109Gactually\r\u001b[2C\u001b[1Bused.\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;102;102;102mS\u001b[6Grched for\u001b[16G\u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[2B\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mR\u001b[5Gnning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
