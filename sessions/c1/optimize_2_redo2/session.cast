[205.698, "\u001b[H \u001b[3Gp\u001b[5Gge-faul\u001b[13G cost\u001b[19Gm\u001b[21Gved into the pack step. Next I'll measure\u001b[63Gend-to-end\u001b[74Gtime to READY and\u001b[92Gtest\u001b[97Gwhether a larger\u001b[114Gstaging\r\u001b[2C\u001b[1Bbuffer helps.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gto\u001b[14GREADY\u001b[20Gnow\u001b[24Gruns\u001b[29Ga\u001b[31Gmedian\u001b[38G82\u201391\u001b[44Gms\u001b[47Gwith\u001b[52G1\u20132\u001b[56GMB\u001b[59Gstaging,\u001b[68Gso\u001b[71GI'm\u001b[75Gkeeping\u001b[83G2\u001b[85GMB.\u001b[89GI'm\u001b[93Gswitching\u001b[103Gthe\u001b[107G75\u001b[110GMB\u001b[113GKV\u001b[116Gcache\r\u001b[1B \u001b[3Gto calloc,\u001b[14Gsince\u001b[20Gfresh pages are already\u001b[44Gzero and the co\u001b[61G shifts to the f\u001b[78Gw page\u001b[85Gfaults on the posi\u001b[104Gions actually\u001b[K\r\u001b[2C\u001b[1Bused.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m5\u001b[22m lines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b"]
