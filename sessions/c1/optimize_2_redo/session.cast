[61.95, "\u001b[H\u001b[8G\u001b[2m\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m81\u001b[13G\u001b[38;2;51;51;51m - FIXED/LOGITS\u001b[29Gsequences\u001b[39Glonger\u001b[46Gthan\u001b[51G`seq_len`\u001b[61Gare\u001b[65Gtruncated\u001b[75Gto\u001b[78G`seq_len`.\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m2\u001b[16G\u001b[38;2;51;51;51m`GENERATE 0 ...` a\u001b[35Gswers `DONE 0 max` without \u001b[63Gunning th\u001b[73G model.        \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m3\u001b[16G\u001b[38;2;51;51;51mA piece whose decoded byte is 0x00 prints as empty (`HEX `), matching\u001b[86GC-string\u001b[95Gsemantics.\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m4\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G`check.py` pa\u001b[28Gsing is necessary\u001b[46Gbut not suffici\u001b[62Gnt. The final gate uses\u001b[86Gothe\u001b[91G inputs I have\u001b[106Gnot\u001b[110Gseen\r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m  \u001b[12G\u001b[38;2;51;51;51m.\u001b[14G          \u001b[25G       \u001b[33G  \u001b[36G         \u001b[46G   \u001b[50G   \u001b[54G           \u001b[66G   \u001b[70G     \u001b[76G    \u001b[81G    \u001b[86G     \u001b[92G      \u001b[99G \u001b[101G    \u001b[106G   \u001b[110G    \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 199 +\u001b[38;2;51;51;51m  - Out-of-range ids in FIXED/LOGITS are replaced by 0, and an out-of-range PIECE id prints `HEX "]
[61.951, "`.   \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m200\u001b[16G\u001b[38;2;51;51;51mFIXED/LOGITS\u001b[29Gseque\u001b[35Gces longer than `seq_\u001b[57Gen` are\u001b[65Gtruncated.            \u001b[88G     \u001b[94G  \u001b[97G      \u001b[104G    \u001b[109G  \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m1\u001b[16G\u001b[38;2;51;51;51m`GENERATE 0`\u001b[29Gansw\u001b[34Grs `DONE 0 max` without running the model.\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m2\u001b[16G\u001b[38;2;51;51;51mA decoded\u001b[27Gx00 byte prints\u001b[43Gas empty (C-s\u001b[57Gring semantics, as in\u001b[79Gthe\u001b[83Greference).\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G**Hi\u001b[19Gden gate:**\u001b[31G`ch\u001b[35Gck.py` p\u001b[45Gsing is necessary but not sufficient.\u001b[83GThe fi\u001b[90Gal gate\u001b[98Guses\u001b[103Gother\u001b[109Ginput\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m   \u001b[12G\u001b[38;2;51;51;51ms,        \u001b[23G       \u001b[31G          \u001b[42G       \u001b[50G  \u001b[53G         \u001b[63G   \u001b[67G   \u001b[71G           \u001b[83G   \u001b[87G     \u001b[93G    \u001b[98G    \u001b[103G     \u001b[109G     \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m204\u001b[12G\u001b[38;2;51;51;51m  which\u001b[20GI\u001b[22Ghave\u001b[27Gnot\u001b[31Gseen\u001b[36Gor\u001b[39Gused.\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[22m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;10"]
