[74.186, "\u001b[H\u001b[3G  They ran at 43\u201353 GB/\u001b[27G.\u001b[K\r\u001b[2C\u001b[1B- A small\u001b[13Gbenchmark on matrices the \u001b[40Game shape\u001b[50Gas\u001b[53Gthe\u001b[57Gmodel's\u001b[65Gput\u001b[69Gone\u001b[73Gcore's\u001b[80Gpractical\u001b[90Gceiling\u001b[98Gat\u001b[101Gabout\u001b[107G62\u001b[110GGB/s.\r\u001b[4C\u001b[1BOn a 1024-position run, attention grew to\u001b[47G35% of the time,\u001b[64Gabout 6\u00d7 \u001b[74Glower\u001b[80Gthan reading its cache shoul\u001b[110Gt\u001b[112Gke.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mWeights repacked into one sequential stream.\u001b[51G\u001b[22mAt\u001b[54Gload, w\u001b[62Gights are reord\u001b[79Ged so\u001b[85Geach token re\u001b[99Gds them front to\u001b[116Gback\r\u001b[5C\u001b[1Bin\u001b[9Gthe\u001b[13Gorder\u001b[19Gthey're\u001b[27Gused,\u001b[33G4\u001b[35Grows\u001b[40Ginterleaved\u001b[52Gat\u001b[55Ga\u001b[57Gtime.\u001b[63GThe\u001b[67Gvalues\u001b[74Gand\u001b[78Gthe\u001b[82Gper-row\u001b[90Garithmetic\u001b[101Gare\u001b[105Gunchanged.\r\u001b[2C\u001b[1B   Matmul\u001b[13Gspeed\u001b[19Gwent\u001b[24Gfrom\u001b[29G43\u201353\u001b[35Gto\u001b[38Gabout\u001b[44G60\u201361\u001b[50GGB/s,\u001b[56Gnear\u001b[61Gthe\u001b[65Gceiling.\r\u001b[2C\u001b[1B2\u001b[6G\u001b[1mFaster loading.\u001b[22m The model is memory-mapped and copied\u001b[60Gonce, \u001b[67Go the program prints READY aft\u001b[98Gr abou"]
[74.188, "t 0.1 s inste\u001b[118Gd\u001b[K\r\u001b[5C\u001b[1Bof\u001b[9G0.26 s.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mFaster attention.\u001b[24G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G- The cache is reordered so each attention\u001b[49Ghead's k\u001b[58Gys and values sit together in\u001b[88Gmemory; it still store\u001b[112Gthe s\u001b[118Gme\r\u001b[5C\u001b[1B  values at\u001b[18Gthe\u001b[22Gsame\u001b[27Gpositions.\r\u001b[2C\u001b[1B  \u001b[6G- Scores are computed\u001b[28G4\u001b[30Gpositions\u001b[40Gat\u001b[43Ga\u001b[45Gtime.\r\u001b[7C\u001b[1BAttention\u001b[18Gcost \u001b[24Gn th\u001b[29G 1024-position run fell from 3.89 to 0.82 m\u001b[73G per pass.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mFaster argmax.\u001b[22m It's vector\u001b[33Gsed,\u001b[38Gwith\u001b[43Gties\u001b[48Gstill\u001b[54Ggoing\u001b[60Gto\u001b[63Gthe\u001b[67Glowest\u001b[74Gindex\u001b[80Gand\u001b[84Ga\u001b[86Gfallback\u001b[95Gto\u001b[98Gthe\u001b[102Goriginal\u001b[111Gscan\u001b[116Gif\r\u001b[5C\u001b[1Bany NaN app\u001b[18Gars.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mTried and dropped:\u001b[22m 2-row grou\u001b[36Gs were no di\u001b[49Gferent from 4, 8-row grou\u001b[75Gs were slower,\u001b[90Gand\u001b[94Gsoftware\u001b[103Gprefetch\u001b[112Ggave\u001b[117Gno\r\u001b[2C\u001b[1B  \u001b[6Gconsistent gain.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
