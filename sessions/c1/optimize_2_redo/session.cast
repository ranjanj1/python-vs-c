[74.48, "\u001b[H\u001b[3G-\u001b[5GA small benchmark\u001b[23Gon matrices\u001b[35Gthe\u001b[39Gsame\u001b[44Gshape\u001b[50Gas\u001b[53Gthe\u001b[57Gmodel's\u001b[65Gput\u001b[69Gone\u001b[73Gcore's\u001b[80Gpractical\u001b[90Gceiling\u001b[98Gat\u001b[101Gabout\u001b[107G62\u001b[110GGB/s.\r\u001b[4C\u001b[1BOn a 1024-position run, att\u001b[33Gntion\u001b[39Ggrew\u001b[44Gto 35% of the time, about 6\u00d7\u001b[73Gslower\u001b[80Gth\u001b[83Gn re\u001b[88Gding its c\u001b[99Gche should\u001b[110Gtake\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mWeights repacked into one sequential stream.\u001b[51G\u001b[22mAt\u001b[54Gload,\u001b[60Gweights\u001b[68Gare\u001b[72Greordered\u001b[82Gso\u001b[85Geach\u001b[90Gtoken\u001b[96Greads\u001b[102Gthem\u001b[107Gfront\u001b[113Gto\u001b[116Gback\r\u001b[2C\u001b[1B  \u001b[6Gin the order they're used, 4 rows interleaved at a time. T\u001b[65Ge v\u001b[69Glues an\u001b[77G the\u001b[82Gper-row\u001b[90Garithmetic are uncha\u001b[111Gged.\u001b[116G\u001b[K\r\u001b[5C\u001b[1BMatmul\u001b[13Gspe\u001b[17Gd\u001b[19Gwent from 43\u201353\u001b[35Gt\u001b[37G abou\u001b[43G 60\u201361 GB/s, near the ceiling.\u001b[74G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mFaster loading.\u001b[22m The model is\u001b[35Gmemory-mapped and copi\u001b[58Gd onc\u001b[64G, so the program\u001b[81Gprints\u001b[88GREADY\u001b[94Gafter\u001b[100Gabout\u001b[106G0.1\u001b[110Gs\u001b[112Ginstea"]
[74.481, "d\r\u001b[2C\u001b[1B  \u001b[6Gof 0.26 s.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mFaster attention.\r\u001b[2C\u001b[1B\u001b[22m  \u001b[6G- The cache is reordered\u001b[31Gso\u001b[34Geach\u001b[39Gattention\u001b[49Ghead's\u001b[56Gkeys\u001b[61Gand\u001b[65Gvalues\u001b[72Gsit\u001b[76Gtogether\u001b[85Gin\u001b[88Gmemory;\u001b[96Git\u001b[99Gstill\u001b[105Gstores\u001b[112Gthe\u001b[116Gsame\r\u001b[5C\u001b[1B \u001b[8Gvalues at\u001b[18Gthe same positions.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GScor\u001b[16Gre comput\u001b[26Gd 4 positions\u001b[40Gat\u001b[43Ga\u001b[45Gtime.\r\u001b[7C\u001b[1BAttention cost on the\u001b[30G1024-p\u001b[37Gsition run fell\u001b[53Gfrom\u001b[58G3.89\u001b[63Gto\u001b[66G0.82\u001b[71Gms\u001b[74Gper\u001b[78Gpass.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mFaster argmax.\u001b[22m It's\u001b[26Gvectorised, with ties\u001b[48Gsti\u001b[52Gl g\u001b[56Ging to\u001b[64Ghe lowest\u001b[74Gindex and\u001b[84Ga\u001b[86Gfallback\u001b[95Gto\u001b[98Gthe\u001b[102Goriginal\u001b[111Gscan\u001b[116Gif\r\u001b[2C\u001b[1B  \u001b[6Gany NaN appears.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mTried and dropped:\u001b[25G\u001b[22m2-row\u001b[31Ggroups\u001b[38Gwere\u001b[43Gno\u001b[46Gdifferent\u001b[56Gfrom\u001b[61G4,\u001b[64G8-row\u001b[70Ggroups\u001b[77Gwere\u001b[82Gslower,\u001b[90Gand\u001b[94Gsoftware\u001b[103Gprefetch\u001b[112Ggave\u001b[117Gno\r\u001b[2C\u001b[1B  \u001b[6Gconsistent gain.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b["]
[74.481, "2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502          Workload          \u2502 Before  \u2502  After  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Dev workload, per forward  \u2502 8.89 ms \u2502 7.47 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 1024-position FIXED        \u2502 11.5 s  \u2502 8.4 s   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS over 1024 positions \u2502 12.5 s  \u2502 8.6 s   \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[74.481, "\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests, all on the final code:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mcheck.py\u001b[14G\u001b[39mpasses\u001b[21Gin\u001b[24Gboth\u001b[29Gthe\u001b[33Gquick\u001b[39Gand\u001b[43Gfull\u001b[48Gruns;\u001b[54Gthe\u001b[58Gworst\u001b[64Glogit\u001b[70Gerror\u001b[76Gis\u001b[79G2.7e-5\u001b[86Gagainst\u001b[94Ga\u001b[96Gtolerance\u001b[106Gof\u001b[109G5e-4.\u001b[40;1H\u001b[38;3H"]
[74.771, "\u001b[H\u001b[5GOn a 1024-position run, att\u001b[33Gntion\u001b[39Ggrew\u001b[44Gto 35% of the time, about 6\u00d7\u001b[73Gslower\u001b[80Gth\u001b[83Gn re\u001b[88Gding its c\u001b[99Gche should\u001b[110Gtake\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges:\r\u001b[2C\u001b[1B\u001b[22m1. \u001b[1mWeights repacked into one sequential stream.\u001b[51G\u001b[22mAt\u001b[54Gload,\u001b[60Gweights\u001b[68Gare\u001b[72Greordered\u001b[82Gso\u001b[85Geach\u001b[90Gtoken\u001b[96Greads\u001b[102Gthem\u001b[107Gfront\u001b[113Gto\u001b[116Gback\r\u001b[2C\u001b[1B  \u001b[6Gin the order they're used, 4 rows interleaved at a time. T\u001b[65Ge v\u001b[69Glues an\u001b[77G the\u001b[82Gper-row\u001b[90Garithmetic are uncha\u001b[111Gged.\u001b[116G\u001b[K\r\u001b[5C\u001b[1BMatmul\u001b[13Gspe\u001b[17Gd\u001b[19Gwent from 43\u201353\u001b[35Gt\u001b[37G abou\u001b[43G 60\u201361 GB/s, near the ceiling.\u001b[74G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mFaster loading.\u001b[22m The model is\u001b[35Gmemory-mapped and copi\u001b[58Gd onc\u001b[64G, so the program\u001b[81Gprints\u001b[88GREADY\u001b[94Gafter\u001b[100Gabout\u001b[106G0.1\u001b[110Gs\u001b[112Ginstead\r\u001b[2C\u001b[1B  \u001b[6Gof 0.26 s.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mFaster attention.\r\u001b[2C\u001b[1B\u001b[22m  \u001b[6G- The cache is reordered\u001b[31Gso\u001b[34Geach\u001b[39Gattention\u001b[49Ghead's\u001b[56Gkeys\u001b[61Gand\u001b[65Gvalues\u001b[72Gsit\u001b[76G"]
[74.772, "together\u001b[85Gin\u001b[88Gmemory;\u001b[96Git\u001b[99Gstill\u001b[105Gstores\u001b[112Gthe\u001b[116Gsame\r\u001b[5C\u001b[1B \u001b[8Gvalues at\u001b[18Gthe same positions.\u001b[K\r\u001b[5C\u001b[1B-\u001b[8GScor\u001b[16Gre comput\u001b[26Gd 4 positions\u001b[40Gat\u001b[43Ga\u001b[45Gtime.\r\u001b[7C\u001b[1BAttention cost on the\u001b[30G1024-p\u001b[37Gsition run fell\u001b[53Gfrom\u001b[58G3.89\u001b[63Gto\u001b[66G0.82\u001b[71Gms\u001b[74Gper\u001b[78Gpass.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mFaster argmax.\u001b[22m It's\u001b[26Gvectorised, with ties\u001b[48Gsti\u001b[52Gl g\u001b[56Ging to\u001b[64Ghe lowest\u001b[74Gindex and\u001b[84Ga\u001b[86Gfallback\u001b[95Gto\u001b[98Gthe\u001b[102Goriginal\u001b[111Gscan\u001b[116Gif\r\u001b[2C\u001b[1B  \u001b[6Gany NaN appears.\u001b[K\r\u001b[2C\u001b[1B5.\u001b[6G\u001b[1mTried and dropped:\u001b[25G\u001b[22m2-row\u001b[31Ggroups\u001b[38Gwere\u001b[43Gno\u001b[46Gdifferent\u001b[56Gfrom\u001b[61G4,\u001b[64G8-row\u001b[70Ggroups\u001b[77Gwere\u001b[82Gslower,\u001b[90Gand\u001b[94Gsoftware\u001b[103Gprefetch\u001b[112Ggave\u001b[117Gno\r\u001b[2C\u001b[1B  \u001b[6Gconsistent gain.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502          Workload     "]
[74.773, "     \u2502 Before  \u2502  After  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Dev workload, per forward  \u2502 8.89 ms \u2502 7.47 ms \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 1024-position FIXED        \u2502 11.5 s  \u2502 8.4 s   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS over 1024 positions \u2502 12.5 s  \u2502 8.6 s   \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests, all on the final code:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mcheck.py\u001b[14G\u001b[39mpasses\u001b[21Gin\u001b[24Gboth\u001b[29Gthe\u001b[33"]
[74.774, "Gquick\u001b[39Gand\u001b[43Gfull\u001b[48Gruns;\u001b[54Gthe\u001b[58Gworst\u001b[64Glogit\u001b[70Gerror\u001b[76Gis\u001b[79G2.7e-5\u001b[86Gagainst\u001b[94Ga\u001b[96Gtolerance\u001b[106Gof\u001b[109G5e-4.\r\u001b[4C\u001b[1BTokenizer \u001b[16Gnd PIECE \u001b[26Gutput matches the refe\u001b[49Ge\u001b[51Gce\u001b[54Gon all 98,009 answers.\u001b[K\u001b[40;1H\u001b[38;3H"]
[75.027, "\u001b[H\u001b[3G\u001b[1mChanges:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[1mWeights repacked into one sequential stream.\u001b[51G\u001b[22mAt\u001b[54Gload,\u001b[60Gweights\u001b[68Gare\u001b[72Greordered\u001b[82Gso\u001b[85Geach\u001b[90Gtoken\u001b[96Greads\u001b[102Gthem\u001b[107Gfront\u001b[113Gto\u001b[116Gback\r\u001b[2C\u001b[1B   in the\u001b[13Gorder\u001b[19Gthey're\u001b[27Gused,\u001b[33G4\u001b[35Grows\u001b[40Ginterleaved\u001b[52Gat\u001b[55Ga\u001b[57Gtime.\u001b[63GThe\u001b[67Gvalues\u001b[74Gand\u001b[78Gthe\u001b[82Gper-row\u001b[90Garithmetic\u001b[101Gare\u001b[105Gunchanged.\r\u001b[2C\u001b[1B  \u001b[6GMatmul speed went from 43\u201353 to about 60\u201361 GB/s, near the ceiling.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mFaster loading.\u001b[22m The mod\u001b[30Gl is\u001b[35Gmemory-mapp\u001b[47Gd and copied once, so th\u001b[72G program prints READY after about 0.1 s instead\r\u001b[5C\u001b[1Bof 0.26 s.\u001b[K\r\u001b[2C\u001b[1B3\u001b[13G\u001b[1mattention.\u001b[22m\u001b[K\r\u001b[5C\u001b[1B- The cache\u001b[18Gis\u001b[21Greordered\u001b[31Gso\u001b[34Geach\u001b[39Gattention\u001b[49Ghead's\u001b[56Gkeys\u001b[61Gand\u001b[65Gvalues\u001b[72Gsit\u001b[76Gtogether\u001b[85Gin\u001b[88Gmemory;\u001b[96Git\u001b[99Gstill\u001b[105Gstores\u001b[112Gthe\u001b[116Gsame\r\u001b[2C\u001b[1B  \u001b[6G  values at the same\u001b[27Gpositions.\r\u001b[7C\u001b[1BScores are computed 4 positions a\u001b[42G a time.\u001b[K\r\u001b[5C"]
[75.027, "\u001b[1B-\u001b[8GAttention\u001b[18Gcost on the 1024-position\u001b[44Grun\u001b[48Gfell\u001b[53Gfrom\u001b[58G3.89\u001b[63Gto\u001b[66G0.82\u001b[71Gms\u001b[74Gper\u001b[78Gpass.\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mFaster argmax.\u001b[22m It's vectorised, with\u001b[43Gties still\u001b[54Ggoing\u001b[60Gto\u001b[63Gthe\u001b[67Glowest\u001b[74Gindex\u001b[80Gand\u001b[84Ga\u001b[86Gfallback\u001b[95Gto\u001b[98Gthe\u001b[102Goriginal\u001b[111Gscan\u001b[116Gif\r\u001b[5C\u001b[1Bany NaN appear\u001b[21G.\u001b[23G\u001b[K\r\u001b[2C\u001b[1B5\u001b[6G\u001b[1mTried and dropped:\u001b[22m 2-row groups\u001b[39Gere\u001b[43Gno different from 4, 8-row groups were slower, and software prefetch g\u001b[114Gve no\r\u001b[5C\u001b[1Bconsistent g\u001b[19Gin\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[14GWorkload\u001b[32G\u2502\u001b[34GBefore\u001b[42G\u2502\u001b[45GAfter\u001b[52G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[32G\u253c\u001b[42G\u253c\u001b[52G\u2524\r\u001b[4C\u001b[1BDev\u001b[9Gworkload, per\u001b[23Gforward\u001b[34G8.89 ms\u001b[44G7.47 ms\r\u001b[4C\u001b[2B1024-position\u001b[19GFIXED      \u001b[34G11.5\u001b[39Gs \u001b[44G8\u001b[47G s  \r\u001b[4C\u001b[2BLOGITS over 1024 positions\u001b[35G2\u001b[46G6\r\u001b[2C"]
[75.028, "\u001b[1B\u2514\u001b[32G\u2534\u001b[42G\u2534\u001b[52G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests, all on the final code:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- \u001b[38;2;87;105;247mcheck.py\u001b[39m passes in both the\u001b[33Gquick\u001b[39Gand\u001b[43Gfull\u001b[48Gruns;\u001b[54Gthe\u001b[58Gworst\u001b[64Glogit\u001b[70Gerror\u001b[76Gis\u001b[79G2.7e-5\u001b[86Gagainst\u001b[94Ga\u001b[96Gtolerance\u001b[106Gof\u001b[109G5e-4.\r\u001b[2C\u001b[1B-\u001b[5GTokenizer\u001b[15Gand\u001b[19GPIECE\u001b[25Goutput\u001b[32Gmatches\u001b[40Gthe\u001b[44Greference\u001b[54Gon\u001b[57Gall\u001b[61G98,009\u001b[68Ganswers.\r\u001b[4C\u001b[1BOver 1024 po\u001b[18Gitio\u001b[23Gs, logits\u001b[33Gstay within 5.05e-5 of the \u001b[61Geference\u001b[70Gand every argmax m\u001b[89Gtches.\u001b[96G\u001b[K\r\u001b[5C\u001b[1Bhe context-limit st\u001b[26Gp works.\u001b[K\u001b[40;1H\u001b[38;3H"]
[75.169, "\u001b]0;\u25d1 Claude Code\u0007"]
