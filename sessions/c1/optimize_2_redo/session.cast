[43.079, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gsection | before ms/fwd | after ms/fwd | after BW |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|---|---|---|---|\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gmatmul q,k,v | 1.626 | 1.411 | 60 GB/s |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gmatmul wo | 0.537 | 0.467 | 61 GB/s |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gmatmul w1+w3 | 2.835 | 2.494 | 61 GB/s |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gmatmul w2 | 1.744 | 1.244 | 61 GB/s |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gmatmul classifier | 1.839 | 1.621 | 61 GB/s |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gattention | 0.221 | 0.136 | |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gargmax | 0.027 | 0.004 | |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6G**total** | **8.89 (2569 ms)** | **7.47 (2160 ms)** | **\u221216%** |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m1024-position FIXED run:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6G| before | after |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|---|---|---|\r\u001b[1B \u001b[2m\u2502\u001b[22m | attention ms/forward (average) | 3.885 | 0.822 |\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m | total | 11455 ms | 8356"]
[43.079, " ms (\u221227%) |\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mOther\u001b[10Gtimings\u001b[18G(wall\u001b[24Gclock,\u001b[31Gnoisy):\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gmeasurement\u001b[18G|\u001b[20Gbefore\u001b[27G|\u001b[29Gafter\u001b[35G|\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m |---|---|---|\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6GLOGITS\u001b[13G1024\u001b[18G(`tests/longctx.py`)\u001b[39G|\u001b[41G12.5\u001b[46Gs\u001b[48G|\u001b[50G8.6\u001b[54Gs\u001b[56G|\r\u001b[1B \u001b[2m\u2502\u001b[22m | FIXED 512 (`te\u001b[21Gts/bench.py`) | 5.06 s | 4.09 s\u001b[53G|\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m |\u001b[6GREADY | ~260 ms |\u001b[24G~100\u2013120 ms |\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m|\u001b[6Gfull\u001b[11G`check.py\u001b[21G--tokens\u001b[30G64\u001b[33G--prompts\u001b[43G3`,\u001b[47Gincluding\u001b[57GPython\u001b[64G|\u001b[66G|\u001b[68G2.4\u20132.9\u001b[76Gs\u001b[78G|\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m All matmuls now run at ~60\u201361 GB/s,\u001b[40Gessentially\u001b[52Gthe\u001b[56G~62\u001b[60GGB/s\u001b[65Gsingle-core\u001b[77Groofline\u001b[86Gmeasured\u001b[95Gabove.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mWhat remains is DRAM bandwidth.\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwc -l NOTES.md.new\u001b[K\r\u001b[1B\u001b[38;2;175;175;"]
[43.08, "175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Galways\u001b[23Gallow\u001b[29Gaccess\u001b[36Gto\u001b[39G\u001b[1m/Users/agentlab/pvc/c1\u001b[62G\u001b[22mfrom\u001b[67Gthis\u001b[72Gproject\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
