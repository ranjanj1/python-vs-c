[555.775, ";145m\"\u001b[38;2;51;51;51m.encode() \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m prev \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m32000\u001b[38;2;51;51;51m)]\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 18 -\u001b[38;2;51;51;51mp.stdin.write(b\"\\n\".join(cmds) + b\"\\nQUIT\\n\"); p.stdin.close()                                         \r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m9\u001b[11G\u001b[38;2;51;51;51mgot = p\u001b[19Gstdout.read().decode(\u001b[41G.splitlines()   \u001b[58G               \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 18 +\u001b[38;2;51;51;51mgot = p.communicate(\u001b[38;2;24;54;145mb\"\\n\"\u001b[38;2;51;51;51m.join(cmds) + \u001b[38;2;24;54;145mb\"\\nQUIT\\n\"\u001b[38;2;51;51;51m)[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m].decode().splitlines()                           \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 19 \u001b[22m bad = \u001b[38;2;0;134;179msum\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mfor"]
