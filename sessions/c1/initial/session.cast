[192.924, "\u001b[H\u001b[8G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m11\u001b[12G\u001b[38;2;51;51;51mstatic \u001b[20Ghar *sbuf;  \u001b[33G         \u001b[43G    \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 411 +\u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mchar\u001b[38;2;51;51;51m *sbuf\u001b[48;2;178;255;178m, *pbuf\u001b[48;2;220;255;220m;                                                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 412 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 413 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179muint32_t\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mhash_bytes\u001b[38;2;0;134;179m(const char *s, size_t n)\u001b[38;2;51;51;51m {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 414 \u001b[22m     \u001b[38;2;0;134;179muint32_t\u001b[38;2;51;51;51m h = \u001b[38;2;0;134;179m2166136261u\u001b[38;2;51;51;51m;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mWriting build\u001b[17Gscript,\u001b[25Gcompiling,\u001b[36Gchecking\u001b[45Glinked\u001b[52Gsymbols\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > build.sh <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m#!/bin/sh\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;1"]
[192.925, "02m# Build the C1 port. No -ffast-math, no -lm, no OpenMP.\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mset -e\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mcd \"$(dirname \"$0\")\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mcc -O3 -mcpu=apple-m1 -std=c11 -D_DARWIN_C_SOURCE -Wall -Wextra -o run_c1 run_c1.c\r\u001b[5C\u001b[1BEOF\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mchmod +x build.sh && ./build.sh && otool -L run_c1 && nm -u run_c1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mWrite build script, compile, check linked symbols\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c"]
[192.925, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m cat > b\u001b[12Gild.sh <<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#!/bin/sh\r\u001b[1B \u001b[2m\u2502\u001b[22m # Build the C1 por\u001b[23G.\u001b[25GN\u001b[27G -ffast-math, no -\u001b[46Gm, no\u001b[52GOpenMP.\r\u001b[1B \u001b[2m\u2502\u001b[22m set -e\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcd \"$(dirname\u001b[18G\"$0\")\"\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcc -O3 -mcpu=apple-m1 -std=c11 -D_DARWIN_C_SOURCE -Wall -Wextra\u001b[68G-o\u001b[71Grun_c1\u001b[78Grun_c1.c\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mchmod +x build.sh && ./build.sh\u001b[36G&&\u001b[39Gotool\u001b[45G-L\u001b[48Grun_c1\u001b[55G&&\u001b[58Gnm\u001b[61G-u\u001b[64Grun_c1\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[192.926, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis command\u001b[15Grequires\u001b[24Gapproval\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mcat, chmod +x build.sh, ./build.sh, otool -L run_c1\u001b[22m, and\u001b[93G\u001b[1mnm -u run_c1\u001b[106G\u001b[22mcommands\u001b[115Gin\r\u001b[6C\u001b[1B\u001b[1m/Users/agentlab/pvc/c1\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
