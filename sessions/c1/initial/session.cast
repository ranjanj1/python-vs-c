[187.609, " + lb > max_token_length * 2 + 2) {                                                                     \r\u001b[1B\u001b[38;2;207;34;46m 467 -\u001b[38;2;51;51;51m        /* cannot be longer than any vocab entry anyway */                                                        \r\u001b[1B\u001b[38;2;207;34;46m 468 -\u001b[38;2;51;51;51m        if (la + lb > max_token_length) return -1;                                                                \r\u001b[1B\u001b[38;2;207;34;46m 469 -\u001b[38;2;51;51;51m    }                                                                                                             \r\u001b[1B\u001b[38;2;207;34;46m 470 -\u001b[38;2;51;51;51m    char tmp[1024];                                                                                               \r\u001b[1B\u001b[38;2;207;34;46m 471 -\u001b[38;2;51;51;51m    char *buf = (la + lb <= sizeof tmp) ? tmp : sbuf;                                                             \r\u001b[1B\u001b[38;2;207;34;46m 472 -\u001b[38;2;51;51;51m    if (buf == sbuf && la + lb > max_token_length * 2 + 2) return -1;                 "]
[187.61, "                            \r\u001b[1B\u001b[38;2;207;34;46m 473 -\u001b[38;2;51;51;51m    memcpy(buf, vocab[a], la);                                                                                    \r\u001b[1B\u001b[38;2;207;34;46m 474 -\u001b[38;2;51;51;51m    memcpy(buf + la, vocab[b], lb);                                                                               \r\u001b[1B\u001b[38;2;207;34;46m 475 -\u001b[38;2;51;51;51m    return lookup(buf, la + lb);                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 466 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(pbuf, vocab[a], la);                                                                                   \r\u001b[1B\u001b[38;2;36;138;61m 467 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(pbuf + la, vocab[b], lb);                                                                              \r\u001b[1B\u001b[38;2;36;138;61m 468 +\u001b[38;2;51;51;51m    \u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m lookup(pbuf, la + lb);           "]
[187.611, "                                                                      \r\u001b[1B\u001b[49m\u001b[2m 469 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 470 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 471 \u001b[22m \u001b[38;2;150;152;150m/* tokens must hold strlen(text)+3 entries */\u001b[39m\u001b[40;1H\u001b[36;2H"]
