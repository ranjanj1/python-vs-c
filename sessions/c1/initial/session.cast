[702.827, "\u001b[H\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mmkdir\u001b[12G-p\u001b[15Gtests\u001b[21G&&\u001b[24Gcat\u001b[28G>\u001b[30Gtests/ref_encode.c\u001b[49G<<'EOF'\r\u001b[1B     /* differential helper: links the unmodified reference (compiled with -DTESTING)\u2026 \u00b7 stopped\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mU\u001b[5Gdate\u001b[22m(tests/difftest.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m2\u001b[30G\u001b[22mlines\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 15 \u001b[22m \u001b[38;2;167;29;93massert\u001b[38;2;51;51;51m p.stdout.readline() == \u001b[38;2;24;54;145mb\"READY\\n\"\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 16 \u001b[22m cmds = [\u001b[38;2;24;54;145mb\"ENCODE \"\u001b[38;2;51;51;51m + t.encode(\u001b[38;2;24;54;145m\"utf-8\"\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"surrogateescape\"\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m texts]\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 17 \u001b[22m cmds += [\u001b[38;2;24;54;145mf\"PIECE \u001b[38;2;51;51;51m{prev}\u001b[38;2;24;54;145m \u001b[38;2;51;51;51m{i}\u001b[38;2;24;54;145m\"\u001b[38;2;51;51;51m.encode() \u001b[38;2;167;29;93mfor\u001b[3"]
[702.828, "8;2;51;51;51m prev \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m32000\u001b[38;2;51;51;51m)]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 18 -\u001b[38;2;51;51;51mp.stdin.write(b\"\\n\".join(cmds) + b\"\\nQUIT\\n\"); p.stdin.close()                                         \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[4G \u001b[6G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 19 -\u001b[38;2;51;51;51mgot = p.stdout.read().decode().splitlines()                                                            \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[4G  \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 18 +\u001b[38;2;51;51;51mgot = p.communicate(\u001b[38;2;24;54;145mb\"\\n\"\u001b[38;2;51;51;51m.join(cmds) + \u001b[38;2;24;54;145mb\"\\nQUIT\\n\"\u001b[38;2;51;51;51m)[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m].decode().splitlines()                           \r\u001b[1C\u001b[1B\u001b[39m\u001b[49m \u001b[4G \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 19 \u001b[22m bad = \u001b[38;2;0;134;179m"]
[702.829, "sum\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m a, b \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got) \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m a != b) + \u001b[38;2;0;134;179mabs\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref) - \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(got))\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 20 \u001b[22m \u001b[38;2;0;134;179mprint\u001b[38;2;51;51;51m(\u001b[38;2;24;54;145mf\"\u001b[38;2;51;51;51m{\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref)}\u001b[38;2;24;54;145m answers compared, \u001b[38;2;51;51;51m{bad}\u001b[38;2;24;54;145m mismatches\"\u001b[38;2;51;51;51m)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 21 \u001b[22m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (i, (a, b)) \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got)):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gtokenizer ma\u001b[20Gches the ref\u001b[33Grence\u001b[3"]
[702.83, "9Gon\u001b[42Gall\u001b[46G98,009\u001b[53Gtest\u001b[58Ganswers,\u001b[67Gso\u001b[70GI'm\u001b[74Gnow\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[1C\u001b[1B reference over a full 1024-posi\u001b[35Gion context, then timing\u001b[60Git.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Logits\u001b[10Gmatch the reference\u001b[30Gwithin\u001b[37G5e-5\u001b[42Gat\u001b[45Gall\u001b[49G1024\u001b[54Gpositions,\u001b[65Gbut\u001b[69Gat\u001b[72Gabout\u001b[78G18\u001b[81Gms\u001b[84Gper\u001b[88Gtoken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[1C\u001b[1B roughly\u001b[11G7 ms the M1's memory bandwidth should allow.\u001b[56GI'm\u001b[60Gnow\u001b[64Gchecking\u001b[73Gwhere\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Benchmarking generation\u001b[27Gspeed\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > tests/bench.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m\"\"\"Rough local timing (the official timing is the harness's). usage: python3 -I tests/bench.py <dir> <cmd...>\"\"\"\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport subprocess, sys, time\u001b[39m\u001b["]
