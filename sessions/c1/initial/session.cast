[1407.376, "\u001b[H\u001b[9G\u001b[38;2;51;51;51m\u001b[2m1\u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[16G\u001b[22m\u001b[38;2;167;29;93mfor\u001b[20G\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m l =\u001b[32G\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m;\u001b[35Gl < (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.n_layers; l++) {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 293 \u001b[22m         rmsnorm(xb, x, W.rms_att_weight + l * dim, dim);\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m...\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[37G\u001b[22m0\u001b[52G0\u001b[71G),\u001b[74Gvld1q_f32(kt + i));\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[32G\u001b[22m    s1 = vfmaq_f32(s1, vld1q_f32(qh + i + \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m), vld1q_f32(kt + i + \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m));\r\u001b[5C\u001b[1B\u001b[2m 328 \u001b[22m                     }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 329 -\u001b[38;2;51;51;51m                    a[t] = hsum(vaddq_f32(s0, s1)) / \u001b[48;2;255;199;199minv_sqrt_hs\u001b[48;2;255;220;220m;                                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 329 +\u001b[38;2;51;51;51m            "]
[1407.378, "        a[t] = hsum(vaddq_f32(s0, s1)) / \u001b[48;2;178;255;178msqrt_hs\u001b[48;2;220;255;220m;                                         \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m0\u001b[24G\u001b[22m \u001b[26G  }\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[24G\u001b[22m}\u001b[26G\u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m {\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[28G\u001b[22m\u001b[38;2;167;29;93mfor\u001b[32G\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mi\u001b[35Gt\u001b[38;2;51;51;51m t = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m;\u001b[44Gt <= pos; t++) {\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[32G\u001b[22m\u001b[38;2;0;134;179mcons\u001b[38Gfloat\u001b[38;2;51;51;51m *kt = kb + (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)t * kv_dim;\r\u001b[8C\u001b[1B\u001b[2m4\u001b[32G\u001b[22m\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m s = \u001b[38;2;0;134;179m0.0f\u001b[47G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 335 \u001b[22m                     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m i = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m; i < head_size; i++) s += qh[i] * kt[i];\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 336 -\u001b[38;2;51;51;51m                    a[t] "]
[1407.379, "= s / \u001b[48;2;255;199;199minv_sqrt_hs\u001b[48;2;255;220;220m;                                                           \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 336 +\u001b[38;2;51;51;51m                    a[t] = s / \u001b[48;2;178;255;178msqrt_hs\u001b[48;2;220;255;220m;                                                               \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m7\u001b[24G\u001b[22m    }\r\u001b[8C\u001b[1B\u001b[2m8\u001b[24G\u001b[22m}\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 339 \u001b[22m             softmax(a, pos + \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m);\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll \u001b[8Ghecks still pass after \u001b[33Ge ke\u001b[38Gnel cha\u001b[47Ge. LOGITS ov\u001b[60Gr 1024 positions\u001b[77Gdropped\u001b[85Gfrom\u001b[90G19\u001b[93Gs\u001b[95Gto\u001b[98G12.5\u001b[103Gs.\u001b[106GNow\u001b[110GI'll\r\u001b[2C\u001b[1Bexercise\u001b[12Gthe\u001b[16G\u001b[38;2;87;105;247mcontext\u001b[24G\u001b[39mstop\u001b[29Gwith\u001b[34Ga\u001b[36Gprompt\u001b[43Glong\u001b[48Genough\u001b[55Gto\u001b[58Greach\u001b[64Gseq_len.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m"]
[1407.38, "\u23fa\u001b[3G\u001b[39mAll the behaviours I tested\u001b[31Gcheck\u001b[37Gout,\u001b[42Gso\u001b[45GI'm\u001b[49Grunning\u001b[57Gthe\u001b[61Gfinal\u001b[67Gdefault\u001b[75Gcheck,\u001b[82Gcleaning\u001b[91Gup\u001b[94Gthe\u001b[98Gscratch\u001b[106Gvariants,\u001b[116Gand\r\u001b[2C\u001b[1Bthen\u001b[8Gwriting\u001b[16GNOTES.md.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Removing scratch variants and running default check\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ rm -rf /tmp/c1var && python3 check.py -- ./run_c1 && ls\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;171;43;63m\u273b\u001b[39m \u001b[38;2;171;43;63mWaiting for API response\u001b[38;2;102;102;102m \u00b7 w\u001b[32Gll\u001b[35Gretry in 2m 40s \u00b7 check you\u001b[63G network\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
