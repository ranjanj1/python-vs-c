[531.442, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 15 \u001b[22m \u001b[38;2;167;29;93massert\u001b[38;2;51;51;51m p.stdout.readline() == \u001b[38;2;24;54;145mb\"READY\\n\"\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 16 \u001b[22m cmds = [\u001b[38;2;24;54;145mb\"ENCODE \"\u001b[38;2;51;51;51m + t.encode(\u001b[38;2;24;54;145m\"utf-8\"\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"surrogateescape\"\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m texts]\r\u001b[1B\u001b[2m 17 \u001b[22m cmds += [\u001b[38;2;24;54;145mf\"PIECE \u001b[38;2;51;51;51m{prev}\u001b[38;2;24;54;145m \u001b[38;2;51;51;51m{i}\u001b[38;2;24;54;145m\"\u001b[38;2;51;51;51m.encode() \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m prev \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m32000\u001b[38;2;51;51;51m)]\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 18 -\u001b[38;2;51;51;51mp.stdin.write(b\"\\n\".join(cmds) + b\"\\nQUIT\\n\"); p.stdin.clo"]
[531.442, "se()                                                     \r\u001b[1B\u001b[38;2;207;34;46m 19 -\u001b[38;2;51;51;51mgot = p.stdout.read().decode().splitlines()                                                                        \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 18 +\u001b[38;2;51;51;51mgot = p.communicate(\u001b[38;2;24;54;145mb\"\\n\"\u001b[38;2;51;51;51m.join(cmds) + \u001b[38;2;24;54;145mb\"\\nQUIT\\n\"\u001b[38;2;51;51;51m)[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m].decode().splitlines()                                       \r\u001b[1B\u001b[49m\u001b[2m 19 \u001b[22m bad = \u001b[38;2;0;134;179msum\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m a, b \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got) \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m a != b) + \u001b[38;2;0;134;179mabs\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref) - \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(got))\r\u001b[1B\u001b[2m 20 \u001b[22m \u001b[38;2;0;134;179mprint\u001b[38;2;51;51;51m(\u001b[38;2;24;54;145mf\"\u001b[38;2;51;51;51m{\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref)}\u001b"]
