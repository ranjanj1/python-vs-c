[189.169, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m4\u001b[13G\u001b[22mSingle thread. float32 weights\u001b[44Gand activation\u001b[59G,\u001b[61Gbatch size \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, one token per\r\u001b[7C\u001b[1B\u001b[2m5\u001b[13G\u001b[22mforward pass, KV\u001b[30Gcache identic\u001b[44Gl to th\u001b[52G ref\u001b[57Grence.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[13G\u001b[22mProtocol: see INTERFACE.md. */\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdlib.h>\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[22G\u001b[22m\u001b[38;2;24;54;145mr\u001b[24Gng.h>\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +624 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m3\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m10\u001b[32G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 463 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;5"]
[189.17, "1m\u001b[2m 464 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mpair_id\u001b[38;2;0;134;179m(int a, int b)\u001b[38;2;51;51;51m {\r\u001b[8C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m    \u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m la = vocab_len[a], lb = vocab_len[b];\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 466 -\u001b[38;2;51;51;51m    if (la + lb > max_token_length * 2 + 2) {                                                         \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 467 -\u001b[38;2;51;51;51m        /* cannot be longer than any vocab entry anyway */                                            \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m8\u001b[16G\u001b[38;2;51;51;51m  \u001b[19G if\u001b[23G(la + lb > max_tok\u001b[43G_length) return\u001b[59G-1;\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m9\u001b[16G\u001b[38;2;51;51;51m}\u001b[20G  \u001b[23G      \u001b[30G  \u001b[33G      \u001b[40G    \u001b[45G   \u001b[49G     \u001b[55G     \u001b[61G      \u001b[68G  \r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m70\u001b[16G\u001b[38;2;51;51;51mchar tmp[1024];\u001b[32G \u001b[34G                 \u001b[52G      \u001b[59G   \r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m71\u001b[16G\u001b[38;2;51;51;51mchar\u001b[21G*buf\u001b[26G=\u001b[28"]
[189.172, "G(la\u001b[32G+\u001b[34Glb\u001b[37G<=\u001b[40Gsizeof\u001b[47Gtmp)\u001b[52G?\u001b[54Gtmp\u001b[58G:\u001b[60Gsbuf;\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m2\u001b[16G\u001b[38;2;51;51;51mif (buf == sbuf\u001b[32G&&\u001b[35Gla\u001b[38G+\u001b[40Glb\u001b[43G>\u001b[45Gmax_token_length\u001b[62G*\u001b[64G2\u001b[66G+\u001b[68G2)\u001b[71Greturn\u001b[78G-1;\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m3\u001b[16G\u001b[38;2;51;51;51mmemcpy(buf,\u001b[28Gvocab[a], la);    \u001b[47G    \u001b[52G \u001b[54G   \u001b[58G \u001b[60G     \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m4\u001b[16G\u001b[38;2;51;51;51mmemcpy(buf\u001b[27G+ la, voc\u001b[37Gb[b],\u001b[43Glb);              \u001b[62G \u001b[64G \u001b[66G \u001b[68G  \u001b[71G      \u001b[78G   \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m5\u001b[16G\u001b[38;2;51;51;51mr\u001b[18Gturn lookup(buf, la\u001b[38G+ lb);\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 466 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(pbuf, vocab[a], la);                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 467 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(pbuf + la, vocab[b], lb);                                                                  \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[16G\u001b[38;2;167;29;93mr"]
