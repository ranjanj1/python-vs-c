[1297.473, "\u001b[H     \u001b[38;2;51;51;51m\u001b[2m 291 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 292 \u001b[22m     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m l = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m; l < (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)cfg.n_layers; l++) {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 293 \u001b[22m         rmsnorm(xb, x, W.rms_att_weight + l * dim, dim);\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 326 \u001b[22m                         s0 = vfmaq_f32(s0, vld1q_f32(qh + i), vld1q_f32(kt + i));\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 327 \u001b[22m                         s1 = vfmaq_f32(s1, vld1q_f32(qh + i + \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m), vld1q_f32(kt + i + \u001b[38;2;0;134;179m4\u001b[38;2;51;51;51m));\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m 328 \u001b[22m                     }\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 329 -\u001b[38;2;51;51;51m                    a[t] = hsum(vaddq_f32(s0, s1)) / \u001b[48;2;255;199;199minv_sqrt_hs\u001b[48;2;255;220;220m;                                  "]
