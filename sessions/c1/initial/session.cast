[715.024, "1m.encode() \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m prev \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m32000\u001b[38;2;51;51;51m)]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m8\u001b[11G\u001b[38;2;51;51;51mp.stdin\u001b[19Gwrite(b\"\\n\".join(cmds\u001b[41G + b\"\\nQUIT\\n\");\u001b[58Gp.stdin.close()\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 19 -\u001b[38;2;51;51;51mgot = p.stdout.read().decode().splitlines()                                                            \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 18 +\u001b[38;2;51;51;51mgot = p.communicate(\u001b[38;2;24;54;145mb\"\\n\"\u001b[38;2;51;51;51m.join(cmds) + \u001b[38;2;24;54;145mb\"\\nQUIT\\n\"\u001b[38;2;51;51;51m)[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m].decode().splitlines()                           \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m19\u001b[11G\u001b[22mbad = \u001b[38;2;0;134;179msum\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mfor\u001b[38;2;51;"]
[715.025, "51;51m a, b \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got) \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m a != b) + \u001b[38;2;0;134;179mabs\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref) - \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(got))\r\u001b[7C\u001b[1B\u001b[2m0\u001b[11G\u001b[22m\u001b[38;2;0;134;179mprint\u001b[38;2;51;51;51m(\u001b[38;2;24;54;145mf\"\u001b[38;2;51;51;51m{\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref)}\u001b[38;2;24;54;145m answers compared, \u001b[38;2;51;51;51m{bad}\u001b[38;2;24;54;145m mismatches\"\u001b[38;2;51;51;51m)\r\u001b[5C\u001b[1B\u001b[2m 21 \u001b[22m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (i, (a, b)) \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got)):\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe tokenizer m\u001b[19Gtches\u001b[25Gthe reference\u001b[39Gon all 98,009\u001b[54Gest answers,\u001b[67Gso\u001b[70GI'm\u001b[74Gnow\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[2C\u001b[1Breference\u001b[13Gover\u001b[18Ga\u001b[20G"]
[715.025, "full\u001b[25G1024-position\u001b[39Gcontext,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mL\u001b[5Ggits match\u001b[20Greference within 5e-5\u001b[42Gat a\u001b[47Gl\u001b[49G1024 positions, but at about 18 ms per\u001b[88Gt\u001b[90Gken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[2C\u001b[1Broughly\u001b[11G7\u001b[13Gms\u001b[16Gthe\u001b[20GM1's\u001b[25Gmemory\u001b[32Gbandwidth\u001b[42Gshould\u001b[49Gallow.\u001b[56GI'm\u001b[60Gnow\u001b[64Gchecking\u001b[73Gwhere\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Benchmarking generation speed\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > tests/bench.py <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\"\"\"Rough local timing (the official timing is the harness's). usage: python3 -I tests/bench.py <dir> <cmd...>\"\"\"\r\u001b[5C\u001b[1Bimport subprocess, sys, time\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102md = sys.argv[1]; cmd = sys.argv[2:]\r\u001b[5C\u001b[1Bt0 = time.time()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp = su\u001b[13Gpr\u001b[16Gcess.Popen(cmd + [f\"{d}/model.bin\", f\"{d}/tokenizer.bin\"], stdi\u2026\r\u001b[17C\u001b[2B"]
