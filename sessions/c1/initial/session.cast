[920.82, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6Gabout 11.4 ms per forward, weight streaming runs near 38 GB/s,\u001b[69Gwell\u001b[74Gbelow\u001b[80Gwhat\u001b[85Gan\u001b[88GM1\u001b[91Gcore\u001b[96Gcan\u001b[100Gsustain.\u001b[109GI'll\u001b[114Gtry\u001b[118Ga\r\u001b[2C\u001b[1Bfew row-blocking and prefetch variants of the matvec\u001b[56Gkernel\u001b[63Gnext.\r\u001b[2C\u001b[4BEigh\u001b[8G rows is\u001b[17Gslower (17.9 ms). I'll check\u001b[46Grun-to-run noi\u001b[61Ge and\u001b[67Gtry fewer concurrent rows.\u001b[94G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo\u001b[7Grows\u001b[12Gat\u001b[15Ga\u001b[17Gtime\u001b[22Gwith\u001b[27Gfour\u001b[32Gaccumulators\u001b[45Geach\u001b[50Gis\u001b[53Gclearly\u001b[61Gbest:\u001b[67G8.75\u001b[72Gms,\u001b[76Gversus\u001b[83G11.8\u001b[88Gms\u001b[91Gbefore.\u001b[99GI'll\u001b[104Gtry\u001b[108Gwider\u001b[114Gloads\r\u001b[1B \u001b[3G(\u001b[38;2;87;105;247mvld1q_f32_x4\u001b[39m) and a d\u001b[26Gep\u001b[29Gr unroll on top\u001b[45Gof that.\u001b[54G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gscript\u001b[14Gbroke\u001b[20Gon\u001b[23Ga\u001b[25Gshell\u001b[31Gword-splitting\u001b[46Gdifference\u001b[57"]
[920.821, "G(zsh\u001b[62Gdoesn't\u001b[70Gsplit\u001b[76G\u001b[38;2;87;105;247m$c\u001b[39m).\u001b[81GRerunning\u001b[91Gunder\u001b[97Gbash:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mR\u001b[5Gbuilding ld1x4\u001b[20Gvariants and\u001b[33Gbenchmarking\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/c1var && bash -c 'for c in \"1 1\" \"1 2\" \"2 1\" \"2 2\" \"3 1\"; do set -- $c; cc -O3 -mcpu=apple-m1 \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m-D_DARWIN_C_SOURCE -DR=$1 -DU=$2 -o vx_$1_$2 vx.c || exit 1; done'\r\u001b[5C\u001b[1Bfor i in 1 2; do for b in ./vr_2 ./vx_1_1 ./vx_1_2 ./vx_2_1 ./vx_2_2 ./vx_3_1; do echo \"== $b $(python3 -I \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m/Users/agentlab/pvc/c\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b["]
[920.822, "1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mRebuild ld1x4 variants and benchmark\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cd /tmp/c1var && bash\u001b[26G-c\u001b[29G'for\u001b[34Gc\u001b[36Gin\u001b[39G\"1\u001b[42G1\"\u001b[45G\"1\u001b[48G2\"\u001b[51G\"2\u001b[54G1\"\u001b[57G\"2\u001b[60G2\"\u001b[63G\"3\u001b[66G1\";\u001b[70Gdo\u001b[73Gset\u001b[77G--\u001b[80G$c;\u001b[84Gcc\u001b[87G-O3\u001b[91G-mcpu=apple-m1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-D_DARWIN_C_SOURCE\u001b[23G-DR=$1\u001b[30G-DU=$2\u001b[37G-o\u001b[40Gvx_$1_$2\u001b[49Gvx.c\u001b[54G||\u001b[57Gexit\u001b[62G1;\u001b[65Gdone'\r\u001b[1B \u001b[2m\u2502\u001b[22m for i \u001b[11Gn 1 2; do for\u001b[25Gb in ./v\u001b[34G_2 ./vx_1_1\u001b[46G./vx_1_2 ./vx_2_1 ./vx_2_2 ./vx_3_1; do echo"]
[920.823, "\u001b[91G\"== $b $(python3\u001b[108G-I\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/Users/agentlab/pvc/c1/tests/bench.py\u001b[42G/Users/agentlab/pvc/c1\u001b[65G$b\u001b[68G2>&1\u001b[73G|\u001b[75Gsed\u001b[79G-n\u001b[82G3p)\";\u001b[88Gdone;\u001b[94Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;"]
