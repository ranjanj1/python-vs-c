[224.637, "\u001b[H \u001b[2m\u2502\u001b[22m \"\"\"Differential\u001b[20Gtest:\u001b[26Grun_c1\u001b[33Gvs\u001b[36Gthe\u001b[40Gunmodified\u001b[51Greference\u001b[61Gfor\u001b[65GENCODE\u001b[72Gand\u001b[76GPIECE.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22musage: python3 -I tests/difftest.py\u001b[40G<repo_dir>\"\"\"\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport random,\u001b[19Gsubprocess,\u001b[31Gsys\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22md\u001b[6G= sys.argv[1]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrandom.seed(1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22malpha = list(\"abcdefghijklmnopqrstuvwxyz ABCXYZ.,!?'\\\"\\t0123456789-\") + [\"\u00e9\", \"\u00ef\", \"\u65e5\", \"\u672c\", \"\u8a9e\", \"\ud83d\ude00\", \"\u00df\",\u001b[116G\"\u00a0\",\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\u001b[6G \"]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtexts = [\"\",\u001b[17G\"\u001b[19G\",\u001b[22G\"\u001b[25G\",\u001b[28G\"a\",\u001b[33G\"Once\u001b[39Gupon\u001b[44Ga\u001b[46Gtime\",\u001b[53G\"\\x7f\",\u001b[61G\"\\xc3\",\u001b[69G\"abc\\x80def\"]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor _ in\u001b[13Grange(2000):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  texts.append(\"\".join(random.choice(alpha)\u001b[50Gfor\u001b[54G_\u001b[56Gin\u001b[59Grange(random.randint(1,\u001b[83G60))))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtexts.append(\"\".join(random.choice(alpha)\u001b[46Gfor\u001b[50G_\u001b[52Gin\u001b[55Grange(3000)))\r\u001b[1B \u001b[2m\u2502\u001b[22m texts = [t for t\u001b"]
[224.638, "[21Gin\u001b[24Gtexts\u001b[30Gif\u001b[33G\"\\n\"\u001b[38Gnot\u001b[42Gin\u001b[45Gt]\r\u001b[1B \u001b[2m\u2502\u001b[22m raw = (\"\\n\".join(texts)\u001b[28G+\u001b[30G\"\\\u001b[33G\").encode(\"utf-8\",\u001b[52G\"surrogateescape\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mref = subprocess.run([f\"{d}/tests/ref_encode\",\u001b[51Gf\"{d}/tokenizer.bin\"],\u001b[74Ginput=raw,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcapture_output=True).stdout.decode().splitlines()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G= subprocess.Popen([f\"{d}/run_c1\", f\"{d}/model.bin\",\u001b[59Gf\"{d}/tokenizer.bin\"],\u001b[82Gstdin=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mstdout=subprocess.PIPE)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert p.stdout.readline() == b\"READY\\n\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcmds = [b\"ENCODE\u001b[21G\"\u001b[23G+\u001b[25Gt.encode(\"utf-8\",\u001b[43G\"surrogateescape\")\u001b[62Gfor\u001b[66Gt\u001b[68Gin\u001b[71Gtexts]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcmds += [f\"PIECE {prev} {i}\".encode() for prev in range(3) for\u001b[67Gi\u001b[69Gin\u001b[72Grange(32000)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write(b\"\\n\".join(cmds) + b\"\\nQUIT\\n\");\u001b[51Gp.stdin.close()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mgot\u001b[8G=\u001b[10Gp.stdout.read().decode().splitlines()\r\u001b[1C\u001b[1B\u001b[2m"]
[224.639, "\u2502\u001b[22m bad = sum(1 for a, b\u001b[25Gin\u001b[28Gzip(ref,\u001b[37Ggot)\u001b[42Gif\u001b[45Ga\u001b[47G!=\u001b[50Gb)\u001b[53G+\u001b[55Gabs(len(ref)\u001b[68G-\u001b[70Glen(got))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f\"{len(ref)}\u001b[23Ganswers\u001b[31Gcompared,\u001b[41G{bad}\u001b[47Gmismatches\")\r\u001b[1B \u001b[2m\u2502\u001b[22m for (i, (a, b)) in enume\u001b[29Gate(zip(ref, got)):\u001b[49G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mif\u001b[11Ga\u001b[13G!=\u001b[16Gb:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         print(i, cmds[i][:80],\u001b[35Ga[:80],\u001b[43Gb[:80]);\u001b[52Gbreak\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msys.exit(1\u001b[15Gif\u001b[18Gbad\u001b[22Gelse\u001b[27G0)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m cc -O2\u001b[11G-D_DARWIN_C_SOURCE -o t\u001b[35Gs\u001b[37Gs/ref_\u001b[44Gncode\u001b[50Gtests/ref_encod\u001b[66G.c 2>&1 |\u001b[76Ggrep\u001b[81G-v\u001b[84Gwarning\u001b[92G|\u001b[94Ghead;\u001b[100Gpython3\u001b[108G-I\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtests/difftest.py\u001b[22G\"$PWD\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[224.639, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11GUnicode\u001b[19Gwhitespace\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
