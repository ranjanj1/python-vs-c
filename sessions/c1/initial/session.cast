[531.397, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 408 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m max_token_length;\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m 409 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mchar\u001b[38;2;51;51;51m byte_pieces[\u001b[38;2;0;134;179m512\u001b[38;2;51;51;51m];\r\u001b[7C\u001b[1B\u001b[2m10\u001b[19G\u001b[22m\u001b[38;2;0;134;179mi\u001b[21Gt\u001b[38;2;51;51;51m *htab; \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m hmask;\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 411 -\u001b[38;2;51;51;51mstatic char *sbuf;                                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 411 +\u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mchar\u001b[38;2;51;51;51m *sbuf\u001b[48;2;178;255"]
[531.398, ";178m, *pbuf\u001b[48;2;220;255;220m;                                                                             \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 412 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 413 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179muint32_t\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mhash_bytes\u001b[38;2;0;134;179m(const char *s, size_t n)\u001b[38;2;51;51;51m {\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22m    \u001b[38;2;0;134;179muint32_t\u001b[38;2;51;51;51m h = \u001b[38;2;0;134;179m2166136261u\u001b[38;2;51;51;51m;\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNo math-library symbols\u001b[27Gare\u001b[31Gimported.\u001b[41GRunning\u001b[49Gthe\u001b[53Gchecker:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mValidation passes, with\u001b[27Ga\u001b[29Gworst\u001b[35Glogit\u001b[41Gerror\u001b[47Gof\u001b[50G2.9e-5\u001b[57Gagainst\u001b[65Ga\u001b[67G5e-4\u001b[72Gtolerance.\u001b[83GNext\u001b[88GI'm\u001b[92Gchecking\u001b[101GPIECE\u001b[107Gagainst\u001b[115Gthe\r\u001b[2C\u001b[1Bfixture\u001b[11Gpieces\u001b[18Gand\u001b[22Gcomparing\u001b[32Gthe"]
[531.399, "\u001b[36Gtokenizer\u001b[46Gand\u001b[50Glogits\u001b[57Gto\u001b[60Gthe\u001b[64Greference.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe test deadlocked:\u001b[24Git\u001b[27Gwrites\u001b[34Gall\u001b[38Ginput\u001b[44Gbefore\u001b[51Greading\u001b[59Gany\u001b[63Goutput,\u001b[71Gso\u001b[74Gthe\u001b[78Gpipes\u001b[84Gfill\u001b[89Gup.\u001b[93GFixing\u001b[100Gthat\u001b[105Gwith\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mcommunicate\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mStop Task\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mmkdir\u001b[12G-p\u001b[15Gtests\u001b[21G&&\u001b[24Gcat\u001b[28G>\u001b[30Gtests/ref_encode.c\u001b[49G<<'EOF'\r\u001b[1B \u001b[3G   /* differential\u001b[22Ghelper:\u001b[30Glinks\u001b[36Gthe\u001b[40Gunmodified\u001b[51Greference\u001b[61G(compiled\u001b[71Gwith\u001b[76G-DTESTING)\u2026\u001b[88G\u00b7\u001b[90Gstopped\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(tests/difftest.\u001b[26Gy)\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;245;149;117mZesting\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
