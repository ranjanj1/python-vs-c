[1296.832, "\u001b[H\u001b[38;2;102;102;102m  \u23bf  $ cat > tests/context.py <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\"\"\"Exercise the 'context' stop: long prompt + GENERATE until seq_len. usage: python3 -I tests/context.py <dir>\"\"\"\r\u001b[5C\u001b[1Bimport subprocess, sys\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102md = sys.argv[1]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp = subprocess.Popen([f\"{d}/run_c1\", f\"{d}/model.bin\", f\"{d}/tokenizer.bin\"], stdin=subprocess.PIPE, stdout=subpr\u2026\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mTest context-"]
[1296.833, "limit stop behavior\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcat > tests/context.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\"\"Exercise the 'context' stop: long prompt + GENERATE until seq_len. usage: python3 -I tests/context.py <dir>\"\"\"\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport subprocess, sys\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22md\u001b[6G= sys.argv[1]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G= subprocess.Popen([f\"{d}/run_c1\",\u001b[41Gf\"{d}/model.bin\",\u001b[59Gf\"{d}/tokenizer.bin\"],\u001b[82Gstdin=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mstdout=subprocess.PIPE, text=True)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert p.stdout.readline() == \"READY\\n\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtext = \" \".join([\"one two"]
[1296.834, " three four five six\u001b[50Gseven\u001b[56Geight\u001b[62Gnine\u001b[67Gten\"]\u001b[73G*\u001b[75G100)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor words in (980, 1005, 1100):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  t = \" \".join(text.split()[:words])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  p.stdin.write(f\"ENCODE {t}\\n\"); p.stdin.flush(); n = len(p.stdout.readline().split()) - 1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  p.stdin.write(f\"GENERATE\u001b[33G500\u001b[37G{t}\\n\");\u001b[46Gp.stdin.flush();\u001b[63Gc\u001b[65G=\u001b[67G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  while True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      s = p.stdout.readline().strip()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gnot\u001b[19Gs.startswith(\"T\u001b[35G\"):\u001b[39Gbreak\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         c += 1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(f\"prompt\u001b[23Gtokens\u001b[30G{n}:\u001b[35G{s}\u001b[39G(expected\u001b[49G'DONE\u001b[55G{max(0,\u001b[63G1024\u001b[68G-\u001b[70Gn\u001b[72G+\u001b[74G1)}\u001b[78Gcontext'\u001b[87Gunless\u001b[94Gstop)\")\r\u001b[1B \u001b[2m\u2502\u001b[22m p.stdin.wri\u001b[16Ge(\"QUIT\\n\"); p.stdin.flush(); p.wait()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15Gtests/context.py\u001b[32G\"$PWD\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c"]
[1296.834, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mQuoted\u001b[9Gtext\u001b[14Gin\u001b[17Gthis\u001b[22Gcommand\u001b[30Gcan't\u001b[36Gbe\u001b[39Gchecked\u001b[47Gbefore\u001b[54Git\u001b[57Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
