[187.773, "m<stdlib.h>\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<string.h>\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m\u2026 +624 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m3\u001b[22m lines, removed \u001b[1m10\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 463 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 464 \u001b[22m \u001b[38;2;0;134;179mstatic\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mpair_id\u001b[38;2;0;134;179m(int a, int b)\u001b[38;2;51;51;51m {\u001b[47G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 465 \u001b[22m     \u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m la = vocab_len[a], lb = vocab_len[b];\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 466 -\u001b[38;2;51;51;51m    if (la + lb > max_token_length * 2 + 2) {                                                         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 467 -\u001b[38;2;51;51;51m        /* cannot be longer t"]
[187.774, "han any vocab entry anyway */                                            \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 468 -\u001b[38;2;51;51;51m        if (la + lb > max_token_length) return -1;                                                    \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 469 -\u001b[38;2;51;51;51m    }                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 470 -\u001b[38;2;51;51;51m    char tmp[1024];                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 471 -\u001b[38;2;51;51;51m    char *buf = (la + lb <= sizeof tmp) ? tmp : sbuf;                                                 \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 472 -\u001b[38;2;51;51;51m    if (buf == sbuf && la + lb > max_token_length * 2 + 2) return -1;                                 \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 473 -\u001b[38;2;51;51;51m    memcpy(buf, vocab[a], la);                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;207;3"]
[187.775, "4;46m 474 -\u001b[38;2;51;51;51m    memcpy(buf + la, vocab[b], lb);                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 475 -\u001b[38;2;51;51;51m    return lookup(buf, la + lb);                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 466 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(pbuf, vocab[a], la);                                                                       \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 467 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(pbuf + la, vocab[b], lb);                                                                  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 468 +\u001b[38;2;51;51;51m    \u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m lookup(pbuf, la + lb);                                                                     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 469 \u001b[22m }\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 470 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 471 \u001b[22m \u001b[38;2;150;152;150m/* tokens must hold strlen(text"]
