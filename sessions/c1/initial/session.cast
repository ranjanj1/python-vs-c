[552.754, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mStop Task\u001b[13G\u001b[22m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mmkdir\u001b[12G-p tests && cat > tests\u001b[37Gef\u001b[40Gencode.c <<'EOF'\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  /* differential helper: links the\u001b[40Gunmodified\u001b[51Greference\u001b[61G(compiled\u001b[71Gwith\u001b[76G-DTESTING)\u2026\u001b[88G\u00b7\u001b[90Gstopped\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mUpdate\u001b[22m(tes\u001b[14Gs/difft\u001b[22Gst.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 15 \u001b[22m \u001b[38;2;167;29;93massert\u001b[38;2;51;51;51m p.stdout.readline() == \u001b[38;2;24;54;145mb\"READY\\n\"\u001b[52G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 16 \u001b[22m cmds = [\u001b[38;2;24;54;145mb\"ENCODE \"\u001b[38;2;51;51;51m + t.encode(\u001b[38;2;24;54;145m\"utf-8\"\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"surrogateescape\"\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m texts]\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 17 \u001b[22m cmds += [\u001b[38;2;24;54;145mf\"PIECE \u001b[38;2;51;51;51m{prev}"]
[552.755, "\u001b[38;2;24;54;145m \u001b[38;2;51;51;51m{i}\u001b[38;2;24;54;145m\"\u001b[38;2;51;51;51m.encode() \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m prev \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m32000\u001b[38;2;51;51;51m)]\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 18 -\u001b[38;2;51;51;51mp.stdin.write(b\"\\n\".join(cmds) + b\"\\nQUIT\\n\"); p.stdin.close()                                         \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 19 -\u001b[38;2;51;51;51mgot = p.stdout.read().decode().splitlines()                                                            \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 18 +\u001b[38;2;51;51;51mgot = p.communicate(\u001b[38;2;24;54;145mb\"\\n\"\u001b[38;2;51;51;51m.join(cmds) + \u001b[38;2;24;54;145mb\"\\nQUIT\\n\"\u001b[38;2;51;51;51m)[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m].decode().splitlines()                 "]
[552.756, "          \r\u001b[1C\u001b[1B\u001b[39m\u001b[49m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 19 \u001b[22m bad = \u001b[38;2;0;134;179msum\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m a, b \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got) \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m a != b) + \u001b[38;2;0;134;179mabs\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref) - \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(got))\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 20 \u001b[22m \u001b[38;2;0;134;179mprint\u001b[38;2;51;51;51m(\u001b[38;2;24;54;145mf\"\u001b[38;2;51;51;51m{\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref)}\u001b[38;2;24;54;145m answers compared, \u001b[38;2;51;51;51m{bad}\u001b[38;2;24;54;145m mismatches\"\u001b[38;2;51;51;51m)\u001b[67G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 21 \u001b[22m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (i, (a, b)) \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got)):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m"]
[552.757, "\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gtokenizer ma\u001b[20Gches the reference on\u001b[42Gall 98,009 test answers, so I'm now\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[1C\u001b[1B refere\u001b[10Gce over\u001b[18Ga\u001b[20Gfull\u001b[25G1024-position\u001b[39Gcontext,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Comparing full-context logits with \u001b[39Geference\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > tests/ref_logits.c <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m/* differential helper: unmodified reference forward(); writes n x vocab logits.\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102musage: ref_logits model.bin out.f32 id id ... */\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m#define TESTING\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m#include \"../reference/run.c\"\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mint main(int argc, char **argv) {\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mTransformer t; build_transformer(&t, argv[1]);\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mFILE *f\u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87"]
