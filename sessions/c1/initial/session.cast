[1139.196, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gtokenizer\u001b[17Gmatches\u001b[25Gthe\u001b[29Greference\u001b[39Gon\u001b[42Gall\u001b[46G98,009\u001b[53Gtest\u001b[58Ganswers,\u001b[67Gso\u001b[70GI'm\u001b[74Gnow\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[2C\u001b[1Breference\u001b[13Gover\u001b[18Ga\u001b[20Gfull\u001b[25G1024-position\u001b[39Gcontext,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the reference\u001b[30Gwithin\u001b[37G5e-5\u001b[42Gat\u001b[45Gall\u001b[49G1024\u001b[54Gpositions,\u001b[65Gbut\u001b[69Gat\u001b[72Gabout\u001b[78G18\u001b[81Gms\u001b[84Gper\u001b[88Gtoken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[2C\u001b[1Broughly\u001b[11G7\u001b[13Gms\u001b[16Gthe\u001b[20GM1's\u001b[25Gmemory\u001b[32Gbandwidth\u001b[42Gshould\u001b[49Gallow.\u001b[56GI'm\u001b[60Gnow\u001b[64Gchecking\u001b[73Gwhere\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt about 11.4 ms per\u001b[24Gforward,\u001b[33Gweight\u001b[40Gstreaming\u001b[50Gruns\u001b[55Gnear\u001b[60G38\u001b[63GGB/s,\u001b[69Gwell\u001b[74Gbelow\u001b[80Gwhat\u001b[85Gan\u001b[88GM1\u001b[91Gcore\u001b[96Gca"]
[1139.197, "n\u001b[100Gsustain.\u001b[109GI'll\u001b[114Gtry\u001b[118Ga\r\u001b[2C\u001b[1Bfew\u001b[7Grow-blocking\u001b[20Gand\u001b[24Gprefetch\u001b[33Gvariants\u001b[42Gof\u001b[45Gthe\u001b[49Gmatvec\u001b[56Gkernel\u001b[63Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEight rows is slower\u001b[24G(17.9\u001b[30Gms).\u001b[35GI'll\u001b[40Gcheck\u001b[46Grun-to-run\u001b[57Gnoise\u001b[63Gand\u001b[67Gtry\u001b[71Gfewer\u001b[77Gconcurrent\u001b[88Grows.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo rows at a time with\u001b[27Gfour\u001b[32Gaccumulators\u001b[45Geach\u001b[50Gis\u001b[53Gclearly\u001b[61Gbest:\u001b[67G8.75\u001b[72Gms,\u001b[76Gversus\u001b[83G11.8\u001b[88Gms\u001b[91Gbefore.\u001b[99GI'll\u001b[104Gtry\u001b[108Gwider\u001b[114Gloads\r\u001b[2C\u001b[1B(\u001b[38;2;87;105;247mvld1q_f32_x4\u001b[39m)\u001b[18Gand\u001b[22Ga\u001b[24Gdeeper\u001b[31Gunroll\u001b[38Gon\u001b[41Gtop\u001b[45Gof\u001b[48Gthat.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe script broke on a\u001b[25Gshell\u001b[31Gword-splitting\u001b[46Gdifference\u001b[57G(zsh\u001b[62Gdoesn't\u001b[70Gsplit\u001b[76G\u001b[38;2;87;105;247m$c\u001b[39m"]
[1139.197, ").\u001b[81GRerunning\u001b[91Gunder\u001b[97Gbash:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo rows per pass with\u001b[26G64-byte\u001b[34Gloads\u001b[40Ghits\u001b[45Gabout\u001b[51G8.8\u001b[55Gms\u001b[58Gper\u001b[62Gforward\u001b[70G(roughly\u001b[79G50\u001b[82GGB/s),\u001b[89Gclose\u001b[95Gto\u001b[98Gone\u001b[102Gcore's\u001b[109Glimit,\u001b[116Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gadopting\u001b[16Git\u001b[19Gand\u001b[23Gmoving\u001b[30Gthe\u001b[34Gkernel\u001b[41Ginto\u001b[46Gthe\u001b[50Gmain\u001b[55Gfile\u001b[60Gwith\u001b[65Ggeneral\u001b[73Gtail\u001b[78Ghandling.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\u001b[40;1H\u001b[38;3H"]
[1139.225, "\u001b]0;\u2733 Claude Code\u0007"]
[1139.228, "\u001b[H\u001b[3GLogi\u001b[8Gs match the reference withi\u001b[36G 5e-5\u001b[43Gt all 1\u001b[51G24 positions, but at about\u001b[78G18 ms per token\u001b[94Gthe run\u001b[102Gis slower than\u001b[117Gthe\r\u001b[3C\u001b[1Boughly 7\u001b[13Gms the\u001b[20GM1's\u001b[25Gmemory bandwidth should allow. I'm\u001b[60Gnow\u001b[64Gchecking\u001b[73Gwhere\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[2C\u001b[4BAt about 11.4 ms\u001b[20Gp\u001b[22Gr forward, weight streaming runs near 38 GB/s,\u001b[69Gwell below what an\u001b[88GM1 core can sustain. I'll try a\u001b[K\r\u001b[2C\u001b[1Bfew row-blocking\u001b[20Gand pr\u001b[27Gfetch varian\u001b[40Gs\u001b[42Gof the\u001b[49Gmatvec\u001b[56Gkernel next.\u001b[K\r\u001b[2C\u001b[4BEight rows is\u001b[17Gslow\u001b[24G(17.9 ms). I'll\u001b[40Gcheck run-to-ru\u001b[56G noise\u001b[63Gand try fewer concurrent\u001b[88Grows.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo\u001b[7Grows\u001b[12Gat\u001b[15Ga\u001b[17Gtime\u001b[22Gwith\u001b[27Gfour\u001b[32Gaccumulators\u001b[45Geach\u001b[50Gis\u001b[53Gclearly\u001b[61Gbest:\u001b[67G8.75\u001b[72Gms,\u001b[76Gversus\u001b[83G11.8\u001b[88Gms\u001b[91Gbefore.\u001b[99GI'll\u001b[104Gtry\u001b[108Gwider\u001b[114Gloads\r\u001b[1B \u001b[3G(\u001b[38;2;87;105;247mvld1q_f32_x4\u001b[39m)"]
[1139.229, " and a\u001b[24Gdeeper unroll on top of that.\u001b[K\r\u001b[3C\u001b[4Bhe\u001b[7Gscript broke on a shell word-sp\u001b[39Gi\u001b[41Gting differenc\u001b[56G (zsh doesn't split\u001b[76G\u001b[38;2;87;105;247m$c\u001b[39m). Rerunning\u001b[91Gunde\u001b[96G bash:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo\u001b[7Grows\u001b[12Gper\u001b[16Gpass\u001b[21Gwith\u001b[26G64-byte\u001b[34Gloads\u001b[40Ghits\u001b[45Gabout\u001b[51G8.8\u001b[55Gms\u001b[58Gper\u001b[62Gforward\u001b[70G(roughly\u001b[79G50\u001b[82GGB/s),\u001b[89Gclose\u001b[95Gto\u001b[98Gone\u001b[102Gcore's\u001b[109Glimit,\u001b[116Gso\r\u001b[1B \u001b[3GI'm\u001b[7Gadopting it and\u001b[23Gmoving the kernel into\u001b[46Gthe mai\u001b[54G file with general tail handling.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
