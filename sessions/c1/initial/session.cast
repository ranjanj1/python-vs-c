[1125.454, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe tokenizer m\u001b[19Gtches\u001b[25Gthe reference\u001b[39Gon all 98,009\u001b[54Gest answers,\u001b[67Gso\u001b[70GI'm\u001b[74Gnow\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[2C\u001b[1Breference\u001b[13Gover\u001b[18Ga\u001b[20Gfull\u001b[25G1024-position\u001b[39Gcontext,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mL\u001b[5Ggits match\u001b[20Greference within 5e-5\u001b[42Gat a\u001b[47Gl\u001b[49G1024 positions, but at about 18 ms per\u001b[88Gt\u001b[90Gken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[2C\u001b[1Broughly\u001b[11G7\u001b[13Gms\u001b[16Gthe\u001b[20GM1's\u001b[25Gmemory\u001b[32Gbandwidth\u001b[42Gshould\u001b[49Gallow.\u001b[56GI'm\u001b[60Gnow\u001b[64Gchecking\u001b[73Gwhere\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt ab\u001b[9Gut 11.4 ms\u001b[20Gper\u001b[24Gforward,\u001b[33Gweight \u001b[41Gtreaming runs nea\u001b[59G 38\u001b[63GGB/s,\u001b[69Gwell\u001b[74Gbelow\u001b[80Gwhat\u001b[85Gan\u001b[88GM1\u001b[91Gcore\u001b[96Gcan\u001b[100Gsustain.\u001b[10"]
[1125.455, "9GI'll\u001b[114Gtry\u001b[118Ga\r\u001b[2C\u001b[1Bfew\u001b[7Grow-blocking\u001b[20Gand\u001b[24Gprefetch\u001b[33Gvariants\u001b[42Gof\u001b[45Gthe\u001b[49Gmatvec\u001b[56Gkernel\u001b[63Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEight\u001b[9Grows\u001b[14Gis\u001b[17Gslower\u001b[24G(17.9\u001b[30Gms).\u001b[35GI'll\u001b[40Gcheck\u001b[46Grun-to-run\u001b[57Gnoise\u001b[63Gand\u001b[67Gtry\u001b[71Gfewer\u001b[77Gconcurrent\u001b[88Grows.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo rows at a time\u001b[22Gwith four accumulators\u001b[45Geach is clearly\u001b[61Gbest:\u001b[67G8.75\u001b[72Gms,\u001b[76Gversus\u001b[83G11.8\u001b[88Gms\u001b[91Gbefore.\u001b[99GI'll\u001b[104Gtry\u001b[108Gwider\u001b[114Gloads\r\u001b[2C\u001b[1B(\u001b[38;2;87;105;247mvld1q_f32_x4\u001b[39m)\u001b[18Gand\u001b[22Ga\u001b[24Gdeeper\u001b[31Gunroll\u001b[38Gon\u001b[41Gtop\u001b[45Gof\u001b[48Gthat.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gscript\u001b[14Gbroke\u001b[20Gon\u001b[23Ga\u001b[25Gshell\u001b[31Gword-splitting\u001b[46Gdifference\u001b[57G(zsh\u001b[62Gdoesn't\u001b[70Gsplit\u001b[76G\u001b[38;2;87;1"]
[1125.456, "05;247m$c\u001b[39m).\u001b[81GRerunning\u001b[91Gunder\u001b[97Gbash:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm\u001b[20Gnd \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo rows per pass with 64-byte loads hits about 8.8 ms per forward (roughly 50 GB/s), close to one core's limit,\u001b[116Gso\r\u001b[2C\u001b[1BI'm adopting it and moving\u001b[30Gthe\u001b[34Gkernel\u001b[41Ginto\u001b[46Gthe\u001b[50Gmain\u001b[55Gfile\u001b[60Gwith\u001b[65Ggeneral\u001b[73Gtail\u001b[78Ghandling.\r\u001b[17C\u001b[2B\u001b[38;2;102;102;102m2\u001b[28G8\u001b[39m\u001b[40;1H\u001b[38;3H"]
