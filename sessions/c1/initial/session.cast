[1139.265, "   a3 = vfmaq_f32(a3, w0.val[\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m], xx.val[\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m]);                                                             \r\u001b[1B\u001b[38;2;36;138;61m 249 +\u001b[38;2;51;51;51m            b0 = vfmaq_f32(b0, w1.val[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m], xx.val[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m]);                                                             \r\u001b[1B\u001b[38;2;36;138;61m 250 +\u001b[38;2;51;51;51m            b1 = vfmaq_f32(b1, w1.val[\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m], xx.val[\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m]);                                                             \r\u001b[1B\u001b[38;2;36;138;61m 251 +\u001b[38;2;51;51;51m            b2 = vfmaq_f32(b2, w1.val[\u001b[38;2;0;134;179m2\u001b[38;2;51;51;51m], xx.val[\u001b[38;2;0;134;179m2\u001b[38;2;51;51;51m]);                                                             \r\u001b[1B\u001b[38;2;36;138;61m 252 +\u001b[38;2;51;51;51m            b3 = vfmaq_f32(b3, w1.val[\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m], xx.val[\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m]);                  "]
[1139.266, "                                           \r\u001b[1B\u001b[49m\u001b[2m 253 \u001b[22m         }\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 258 -\u001b[38;2;51;51;51m        float32x4_t s0 = vaddq_f32(a00, a01), s1 = vaddq_f32(a10, a11);                                           \r\u001b[1B\u001b[38;2;207;34;46m 259 -\u001b[38;2;51;51;51m        float32x4_t s2 = vaddq_f32(a20, a21), s3 = vaddq_f32(a30, a31);                                           \r\u001b[1B\u001b[38;2;207;34;46m 260 -\u001b[38;2;51;51;51m        /* transpose-reduce 4 accumulators into one vector of 4 results */                                        \r\u001b[1B\u001b[38;2;207;34;46m 261 -\u001b[38;2;51;51;51m        float32x4_t t01 = vpaddq_f32(s0, s1), t23 = vpaddq_f32(s2, s3);                                           \r\u001b[1B\u001b[38;2;207;34;46m 262 -\u001b[38;2;51;51;51m        vst1q_f32(out + i, vpaddq_f32(t01, t23));                                                                 \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 254 +\u001b[38;2;51;51;51m        out[i] = hsum(vaddq_f32(vaddq_f32(a0, a1), vaddq_f32(a2, a3)));    "]
