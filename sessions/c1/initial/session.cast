[225.308, "\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m No math-library symbo\u001b[25Gs are\u001b[31Gimported. Running\u001b[49Gthe\u001b[53Gchecker:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Validation passes, with a worst log\u001b[40G error of\u001b[50G2.9e-5\u001b[57Gagainst\u001b[65Ga\u001b[67G5e-4\u001b[72Gtolerance.\u001b[83GNext\u001b[88GI'm\u001b[92Gchecking\u001b[101GPIECE\u001b[107Gagainst\u001b[115Gthe\r\u001b[1C\u001b[1B fixture pieces and comparing the tokenizer and\u001b[50Glogits to the reference.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Building\u001b[12Greference tokenizer hel\u001b[36Ge\u001b[38G and running\u001b[51Gdifferential\u001b[64Gtest\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ mkdir -p tests && cat > tests/ref_encode.c <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m/* differential helper: links the unmodified reference (compiled with -DTESTING)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mand prints encode()/decode() results for lines on stdin. */\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m#define TESTING\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m#include \"../reference/run."]
