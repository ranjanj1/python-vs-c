[897.579, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gtokenizer ma\u001b[20Gches\u001b[25Gthe reference on all 98,009 test\u001b[58Ganswers, so\u001b[70GI'm now\u001b[78Gchecking logits against\u001b[102Gthe\u001b[106Gunmodified\r\u001b[1C\u001b[1B reference \u001b[14Gver a full\u001b[25G1024-position context,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Logits\u001b[10Gmatch\u001b[16Gthe\u001b[20Greference within 5e-5 at all 10\u001b[52G4 positions, but at\u001b[72Gabout\u001b[78G18 ms per\u001b[88Gtoken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[1C\u001b[1B roughly\u001b[11G7\u001b[13Gms\u001b[16Gthe\u001b[20GM1's memory\u001b[32Gbandwidth should allo\u001b[54G. I'm now\u001b[64Gchecking where\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m At\u001b[6Gabout\u001b[12G11.4\u001b[17Gms\u001b[20Gper\u001b[24Gforward,\u001b[33Gweight\u001b[40Gstreaming\u001b[50Gruns\u001b[55Gnear\u001b[60G38\u001b[63GG"]
