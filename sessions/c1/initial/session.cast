[1410.469, "\u001b[H\r\u001b[47C\u001b[34B\u001b[38;2;102;102;102m7\u001b[39m\u001b[40;1H\u001b[38;3H"]
[1410.787, "\u001b[H\r\u001b[31B\u001b[38;2;102;102;102m \u001b[39m\u001b[40;1H\u001b[38;3H"]
