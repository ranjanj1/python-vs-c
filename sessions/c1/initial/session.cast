[192.073, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m 460 \u001b[22m     }\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[12G\u001b[22m    sbuf = \u001b[38;2;0;134;179mmalloc\u001b[38;2;51;51;51m(max_token_length * \u001b[38;2;0;134;179m2\u001b[38;2;51;51;51m + \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m + \u001b[38;2;0;134;179m8\u001b[38;2;51;51;51m);\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 462 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m maxlen = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m;                                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 463 +\u001b[38;2;51;51;51m    \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m i = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m; i < vs; i++) \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m (vocab_len[i] > maxlen) maxlen = vocab_len[i];                    \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 464 +\u001b[38;2;51;51;51m    pbuf = \u001b[38;2;0;134;179mmalloc\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m2\u001b[38;2;51;51;51m * (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)maxlen + \u001b[38;2;0;134;179m8\u001b[38;2;51;51;51m);              "]
[192.075, "                                              \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 465 \u001b[22m }\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 466 \u001b[22m \u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m67\u001b[12G\u001b[22m\u001b[38;2;0;134;179mstatic\u001b[19Gint\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mpair_id\u001b[38;2;0;134;179m(int a, int b)\u001b[38;2;51;51;51m {\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run_c1.c)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mWriting build script, compiling, checking linked symbols\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > build.sh <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m#!/bin/sh\r\u001b[5C\u001b[1B# Build the C1 port. No -ffast-math, no -lm, no OpenMP.\r\u001b[5C\u001b[1Bset -e\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mcd \"$(dirname \"$0\")\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mcc -O3 -mcpu=apple-m1 -std=c11 -D_DARWIN_C_SOURCE -Wall -Wextra -o run_c1 run_c1.c\r\u001b[5C\u001b[1BEOF\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mchmod +x build.sh && ./build.sh && otool -L run_c1 && nm -u run_c1\u001b[39m\u001b[40;1H\u001b[36;2H"]
