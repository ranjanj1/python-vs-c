[551.743, "a =\u001b[12Garray.array('f');\u001b[30Ga.frombytes(open(f\"{t}/r.f32\",\u001b[61G\"rb\").read())\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  b = ar\u001b[15Gay.array('f');\u001b[30Gb.frombytes(open(f\"{t}/c.f32\",\u001b[61G\"rb\").r\u001b[69Gad())\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Glen(a)\u001b[22G==\u001b[25Glen(b)\u001b[32G==\u001b[35Gn\u001b[37G*\u001b[39GV\r\u001b[1B \u001b[2m\u2502\u001b[22m     worst = max(max(abs(x\u001b[30G-\u001b[32Gy)\u001b[35Gfor\u001b[39Gx,\u001b[42Gy\u001b[44Gin\u001b[47Gzip(a[i*V:(i+1)*V],\u001b[67Gb[i*V:(i+1)*V]))\u001b[84Gfor\u001b[88Gi\u001b[90Gin\u001b[93Grange(0,\u001b[102Gn,\u001b[105G1))\r\u001b[1B \u001b[2m\u2502\u001b[22m     am = [max(range(V),\u001b[28Gkey=lambda\u001b[39Gj:\u001b[42G(a[i*V+j],\u001b[53G-j))\u001b[58Gfor\u001b[62Gi\u001b[64Gin\u001b[67Grange(n)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  print(f\"positions {n}: worst max-abs logit error\u001b[57G{worst:.3g};\u001b[70Gargmax\u001b[77Gagree\u001b[83G{sum(int(x)==y\u001b[98Gfor\u001b[102Gx,y\u001b[106Gin\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mzip(fixed[2:], am))}/{n}\")\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  print(f\"reference {t1-t0:.1f}s, run_c1 LOGITS {t3-t2:.2f}s\")\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  # context: long prompt so that generation runs into seq_len\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  p.stdin.write(\"GENERATE 2000"]
[551.744, " Once upon a time\\n\"); p.stdin.flush()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  cnt = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  while True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      s = p.stdout.readline().strip()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      if not s.startswith(\"T \"): break\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mcnt\u001b[16G+=\u001b[19G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(\"GENERATE\u001b[24G2000:\",\u001b[32Gs,\u001b[35G\"tokens\",\u001b[45Gcnt)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write(\"GENERATE\u001b[32G0\u001b[34Ghi\\nQUIT\\n\");\u001b[48Gp.stdin.flush()\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G pri\u001b[12Gt(\"GENERATE 0:\",\u001b[29Gp.stdout.readline().strip()); p.\u001b[62Gait(); print(\"exit\", p.returncode)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15Gtests/longctx.py\u001b[32G\"$PWD\"\u001b[39G1024\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
