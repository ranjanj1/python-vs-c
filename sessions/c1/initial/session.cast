[702.507, ".py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\"\"Rough local timing (the official\u001b[40Gti\u001b[43Ging \u001b[48Gs th\u001b[53G har\u001b[58Gess's). usage: python3 -\u001b[83G tests/bench.py\u001b[99G<dir>\u001b[105G<cmd...>\"\"\"\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsubprocess,\u001b[23Gsys,\u001b[28Gtime\r\u001b[1B \u001b[2m\u2502\u001b[22m d = sys.argv[1]; cmd = sys.argv[2:]\r\u001b[1B \u001b[2m\u2502\u001b[22m t0 = time.t\u001b[16Gm\u001b[18G()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G= subprocess.Popen(cmd + [f\"{d}/model.bin\", f\"{d}/tokenizer.bin\"],\u001b[73Gstdin=subprocess.PIPE,\u001b[96Gstdout=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtext=True)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert p.stdout.readline() == \"READY\\n\"; t1 = time.time()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef gen(n, text):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  p.stdin.write(f\"GENERATE {n} {text}\\n\"); p.stdin.flush(); c = 0; t = time.time(); first = None\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  while True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      s = p.stdout.readline()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      if first is None: first = time.time() - t\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      if not s.startswith(\"T \"): r"]
[702.507, "eturn c, time.time()\u001b[61G-\u001b[63Gt,\u001b[66Gfirst,\u001b[73Gs.strip()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mc\u001b[14G+=\u001b[17G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print(f\"load {t1-t0:.2f}s\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gn\u001b[10Gin\u001b[13G(16,\u001b[18G128,\u001b[23G256):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G c, dt, firs\u001b[20G, s = g\u001b[28Gn(n, \"O\u001b[39Gupon a\u001b[46Gtime\")\u001b[53G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f\"GENERATE\u001b[25G{n}: {s}, {dt:.2f}s, {1000*d\u001b[54G/(c+4):.2f}\u001b[66Gms/forward,\u001b[78Gfirst\u001b[84Gtoken\u001b[90G{1000*first:.1f}ms\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mids\u001b[8G=\u001b[10G\"\u001b[12G\".join([\"1\"]\u001b[25G+\u001b[27G[\"450\"]\u001b[35G*\u001b[37G511)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m t = time.time(); p.stdin.write(f\"FIXED\u001b[43G{ids}\\n\");\u001b[54Gp.stdin.flush();\u001b[71Gp.stdout.readline()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f\"FIXED\u001b[18G512:\u001b[23G{time.time()-t:.2f}s\")\r\u001b[1B \u001b[2m\u2502\u001b[22m p.s\u001b[8Gdin.write(\"QUIT\\n\"); p.s\u001b[33Gd\u001b[36G.flush(); p.wait()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15Gtests/bench.py\u001b[30G\"$PWD\"\u001b[37G./run_c1\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
