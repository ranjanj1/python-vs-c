[698.392, "m(ref, got)):\r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe tokenizer match\u001b[23Gs the reference on all 98,009\u001b[53Gtest\u001b[58Ganswers,\u001b[67Gso\u001b[70GI'm\u001b[74Gnow\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[1B  reference over a full 1024-position context,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the reference within\u001b[37G5e-5\u001b[42Gat\u001b[45Gall\u001b[49G1024\u001b[54Gpositions,\u001b[65Gbut\u001b[69Gat\u001b[72Gabout\u001b[78G18\u001b[81Gms\u001b[84Gper\u001b[88Gtoken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[2C\u001b[1Broughly 7 ms the M1's memory bandwidth\u001b[42Gshould\u001b[49Gallow.\u001b[56GI'm\u001b[60Gnow\u001b[64Gchecking\u001b[73Gwhere\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m7\u001b[39m\u001b[40;1H\u001b[38;3H"]
