[797.323, " \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(got))\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 20 \u001b[22m \u001b[38;2;0;134;179mprint\u001b[38;2;51;51;51m(\u001b[38;2;24;54;145mf\"\u001b[38;2;51;51;51m{\u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ref)}\u001b[38;2;24;54;145m answers compared, \u001b[38;2;51;51;51m{bad}\u001b[38;2;24;54;145m mismatches\"\u001b[38;2;51;51;51m)\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 21 \u001b[22m \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (i, (a, b)) \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mzip\u001b[38;2;51;51;51m(ref, got)):\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The tokenizer\u001b[17Gmatches the\u001b[29Greference\u001b[39Gon\u001b[42Gall\u001b[46G98,009\u001b[53Gtest\u001b[58Ganswers,\u001b[67Gso\u001b[70GI'm\u001b[74Gnow\u001b[78Gchecking\u001b[87Glogits\u001b[94Gagainst\u001b[102Gthe\u001b[106Gunmodified\r\u001b[1C\u001b[1B reference\u001b[13Gover a\u001b[20Gfull\u001b[25G1024-position\u001b[39Gcontext,\u001b[48Gthen\u001b[53Gtiming\u001b[60Git.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b"]
[797.324, "[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Logits\u001b[10Gmatch\u001b[16Gthe\u001b[20Greference\u001b[30Gwithin 5e-5 at all\u001b[49G1024 positions, but at about\u001b[78G18\u001b[81Gms\u001b[84Gper\u001b[88Gtoken\u001b[94Gthe\u001b[98Grun\u001b[102Gis\u001b[105Gslower\u001b[112Gthan\u001b[117Gthe\r\u001b[1C\u001b[1B roughly\u001b[11G7\u001b[13Gms\u001b[16Gthe\u001b[20GM1's memory b\u001b[34Gndwidth should\u001b[49Ga\u001b[51Glow. I'm now\u001b[64Gchecking where\u001b[79Gthe\u001b[83Gtime\u001b[88Ggoes.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m At about 11.4 ms per forward, weight\u001b[40Gstreaming\u001b[50Gruns\u001b[55Gnear\u001b[60G38\u001b[63GGB/s,\u001b[69Gwell\u001b[74Gbelow\u001b[80Gwhat\u001b[85Gan\u001b[88GM1\u001b[91Gcore\u001b[96Gcan\u001b[100Gsustain.\u001b[109GI'll\u001b[114Gtry\u001b[118Ga\r\u001b[1C\u001b[1B few\u001b[7Grow-blocking\u001b[20Gand\u001b[24Gprefetch\u001b[33Gvariants\u001b[42Gof\u001b[45Gthe\u001b[49Gmatvec\u001b[56Gkernel\u001b[63Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Eight r\u001b[11Gws is slower (17.9 ms). I'll che\u001b[44Gk run-to-run\u001b[57Gnoise\u001b[63Gand\u001b[67Gtry\u001b[71Gfewer\u001b[77Gconcurrent\u001b[88Grows.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;10"]
