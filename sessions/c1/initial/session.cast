[732.097, "\u001b[H\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m2\u001b[30G\u001b[22mlines\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 15 \u001b[22m \u001b[38;2;167;29;93massert\u001b[38;2;51;51;51m p.stdout.readline() == \u001b[38;2;24;54;145mb\"READY\\n\"\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 16 \u001b[22m cmds = [\u001b[38;2;24;54;145mb\"ENCODE \"\u001b[38;2;51;51;51m + t.encode(\u001b[38;2;24;54;145m\"utf-8\"\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"surrogateescape\"\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m texts]\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 17 \u001b[22m cmds += [\u001b[38;2;24;54;145mf\"PIECE \u001b[38;2;51;51;51m{prev}\u001b[38;2;24;54;145m \u001b[38;2;51;51;51m{i}\u001b[38;2;24;54;145m\"\u001b[38;2;51;51;51m.encode() \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m prev \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m32000\u001b[38;2;51;51;51m)]\r\u001b[1C\u001b[1"]
