[166.198, "\u001b[H\r\u001b[26B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe packed single-stream layout hits about 62 GB/s, against roughly 50 GB/s for the current\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[2C\u001b[1Bevery matmul weight in forward-pass order at load.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mReading \u001b[1m1\u001b[22m file\u2026\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[3G\u001b[38;2;245;149;117mC\u001b[38;2;215;119;87moncocting\u2026 \u001b[28G\u001b[38;2;102;102;102m7\u001b[42G\u001b[38;2;185;185;185mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[166.217, "\u001b[H\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gremaining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gstart\u001b[14Gby\u001b[17Gchecking\u001b[26Gwhich\u001b[32Gdevelopment\u001b[44Gworkloads\u001b[54Gare\u001b[58Gactually\u001b[67Gsupplied,\u001b[77Gthen\u001b[82Gadd\u001b[86Gan\u001b[89Gopt-in\u001b[96Gprofiling\u001b[106Gbuild\u001b[112Gso\u001b[115Gthe\r\u001b[1B \u001b[3Gevidence comes from the real\u001b[32Gbinary.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gonly\u001b[12Gsupplied\u001b[21Gworkloads\u001b[31Gare\u001b[35Gcheck.py\u001b[44Gand\u001b[48Gfixtures.json,\u001b[63Gwhich\u001b[69Gmeans\u001b[75Gshort-context\u001b[89Gdecoding:\u001b["]
[166.218, "99G64\u001b[102Gnew\u001b[106Gtokens\u001b[113Gper\r\u001b[1B \u001b[3Gprompt over 69\u201382\u001b[21Gp\u001b[23Gsition\u001b[30G. I'll add compile-time secti\u001b[61G timers\u001b[69G(-DPROFILE) and profile against that\u001b[106Gw\u001b[108Grkload.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmuls\u001b[11Gtake\u001b[16Gabout\u001b[22G96.5%\u001b[28Gof\u001b[31Geach\u001b[36Gforward\u001b[44Gpass,\u001b[50Gand\u001b[54Gw2\u001b[57Gstreams\u001b[65Gslowest\u001b[73Gat\u001b[76G43\u001b[79GGB/s\u001b[84Gversus\u001b[91Groughly\u001b[99G53\u001b[102GGB/s\u001b[107Gelsewhere.\r\u001b[1B \u001b[3GNext I'll m\u001b[15Gasure the single-core read roofline and te\u001b[59G whether a pre-packed sequ\u001b[86Gntial weight\u001b[99Glayout clo\u001b[111Gs that\r\u001b[2C\u001b[1Bgap.\u001b[8G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gkernel\u001b[14Gis\u001b[17Gpartly\u001b[24GFMA-latency-bound:\u001b[43Ga\u001b[45Gsingle\u001b[52Gstream\u001b[59Gwith\u001b[64G4\u001b[66Gaccumulators\u001b[79Gtops\u001b[84Gout\u001b[88Gnear\u001b[93G51\u001b[96GGB/s,\u001b[102Gwhile\u001b[108Ginterleaved\r\u001b[1B \u001b[3Grows reach\u001b[14Gabout 62 GB/s "]
[166.219, "on the 768-column shap\u001b[51Gs. The 2048-column w2 shape\u001b[79Gstays slow\u001b[90Gr at about 47 GB/s, so I'm\u001b[K\r\u001b[2C\u001b[1Btesting more accumulators and a\u001b[35Gdifferent loop order for it next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpacked\u001b[14Gsingle-stream\u001b[28Glayout\u001b[35Ghits\u001b[40Gabout\u001b[46G62\u001b[49GGB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[1B \u001b[3Gev\u001b[6Gry matmul weight in forward-pass order at load.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mReading\u001b[11Grun_c1.c\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102m \u23bf  run_c1.c\u001b[39m\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mC\u001b[42G\u001b[38;2;102;102;102mthought for 31s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[166.263, "\u001b[H\r\u001b[2C\u001b[33B\u001b[38;2;219;123;91mConcocting\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
