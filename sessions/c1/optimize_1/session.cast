[695.435, "\u001b[H\u001b[3Gwith\u001b[8Gthe\u001b[12Gdev\u001b[16Gcheck\u001b[22Gstill\u001b[28Gpassing.\u001b[37GNext\u001b[42GI'll\u001b[47Gvectorize\u001b[57Gargmax\u001b[64G(currently\u001b[75G0.03\u20130.04\u001b[85Gms\u001b[88Gper\u001b[92Gforward)\u001b[101Gwhile\u001b[107Gkeeping\r\u001b[2C\u001b[1Blowest-index\u001b[16Gtie-breaking\u001b[29Gand\u001b[33Ga\u001b[35Gscalar\u001b[42GNaN\u001b[46Gfallback.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mForward time dropp\u001b[22Gd 16% on the dev w\u001b[41Grkloa\u001b[47G, to 7.47 ms per forward, with m\u001b[81Gmuls now\u001b[90Gstreaming\u001b[100Gnear\u001b[105Gthe\u001b[109Gsingle-core\r\u001b[2C\u001b[1Broofline.\u001b[13GI'm\u001b[17Grunning\u001b[25Gthe\u001b[29Gfull\u001b[34Gregression\u001b[45Gsuite\u001b[51Gagainst\u001b[59Gthe\u001b[63Greference\u001b[73Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass, and logits for 1024 positions dropp\u001b[56Gd from 12.5 s to 8.6 s. Next\u001b[85GI'll test the uns\u001b[103Gar\u001b[106Gd-classifier\r\u001b[2C\u001b[1Bpath and the\u001b[16Gunpack\u001b[23Gd fallback with \u001b[40G synthetic checkpoint\u001b[62Gand\u001b[66Ga\u001b[68Gmixed\u001b[74Gbuild.\r\u001b[2C\u001b[4"]
