[412.075, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gkernel\u001b[14Gis\u001b[17Gpartly\u001b[24GFMA-latency-bound:\u001b[43Ga\u001b[45Gsingle\u001b[52Gstream\u001b[59Gwith\u001b[64G4\u001b[66Gaccumulators\u001b[79Gtops\u001b[84Gout\u001b[88Gnear\u001b[93G51\u001b[96GGB/s,\u001b[102Gwhile\u001b[108Ginterleaved\r\u001b[2C\u001b[1Brows reach about 62 GB/s\u001b[28Gon\u001b[31Gthe\u001b[35G768-column\u001b[46Gshapes.\u001b[54GThe\u001b[58G2048-column\u001b[70Gw2\u001b[73Gshape\u001b[79Gstays\u001b[85Gslower\u001b[92Gat\u001b[95Gabout\u001b[101G47\u001b[104GGB/s,\u001b[110Gso\u001b[113GI'm\r\u001b[2C\u001b[1Btesting\u001b[11Gmore\u001b[16Gaccumulators\u001b[29Gand\u001b[33Ga\u001b[35Gdifferent\u001b[45Gloop\u001b[50Gorder\u001b[56Gfor\u001b[60Git\u001b[63Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe packed single-stream layout hits\u001b[40Gabout\u001b[46G62\u001b[49GGB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[2C\u001b[1Bevery\u001b[9Gmatmul\u001b[16Gweight\u001b[23Gin\u001b[26Gforward-pass\u001b[39Gorder\u001b[45Gat\u001b[48Gload.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacked"]
[412.076, "\u001b[10Glayout\u001b[17Gbrings\u001b[24Ga\u001b[26Gforward\u001b[34Gpass\u001b[39Gto\u001b[42G7.96\u001b[47Gms,\u001b[51Gwith\u001b[56Gevery\u001b[62Gmatmul\u001b[69Gnear\u001b[74G57\u001b[77GGB/s\u001b[82Gand\u001b[86Glogit\u001b[92Gerrors\u001b[99Gunchanged.\u001b[110GNext\u001b[115GI'll\r\u001b[2C\u001b[1Btry panel height and\u001b[24Gprefetch\u001b[33Gdistance\u001b[42Gin\u001b[45Gthe\u001b[49Greal\u001b[54Gbinary,\u001b[62Gsince\u001b[68Gthere's\u001b[76Gstill\u001b[82Ga\u001b[84G~5\u001b[87GGB/s\u001b[92Ggap\u001b[96Gto\u001b[99Gthe\u001b[103Gmicrobenchmark\r\u001b[2C\u001b[1Bceiling.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPanel\u001b[9Gheights\u001b[17G2\u001b[19Gand\u001b[23G4\u001b[25Gand\u001b[29Gshort\u001b[35Gprefetch\u001b[44Gdistances\u001b[54Gtie\u001b[58Gwithin\u001b[65Gnoise,\u001b[72Gwhile\u001b[78Ga\u001b[80G4\u001b[82GKB\u001b[85Gdistance\u001b[94Gand\u001b[98G8-row\u001b[104Gpanels\u001b[111Gdo\u001b[114Gworse\r\u001b[2C\u001b[1Bor no better. I'm going\u001b[27Gwith\u001b[32G4-row\u001b[38Gpanels\u001b[45Gand\u001b[49Gno\u001b[52Gsoftware\u001b[61Gprefetch,\u001b[71Gremoving\u001b[80Gthe\u001b[84Gexperimental\u001b[97Ghook,\u001b[103Gand\u001b[107Gthen\u001b[112Gchecking\r\u001b[2C\u001b[1Bload\u001b[8Gtime.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m"]
