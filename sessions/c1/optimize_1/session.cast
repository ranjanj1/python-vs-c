[352.68, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmuls\u001b[11Gtake\u001b[16Gabout\u001b[22G96.5%\u001b[28Gof\u001b[31Geach\u001b[36Gforward\u001b[44Gpass,\u001b[50Gand\u001b[54Gw2\u001b[57Gstreams\u001b[65Gslowest\u001b[73Gat\u001b[76G43\u001b[79GGB/s\u001b[84Gversus\u001b[91Groughly\u001b[99G53\u001b[102GGB/s\u001b[107Gelsewhere.\r\u001b[2C\u001b[1BNext I'll measure the\u001b[25Gsingle-core\u001b[37Gread\u001b[42Groofline\u001b[51Gand\u001b[55Gtest\u001b[60Gwhether\u001b[68Ga\u001b[70Gpre-packed\u001b[81Gsequential\u001b[92Gweight\u001b[99Glayout\u001b[106Gcloses\u001b[113Gthat\r\u001b[2C\u001b[1Bgap.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe kernel is partly FMA-latency-bound:\u001b[43Ga\u001b[45Gsingle\u001b[52Gstream\u001b[59Gwith\u001b[64G4\u001b[66Gaccumulators\u001b[79Gtops\u001b[84Gout\u001b[88Gnear\u001b[93G51\u001b[96GGB/s,\u001b[102Gwhile\u001b[108Ginterleaved\r\u001b[2C\u001b[1Brows\u001b[8Greach\u001b[14Gabout\u001b[20G62\u001b[23GGB/s\u001b[28Gon\u001b[31Gthe\u001b[35G768-column\u001b[46Gshapes.\u001b[54GThe\u001b[58G2048-column\u001b[70Gw2\u001b[73Gshape\u001b[79Gstays\u001b[85Gslower\u001b[92Gat\u001b[95Gabout\u001b[101G47\u001b[104GGB/s,\u001b[110Gso\u001b[113GI'm\r\u001b[1B \u001b[3Gtesting more a"]
[352.684, "ccumulators and a different loop order\u001b[56Gfor it next.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe packed singl\u001b[20G-stream layout hits about 62 GB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[1B  every matmul weight in forward-pass\u001b[39Gorder\u001b[45Gat\u001b[48Gload.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, \u001b[17Gan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacked\u001b[10Glayout\u001b[17Gbrings\u001b[24Ga\u001b[26Gforward\u001b[34Gpass\u001b[39Gto\u001b[42G7.96\u001b[47Gms,\u001b[51Gwith\u001b[56Gevery\u001b[62Gmatmul\u001b[69Gnear\u001b[74G57\u001b[77GGB/s\u001b[82Gand\u001b[86Glogit\u001b[92Gerrors\u001b[99Gunchanged.\u001b[110GNext\u001b[115GI'll\r\u001b[2C\u001b[1Btry panel height\u001b[20Gand\u001b[24Gprefetch\u001b[33Gdistance\u001b[42Gin\u001b[45Gthe\u001b[49Greal\u001b[54Gbinary,\u001b[62Gsince\u001b[68Gthere's\u001b[76Gstill\u001b[82Ga\u001b[84G~5\u001b[87GGB/s\u001b[92Ggap\u001b[96Gto\u001b[99Gthe\u001b[103Gmicrobenchmark\r\u001b[2C\u001b[1Bceiling.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C"]
[352.684, "\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPanel heights 2 and 4 and short prefetch\u001b[44Gdistances\u001b[54Gtie\u001b[58Gwithin\u001b[65Gnoise,\u001b[72Gwhile\u001b[78Ga\u001b[80G4\u001b[82GKB\u001b[85Gdistance\u001b[94Gand\u001b[98G8-row\u001b[104Gpanels\u001b[111Gdo\u001b[114Gworse\r\u001b[2C\u001b[1Bor\u001b[6Gno better. I'm going with 4-row panels\u001b[45Gand\u001b[49Gno\u001b[52Gsoftware\u001b[61Gprefetch,\u001b[71Gremoving\u001b[80Gthe\u001b[84Gexperimental\u001b[97Ghook,\u001b[103Gand\u001b[107Gthen\u001b[112Gchecking\r\u001b[2C\u001b[1Bload time.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m4\u001b[30G3\u001b[39m\u001b[40;1H\u001b[38;3H"]
[352.693, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 8s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[352.71, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[39m\u001b[40;1H\u001b[38;3H"]
