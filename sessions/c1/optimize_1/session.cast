[664.559, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gat\u001b[16Ga\u001b[18G1024-position\u001b[32Grun\u001b[36Gtakes\u001b[42G3.9\u001b[46Gms\u001b[49Gper\u001b[53Gforward\u001b[61G(35%),\u001b[68Gabout\u001b[74G6\u00d7\u001b[77Gthe\u001b[81Gbandwidth\u001b[91Gneeded\u001b[98Gfor\u001b[102Gthe\u001b[106GKV\u001b[109Gcache.\u001b[116GI'm\r\u001b[1B \u001b[3Gswitching the cach\u001b[22G to head-major lay\u001b[41Gut an\u001b[47G computing four position scores \u001b[81G once to\u001b[90Gfix it.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context\u001b[16Gattention\u001b[26Gfell\u001b[31Gfrom\u001b[36G3.89\u001b[41Gto\u001b[44G0.82\u001b[49Gms\u001b[52Gper\u001b[56Gforward,\u001b[65Gand\u001b[69Gthe\u001b[73G1024-position\u001b[87Grun\u001b[91Gdropped\u001b[99Gfrom\u001b[104G11.45\u001b[110Gs\u001b[112Gto\u001b[115G8.36\u001b[120Gs\r\u001b[1B \u001b[3Gwith the dev check still passing. Next I'll vectoriz\u001b[56G argmax (currently 0.03\u20130.04\u001b[85Gms per forward) w\u001b[103Gil\u001b[106G keeping\u001b[K\r\u001b[2C\u001b[1Blowest-index\u001b[16Gtie-br\u001b[23Gaking and a scal"]
[664.56, "\u001b[40Gr NaN fallback.\u001b[K\r\u001b[2C\u001b[4BF\u001b[5Grward time dropped 16% on \u001b[32Ghe dev workl\u001b[45Gad, to 7.47\u001b[57Gms per forward,\u001b[73Gwith matmuls now streaming near the\u001b[109Gsingle-core\r\u001b[2C\u001b[1Broof\u001b[8Gin\u001b[11G. I'm running the full r\u001b[36Ggr\u001b[39Gssi\u001b[43Gn suite\u001b[51Gagainst\u001b[59Gthe\u001b[63Greference\u001b[73Gnext.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass, and logits for 1024 positions dropped from 12.5 s to 8.6 s. Next I'll test the unshared-classifier\u001b[K\r\u001b[2C\u001b[1Bpath and the unpacked fallback with a synthetic checkpoint\u001b[62Gand\u001b[66Ga\u001b[68Gmixed\u001b[74Gbuild.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Both paths produce logits bit-identical to the normal build (max diff 0), with identical\u001b[92GGENERATE\u001b[101Goutput.\u001b[109GNow\u001b[113Gthe\r\u001b[1C\u001b[1B final before/after timings\u001b[30Gon\u001b[33Gthe\u001b[37Gdev\u001b[41Gworkload.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Final end-to-end\u001b[20Gtimings\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf"]
[664.561, "  $ for i in 1 2 3; do /usr/bin/time -p python3 check.py --tokens 64 --prompts 3 -- ./run_c1 2>&1 | grep -E \u001b[113G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m\"PASS|FAIL|real\"; done; python3 -I tests/bench.py \"$PWD\" ./run_c1; python3 -I tests/bench.py \"$PWD\" ./run_c1 | sed \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m-n 3p; python3 -I tests/loadtime.py \"$PWD\" ./run_c1\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u00b7\u001b[3G\u001b[38;2;234;138;106mConcocting\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(10m 53s \u00b7 \u2193\u001b[28G38.2k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
