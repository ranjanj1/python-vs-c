[667.573, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gat\u001b[16Ga\u001b[18G1024-position\u001b[32Grun\u001b[36Gtakes\u001b[42G3.9\u001b[46Gms\u001b[49Gper\u001b[53Gforward\u001b[61G(35%),\u001b[68Gabout\u001b[74G6\u00d7\u001b[77Gthe\u001b[81Gbandwidth\u001b[91Gneeded\u001b[98Gfor\u001b[102Gthe\u001b[106GKV\u001b[109Gcache.\u001b[116GI'm\r\u001b[1B \u001b[3Gswitch\u001b[10Gng\u001b[13Gthe cache t\u001b[25G head-major layout and computing four position scores at o\u001b[84Gce to fix it.\u001b[98G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context\u001b[16Gattention\u001b[26Gfell\u001b[31Gfrom\u001b[36G3.89\u001b[41Gto\u001b[44G0.82\u001b[49Gms\u001b[52Gper\u001b[56Gforward,\u001b[65Gand\u001b[69Gthe\u001b[73G1024-position\u001b[87Grun\u001b[91Gdropped\u001b[99Gfrom\u001b[104G11.45\u001b[110Gs\u001b[112Gto\u001b[115G8.36\u001b[120Gs\r\u001b[1B \u001b[3Gwith the dev\u001b[16Gcheck still passing. Next I'll vectorize a\u001b[59Ggmax (currently 0.03\u20130.04 ms per f\u001b[94Grward) while keeping\u001b[115G\u001b[K\r\u001b[2C\u001b[1Blowes\u001b[9G-in\u001b[14Gx\u001b[16Gti\u001b[19G-breaking \u001b[30Gnd a scalar\u001b[42G"]
[667.574, "NaN fallback.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mForward\u001b[11Gtime\u001b[16Gdropped\u001b[24G16%\u001b[28Gon\u001b[31Gthe\u001b[35Gdev\u001b[39Gworkload,\u001b[49Gto\u001b[52G7.47\u001b[57Gms\u001b[60Gper\u001b[64Gforward,\u001b[73Gwith\u001b[78Gmatmuls\u001b[86Gnow\u001b[90Gstreaming\u001b[100Gnear\u001b[105Gthe\u001b[109Gsingle-core\r\u001b[1B \u001b[3Gr\u001b[5Gofline. I'm \u001b[18Gunning the full regression suite against th\u001b[62G reference\u001b[73Gnext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gchecks\u001b[14Gpass,\u001b[20Gand\u001b[24Glogits\u001b[31Gfor\u001b[35G1024\u001b[40Gpositions\u001b[50Gdropped\u001b[58Gfrom\u001b[63G12.5\u001b[68Gs\u001b[70Gto\u001b[73G8.6\u001b[77Gs.\u001b[80GNext\u001b[85GI'll\u001b[90Gtest\u001b[95Gthe\u001b[99Gunshared-classifier\r\u001b[1B \u001b[3Gpath and the unpacked fallback with a syn\u001b[45Ghetic checkpoint and a\u001b[68Gmixed build.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Gpaths\u001b[14Gproduce\u001b[22Glogits\u001b[29Gbit-identical\u001b[43Gto\u001b[46Gthe\u001b[50"]
