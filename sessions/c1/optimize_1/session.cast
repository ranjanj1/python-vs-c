[445.365, "\u001b[H \u001b[3Grows reach\u001b[14Gabout 62 GB/s on the 768-column shap\u001b[51Gs. The 2048-column w2 shape\u001b[79Gstays slow\u001b[90Gr at about 47 GB/s, so I'm\u001b[K\r\u001b[2C\u001b[1Btesting more accumulators and a\u001b[35Gdifferent loop order for it next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpacked\u001b[14Gsingle-stream\u001b[28Glayout\u001b[35Ghits\u001b[40Gabout\u001b[46G62\u001b[49GGB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[1B \u001b[3Gev\u001b[6Gry matmul weight in forward-pass order at load.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacked\u001b[10Glayout\u001b[17Gbrings\u001b[24Ga\u001b[26Gforward\u001b[34Gpass\u001b[39Gto\u001b[42G7.96\u001b[47Gms,\u001b[51Gwith\u001b[56Gevery\u001b[62Gmatmul\u001b[69Gnear\u001b[74G57\u001b[77GGB/s\u001b[82Gand\u001b[86Glogit\u001b[92Gerrors\u001b[99Gunchanged.\u001b[110GNext\u001b[115GI'll\r\u001b[1B \u001b[3Gtry panel height and\u001b[24Gprefetch distance\u001b[42Gin the real binary,\u001b[62Gsince th\u001b[71Gr"]
