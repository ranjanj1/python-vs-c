[61.818, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[22m \u001b[5G       \u001b[13G      \u001b[20GPMARK(P_LOGIO);''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrep('''\u001b[12G    \u001b[17G   \u001b[21G  fcl\u001b[27Gs\u001b[29G(f);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   \u001b[9G    \u001b[14G  printf(\"DONE %d\\\\n\", n);''','''  \u001b[50G     \u001b[56G  \u001b[59GPSTART();\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G    \u001b[10G      fclose(f);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m    \u001b[10G     \u001b[16GPMARK(P_LOGIO);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G        \u001b[14G  pr\u001b[20Gtf(\"DONE %d\\\\n\", n);''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrep('''\u001b[15Gfree(line);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   re\u001b[11Gurn 0;''','''    free(line);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #ifdef PROFILE\u001b[19G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprof_report();\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #endif\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   return\u001b[15G0;''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m open(p,'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m cat > build.sh\u001b[19G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#!/bin/sh\r\u001b[1B \u001b[2m\u2502\u001b[22m # Build the C1 port. No -ffast-math,\u001b[41Gno\u001b[44G-lm,\u001b[49Gno\u001b[52GOpenMP.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[8G./build.sh\u001b[28G->\u001b[31G./run_c1\u001b["]
[61.819, "47G(the\u001b[52Gsubmission\u001b[63Gbinary)\r\u001b[1B \u001b[2m\u2502\u001b[22m #   ./build.sh profile  -> ./run_c1_prof   (same code + section timers, stderr report at QUIT)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m set -e\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m cd \"$(dirname \"$0\")\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mCFLAGS=\"-O3\u001b[16G-mcpu=apple-m1\u001b[31G-std=c11\u001b[40G-D_DARWIN_C_SOURCE\u001b[59G-Wall\u001b[65G-Wextra\"\r\u001b[1B \u001b[2m\u2502\u001b[22m if [ \"$1\"\u001b[14G= profile ]; then\u001b[32G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     c\u001b[10G $CFLAGS -DPROFILE -o\u001b[32Gru\u001b[35G_c1_prof\u001b[44Grun_c1.c\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22melse\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     cc $CFLAGS -o run_c1\u001b[29Grun_c1.c\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfi\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ./build.sh\u001b[15G&& ./build.sh profi\u001b[35Ge\u001b[37G&& python3 check.py --tokens 64\u001b[69G-\u001b[71Gprompts 3\u001b[81G-- ./\u001b[87Gun_c1_prof\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
