[688.068, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttent\u001b[10Gon\u001b[13Gat a 1024-p\u001b[25Gsition run takes 3.9 ms per forward (35%), about 6\u00d7 the ba\u001b[84Gdwidth needed\u001b[98Gfor\u001b[102Gthe\u001b[106GKV\u001b[109Gcache.\u001b[116GI'm\r\u001b[2C\u001b[1Bswitching\u001b[13Gthe\u001b[17Gcache\u001b[23Gto\u001b[26Ghead-major\u001b[37Glayout\u001b[44Gand\u001b[48Gcomputing\u001b[58Gfour\u001b[63Gposition\u001b[72Gscores\u001b[79Gat\u001b[82Gonce\u001b[87Gto\u001b[90Gfix\u001b[94Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context\u001b[16Gattention fell from 3.89 to 0.82 ms per fo\u001b[59Gward, and the 1024-position run dr\u001b[94Gpped from 11.45 s to\u001b[115G8.36\u001b[120Gs\r\u001b[2C\u001b[1Bwith \u001b[9Ghe \u001b[14Gv\u001b[16Gch\u001b[19Gck still p\u001b[30Gssing. Next\u001b[42GI'll vectorize\u001b[57Gargmax\u001b[64G(currently\u001b[75G0.03\u20130.04\u001b[85Gms\u001b[88Gper\u001b[92Gforward)\u001b[101Gwhile\u001b[107Gkeeping\r\u001b[2C\u001b[1Blowest-index\u001b[16Gtie-breaking\u001b[29Gand\u001b[33Ga\u001b[35Gscalar\u001b[42GNaN\u001b[46Gfallback.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b["]
[688.068, "1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mF\u001b[5Grward time d\u001b[18Gopped 16% on the dev workload, to 7.47 ms p\u001b[62Gr forward,\u001b[73Gwith matmuls\u001b[86Gnow\u001b[90Gstreaming\u001b[100Gnear\u001b[105Gthe\u001b[109Gsingle-core\r\u001b[2C\u001b[1Broofline.\u001b[13GI'm\u001b[17Grunning\u001b[25Gthe\u001b[29Gfull\u001b[34Gregression\u001b[45Gsuite\u001b[51Gagainst\u001b[59Gthe\u001b[63Greference\u001b[73Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass, and logits for 1024 posi\u001b[45Gions dropped from 12.5\u001b[68Gs to 8.6 s. Next\u001b[85GI'll\u001b[90Gtest\u001b[95Gthe\u001b[99Gunshared-classifier\r\u001b[2C\u001b[1Bpath\u001b[8Gand\u001b[12Gthe\u001b[16Gunpacked\u001b[25Gfallback\u001b[34Gwith\u001b[39Ga\u001b[41Gsynthetic\u001b[51Gcheckpoint\u001b[62Gand\u001b[66Ga\u001b[68Gmixed\u001b[74Gbuild.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth paths produce\u001b[22Glog\u001b[26Gts bit-id\u001b[36Gntical to the normal\u001b[57Gbuild\u001b[63G(max\u001b[68Gdiff\u001b[73G0),\u001b[77Gwith\u001b[82Gidentical\u001b[92GGENERATE\u001b[101Goutput.\u001b[109G"]
[688.069, "Now\u001b[113Gthe\r\u001b[2C\u001b[1Bfinal\u001b[9Gbefore/after\u001b[22Gtimings\u001b[30Gon\u001b[33Gthe\u001b[37Gdev\u001b[41Gworkload.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Final end-to-end timings\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2 3\u001b[26G /usr/bin/time\u001b[41G-p pytho\u001b[50G3 check.py --toke\u001b[68Gs 64\u001b[73G--pr\u001b[78Gmpts 3 -- .\u001b[90Gru\u001b[93G_c1 2>&1 | grep -E \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\"PASS|FAIL|real\";\u001b[24Gdone; python3 -I tests/bench.py \"$PWD\"\u001b[63G./run_c1; python3 -I tests/bench.py \"$PWD\" ./run_c1 | sed \r\u001b[5C\u001b[1B-n 3p; python3\u001b[21G-I\u001b[24Gtests/loa\u001b[34Gtime.py \"$PWD\" ./run_c1\u001b[39m\u001b[40;1H\u001b[38;3H"]
