[207.725, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe only supplied\u001b[21Gw\u001b[23Grkload\u001b[30G are check.py and fixtures.js\u001b[61G, which\u001b[69Gmeans short-context decoding: 64 new\u001b[106Gt\u001b[108Gkens per\r\u001b[2C\u001b[1Bprompt\u001b[10Gover\u001b[15G69\u201382\u001b[21Gpositions.\u001b[32GI'll\u001b[37Gadd\u001b[41Gcompile-time\u001b[54Gsection\u001b[62Gtimers\u001b[69G(-DPROFILE)\u001b[81Gand\u001b[85Gprofile\u001b[93Gagainst\u001b[101Gthat\u001b[106Gworkload.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmuls tak\u001b[15G about 96.5% of each forward pass, and w2 \u001b[59Greams slowest at 43 GB/s v\u001b[86Grsus roughly\u001b[99G53 GB/s el\u001b[111Gwhere.\r\u001b[2C\u001b[1BNext\u001b[8GI'll\u001b[13Gmeasure\u001b[21Gthe\u001b[25Gsingle-core\u001b[37Gread\u001b[42Groofline\u001b[51Gand\u001b[55Gtest\u001b[60Gwhether\u001b[68Ga\u001b[70Gpre-packed\u001b[81Gsequential\u001b[92Gweight\u001b[99Glayout\u001b[106Gcloses\u001b[113Gthat\r\u001b[2C\u001b[1Bgap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe kernel\u001b[14Gis partly FMA-latency-bound: a singl\u001b[51G stream with 4 accumulators\u001b["]
[207.725, "79Gtops out n\u001b[90Gar 51 GB/s, while interleaved\r\u001b[2C\u001b[1Brows reach about 62 GB/s on the\u001b[35G768-column shapes. The 2048-column\u001b[70Gw2\u001b[73Gshape\u001b[79Gstays\u001b[85Gslower\u001b[92Gat\u001b[95Gabout\u001b[101G47\u001b[104GGB/s,\u001b[110Gso\u001b[113GI'm\r\u001b[2C\u001b[1Btesting\u001b[11Gmore\u001b[16Gaccumulators\u001b[29Gand\u001b[33Ga\u001b[35Gdifferent\u001b[45Gloop\u001b[50Gorder\u001b[56Gfor\u001b[60Git\u001b[63Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTh\u001b[6G packed single-stream layout hits about 62 GB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[2C\u001b[1Bevery\u001b[9Gmatmul\u001b[16Gweight\u001b[23Gin\u001b[26Gforward-pass\u001b[39Gorder\u001b[45Gat\u001b[48Gload.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Implement packed sequential\u001b[31Gweight\u001b[38Glayout\u001b[45Gand\u001b[49Gprofile\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp\u001b[8G'/Users/agentlab/pvc/c1/run_c1.c'\r\u001b[5C\u001b[1Bs=open(p).read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mdef rep(a,b,cnt=1):\r\u001b[5C\u001b[1Bglo"]
