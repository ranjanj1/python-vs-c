[475.215, "\u001b[H \u001b[2m\u2502\u001b[22m stati\u001b[10G int ar\u001b[18Gmax(const\u001b[28Gfloat *v, int n) {\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     PSTART();\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mint\u001b[12Gmi\u001b[15G=\u001b[17G0;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     if (n >= 16) {\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfloat32x4_t\u001b[24Gm0\u001b[27G=\u001b[29Gvld1q_f32(v),\u001b[43Gm1\u001b[46G=\u001b[48Gvld1q_f32(v\u001b[60G+\u001b[62G4);\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G  uin\u001b[16G32x4_t ok\u001b[26G= vandq_u32(vceqq_f32(m0, m0), \u001b[58Gceqq_f32(m1, m1));\u001b[77G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G     int i =\u001b[20G8;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gfor\u001b[16G(;\u001b[19Gi\u001b[21G+\u001b[23G8\u001b[25G<=\u001b[28Gn;\u001b[31Gi\u001b[33G+=\u001b[36G8)\u001b[39G{\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mfloat32x4_t\u001b[28Ga\u001b[30G=\u001b[32Gvld1q_f32(v\u001b[44G+\u001b[46Gi),\u001b[50Gb\u001b[52G=\u001b[54Gvld1q_f32(v\u001b[66G+\u001b[68Gi\u001b[70G+\u001b[72G4);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             ok = vandq_u32(ok,\u001b[35Gvandq_u32(vceqq_f32(a,\u001b[58Ga),\u001b[62Gvceqq_f32(b,\u001b[75Gb)));\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mm0\u001b[19G=\u001b[21Gvmaxq_f32(m0,\u001b[35Ga);\u001b[39Gm1\u001b[42G=\u001b[44Gvmaxq_f32(m1,\u001b[58Gb);\r\u001b[1B \u001b[2m\u2502\u001b[22m     \u001b[9G   }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  \u001b[9G   float mv\u001b[21G= vmaxvq_f32(v"]
[475.216, "maxq_f32(m0, m1));\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G    int\u001b[16Gnan\u001b[20G=\u001b[22Gvminvq_u32(ok)\u001b[37G==\u001b[40G0;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16G(int\u001b[21Gj\u001b[23G=\u001b[25Gi;\u001b[28Gj\u001b[30G<\u001b[32Gn;\u001b[35Gj++)\u001b[40G{\u001b[42Gif\u001b[45G(v[j]\u001b[51G!=\u001b[54Gv[j])\u001b[60Gnan\u001b[64G=\u001b[66G1;\u001b[69Gelse\u001b[74Gif\u001b[77G(v[j]\u001b[83G>\u001b[85Gmv)\u001b[89Gmv\u001b[92G=\u001b[94Gv[j];\u001b[100G}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         if (!nan) {\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mwhile\u001b[22G(v[mi]\u001b[29G!=\u001b[32Gmv)\u001b[36Gmi++;\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G  \u001b[14G  PMARK(P_ARGMAX);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G       \u001b[16Greturn m\u001b[25G;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22m}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfloat\u001b[14Gmv\u001b[17G=\u001b[19Gv[0];\r\u001b[1B \u001b[2m\u2502\u001b[22m     for (int i = 1; i < n; i++)\u001b[36Gif (v[i] > mv) {\u001b[53Gmv = v[i]; mi = i; }\u001b[74G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     PMARK(P_ARGMAX);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15Gmi;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m }''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen(p,'w').write(s)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ./build.sh && ./build.sh profile\u001b[37G&& python3 check.py\u001b[57"]
