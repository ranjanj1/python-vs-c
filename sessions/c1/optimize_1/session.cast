[217.936, "'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp='/Users/agentlab/pvc/c1/run_c1.c'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s=open(p).read()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ma='''#define\u001b[17GPR\u001b[20G4\r\u001b[1B \u001b[2m\u2502\u001b[22m '''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m assert a\u001b[13Gin \u001b[17G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s=s.replace(a,'''#ifndef\u001b[29GPR\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#define\u001b[12GPR\u001b[15G4\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m #endif\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m''')\r\u001b[1B \u001b[2m\u2502\u001b[22m a='''    \u001b[14G  \u001b[17G    for (int r = 0; r < PR;\u001b[45Gr++) {\u001b[52G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G     \u001b[14G     \u001b[20Gfloat32x4x4_t ww = vld1q_f32_x4(w);'''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m a\u001b[6Gsert\u001b[11Ga in\u001b[16Gs\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms=s.replace(a,'''#ifdef\u001b[28GPFD\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             __builtin_prefetch(w\u001b[37G+\u001b[39GPFD,\u001b[44G0,\u001b[47G0);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#endif\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G      \u001b[14G  for (int r = 0; r < PR;\u001b[40Gr++) {\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G      \u001b[16G    float32x4x4_t ww =\u001b[39Gvl\u001b[42G1q_f32_x4(w);''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen(p,'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1"]
[217.937, "C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmkdir\u001b[10G-p\u001b[13G/tmp/c1v2\u001b[23G&&\u001b[26Gfor\u001b[30Gv\u001b[32Gin\u001b[35G\"4\u001b[38G0\"\u001b[41G\"2\u001b[44G0\"\u001b[47G\"8\u001b[50G0\"\u001b[53G\"4\u001b[56G256\"\u001b[61G\"4\u001b[64G1024\"\u001b[70G\"4\u001b[73G4096\"\u001b[79G\"2\u001b[82G1024\";\u001b[89Gdo\u001b[92Gset\u001b[96G--\u001b[99G${=v};\u001b[106GD=\"\";\u001b[112G[\u001b[114G$2\u001b[117G!=\r\u001b[1B \u001b[2m\u2502\u001b[22m 0 ] && D=\"-DPFD=$2\"; cc -O3 -mcpu=apple-m1\u001b[47G-\u001b[49Gtd=c11\u001b[56G-D_DARWIN_C_SOURCE -DPR=$1 $D\u001b[86G-\u001b[88G /\u001b[91Gmp/c1v2/r_$1_$2 run_c1.c ||\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m break; don\u001b[15G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for round\u001b[14Gin\u001b[17G1\u001b[19G2;\u001b[22Gdo\u001b[25Gfor\u001b[29Gv\u001b[31Gin\u001b[34G4_0\u001b[38G2_0\u001b[42G8_0\u001b[46G4_256\u001b[52G4_1024\u001b[59G4_4096\u001b[66G2_1024;\u001b[74Gdo\u001b[77Gecho\u001b[82G\"PR_PFD=$v\u001b[93G$(python3\u001b[103G-I\u001b[106Gtests/bench.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"$PWD\"\u001b[11G/tmp/c1v2/r_$v\u001b[26G|\u001b[28Gsed\u001b[32G-n\u001b[35G3p)\";\u001b[41Gdone;\u001b[47Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[217.938, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
