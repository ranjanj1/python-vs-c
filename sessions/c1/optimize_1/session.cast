[663.614, "\u001b[H\u001b[3Gwith\u001b[8Gthe\u001b[12Gdev\u001b[16Gcheck\u001b[22Gstill\u001b[28Gpassing.\u001b[37GNext\u001b[42GI'll\u001b[47Gvectorize\u001b[57Gargmax\u001b[64G(currently\u001b[75G0.03\u20130.04\u001b[85Gms\u001b[88Gper\u001b[92Gforward)\u001b[101Gwhile\u001b[107Gkeeping\r\u001b[2C\u001b[1Blowest-index\u001b[16Gtie-breaking\u001b[29Gand\u001b[33Ga\u001b[35Gscalar\u001b[42GNaN\u001b[46Gfallback.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mForward time dropped\u001b[24G16%\u001b[28Gon\u001b[31Gthe\u001b[35Gdev\u001b[39Gworkload,\u001b[49Gto\u001b[52G7.47\u001b[57Gms\u001b[60Gper\u001b[64Gforward,\u001b[73Gwith\u001b[78Gmatmuls\u001b[86Gnow\u001b[90Gstreaming\u001b[100Gnear\u001b[105Gthe\u001b[109Gsingle-core\r\u001b[2C\u001b[1Broofline.\u001b[13GI'm\u001b[17Grunning\u001b[25Gthe\u001b[29Gfull\u001b[34Gregression\u001b[45Gsuite\u001b[51Gagainst\u001b[59Gthe\u001b[63Greference\u001b[73Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass, and logits for 1024 positions dropped from\u001b[63G12.5\u001b[68Gs\u001b[70Gto\u001b[73G8.6\u001b[77Gs.\u001b[80GNext\u001b[85GI'll\u001b[90Gtest\u001b[95Gthe\u001b[99Gunshared-classifier\r\u001b[2C\u001b[1Bpath\u001b[8Gand\u001b[12Gthe\u001b[16Gunpacked\u001b[25Gfallback\u001b[34Gwith\u001b[39Ga\u001b[41Gsynthet"]
[663.615, "ic\u001b[51Gcheckpoint\u001b[62Gand\u001b[66Ga\u001b[68Gmixed\u001b[74Gbuild.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Gpaths\u001b[14Gproduce\u001b[22Glogits\u001b[29Gbit-identical\u001b[43Gto\u001b[46Gthe\u001b[50Gnormal\u001b[57Gbuild\u001b[63G(max\u001b[68Gdiff\u001b[73G0),\u001b[77Gwith\u001b[82Gidentical\u001b[92GGENERATE\u001b[101Goutput.\u001b[109GNow\u001b[113Gthe\r\u001b[2C\u001b[1Bfinal before/after timings\u001b[30Gon\u001b[33Gthe\u001b[37Gdev\u001b[41Gworkload.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[4G\u001b[39minal end-to-end timings\u001b[28G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2 3; do /usr/bin/time -p python3 check.py --tokens 64 --prompts 3 -- ./run_c1 2>&1 | grep -E \r\u001b[5C\u001b[1B\"PASS|FAIL|real\"; done; python3 -I tests/bench.py \"$PWD\" ./run_c1; python3 -I tests/bench.py \"$PWD\" ./run_c1 | sed \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m-n\u001b[9G3p; python3 -I tests/loadtime.py \"$PWD\" ./run_c1\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
