[366.528, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe packed single-stream layout hits about 62\u001b[49GGB/s, against roughly 50 GB/s\u001b[79Gfor the\u001b[87Gcurrent k\u001b[97Grnel, so I'm re\u001b[113Gacking\r\u001b[2C\u001b[1Bevery\u001b[9Gmatmul\u001b[16Gweight\u001b[23Gin\u001b[26Gforward-pass\u001b[39Gorder\u001b[45Gat\u001b[48Gload.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRead\u001b[8G\u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacked layout brings\u001b[24Ga\u001b[26Gforward\u001b[34Gpass\u001b[39Gto\u001b[42G7.96\u001b[47Gms,\u001b[51Gwith\u001b[56Gevery\u001b[62Gmatmul\u001b[69Gnear\u001b[74G57\u001b[77GGB/s\u001b[82Gand\u001b[86Glogit\u001b[92Gerrors\u001b[99Gunchanged.\u001b[110GNext\u001b[115GI'll\r\u001b[2C\u001b[1Btry panel height and prefetch distance in the real binary, since\u001b[68Gthere's\u001b[76Gstill\u001b[82Ga\u001b[84G~5\u001b[87GGB/s\u001b[92Ggap\u001b[96Gto\u001b[99Gthe\u001b[103Gmicrobenchmark\r\u001b[2C\u001b[1Bceiling.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPanel\u001b[9Gheights\u001b[17G2\u001b[19Gand\u001b[23G4\u001b[25Gand\u001b[29Gshort\u001b[35Gprefetch\u001b[44"]
[366.53, "Gdistances\u001b[54Gtie\u001b[58Gwithin\u001b[65Gnoise,\u001b[72Gwhile\u001b[78Ga\u001b[80G4\u001b[82GKB\u001b[85Gdistance\u001b[94Gand\u001b[98G8-row\u001b[104Gpanels\u001b[111Gdo\u001b[114Gworse\r\u001b[1B  or no better. I'm going with 4-row panels and no software prefetch, removing the experimental hook, and then checking\u001b[K\r\u001b[1C\u001b[1B load time.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Startup to READY f\u001b[22Gll from about 260 ms to about\u001b[52G93\u001b[55Gms\u001b[58Gmedian,\u001b[66Gsince\u001b[72Gmmap\u001b[77Gwith\u001b[82Gone\u001b[86Gpacking\u001b[94Gcopy\u001b[99Greplaces\u001b[108Gread()\u001b[115Gplus\u001b[120Ga\r\u001b[1C\u001b[1B full memcpy. I'm profiling\u001b[30Ga\u001b[32Glong-context\u001b[45Grun\u001b[49Gnext\u001b[54Gto\u001b[57Gsee\u001b[61Gwhether\u001b[69Gattention\u001b[79Gmatters\u001b[87Gbeyond\u001b[94Gthe\u001b[98Gshort\u001b[104Gdev\u001b[108Gprompts.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Profiling a 1024-p\u001b[22Gsition FIXED run\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ./build.sh profile && python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport subprocess, random\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mra"]
[366.531, "ndom.seed(7)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mseq = [1] + [random.randrange(3, 32000) for _ in range(1023)]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mp = subprocess.Popen([\"./run_c1_prof\", \"model.bin\", \"tokenizer.bin\"], stdin=subprocess.PIPE, \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mstdout=subprocess.PIPE, text=True)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mp.stdout.readline()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mout\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;230;134;102mConcocting\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(5m 58s \u00b7 \u2193\u001b[27G25.5k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G                  \u001b[55G   \u001b[59G            \u001b[72G        \u001b[81G  \u001b[84G                   \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
