[221.759, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gkernel\u001b[14Gis\u001b[17Gpartly\u001b[24GFMA-latency-bound:\u001b[43Ga\u001b[45Gsingle\u001b[52Gstream\u001b[59Gwith\u001b[64G4\u001b[66Gaccumulators\u001b[79Gtops\u001b[84Gout\u001b[88Gnear\u001b[93G51\u001b[96GGB/s,\u001b[102Gwhile\u001b[108Ginterleaved\r\u001b[1B \u001b[3Grows reach\u001b[14Gabout 62 GB/s on the 768-column shap\u001b[51Gs. The 2048-column w2 shape\u001b[79Gstays slow\u001b[90Gr at about 47 GB/s, so I'm\u001b[K\r\u001b[2C\u001b[1Btesting more accumulators and a\u001b[35Gdifferent loop order for it next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpacked\u001b[14Gsingle-stream\u001b[28Glayout\u001b[35Ghits\u001b[40Gabout\u001b[46G62\u001b[49GGB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[1B \u001b[3Gev\u001b[6Gry matmul weight in forward-pass order at load.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacked\u001b[10Glayout\u001b[17Gbrings\u001b[24Ga\u001b[26Gforward\u001b[34Gpass\u001b[39Gto\u001b[42G7.96\u001b[47Gms"]
[221.76, ",\u001b[51Gwith\u001b[56Gevery\u001b[62Gmatmul\u001b[69Gnear\u001b[74G57\u001b[77GGB/s\u001b[82Gand\u001b[86Glogit\u001b[92Gerrors\u001b[99Gunchanged.\u001b[110GNext\u001b[115GI'll\r\u001b[1B \u001b[3Gtry panel height and\u001b[24Gprefetch distance\u001b[42Gin the real binary,\u001b[62Gsince th\u001b[71Gre's still\u001b[83G ~5 GB/s\u001b[92Ggap to\u001b[99Gthe microbenchmark\u001b[K\r\u001b[2C\u001b[1Bceiling.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mBenchmarking\u001b[16Gpanel\u001b[22Gheights\u001b[30Gand\u001b[34Gprefetch\u001b[43Gdistances\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mp='/Users/agentlab/pvc/c1/run_c1.c'\r\u001b[5C\u001b[1Bs\u001b[8Gopen(p).read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ma\u001b[8G'''#defin\u001b[18G PR 4\r\u001b[5C\u001b[1B''\u001b[9G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert a in s\r\u001b[5C\u001b[1Bs=\u001b[9G.\u001b[11Geplace(a,'''#ifndef PR\r\u001b[5C\u001b[1B#define PR 4\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102mend\u001b[11Gf\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m''')\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ma=\u001b[9G'' for (int r = 0; r < PR; r++) {\r\u001b[5C\u001b[1Bfloat32x4x4_t ww\u001b[25Gvld1q_f32_x4(w\u001b[40G;'''\r\u001b[5C\u001b[1Bassert a in s\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;10"]
