[365.166, "s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[2C\u001b[1Bevery matmul weight in\u001b[26Gforward-pass\u001b[39Gorder\u001b[45Gat\u001b[48Gload.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacked layout\u001b[17Gbrings\u001b[24Ga\u001b[26Gforward\u001b[34Gpass\u001b[39Gto\u001b[42G7.96\u001b[47Gms,\u001b[51Gwith\u001b[56Gevery\u001b[62Gmatmul\u001b[69Gnear\u001b[74G57\u001b[77GGB/s\u001b[82Gand\u001b[86Glogit\u001b[92Gerrors\u001b[99Gunchanged.\u001b[110GNext\u001b[115GI'll\r\u001b[2C\u001b[1Btry\u001b[7Gpanel\u001b[13Gheight\u001b[20Gand\u001b[24Gprefetch\u001b[33Gdistance\u001b[42Gin\u001b[45Gthe\u001b[49Greal\u001b[54Gbinary,\u001b[62Gsince\u001b[68Gthere's\u001b[76Gstill\u001b[82Ga\u001b[84G~5\u001b[87GGB/s\u001b[92Ggap\u001b[96Gto\u001b[99Gthe\u001b[103Gmicrobenchmark\r\u001b[1B \u001b[3Gceiling.\u001b[12G\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPanel heights 2 and\u001b[23G4\u001b[25Gand\u001b[29Gshort\u001b[35Gprefetch\u001b[44Gdistances\u001b[54Gtie\u001b[58Gwithin\u001b[65Gnoise,\u001b[72Gwhile\u001b[78Ga\u001b[80G4\u001b[82GKB\u001b[85Gdistance\u001b[94Gand\u001b[98G8-row\u001b[104Gpanels\u001b[111Gdo\u001b[114Gworse\r\u001b[2C\u001b[1Bor\u001b[6Gno bet"]
