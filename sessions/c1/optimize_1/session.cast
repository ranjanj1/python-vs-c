[205.932, "43Ga\u001b[45Gsingle\u001b[52Gstream\u001b[59Gwith\u001b[64G4\u001b[66Gaccumulators\u001b[79Gtops\u001b[84Gout\u001b[88Gnear\u001b[93G51\u001b[96GGB/s,\u001b[102Gwhile\u001b[108Ginterleaved\r\u001b[1B \u001b[3Grows reach\u001b[14Gabout 62 GB/s on the 768-column shap\u001b[51Gs. The 2048-column w2 shape\u001b[79Gstays slow\u001b[90Gr at about 47 GB/s, so I'm\u001b[K\r\u001b[2C\u001b[1Btesting more accumulators and a\u001b[35Gdifferent loop order for it next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpacked\u001b[14Gsingle-stream\u001b[28Glayout\u001b[35Ghits\u001b[40Gabout\u001b[46G62\u001b[49GGB/s,\u001b[55Gagainst\u001b[63Groughly\u001b[71G50\u001b[74GGB/s\u001b[79Gfor\u001b[83Gthe\u001b[87Gcurrent\u001b[95Gkernel,\u001b[103Gso\u001b[106GI'm\u001b[110Grepacking\r\u001b[1B \u001b[3Gev\u001b[6Gry matmul weight in forward-pass order at load.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mImplement\u001b[13Gpacked\u001b[20Gsequential\u001b[31Gweight\u001b[38Glayout\u001b[45Gand\u001b[49Gprofile\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1C\u001b[1B \u23bf  $ python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mp='/Users/agentlab/pvc/c1/run_c1.c'\r\u001b[5C\u001b[1Bs\u001b[8Gopen(p).read()\u001b[39m\u001b[K\r\u001b[5C\u001b["]
