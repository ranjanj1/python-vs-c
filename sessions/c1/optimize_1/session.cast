[635.847, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPanel\u001b[9Gh\u001b[11Gights\u001b[17G2 and 4 and s\u001b[31Gort prefetch dista\u001b[50Gce\u001b[53G tie within noise, while a\u001b[80G4 KB distance \u001b[95Gnd 8-row panels do worse\u001b[K\r\u001b[2C\u001b[1Bor no better.\u001b[17GI'm\u001b[21Ggoing\u001b[27Gwith\u001b[32G4-row\u001b[38Gpanels\u001b[45Gand\u001b[49Gno\u001b[52Gsoftware\u001b[61Gprefetch,\u001b[71Gremoving\u001b[80Gthe\u001b[84Gexperimental\u001b[97Ghook,\u001b[103Gand\u001b[107Gthen\u001b[112Gchecking\r\u001b[2C\u001b[1Bload\u001b[8Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup to READY\u001b[20Gfell from\u001b[31Gbout 260 ms \u001b[44Go about 93 ms m\u001b[60Gdian, since mmap with one packi\u001b[92Gg\u001b[94Gcopy replac\u001b[106Gs\u001b[108Gread() plus\u001b[120Ga\r\u001b[2C\u001b[1Bfull\u001b[8Gmemcpy.\u001b[16GI'm\u001b[20Gprofiling\u001b[30Ga\u001b[32Glong-context\u001b[45Grun\u001b[49Gnext\u001b[54Gto\u001b[57Gsee\u001b[61Gwhether\u001b[69Gattention\u001b[79Gmatters\u001b[87Gbeyond\u001b[94Gthe\u001b[98Gshort\u001b[104Gdev\u001b[108Gprompts.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b["]
[635.847, "1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttent\u001b[10Gon\u001b[13Gat a 1024-p\u001b[25Gsition run takes 3.9 ms per forward (35%), about 6\u00d7 the ba\u001b[84Gdwidth needed\u001b[98Gfor\u001b[102Gthe\u001b[106GKV\u001b[109Gcache.\u001b[116GI'm\r\u001b[2C\u001b[1Bswitching\u001b[13Gthe\u001b[17Gcache\u001b[23Gto\u001b[26Ghead-major\u001b[37Glayout\u001b[44Gand\u001b[48Gcomputing\u001b[58Gfour\u001b[63Gposition\u001b[72Gscores\u001b[79Gat\u001b[82Gonce\u001b[87Gto\u001b[90Gfix\u001b[94Git.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLong-context\u001b[16Gattention fell from 3.89 to 0.82 ms per fo\u001b[59Gward, and the 1024-position run dr\u001b[94Gpped from 11.45 s to\u001b[115G8.36\u001b[120Gs\r\u001b[2C\u001b[1Bwith \u001b[9Ghe \u001b[14Gv\u001b[16Gch\u001b[19Gck still p\u001b[30Gssing. Next\u001b[42GI'll vectorize\u001b[57Gargmax\u001b[64G(currently\u001b[75G0.03\u20130.04\u001b[85Gms\u001b[88Gper\u001b[92Gforward)\u001b[101Gwhile\u001b[107Gkeeping\r\u001b[2C\u001b[1Blowest-index\u001b[16Gtie-breaking\u001b[29Gand\u001b[33Ga\u001b[35Gscalar\u001b[42GNaN\u001b[46Gfallback.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G"]
[635.848, "\u001b[39mF\u001b[5Grward time d\u001b[18Gopped 16% on the dev workload, to 7.47 ms p\u001b[62Gr forward,\u001b[73Gwith matmuls\u001b[86Gnow\u001b[90Gstreaming\u001b[100Gnear\u001b[105Gthe\u001b[109Gsingle-core\r\u001b[2C\u001b[1Broofline.\u001b[13GI'm\u001b[17Grunning\u001b[25Gthe\u001b[29Gfull\u001b[34Gregression\u001b[45Gsuite\u001b[51Gagainst\u001b[59Gthe\u001b[63Greference\u001b[73Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running full regression and differential tests\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 check.py -- ./run_c1 | tail -1 && python3 -I tests/difftest.py \"$PWD\" && python3 -I tests/longctx.py \r\u001b[5C\u001b[1B\"$PWD\" 1024 &&\u001b[21Gpython3 -I tests/context.py \"$PWD\"\u001b[39m\u001b[40;1H\u001b[38;3H"]
