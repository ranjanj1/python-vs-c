[365.933, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gto\u001b[14GREADY\u001b[20Gfell\u001b[25Gfrom\u001b[30Gabout\u001b[36G260\u001b[40Gms\u001b[43Gto\u001b[46Gabout\u001b[52G93\u001b[55Gms\u001b[58Gmedian,\u001b[66Gsince\u001b[72Gmmap\u001b[77Gwith\u001b[82Gone\u001b[86Gpacking\u001b[94Gcopy\u001b[99Greplaces\u001b[108Gread()\u001b[115Gplus\u001b[120Ga\r\u001b[2C\u001b[1Bfull memcpy. I'm profiling\u001b[30Ga\u001b[32Glong-context\u001b[45Grun\u001b[49Gnext\u001b[54Gto\u001b[57Gsee\u001b[61Gwhether\u001b[69Gattention\u001b[79Gmatters\u001b[87Gbeyond\u001b[94Gthe\u001b[98Gshort\u001b[104Gdev\u001b[108Gprompts.\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mProfili\u001b[11Gg a 1024-position FIXED run\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ./build.sh profile && python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mimport subprocess, random\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mrandom.seed(7)\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mseq = [1] + [random.randrange(3, 32000) for _ in range(1023)]\r\u001b[5C\u001b[1Bp = subprocess.Popen([\"./run_c1_prof\", \"model.bin\", \"tokenizer.bin\"], stdin=subprocess.PIPE, \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mstdout=subprocess.PIPE, text=True)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mp.stdout."]
[365.934, "readline()\u001b[26G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mout\u2026\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[84G\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mProfile a 1024-position FIXED run\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[365.935, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m ./build.sh profile &&\u001b[26Gpython3\u001b[34G-I\u001b[37G-\u001b[39G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsubprocess,\u001b[23Grandom\r\u001b[1B \u001b[2m\u2502\u001b[22m random.seed(7)\u001b[19G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m seq = [1] + [random.randrange(3, 32000) for _ in range(1023)]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p =\u001b[8Gsubprocess.Popen([\"./run_c1_prof\",\u001b[43G\"model.bin\",\u001b[56G\"tokenizer.bin\"],\u001b[74Gstdin=subprocess.PIPE,\u001b[97Gstdout=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtext=True)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p.stdout.readline()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mout\u001b[8G=\u001b[10Gp.communicate(\"FIXED\u001b[31G\"\u001b[33G+\u001b[35G\"\u001b[37G\".join(map(str,\u001b[53Gseq))\u001b[59G+\u001b[61G\"\\nQUIT\\n\")[0]\r\u001b[1B \u001b[2m\u2502\u001b[22m print(out[:20])\u001b[20G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[8G\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[365.936, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1m./build.sh profile\u001b[55G\u001b[22mand\u001b[59G\u001b[1mpython3 -I -\u001b[72G\u001b[22mcommands\u001b[81Gin\u001b[84G\u001b[1m/Users/agentlab/pvc/c1\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
