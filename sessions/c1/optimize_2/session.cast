[7.132, "            \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  81 -\u001b[38;2;51;51;51m  - FIXED/LOGITS sequences longer than `seq_len` are truncated to `seq_len`.                          \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m2\u001b[16G\u001b[38;2;51;51;51m`GENERATE 0 ...`\u001b[33Ga\u001b[35Gswers `D\u001b[44GNE 0\u001b[49Gmax` without\u001b[62Grunning the m\u001b[76Gdel.   \u001b[84G     \u001b[90G  \u001b[93G      \u001b[100G    \u001b[105G \u001b[107G    \u001b[112G  \r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m83\u001b[13G\u001b[38;2;51;51;51m - A piece\u001b[24Gwhose\u001b[30Gdecoded\u001b[38Gbyte\u001b[43Gis\u001b[46G0x00\u001b[51Gprints\u001b[58Gas\u001b[61Gempty\u001b[67G(`HEX\u001b[73G`),\u001b[77Gmatching\u001b[86GC-string\u001b[95Gsemantics.\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m4\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G`check.py` passing is necessary\u001b[46Gbut not sufficient. The final gate uses other\u001b[92Ginputs\u001b[99GI\u001b[101Ghave\u001b[106Gnot\u001b[110Gseen\r\u001b[7C\u001b[1B\u001b[38;2;207;34;46m  \u001b[12G\u001b[38;2;51;51;51m.\u001b[14G \u001b[16G         \u001b[26G \u001b[28G    \u001b[33G       \u001b[41G     \u001b[47G \u001b[49G    \u001b[54G       \u001b[62G       \u001b[70G   \u001b[74G      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 192 +\u001b[38;2;51;51;51m  - Out-of-range ids in FIXED/LOGITS are replaced by 0"]
