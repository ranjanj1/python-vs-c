[7.129, "\u001b[H\u001b[9G\u001b[2m\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m4\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G**\u001b[17Gemory layouts\u001b[31Ga\u001b[34G reordered:**\u001b[48Gthe packed weight panels and the head-major KV cache. They hol\u001b[112Gth\r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m   \u001b[12G\u001b[38;2;51;51;51me\u001b[16G      \u001b[23G          \u001b[34G \u001b[36G    \u001b[41G \u001b[43G   \u001b[47G   \u001b[51G  \u001b[54G  \u001b[57G       \u001b[65G   \u001b[69G     \u001b[75G   \u001b[79G     \u001b[85G    \u001b[90G \u001b[92G   \u001b[96G   \u001b[100G    \u001b[105G        \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m185\u001b[12G\u001b[38;2;51;51;51m  same\u001b[19Gvalues\u001b[26Gused\u001b[31Gin\u001b[34Gthe\u001b[38Gsame\u001b[43Gcomputations;\u001b[57GI\u001b[59Gconsider\u001b[68Gthis\u001b[73Gwithin\u001b[80G\"same\u001b[86Gwork,\u001b[92Gsame\u001b[97GKV-cache\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m \u001b[14Gbehaviour\", b\u001b[29G it is a judg\u001b[43Gment\u001b[48Gcall.     \u001b[59G      \u001b[66G      \u001b[73G   \u001b[77G   \u001b[81G          \u001b[92G  \u001b[95G      \u001b[102G    \u001b[107G    \u001b[112G  \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m187\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G**Startup\u001b[24Gcost:**\u001b[32Gthe\u001b[36Gpacking\u001b[44Gadds\u001b[49Ga\u001b[51G~0.1\u001b[56Gs\u001b[58Gone-time\u001b[67Gcopy\u001b[72Gat\u001b[75Gstartup,\u001b[84Gbefore\u001b[91GREADY.\r"]
