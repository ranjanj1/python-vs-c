[300.675, "\u001b[8C\u001b[1B\u001b[38;2;36;138;61m0\u001b[16G\u001b[38;2;51;51;51mwhile i < d:             \u001b[42G \u001b[44G                     \u001b[66G \u001b[68G   \u001b[72G  \u001b[75G  \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m1\u001b[20G\u001b[38;2;51;51;51mxout[unsafe_offset=i]\u001b[42G=\u001b[44Gdot(w.unsafe_offset(i\u001b[66G*\u001b[68Gn),\u001b[72Gx,\u001b[75Gn)\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m2\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G+=\u001b[25G1\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\r\u001b[8C\u001b[1B4\u001b[12G\u001b[38;2;51;51;51m   \u001b[16G                 \u001b[34G     \u001b[40G  \u001b[43G     \u001b[49G  \u001b[52G     \u001b[58G  \u001b[61G    \u001b[66G  \u001b[69G     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[12G\u001b[38;2;51;51;51mdef\u001b[16Gmatmul_rows(xout: FPtr, x:\u001b[43GFP\u001b[46Gr,\u001b[49Gw: FPtr,\u001b[58Gn:\u001b[61GInt, d: Int):\u001b[75G    \u001b[80G     \u001b[86G    \u001b[91G \u001b[93G     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 146 +\u001b[38;2;51;51;51m    # Row-major fallback for n not a multiple of PK_W; MM_ROWS rows share each x load.                \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m7\u001b[25G\u001b[22mR\u001b[32GROWS\r\u001b[8C\u001b[1B\u001b[2m8\u001b[16G\u001b[22mcomptime W = MM_W\r\u001b[5C\u001b[1B\u001b[2m 149 \u001b[22m     var i = 0\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow\u001b[7Gthe\u001b[11Gload-time\u001b[21Gpacking\u001b[29Gand\u001b[33Gthe\u001b"]
[300.676, "[37Gembedding\u001b[47Glookup:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking lowered\u001b[19Gforward \u001b[28Gime from\u001b[37G8.20 to 7.49 ms/token, but\u001b[64Gth\u001b[67G o\u001b[70Gher\u001b[74Gmatrices still\u001b[89Grun\u001b[93Gbelow the\u001b[103Gmicrobenchmark's\r\u001b[2C\u001b[1B62.7\u001b[8GGB/s.\u001b[14GNext\u001b[19GI'll\u001b[24Gtest\u001b[29Gwhether\u001b[37Gthe\u001b[41Gback-to-back\u001b[54Glayout\u001b[61Gin\u001b[64Gexecution\u001b[74Gorder\u001b[80Gaccounts\u001b[89Gfor\u001b[93Gthe\u001b[97Ggap.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix order makes no difference (62.5\u201363.1 GB/s either way), so I won't re-layout further. Next I'll\u001b[105Gsweep\u001b[111Gthe\u001b[115Gpacked\r\u001b[2C\u001b[1Bblock shape in the real program.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m20\u001b[30G2\u001b[39m\u001b[40;1H\u001b[38;3H"]
