[0.545, "d\u001b[17Gthrough\u001b[25Gmy\u001b[28Gown\u001b[32Gline\u001b[37Gbuffer.\u001b[45GMojo's\u001b[52G\u001b[38;2;87;105;247minput()\u001b[60G\u001b[39mopens\u001b[66Ga\u001b[68Gnew\u001b[72Gbuffered\u001b[81Greader\u001b[88Gon\u001b[91Geach\u001b[96Gcall\u001b[101Gand\u001b[105Gcould\u001b[111Glose\u001b[116Glines\r\u001b[4C\u001b[1Bwhen\u001b[10Gcommands\u001b[19Garrive\u001b[26Gtogether.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247m\u001b[1mexp\u001b[39m:\u001b[10G\u001b[22mcomes\u001b[16Gfrom\u001b[21GMojo's\u001b[28Gstandard\u001b[37Glibrary\u001b[45Gand\u001b[49Gcan\u001b[53Gdiffer\u001b[60Gfrom\u001b[65GC's\u001b[69G\u001b[38;2;87;105;247mexpf\u001b[74G\u001b[39min\u001b[77Gthe\u001b[81Glast\u001b[86Gbit.\r\u001b[2C\u001b[2B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GOnly\u001b[10Gthis\u001b[15Gmodel's\u001b[23Gshape\u001b[29Ghas\u001b[33Gactually\u001b[42Gbeen\u001b[47Grun;\u001b[52Gother\u001b[58Gshapes\u001b[65Grely\u001b[70Gon\u001b[73Gthe\u001b[77Ggeneral\u001b[85Gcode\u001b[90Gpaths.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mFIXED\u001b[39m/\u001b[38;2;87;105;247mLOGITS\u001b[18G\u001b[39mwith\u001b[23Gmore\u001b[28Gthan\u001b[33G1024\u001b[38Gids\u001b[42Gprocess\u001b[50Gonly\u001b[55Gthe\u001b[59Gfirst\u001b[65G1024\u001b[70Gand\u001b[74Greport\u001b[81Gthat\u001b[86Gcount.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gweights\u001b[17Gare\u001b[21Gloaded\u001b[28Ginto\u001b[33Gmemory\u001b[40G(about\u001b[47G0.4\u001b[51GGB)\u001b[55Grather\u001b[62Gthan\u001b[67Gmemory-mapped.\r\u001b[2C\u001b[1B-\u001b[5GPassi"]
