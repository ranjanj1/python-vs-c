[54.135, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mKV cache:\u001b[15G\u001b[22mnot\u001b[19Gwiped\u001b[25Gbetween\u001b[33Gcommands.\u001b[43GEvery\u001b[49Gcommand\u001b[57Grestarts\u001b[66Gat\u001b[69Gposition\u001b[78G0\u001b[80Gand\u001b[84Gonly\u001b[89Greads\u001b[95Gcache\u001b[101Grows\u001b[106Git\u001b[109Ghas\u001b[113Gjust\r\u001b[2C\u001b[1B  written, \u001b[17Gthe \u001b[22Ge\u001b[24Gults\u001b[29Gare the sam\u001b[41G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mstdin:\u001b[12G\u001b[22mread\u001b[17Gthrough\u001b[25Gmy\u001b[28Gown\u001b[32Gline\u001b[37Gbuffer.\u001b[45GMojo's\u001b[52G\u001b[38;2;87;105;247minput()\u001b[60G\u001b[39mopens\u001b[66Ga\u001b[68Gnew\u001b[72Gbuffered\u001b[81Greader\u001b[88Gon\u001b[91Geach\u001b[96Gcall\u001b[101Gand\u001b[105Gcould\u001b[111Glose\u001b[116Glines\r\u001b[1B \u001b[3G  when commands arrive together.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247m\u001b[1mexp\u001b[39m:\u001b[10G\u001b[22mcomes\u001b[16Gfrom\u001b[21GMojo's\u001b[28Gstandard\u001b[37Glibrary\u001b[45Gand\u001b[49Gcan\u001b[53Gdiffer\u001b[60Gfrom\u001b[65GC's\u001b[69G\u001b[38;2;87;105;247mexpf\u001b[74G\u001b[39min\u001b[77Gthe\u001b[81Glast\u001b[86Gbit.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[1B  - Only this model's shape has actually been run; other shapes rely on the general code paths.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mFIXED\u001b[39m/\u001b[38;2;87;105;247mLOGITS\u001b[18G\u001b[39mwith\u001b[23Gmore\u001b[28Gthan"]
[54.136, "\u001b[33G1024\u001b[38Gids\u001b[42Gprocess\u001b[50Gonly\u001b[55Gthe\u001b[59Gfirst\u001b[65G1024\u001b[70Gand\u001b[74Greport\u001b[81Gthat\u001b[86Gcount.\r\u001b[1B \u001b[3G- The weights are loaded \u001b[29Gnto mem\u001b[37Gry\u001b[40G(about 0.4\u001b[51GGB)\u001b[55Grather than memory-mapped.\u001b[K\r\u001b[2C\u001b[1B- Passing the\u001b[17Gpublic\u001b[24Gcheck\u001b[30Gdoesn't\u001b[38Gguarantee\u001b[48Gpassing\u001b[56Gthe\u001b[60Gfinal\u001b[66Ggate,\u001b[72Gwhich\u001b[78Guses\u001b[83Gother\u001b[89Ginputs.\r\u001b[2C\u001b[2BNOTES.md also records\u001b[25Gthe\u001b[29Gbuild\u001b[35Gand\u001b[39Gtest\u001b[44Gcommands.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GCooked for 14m 38s \u00b7 done 5:13 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[5C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38"]
[54.137, ";2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll start with what profiling tools exist here and what the development workloads\u001b[86Gare\u001b[90G(the\u001b[95Gfixture\u001b[103Gprompts\u001b[111Gused\u001b[116Gby\r\u001b[2C\u001b[1Bcheck.py).\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Apple M1 at ~60 GB/s matches the expected\u001b[45Gsingle-core\u001b[57Gfigure,\u001b[65Gso\u001b[68GI'm\u001b[72Glooping\u001b[80Gthe\u001b[84Gfixture\u001b[92Gprompts\u001b[100Gand\u001b[104Gsampling\u001b[113Gthe\r\u001b[1B  process with \u001b[38;2;87;105;247m/usr/bin/sample\u001b[39m.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Sample the process d\u001b[24Gring\u001b[29Gthe workload\u001b[42G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ mojo build -g1 mj.mojo -o /tmp/mjprof/mj_g 2>&1 | grep -i error; (python3 -I /tmp/mjprof/work.py /tmp/mjprof/mj_g\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m. 4 > /tmp/mjprof/w.out &) ; sleep 1.5; PID=$(pgrep -f mjprof/mj_g | head -1); /usr/bin/sample $PID 10 -file \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m/tmp/mjprof/sample.txt >/dev/null 2>&1; sleep 6; cat /tmp/mjprof/w.out; gr\u2026\u001b[39m\u001b["]
