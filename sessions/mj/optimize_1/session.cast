[113.274, "[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat\u001b[8Gsampled\u001b[16Gthe\u001b[20GPython\u001b[27Gdriver\u001b[34Ginstead\u001b[42Gof\u001b[45Gthe\u001b[49Gprogram.\u001b[58GSampling\u001b[67Gthe\u001b[71Gchild\u001b[77GPID\u001b[81Gthat\u001b[86Gthe\u001b[90Gdriver\u001b[97Gprints:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul accounts for about 98%\u001b[33Gof\u001b[36Gmain-thread\u001b[48Gsamples,\u001b[57Gwith\u001b[62Gforward\u001b[70Gand\u001b[74Gsoftmax\u001b[82Gminor;\u001b[89GI'm\u001b[93Gchecking\u001b[102Gwhat\u001b[107Gthe\r\u001b[2C\u001b[1Bsemaphore_wait_trap\u001b[23Gsamples\u001b[31Gare\u001b[35Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mListing\u001b[11Gthreads\u001b[19Gin\u001b[22Gthe\u001b[26Gsample\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ awk '/Thread_1756503/{f=1} f&&NR<99999{print} /Thread_1756504/{exit}' /tmp/mjprof/sample.txt | head -12\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
