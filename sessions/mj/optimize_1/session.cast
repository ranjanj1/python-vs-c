[0.543, "4Gmain\u001b[89Gloops\u001b[95Greach\u001b[101Groughly\u001b[109G86%\u001b[113Gof\u001b[116Gthat\r\u001b[2C\u001b[1Blimit.\u001b[10GWhat\u001b[15Gmade\u001b[20Gthe\u001b[24Gdifference:\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMatrix multiply:\u001b[22G\u001b[22m2\u001b[24Grows\u001b[29Gat\u001b[32Ga\u001b[34Gtime\u001b[39Gwith\u001b[44G32-wide\u001b[52GSIMD\u001b[57Gand\u001b[61Gexplicit\u001b[70GFMA,\u001b[75Gchosen\u001b[82Gby\u001b[85Gbenchmarking\u001b[98Gseveral\u001b[106Gsizes.\u001b[113GSoftware\r\u001b[4C\u001b[1Bprefetch\u001b[14Gdidn't\u001b[21Ghelp.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttention:\u001b[16G\u001b[22mreads\u001b[22Gthe\u001b[26GKV\u001b[29Gcache\u001b[35Gin\u001b[38Gposition\u001b[47Gorder,\u001b[54Gcovering\u001b[63Gall\u001b[67Gheads\u001b[73Gper\u001b[77Grow,\u001b[82Gwhich\u001b[88Ggave\u001b[93Gabout\u001b[99G17%\u001b[103Gmore\u001b[108Gspeed\u001b[114Gat\u001b[117Glong\r\u001b[4C\u001b[1Bcontext.\u001b[14GThe\u001b[18Ghead\u001b[23Gsize\u001b[28Gis\u001b[31Ga\u001b[33Gcompile-time\u001b[46Gparameter\u001b[56Gfor\u001b[60G16,\u001b[64G32,\u001b[68G64\u001b[71Gand\u001b[75G128,\u001b[80Gwith\u001b[85Ga\u001b[87Ggeneral\u001b[95Gpath\u001b[100Gfor\u001b[104Gother\u001b[110Gsizes.\u001b[117GI\r\u001b[4C\u001b[1Bforced\u001b[12Gthat\u001b[17Ggeneral\u001b[25Gpath\u001b[30Gon\u001b[33Gand\u001b[37Git\u001b[40Galso\u001b[45Gpasses\u001b[52Gthe\u001b[56Gcheck.\r\u001b[2C\u001b[2B\u001b[1mSmall deviations from run.c, all in NOTES.md:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mRoPE constants:\u001b[21G\u001b[22mMojo's\u001b[2"]
