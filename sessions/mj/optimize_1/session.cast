[53.665, "s\u001b[32Gthe\u001b[36Gexpected\u001b[45Gsingle-core\u001b[57Gfigure,\u001b[65Gso\u001b[68GI'm\u001b[72Glooping\u001b[80Gthe\u001b[84Gfixture\u001b[92Gprompts\u001b[100Gand\u001b[104Gsampling\u001b[113Gthe\r\u001b[1B  process with \u001b[38;2;87;105;247m/usr/bin/sample\u001b[39m.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Sample the process during the workload\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ mojo build -g1 mj.mojo -o /tmp/mjprof/mj_g 2>&1 | grep -i error; (python3 -I /tmp/mjprof/work.py /tmp/mjprof/mj_g\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m. 4 > /tmp/mjprof/w.out &) ; sleep 1.5; PID=$(pgrep -f mjprof/mj_g | head -1); /usr/bin/sample $PID 10 -file \u001b[116G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102m/tmp/mjprof/sample.txt >/dev/null 2>&1; sleep 6; cat /tmp/mjprof/w.out; gr\u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
