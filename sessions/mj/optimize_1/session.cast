[373.12, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mfrom std.memory.alloc import alloc, Layout\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfrom std.time import perf_counter_ns\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef sweep[S: Int](p: FPtr, n: Int) -> Float64:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  # S sequential streams, each over a contiguous 1/S of the buffer\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var best = Float64(1e18)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var seg = n // S\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var tot: Float32 = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for rep in range(6):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      var t0 = perf_counter_ns()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      var acc = Array[SIMD[DType.float32,\u001b[48G16],\u001b[53GS](fill=0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      var j = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      while j + 16 <=\u001b[28Gseg:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mcomptime\u001b[25Gfor\u001b[29Gs\u001b[31Gin\u001b[34Grange(S):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G   \u001b[11G         acc[s] += p.unsaf\u001b[38G_offset(s * seg +\u001b[56Gj).unsafe_load[width=16]()\r\u001b[1C\u001b[1B\u001b[2m"]
[373.121, "\u2502\u001b[16G\u001b[22mj\u001b[18G+=\u001b[21G16\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         comptime for s in range(S):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mtot\u001b[20G+=\u001b[23Gacc[s].reduce_add()\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G var dt\u001b[19G= Float64(p\u001b[31Gr\u001b[33G_counter_ns() - t0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G    if dt < best: best = dt\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(S,\u001b[17G\"streams\u001b[26GGB/s\",\u001b[33GFloat64(n\u001b[43G*\u001b[45G4)\u001b[48G/\u001b[50Gbest,\u001b[56Gtot)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     return best\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gmain():\r\u001b[1B \u001b[2m\u2502\u001b[22m     var n =\u001b[16G438381596 // 4\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     var \u001b[13G = alloc(Layout[Flo\u001b[33Gt32,\u001b[38Galignment\u001b[48G=\u001b[50G.of_bytes[64]()](count=n)).unsafe_leak()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gi\u001b[14Gin\u001b[17Grange(n):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         p[unsafe_offset=i]\u001b[31G=\u001b[33GFloat32(i\u001b[43G&\u001b[45G7)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22m_\u001b[10G=\u001b[12Gsweep[1](p,\u001b[24Gn);\u001b[28G_\u001b[30G=\u001b[32Gsweep[2](p,\u001b[44Gn);\u001b[48G_\u001b[50G=\u001b[52Gsweep[4](p,\u001b[64Gn);\u001b[68G_\u001b[70G=\u001b[72Gsweep[8](p,\u001b[84Gn);\u001b[88G_\u001b[90G=\u001b[92Gsweep[1](p,\u001b[104Gn)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b["]
