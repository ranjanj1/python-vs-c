[647.421, "\u001b[H\u001b[3G- \u001b[1mPer-matrix timers:\u001b[22m every weight matrix was read at only 45\u201357\u001b[67GGB/\u001b[71G. The w2\u001b[80Gmatrix\u001b[87Gwas\u001b[91Gthe\u001b[95Gworst\u001b[101Gat\u001b[104G45\u001b[107GGB/s.\r\u001b[4C\u001b[1B\u001b[1mB\u001b[7Gndwidth ceiling:\u001b[22m one\u001b[28Gsequent\u001b[36Gal read s\u001b[46Gr\u001b[48Ga\u001b[50G reac\u001b[56Ges 62.5 GB/s\u001b[69Gon this M1, which works out to about 7.0 ms\u001b[113Gper\r\u001b[2C\u001b[1B \u001b[5Gtoken. Several streams at once are slower.\u001b[48G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC\u001b[7Guse:\u001b[22m the old kernel read several rows at once, w\u001b[56Gich means several separate memory streams. L\u001b[101Gying\u001b[106Gthe\u001b[110Gweights\u001b[118Gout\r\u001b[4C\u001b[1Bs\u001b[7G \u001b[9Gach mat\u001b[17Gix\u001b[20Gis read\u001b[29Gs\u001b[33Ge sequential stream\u001b[53Greaches\u001b[61G62\u201363\u001b[67GGB/s\u001b[72Gin\u001b[75Ga\u001b[77Gmicrobenchmark.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe change:\u001b[22m at load\u001b[23Gtime\u001b[28Geach weight matrix is rea\u001b[54Gr\u001b[56Gng\u001b[59Gd\u001b[61Ginto blocks of 8 rows, so the matrix-vector\u001b[105Gproduct\u001b[113Greads\r\u001b[2C\u001b[1Bone\u001b[7Gsequential\u001b[18Gstream.\r\u001b[2C\u001b[1B- The weights,\u001b[18Gfloat32 pr\u001b[29Gcision, the one-product-per-w\u001b[59Gight-per-to\u001b[71Gen shape and\u001b[84G"]
[647.423, "the amoun\u001b[94G of work are all unch\u001b[116Gnged;\r\u001b[2C\u001b[1B  only the order in \u001b[24Gemory\u001b[30Gdiffers.\r\u001b[4C\u001b[1BW\u001b[8Gn the \u001b[15Goken embedding table is also the classifier, embedding lookups re\u001b[81Gd rows\u001b[88Gback out of the n\u001b[106Gw \u001b[109Gayout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMatrices\u001b[14Gwith an input length that\u001b[40Gisn't\u001b[46Ga\u001b[48Gmultiple\u001b[57Gof\u001b[60G8\u001b[62Gkeep\u001b[67Gthe\u001b[71Gold\u001b[75Glayout\u001b[82Gand\u001b[86Gkernel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[42G\u2502\u001b[46Gbefore\u001b[55G\u2502\u001b[59Gafter\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[42G\u253c\u001b[55G\u253c\u001b[68G\u2524\r\u001b[4C\u001b[1BGENERATE\u001b[14Gon\u001b[17Gthe\u001b[21Gdevelopment\u001b[33Gworkload\u001b[44G~124 pos/s\u001b[57G~133 pos/s\r\u001b[4C\u001b[2BLOGITS on the dev\u001b[23Glopment workload  \u001b[47G0\u001b[60G1\r\u001b[4C\u001b[2BFIXED,\u001b[12G1024 positions    \u001b[31G        \u001b[44G1\u001b[46G1 tok/s \u001b[57G121 tok/s \r\u001b[4C\u001b[2BTime to \u001b[38;2;87;105;247mREADY\u001b[39m        \u001b[44G0.069 s  \u001b[57G0.090 "]
[647.425, "s  \r\u001b[2C\u001b[1B\u2514\u001b[42G\u2534\u001b[55G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary\u001b[13Gbuffer\u001b[20Gand\u001b[24Grearranging\u001b[36Git\u001b[39Gfrom\u001b[44Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m, b\u001b[18Gyond ch\u001b[26Gck.py:\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mEarli\u001b[11Gr protocol tests:\u001b[22m PIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[4C\u001b[1Bare\u001b[9Gunchanged.\r\u001b[4C\u001b[1B\u001b[1mUnshared classifier\u001b[22m (the supplied model does\u001b[50G't\u001b[53Guse one):\u001b[63Ga temporary checkpoint bui\u001b[90Gt\u001b[92Gfor this gave bit-identical\u001b[K\r\u001b[4C\u001b[1Blogits and the\u001b[20Gsame\u001b[25Goutput.\u001b[33GI\u001b[35Gdeleted\u001b[43Git\u001b[46Gafterwards\u001b[57Gbecause\u001b[65Gthe\u001b[69Gdisk\u001b[74Gis\u001b[77G98%\u001b[81Gfull.\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[647.781, "\u001b[H\u001b[5G\u001b[1mBandwidth ce\u001b[18Gling\u001b[24G\u001b[22mon\u001b[27G sequential read\u001b[44Gstream re\u001b[54Gches 62.\u001b[63G GB/s on this\u001b[77GM1, which\u001b[88Gorks out to about 7.0 ms\u001b[113Gper\r\u001b[2C\u001b[1B \u001b[5Gtoken. Several streams\u001b[28Gat once \u001b[37Gre slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCause:\u001b[12G\u001b[22mthe old\u001b[20Gke\u001b[23Gnel read several\u001b[40Grows at\u001b[48Gonce,\u001b[54Gwhich\u001b[60Gmeans\u001b[66Gseveral\u001b[74Gseparate\u001b[83Gmemory\u001b[90Gstreams.\u001b[99GLaying\u001b[106Gthe\u001b[110Gweights\u001b[118Gout\r\u001b[2C\u001b[1B \u001b[5Gso each matrix\u001b[20Gis r\u001b[25Gad as on\u001b[34G sequential stream reaches 62\u201363 GB/s in a microbenchmark.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe change:\u001b[15G\u001b[22mat\u001b[18Gload\u001b[23Gtime\u001b[28Geach\u001b[33Gweight\u001b[40Gmatrix\u001b[47Gis\u001b[50Grearranged\u001b[61Ginto\u001b[66Gblocks\u001b[73Gof\u001b[76G8\u001b[78Grows,\u001b[84Gso\u001b[87Gthe\u001b[91Gmatrix-vector\u001b[105Gproduct\u001b[113Greads\r\u001b[2C\u001b[1Bone sequenti\u001b[16Gl\u001b[18Gstream.\u001b[K\r\u001b[2C\u001b[1B- The weights,\u001b[18Gfloat32\u001b[26Gprecision,\u001b[37Gthe\u001b[41Gone-product-per-weight-per-token\u001b[74Gshape\u001b[80Gand\u001b[84Gthe\u001b[88Gamount\u001b[95Gof\u001b[98Gwork\u001b[103Gare\u001b[107Gall\u001b[111Gunchanged;\r\u001b[2C\u001b[1B \u001b[5Gonly the order in "]
[647.782, "memo\u001b[28Gy differs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWhen\u001b[14Gtok\u001b[18Gn\u001b[20Gembedding\u001b[30Gtabl\u001b[35G is\u001b[39Galso\u001b[44Gthe\u001b[48Gclassifier,\u001b[60Gembedding\u001b[70Glookups\u001b[78Gread\u001b[83Grows\u001b[88Gback\u001b[93Gout\u001b[97Gof\u001b[100Gthe\u001b[104Gnew\u001b[108Glayout.\r\u001b[4C\u001b[1BMatrices\u001b[14Gwith an input length that i\u001b[42Gn'\u001b[45G a\u001b[48Gmultiple of\u001b[60G8 k\u001b[64Gep the \u001b[72Gld layout and kernel.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                                      \u2502   before   \u2502   after    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE on the development workload \u2502 ~124 pos/s \u2502 ~133 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
