[421.455, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Packing\u001b[11Glowered forward time from\u001b[37G8.20 to 7.49 ms/token, but the other\u001b[74Gmatrices\u001b[83Gstill\u001b[89Grun\u001b[93Gbelow\u001b[99Gthe\u001b[103Gmicrobenchmark's\r\u001b[1C\u001b[1B 62.7\u001b[8GGB/s. N\u001b[16Gxt\u001b[19GI'll test whether the back-to-back layout in execution\u001b[74Gorder\u001b[80Gaccounts\u001b[89Gfor\u001b[93Gthe\u001b[97Ggap.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Matrix\u001b[10Gorder\u001b[16Gmak\u001b[20Gs no difference (62.5\u201363.1 GB/s either way),\u001b[65Gso\u001b[68GI won't\u001b[76Gre-layout\u001b[86Gfurther.\u001b[95GNext\u001b[100GI'll\u001b[105Gsweep\u001b[111Gthe\u001b[115Gpacked\r\u001b[1C\u001b[1B block\u001b[9Gshape in\u001b[18Gthe real program.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All\u001b[7Gblock shapes now land around 134\u2013136 tok/s, so the kernel\u001b[65Gis memory-bound\u001b[81Gand\u001b[85GI'm\u001b[89Gkeeping\u001b[97G8\u00d78.\u001b[102GNext\u001b[107GI'll\u001b[112Grun\u001b[116Ga\r\u001b[1C\u001b[1B quick\u001b[9Gread-bandwidth t\u001b[26Gst to\u001b[32Gsee\u001b[36Gwhether\u001b[44Gse"]
[421.456, "veral\u001b[52Gdistant\u001b[60Gsequential\u001b[71Gstreams\u001b[79Gbeat\u001b[84Gone.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gsingle seque\u001b[20Gti\u001b[23Gl stream\u001b[32Greaches\u001b[40G62.5\u001b[45GGB/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gpacked\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[1C\u001b[1B matmul\u001b[10Gwork\u001b[15Gis done. Next I'll measure startup\u001b[50Gt\u001b[53Ge\u001b[55Gto \u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Packing\u001b[11Gcosts\u001b[17Gabout 55 ms at st\u001b[35Grtup but sti\u001b[48Gl pays\u001b[55Goff in tokens, so\u001b[73GI'm\u001b[77Gcutting\u001b[85Gthe\u001b[89Gextra\u001b[95Gfull\u001b[100Gcopy\u001b[105Gby\u001b[108Greading\u001b[116Geach\r\u001b[1C\u001b[1B matrix\u001b[10Gstraight into its final\u001b[34Gslot.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Reading\u001b[11Gweights\u001b[19Gsectionwise\u001b[31Gand\u001b[35Gpack\u001b[40Gfrom\u001b[45Gtemp\r\u001b[1B\u001b[38;2;102;102;10"]
