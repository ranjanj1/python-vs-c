[226.98, "\u001b[H\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 117 +\u001b[38;2;51;51;51m        matmul_packed(xout, x, w, n, d)                                                                           \r\u001b[1B\u001b[38;2;36;138;61m 118 +\u001b[38;2;51;51;51m    else:                                                                                                         \r\u001b[1B\u001b[38;2;36;138;61m 119 +\u001b[38;2;51;51;51m        matmul_rows(xout, x, w, n, d)                                                                             \r\u001b[1B\u001b[38;2;36;138;61m 120 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 121 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 122 +\u001b[38;2;51;51;51mdef matmul_packed(xout: FPtr, x: FPtr, w: FPtr, n: Int, d: Int):                                                  \r\u001b[1B\u001b[38;2;36;138;61m 123 +\u001b[38;2;51;51;51m    comptime R "]
