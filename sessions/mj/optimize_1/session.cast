[148.669, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Apple\u001b[9GM1\u001b[12Gat ~60 GB/s matches the\u001b[36Gexpected single-core\u001b[57Gfigure,\u001b[65Gso\u001b[68GI'm\u001b[72Glooping\u001b[80Gthe\u001b[84Gfixture\u001b[92Gprompts\u001b[100Gand\u001b[104Gsampling\u001b[113Gthe\r\u001b[1C\u001b[1B process\u001b[11Gwith \u001b[38;2;87;105;247m/usr/bin/sample\u001b[39m.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m That\u001b[8Gsampled\u001b[16Gthe Py\u001b[23Ghon driver\u001b[34Ginstead\u001b[42Gof\u001b[45Gthe\u001b[49Gprogram.\u001b[58GSampling\u001b[67Gthe\u001b[71Gchild\u001b[77GPID\u001b[81Gthat\u001b[86Gthe\u001b[90Gdriver\u001b[97Gprints:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Matmul accounts\u001b[19Gfo\u001b[23Gabout\u001b[29G98% of main-thread samples, with forward and softmax minor;\u001b[89GI'm checking wh\u001b[105Gt the\u001b[K\r\u001b[1C\u001b[1B semapho\u001b[11Ge\u001b[13Gwait_t\u001b[20Gap samples are\u001b[35Gnext.\u001b[42G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pat"]
[148.67, "tern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Four\u001b[8Gextra\u001b[14Gthreads are\u001b[26Gthe Mojo runtime's o\u001b[47Gn idle worker pool, so they add no compute; matmul\u001b[98Gis \u001b[102Gbout\u001b[107G98%\u001b[111Gof\r\u001b[1C\u001b[1B runtime.\u001b[12GI'm\u001b[16Gadding an\u001b[26Goptional PROFILE build \u001b[50Glag to \u001b[58Gime matmul\u001b[69Gper\u001b[73Gmatrix\u001b[80Gand\u001b[84Greport\u001b[91Geffective\u001b[101GGB/s.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'll\u001b[8Gdo\u001b[11Gthis\u001b[16Gas\u001b[19Gan \u001b[24Gstrumented copy generated by a script, so \u001b[38;2;87;105;247mmj.mojo\u001b[39m itself stays clea\u001b[92G.\u001b[94G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Building\u001b[12Ginst\u001b[17Gumented copy\u001b[30Gand\u001b[34Gprofiling\u001b[44Gphases\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/mjprof/instrument.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m# Generates an instrumented copy of mj.mojo with per-phase wall-clock timers (perf_counter_ns).\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102"]
