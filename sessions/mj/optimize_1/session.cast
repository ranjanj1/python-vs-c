[649.371, "\u001b[H\r\u001b[4C\u001b[34BThe\u001b[9GMojo\u001b[14Gruntime\u001b[22Gstarts\u001b[29G4\u001b[31Gworker\u001b[38Gthreads\u001b[46Gof\u001b[49Gits\u001b[53Gown\u001b[57Gwhen\u001b[62Gthe\u001b[66Gprocess\u001b[74Glaunches.\u001b[84GThey\u001b[89Gsat\u001b[93Gidle\u001b[98Gfor\u001b[102G100%\u001b[107Gof\u001b[110Gthe\u001b[40;1H\u001b[38;3H"]
[649.528, "\u001b[H\u001b[3G-\u001b[5GMatrices\u001b[14Gwith an input length that\u001b[40Gisn't\u001b[46Ga\u001b[48Gmultiple\u001b[57Gof\u001b[60G8\u001b[62Gkeep\u001b[67Gthe\u001b[71Gold\u001b[75Glayout\u001b[82Gand\u001b[86Gkernel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[42G\u2502\u001b[46Gbefore\u001b[55G\u2502\u001b[59Gafter\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[42G\u253c\u001b[55G\u253c\u001b[68G\u2524\r\u001b[4C\u001b[1BGENERATE\u001b[14Gon\u001b[17Gthe\u001b[21Gdevelopment\u001b[33Gworkload\u001b[44G~124 pos/s\u001b[57G~133 pos/s\r\u001b[4C\u001b[2BLOGITS on the dev\u001b[23Glopment workload  \u001b[47G0\u001b[60G1\r\u001b[4C\u001b[2BFIXED,\u001b[12G1024 positions    \u001b[31G        \u001b[44G1\u001b[46G1 tok/s \u001b[57G121 tok/s \r\u001b[4C\u001b[2BTime to \u001b[38;2;87;105;247mREADY\u001b[39m        \u001b[44G0.069 s  \u001b[57G0.090 s  \r\u001b[2C\u001b[1B\u2514\u001b[42G\u2534\u001b[55G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary\u001b[13Gbuffer\u001b[20Gand\u001b"]
[649.53, "[24Grearranging\u001b[36Git\u001b[39Gfrom\u001b[44Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m, b\u001b[18Gyond ch\u001b[26Gck.py:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEarlier protocol tests:\u001b[29G\u001b[22mPIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[2C\u001b[1B  are unchanged.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mUnshared classifier\u001b[22m (the supplied model does\u001b[50G't\u001b[53Guse one):\u001b[63Ga temporary checkpoint bui\u001b[90Gt\u001b[92Gfor this gave bit-identical\u001b[K\r\u001b[4C\u001b[1Blogits and the\u001b[20Gsame\u001b[25Goutput.\u001b[33GI\u001b[35Gdeleted\u001b[43Git\u001b[46Gafterwards\u001b[57Gbecause\u001b[65Gthe\u001b[69Gdisk\u001b[74Gis\u001b[77G98%\u001b[81Gfull.\r\u001b[4C\u001b[1B\u001b[1mOther code paths, via temporary builds:\u001b[45G\u001b[22mf\u001b[47Grcing\u001b[53Gth\u001b[58Gld layout everywher\u001b[78G, and a\u001b[87Glock\u001b[92Gsize that leaves leftover\u001b[K\r\u001b[4C\u001b[1Br\u001b[7Gws, both\u001b[16Gpass th\u001b[25Gf\u001b[27Gll check.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I didn't do:\u001b[21G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gdidn't\u001b[14Grun\u001b[18Gseveral\u001b[26Gpositions\u001b[36Gthrough\u001b[44Geach\u001b[4"]
[649.532, "9Gpass\u001b[54Gover\u001b[59Gthe\u001b[63Gweights.\u001b[72GThat\u001b[77Gwould\u001b[83Gbe\u001b[86Gmuch\u001b[91Gfaster\u001b[98Gfor\u001b[102Gprompts\u001b[110Gand\r\u001b[2C\u001b[1B  FIXED/LOGITS, but\u001b[23Gthe\u001b[27Grules\u001b[33Grequire\u001b[41Gbatch\u001b[47Gsize\u001b[52G1\u001b[54Gand\u001b[58Gthe\u001b[62Gsame\u001b[67Goperation\u001b[77Gshapes.\r\u001b[4C\u001b[1BSoftware\u001b[14Gprefetch, using several streams at\u001b[49Gonce, and\u001b[59Gdifferent block shapes made no difference or were slower.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRemaining limitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- The Mojo runtime starts\u001b[29G4\u001b[31Gworker\u001b[38Gthreads\u001b[46Gof\u001b[49Gits\u001b[53Gown\u001b[57Gwhen\u001b[62Gthe\u001b[66Gprocess\u001b[74Glaunches.\u001b[84GThey\u001b[89Gsat\u001b[93Gidle\u001b[98Gfor\u001b[102G100%\u001b[107Gof\u001b[110Gthe\r\u001b[4C\u001b[1Bprofile;\u001b[14GI\u001b[16Gleft\u001b[21Gthem\u001b[26Galone\u001b[32Gbecause\u001b[40Gthe\u001b[44Grules\u001b[50Gforbid\u001b[57Gsetting\u001b[65Gthread\u001b[72Gcounts.\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[649.829, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                                      \u2502   before   \u2502   after    \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE on the development workload \u2502 ~124 pos/s \u2502 ~133 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS on the development workload   \u2502 ~120 pos/s \u2502 ~131 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500"]
[649.831, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED, 1024 positions                \u2502 111 tok/s  \u2502 121 tok/s  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Time to \u001b[38;2;87;105;247mREADY\u001b[39m                        \u2502 0.069 s    \u2502 0.090 s    \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gstartup\u001b[15Gcost\u001b[20Gwas\u001b[24G55\u001b[27Gms\u001b[30Gat\u001b[33Gfirst.\u001b[40GI\u001b[42Gcut\u001b[46Git\u001b[49Gto\u001b[52Gabout\u001b[58G20\u001b[61Gms\u001b[64Gby\u001b[67Greading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btempor\u001b[11Gy buffer\u001b[20Gand\u001b[24Grearranging i\u001b[38G from \u001b[45Ghere.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m,\u001b[16Gb"]
[649.833, "eyond\u001b[23Gcheck.py:\r\u001b[2C\u001b[1B- \u001b[1mEarli\u001b[11Gr protocol tests:\u001b[22m PIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[2C\u001b[1B \u001b[5Gare unchanged.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mUnshared classifier\u001b[25G\u001b[22m(the\u001b[30Gsupplied\u001b[39Gmodel\u001b[45Gdoesn't\u001b[53Guse\u001b[57Gone):\u001b[63Ga\u001b[65Gtemporary\u001b[75Gcheckpoint\u001b[86Gbuilt\u001b[92Gfor\u001b[96Gthis\u001b[101Ggave\u001b[106Gbit-identical\r\u001b[2C\u001b[1B \u001b[5Glogits and the same\u001b[25Goutput. I d\u001b[37Glete\u001b[42G it afterwards\u001b[57Gbecause\u001b[66Ghe disk is 98% full.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther code paths, via temporary builds:\u001b[22m forcing the\u001b[57Gold layout everywhere, and a block\u001b[92Gsize\u001b[97Gthat\u001b[102Gleaves\u001b[109Gleftover\r\u001b[2C\u001b[1B \u001b[5Grows, both pass the full check.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I didn't do:\r\u001b[2C\u001b[1B\u001b[22m- I didn't run several\u001b[26Gpositions\u001b[36Gthrough\u001b[44Geach\u001b[49Gpass\u001b[54Gover\u001b[59Gthe\u001b[63Gweights.\u001b[72GThat\u001b[77Gwould\u001b[83Gbe\u001b[86Gmuch\u001b[91Gfaster\u001b[98Gfor\u001b[102Gprompts\u001b[1"]
[649.834, "10Gand\r\u001b[2C\u001b[1B \u001b[5GFIXED/LOGITS, but the rules requi\u001b[39Ge batch size 1\u001b[54Gand the same operation\u001b[77Gshapes.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSoftware prefetch, using several stre\u001b[43Gms at once, and differ\u001b[66Gnt block shapes made\u001b[87Gno\u001b[90Gdifference\u001b[101Gor\u001b[104Gwere\u001b[109Gslower.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRemaining limitations:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9GMojo\u001b[14Gruntime\u001b[22Gstarts\u001b[29G4\u001b[31Gworker\u001b[38Gthreads\u001b[46Gof\u001b[49Gits\u001b[53Gown\u001b[57Gwhen\u001b[62Gthe\u001b[66Gprocess\u001b[74Glaunches.\u001b[84GThey\u001b[89Gsat\u001b[93Gidle\u001b[98Gfor\u001b[102G100%\u001b[107Gof\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5Gprofile;\u001b[14GI left them alone because the rules forbid\u001b[57Gsetting th\u001b[68Gead counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLoad\u001b[10Gng now briefly needs an extra\u001b[40G98 MB buffer, freed before \u001b[38;2;87;105;247mREADY\u001b[39m.\u001b[K\u001b[40;1H\u001b[38;3H"]
[650.082, "\u001b[H\r\u001b[2C\u001b[30B-\u001b[5GThe\u001b[9GMojo\u001b[14Gruntime\u001b[22Gstarts\u001b[29G4\u001b[31Gworker\u001b[38Gthreads\u001b[46Gof\u001b[49Gits\u001b[53Gown\u001b[57Gwhen\u001b[62Gthe\u001b[66Gprocess\u001b[74Glaunches.\u001b[84GThey\u001b[89Gsat\u001b[93Gidle\u001b[98Gfor\u001b[102G100%\u001b[107Gof\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5Gprofile;\u001b[14GI left them alone because the rules forbid\u001b[57Gsetting th\u001b[68Gead counts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GLoad\u001b[10Gng now briefly needs an extra\u001b[40G98 MB buffer, freed before \u001b[38;2;87;105;247mREADY\u001b[39m.\u001b[K\r\u001b[4C\u001b[1BI only pr\u001b[15Gfiled phase by phas\u001b[35G at the\u001b[43Gshort d\u001b[51Gvelopm\u001b[58Gnt cont\u001b[66Gxts (at\u001b[74Gmost\u001b[79G82\u001b[82Gpositions).\r\u001b[2C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[650.297, "\u001b]0;\u25d1 Claude Code\u0007"]
