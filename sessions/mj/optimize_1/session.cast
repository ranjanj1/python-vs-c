[472.075, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle\u001b[14Gsequential\u001b[25Gstream\u001b[32Greaches\u001b[40G62.5\u001b[45GGB/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gpacked\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[2C\u001b[1Bmatmul work is done.\u001b[24GNext\u001b[29GI'll\u001b[34Gmeasure\u001b[42Gstartup\u001b[50Gtime\u001b[55Gto\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking\u001b[11Gcosts\u001b[17Gabout\u001b[23G55\u001b[26Gms\u001b[29Gat\u001b[32Gstartup\u001b[40Gbut\u001b[44Gstill\u001b[50Gpays\u001b[55Goff\u001b[59Gin\u001b[62Gtokens,\u001b[70Gso\u001b[73GI'm\u001b[77Gcutting\u001b[85Gthe\u001b[89Gextra\u001b[95Gfull\u001b[100Gcopy\u001b[105Gby\u001b[108Greading\u001b[116Geach\r\u001b[2C\u001b[1Bmatrix straight into\u001b[24Gits\u001b[28Gfinal\u001b[34Gslot.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing one\u001b[14Goffset\u001b[21Gbug\u001b[25Gbefore\u001b[32Gbuilding\u001b[41G(\u001b[38;2;87;105;247mrms_att_weight\u001b[57G\u001b[39mupper"]
