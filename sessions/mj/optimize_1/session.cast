[303.228, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m 147 \u001b[22m     comptime R = MM_ROWS\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 148 \u001b[22m     comptime W = MM_W\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow the load-time packing and the embedding lookup:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking lowered forward time from 8.20 to 7.49 ms/token, but the other matrices still run below the microbenchmark's\r\u001b[2C\u001b[1B62.7 GB/s. Next I'll test whether the back-to-back layout in execution order accounts for the gap.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix order makes no difference (62.5\u201363.1 GB/s either way), so I won't re-layout further. Next I'll sweep the\u001b[115Gpacked\r\u001b[2C\u001b[1Bblock shape in the real program.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mSweeping packed block sh"]
[303.229, "apes in\u001b[35Gthe\u001b[39Gfull\u001b[44Gprogram\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; for R W in 8 8 4 16 8 16 16 8 4 8; do sed -e \"s/^comptime PK_R = 8/comptime PK_R = \r\u001b[5C\u001b[1B$R/\" -e \"s/^comptime PK_W = 8/comptime PK_W = $W/\" mj.mojo > /tmp/mjprof/v.mojo && mojo build /tmp/mjprof/v.mojo -o\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m/tmp/mjprof/pk_${R}_${W} 2>&1 | grep -i error; done; for rep in 1 2 3; \u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mSweep packed block shapes in the full program\u001b[39m\u001b[K\r\u001b[1B\u001b[38;"]
[303.23, "2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cd /Users/agentlab/pvc/mj;\u001b[31Gfor\u001b[35GR\u001b[37GW\u001b[39Gin\u001b[42G8\u001b[44G8\u001b[46G4\u001b[48G16\u001b[51G8\u001b[53G16\u001b[56G16\u001b[59G8\u001b[61G4\u001b[63G8;\u001b[66Gdo\u001b[69Gsed\u001b[73G-e\u001b[76G\"s/^comptime\u001b[89GPK_R\u001b[94G=\u001b[96G8/comptime\u001b[107GPK_R\u001b[112G=\u001b[114G$R/\"\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-e\u001b[7G\"s/^comptime\u001b[20GPK_W\u001b[25G=\u001b[27G8/comptime\u001b[38GPK_W\u001b[43G=\u001b[45G$W/\"\u001b[50Gmj.mojo\u001b[58G>\u001b[60G/tmp/mjprof/v.mojo\u001b[79G&&\u001b[82Gmojo\u001b[87Gbuild\u001b[93G/tmp/mjprof/v.mojo\u001b[112G-o\r\u001b[1B \u001b[2m\u2502\u001b[22m /\u001b[6Gmp/mjprof/pk_${R}_${W} 2>&1 |\u001b[36Ggrep -i error; done; for rep\u001b[65Gin\u001b[68G1\u001b[70G2 3; do for v in 8_8 4_16 8_16 16_8 4_8;\u001b[111Gdo echo\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m -n \"R_W=$v: \"; python3\u001b[27G-I /tm"]
[303.232, "p/mjtest/bench.py\u001b[51G/tmp/mjprof/pk_$v\u001b[69G.;\u001b[72Gdone;\u001b[78Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m statement directly follows\u001b[31Ganother\u001b[39Gstatement\u001b[49Gon\u001b[52Gthe\u001b[56Gsame\u001b[61Gline\u001b[66G\u2014\u001b[68Gbash\u001b[73Greads\u001b[79Gthe\u001b[83Gtext\u001b[88Gas\u001b[91Gone\u001b[95Gcommand\u001b[103G(`!`\u001b[108Gand\u001b[112Gshell\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mkeywords\u001b[13Gare\u001b[17Gplain\u001b[23Gwords\u001b[29Gafter\u001b[35Gan\u001b[38Gassignment),\u001b[51Gnot\u001b[55Gtwo\u001b[59Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts"]
