[226.982, "                       \r\u001b[1B\u001b[38;2;36;138;61m 130 +\u001b[38;2;51;51;51m        while j < n:                                                                                              \r\u001b[1B\u001b[38;2;36;138;61m 131 +\u001b[38;2;51;51;51m            var xv = x.unsafe_offset(j).unsafe_load[width=W]()                                                    \r\u001b[1B\u001b[38;2;36;138;61m 132 +\u001b[38;2;51;51;51m            comptime for r in range(R):                                                                           \r\u001b[1B\u001b[38;2;36;138;61m 133 +\u001b[38;2;51;51;51m                acc[r] = p.unsafe_offset(r * W).unsafe_load[width=W]().fma(xv, acc[r])                            \r\u001b[1B\u001b[38;2;36;138;61m 134 +\u001b[38;2;51;51;51m            p = p.unsafe_offset(R * W)                                                                            \r\u001b[1B\u001b[38;2;36;138;61m 135 +\u001b[38;2;51;51;51m            j += W                                                                                                \r\u001b[1B\u001b[38;2;36;138;61m 136 +\u001b[38;2;51;51;51m        c"]
[226.983, "omptime for r in range(R):                                                                               \r\u001b[1B\u001b[38;2;36;138;61m 137 +\u001b[38;2;51;51;51m            xout[unsafe_offset=i + r] = acc[r].reduce_add()                                                       \r\u001b[1B\u001b[38;2;36;138;61m 138 +\u001b[38;2;51;51;51m        i += R                                                                                                    \r\u001b[1B\u001b[38;2;36;138;61m 139 +\u001b[38;2;51;51;51m    # leftover rows (d % R) are row-major right after the packed blocks                                           \r\u001b[1B\u001b[38;2;36;138;61m 140 +\u001b[38;2;51;51;51m    while i < d:                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 141 +\u001b[38;2;51;51;51m        xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)                                                 \r\u001b[1B\u001b[38;2;36;138;61m 142 +\u001b[38;2;51;51;51m        i += 1                                                                       "]
[226.984, "                             \r\u001b[1B\u001b[38;2;36;138;61m 143 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 144 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 145 +\u001b[38;2;51;51;51mdef matmul_rows(xout: FPtr, x: FPtr, w: FPtr, n: Int, d: Int):                                                    \r\u001b[1B\u001b[38;2;36;138;61m 146 +\u001b[38;2;51;51;51m    # Row-major fallback for n not a multiple of PK_W; MM_ROWS rows share each x load.                            \r\u001b[1B\u001b[49m\u001b[2m 147 \u001b[22m     comptime R = MM_ROWS\r\u001b[1B\u001b[2m 148 \u001b[22m     comptime W = MM_W\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[39m\u001b[40;1H\u001b[36;2H"]
