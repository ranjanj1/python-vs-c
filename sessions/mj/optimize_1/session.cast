[226.966, "[20G45.3\u001b[25GGB/s\u001b[30Gagainst\u001b[38Groughly\u001b[46G56\u001b[49GGB/s\u001b[54Gfor\u001b[58Gthe\u001b[62Gother\u001b[68Gmatrices\u001b[77Gand\u001b[81Ga\u001b[83G~62\u001b[87GGB/s\u001b[92Gceiling,\u001b[101Gwhich\u001b[107GI\u001b[109Gsuspect\r\u001b[1B \u001b[3Gcomes from re\u001b[17Gding\u001b[22GR \u001b[25Geparate row streams. I'll test repacking\u001b[66Geach weight matrix into i\u001b[92Gterleaved\u001b[102GW-wide\u001b[109Gchunks\u001b[116Gin\u001b[119Ga\r\u001b[2C\u001b[1Bmicrobenchmark\u001b[18Gon\u001b[21Gthe\u001b[25Greal\u001b[30Gshapes\u001b[37Gfirst.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking confirmed the hypoth\u001b[32Gsis:\u001b[37Gpacked R=8\u00d7W=8 layouts reach\u001b[66Gabout 62.5\u201362.8 GB/s, near the streaming ceili\u001b[113Gg,\u001b[116G\u001b[K\r\u001b[2C\u001b[1Bversus about 59 GB/s now. I'm implemen\u001b[42Ging\u001b[46Gthat\u001b[51Gpacking\u001b[59Gin\u001b[62Gplace\u001b[68Gat\u001b[71Gload,\u001b[77Gwith\u001b[82Gthe\u001b[86Gembedding\u001b[96Glookup\u001b[103Greading\u001b[111Gthe\u001b[115Gpacked\r\u001b[2C\u001b[1Blayout\u001b[10Gsince\u001b[16Git\u001b[19Gdoubles\u001b[27Gas\u001b[30Gthe\u001b[34Gclassifier.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b["]
