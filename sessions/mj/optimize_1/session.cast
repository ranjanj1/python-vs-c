[459.527, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gblock\u001b[13Gshapes\u001b[20Gnow\u001b[24Gland\u001b[29Garound\u001b[36G134\u2013136\u001b[44Gtok/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gkernel\u001b[65Gis\u001b[68Gmemory-bound\u001b[81Gand\u001b[85GI'm\u001b[89Gkeeping\u001b[97G8\u00d78.\u001b[102GNext\u001b[107GI'll\u001b[112Grun\u001b[116Ga\r\u001b[2C\u001b[1Bquick read-bandwidth\u001b[24Gtest\u001b[29Gto\u001b[32Gsee\u001b[36Gwhether\u001b[44Gseveral\u001b[52Gdistant\u001b[60Gsequential\u001b[71Gstreams\u001b[79Gbeat\u001b[84Gone.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle\u001b[14Gsequential\u001b[25Gstream\u001b[32Greaches\u001b[40G62.5\u001b[45GGB/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gpacked\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[2C\u001b[1Bmatmul work is done.\u001b[24GNext\u001b[29GI'll\u001b[34Gmeasure\u001b[42Gstartup\u001b[50Gtime\u001b[55Gto\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m"]
[459.528, "\u23fa\u001b[3G\u001b[39mPacking\u001b[11Gcosts\u001b[17Gabout\u001b[23G55\u001b[26Gms\u001b[29Gat\u001b[32Gstartup\u001b[40Gbut\u001b[44Gstill\u001b[50Gpays\u001b[55Goff\u001b[59Gin\u001b[62Gtokens,\u001b[70Gso\u001b[73GI'm\u001b[77Gcutting\u001b[85Gthe\u001b[89Gextra\u001b[95Gfull\u001b[100Gcopy\u001b[105Gby\u001b[108Greading\u001b[116Geach\r\u001b[2C\u001b[1Bmatrix straight into its final slot.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing one offset bug\u001b[25Gbefore\u001b[32Gbuilding\u001b[41G(\u001b[38;2;87;105;247mrms_att_weight\u001b[57G\u001b[39mupper\u001b[63Gbound\u001b[69Gmust\u001b[74Gbe\u001b[77Grelative\u001b[86Gto\u001b[89G\u001b[38;2;87;105;247mdone\u001b[39m):\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gnow\u001b[15Gtakes\u001b[21G0.087\u001b[27Gs,\u001b[30Gup\u001b[33Gfrom\u001b[38G0.078\u001b[44Gs\u001b[46Gbefore\u001b[53Gpacking.\u001b[62GNext\u001b[67GI'll\u001b[72Gsilence\u001b[80Gthe\u001b[84Gunused-loop-variable\u001b[105Gwarnings\u001b[114Gand\r\u001b[1B \u001b[3Gt\u001b[7G the unshared-cla\u001b[25Gsifier path with a temporary checkpoint\u001b[65Gwhose\u001b[71Glogits\u001b[78Gshould\u001b[85Gmatch\u001b[91Gthe\u001b[95Gshared\u001b[102Gmodel.\r\u001b[1B\u001b["]
[459.528, "K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe unshared-classifier path matches bit-for-bit,\u001b[53Gand\u001b[57GI've\u001b[62Gdeleted\u001b[70Gthe\u001b[74G536\u001b[78GMB\u001b[81Gtemp\u001b[86Gcheckpoint\u001b[97Gsince\u001b[103Gthe\u001b[107Gdisk\u001b[112Gis\u001b[115G98%\r\u001b[2C\u001b[1Bfull. Next I'll build variants to exercise the row-major\u001b[60Gfallback\u001b[69G(PK_W=7)\u001b[78Gand\u001b[82Gthe\u001b[86Gtail-row\u001b[95Gand\u001b[99Gpacked-embedding\u001b[116Gpaths\r\u001b[2C\u001b[1B(PK_R=5).\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[29C\u001b[2B\u001b[38;2;102;102;102m8\u001b[39m\u001b[40;1H\u001b[38;3H"]
[459.544, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 4s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
