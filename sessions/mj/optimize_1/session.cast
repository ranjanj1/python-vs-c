[36.244, "\u001b[H\u001b[3G- \u001b[1mRoPE cos/s\u001b[16Gn:\u001b[22m computed once per token instead\u001b[51Gof\u001b[54Gonce\u001b[59Gper\u001b[63Glayer.\u001b[70GThe\u001b[74Gvalues\u001b[81Gare\u001b[85Gidentical.\r\u001b[4C\u001b[1B\u001b[1mV\u001b[7Gcab lookup:\u001b[22m a\u001b[21Ghash tab\u001b[30Ge replaces the sorted binary\u001b[59Gsearch. The vocab\u001b[77Ghas no duplicate strings, so it returns\u001b[117Gthe\r\u001b[4C\u001b[1Bsame ids.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mKV ca\u001b[11Ghe:\u001b[22m not\u001b[19Gwiped between\u001b[33Gcommands.\u001b[43GEvery command restarts at position 0 and only reads cache\u001b[101Grows\u001b[106Git\u001b[109Ghas\u001b[113Gjust\r\u001b[2C\u001b[1B \u001b[5Gwritten, so the\u001b[21Gre\u001b[24Gul\u001b[27Gs are the same.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mstdin:\u001b[22m read\u001b[17Gthrough\u001b[25Gmy\u001b[28Gown\u001b[32Gline\u001b[37Gbuffer.\u001b[45GMojo's\u001b[52G\u001b[38;2;87;105;247minput()\u001b[60G\u001b[39mopens\u001b[66Ga\u001b[68Gnew\u001b[72Gbuffered\u001b[81Greader\u001b[88Gon\u001b[91Geach\u001b[96Gcall\u001b[101Gand\u001b[105Gcould\u001b[111Glose\u001b[116Glines\r\u001b[2C\u001b[1B \u001b[5Gwhen comma\u001b[16Gds\u001b[19Garrive tog\u001b[30Gther.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247m\u001b[1mexp\u001b[39m:\u001b[22m come\u001b[15G from\u001b[21GMojo's standard\u001b[37Glibrary\u001b[45Gand\u001b[49Gcan\u001b[53Gdiffer\u001b[60Gfrom\u001b[65GC's\u001b[69G\u001b[38;2;87;105;247mexpf\u001b"]
[36.245, "[74G\u001b[39min\u001b[77Gthe\u001b[81Glast\u001b[86Gbit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BOnly\u001b[10Gthis model's shape h\u001b[31Gs \u001b[34Gctually been run; other shapes\u001b[65Grely on the\u001b[77Ggener\u001b[83Gl code paths.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mFIXED\u001b[39m/\u001b[38;2;87;105;247mLOGITS\u001b[18G\u001b[39mwith\u001b[23Gmore\u001b[28Gthan\u001b[33G1024\u001b[38Gids\u001b[42Gprocess\u001b[50Gonly\u001b[55Gthe\u001b[59Gfirst\u001b[65G1024\u001b[70Gand\u001b[74Greport\u001b[81Gthat\u001b[86Gcount.\r\u001b[2C\u001b[1B- The weights\u001b[17Gare\u001b[21Gloaded\u001b[28Ginto\u001b[33Gmemory\u001b[40G(about\u001b[47G0.4\u001b[51GGB)\u001b[55Grather\u001b[62Gthan\u001b[67Gmemory-mapped.\r\u001b[4C\u001b[1BPassing the public check doesn't guarantee passing the final gate, which us\u001b[81Gs other input\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNO\u001b[6GES.md also\u001b[17Grecords the build and test commands.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCooked for 14m 38s \u00b7 done 5:13 PM\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremainin"]
[36.247, "g budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'll start with what profiling tools exist here and what the development workloads are (the fixture prompts used by\u001b[K\r\u001b[1B  check.py).\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mApple\u001b[9GM1\u001b[12Gat\u001b[15G~60\u001b[19GGB/s\u001b[24Gmatches\u001b[32Gthe\u001b[36Gexpected\u001b[45Gsingle-core\u001b[57Gfigure,\u001b[65Gso\u001b[68GI'm\u001b[72Glooping\u001b[80Gthe\u001b[84Gfixture\u001b[92Gprompts\u001b[100Gand\u001b[104Gsampling\u001b[113Gthe\r\u001b[1B \u001b[3Gpro\u001b[7Gess with \u001b[38;2;87;105;247m/usr/bin/sample\u001b[39m.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2722\u001b[3GScampering\u2026 \u001b[38;2;102;102;102m(31s \u00b7 \u2193\u001b[24G3.0k tokens \u00b7 thought for 3s)\r\u001b[1B  \u23bf \u00a0Tip:"]
