[401.83, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m 147 \u001b[22m     comptime R = MM_ROWS\r\u001b[5C\u001b[1B\u001b[2m 148 \u001b[22m     comptime W = MM_W\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[39m\u001b[K\r\u001b[2C\u001b[2BNow the\u001b[13Gad-time packing and the\u001b[37Gembedding lookup:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking\u001b[11Glowered\u001b[19Gforward\u001b[27Gtime\u001b[32Gfrom\u001b[37G8.20\u001b[42Gto\u001b[45G7.49\u001b[50Gms/token,\u001b[60Gbut\u001b[64Gthe\u001b[68Gother\u001b[74Gmatrices\u001b[83Gstill\u001b[89Grun\u001b[93Gbelow\u001b[99Gthe\u001b[103Gmicrobenchmark's\r\u001b[1B \u001b[3G62.7 GB/s. Next I'll test wh\u001b[32Gth\u001b[35Gr the back-to-back layout in executi\u001b[73G ord\u001b[78Gr \u001b[81Gccounts for the gap.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix\u001b[10Gorder\u001b[16Gmakes\u001b[22Gno\u001b[25Gdifference\u001b[36G(62.5\u201363.1\u001b[47GGB/s\u001b[52Geither\u001b[59Gway),\u001b[65Gso\u001b[68GI\u001b[70Gwon't\u001b[76Gre-layout\u001b[86Gfurther.\u001b[95GNext\u001b[100GI'll\u001b[105Gsweep\u001b[111Gthe\u001b[115Gpacked\r\u001b[1B \u001b[3Gb\u001b["]
[401.831, "5Gock shape in the real program.\u001b[36G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gblock\u001b[13Gshapes\u001b[20Gnow\u001b[24Gland\u001b[29Garound\u001b[36G134\u2013136\u001b[44Gtok/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gkernel\u001b[65Gis\u001b[68Gmemory-bound\u001b[81Gand\u001b[85GI'm\u001b[89Gkeeping\u001b[97G8\u00d78.\u001b[102GNext\u001b[107GI'll\u001b[112Grun\u001b[116Ga\r\u001b[1B \u001b[3Gquick read-bandwidth test to\u001b[32Gs\u001b[34Ge whether several distant sequential stre\u001b[76Gms beat one.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The single sequential stream reaches 62.5\u001b[45GGB/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gpacked\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[2C\u001b[1Bmatmul work is done. Next I'll measure\u001b[42Gstartup\u001b[50Gtime\u001b[55Gto\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[9G\u001b[22mshell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa"]
