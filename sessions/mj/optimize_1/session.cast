[635.845, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m###\u001b[8GTests\u001b[14Gafter\u001b[20Gthe\u001b[24Gchange\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1B\u001b[22m \u001b[2m\u2502\u001b[22m - `python3\u001b[15Gcheck.py --\u001b[27G./mj`: PASS.\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m - `python3 check.py --tok\u001b[30Gns 64 --prompts 3 -- ./mj`: PASS, max logit error 1.2e-5 \u001b[88Go 2.9\u001b[94G-5.\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-\u001b[6GMy\u001b[9Gscripts\u001b[17G(`/tmp/mjtest`),\u001b[34Gall\u001b[38Gas\u001b[41Gbefore:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   - all fixture `PIECE`s\u001b[29Gmatch;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m-\u001b[8G`FIXED`\u001b[16Gargmaxes\u001b[25Greproduce\u001b[35Gthe\u001b[39Gfixture\u001b[47Gcontinuations;\r\u001b[1B \u001b[2m\u2502\u001b[22m   - pipelined input works;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   - `GENERATE 0`, `stop` \u001b[31Gd `c\u001b[36Gntext` (148 tokens \u001b[56Gfter \u001b[62Gn 877-token prompt)\u001b[82Gall\u001b[86Gend correctly;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   - long-run\u001b[17Goutputs\u001b[25Gare\u001b[29Gunchanged\u001b[39G(the\u001b[44G`GENERATE\u001b[54G2000`\u001b[60Grun\u001b[64Gstill\u001b[70Gstops\u001b[76Gat\u001b[79G238\u001b[83Gtokens;\u001b[91Gsame\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22m`FIXED\u001b[15G1024`\u001b[21Gargmaxes).\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m - **Unshared-classifier\u001b[28Gpath:**\u001b[36GI\u001b[38Gbuilt\u001b[44Ga\u001b"]
[635.847, "[46Gtemporary\u001b[56Gcheckpoint\u001b[67Gwith\u001b[72G`-vocab_size`\u001b[86Gand\u001b[90Gan\u001b[93Gappended\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m`wcls`\u001b[13Gequal\u001b[19Gto\u001b[22Gthe\u001b[26Gembedding\u001b[36Gtable.\u001b[43G`LOGITS`\u001b[52Gwere\u001b[57Gbit-identical\u001b[71Gto\u001b[74Gthe\u001b[78Gshared\u001b[85Gmodel's,\u001b[94Gand\r\u001b[1B \u001b[2m\u2502\u001b[22m   `GENERATE` output was identical. The file was\u001b[52Gdeleted afterwards bec\u001b[75Guse the d\u001b[85Gsk\u001b[88Gis 98% full.\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-\u001b[6G**Non-default\u001b[20Gcode\u001b[25Gpaths,\u001b[32Gchecked\u001b[40Gwith\u001b[45Gtemporary\u001b[55Gbuilds:**\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   - forcing the row-major\u001b[30Gfallback\u001b[39G(`is_packed`\u001b[52G\u2192\u001b[54GFalse):\u001b[62Gfull\u001b[67Gcheck\u001b[73GPASS;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m-\u001b[8G`PK_R=5`,\u001b[18Gwhich\u001b[24Gleaves\u001b[31G3\u001b[33Grow-major\u001b[43Gtail\u001b[48Grows\u001b[53Gper\u001b[57Gmatrix\u001b[64Gand\u001b[68Gputs\u001b[73Gembedding\u001b[83Grows\u001b[88Gin\u001b[91Gthe\u001b[95Gtail\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G \u001b[9Gnd in packed bl\u001b[25Gcks: full check PASS.\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m###\u001b[8GRemaining\u001b[18Glimitations\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-\u001b[6GThe\u001b[10Gfor"]
[635.848, "ward\u001b[18Gpass\u001b[23Gis\u001b[26Gat\u001b[29Gabout\u001b[35G95%\u001b[39Gof\u001b[42Gthe\u001b[46Gsingle-core\u001b[58Gmemory-bandwidth\u001b[75Gfloor.\u001b[82GFurther\u001b[90Gspeedup\r\u001b[1B \u001b[2m\u2502\u001b[22m   would need fewer \u001b[24Gytes per token,\u001b[40Gwhich means quantization (forbidden), or batching positions\u001b[100G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   (rejec\u001b[14Gd above).\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-\u001b[6GThe\u001b[10Gprofile\u001b[18Gcovers\u001b[25Gonly\u001b[30Gthe\u001b[34Gshort\u001b[40Gdevelopment\u001b[52Gcontexts\u001b[61G(at\u001b[65Gmost\u001b[70G82\u001b[73Gpositions).\u001b[85GLong\u001b[90Gcontexts\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   (FIXED 1024) were\u001b[24Gtimed\u001b[30Gbut\u001b[34Gnot\u001b[38Gprofiled\u001b[47Gphase\u001b[53Gby\u001b[56Gphase.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\"\"\r\u001b[1B \u001b[2m\u2502\u001b[22m open(p,'w').write(s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mecho\u001b[9Gok\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
