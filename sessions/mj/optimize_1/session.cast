[650.794, "\u001b[H\u001b[3G\u2502 GENERATE on the development workload \u2502 ~124 pos/s \u2502 ~133 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS on the development workload   \u2502 ~120 pos/s \u2502 ~131 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED, 1024 positions                \u2502 111 tok/s  \u2502 121 tok/s  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Time to \u001b[38;2;87;105;247mREADY\u001b[39m                        \u2502 0.069 s    \u2502 0.090 s    \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[650.795, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost\u001b[20Gwas\u001b[24G55\u001b[27Gms\u001b[30Gat\u001b[33Gfirst.\u001b[40GI\u001b[42Gcut it to\u001b[52Gabout 2\u001b[60G ms by\u001b[67Greading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary buffer and rearranging it from there.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mExtra tests\u001b[22m, beyond check.py:\u001b[33G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEarlier protocol tests:\u001b[22m PIECE,\u001b[36GFIXED, pip\u001b[47Glined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[4C\u001b[1Bare\u001b[9Gunchanged.\r\u001b[2C\u001b[1B- \u001b[1mUnshared classifier\u001b[22m (the supplied\u001b[39Gmodel\u001b[45Gdoesn't\u001b[53Guse\u001b[57Gone):\u001b[63Ga\u001b[65Gtemporary\u001b[75Gcheckpoint\u001b[86Gbuilt\u001b[92Gfor\u001b[96Gthis\u001b[101Ggave\u001b[106Gbit-identical\r\u001b[2C\u001b[1B \u001b[5Glogits and the same output. I deleted\u001b[43Git afterwards because the disk is 98% full.\u001b[K\r"]
[650.796, "\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther code paths, via temporary builds:\u001b[45G\u001b[22mforcing\u001b[53Gthe\u001b[57Gold\u001b[61Glayout\u001b[68Geverywhere,\u001b[80Gand\u001b[84Ga\u001b[86Gblock\u001b[92Gsize\u001b[97Gthat\u001b[102Gleaves\u001b[109Gleftover\r\u001b[2C\u001b[1B \u001b[5Grows, both pass the\u001b[25Gfull\u001b[30Gcheck.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWha\u001b[7G I didn't do:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI didn't run \u001b[19Geveral positions through\u001b[44Geach\u001b[49Gpass\u001b[54Gover\u001b[59Gthe\u001b[63Gweights.\u001b[72GThat\u001b[77Gwould\u001b[83Gbe\u001b[86Gmuch\u001b[91Gfaster\u001b[98Gfor\u001b[102Gprompts\u001b[110Gand\r\u001b[4C\u001b[1BFIXED/LOGITS,\u001b[19Gbut\u001b[23Gthe\u001b[27Grules\u001b[33Grequire\u001b[41Gbatch\u001b[47Gsize\u001b[52G1\u001b[54Gand\u001b[58Gthe\u001b[62Gsame\u001b[67Goperation\u001b[77Gshapes.\r\u001b[2C\u001b[1B- Software prefetch,\u001b[24Gusing\u001b[30Gseveral\u001b[38Gstreams\u001b[46Gat\u001b[49Gonce,\u001b[55Gand\u001b[59Gdifferent\u001b[69Gblock\u001b[75Gshapes\u001b[82Gmade\u001b[87Gno\u001b[90Gdifference\u001b[101Gor\u001b[104Gwere\u001b[109Gslower.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRemaining limitations:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BThe Mojo\u001b[14Gruntime starts 4 worker\u001b[38Gth\u001b[43Gd\u001b[46Gof\u001b[49Gits own when the process launches. They sat idl\u001b[97G for 100% of the\u001b[K\r\u001b[4C\u001b[1Bprofile;\u001b[14GI\u001b[16Gleft\u001b["]
[650.796, "21Gthem\u001b[26Galone\u001b[32Gbecause\u001b[40Gthe\u001b[44Grules\u001b[50Gforbid\u001b[57Gsetting\u001b[65Gthread\u001b[72Gcounts.\r\u001b[2C\u001b[1B- Loading now briefly needs\u001b[31Gan\u001b[34Gextra\u001b[40G98\u001b[43GMB\u001b[46Gbuffer,\u001b[54Gfreed\u001b[60Gbefore\u001b[67G\u001b[38;2;87;105;247mREADY\u001b[39m.\r\u001b[4C\u001b[1BI only profiled phase by phase at th\u001b[42G short\u001b[49Gdevelopment contexts (at\u001b[74Gmost 82 positions).\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md has the profiling evid\u001b[35Gnce,\u001b[40Gthe changes, the tests and\u001b[67Gthe limitations.\u001b[84GThe\u001b[88Gprofiling\u001b[98Gtools\u001b[104Gare\u001b[108Gin\u001b[111G\u001b[38;2;87;105;247mprof/\u001b[117G\u001b[39mso\r\u001b[2C\u001b[1Bthe\u001b[7Gmeasurements can b\u001b[27Grepeated; \u001b[38;2;87;105;247mmj.mojo\u001b[39m itself contai\u001b[59Gs\u001b[61Gn\u001b[63G profiling\u001b[74Gc\u001b[76Gde.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GWorked for 10m 31s \u00b7 done 5:24 PM\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[21C\u001b[2B\u001b[38;2;102;102;102m? for shortcuts\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
