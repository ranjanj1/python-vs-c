[646.369, "\u001b[H\u001b[3Gof\u001b[6G5e-4.\r\u001b[2B \u001b[3G\u001b[1mWhat the profiling showed\u001b[22m (fixture prompts \u001b[47Gun \u001b[51Ghe way ch\u001b[61Gck.py runs them):\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mmacOS \u001b[38;2;87;105;247msample\u001b[39m profiler:\u001b[22m m\u001b[30Gtmul is 98% of the main thread's time;\u001b[69Gattention, RoPE and no\u001b[92Gms\u001b[96Gre\u001b[99Gabout 1.5%.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mPer-matrix timers:\u001b[24G\u001b[22mevery\u001b[30Gweight\u001b[37Gmatrix\u001b[44Gwas\u001b[48Gread\u001b[53Gat\u001b[56Gonly\u001b[61G45\u201357\u001b[67GGB/s.\u001b[73GThe\u001b[77Gw2\u001b[80Gmatrix\u001b[87Gwas\u001b[91Gthe\u001b[95Gworst\u001b[101Gat\u001b[104G45\u001b[107GGB/s.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBandwidth ceiling:\u001b[24G\u001b[22mone\u001b[28Gsequential\u001b[39Gread\u001b[44Gstream\u001b[51Greaches\u001b[59G62.5\u001b[64GGB/s\u001b[69Gon\u001b[72Gthis\u001b[77GM1,\u001b[81Gwhich\u001b[87Gworks\u001b[93Gout\u001b[97Gto\u001b[100Gabout\u001b[106G7.0\u001b[110Gms\u001b[113Gper\r\u001b[2C\u001b[1B  token. Several streams\u001b[28Gat\u001b[31Gonce\u001b[36Gare\u001b[40Gslower.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCause:\u001b[12G\u001b[22mthe\u001b[16Gold\u001b[20Gkernel\u001b[27Gread\u001b[32Gseveral\u001b[40Grows\u001b[45Gat\u001b[48Gonce,\u001b[54Gwhich\u001b[60Gmeans\u001b[66Gseveral\u001b[74Gseparate\u001b[83Gmemory\u001b[90Gstreams.\u001b[99GLaying\u001b[106Gthe\u001b[110Gweights\u001b[118Gout\r\u001b[1B \u001b[3G  so\u001b[8Geach matrix\u001b"]
[646.371, "[20Gis\u001b[23Gread as one sequentia\u001b[46Gst\u001b[49Geam r\u001b[55Gaches 62\u201363 GB/s in a microbenchmark.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mThe change:\u001b[22m at load time\u001b[28Geach\u001b[33Gweight\u001b[40Gmatrix\u001b[47Gis\u001b[50Grearranged\u001b[61Ginto\u001b[66Gblocks\u001b[73Gof\u001b[76G8\u001b[78Grows,\u001b[84Gso\u001b[87Gthe\u001b[91Gmatrix-vector\u001b[105Gproduct\u001b[113Greads\r\u001b[2C\u001b[1Bone\u001b[7Gsequential\u001b[18Gstream.\r\u001b[1B \u001b[3G- The weights, float32 precision, the one-product-per-weig\u001b[62Gt-per-token shape and the amou\u001b[93Gt of work are\u001b[107Gall unchanged;\r\u001b[2C\u001b[1B  only\u001b[14Gord\u001b[18Gr in memory differs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWhen\u001b[10Gthe\u001b[14Gtoken\u001b[20Gembedding\u001b[30Gtable\u001b[36Gis\u001b[39Galso\u001b[44Gthe\u001b[48Gclassifier,\u001b[60Gembedding\u001b[70Glookups\u001b[78Gread\u001b[83Grows\u001b[88Gback\u001b[93Gout\u001b[97Gof\u001b[100Gthe\u001b[104Gnew\u001b[108Glayout.\r\u001b[2C\u001b[1B- Matrices with an input\u001b[28Glength\u001b[35Gthat\u001b[40Gisn't\u001b[46Ga\u001b[48Gmultiple\u001b[57Gof\u001b[60G8\u001b[62Gkeep\u001b[67Gthe\u001b[71Gold\u001b[75Glayout\u001b[82Gand\u001b[86Gkernel.\r\u001b[2B \u001b[3G\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[646.372, "\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502       \u001b[12G     \u001b[18G   \u001b[22G \u001b[24G     \u001b[30G     \u001b[36G      \u2502\u001b[44G  before   \u2502 \u001b[58G af\u001b[62Ger\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE on the development\u001b[33Gworkload\u001b[42G\u2502\u001b[44G~124\u001b[49Gpos/s\u001b[55G\u2502\u001b[57G~133\u001b[62Gpos/s\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B \u001b[3G\u2502 LOGITS on the development workload   \u2502 ~120\u001b[49Gpos/s \u2502 ~131\u001b[62Gpos/s \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502"]
[646.373, "\u001b[5GFIXED,\u001b[12G1024\u001b[17Gpositions\u001b[42G\u2502\u001b[44G111\u001b[48Gtok/s\u001b[55G\u2502\u001b[57G121\u001b[61Gtok/s\u001b[68G\u2502\r\u001b[1B \u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B  \u2502 Time to \u001b[38;2;87;105;247mREADY\u001b[39m          \u001b[42G\u2502\u001b[44G0.069\u001b[50Gs\u001b[55G\u2502\u001b[57G0.090\u001b[63Gs\u001b[68G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading each matrix from the file\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary buffer and rearranging it from there.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m,\u001b[16Gbeyond\u001b[23Gcheck.py:\r\u001b[1B\u001b[K\r\u001b[1B  -\u001b[K\u001b[40;1H\u001b[38;3H"]
[646.451, "\u001b]0;\u25d1 Claude Code\u0007"]
[646.772, "\u001b[H\u001b[3G\u001b[1mWhat the profiling showed\u001b[29G\u001b[22m(fixture\u001b[38Gprompts\u001b[46Grun\u001b[50Gthe\u001b[54Gway\u001b[58Gcheck.py\u001b[67Gruns\u001b[72Gthem):\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mmacOS \u001b[38;2;87;105;247msample\u001b[39m profiler:\u001b[28G\u001b[22mmatmul\u001b[35Gis\u001b[38G98%\u001b[42Gof\u001b[45Gthe\u001b[49Gmain\u001b[54Gthread's\u001b[63Gtime;\u001b[69Gattention,\u001b[80GRoPE\u001b[85Gand\u001b[89Gnorms\u001b[95Gare\u001b[99Gabout\u001b[105G1.5%.\r\u001b[2C\u001b[1B- \u001b[1mPer-matrix timers:\u001b[22m every weight matrix was read at only 45\u201357\u001b[67GGB/\u001b[71G. The w2\u001b[80Gmatrix\u001b[87Gwas\u001b[91Gthe\u001b[95Gworst\u001b[101Gat\u001b[104G45\u001b[107GGB/s.\r\u001b[4C\u001b[1B\u001b[1mB\u001b[7Gndwidth ceiling:\u001b[22m one\u001b[28Gsequent\u001b[36Gal read s\u001b[46Gr\u001b[48Ga\u001b[50G reac\u001b[56Ges 62.5 GB/s\u001b[69Gon this M1, which works out to about 7.0 ms\u001b[113Gper\r\u001b[2C\u001b[1B \u001b[5Gtoken. Several streams at once are slower.\u001b[48G\u001b[K\r\u001b[4C\u001b[1B\u001b[1mC\u001b[7Guse:\u001b[22m the old kernel read several rows at once, w\u001b[56Gich means several separate memory streams. L\u001b[101Gying\u001b[106Gthe\u001b[110Gweights\u001b[118Gout\r\u001b[4C\u001b[1Bs\u001b[7G \u001b[9Gach mat\u001b[17Gix\u001b[20Gis read\u001b[29Gs\u001b[33Ge sequential stream\u001b[53Greaches\u001b[61G62\u201363\u001b[67GGB/s\u001b[72Gin\u001b[75Ga\u001b[77Gmicro"]
[646.774, "benchmark.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe change:\u001b[22m at load\u001b[23Gtime\u001b[28Geach weight matrix is rea\u001b[54Gr\u001b[56Gng\u001b[59Gd\u001b[61Ginto blocks of 8 rows, so the matrix-vector\u001b[105Gproduct\u001b[113Greads\r\u001b[2C\u001b[1Bone\u001b[7Gsequential\u001b[18Gstream.\r\u001b[2C\u001b[1B- The weights,\u001b[18Gfloat32 pr\u001b[29Gcision, the one-product-per-w\u001b[59Gight-per-to\u001b[71Gen shape and\u001b[84Gthe amoun\u001b[94G of work are all unch\u001b[116Gnged;\r\u001b[2C\u001b[1B  only the order in \u001b[24Gemory\u001b[30Gdiffers.\r\u001b[4C\u001b[1BW\u001b[8Gn the \u001b[15Goken embedding table is also the classifier, embedding lookups re\u001b[81Gd rows\u001b[88Gback out of the n\u001b[106Gw \u001b[109Gayout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMatrices\u001b[14Gwith an input length that\u001b[40Gisn't\u001b[46Ga\u001b[48Gmultiple\u001b[57Gof\u001b[60G8\u001b[62Gkeep\u001b[67Gthe\u001b[71Gold\u001b[75Glayout\u001b[82Gand\u001b[86Gkernel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[42G\u2502\u001b[46Gbefore\u001b[55G\u2502\u001b[59Gafter\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b["]
[646.776, "42G\u253c\u001b[55G\u253c\u001b[68G\u2524\r\u001b[4C\u001b[1BGENERATE\u001b[14Gon\u001b[17Gthe\u001b[21Gdevelopment\u001b[33Gworkload\u001b[44G~124 pos/s\u001b[57G~133 pos/s\r\u001b[4C\u001b[2BLOGITS on the dev\u001b[23Glopment workload  \u001b[47G0\u001b[60G1\r\u001b[4C\u001b[2BFIXED,\u001b[12G1024 positions    \u001b[31G        \u001b[44G1\u001b[46G1 tok/s \u001b[57G121 tok/s \r\u001b[4C\u001b[2BTime to \u001b[38;2;87;105;247mREADY\u001b[39m        \u001b[44G0.069 s  \u001b[57G0.090 s  \r\u001b[2C\u001b[1B\u2514\u001b[42G\u2534\u001b[55G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary\u001b[13Gbuffer\u001b[20Gand\u001b[24Grearranging\u001b[36Git\u001b[39Gfrom\u001b[44Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m, b\u001b[18Gyond ch\u001b[26Gck.py:\u001b[K\r\u001b[2C\u001b[2B- \u001b[1mEarli\u001b[11Gr protocol tests:\u001b[22m PIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[4C\u001b[1Bare\u001b[9Gunchanged.\u001b[40;1H\u001b[38;3H"]
[646.841, "\u001b[H\r\u001b[102C\u001b[35B\u001b[K\u001b[40;1H\u001b[38;3H"]
[647.17, "\u001b[H\r\u001b[4C\u001b[34B\u001b[1mUnshared classifier\u001b[25G\u001b[22m(the\u001b[30Gsupplied\u001b[39Gmodel\u001b[45Gdoesn't\u001b[53Guse\u001b[57Gone):\u001b[63Ga\u001b[65Gtemporary\u001b[75Gcheckpoint\u001b[86Gbuilt\u001b[92Gfor\u001b[96Gthis\u001b[101Ggave\u001b[106Gbit-identical\u001b[40;1H\u001b[38;3H"]
