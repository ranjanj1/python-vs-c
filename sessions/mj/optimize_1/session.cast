[451.75, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gblock\u001b[13Gshapes\u001b[20Gnow\u001b[24Gland\u001b[29Garound\u001b[36G134\u2013136\u001b[44Gtok/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gkernel\u001b[65Gis\u001b[68Gmemory-bound\u001b[81Gand\u001b[85GI'm\u001b[89Gkeeping\u001b[97G8\u00d78.\u001b[102GNext\u001b[107GI'll\u001b[112Grun\u001b[116Ga\r\u001b[1B \u001b[3Gquick read-b\u001b[16Gndwidth\u001b[24Gtest\u001b[29Gto see\u001b[36Gwhether\u001b[44Gseveral distant sequential streams be\u001b[82Gt one.\u001b[89G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle\u001b[14Gsequential\u001b[25Gstream\u001b[32Greaches\u001b[40G62.5\u001b[45GGB/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gpacked\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[1B \u001b[3Gmatmul work is done. Next I'll measure startup time to\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsinc\u001b[70G the\u001b[75Gha\u001b[78Gness\u001b[83Gmay count it too.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking\u001b[11Gcosts\u001b[17Gabout\u001b[23G55\u001b[26Gms\u001b[29Gat\u001b[32Gstartup\u001b[40Gbut\u001b[44Gstill\u001b[50Gpays\u001b[55Goff"]
[451.751, "\u001b[59Gin\u001b[62Gtokens,\u001b[70Gso\u001b[73GI'm\u001b[77Gcutting\u001b[85Gthe\u001b[89Gextra\u001b[95Gfull\u001b[100Gcopy\u001b[105Gby\u001b[108Greading\u001b[116Geach\r\u001b[1B \u001b[3Gm\u001b[5Gtr\u001b[8Gx straight in\u001b[22Go its final slot.\u001b[40G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing\u001b[10Gone\u001b[14Goffset\u001b[21Gbug\u001b[25Gbefore\u001b[32Gbuilding\u001b[41G(\u001b[38;2;87;105;247mrms_att_weight\u001b[57G\u001b[39mupper\u001b[63Gbound\u001b[69Gmust\u001b[74Gbe\u001b[77Grelative\u001b[86Gto\u001b[89G\u001b[38;2;87;105;247mdone\u001b[39m):\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gnow\u001b[15Gtakes\u001b[21G0.087\u001b[27Gs,\u001b[30Gup\u001b[33Gfrom\u001b[38G0.078\u001b[44Gs\u001b[46Gbefore\u001b[53Gpacking.\u001b[62GNext\u001b[67GI'll\u001b[72Gsilence\u001b[80Gthe\u001b[84Gunused-loop-variable\u001b[105Gwarnings\u001b[114Gand\r\u001b[1B \u001b[3Gtest the unsh\u001b[17Gr\u001b[19Gd-classifier path with a\u001b[44Gtemporary checkpoint whose logits should match the sh\u001b[99Ged model.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mTesting\u001b[11Gunshared\u001b[20Gclass"]
[451.752, "ifier\u001b[31Gpath\u001b[36Gwith\u001b[41Ga\u001b[43Gsynthetic\u001b[53Gcheckpoint\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cd /Users/agentlab/pvc/mj; sed -i '' 's/^ for l in range(nl):\\n done = read_matrix/X/' mj.mojo; python3 -I - \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m<<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp=\u001b[9G/Users/agentlab/pvc/mj/mj.mojo'; s=open(p).read()\r\u001b[5C\u001b[1Bs\u001b[8Gs.replace(\"\"\" for l in range(nl):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mdone = read_matrix\"\"\",\"\"\" for _ in range(nl):\r\u001b[26C\u001b[1B)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mopen(p,'w').write(s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mE\u2026 (3s \u00b7 3 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
