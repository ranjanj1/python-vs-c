[600.287, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gnow\u001b[15Gtakes\u001b[21G0.087\u001b[27Gs,\u001b[30Gup\u001b[33Gfrom\u001b[38G0.078\u001b[44Gs\u001b[46Gbefore\u001b[53Gpacking.\u001b[62GNext\u001b[67GI'll\u001b[72Gsilence\u001b[80Gthe\u001b[84Gunused-loop-variable\u001b[105Gwarnings\u001b[114Gand\r\u001b[2C\u001b[1Btest\u001b[8Gthe\u001b[12Gunshared-classifier\u001b[32Gpath\u001b[37Gwith\u001b[42Ga\u001b[44Gtemporary\u001b[54Gcheckpoint\u001b[65Gwhose\u001b[71Glogits\u001b[78Gshould\u001b[85Gmatch\u001b[91Gthe\u001b[95Gshared\u001b[102Gmodel.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gunshared-classifier\u001b[27Gpath\u001b[32Gmatches\u001b[40Gbit-for-bit,\u001b[53Gand\u001b[57GI've\u001b[62Gdeleted\u001b[70Gthe\u001b[74G536\u001b[78GMB\u001b[81Gtemp\u001b[86Gcheckpoint\u001b[97Gsince\u001b[103Gthe\u001b[107Gdisk\u001b[112Gis\u001b[115G98%\r\u001b[1B \u001b[3Gfull. Next I'll build variants to exe\u001b[41Gcise the row-major fallback (PK_W=7)\u001b[78Gand the tail-row and packed-embedding paths\r\u001b[2C\u001b[1B(PK_R=5).\u001b[K\r\u001b[2C\u001b[4BSIMD widths must be p\u001b[25Gwers of tw\u001b[36G, \u001b[39Go I'll force the f\u001b[58Gllback another\u001b[73Gway, by making \u001b[38;2;87;105;247mis_packed\u001b[39m retu\u001b[103Gn False:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b["]
[600.288, "1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfallback\u001b[16Gpasses\u001b[23Gtoo;\u001b[28Gthe\u001b[32Gother\u001b[38Gthree\u001b[44G\u001b[38;2;87;105;247mreturn False\u001b[57G\u001b[39mmatches\u001b[65Gwere\u001b[70Galready\u001b[78Gthere.\u001b[85GI'm\u001b[89Grunning\u001b[97Gthe\u001b[101Gfinal\u001b[107Ginterleaved\r\u001b[1B \u001b[4G/B\u001b[7Gon \u001b[11Ghe development\u001b[26Gworkload, comparing the start-of-session build against th\u001b[84G new one.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The steady gain of about 8\u201310% holds across the benchmarks, at a cost of 21 ms more startup. I'm rerunning the\u001b[K\r\u001b[2C\u001b[1Bprotocol tests and a final phase profile for the notes next.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All tests pass\u001b[18Gand\u001b[22Gthe\u001b[26Goutputs\u001b[34G(the\u001b[39G238-token\u001b[49G\u001b[38;2;87;105;247mstop\u001b[54G\u001b[39mrun\u001b[58Gand\u001b[62Gthe\u001b[66GFIXED\u001b[72G1024\u001b[77Gargmaxes)\u001b[87Gare\u001b[91Gunchanged.\u001b[102GI'm\u001b[106Gcopying\u001b[1"]
