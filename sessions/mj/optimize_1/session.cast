[598.808, ";0m\u23fa\u001b[3G\u001b[39mSIMD widths must be powers\u001b[30Gof\u001b[33Gtwo,\u001b[38Gso\u001b[41GI'll\u001b[46Gforce\u001b[52Gthe\u001b[56Gfallback\u001b[65Ganother\u001b[73Gway,\u001b[78Gby\u001b[81Gmaking\u001b[88G\u001b[38;2;87;105;247mis_packed\u001b[98G\u001b[39mreturn\u001b[105GFalse:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe fallback passes too;\u001b[28Gthe\u001b[32Gother\u001b[38Gthree\u001b[44G\u001b[38;2;87;105;247mreturn False\u001b[57G\u001b[39mmatches\u001b[65Gwere\u001b[70Galready\u001b[78Gthere.\u001b[85GI'm\u001b[89Grunning\u001b[97Gthe\u001b[101Gfinal\u001b[107Ginterleaved\r\u001b[2C\u001b[1BA/B\u001b[7Gon\u001b[10Gthe\u001b[14Gdevelopment\u001b[26Gworkload,\u001b[36Gcomparing\u001b[46Gthe\u001b[50Gstart-of-session\u001b[67Gbuild\u001b[73Gagainst\u001b[81Gthe\u001b[85Gnew\u001b[89Gone.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe steady gain of about\u001b[28G8\u201310%\u001b[34Gholds\u001b[40Gacross\u001b[47Gthe\u001b[51Gbenchmarks,\u001b[63Gat\u001b[66Ga\u001b[68Gcost\u001b[73Gof\u001b[76G21\u001b[79Gms\u001b[82Gmore\u001b[87Gstartup.\u001b[96GI'm\u001b[100Grerunning\u001b[110Gthe\r\u001b[2C\u001b[1Bprotocol\u001b[12Gtests\u001b[18Gand\u001b[22Ga\u001b[24Gfinal\u001b[30Gphase\u001b[36Gprofile\u001b[44Gfor\u001b[48Gthe\u001b[52Gnotes\u001b[58Gne"]
