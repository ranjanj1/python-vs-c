[195.661, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat\u001b[8Gsampled\u001b[16Gthe\u001b[20GPython\u001b[27Gdriver\u001b[34Ginstead\u001b[42Gof\u001b[45Gthe\u001b[49Gprogram.\u001b[58GSampling\u001b[67Gthe\u001b[71Gchild\u001b[77GPID\u001b[81Gthat\u001b[86Gthe\u001b[90Gdriver\u001b[97Gprints:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul\u001b[10Gaccounts\u001b[19Gfor\u001b[23Gabout\u001b[29G98%\u001b[33Gof\u001b[36Gmain-thread\u001b[48Gsamples,\u001b[57Gwith\u001b[62Gforward\u001b[70Gand\u001b[74Gsoftmax\u001b[82Gminor;\u001b[89GI'm\u001b[93Gchecking\u001b[102Gwhat\u001b[107Gthe\r\u001b[1B \u001b[3Gsemaphore_wai\u001b[17G_trap\u001b[23Gsamples are next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFour\u001b[8Gextra\u001b[14Gthreads\u001b[22Gare\u001b[26Gthe\u001b[30GMojo\u001b[35Gruntime's\u001b[45Gown\u001b[49Gidle\u001b[54Gworker\u001b[61Gpool,\u001b[67Gso\u001b[70Gthey\u001b[75Gadd\u001b[79Gno\u001b[82Gcompute;\u001b[91Gmatmul\u001b[98Gis\u001b[101Gabout\u001b[107G98%\u001b[111Gof\r\u001b[1B \u001b[3Gruntime. I'm adding an\u001b[26Goptional\u001b[35GPROFILE build\u001b[49Gflag\u001b[54Gt\u001b[56G time matmul per matrix an"]
[195.662, "d report\u001b[91Geffective\u001b[101GGB/s.\u001b[107G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gdo\u001b[11Gthis\u001b[16Gas\u001b[19Gan\u001b[22Ginstrumented\u001b[35Gcopy\u001b[40Ggenerated\u001b[50Gby\u001b[53Ga\u001b[55Gscript,\u001b[63Gso\u001b[66G\u001b[38;2;87;105;247mmj.mojo\u001b[74G\u001b[39mitself\u001b[81Gstays\u001b[87Gclean.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mw2\u001b[6Greads\u001b[12Gat\u001b[15Gonly\u001b[20G45.3\u001b[25GGB/s\u001b[30Gagainst\u001b[38Groughly\u001b[46G56\u001b[49GGB/s\u001b[54Gfor\u001b[58Gthe\u001b[62Gother\u001b[68Gmatrices\u001b[77Gand\u001b[81Ga\u001b[83G~62\u001b[87GGB/s\u001b[92Gceiling,\u001b[101Gwhich\u001b[107GI\u001b[109Gsuspect\r\u001b[1B \u001b[3Gcomes from reading R separate row streams.\u001b[46GI'll test \u001b[57Gepacking each weight matrix into int\u001b[94Gr\u001b[96Geaved W-wide\u001b[109Gchunks in\u001b[119Ga\r\u001b[2C\u001b[1Bmicrobenchmark o\u001b[20G the re\u001b[28Gl shapes\u001b[37Gfi\u001b[40Gst.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mMicrobenchmark\u001b[18Gpacked\u001b[25Gvs\u001b[28Grow-major\u001b[38Gmatvec\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1C\u001b[1B \u23bf  $ cat > /tmp/mj"]
[195.663, "prof/mb.mojo <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m#\u001b[8GMicrobenchmark: matvec over the model's real weight shapes, row-major (R rows = R streams)\r\u001b[7C\u001b[1Bvs packed (R rows interleaved in W-wide\u001b[48Gchunks = one sequential stream).\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfrom\u001b[11Gstd.memory.alloc import alloc, Layout\u001b[39m\u001b[K\r\u001b[14C\u001b[1B\u001b[38;2;102;102;102mti\u001b[18Ge import perf_counter_ns\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mcomptime FPtr\u001b[20G=\u2026 (3s\u001b[27G\u00b7 8 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[195.741, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat\u001b[8Gsampled\u001b[16Gthe\u001b[20GPython\u001b[27Gdriver\u001b[34Ginstead\u001b[42Gof\u001b[45Gthe\u001b[49Gprogram.\u001b[58GSampling\u001b[67Gthe\u001b[71Gchild\u001b[77GPID\u001b[81Gthat\u001b[86Gthe\u001b[90Gdriver\u001b[97Gprints:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul accoun\u001b[17Gs for\u001b[23Gabout 98% of main-thread\u001b[48Gsamples,\u001b[57Gwith\u001b[62Gforward\u001b[70Gand\u001b[74Gsoftmax\u001b[82Gminor;\u001b[89GI'm\u001b[93Gchecking\u001b[102Gwhat\u001b[107Gthe\r\u001b[2C\u001b[1Bsemaphore_wait_trap\u001b[23Gsamples\u001b[31Gare\u001b[35Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFour extra threads are\u001b[26Gthe Mojo\u001b[35Gruntime's own\u001b[49Gidle\u001b[54Gw\u001b[56Grker pool, so they add no compute;\u001b[91Gmatmul is\u001b[101Gabout\u001b[107G98%\u001b[111Gof\r\u001b[2C\u001b[1Bruntime.\u001b[12GI'm\u001b[16Gadding\u001b[23Gan\u001b[26Goptional\u001b[35GPROFILE\u001b[43Gbuild\u001b[49Gflag\u001b[54Gto\u001b[57Gtime\u001b[62Gmatmu"]
