[29.221, "\u001b[H\u001b[3G- \u001b[1mMatrix multiply:\u001b[22G\u001b[22m2 rows a\u001b[31G a time with 32-wide SIMD\u001b[58Gnd explicit\u001b[70GFMA, chosen by be\u001b[88Gchmarking several sizes.\u001b[113GSof\u001b[117Gw\u001b[119Gre\r\u001b[2C\u001b[1B  prefetch didn't \u001b[23Glp.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mAt\u001b[8Gention:\u001b[22m reads\u001b[22Gthe KV\u001b[29Gcache \u001b[36Gn position or\u001b[51Gr, covering a\u001b[65Gl heads per row,\u001b[82Gwhich gave about 17% more speed at long\r\u001b[4C\u001b[1Bcont\u001b[10Gxt.\u001b[14GThe head size\u001b[28Gis\u001b[31Ga\u001b[33Gcompile-time\u001b[46Gparameter\u001b[56Gfor\u001b[60G16,\u001b[64G32,\u001b[68G64\u001b[71Gand\u001b[75G128,\u001b[80Gwith\u001b[85Ga\u001b[87Ggeneral\u001b[95Gpath\u001b[100Gfor\u001b[104Gother\u001b[110Gsizes.\u001b[117GI\r\u001b[2C\u001b[1B \u001b[5Gforced that general path on and it also passes the check.\u001b[63G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmall deviations from run.c, all in NOTES.md:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoPE constants:\u001b[21G\u001b[22mMojo's\u001b[28Gfloat32\u001b[36Gpower\u001b[42Gfunction\u001b[51Gis\u001b[54Gless\u001b[59Gaccurate\u001b[68Gthan\u001b[73GC's\u001b[77G\u001b[38;2;87;105;247mpowf\u001b[39m.\u001b[83GI\u001b[85Gcompute\u001b[93Gthose\u001b[99G32\u001b[102Gconstants\u001b[112Gin\r\u001b[2C\u001b[1B  float64 and round to float32 so they match.\u001b[49GThe\u001b[53Gmain\u001b[5"]
[29.222, "8Gcomputation\u001b[70Gstays\u001b[76Gfloat32.\r\u001b[11C\u001b[1B\u001b[1ms/si\u001b[17G:\u001b[22m computed\u001b[28Gonce per token i\u001b[45Gs\u001b[47Gead\u001b[51Gof\u001b[54Gonce\u001b[59Gper l\u001b[65Gy\u001b[67Gr. The values are\u001b[85Gidentical.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVocab lookup:\u001b[22m a hash\u001b[26Gtable replaces the sorted binary search. The vocab has no duplicate\u001b[94Gstrings,\u001b[103Gso\u001b[106Git\u001b[109Greturns\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gsame ids.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mKV cache:\u001b[22m not\u001b[19Gwiped betwe\u001b[31Gn commands. Every comma\u001b[55Gd re\u001b[60Gt\u001b[63Gts at position 0 a\u001b[82Gd\u001b[84Gonly reads cache rows\u001b[109Ghas ju\u001b[116Gt\u001b[K\r\u001b[4C\u001b[1Bwritten, so\u001b[17Gthe\u001b[21Gresults\u001b[29Gare\u001b[33Gthe\u001b[37Gsame.\r\u001b[4C\u001b[1B\u001b[1mstdin:\u001b[22m read \u001b[18Ghrough\u001b[25Gmy own line buffer. Mojo's \u001b[38;2;87;105;247minput()\u001b[39m open\u001b[67G new buffered reader on each call\u001b[101Gand could lose lines\r\u001b[5C\u001b[1Bhen commands ar\u001b[22Give \u001b[27Gogether.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;87;105;247m\u001b[1mexp\u001b[39m:\u001b[22m com\u001b[14Gs from Mojo's\u001b[28Gstandard\u001b[37Glibra\u001b[43Gy\u001b[45Gand can differ\u001b[60Gfrom C's \u001b[38;2;87;105;247mexpf\u001b[39m in the\u001b[81Glast bit.\u001b[91G\u001b[K\r\u001b[4C\u001b[1B\u001b[K"]
