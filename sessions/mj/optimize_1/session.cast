[31.548, "\u001b[H\u001b[3G\u001b[1mSmall deviations from run.c, all in NOTES.md:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mRoPE constants:\u001b[22m Moj\u001b[25G's\u001b[28Gfloat32 power\u001b[42Gfun\u001b[46Gtion is less\u001b[59Gaccurate th\u001b[72G C's \u001b[38;2;87;105;247mpowf\u001b[39m. I compu\u001b[91Ge\u001b[93Gthose\u001b[99G32\u001b[102Gconstants\u001b[112Gin\r\u001b[2C\u001b[1B \u001b[5Gfloat64 and\u001b[17Ground to floa\u001b[31G32 so they match. The main comput\u001b[65Gtion stays float32.\r\u001b[4C\u001b[1B\u001b[1mRoPE cos/sin:\u001b[22m computed once per token instead of once per layer. The value\u001b[80G are identical.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mVocab lookup:\u001b[19G\u001b[22ma\u001b[21Ghash\u001b[26Gtable\u001b[32Greplaces\u001b[41Gthe\u001b[45Gsorted\u001b[52Gbinary\u001b[59Gsearch.\u001b[67GThe\u001b[71Gvocab\u001b[77Ghas\u001b[81Gno\u001b[84Gduplicate\u001b[94Gstrings,\u001b[103Gso\u001b[106Git\u001b[109Greturns\u001b[117Gthe\r\u001b[2C\u001b[1B  same ids.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[15G\u001b[22mnot\u001b[19Gwiped\u001b[25Gbetween\u001b[33Gcommands.\u001b[43GEvery\u001b[49Gcommand\u001b[57Grestarts\u001b[66Gat\u001b[69Gposition\u001b[78G0\u001b[80Gand\u001b[84Gonly\u001b[89Greads\u001b[95Gcache\u001b[101Grows\u001b[106Git\u001b[109Ghas\u001b[113Gjust\r\u001b[1B \u001b[3G  written, so the results are the\u001b[37Gsame.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mstdin:\u001b[12G\u001b[22mread\u001b[17Gt"]
[31.549, "hrough\u001b[25Gmy\u001b[28Gown\u001b[32Gline\u001b[37Gbuffer.\u001b[45GMojo's\u001b[52G\u001b[38;2;87;105;247minput()\u001b[60G\u001b[39mopens\u001b[66Ga\u001b[68Gnew\u001b[72Gbuffered\u001b[81Greader\u001b[88Gon\u001b[91Geach\u001b[96Gcall\u001b[101Gand\u001b[105Gcould\u001b[111Glose\u001b[116Glines\r\u001b[1B    when commands arrive together.\u001b[K\r\u001b[1B  - \u001b[38;2;87;105;247m\u001b[1mexp\u001b[39m:\u001b[22m comes from Mojo's standard library and can differ from C's \u001b[38;2;87;105;247mexpf\u001b[39m in the last bit.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\r\u001b[1B\u001b[22m \u001b[3G- Only this model's shape has actually been run; other shap\u001b[63Gs rely on the gener\u001b[83Gl cod\u001b[90Gpaths.\u001b[K\r\u001b[2C\u001b[1B- \u001b[38;2;87;105;247mFIXED\u001b[39m/\u001b[38;2;87;105;247mLOGITS\u001b[18G\u001b[39mwith\u001b[23Gmore\u001b[28Gthan\u001b[33G1024\u001b[38Gids\u001b[42Gprocess\u001b[50Gonly\u001b[55Gthe\u001b[59Gfirst\u001b[65G1024\u001b[70Gand\u001b[74Greport\u001b[81Gthat\u001b[86Gcount.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gweights\u001b[17Gare\u001b[21Gloaded\u001b[28Ginto\u001b[33Gmemory\u001b[40G(about\u001b[47G0.4\u001b[51GGB)\u001b[55Grather\u001b[62Gthan\u001b[67Gmemory-mapped.\r\u001b[1B \u001b[3G- Passing the public check \u001b[31Goesn't guarantee\u001b[48Gpassing\u001b[56Gthe\u001b[60Gfinal\u001b[66Ggate,\u001b[72Gwhich\u001b[78Guses\u001b[83Gother\u001b[89Ginputs.\r"]
[31.55, "\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md also records the build and test commands.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCooked for 14m 38s \u00b7 done 5:13 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'll start with what profiling \u001b[35Gools\u001b[40Gexist here and what the development workloads are (\u001b[92Ghe fixture\u001b[103Gprompts\u001b[111Gused\u001b[116Gby\r\u001b[1C\u001b[1B che\u001b[7Gk.py).\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Checking profiling tools and hardware info\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ls /usr/bin/sample /usr/bin/xctrace /usr/sbin/sysctl /usr/bin/time "]
