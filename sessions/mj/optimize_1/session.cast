[453.83, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll block sh\u001b[16Gpes now\u001b[24Gland\u001b[29Garound\u001b[36G134\u2013136\u001b[44Gtok/s, so the kernel is memory-bound \u001b[82Gnd I'm\u001b[89Gkeeping\u001b[97G8\u00d78.\u001b[102GNext\u001b[107GI'll\u001b[112Grun\u001b[116Ga\r\u001b[2C\u001b[1Bquick\u001b[9Gread-bandwidth\u001b[24Gtest\u001b[29Gto\u001b[32Gsee\u001b[36Gwhether\u001b[44Gseveral\u001b[52Gdistant\u001b[60Gsequential\u001b[71Gstreams\u001b[79Gbeat\u001b[84Gone.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe single sequential stream reaches 62.5 GB/s, so the\u001b[58Gpacked\u001b[65Gkern\u001b[70Gl is\u001b[75Gal\u001b[78Geady\u001b[83Gnear the ~7.0 ms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[2C\u001b[1Bmatmul\u001b[10Gwork\u001b[15Gis\u001b[18Gdone.\u001b[24GNext\u001b[29GI'll\u001b[34Gmeasure\u001b[42Gstartup\u001b[50Gtime\u001b[55Gto\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mP\u001b[5Gck\u001b[8Gng costs abou\u001b[22G 55 ms at startup\u001b[40Gbut\u001b[44Gstill\u001b[50Gpays\u001b[55Goff\u001b[59Gin\u001b[62Gtokens,\u001b[70Gso\u001b[73GI'm"]
[453.831, "\u001b[77Gcutting\u001b[85Gthe\u001b[89Gextra\u001b[95Gfull\u001b[100Gcopy\u001b[105Gby\u001b[108Greading\u001b[116Geach\r\u001b[2C\u001b[1Bmatrix\u001b[10Gstraight\u001b[19Ginto\u001b[24Gits\u001b[28Gfinal\u001b[34Gslot.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing\u001b[10Gone\u001b[14Goffset\u001b[21Gbug\u001b[25Gbefore\u001b[32Gbuilding\u001b[41G(\u001b[38;2;87;105;247mrms_att_weight\u001b[57G\u001b[39mupper\u001b[63Gbound\u001b[69Gmust\u001b[74Gbe\u001b[77Grelative\u001b[86Gto\u001b[89G\u001b[38;2;87;105;247mdone\u001b[39m):\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup now t\u001b[17Gk\u001b[19Gs 0.087 s, up from 0.078\u001b[44Gs before packing. Next I'll silence the unused-loop-v\u001b[99Giable warnings\u001b[114Gand\r\u001b[2C\u001b[1Btest\u001b[8Gthe\u001b[12Gunshared-classifier\u001b[32Gpath\u001b[37Gwith\u001b[42Ga\u001b[44Gtemporary\u001b[54Gcheckpoint\u001b[65Gwhose\u001b[71Glogits\u001b[78Gshould\u001b[85Gmatch\u001b[91Gthe\u001b[95Gshared\u001b[102Gmodel.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Testing unshared classifier path with a synthetic checkpoint\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m"]
