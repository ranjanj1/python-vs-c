[385.951, "\u001b[H\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell\u001b[28Gcomm\u001b[33Gnds \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking lowered forward\u001b[27Gtime\u001b[32Gfrom\u001b[37G8.20\u001b[42Gto\u001b[45G7.49\u001b[50Gms/token,\u001b[60Gbut\u001b[64Gthe\u001b[68Gother\u001b[74Gmatrices\u001b[83Gstill\u001b[89Grun\u001b[93Gbelow\u001b[99Gthe\u001b[103Gmicrobenchmark's\r\u001b[2C\u001b[1B62.7 GB/s. Next I'll\u001b[24Gtest\u001b[29Gwhether\u001b[37Gthe\u001b[41Gback-to-back\u001b[54Glayout\u001b[61Gin\u001b[64Gexecution\u001b[74Gorder\u001b[80Gaccounts\u001b[89Gfor\u001b[93Gthe\u001b[97Ggap.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix\u001b[10Gorder\u001b[16Gmakes\u001b[22Gno\u001b[25Gdifference\u001b[36G(62.5\u201363.1\u001b[47GGB/s\u001b[52Geither\u001b[59Gway),\u001b[65Gso\u001b[68GI\u001b[70Gwon't\u001b[76Gre-layout\u001b[86Gfurther.\u001b[95GNext\u001b[100GI'll\u001b[105Gsweep\u001b[111Gthe\u001b[115Gpacked\r\u001b[1B  block shape in the real program.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All block shapes now land around 134\u2013136 tok/s, so the kerne"]
[385.952, "l is memory-bound and I'm keeping 8\u00d78. Next I'll run a\u001b[K\r\u001b[1C\u001b[1B quick read-bandwidth test to see whether\u001b[44Gseveral\u001b[52Gdistant\u001b[60Gsequential\u001b[71Gstreams\u001b[79Gbeat\u001b[84Gone.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The single sequential\u001b[25Gstream\u001b[32Greaches\u001b[40G62.5\u001b[45GGB/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gpacked\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[1C\u001b[1B matmul\u001b[10Gwork is done.\u001b[24GNext\u001b[29GI'll\u001b[34Gmeasure\u001b[42Gstartup\u001b[50Gtime\u001b[55Gto\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Measuring startup time before and after packing\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/mjprof/startup.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mimport subprocess, sys, time\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mexe, d = sys.argv[1], sys.argv[2]\u001b[40G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mts = []\r"]
