[487.89, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking\u001b[11Gcosts\u001b[17Gabout\u001b[23G55\u001b[26Gms\u001b[29Gat\u001b[32Gstartup\u001b[40Gbut\u001b[44Gstill\u001b[50Gpays\u001b[55Goff\u001b[59Gin\u001b[62Gtokens,\u001b[70Gso\u001b[73GI'm\u001b[77Gcutting\u001b[85Gthe\u001b[89Gextra\u001b[95Gfull\u001b[100Gcopy\u001b[105Gby\u001b[108Greading\u001b[116Geach\r\u001b[1B \u001b[3Gm\u001b[5Gtr\u001b[8Gx straight in\u001b[22Go its final slot.\u001b[40G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing\u001b[10Gone\u001b[14Goffset\u001b[21Gbug\u001b[25Gbefore\u001b[32Gbuilding\u001b[41G(\u001b[38;2;87;105;247mrms_att_weight\u001b[57G\u001b[39mupper\u001b[63Gbound\u001b[69Gmust\u001b[74Gbe\u001b[77Grelative\u001b[86Gto\u001b[89G\u001b[38;2;87;105;247mdone\u001b[39m):\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gnow\u001b[15Gtakes\u001b[21G0.087\u001b[27Gs,\u001b[30Gup\u001b[33Gfrom\u001b[38G0.078\u001b[44Gs\u001b[46Gbefore\u001b[53Gpacking.\u001b[62GNext\u001b[67GI'll\u001b[72Gsilence\u001b[80Gthe\u001b[84Gunused-loop-variable\u001b[105Gwarnings\u001b[114Gand\r\u001b[1B \u001b[3Gtest the unsh\u001b[17Gr\u001b[19Gd-classifier path with a\u001b[44Gtemporary checkpoint whos"]
[487.891, "e logits should match the sh\u001b[99Ged model.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gunshared-classifier\u001b[27Gpath\u001b[32Gmatches\u001b[40Gbit-for-bit,\u001b[53Gand\u001b[57GI've\u001b[62Gdeleted\u001b[70Gthe\u001b[74G536\u001b[78GMB\u001b[81Gtemp\u001b[86Gcheckpoint\u001b[97Gsince\u001b[103Gthe\u001b[107Gdisk\u001b[112Gis\u001b[115G98%\r\u001b[1B \u001b[3Gfull. Next I'l\u001b[18G bu\u001b[22Gld variants \u001b[35Go \u001b[38Gxercise the row-major fallback (PK_W=7)\u001b[78Gand the\u001b[86Gtail-r\u001b[93Gw and packed-embedd\u001b[113Gng paths\r\u001b[2C\u001b[1B(PK_R=5).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSIMD\u001b[8Gwidths\u001b[15Gmust\u001b[20Gbe\u001b[23Gpowers\u001b[30Gof\u001b[33Gtwo,\u001b[38Gso\u001b[41GI'll\u001b[46Gforce\u001b[52Gthe\u001b[56Gfallback\u001b[65Ganother\u001b[73Gway,\u001b[78Gby\u001b[81Gmaking\u001b[88G\u001b[38;2;87;105;247mis_packed\u001b[98G\u001b[39mreturn\u001b[105GFalse:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfallback\u001b[16Gpasses\u001b[23Gtoo;\u001b[28Gthe\u001b[32Gother\u001b[38Gthree\u001b"]
