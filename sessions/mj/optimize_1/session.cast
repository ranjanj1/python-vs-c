[156.286, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gstart\u001b[14Gwith\u001b[19Gwhat\u001b[24Gprofiling\u001b[34Gtools\u001b[40Gexist\u001b[46Ghere\u001b[51Gand\u001b[55Gwhat\u001b[60Gthe\u001b[64Gdevelopment\u001b[76Gworkloads\u001b[86Gare\u001b[90G(the\u001b[95Gfixture\u001b[103Gprompts\u001b[111Gused\u001b[116Gby\r\u001b[1B \u001b[3Gcheck.py).\u001b[14G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mApple\u001b[9GM1\u001b[12Gat\u001b[15G~60\u001b[19GGB/s\u001b[24Gmatches\u001b[32Gthe\u001b[36Gexpected\u001b[45Gsingle-core\u001b[57Gfigure,\u001b[65Gso\u001b[68GI'm\u001b[72Glooping\u001b[80Gthe\u001b[84Gfixture\u001b[92Gprompts\u001b[100Gand\u001b[104Gsampling\u001b[113Gthe\r\u001b[1B \u001b[3Gproc\u001b[8Gss wi\u001b[14Gh \u001b[38;2;87;105;247m/usr/bin/sample\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat\u001b[8Gsampled\u001b[16Gthe\u001b[20GPython\u001b[27Gdriver\u001b[34Ginstead\u001b[42Gof\u001b[45Gthe\u001b[49Gprogram.\u001b[58GSampling\u001b[67Gthe\u001b[71Gchild\u001b[77GPID\u001b[81Gthat\u001b[86Gthe\u001b[90Gdriver\u001b[97Gprints:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul"]
[156.286, "\u001b[10Gaccounts\u001b[19Gfor\u001b[23Gabout\u001b[29G98%\u001b[33Gof\u001b[36Gmain-thread\u001b[48Gsamples,\u001b[57Gwith\u001b[62Gforward\u001b[70Gand\u001b[74Gsoftmax\u001b[82Gminor;\u001b[89GI'm\u001b[93Gchecking\u001b[102Gwhat\u001b[107Gthe\r\u001b[1B \u001b[3Gsemaphore_wai\u001b[17G_trap\u001b[23Gsamples are next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFour\u001b[8Gextra\u001b[14Gthreads\u001b[22Gare\u001b[26Gthe\u001b[30GMojo\u001b[35Gruntime's\u001b[45Gown\u001b[49Gidle\u001b[54Gworker\u001b[61Gpool,\u001b[67Gso\u001b[70Gthey\u001b[75Gadd\u001b[79Gno\u001b[82Gcompute;\u001b[91Gmatmul\u001b[98Gis\u001b[101Gabout\u001b[107G98%\u001b[111Gof\r\u001b[1B \u001b[3Gruntime. I'm adding an\u001b[26Goptional\u001b[35GPROFILE build\u001b[49Gflag\u001b[54Gt\u001b[56G time matmul per matrix and report\u001b[91Geffective\u001b[101GGB/s.\u001b[107G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gdo\u001b[11Gthis\u001b[16Gas\u001b[19Gan\u001b[22Ginstrumented\u001b[35Gcopy\u001b[40Ggenerated\u001b[50Gby\u001b[53Ga\u001b[55Gscript,\u001b[63Gso\u001b[66G\u001b[38;2;87;105;247mmj.mojo\u001b[74G\u001b[39mitself\u001b[81Gstays\u001b[87G"]
