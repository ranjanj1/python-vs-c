[385.361, "22mstdout=subprocess.PIPE,\u001b[28Gtext=True,\u001b[39Gbufsize=1)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G assert p.stdout.rea\u001b[28Gline().strip() == 'READY'; ts.append(time.time() - t)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     p.st\u001b[13Gin.write('QUIT\\n'); p.stdin.flu\u001b[45Gh(); p.wai\u001b[56G()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(exe,\u001b[15G'time\u001b[21Gto\u001b[24GREADY:\u001b[31Gmin\u001b[35G%.3f\u001b[40Gmedian\u001b[47G%.3f\u001b[52Gs'\u001b[55G%\u001b[57G(min(ts),\u001b[67Gsorted(ts)[2]))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/agentlab/pvc/mj;\u001b[31Gpython3\u001b[39G-I\u001b[42G/tmp/mjprof/startup.py\u001b[65G/tmp/mjtest/v_2_32\u001b[84G.;\u001b[87Gpython3\u001b[95G-I\u001b[98G/tmp/mjprof/startup.py\r\u001b[1B \u001b[2m\u2502\u001b[22m ./mj .\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1"]
