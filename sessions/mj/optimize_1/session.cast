[247.66, "])\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m34\u001b[16G\u001b[38;2;51;51;51m \u001b[18G      p =\u001b[28Gp.uns\u001b[34Gfe_offset(R * W)       \u001b[58G  \u001b[61G     \u001b[67G       \u001b[75G    \u001b[80G     \u001b[86G    \u001b[91G \u001b[93G     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 135 +\u001b[38;2;51;51;51m            j += W                                                                                    \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 136 +\u001b[38;2;51;51;51m        comptime for r in range(R):                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 137 +\u001b[38;2;51;51;51m            xout[unsafe_offset=i + r] = acc[r].reduce_add()                                           \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 138 +\u001b[38;2;51;51;51m        i += R                                                                                        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 139 +\u001b[38;2;51;51;51m    # leftover rows (d % R) are row-major right after the packed blocks                               \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 140 +\u001b[38;2;51;51;51m    while i < d:"]
[247.661, "                                                                                      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 141 +\u001b[38;2;51;51;51m        xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)                                     \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 142 +\u001b[38;2;51;51;51m        i += 1                                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 143 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 144 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 145 +\u001b[38;2;51;51;51mdef matmul_rows(xout: FPtr, x: FPtr, w: FPtr, n: Int, d: Int):                                        \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 146 +\u001b[38;2;51;51;51m    # Row-major fallback for n not a multiple o"]
[247.662, "f PK_W; MM_ROWS rows share each x load.                \u001b[49m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 147 \u001b[22m     comptime R = MM_ROWS\r\u001b[1C\u001b[1B\u001b[39m    \u001b[38;2;51;51;51m\u001b[2m 148 \u001b[22m     comptime W = MM_W\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Now\u001b[7Gthe load-time packing and the embedding l\u001b[49Gokup:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Adding loa\u001b[14G-ti\u001b[18Ge packing and packed embedding lookup\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; mojo build mj.mojo -o mj 2>&1 | grep -iA8 \"error\\|warning\" | head -20; python3 \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mcheck.py --tokens 64 --prompts 3 -- ./mj | tail -4; python3 -I /tmp/mjprof/instrument.py mj.mojo \u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102m/tmp/mjprof/mj_prof.mojo && mojo build /tmp/mjprof/mj_prof.mojo -o /tmp/mjprof/mj_prof 2>&1 | \u2026\r\u001b[2B\u001b[38;2;215;119;87m\u273d\u001b[39m \u001b[38;2;223;127;95mScampering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(3m 57s \u00b7 \u2193\u001b[27G17.5k tokens)\r\u001b["]
