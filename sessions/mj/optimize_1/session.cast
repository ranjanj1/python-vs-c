[288.701, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22ms=s.replace('''def main():''','''def run_scat[R: Int, W: Int](w: FPtr, x: FPtr, y: FPtr, name: StaticString):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var best = Float64(1e18)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var dd = 768 * 768\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var hh = 768 * 2048\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for rep in range(6):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      var t0 = perf_counter_ns()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      for l in range(12):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsafe_offset(l * dd), 768, 768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsafe_offset(12 * dd + l * dd), 768, 768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsafe_offset(24 * dd + l * dd), 768, 768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsafe_offset(36 * dd + l * dd), 768, 768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsafe_offset(48 * dd + l * hh), 768, 2048)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsaf"]
[288.702, "e_offset(48 * dd + 24 * hh + l * hh), 768, 2048)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          mm_packed[R, W](y, x, w.unsafe_offset(48 * dd + 12 * hh + l * hh), 2048, 768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      mm_packed[R, W](y, x, w.unsafe_offset(48 * dd + 36 * hh), 768, 32000)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      var dt = Float64(perf_counter_ns() - t0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      if dt < best: best = dt\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  var bytes = Float64(12 * (4 * 768 * 768 + 3 * 768 * 2048) + 768 * 32000) * 4\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  print(name, \"ms\", best / 1e6, \"GB/s\", bytes / best)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef main():''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms=s[:s.index('    run[False, 2,\u001b[36G32](w,\u001b[43Gx,\u001b[46Gy,\u001b[49G\"rows\u001b[57GR=2\u001b[61GW=32\")')]+'''\u001b[78Grun[True,\u001b[88G8,\u001b[91G8](w,\u001b[97Gx,\u001b[100Gy,\u001b[103G\"packed\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcontiguous R=8 W=8\")\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrun_scat[8,\u001b[20G8](w,\u001b[26Gx,\u001b[29Gy,\u001b[32G\"packed\u001b[40Gscattered\u001b[51GR=8\u001b[55GW=8\")\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G run[True, 8,"]
[288.703, "\u001b[21G8](w, x, y,\u001b[33G\"packed contigu\u001b[49Gus R=8\u001b[56GW=8\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrun_scat[8,\u001b[20G8](w,\u001b[26Gx,\u001b[29Gy,\u001b[32G\"packed\u001b[40Gscattered\u001b[51GR=8\u001b[55GW=8\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m '''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('mb2.mojo','w').write(s)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m mojo build mb2.mojo\u001b[24G-o mb2 2>&1 | grep -iA5 error\u001b[54G| head; ./mb2\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gallow\u001b[22G\u001b[1m/private/tmp/mjprof\u001b[42G\u001b[22maccess\u001b[49Gand\u001b[53G\u001b[1m"]
[288.703, "python3 -I -, mojo build, grep -iA5 error\u001b[22m,\u001b[96Gand\u001b[100G\u001b[1m./mb2\u001b[106G\u001b[22mcommands\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
