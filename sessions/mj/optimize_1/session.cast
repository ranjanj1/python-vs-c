[647.924, "\u001b[H\u001b[3G \u001b[5Gso each matrix is read\u001b[28Gas one sequential stream reaches 62\u201363 GB/s\u001b[72Gin a\u001b[77Gmicrobenchma\u001b[91G.\u001b[93G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mThe change:\u001b[22m at load time \u001b[30Gch weight\u001b[40Gmatrix is r\u001b[52Garranged into\u001b[66Gblocks of 8 \u001b[79Gows, so the matrix-vector product reads\u001b[K\r\u001b[2C\u001b[1Bone s\u001b[9Gquential stream.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gweights,\u001b[18Gfloat32\u001b[26Gprecision,\u001b[37Gthe\u001b[41Gone-product-per-weight-per-token\u001b[74Gshape\u001b[80Gand\u001b[84Gthe\u001b[88Gamount\u001b[95Gof\u001b[98Gwork\u001b[103Gare\u001b[107Gall\u001b[111Gunchanged;\r\u001b[2C\u001b[1B  only the order in\u001b[23Gme\u001b[26Gory diff\u001b[35Grs.\u001b[K\r\u001b[2C\u001b[1B- When the token embedding\u001b[30Gtable\u001b[36Gis\u001b[39Galso\u001b[44Gthe\u001b[48Gclassifier,\u001b[60Gembedding\u001b[70Glookups\u001b[78Gread\u001b[83Grows\u001b[88Gback\u001b[93Gout\u001b[97Gof\u001b[100Gthe\u001b[104Gnew\u001b[108Glayout.\r\u001b[4C\u001b[1BMatrices with an input length that is\u001b[43G't a m\u001b[50Gl\u001b[52Gi\u001b[54Gle of 8 keep the old l\u001b[77Gyout and kernel.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500"]
[647.926, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[70G\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5G        \u001b[14G    \u001b[19G  \u001b[22G     \u001b[28G      \u001b[35G    \u001b[40G  \u2502  \u001b[46Gbefore   \u2502\u001b[57G  after  \u001b[67G \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE on the development workload \u2502 ~124 pos/s \u2502 ~133 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS on the development workload   \u2502 ~120 pos/s \u2502 ~131 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED, 1024 posit"]
[647.927, "ions                \u2502 111 tok/s  \u2502 121 tok/s  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Time to \u001b[38;2;87;105;247mREADY\u001b[39m                        \u2502 0.069 s    \u2502 0.090 s    \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost\u001b[20Gwas\u001b[24G55\u001b[27Gms\u001b[30Gat\u001b[33Gfirst.\u001b[40GI\u001b[42Gcut it to\u001b[52Gabout 2\u001b[60G ms by\u001b[67Greading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary buffer and rearranging it from there.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mExtra tests\u001b[22m, beyond check.py:\u001b[33G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEarlier protocol tests:\u001b[22m PIECE,\u001b[36GFIXED, pip\u001b[47Glined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop"]
[647.928, "\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[4C\u001b[1Bare\u001b[9Gunchanged.\r\u001b[2C\u001b[1B- \u001b[1mUnshared classifier\u001b[22m (the supplied\u001b[39Gmodel\u001b[45Gdoesn't\u001b[53Guse\u001b[57Gone):\u001b[63Ga\u001b[65Gtemporary\u001b[75Gcheckpoint\u001b[86Gbuilt\u001b[92Gfor\u001b[96Gthis\u001b[101Ggave\u001b[106Gbit-identical\r\u001b[2C\u001b[1B \u001b[5Glogits and the same output. I deleted\u001b[43Git afterwards because the disk is 98% full.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther code paths, via temporary builds:\u001b[45G\u001b[22mforcing\u001b[53Gthe\u001b[57Gold\u001b[61Glayout\u001b[68Geverywhere,\u001b[80Gand\u001b[84Ga\u001b[86Gblock\u001b[92Gsize\u001b[97Gthat\u001b[102Gleaves\u001b[109Gleftover\r\u001b[2C\u001b[1B \u001b[5Grows, both pass the\u001b[25Gfull\u001b[30Gcheck.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWha\u001b[7G I didn't do:\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[40;1H\u001b[38;3H"]
[648.373, "\u001b]0;\u25d1 Claude Code\u0007"]
[648.426, "\u001b[H\r\u001b[4C\u001b[34BI\u001b[7Gdidn't\u001b[14Grun\u001b[18Gseveral\u001b[26Gpositions\u001b[36Gthrough\u001b[44Geach\u001b[49Gpass\u001b[54Gover\u001b[59Gthe\u001b[63Gweights.\u001b[72GThat\u001b[77Gwould\u001b[83Gbe\u001b[86Gmuch\u001b[91Gfaster\u001b[98Gfor\u001b[102Gprompts\u001b[110Gand\u001b[40;1H\u001b[38;3H"]
[648.577, "\u001b[H\u001b[3G\u001b[1mThe change:\u001b[22m at load\u001b[23Gtime\u001b[28Geach weight matrix is rea\u001b[54Gr\u001b[56Gng\u001b[59Gd\u001b[61Ginto blocks of 8 rows, so the matrix-vector\u001b[105Gproduct\u001b[113Greads\r\u001b[2C\u001b[1Bone\u001b[7Gsequential\u001b[18Gstream.\r\u001b[2C\u001b[1B- The weights,\u001b[18Gfloat32 pr\u001b[29Gcision, the one-product-per-w\u001b[59Gight-per-to\u001b[71Gen shape and\u001b[84Gthe amoun\u001b[94G of work are all unch\u001b[116Gnged;\r\u001b[2C\u001b[1B  only the order in \u001b[24Gemory\u001b[30Gdiffers.\r\u001b[4C\u001b[1BW\u001b[8Gn the \u001b[15Goken embedding table is also the classifier, embedding lookups re\u001b[81Gd rows\u001b[88Gback out of the n\u001b[106Gw \u001b[109Gayout.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GMatrices\u001b[14Gwith an input length that\u001b[40Gisn't\u001b[46Ga\u001b[48Gmultiple\u001b[57Gof\u001b[60G8\u001b[62Gkeep\u001b[67Gthe\u001b[71Gold\u001b[75Glayout\u001b[82Gand\u001b[86Gkernel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[42G\u2502\u001b[46Gbefore\u001b[55G\u2502\u001b[59Gafter\u001b[68G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[42G\u253c\u001b[55G\u253c\u001b[68G\u2524\r\u001b"]
[648.578, "[4C\u001b[1BGENERATE\u001b[14Gon\u001b[17Gthe\u001b[21Gdevelopment\u001b[33Gworkload\u001b[44G~124 pos/s\u001b[57G~133 pos/s\r\u001b[4C\u001b[2BLOGITS on the dev\u001b[23Glopment workload  \u001b[47G0\u001b[60G1\r\u001b[4C\u001b[2BFIXED,\u001b[12G1024 positions    \u001b[31G        \u001b[44G1\u001b[46G1 tok/s \u001b[57G121 tok/s \r\u001b[4C\u001b[2BTime to \u001b[38;2;87;105;247mREADY\u001b[39m        \u001b[44G0.069 s  \u001b[57G0.090 s  \r\u001b[2C\u001b[1B\u2514\u001b[42G\u2534\u001b[55G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary\u001b[13Gbuffer\u001b[20Gand\u001b[24Grearranging\u001b[36Git\u001b[39Gfrom\u001b[44Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m, b\u001b[18Gyond ch\u001b[26Gck.py:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEarlier protocol tests:\u001b[29G\u001b[22mPIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[2C\u001b[1B  are unchanged.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mUnshared classifier\u001b[22m (the supplied model does\u001b[50G't\u001b[53Guse one):\u001b[63"]
[648.58, "Ga temporary checkpoint bui\u001b[90Gt\u001b[92Gfor this gave bit-identical\u001b[K\r\u001b[4C\u001b[1Blogits and the\u001b[20Gsame\u001b[25Goutput.\u001b[33GI\u001b[35Gdeleted\u001b[43Git\u001b[46Gafterwards\u001b[57Gbecause\u001b[65Gthe\u001b[69Gdisk\u001b[74Gis\u001b[77G98%\u001b[81Gfull.\r\u001b[4C\u001b[1B\u001b[1mOther code paths, via temporary builds:\u001b[45G\u001b[22mf\u001b[47Grcing\u001b[53Gth\u001b[58Gld layout everywher\u001b[78G, and a\u001b[87Glock\u001b[92Gsize that leaves leftover\u001b[K\r\u001b[4C\u001b[1Br\u001b[7Gws, both\u001b[16Gpass th\u001b[25Gf\u001b[27Gll check.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat I didn't do:\u001b[21G\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- I didn't run several\u001b[26Gpositions\u001b[36Gthrough\u001b[44Geach\u001b[49Gpass\u001b[54Gover\u001b[59Gthe\u001b[63Gweights.\u001b[72GThat\u001b[77Gwould\u001b[83Gbe\u001b[86Gmuch\u001b[91Gfaster\u001b[98Gfor\u001b[102Gprompts\u001b[110Gand\r\u001b[4C\u001b[1BFIXED/LOGITS,\u001b[19Gbut\u001b[23Gthe\u001b[27Grules\u001b[33Grequire\u001b[41Gbatch\u001b[47Gsize\u001b[52G1\u001b[54Gand\u001b[58Gthe\u001b[62Gsame\u001b[67Goperation\u001b[77Gshapes.\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
[648.876, "\u001b[H\u001b[3G  only the order in\u001b[23Gme\u001b[26Gory diff\u001b[35Grs.\u001b[K\r\u001b[2C\u001b[1B- When the token embedding\u001b[30Gtable\u001b[36Gis\u001b[39Galso\u001b[44Gthe\u001b[48Gclassifier,\u001b[60Gembedding\u001b[70Glookups\u001b[78Gread\u001b[83Grows\u001b[88Gback\u001b[93Gout\u001b[97Gof\u001b[100Gthe\u001b[104Gnew\u001b[108Glayout.\r\u001b[4C\u001b[1BMatrices with an input length that is\u001b[43G't a m\u001b[50Gl\u001b[52Gi\u001b[54Gle of 8 keep the old l\u001b[77Gyout and kernel.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[70G\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5G        \u001b[14G    \u001b[19G  \u001b[22G     \u001b[28G      \u001b[35G    \u001b[40G  \u2502  \u001b[46Gbefore   \u2502\u001b[57G  after  \u001b[67G \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE on the development workload \u2502 ~124 pos/s \u2502 ~133 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500"]
[648.877, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 LOGITS on the development workload   \u2502 ~120 pos/s \u2502 ~131 pos/s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED, 1024 positions                \u2502 111 tok/s  \u2502 121 tok/s  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Time to \u001b[38;2;87;105;247mREADY\u001b[39m                        \u2502 0.069 s    \u2502 0.090 s    \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[648.879, "\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost\u001b[20Gwas\u001b[24G55\u001b[27Gms\u001b[30Gat\u001b[33Gfirst.\u001b[40GI\u001b[42Gcut it to\u001b[52Gabout 2\u001b[60G ms by\u001b[67Greading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary buffer and rearranging it from there.\u001b[K\r\u001b[2C\u001b[2B\u001b[1mExtra tests\u001b[22m, beyond check.py:\u001b[33G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mEarlier protocol tests:\u001b[22m PIECE,\u001b[36GFIXED, pip\u001b[47Glined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[4C\u001b[1Bare\u001b[9Gunchanged.\r\u001b[2C\u001b[1B- \u001b[1mUnshared classifier\u001b[22m (the supplied\u001b[39Gmodel\u001b[45Gdoesn't\u001b[53Guse\u001b[57Gone):\u001b[63Ga\u001b[65Gtemporary\u001b[75Gcheckpoint\u001b[86Gbuilt\u001b[92Gfor\u001b[96Gthis\u001b[101Ggave\u001b[106Gbit-identical\r\u001b[2C\u001b[1B \u001b[5Glogits and the same output. I deleted\u001b[43Git afterwards because the disk is 98% full.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOther code paths, via temporary builds:\u001b[45G\u001b[22mforcing\u001b[53Gthe\u001b[57Gold\u001b[61Glayout\u001b["]
[648.88, "68Geverywhere,\u001b[80Gand\u001b[84Ga\u001b[86Gblock\u001b[92Gsize\u001b[97Gthat\u001b[102Gleaves\u001b[109Gleftover\r\u001b[2C\u001b[1B \u001b[5Grows, both pass the\u001b[25Gfull\u001b[30Gcheck.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWha\u001b[7G I didn't do:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI didn't run \u001b[19Geveral positions through\u001b[44Geach\u001b[49Gpass\u001b[54Gover\u001b[59Gthe\u001b[63Gweights.\u001b[72GThat\u001b[77Gwould\u001b[83Gbe\u001b[86Gmuch\u001b[91Gfaster\u001b[98Gfor\u001b[102Gprompts\u001b[110Gand\r\u001b[4C\u001b[1BFIXED/LOGITS,\u001b[19Gbut\u001b[23Gthe\u001b[27Grules\u001b[33Grequire\u001b[41Gbatch\u001b[47Gsize\u001b[52G1\u001b[54Gand\u001b[58Gthe\u001b[62Gsame\u001b[67Goperation\u001b[77Gshapes.\r\u001b[2C\u001b[1B- Software prefetch,\u001b[24Gusing\u001b[30Gseveral\u001b[38Gstreams\u001b[46Gat\u001b[49Gonce,\u001b[55Gand\u001b[59Gdifferent\u001b[69Gblock\u001b[75Gshapes\u001b[82Gmade\u001b[87Gno\u001b[90Gdifference\u001b[101Gor\u001b[104Gwere\u001b[109Gslower.\r\u001b[2C\u001b[2B\u001b[1mRemaining limitations:\u001b[26G\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
