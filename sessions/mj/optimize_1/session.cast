[289.298, "\u001b[H\u001b[2G \u001b[4G  \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 133 +\u001b[38;2;51;51;51m                acc[r] = p.unsafe_offset(r * W).unsafe_load[width=W]().fma(xv, acc[r])                \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 134 +\u001b[38;2;51;51;51m            p = p.unsafe_offset(R * W)                                                                \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 135 +\u001b[38;2;51;51;51m            j += W                                                                                    \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 136 +\u001b[38;2;51;51;51m        comptime for r in range(R):                                                                   \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 137 +\u001b[38;2;51;51;51m            xout[unsafe_offset=i + r] = acc[r].reduce_add()                                           \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 138 +\u001b[38;2;51;51;51m        i += R                  "]
[289.299, "                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 139 +\u001b[38;2;51;51;51m    # leftover rows (d % R) are row-major right after the packed blocks                               \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 140 +\u001b[38;2;51;51;51m    while i < d:                                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 141 +\u001b[38;2;51;51;51m        xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)                                     \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 142 +\u001b[38;2;51;51;51m        i += 1                                                                                        \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 143 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;"]
[289.301, "138;61m\u001b[48;2;220;255;220m 144 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 145 +\u001b[38;2;51;51;51mdef matmul_rows(xout: FPtr, x: FPtr, w: FPtr, n: Int, d: Int):                                        \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 146 +\u001b[38;2;51;51;51m    # Row-major fallback for n not a multiple of PK_W; MM_ROWS rows share each x load.                \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 147 \u001b[22m     comptime R = MM_ROWS\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 148 \u001b[22m     comptime W = MM_W\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[26G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Now\u001b[7Gthe load-time packing and\u001b[33Gthe embedding lookup:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Packin\u001b[10G lowered\u001b[19Gforward\u001b[27Gt"]
[289.302, "ime\u001b[32Gfrom\u001b[37G8.20\u001b[42Gto\u001b[45G7.49\u001b[50Gms/token,\u001b[60Gbut\u001b[64Gthe\u001b[68Gother\u001b[74Gmatrices\u001b[83Gstill\u001b[89Grun\u001b[93Gbelow\u001b[99Gthe\u001b[103Gmicrobenchmark's\r\u001b[1C\u001b[1B 62.7\u001b[8GGB/s. Next I'll test\u001b[29Gwhether the b\u001b[43Gck-to-back layout\u001b[61Gin\u001b[64Gexecution\u001b[74Gorder\u001b[80Gaccounts\u001b[89Gfor\u001b[93Gthe\u001b[97Ggap.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Microbe\u001b[11Gchm\u001b[15Grk contiguous\u001b[29Gvs\u001b[32Gsc\u001b[35Gtt\u001b[38Gred ma\u001b[45Grix order\u001b[55G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/mjprof && python3 -I - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102ms=open('mb.mojo').read()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m# add a 'scattered' variant using the checkpoint's real offsets (matrix-type-major across layers)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102ms=s.replace('''def main():''','''def run_scat[R: Int, W: Int](w: FPtr, x: FPtr, y: FPtr, name: StaticString):\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mvar best = Float64(1e18)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102m\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[39m \u001b[38;2;241;145;113mScampering\u2026\u001b["]
