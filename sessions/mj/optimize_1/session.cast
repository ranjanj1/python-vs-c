[555.354, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSIMD\u001b[8Gwidths\u001b[15Gmust\u001b[20Gbe\u001b[23Gpowers\u001b[30Gof\u001b[33Gtwo,\u001b[38Gso\u001b[41GI'll\u001b[46Gforce\u001b[52Gthe\u001b[56Gfallback\u001b[65Ganother\u001b[73Gway,\u001b[78Gby\u001b[81Gmaking\u001b[88G\u001b[38;2;87;105;247mis_packed\u001b[98G\u001b[39mreturn\u001b[105GFalse:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfallback\u001b[16Gpasses\u001b[23Gtoo;\u001b[28Gthe\u001b[32Gother\u001b[38Gthree\u001b[44G\u001b[38;2;87;105;247mreturn False\u001b[57G\u001b[39mmatches\u001b[65Gwere\u001b[70Galready\u001b[78Gthere.\u001b[85GI'm\u001b[89Grunning\u001b[97Gthe\u001b[101Gfinal\u001b[107Ginterleaved\r\u001b[1B \u001b[3GA/B on the development workload, comparing\u001b[46Gthe start-of-session\u001b[67Gbui\u001b[71Gd against the \u001b[86Gew one.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsteady\u001b[14Ggain\u001b[19Gof\u001b[22Gabout\u001b[28G8\u201310%\u001b[34Gholds\u001b[40Gacross\u001b[47Gthe\u001b[51Gbenchmarks,\u001b[63Gat\u001b[66Ga\u001b[68Gcost\u001b[73Gof\u001b[76G21\u001b[79Gms\u001b[82Gmore\u001b[87Gstartup.\u001b[9"]
[555.355, "6GI'm\u001b[100Grerunning\u001b[110Gthe\r\u001b[1B \u001b[3Gprotocol t\u001b[14Gsts \u001b[19Gnd a final phase profile \u001b[47G the notes next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning all\u001b[15Gtests\u001b[21Gand\u001b[25Gfinal\u001b[31Gphase\u001b[37Gprofile\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; python3 check.py -- ./mj | tail -1; python3 check.py --tokens 64 --prompts 3 -- ./mj; \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mpython3 -I /tmp/mjtest/t.py /Users/agentlab/pvc/mj 2>&1 | grep -v \"^T \"; python3 -I /tmp/mjtest/ctx.py \r\u001b[5C\u001b[1B/Users/agentlab/pvc/mj; python3 -I /tmp/mjprof/instrument.py mj.mojo /tmp/mjprof/\u2026\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22"]
[555.355, "m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mRun all tests and final phase profile\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/agentlab/pvc/mj;\u001b[31Gpython3\u001b[39Gcheck.py\u001b[48G--\u001b[51G./mj\u001b[56G|\u001b[58Gtail\u001b[63G-1;\u001b[67Gpython3\u001b[75Gcheck.py\u001b[84G--tokens\u001b[93G64\u001b[96G--prompts\u001b[106G3\u001b[108G--\u001b[111G./mj;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 -I /tmp/mjtest/t.py\u001b[32G/Users/agentlab/pvc/mj\u001b[55G2>&1\u001b[60G|\u001b[62Ggrep\u001b[67G-v\u001b[70G\"^T\u001b[74G\";\u001b[77Gpython3\u001b[85G-I\u001b[88G/tmp/mjtest/ctx.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/Users/agentlab/pvc/mj;\u001b[28Gpython3\u001b[36G-I\u001b[39G/tmp/mjprof/inst"]
