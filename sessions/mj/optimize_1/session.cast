[636.838, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The uns\u001b[11Gared-classifier\u001b[27Gpath matches\u001b[40Gbit-for-bit,\u001b[53Gand\u001b[57GI've\u001b[62Gdeleted\u001b[70Gthe\u001b[74G536\u001b[78GMB\u001b[81Gtemp\u001b[86Gcheckpoint\u001b[97Gsince\u001b[103Gthe\u001b[107Gdisk\u001b[112Gis\u001b[115G98%\r\u001b[1C\u001b[1B full. Next I'll build varia\u001b[31Gts to exercise\u001b[46Gthe row-major fallb\u001b[66Gck (PK_W=7) and the tail-row and\u001b[99Gpacked-embedding\u001b[116Gpaths\r\u001b[1C\u001b[1B (PK_R=5).\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m SIMD\u001b[8Gwidths must be powers of\u001b[33Gtw\u001b[36G, so I'll force the \u001b[57Gallb\u001b[62Gck ano\u001b[69Gher way, by m\u001b[83Gking \u001b[38;2;87;105;247mis_packed\u001b[39m return\u001b[105GFalse:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The fa\u001b[10Glback passes too; the other three \u001b[38;2;87;105;247mreturn False\u001b[57G\u001b[39mma\u001b[60Gches were already\u001b[78Gt\u001b[80Ge\u001b[83G.\u001b[85GI'm running the\u001b[101Gfinal\u001b[107Ginterleaved\r\u001b[1C\u001b[1B A/B on the develo\u001b[21Gment workload, co"]
[636.839, "mparing the \u001b[51Gtart-of-session build agains\u001b[80G the new one.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gsteady gain of\u001b[22Gab\u001b[25Gut 8\u201310% holds across\u001b[47Gthe\u001b[51Gbenchmarks,\u001b[63Gat\u001b[66Ga\u001b[68Gcost\u001b[73Gof\u001b[76G21\u001b[79Gms\u001b[82Gmore\u001b[87Gstartup.\u001b[96GI'm\u001b[100Grerunning\u001b[110Gthe\r\u001b[1C\u001b[1B protocol\u001b[12Gtests\u001b[18Gand\u001b[22Ga\u001b[24Gfinal\u001b[30Gphase\u001b[36Gprofile\u001b[44Gfor\u001b[48Gthe\u001b[52Gnotes\u001b[58Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All tests pass and the out\u001b[30Guts (the 238-token \u001b[38;2;87;105;247mstop\u001b[39m run and the FIXED 1024 argmaxes) are unchanged.\u001b[102GI'm\u001b[106Gcopying\u001b[114Gthe\r\u001b[1C\u001b[1B profiling tools into\u001b[24G\u001b[38;2;87;105;247mprof/\u001b[30G\u001b[39mfor\u001b[34Greproducibility,\u001b[51Gthen\u001b[56Gupdating\u001b[65GNOTES.md.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Updating NOTES.md with profiling evidence and changes\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -I - <<'EOF'\r\u001b[1"]
