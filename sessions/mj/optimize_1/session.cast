[447.358, "\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m cp\u001b[7Gtokenizer.bi\u001b[20G /tmp/mjunshared/; cat >\u001b[45G/tmp/mjuns\u001b[56Gared/cmp.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import subprocess, array, sys\u001b[34G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mseq\u001b[8G=\u001b[10G[1,\u001b[14G9038,\u001b[20G2501,\u001b[26G263,\u001b[31G931,\u001b[36G29892,\u001b[43G727,\u001b[48G471]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m out = []\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gd\u001b[10Gin\u001b[13G('/Users/agentlab/pvc/mj',\u001b[40G'/tmp/mjunshared'):\r\u001b[1B \u001b[2m\u2502\u001b[22m     p = subprocess.Popen(['/Use\u001b[36Gs/agen\u001b[43Glab/pvc/mj/mj',\u001b[59Gd + '/model.bin\u001b[75G,\u001b[77Gd + '/tokenizer.bin'],\u001b[100G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s\u001b[6Gd\u001b[8Gn=\u001b[11Gubprocess.PIPE, stdout=\u001b[35Gubprocess.PIPE,\u001b[51Gtext=True,\u001b[62Gbufsize=1)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Gp.stdout.readline().strip()\u001b[43G==\u001b[46G'READY'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     f = d + '/l.f32' if d.startswith('/tmp')\u001b[49Gelse\u001b[54G'/tmp/mjunshared/shared.f32'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write(f'LOGITS\u001b[31G{f}\u001b[35G'\u001b[37G+\u001b[39G'\u001b[41G'.join(map(str,\u001b[57Gseq))\u001b[63G+\u001b[65G'\\nGENERATE\u001b[77G8\u001b[79GOnce\u001b[84Gupon\u001b[89"]
[447.358, "Ga\u001b[91Gtime\\nQUIT\\n');\r\u001b[1B \u001b[2m\u2502\u001b[22m p.stdin.flush()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mr\u001b[10G=\u001b[12Gp.stdout.read();\u001b[29Gp.wait()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     a = array.array('f');\u001b[30Ga.frombytes(open(f,\u001b[50G'rb').read());\u001b[65Gout.append((a,\u001b[80Gr))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('identical\u001b[21Glogits:',\u001b[31Gout[0][0]\u001b[41G==\u001b[44Gout[1][0],\u001b[55G'|\u001b[58Gsame\u001b[63GGENERATE\u001b[72Goutput:',\u001b[82Gout[0][1]\u001b[92G==\u001b[95Gout[1][1])\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m py\u001b[7Ghon3\u001b[12G-I /tmp/mjun\u001b[25Ghared/cmp.py; rm\u001b[42G-rf /tmp/mjunshared\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m "]
