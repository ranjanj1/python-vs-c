[383.292, "\u001b[H\u001b[9G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m2\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G+=\u001b[25G1\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\u001b[12G\u001b[38;2;51;51;51m   \u001b[16G                 \u001b[34G     \u001b[40G  \u001b[43G     \u001b[49G  \u001b[52G     \u001b[58G  \u001b[61G    \u001b[66G  \u001b[69G     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m4\u001b[16G\u001b[38;2;51;51;51m \u001b[18G         \u001b[28G        \u001b[37G   \u001b[41G \u001b[43G   \u001b[47G \u001b[49G        \u001b[58G  \u001b[61G     \u001b[67G       \u001b[75G    \u001b[80G     \u001b[86G    \u001b[91G \u001b[93G     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 145 +\u001b[38;2;51;51;51mdef matmul_rows(xout: FPtr, x: FPtr, w: FPtr, n: Int, d: Int):                                        \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 146 +\u001b[38;2;51;51;51m    # Row-major fallback for n not a multiple of PK_W; MM_ROWS rows share each x load.                \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m7\u001b[16G\u001b[22mcomptime R = MM_ROWS\r\u001b[5C\u001b[1B\u001b[2m 148 \u001b[22m     comptime W = MM_W\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow the load-time packing and the embedding\u001b[47Glookup:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b"]
[383.293, "[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPacking\u001b[11Glowered\u001b[19Gforward\u001b[27Gtime\u001b[32Gfrom\u001b[37G8.20\u001b[42Gto\u001b[45G7.49\u001b[50Gms/token,\u001b[60Gbut\u001b[64Gthe\u001b[68Gother\u001b[74Gmatrices\u001b[83Gstill\u001b[89Grun\u001b[93Gbelow\u001b[99Gthe\u001b[103Gmicrobenchmark's\r\u001b[2C\u001b[1B62.7 GB/s. Next I'll\u001b[24Gtest\u001b[29Gwhether\u001b[37Gthe\u001b[41Gback-to-back\u001b[54Glayout\u001b[61Gin\u001b[64Gexecution\u001b[74Gorder\u001b[80Gaccounts\u001b[89Gfor\u001b[93Gthe\u001b[97Ggap.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix\u001b[10Gorder\u001b[16Gmakes\u001b[22Gno\u001b[25Gdifference\u001b[36G(62.5\u201363.1\u001b[47GGB/s\u001b[52Geither\u001b[59Gway),\u001b[65Gso\u001b[68GI\u001b[70Gwon't\u001b[76Gre-layout\u001b[86Gfurther.\u001b[95GNext\u001b[100GI'll\u001b[105Gsweep\u001b[111Gthe\u001b[115Gpacked\r\u001b[2C\u001b[1Bblock shape in the real\u001b[27Gprogram.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gblock\u001b[13Gshapes\u001b[20Gnow\u001b[24Gland\u001b[29Garound\u001b[36G134\u2013136\u001b[44Gtok/s,\u001b[51Gso\u001b[54Gthe\u001b[58Gkernel\u001b[65Gis\u001b[68Gmemory-bound\u001b[81Gand\u001b[85GI'm\u001b[89G"]
[383.294, "keeping\u001b[97G8\u00d78.\u001b[102GNext\u001b[107GI'll\u001b[112Grun\u001b[116Ga\r\u001b[1B \u001b[3Gquick read-bandwidth test to see whether several distant\u001b[60Gsequential\u001b[71Gstreams\u001b[79Gbeat\u001b[84Gone.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell co\u001b[18Gmand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe single sequential stream reaches 62.5 GB/s, so the packed\u001b[65Gkernel\u001b[72Gis\u001b[75Galready\u001b[83Gnear\u001b[88Gthe\u001b[92G~7.0\u001b[97Gms/token\u001b[106Gfloor\u001b[112Gand\r\u001b[2C\u001b[1Bmatmul work is done. Next I'll measure startup time\u001b[55Gto\u001b[58G\u001b[38;2;87;105;247mREADY\u001b[39m,\u001b[65Gsince\u001b[71Gthe\u001b[75Gharness\u001b[83Gmay\u001b[87Gcount\u001b[93Git\u001b[96Gtoo.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m2\u001b[30G4\u001b[39m\u001b[40;1H\u001b[38;3H"]
