[553.66, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing one offset bug before building (\u001b[38;2;87;105;247mrms_att_weight\u001b[57G\u001b[39mupper\u001b[63Gbound\u001b[69Gmust\u001b[74Gbe\u001b[77Grelative\u001b[86Gto\u001b[89G\u001b[38;2;87;105;247mdone\u001b[39m):\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup now takes 0.087\u001b[27Gs,\u001b[30Gup\u001b[33Gfrom\u001b[38G0.078\u001b[44Gs\u001b[46Gbefore\u001b[53Gpacking.\u001b[62GNext\u001b[67GI'll\u001b[72Gsilence\u001b[80Gthe\u001b[84Gunused-loop-variable\u001b[105Gwarnings\u001b[114Gand\r\u001b[2C\u001b[1Btest\u001b[8Gthe\u001b[12Gunshared-classifier\u001b[32Gpath\u001b[37Gwith\u001b[42Ga\u001b[44Gtemporary\u001b[54Gcheckpoint\u001b[65Gwhose\u001b[71Glogits\u001b[78Gshould\u001b[85Gmatch\u001b[91Gthe\u001b[95Gshared\u001b[102Gmodel.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe unshared-classifier\u001b[27Gpath\u001b[32Gmatches\u001b[40Gbit-for-bit,\u001b[53Gand\u001b[57GI've\u001b[62Gdeleted\u001b[70Gthe\u001b[74G536\u001b[78GMB\u001b[81Gtemp\u001b[86Gcheckpoint\u001b[97Gsince\u001b[103Gthe\u001b[107Gdisk\u001b[112Gis\u001b[115G98%\r\u001b["]
[553.661, "2C\u001b[1Bfull.\u001b[9GNext\u001b[14GI'll\u001b[19Gbuild\u001b[25Gvariants\u001b[34Gto\u001b[37Gexercise\u001b[46Gthe\u001b[50Grow-major\u001b[60Gfallback\u001b[69G(PK_W=7)\u001b[78Gand\u001b[82Gthe\u001b[86Gtail-row\u001b[95Gand\u001b[99Gpacked-embedding\u001b[116Gpaths\r\u001b[1B \u001b[3G(PK_R=5).\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSIMD widths must be powers\u001b[30Gof\u001b[33Gtwo,\u001b[38Gso\u001b[41GI'll\u001b[46Gforce\u001b[52Gthe\u001b[56Gfallback\u001b[65Ganother\u001b[73Gway,\u001b[78Gby\u001b[81Gmaking\u001b[88G\u001b[38;2;87;105;247mis_packed\u001b[98G\u001b[39mreturn\u001b[105GFalse:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe fallback passes too;\u001b[28Gthe\u001b[32Gother\u001b[38Gthree\u001b[44G\u001b[38;2;87;105;247mreturn False\u001b[57G\u001b[39mmatches\u001b[65Gwere\u001b[70Galready\u001b[78Gthere.\u001b[85GI'm\u001b[89Grunning\u001b[97Gthe\u001b[101Gfinal\u001b[107Ginterleaved\r\u001b[2C\u001b[1BA/B\u001b[7Gon\u001b[10Gthe\u001b[14Gdevelopment\u001b[26Gworkload,\u001b[36Gcomparing\u001b[46Gthe\u001b[50Gstart-of-session\u001b[67Gbuild\u001b[73Gagainst\u001b[81Gthe\u001b[85Gnew\u001b[89Gone.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m"]
[553.662, "\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsteady gain of about\u001b[28G8\u201310%\u001b[34Gholds acros\u001b[47Gthe\u001b[51Gbenchmarks,\u001b[63Gat\u001b[66Ga\u001b[68Gcost\u001b[73Gof\u001b[76G21\u001b[79Gms\u001b[82Gmore\u001b[87Gstartup.\u001b[96GI'm\u001b[100Grerunning\u001b[110Gthe\r\u001b[1B  protocol tests and a final phase profile for the notes next.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[29C\u001b[2B\u001b[38;2;102;102;102m6\u001b[39m\u001b[40;1H\u001b[38;3H"]
