[247.079, "\u001b[H\u001b[8G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m37\u001b[20G\u001b[38;2;51;51;51m   \u001b[24Gxout[unsafe_offset=i\u001b[45G+\u001b[47Gr]\u001b[50G=\u001b[52Gacc[r].reduce_add()\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[20G\u001b[38;2;51;51;51mi += R \u001b[28G \u001b[30G  \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[16G\u001b[38;2;51;51;51m#\u001b[18Gleftover rows (d % R) are row-major right after the packed\u001b[77Gblocks\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m40\u001b[16G\u001b[38;2;51;51;51mwhile\u001b[22Gi\u001b[24G< d:    \u001b[33G   \u001b[37G \u001b[39G  \u001b[42G         \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m41\u001b[20G\u001b[38;2;51;51;51mxout[uns\u001b[29Gfe_offset=i] = dot(w.unsafe_offset(i * n), x, n)             \u001b[91G       \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m42\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G+= 1 \u001b[28G                 \u001b[46G \u001b[48G  \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m43\u001b[24G\u001b[38;2;51;51;51m \u001b[26G  \u001b[29G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m44\u001b[20G\u001b[38;2;51;51;51m        \u001b[29G   \u001b[33G \u001b[35G  \u001b[38G         \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m45\u001b[12G\u001b[38;2;51;51;51mdef\u001b[16Gmatmul_rows(xout: FPtr, x: FPtr, w:\u001b[52GFPtr, n: Int, d: Int):\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m46\u001b[16G\u001b[38;2;51;51;51m#\u001b[18GRow-major\u001b[28Gfallback\u001b[37Gfo"]
[247.08, "r\u001b[41Gn\u001b[43Gnot\u001b[47Ga\u001b[49Gmultiple\u001b[58Gof\u001b[61GPK_W;\u001b[67GMM_ROWS\u001b[75Grows\u001b[80Gshare\u001b[86Geach\u001b[91Gx\u001b[93Gload.\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 147 \u001b[22m     comptime R = MM_ROWS\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 148 \u001b[22m     comptime W = MM_W\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 149 \u001b[22m     var i = 0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow the load-time packing and the embedding lookup:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mAdding load-time packing and packed embedding lookup\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; mojo build mj.mojo -o mj 2>&1 | grep -iA8 \"error\\|warning\" | head -20; python3 \r\u001b[5C\u001b[1Bcheck.py --tokens 64 --prompts 3 -- ./mj | tail -4; python3 -I /tmp/mjprof/instrument.py mj.mojo \r\u001b[5C\u001b[1B/tmp/mjprof/mj_prof.mojo && mojo build /tmp/mjprof/mj_prof.mojo -o /tmp/mjprof/mj_prof 2>&1 | \u2026\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[247.081, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mBuild packed version, check and profile\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcd /Users/agentlab/pvc/mj; mojo build\u001b[42Gmj.mojo\u001b[50G-o\u001b[53Gmj\u001b[56G2>&1\u001b[61G|\u001b[63Ggrep\u001b[68G-iA8\u001b[73G\"error\\|warning\"\u001b[90G|\u001b[92Ghead\u001b[97G-20;\u001b[102Gpython3\u001b"]
