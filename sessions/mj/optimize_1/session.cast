[152.714, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat\u001b[8Gsampled\u001b[16Gthe\u001b[20GPython\u001b[27Gdriver\u001b[34Ginstead\u001b[42Gof\u001b[45Gthe\u001b[49Gprogram.\u001b[58GSampling\u001b[67Gthe\u001b[71Gchild\u001b[77GPID\u001b[81Gthat\u001b[86Gthe\u001b[90Gdriver\u001b[97Gprints:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul accounts for about 98%\u001b[33Gof\u001b[36Gmain-thread\u001b[48Gsamples,\u001b[57Gwith\u001b[62Gforward\u001b[70Gand\u001b[74Gsoftmax\u001b[82Gminor;\u001b[89GI'm\u001b[93Gchecking\u001b[102Gwhat\u001b[107Gthe\r\u001b[2C\u001b[1Bsemaphore_wait_trap\u001b[23Gsamples\u001b[31Gare\u001b[35Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFour\u001b[8Gextra\u001b[14Gthreads\u001b[22Gare\u001b[26Gthe\u001b[30GMojo\u001b[35Gruntime's\u001b[45Gown\u001b[49Gidle\u001b[54Gworker\u001b[61Gpool,\u001b[67Gso\u001b[70Gthey\u001b[75Gadd\u001b[79Gno\u001b[82Gcompute;\u001b[91Gmatmul\u001b[98Gis\u001b[101Gabout\u001b[107G98%\u001b[111Gof\r\u001b[2C\u001b[1Bruntime. I'm adding an\u001b[26Goptional\u001b[35GPROFILE\u001b[43Gbuild\u001b[49Gflag\u001b[54Gto\u001b[57Gtime\u001b[62Gmatmul\u001b[69Gper\u001b[73Gmatrix\u001b[80Gand\u001b[84Greport\u001b"]
[152.715, "[91Geffective\u001b[101GGB/s.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gdo\u001b[11Gthis\u001b[16Gas\u001b[19Gan\u001b[22Ginstrumented\u001b[35Gcopy\u001b[40Ggenerated\u001b[50Gby\u001b[53Ga\u001b[55Gscript,\u001b[63Gso\u001b[66G\u001b[38;2;87;105;247mmj.mojo\u001b[74G\u001b[39mitself\u001b[81Gstays\u001b[87Gclean.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mFixing\u001b[10Gstderr\u001b[17Gprint\u001b[23Gand\u001b[27Gprofiling\u001b[37Gphases\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; sed -i '' 's/file=2)/file=RawFileDescriptor(2))/' /tmp/mjprof/instrument.py && python3\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m-I /tmp/mjprof/instrument.py mj.mojo /tmp/mjprof/mj_prof.mojo && mojo build /tmp/mjprof/mj_prof.mojo -o \r\u001b[5C\u001b[1B/tmp/mjprof/mj_prof 2>&1 | grep -iA8 error | head -30; python3 -I /tmp/mjprof/w\u2026\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
