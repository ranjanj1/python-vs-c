[192.153, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[24G\u001b[22mmm_packed[R,\u001b[37GW](y,\u001b[43Gx,\u001b[46Gw.unsafe_offset(off),\u001b[68Gn,\u001b[71Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22melse:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                    \u001b[24Gmm_rows[R,\u001b[35GW](y,\u001b[41Gx,\u001b[44Gw.unsafe_offset(off),\u001b[66Gn,\u001b[69Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22moff\u001b[24G+=\u001b[27Gn\u001b[29G*\u001b[31Gd\r\u001b[1B \u001b[2m\u2502\u001b[22m     \u001b[9G  \u001b[12Gcomptime if\u001b[24Gp\u001b[26Gcked:\u001b[32G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G    \u001b[16Gmm_packed[R, W](y,\u001b[35Gx,\u001b[38Gw.unsafe_offset(off),\u001b[60G768,\u001b[65G32000)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22melse:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             mm_rows[R,\u001b[27GW](y,\u001b[33Gx,\u001b[36Gw.unsafe_offset(off),\u001b[58G768,\u001b[63G32000)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22moff\u001b[16G+=\u001b[19G768\u001b[23G*\u001b[25G32000\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8G    var\u001b[16Gdt = Float64(perf_counter_ns() -\u001b[49Gt0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gdt\u001b[18G<\u001b[20Gbest:\u001b[26Gbest\u001b[31G=\u001b[33Gdt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     var bytes = Float64(12\u001b[31G*\u001b[33G(4\u001b[36G*\u001b[38G768\u001b[42G*\u001b[44G768\u001b[48G+\u001b[50G3\u001b[52G*\u001b[54G768\u001b[58G*\u001b[60G2048)\u001b[66G+\u001b[68G768\u001b[72G*\u001b[74G32000)\u001b[81G*\u001b[83G4\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22m"]
[192.154, "print(name,\u001b[20G\"ms\",\u001b[26Gbest\u001b[31G/\u001b[33G1e6,\u001b[38G\"GB/s\",\u001b[46Gbytes\u001b[52G/\u001b[54Gbest)\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def main():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gtotal\u001b[18G=\u001b[20G12\u001b[23G*\u001b[25G(4\u001b[28G*\u001b[30G768\u001b[34G*\u001b[36G768\u001b[40G+\u001b[42G3\u001b[44G*\u001b[46G768\u001b[50G*\u001b[52G2048)\u001b[58G+\u001b[60G768\u001b[64G*\u001b[66G32000\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     var w = fa(total)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gx\u001b[14G=\u001b[16Gfa(2048)\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8Gvar y\u001b[14G= fa(32000)\u001b[26G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     run[False, 2, 32](w, x, y,\u001b[35G\"rows  \u001b[43GR=2 W=32\")\u001b[54G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrun[False,\u001b[19G4,\u001b[22G16](w,\u001b[29Gx,\u001b[32Gy,\u001b[35G\"rows\u001b[43GR=4\u001b[47GW=16\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     run[True, 2, 32](w,\u001b[28Gx,\u001b[31Gy,\u001b[34G\"packed\u001b[42GR=2\u001b[46GW=32\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrun[True,\u001b[18G4,\u001b[21G16](w,\u001b[28Gx,\u001b[31Gy,\u001b[34G\"packed\u001b[42GR=4\u001b[46GW=16\")\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8Grun[True, 4, 32](w, x, y, \"packed R=4 W=32\")\u001b[53G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrun[True,\u001b[18G8,\u001b[21G16](w,\u001b[28Gx,\u001b[31Gy,\u001b[34G\"packed\u001b[42GR=8\u001b[46GW=16\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m"]
[192.154, "     run[True, 8, 8](w,\u001b[27Gx,\u001b[30Gy,\u001b[33G\"packed\u001b[41GR=8\u001b[45GW=8\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrun[True,\u001b[18G16,\u001b[22G8](w,\u001b[28Gx,\u001b[31Gy,\u001b[34G\"packed\u001b[42GR=16\u001b[47GW=8\")\r\u001b[1B \u001b[2m\u2502\u001b[22m  \u001b[6G  run[False, 2, 32](w, x, y, \"rows   R=2 W=32\")\u001b[54G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m moj\u001b[8G build /tmp/mjprof/mb.mojo -o /tmp/mjprof/mb\u001b[53G2>&1\u001b[58G|\u001b[60Ggrep\u001b[65G-iA5\u001b[70Gerror\u001b[76G|\u001b[78Ghead;\u001b[84G/tmp/mjprof/mb\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[26G\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon"]
[192.155, "'t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mmojo build, grep -iA5 error\u001b[22m,\u001b[65Gand\u001b[69G\u001b[1m/tmp/mjprof/mb\u001b[84G\u001b[22mcommands\u001b[93Gin\u001b[96G\u001b[1m/Users/agentlab/pvc/mj\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
[192.606, "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
