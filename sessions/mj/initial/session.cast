[454.479, "\u001b[H\u001b[9G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m3\u001b[25G\u001b[38;2;51;51;51m2\u001b[31G2\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m4\u001b[25G\u001b[38;2;51;51;51m3\u001b[31G3\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m5\u001b[24G\u001b[38;2;51;51;51mj += 1                   \u001b[50G \u001b[52G  \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m6\u001b[20G\u001b[38;2;51;51;51mxout[unsafe_offset=i]\u001b[42G=\u001b[44Gs0\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m7\u001b[40G\u001b[38;2;51;51;51m + 1] =\u001b[48Gs1\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m8\u001b[43G\u001b[38;2;51;51;51m2\u001b[49G2\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m9\u001b[43G\u001b[38;2;51;51;51m3\u001b[49G3\r\u001b[6C\u001b[1B\u001b[38;2;207;34;46m100\u001b[20G\u001b[38;2;51;51;51mi += 4              \u001b[41G \u001b[43G  \u001b[46G \u001b[48G  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  78 +\u001b[38;2;51;51;51m        while j + \u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m <= n:                                                                             \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[20G\u001b[38;2;51;51;51m    var\u001b[28Gxv = x.unsafe_offset(j).unsafe_load[width=\u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m]()\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m80\u001b[24G\u001b[38;2;51;51;51mcomptime\u001b[33Gfor r in rang\u001b[47G(R):                       \r\u001b["]
[454.48, "8C\u001b[1B\u001b[38;2;36;138;61m1\u001b[12G\u001b[38;2;51;51;51m\u001b[48;2;178;255;178m                acc[r]\u001b[48;2;220;255;220m =\u001b[37G\u001b[48;2;178;255;178mrb\u001b[48;2;220;255;220m.uns\u001b[44Gfe_offset(\u001b[48;2;178;255;178mr * n + \u001b[48;2;220;255;220mj).unsafe_load[width=\u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m]().fma(xv,\u001b[96G\u001b[48;2;178;255;178macc[r]\u001b[48;2;220;255;220m)\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m2\u001b[12G\u001b[38;2;51;51;51m            j += W    \u001b[35G \u001b[37G                                                          \u001b[96G       \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\u001b[20G\u001b[38;2;51;51;51mcomptime\u001b[29Gfor\u001b[33Gr\u001b[35Gin\u001b[38Grange(R):\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m4\u001b[20G\u001b[38;2;51;51;51m    var s = acc[r].reduce_add()\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[24G\u001b[38;2;51;51;51mfo\u001b[28Gjj in range(j, n):     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[24G\u001b[38;2;51;51;51m   \u001b[28Gs += rb[unsafe_offset=r\u001b[52G*\u001b[54Gn\u001b[56G+\u001b[58Gjj]\u001b[62G*\u001b[64Gx[unsafe_offset=jj]\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[24G\u001b[38;2;51;51;51mxout[unsafe_offset=i + r] =\u001b[52Gs\u001b[54G \u001b[56G \u001b[58G   \u001b[62G \u001b[64G                   \r\u001b[8C\u001b[1B\u001b[38;2;36;13"]
