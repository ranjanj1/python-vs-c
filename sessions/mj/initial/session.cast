[278.78, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(mj.mojo)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m774\u001b[22m lines\u001b[22Gto\u001b[25G\u001b[1mmj.mojo\r\u001b[1B\u001b[22m     \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m# MJ: llama2.c (reference/run.c) inference in Mojo 1.2.0, standard library only.\r\u001b[7C\u001b[1B\u001b[2m2\u001b[12G\u001b[22mSing\u001b[17Ge-threaded, float32 weights and a\u001b[51Gtivati\u001b[58Gns, batch\u001b[69Gize 1.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[13G\u001b[22mpeaks \u001b[21Ge line protocol\u001b[37Gin INTERFACE.md on stdin/stdout.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22mfrom std.memory.alloc import alloc, Layout\r\u001b[7C\u001b[1B\u001b[2m6\u001b[19G\u001b[22msys import argv\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[19G\u001b[22mio.f\u001b[24Gle_desc\u001b[32Giptor import RawFileDescriptor\r\u001b[7C\u001b[1B\u001b[2m8\u001b[19G\u001b[22mmath import ex\u001b[34G, cos, sin, sqrt, log\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +764 li"]
