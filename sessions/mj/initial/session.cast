[620.067, "\u001b[H\u001b[9G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m2\u001b[24G\u001b[38;2;51;51;51mj += W  \u001b[33G   \u001b[37G \u001b[39G  \u001b[42G         \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\u001b[12G\u001b[38;2;51;51;51m        comptime for r\u001b[35Gin range(R):                                                \u001b[96G       \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m4\u001b[24G\u001b[38;2;51;51;51mvar s =\u001b[32Gacc[r].reduce_add()\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[20G\u001b[38;2;51;51;51m    for jj in ra\u001b[37Gge(j, n): \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[24G\u001b[38;2;51;51;51m   \u001b[30G+= rb\u001b[36Gunsafe_offset=r\u001b[52G*\u001b[54Gn\u001b[56G+\u001b[58Gjj]\u001b[62G*\u001b[64Gx[unsafe_offset=jj]\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[24G\u001b[38;2;51;51;51mx\u001b[26Gut[unsafe_offset=i +\u001b[47Gr]\u001b[50G=\u001b[52Gs\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G+=\u001b[25GR\u001b[28G \u001b[30G  \u001b[33G                  \u001b[52G \u001b[54G \u001b[56G \u001b[58G   \u001b[62G \u001b[64G                   \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  89 \u001b[22m     while i < d:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  90 \u001b[22m         xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m91\u001b[16G\u001b[22m    i\u001b[22G+= 1\u001b[39m\u001b"]
[620.068, "[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mShell quoting issue (zsh\u001b[28Gdoesn't\u001b[36Gword-split);\u001b[49Gretrying.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults look noisy (R=2\u001b[27Gruns\u001b[32Gdisagree),\u001b[43Gso\u001b[46GI'm\u001b[50Gre-running\u001b[61Gthe\u001b[65Gcandidates\u001b[76Ginterleaved,\u001b[89Gseveral\u001b[97Gtimes\u001b[103Geach.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mR=2 rows \u00d7 32-wide SIMD\u001b[27Gis\u001b[30Gconsistently\u001b[43Gbest\u001b[48G(~118\u001b[54Gtok/s,\u001b[61Gup\u001b[64Gfrom\u001b[69G~87).\u001b[75GOne\u001b[79Gmore\u001b[84Gexperiment:\u001b[96Gsoftware\u001b[105Gprefetch.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefetch gives nothing,\u001b[27Gso\u001b[30GI'm\u001b[34Gkeeping\u001b[42Gthe\u001b[46Gplain\u001b[52Gloop\u001b[57Gat\u001b[60GR=2,\u001b[65GW=32.\u001b[71GThroughput\u001b[82Gdrops\u001b[88Gat\u001b[91Glong\u001b[96Gcontext\u001b[104G(FIXED\u001b[111G1024\r\u001b[2C\u001b[1Baveraged\u001b[12G~68\u001b[16Gtok/s\u001b[22Gvs\u001b[25G~118\u001b[30Gat\u001b[33Gsh"]
[620.069, "ort),\u001b[41Gso\u001b[44Gthe\u001b[48Gattention\u001b[58Gloops\u001b[64Gare\u001b[68Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm adding a head-size-specialized\u001b[38Gattention\u001b[48Gpath\u001b[53Gfor\u001b[57GHS=64\u001b[63Gthat\u001b[68Gkeeps\u001b[74Gq\u001b[76Gand\u001b[80Gthe\u001b[84Goutput\u001b[91Gaccumulator\u001b[103Gin\u001b[106GSIMD\u001b[111Gregisters,\r\u001b[1B  plus a vectorized\u001b[21Gsoftmax,\u001b[30Gwith\u001b[35Gthe\u001b[39Ggeneric\u001b[47Gpath\u001b[52Gkept\u001b[57Gas\u001b[60Gfallback.\r\u001b[25C\u001b[2B\u001b[38;2;102;102;102m8\u001b[39m\u001b[40;1H\u001b[38;3H"]
