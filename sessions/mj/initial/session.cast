[331.117, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery\u001b[9Gfixture\u001b[17Gcheck\u001b[23Gpasses\u001b[30Gand\u001b[34Gthroughput\u001b[45Gis\u001b[48Gabout\u001b[54G80\u001b[57Gtok/s,\u001b[64Gso\u001b[67Gthere's\u001b[75Gheadroom.\u001b[85GI'm\u001b[89Gchecking\u001b[98Gthe\u001b[102Ghardware\u001b[111Gand\u001b[115Gthen\r\u001b[1B  tuning the matmul kernel.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sysctl -n machdep.cpu.brand_string hw.memsize hw.perflevel0.l2cachesize 2>/dev/null; cat > /tmp/mjtest/bench.py \r\u001b[5C\u001b[1B<<'EOF'\r\u001b[5C\u001b[1Bimport subprocess, sys, time\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mexe, d = sys.argv[1], sys.argv[2]\r\u001b[5C\u001b[1Bp = subprocess.Popen([exe, d + '/model.bin', d + '/tokenizer.bin'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,\u2026\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
