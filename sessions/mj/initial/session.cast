[769.899, "\u001b[H\u001b[8G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m72\u001b[24G\u001b[38;2;51;51;51m   \u001b[28G  \u001b[31G \u001b[33G                     \u001b[55G  \u001b[58G       \u001b[66G \u001b[68G                           \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m73\u001b[24G\u001b[38;2;51;51;51m                   \u001b[44G \u001b[46G       \u001b[54G \u001b[56G  \u001b[59G \u001b[61G   \u001b[65G \u001b[67G                \u001b[84G \u001b[86G       \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 174 \u001b[22m def attention_head[HS: Int](\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 175 \u001b[22m     q: FPtr, att: FPtr, kb: FPtr, vb: FPtr, stride: Int, npos: Int, xb: FPtr, sqrt_hs: Float32\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 176 \u001b[22m ):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPosition-major attention brings FIXED 1024 to ~109 tok/s (from 93). Now I'll tidy the dispatch and remove the\u001b[K\r\u001b[2C\u001b[1Bsuperseded per-head kernel.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m"]
[769.9, "Check passes. That benchmark number (101.6 vs ~109) could be noise, so I'm rerunning it and also testing the generic\r\u001b[2C\u001b[1Bfallback path by forcing it on.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mValidating generic path and re-benchmark\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -e 's/ if head_size == 64:/ if False:/' -e 's/ elif head_size == 128:/ elif False:/' mj.mojo > \r\u001b[5C\u001b[1B/tmp/mjtest/gen.mojo && grep -c \"if False\" /tmp/mjtest/gen.mojo && mojo build /tmp/mjtest/gen.mojo -o \r\u001b[5C\u001b[1B/tmp/mjtest/gen 2>&1 | grep -i error; python3 check.py --tokens 64 --prompts 3 -- /tmp/mjtest/ge\u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m"]
