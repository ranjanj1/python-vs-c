[903.953, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gstreaming-read\u001b[22Gceiling\u001b[30Gworks\u001b[36Gout\u001b[40Gto\u001b[43Gabout\u001b[49G141\u001b[53Gtok/s,\u001b[60Gand\u001b[64Gat\u001b[67Groughly\u001b[75G120\u001b[79Gtok/s\u001b[85Gwe're\u001b[91Gnear\u001b[96G86%\u001b[100Gof\u001b[103Git,\u001b[107Gso\u001b[110GI'll\u001b[115Gstop\r\u001b[2C\u001b[1Btuning. Next I'll free the\u001b[30Gthree\u001b[36Gscratch\u001b[44Gbuffers\u001b[52Gthat\u001b[57G\u001b[38;2;87;105;247mencode\u001b[64G\u001b[39mleaks\u001b[70Gon\u001b[73Geach\u001b[78Gcall.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything still passes. One more edge\u001b[42Gcase,\u001b[48Gthe\u001b[52G\u001b[38;2;87;105;247mcontext\u001b[60G\u001b[39mstop:\u001b[66Ga\u001b[68Glong\u001b[73Gprompt\u001b[80Gnear\u001b[85Gseq_len=1024.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe \u001b[38;2;87;105;247mcontext\u001b[39m stop matches the reference loop exactly: 877 prompt tokens give 1024 \u2212 877 + 1 = 148 new tokens.\u001b[112GA\u001b[114Gfinal\r\u001b[2C\u001b[1Bpass over the source, then NOTES.md.\u001b[K\r\u001b[5C\u001b[1B\u001b["]
[903.954, "K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(NOTES.md)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m103\u001b[22m lines\u001b[22Gto\u001b[25G\u001b[1mNOTES.md\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m# MJ \u2014 llama2.c in Mojo 1.2.0\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22mSingle source file `mj.mojo` \u2192 executable `mj`. It implements `reference/run.c` (forward pass, BPE\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mtokenizer, greedy argmax) behind the line protocol in `INTERFACE.md`. It uses only the Mojo 1.2.0\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22mstandard library: SIMD, compile-time parameters, `std.math`, file I/O and raw fd reads. It does not\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22muse Python interop, MAX, `parallelize`, threads, fast-math or any external math library.\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m## Commands used\u001b[39m\u001b[K\r\u001b[1C\u001b[1B "]
[903.955, "   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m```\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m\u2026 +93 lines \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ rm -rf /tmp/mjprobe; mojo build mj.mojo -o mj 2>&1 | head -5; python3 check.py --tokens 64 --prompts 3 -- ./mj | \r\u001b[5C\u001b[1Btail -2; ls -la\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[39m \u001b[38;2;226;130;98mHatching\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(14m 23s \u00b7 \u2193\u001b[26G52.2k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[39m\u001b[K\r\u001b[6C\u001b[1B        \u001b[16G  \u001b[19G                      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[903.956, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
