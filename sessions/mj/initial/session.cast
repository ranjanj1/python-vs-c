[338.684, "\u001b[H\u001b[7G\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing the\u001b[14Gremaining\u001b[24Gfew\u001b[28Gby\u001b[31Ghand,\u001b[37Gplus\u001b[42Gthe\u001b[46G\u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shel\u001b[14G commands \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes (max\u001b[27Glogit\u001b[33Gerror\u001b[39G~1.8e-5\u001b[47Gvs\u001b[50Gtolerance\u001b[60G5e-4).\u001b[67GRunning\u001b[75Gthe\u001b[79Gfull\u001b[84Gcheck\u001b[90Gover\u001b[95Gall\u001b[99Gprompts\u001b[107Gand\u001b[111G64\u001b[114Gtokens:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFull check passes. Now\u001b[26Gverifying\u001b[36Gcommands\u001b[45Gcheck.py\u001b[54Gdoesn't\u001b[62Gexercise\u001b[71G(PIECE,\u001b[79GFIXED,\u001b[86Gedge\u001b[91Gcases)\u001b[98Gand\u001b[102Gmeasuring\u001b[112Gspeed.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m"]
[338.685, "\u23fa\u001b[3G\u001b[39mEvery fixture check passes\u001b[30Gand\u001b[34Gthroughput\u001b[45Gis\u001b[48Gabout\u001b[54G80\u001b[57Gtok/s,\u001b[64Gso\u001b[67Gthere's\u001b[75Gheadroom.\u001b[85GI'm\u001b[89Gchecking\u001b[98Gthe\u001b[102Ghardware\u001b[111Gand\u001b[115Gthen\r\u001b[2C\u001b[1Btuning\u001b[10Gthe\u001b[14Gmatmul\u001b[21Gkernel.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mChecking\u001b[12Ghardware\u001b[21Gand\u001b[25Gmojo\u001b[30Gbuild\u001b[36Goptions\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sysct\u001b[15Ghw.\u001b[19Godel machdep.cpu.brand_string hw.ncpu 2>&1 | head; mojo build --help 2>&1 | head -60\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mCh"]
