[682.638, "\u001b[H\u001b[6G\u001b[38;2;102;102;102mb=\"\"\" # multihead attention\r\u001b[5C\u001b[1Bvar kbase = self.key_cache.unsafe_offset(loff)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mvar vbase = self.value_cache.unsafe_offset(loff)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mif ATTN_ALL and head_size == 64:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mattention_\u2026\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mCompare position-major vs per-head attention\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[682.639, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3 -I - <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms=open('/Users/agentlab/pvc/mj/mj.mojo').read()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ma=\"\"\"            # multihead attention\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          for h in range(self.n_heads):\"\"\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mb=\"\"\"            # multihead attention\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          var kbase = self.key_cache.unsafe_offset(loff)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          var vbase = self.value_cache.unsafe_offset(loff)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          if ATTN_ALL and head_size == 64:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m              attention_all[64](self.q, self.att, kbase, vbase, kv_dim, seq_len, pos + 1, self.xb, sqrt_hs,\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m"]
[682.64, "self.n_heads, kv_mul)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          for h in range(self.n_heads if not (ATTN_ALL and head_size == 64) else 0):\"\"\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert a in s; s=s.replace(a,b)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms=s.replace(\"comptime MM_ROWS = 2\",\"comptime ATTN_ALL = True\\ncomptime MM_ROWS = 2\")\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('/Users/agentlab/pvc/mj/mj.mojo','w').write(s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('/tmp/mjtest/noall.mojo','w').write(s.replace(\"comptime ATTN_ALL = True\",\"comptime ATTN_ALL = False\"))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmojo build mj.mojo -o mj 2>&1 | grep\u001b[41G-iA6\u001b[46G\"error\"\u001b[54G|\u001b[56Ghead\u001b[61G-30;\u001b[66Gmojo\u001b[71Gbuild\u001b[77G/tmp/mjtest/noall.mojo\u001b[100G-o\u001b[103G/tmp/mjtest/noall\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m2>&1 | grep -i error\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor e in ./mj\u001b[18G/tmp/mjtest/noall\u001b[36G./mj\u001b[41G/tmp/mjtest/noall;\u001b[60Gdo\u001b[63Gecho\u001b[68G-n\u001b[71G\"$e\u001b[75G\";\u001b[78Gpython3\u001b[86G-I\u001b[89G/tmp/mjtest/bench2.py\u001b[111G$e\u001b[114G.;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdone\r\u001b[1B\u001b[38;2;175;17"]
