[860.572, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPosition-major attention brings FIXED 1024 to ~109\u001b[54Gtok/s\u001b[60G(from\u001b[66G93).\u001b[71GNow\u001b[75GI'll\u001b[80Gtidy\u001b[85Gthe\u001b[89Gdispatch\u001b[98Gand\u001b[102Gremove\u001b[109Gthe\r\u001b[2C\u001b[1Bsuperseded per-head kernel.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Check passes.\u001b[17GThat\u001b[22Gbenchmark\u001b[32Gnumber\u001b[39G(101.6\u001b[46Gvs\u001b[49G~109)\u001b[55Gcould\u001b[61Gbe\u001b[64Gnoise,\u001b[71Gso\u001b[74GI'm\u001b[78Grerunning\u001b[88Git\u001b[91Gand\u001b[95Galso\u001b[100Gtesting\u001b[108Gthe\u001b[112Ggeneric\r\u001b[1C\u001b[1B fallback path by forcing it on.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Both paths \u001b[15Gass at about\u001b[28G120\u001b[32Gtok/s\u001b[38Gshort-context\u001b[52Gand\u001b[56G110\u001b[60Gtok/s\u001b[66Gat\u001b[69Gfull\u001b[74Gcontext.\u001b[83GNext\u001b[88GI'll\u001b[93Gmeasure\u001b[101Gthis\u001b[106Gmachine's\r\u001b[1C\u001b[1B single-core streaming-read\u001b[30Gceiling\u001b[38Gto\u001b[41Gsee\u001b[45Ghow\u001b[49Gmuch\u001b[54Gheadroom\u001b[63Gremains."]
[860.574, "\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The streaming-read ceiling\u001b[30Gworks\u001b[36Gout\u001b[40Gto\u001b[43Gabout\u001b[49G141\u001b[53Gtok/s,\u001b[60Gand\u001b[64Gat\u001b[67Groughly\u001b[75G120\u001b[79Gtok/s\u001b[85Gwe're\u001b[91Gnear\u001b[96G86%\u001b[100Gof\u001b[103Git,\u001b[107Gso\u001b[110GI'll\u001b[115Gstop\r\u001b[1C\u001b[1B tuning.\u001b[11GNext\u001b[16GI'll free the three scratch buffers\u001b[52Gthat\u001b[57G\u001b[38;2;87;105;247mencode\u001b[64G\u001b[39mleaks\u001b[70Gon\u001b[73Geach\u001b[78Gcall.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything still\u001b[20Gpasses.\u001b[28GOne\u001b[32Gmore\u001b[37Gedge\u001b[42Gcase,\u001b[48Gthe\u001b[52G\u001b[38;2;87;105;247mcontext\u001b[60G\u001b[39mstop:\u001b[66Ga\u001b[68Glong\u001b[73Gprompt\u001b[80Gnear\u001b[85Gseq_len=1024.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Testing\u001b[11Gcon\u001b[15Gex\u001b[18G-l\u001b[21Gmit stop behaviour\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/mjtest/ctx.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport subprocess, sys\u001b[39"]
[860.575, "m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102md = sys.argv[1]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mp = subprocess.Popen([d + '/mj', d + '/model.bin', d + '/tokenizer.bin'], stdin=subprocess.PIPE, \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mstdout=subprocess.PIPE, text=True, bufsize=1)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mrd = lambda: p.stdout.readline().rstrip('\\n')\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102massert rd() == 'READY'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mtext = 'the c\u2026\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2733\u001b[39m \u001b[38;2;215;119;87mHatching\u2026 \u001b[38;2;102;102;102m(13m 41s \u00b7 \u2193\u001b[26G48.9k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[39m\u001b[K\r\u001b[6C\u001b[1B                      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
