[637.339, "                                                                                           \u001b[49m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 163 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m    \u001b[38;2;51;51;51m\u001b[2m 164 \u001b[22m def add_into(x: FPtr, y: FPtr, n: Int):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 165 \u001b[22m     var j = 0\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 166 \u001b[22m     while j + VW <= n:\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Rebuild,\u001b[12Gbench\u001b[18Gark and validate\u001b[38;2;102;102;102m \u00b7 2s\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ mojo build mj.mojo -o mj 2>&1 | grep -iB2 -A6 \"error\\|warning\" | head -30; python3 -I /tmp/mjtest/bench2.py ./mj \r\u001b[1C\u001b[1B\u001b[39m    \u001b[38;2;102;102;102m.; python3 -I /tmp/mjtest/bench.py ./mj .; python3 check.py --tokens 64 --prompts 3 -- ./mj\r\u001b[2B\u001b[38;2;215;119;87m\u2733\u001b[39m \u001b[38;2;245;149;117mHatching\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(10m 2s \u00b7 \u2193\u001b[39m \u001b"]
