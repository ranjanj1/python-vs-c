[296.535, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gi,\u001b[15Gwant\u001b[20Gin\u001b[23Genumerate(pr['pieces']):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mgot\u001b[16G=\u001b[18Gask(f'PIECE\u001b[30G{seq[i]}\u001b[39G{seq[i+1]}')\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G  if got != want: print('PIECE mismatch', i, got, want);\u001b[67Gbad\u001b[71G+=\u001b[74G1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  r = ask('FIXED ' + ' '.join(map(str,\u001b[45Gseq)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mam\u001b[11G=\u001b[13Glist(map(int,\u001b[27Gr.split()[2:]))\r\u001b[1B \u001b[2m\u2502\u001b[22m     np_ = len(seq)\u001b[23G-\u001b[25Glen(pr['ids'])\r\u001b[1B \u001b[2m\u2502\u001b[22m     if am[np_-1:-1] != pr['ids']:\u001b[38Gprint('FIXED\u001b[51Gmismatch');\u001b[63Gbad\u001b[67G+=\u001b[70G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('raw bytes', ask('PIECE 5 3'), ask('PIECE 5 13'), ask('PIECE 5 259'), ask('PIECE\u001b[91G1\u001b[93G29871'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6Gpipelined commands (several lines written at once)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('ENCODE a\\nENCODE b\\nGENERATE 0 hi\\nGENERATE 3\\n');\u001b[70Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor _ in\u001b[13Grange(8):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  l = rd(); print(l)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[2"]
[296.536, "2m  if l.startswith('DONE') and\u001b[36G'hi'\u001b[41Gnot\u001b[45Gin\u001b[48Gl\u001b[50Gand\u001b[54G_\u001b[56G>\u001b[58G3:\u001b[61Gbreak\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt\u001b[6G= time.time(); p.stdin.write('GENERATE 200 Once upon a time\\n');\u001b[71Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mn\u001b[6G= 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwhile True:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  l = rd()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  if l.startswith('DONE'):\u001b[33Gprint(l);\u001b[43Gbreak\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mn\u001b[10G+=\u001b[13G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m dt = time.time() - t;\u001b[26Gprint(f'{n}\u001b[38Gtokens\u001b[45Gin\u001b[48G{dt:.2f}s\u001b[58G=\u001b[60G{n/dt:.1f}\u001b[71Gtok/s')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt\u001b[6G=\u001b[8Gtime.time();\u001b[21Gr\u001b[23G=\u001b[25Gask('FIXED\u001b[36G'\u001b[38G+\u001b[40G'\u001b[42G'.join(['1']\u001b[55G+\u001b[57G['300']\u001b[65G*\u001b[67G1100));\u001b[75Gprint(r[:20],\u001b[89Gf'{time.time()-t:.1f}s')\r\u001b[1B \u001b[2m\u2502\u001b[22m t = time.time(); p.stdin.write('GENERATE 2000 Once upo\u001b[60Ga time\\n');\u001b[72Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mn\u001b[6G=\u001b[8G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m while True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22ml\u001b[10G=\u001b[12Grd()\r\u001b[1B \u001b[2m\u2502\u001b[22m     if l.start\u001b[19Gwith('DONE')"]
[296.537, ":\u001b[33Gp\u001b[35Gint(l); break\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mn\u001b[10G+=\u001b[13G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print(n, f'{time.time()-t:.1f}s')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('QUIT\\n');\u001b[29Gp.stdin.flush();\u001b[46Gprint('exit',\u001b[60Gp.wait(),\u001b[70G'bad',\u001b[77Gbad)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[8G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15G/tmp/mjtest/t.py\u001b[32G/Users/agentlab/pvc/mj\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;10"]
