[624.483, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m  89 \u001b[22m     while i < d:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  90 \u001b[22m         xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  91 \u001b[22m         i += 1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mShell quoting issue (zsh doesn't word-split); retrying.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults\u001b[11Glook\u001b[16Gnoisy\u001b[22G(R=2\u001b[27Gruns\u001b[32Gdisagree),\u001b[43Gso\u001b[46GI'm\u001b[50Gre-running\u001b[61Gthe\u001b[65Gcandidates\u001b[76Ginterleaved,\u001b[89Gseveral\u001b[97Gtimes\u001b[103Geach.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mR=2\u001b[7Grows\u001b[12G\u00d7\u001b[14G32-wide\u001b[22GSIMD\u001b[27Gis\u001b[30Gconsistently\u001b[43Gbest\u001b[48G(~118\u001b[54Gtok/s,\u001b[61Gup\u001b[64Gfrom\u001b[69G~87).\u001b[75GOne\u001b[79Gmore\u001b[84Gexperiment:\u001b[96Gsoftware\u001b[105Gprefetch.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan"]
[624.486, " \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefetch\u001b[12Ggives\u001b[18Gnothing,\u001b[27Gso\u001b[30GI'm\u001b[34Gkeeping\u001b[42Gthe\u001b[46Gplain\u001b[52Gloop\u001b[57Gat\u001b[60GR=2,\u001b[65GW=32.\u001b[71GThroughput\u001b[82Gdrops\u001b[88Gat\u001b[91Glong\u001b[96Gcontext\u001b[104G(FIXED\u001b[111G1024\r\u001b[1B \u001b[3Gaveraged\u001b[12G~68 tok/s\u001b[22Gvs ~118\u001b[30Gat \u001b[34Ghort), so the\u001b[48Gattenti\u001b[56Gn loops\u001b[64Ga\u001b[66Ge next.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102mead \u001b[1m1\u001b[22m fi\u001b[13Ge, ran \u001b[1m1\u001b[22m \u001b[23Ghell command \r\u001b[2C\u001b[2B\u001b[39mI'm addin\u001b[13G a head-s\u001b[23Gze-specializ\u001b[36Gd attention path f\u001b[55Gr\u001b[57GHS=64 that keeps q and \u001b[81Ghe \u001b[85Gutpu\u001b[91Gaccumula\u001b[100Gor in SIM\u001b[111Gregisters,\r\u001b[2C\u001b[1Bplus a vectorized softmax,\u001b[30Gwith the generic p\u001b[50Gh kept as fallback.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(mj.mojo)\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
