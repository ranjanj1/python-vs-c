[371.455, "\u001b[H\u001b[9G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m3\u001b[25G\u001b[38;2;51;51;51m2\u001b[31G2\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m4\u001b[25G\u001b[38;2;51;51;51m3\u001b[31G3\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m5\u001b[24G\u001b[38;2;51;51;51mj += 1                   \u001b[50G \u001b[52G  \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m6\u001b[20G\u001b[38;2;51;51;51mxout[unsafe_offset=i]\u001b[42G=\u001b[44Gs0\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m7\u001b[40G\u001b[38;2;51;51;51m + 1] =\u001b[48Gs1\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m8\u001b[43G\u001b[38;2;51;51;51m2\u001b[49G2\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m9\u001b[43G\u001b[38;2;51;51;51m3\u001b[49G3\r\u001b[6C\u001b[1B\u001b[38;2;207;34;46m100\u001b[20G\u001b[38;2;51;51;51mi += 4              \u001b[41G \u001b[43G  \u001b[46G \u001b[48G  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m  78 +\u001b[38;2;51;51;51m        while j + \u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m <= n:                                                                             \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[20G\u001b[38;2;51;51;51m    var\u001b[28Gxv = x.unsafe_offset(j).unsafe_load[width=\u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m]()\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m80\u001b[24G\u001b[38;2;51;51;51mcomptime\u001b[33Gfor r in rang\u001b[47G(R):                       \r\u001b["]
[371.455, "8C\u001b[1B\u001b[38;2;36;138;61m1\u001b[12G\u001b[38;2;51;51;51m\u001b[48;2;178;255;178m                acc[r]\u001b[48;2;220;255;220m =\u001b[37G\u001b[48;2;178;255;178mrb\u001b[48;2;220;255;220m.uns\u001b[44Gfe_offset(\u001b[48;2;178;255;178mr * n + \u001b[48;2;220;255;220mj).unsafe_load[width=\u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m]().fma(xv,\u001b[96G\u001b[48;2;178;255;178macc[r]\u001b[48;2;220;255;220m)\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m2\u001b[12G\u001b[38;2;51;51;51m            j += W    \u001b[35G \u001b[37G                                                          \u001b[96G       \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\u001b[20G\u001b[38;2;51;51;51mcomptime\u001b[29Gfor\u001b[33Gr\u001b[35Gin\u001b[38Grange(R):\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m4\u001b[20G\u001b[38;2;51;51;51m    var s = acc[r].reduce_add()\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[24G\u001b[38;2;51;51;51mfo\u001b[28Gjj in range(j, n):     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[24G\u001b[38;2;51;51;51m   \u001b[28Gs += rb[unsafe_offset=r\u001b[52G*\u001b[54Gn\u001b[56G+\u001b[58Gjj]\u001b[62G*\u001b[64Gx[unsafe_offset=jj]\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[24G\u001b[38;2;51;51;51mxout[unsafe_offset=i + r] =\u001b[52Gs\u001b[54G \u001b[56G \u001b[58G   \u001b[62G \u001b[64G                   \r\u001b[8C\u001b[1B\u001b[38;2;36;13"]
[371.456, "8;61m8\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G+= R                  \u001b[45G \u001b[47G  \u001b[50G \u001b[52G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  89 \u001b[22m     while i < d:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m90\u001b[16G\u001b[22m    xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)\r\u001b[8C\u001b[1B\u001b[2m1\u001b[20G\u001b[22mi += 1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mShell\u001b[9Gquoting\u001b[17Gissue\u001b[23G(zsh\u001b[28Gdoesn't\u001b[36Gword-split);\u001b[49Gretrying.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u001b[38;2;102;102;102m \u00b7 3s\u001b[39m\u2026\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102m \u23bf  $ mojo build mj.mojo\u001b[27G-o mj 2>&1 | grep -i error; for R W in 4 16 8 8 8 16 4 32 2 32; do sed -e \"s/^comptime MM_ROWS\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m=\u001b[8G4/c\u001b[12Gmpt\u001b[16Gme\u001b[19GMM_ROWS\u001b[27G= $R/\" -e \"s/^compt\u001b[47Gm\u001b[49G MM_W\u001b[55G= 16/comptime MM_W = $W/\" mj.mojo >\u001b[91G/tmp/mjt\u001b[100Gst/v.m\u001b[107Gjo && mojo \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mbuild /tmp/mjtest/v.mojo -o\u001b[34G/tmp/mjtest/v_${R}\u001b[53G${W"]
[371.456, "} 2>&1 | gr\u001b[68Gp -i erro\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
