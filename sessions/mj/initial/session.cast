[451.942, "\u001b[H\u001b[9G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m2\u001b[25G\u001b[38;2;51;51;51m1\u001b[31G1\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m3\u001b[25G\u001b[38;2;51;51;51m2\u001b[31G2\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m4\u001b[24G\u001b[38;2;51;51;51ms3 += r3[unsafe_offset=j]\u001b[50G*\u001b[52Gxs\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m5\u001b[20G\u001b[38;2;51;51;51m    j += 1           \u001b[42G \u001b[44G  \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m6\u001b[40G\u001b[38;2;51;51;51m] = s0 \u001b[48G  \r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m7\u001b[43G\u001b[38;2;51;51;51m1\u001b[49G1\r\u001b[8C\u001b[1B\u001b[38;2;207;34;46m8\u001b[43G\u001b[38;2;51;51;51m2\u001b[49G2\r\u001b[6C\u001b[1B\u001b[38;2;207;34;46m 99\u001b[20G\u001b[38;2;51;51;51mxout[unsafe_offset=i\u001b[41G+\u001b[43G3]\u001b[46G=\u001b[48Gs3\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 100 -\u001b[38;2;51;51;51m        i += 4                                                                                        \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m8\u001b[20G\u001b[38;2;51;51;51mwhile j\u001b[28G+ \u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m <= n:                                     \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m79\u001b[24G\u001b[38;2;51;51;51mvar xv =\u001b[33Gx.unsafe_offs\u001b[47Gt(j).unsafe_load[width=\u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m]()\r\u001b["]
[451.942, "8C\u001b[1B\u001b[38;2;36;138;61m0\u001b[12G\u001b[38;2;51;51;51m            comptime for\u001b[37Gr in r\u001b[44Gnge(R):                                            \u001b[96G       \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m1\u001b[12G\u001b[38;2;51;51;51m\u001b[48;2;178;255;178m                acc[r]\u001b[35G\u001b[48;2;220;255;220m=\u001b[37G\u001b[48;2;178;255;178mrb\u001b[48;2;220;255;220m.unsafe_offset(\u001b[48;2;178;255;178mr * n + \u001b[48;2;220;255;220mj).unsafe_load[width=\u001b[48;2;178;255;178mW\u001b[48;2;220;255;220m]().fma(xv,\u001b[96G\u001b[48;2;178;255;178macc[r]\u001b[48;2;220;255;220m)\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m2\u001b[20G\u001b[38;2;51;51;51m    j +=\u001b[29GW  \u001b[33G \u001b[35G  \u001b[38G         \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m3\u001b[20G\u001b[38;2;51;51;51mcomptime for r in range(R):    \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m4\u001b[24G\u001b[38;2;51;51;51mva\u001b[28Gs = acc[r].reduce_add()\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[24G\u001b[38;2;51;51;51mfor\u001b[28Gjj in range(j, n):     \u001b[52G \u001b[54G \u001b[56G \u001b[58G   \u001b[62G \u001b[64G                   \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[24G\u001b[38;2;51;51;51m    s += rb[unsafe_offset=r\u001b[52G*\u001b[54Gn\u001b[56G+\u001b[58Gjj]\u001b[62G*\u001b[64Gx[unsafe_offset=jj]\r\u001b[8C\u001b[1B\u001b[38;2;36;13"]
