[112.244, "[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gf\u001b[14G=\u001b[16Gopen(String(args[1]),\u001b[38G\"r\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gbuf\u001b[16G=\u001b[18Galloc[UInt8]({count\u001b[38G=\u001b[40G16}).unsafe_leak()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gn\u001b[14G=\u001b[16Gf.read(Span(unsafe_ptr=buf,\u001b[44Glength=16))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(n,\u001b[17Gbuf[unsafe_offset=0])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gfd\u001b[15G=\u001b[17GRawFileDescriptor(0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gm\u001b[14G=\u001b[16Gfd.read_bytes(Span(unsafe_ptr=buf,\u001b[51Glength=16))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(\"read\",\u001b[22Gm,\u001b[25Gflush=True)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmojo\u001b[9Gbuild\u001b[15Gp.mojo\u001b[22G-o\u001b[25Gp\u001b[27G2>&1\u001b[32G|\u001b[34Ghead\u001b[39G-40\u001b[43G&&\u001b[46Gecho\u001b[51Ghi\u001b[54G|\u001b[56G./p\u001b[60Gp.mojo\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
