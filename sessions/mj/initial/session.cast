[280.907, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProbe compiled cleanly, so\u001b[30Gthe Moj\u001b[38G 1.2 pointer/SIMD/IO\u001b[59GAPIs\u001b[64Gwork\u001b[69Gas\u001b[72Gexpected.\u001b[82GNext,\u001b[88Ga\u001b[90Gcouple\u001b[97Gof\u001b[100Gtokenizer\u001b[110Gedge-case\r\u001b[2C\u001b[1Bchecks\u001b[10Gbefore\u001b[17Gwriting\u001b[25Gthe\u001b[29Gfull\u001b[34Gprogram.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMojo's float32 \u001b[38;2;87;105;247m**\u001b[39m is less accurate than C \u001b[38;2;87;105;247mpowf\u001b[39m, so I'll compute the 32 RoPE\u001b[79Gfrequency\u001b[89Gconstants\u001b[99Gin\u001b[102Gfloat64\u001b[110Gand\u001b[114Ground\r\u001b[2C\u001b[1Bto\u001b[6Gfloat32, then write the full program.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(mj.mojo)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m774\u001b[22m lines to \u001b[1mmj.mojo\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m# MJ: llama2.c (reference/\u001b[37Gun.c) inferenc\u001b[52G in Mojo 1.2.0, standard library only.\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m# Single-threaded, float32 weights and activations, batch size 1.\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10"]
[280.908, "G\u001b[22m# Speaks the line protocol in INTERFACE.md on stdin/stdout.\r\u001b[6C\u001b[1B\u001b[2m 4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mfrom std.memory.alloc import alloc, Layout\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22mfrom std.sys import argv\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mfrom std.math import exp, cos, sin, sqrt, log\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell co\u001b[18Gmands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing the remaining few by hand,\u001b[37Gplus\u001b[42Gthe\u001b[46G\u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell\u001b[15Gcomma\u001b[21Gds\u001b[24G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes\u001b[22G(max\u001b[27Glogit\u001b[33Gerror\u001b[39G~1.8e-5\u001b[47Gvs\u001b[50Gt"]
[280.909, "olerance\u001b[60G5e-4).\u001b[67GRunning\u001b[75Gthe\u001b[79Gfull\u001b[84Gcheck\u001b[90Gover\u001b[95Gall\u001b[99Gprompts\u001b[107Gand\u001b[111G64\u001b[114Gtokens:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[38;3H"]
