[268.995, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[39m Probe compiled cleanly, so the Mojo 1.2 pointer/SIMD/IO APIs work as expected. Next,\u001b[88Ga\u001b[90Gcouple\u001b[97Gof\u001b[100Gtokenizer\u001b[110Gedge-case\r\u001b[1C\u001b[1B checks before writing the\u001b[29Gfull\u001b[34Gprogram.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Mojo's float32 \u001b[38;2;87;105;247m**\u001b[39m is less \u001b[30Gccurate \u001b[39Ghan C \u001b[38;2;87;105;247mpowf\u001b[39m, so\u001b[54GI'll compute th\u001b[70G 32 RoPE frequency constants\u001b[99Gin float64 and round\r\u001b[1C\u001b[1B to float32, then write th\u001b[29G full program.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mWrite\u001b[22m(mj.mojo)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m774\u001b[22m lines to \u001b[1mmj.mojo\u001b[22m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m# MJ: llama2.c (reference/run.c) inference in Mojo 1.2.0, standard library only.\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m# Single-threaded, float32 weights and activations, batch size 1.\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m# Speaks th"]
[268.997, "e line protocol in INTERFACE.md on stdin/stdout.\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  4 \u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mfrom std.memory.alloc import alloc, Layout\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mfrom std.sys import argv\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\u001b[63G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22mfrom std.math import exp, cos, sin, sqrt, log\u001b[56G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[12G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Fixing\u001b[10Gthe\u001b[14Gremaining\u001b[24Gfew\u001b[28Gby\u001b[31Ghand,\u001b[37Gplus\u001b[42Gthe\u001b[46G\u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Applying fixes and rebuilding\u001b[K\r\u001b[1"]
