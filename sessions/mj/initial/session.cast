[328.219, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m774\u001b[22m lines to \u001b[1mmj.mojo\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[12G\u001b[22mMJ: llama2.c (referen\u001b[34Ge/ru\u001b[39G.c) inference\u001b[53Gi\u001b[56GMojo 1.2.0, standard library only.\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m# Single-threaded, float32 weights and activations, batch size 1.\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22m# Speaks the line protocol in INTERFACE.md on stdin/stdout.\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[19G\u001b[22mmemory.allo\u001b[31G \u001b[33Gmp\u001b[37Gt alloc, Layout\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[19G\u001b[22msys import argv\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\r\u001b[6C\u001b[1B\u001b[2m 8\u001b[10G\u001b[22mfrom std.ma\u001b[22Gh\u001b[24Gimp\u001b[28Grt \u001b[32Gxp, cos, sin, sqrt, log\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m\u2026 +764 \u001b[14Gines \u001b[39m\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell com"]
[328.22, "mands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing the remaining few\u001b[28Gby\u001b[31Ghand,\u001b[37Gplus\u001b[42Gthe\u001b[46G\u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes (max\u001b[27Glogit\u001b[33Gerror\u001b[39G~1.8e-5\u001b[47Gvs\u001b[50Gtolerance\u001b[60G5e-4).\u001b[67GRunning\u001b[75Gthe\u001b[79Gfull\u001b[84Gcheck\u001b[90Gover\u001b[95Gall\u001b[99Gprompts\u001b[107Gand\u001b[111G64\u001b[114Gtokens:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFull check passes. Now verifying\u001b[36Gcommands check.py\u001b[54Gdoesn't\u001b[62Gexercise\u001b[71G(PIECE,\u001b[79GFIXED,\u001b[86Gedge\u001b[91Gcases)\u001b[98Gand\u001b[102Gmeasuring\u001b[112Gspeed.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery fixture check passes and throughput is about\u001b[54G80\u001b[57Gtok/s,\u001b[64Gso\u001b[67Gthere's\u001b[75Gheadroom.\u001b[85GI'm\u001b[89Gchecking\u001b[98Gthe\u001b[102Ghardware\u001b[111Gand\u001b[115Gthen\r\u001b[2C\u001b[1Btuning the matmul kernel.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1"]
