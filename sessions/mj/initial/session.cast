[625.613, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 283 \u001b[22m             self.rope_cos[unsafe_offset=k] = cos(val)\r\u001b[1B\u001b[2m 284 \u001b[22m             self.rope_sin[unsafe_offset=k] = sin(val)\r\u001b[1B\u001b[2m 285 \u001b[22m \r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 286 -\u001b[38;2;51;51;51m        var \u001b[48;2;255;199;199minv_sqrt_hs\u001b[48;2;255;220;220m = sqrt(Float32(head_size))                                                                \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 286 +\u001b[38;2;51;51;51m        var \u001b[48;2;178;255;178msqrt_hs\u001b[48;2;220;255;220m = sqrt(Float32(head_size))                                                                    \r\u001b[1B\u001b[49m\u001b[2m 287 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 288 \u001b[22m         for l in range(self.n_layers):\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 289 \u001b[22m      "]
