[678.9, "38;2;36;138;61m\u001b[48;2;220;255;220m 163 +\u001b[15G\u001b[38;2;51;51;51m   \u001b[19G    \u001b[24G \u001b[26G                  \u001b[45G \u001b[47G       \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 164 \u001b[22m def add_into(x: FPtr, y: FPtr, n: Int):\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 165 \u001b[22m     var j = 0\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 166 \u001b[22m     while j + VW <= n:\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Long-context throughput rose from 82.7 to 92.5 tok/s and the check still passes. The attention cost looks\u001b[K\r\u001b[1B  memory-bound, so I'm restructuring it to read each KV-cache row contiguously across all heads.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m \u001b[1mUpdate\u001b[22m(mj.mojo)\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;215;119;87mHatching\u2026 \u001b[38;2;102;102;102m(10m 43s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m42.1k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0Tip: Use /btw to ask a"]
