[268.639, "3GInt)\u001b[88G->\u001b[91GList[Int]:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      # C strings: the text ends at its first NUL byte\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m    \u001b[12Gvar\u001b[16Gtext_len\u001b[25G=\u001b[27G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      while start + text_len < len(line) and line[start\u001b[62G+\u001b[64Gtext_len]\u001b[74G!=\u001b[77G0:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          text_len += 1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      var text = balloc(text_len + 1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      for i in range(text_len):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m    \u001b[16Gtext[unsafe_offset=i]\u001b[38G=\u001b[40Gline[start\u001b[51G+\u001b[53Gi]\"\"\"),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m]\u001b[6G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor a,b in rep:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Ga\u001b[17Gin\u001b[20Gs,a;\u001b[25Gs=s.replace(a,b)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m open('mj.mojo','w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m grep -n \"\u001b[14G+ \\| - \" mj.mojo\u001b[31G| grep -i \"ptr\\|offs\\|buf\\b\"\u001b[60G| head;\u001b[68Gmojo\u001b[73Gbuild\u001b[79Gmj.mojo\u001b[87G-o\u001b[90Gmj\u001b[93G2>&1\u001b[98G|\u001b[100Ghead\u001b[105G-40\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
