[282.326, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[39m Probe compiled cleanly, so the\u001b[34GMojo\u001b[39G1.2\u001b[43Gpointer/SIMD/IO\u001b[59GAPIs\u001b[64Gwork\u001b[69Gas\u001b[72Gexpected.\u001b[82GNext,\u001b[88Ga\u001b[90Gcouple\u001b[97Gof\u001b[100Gtokenizer\u001b[110Gedge-case\r\u001b[2C\u001b[1Bchecks before writing the full program.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMojo's float32 \u001b[38;2;87;105;247m**\u001b[39m is less accurate than C \u001b[38;2;87;105;247mpowf\u001b[39m, so\u001b[54GI'll\u001b[59Gcompute\u001b[67Gthe\u001b[71G32\u001b[74GRoPE\u001b[79Gfrequency\u001b[89Gconstants\u001b[99Gin\u001b[102Gfloat64\u001b[110Gand\u001b[114Ground\r\u001b[2C\u001b[1Bto\u001b[6Gfloat32, then write the full\u001b[35Gprogram.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(mj.mojo)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m774\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mmj.mojo\r\u001b[6C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m 1\u001b[10G\u001b[22m# MJ: llama2.c (refer\u001b[32Gnce/run.c)\u001b[43Ginference in Mojo 1.2.0, standard library only.\r\u001b[5C\u001b[1B\u001b[2m  2 \u001b[22m# Single-threaded, float32 weights and activations, batch size 1.\r\u001b[5C\u001b[1"]
[282.328, "B\u001b[2m  3 \u001b[22m# Speaks the line protocol in INTERFACE.md on stdin/stdout.\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mfrom std.memory.alloc import alloc, Layout\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mfrom std.sys import argv\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22mfrom std.math import exp, cos, sin, sqrt, log\r\u001b[5C\u001b[1B\u001b[2m  9 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +764 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m sh\u001b[12Gll commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m Fixing the remaining few by hand, plus the \u001b[38;2;87;105;247mencode\u001b[39m origin error.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Quick check passes (max logit error ~1.8e-5 vs tolerance 5e-4). Runnin"]
[282.329, "g the full check over all prompts and 64 tokens:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running full validation check\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time python3 check.py --tokens 64 --prompts 3 -- ./mj\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[39m \u001b[38;2;215;119;87mHatching\u2026 \u001b[38;2;102;102;102m(4m 20s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m27.9k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G    \u001b[37G    \u001b[42G       \u001b[50G        \u001b[59G        \u001b[68G  \u001b[71G         \u001b[81G \u001b[83G  \u001b[86G    \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
