[683.541, "                                                        \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 174 \u001b[22m def attention_head[HS: Int](\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 175 \u001b[22m     q: FPtr, att: FPtr, kb: FPtr, vb: FPtr, stride: Int, npos: Int, xb: FPtr, sqrt_hs: Float32\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 176 \u001b[22m ):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Compa\u001b[9Ging\u001b[13Gposition-major vs per-head\u001b[40Gattention\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102ms=open('/Users/agentlab/pvc/mj/mj.mojo').read()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102ma=\"\"\" # multihead attention\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfor h in range(self.n_heads):\"\"\"\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mb=\"\"\" # multihead attention\u001b[34G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mvar kbase = self.key_cache.unsafe_offset(loff)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mvar vbase = self.value_cache.unsafe_offset(loff)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102"]
