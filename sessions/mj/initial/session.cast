[860.107, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat > /tmp/mjtest/ctx.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsubprocess,\u001b[23Gsys\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m d = sys.argv[1]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G=\u001b[8Gsubprocess.Popen([d\u001b[28G+\u001b[30G'/mj',\u001b[37Gd\u001b[39G+\u001b[41G'/model.bin',\u001b[55Gd\u001b[57G+\u001b[59G'/tokenizer.bin'],\u001b[78Gstdin=subprocess.PIPE,\r\u001b[1B \u001b[2m\u2502\u001b[22m stdout=\u001b[12Gubprocess.PIPE, text=Tru\u001b[37G,\u001b[39Gbufsize=1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m rd = lambda:\u001b[17Gp.stdout.readli\u001b[33Ge().rstrip('\\n')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert\u001b[11Grd()\u001b[16G==\u001b[19G'READY'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m text = 'the cat sat\u001b[24Gon\u001b[27Gthe\u001b[31Gmat\u001b[35Gand\u001b[39G'\u001b[41G*\u001b[43G125\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write(f'ENCODE\u001b[27G{text}\\n');\u001b[39Gp.stdin.flush();\u001b[56Gn\u001b[58G=\u001b[60Glen(rd().split())\u001b[78G-\u001b[80G1\r\u001b[1B \u001b[2m\u2502\u001b[22m p.stdin.write(f'GENERATE 5\u001b[31G0 {text}\\"]
[860.108, "n'); p.stdin.flush()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m c = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwhile\u001b[10GTrue:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     l = rd()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mif\u001b[11Gl.startswith('DONE'):\u001b[33Gbreak\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G c += 1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m pr\u001b[8Gt('prompt\u001b[18G, n, 'go\u001b[27G',\u001b[30Gc, l,\u001b[36G'expe\u001b[42Gted count', 1024 - n + 1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('QUIT\\n');\u001b[29Gp.stdin.flush();\u001b[46Gp.wait()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15G/tmp/mjtest/ctx.py\u001b[34G/Users/agentlab/pvc/mj\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gp"]
[860.109, "roceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mcat\u001b[22m and \u001b[1mpython3 -I /tmp/mjtest/ctx.py /Users/agentlab/pvc/mj\u001b[97G\u001b[22mcommands\u001b[106Gin\r\u001b[6C\u001b[1B\u001b[1m/Users/agentlab/pvc/mj\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
