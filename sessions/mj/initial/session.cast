[854.026, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPosition-major\u001b[18Gattention\u001b[28Gbrings\u001b[35GFIXED\u001b[41G1024\u001b[46Gto\u001b[49G~109\u001b[54Gtok/s\u001b[60G(from\u001b[66G93).\u001b[71GNow\u001b[75GI'll\u001b[80Gtidy\u001b[85Gthe\u001b[89Gdispatch\u001b[98Gand\u001b[102Gremove\u001b[109Gthe\r\u001b[2C\u001b[1Bsuperseded\u001b[14Gper-head\u001b[23Gkernel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck passes.\u001b[17GThat benchmark \u001b[33Gumber\u001b[39G(101.6\u001b[46Gvs\u001b[49G~109)\u001b[55Gcould\u001b[61Gbe\u001b[64Gnoise,\u001b[71Gso\u001b[74GI'm\u001b[78Grerunning\u001b[88Git\u001b[91Gand\u001b[95Galso\u001b[100Gtesting\u001b[108Gthe\u001b[112Ggeneric\r\u001b[2C\u001b[1Bfallback\u001b[12Gpath\u001b[17Gby\u001b[20Gforcing\u001b[28Git\u001b[31Gon.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth paths pass \u001b[20Gt about 120 tok/s\u001b[38Gshort-context and 110 tok/s \u001b[67Gt full\u001b[74Gcontext.\u001b[83GNext\u001b[88GI'll\u001b[93Gmeasure\u001b[101Gthis\u001b[106Gmachine's\r\u001b[2C\u001b[1Bsingle-core\u001b[15Gstreaming-read\u001b[30Gceiling\u001b[38Gto\u001b[41Gsee\u001b[45Ghow\u001b[49Gmuch\u001b[54Gheadroom\u001b"]
[854.027, "[63Gremains.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe streaming-read c\u001b[24Giling\u001b[30Gwo\u001b[33Gks\u001b[36Gout \u001b[41Go a\u001b[45Gout 141 tok/s, and\u001b[64Gat roughly 120 tok/s\u001b[85Gwe're\u001b[91Gnear\u001b[96G86%\u001b[100Gof\u001b[103Git,\u001b[107Gso\u001b[110GI'll\u001b[115Gstop\r\u001b[2C\u001b[1Btuning.\u001b[11GNext\u001b[16GI'll\u001b[21Gfree\u001b[26Gthe\u001b[30Gthree\u001b[36Gscratch\u001b[44Gbuffers\u001b[52Gthat\u001b[57G\u001b[38;2;87;105;247mencode\u001b[64G\u001b[39mleaks\u001b[70Gon\u001b[73Geach\u001b[78Gcall.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Free encode scratch buffers,\u001b[32Grebuild,\u001b[41Gretest\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp\u001b[8G'/Users/agentlab/pvc/mj/mj.mojo'\r\u001b[5C\u001b[1Bs=open(p).read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mrep=[(\u001b[13G\"\" tokens.append(self.lookup(sp, 1))\r\u001b[5C\u001b[1B\"\"\",\"\"\" tokens.append(self.lookup(sp, 1))\r\u001b[5C\u001b[1Bsp.unsafe_free()\r\u001b[5C\u001b[1B\"\u001b[9G),\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(\"\"\" str_l\u001b[17Gn = 0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m# merge the b\u001b[20Gst\"\"\",\"\"\" str_len = 0\r\u001b[5C\u001b[1Bsb.unsafe_free()\u001b[39"]
