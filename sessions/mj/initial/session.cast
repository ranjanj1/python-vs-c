[261.335, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m13\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m P\u001b[5Gobe compiled cleanly, so the\u001b[34GMojo\u001b[39G1.2\u001b[43Gpointer/SIMD/IO\u001b[59GAPIs\u001b[64Gwork\u001b[69Gas\u001b[72Gexpected.\u001b[82GNext,\u001b[88Ga\u001b[90Gcouple\u001b[97Gof\u001b[100Gtokenizer\u001b[110Gedge-case\r\u001b[1C\u001b[1B checks before\u001b[17Gwrit\u001b[22Gng\u001b[25Gthe full program.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Mojo's f\u001b[12Goat32 \u001b[38;2;87;105;247m**\u001b[21G\u001b[39mis\u001b[24Gless\u001b[29Gaccurate\u001b[38Gthan\u001b[43GC\u001b[45G\u001b[38;2;87;105;247mpowf\u001b[39m,\u001b[51Gso\u001b[54GI'll\u001b[59Gcompute\u001b[67Gthe\u001b[71G32\u001b[74GRoPE\u001b[79Gfrequency\u001b[89Gconstants\u001b[99Gin\u001b[102Gfloat64\u001b[110Gand\u001b[114Ground\r\u001b[1C\u001b[1B to\u001b[6Gfloat32, then w\u001b[22Gite the\u001b[30Gfull\u001b[35Gprogram.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mWrite\u001b[22m(mj.mojo)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m774\u001b[22m lines to \u001b[1mmj.mojo\r\u001b[1C\u001b[1B\u001b[22m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m#"]
[261.336, " MJ: llama2.c (reference/run.c) inference in Mojo 1.2.0, standard library only.\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m# Single-threaded, float32 weights and activations, batch size 1.\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m# Speaks the line protocol in INTERFACE.md on stdin/stdout.\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  4 \u001b[20G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mfrom std.memory.alloc import alloc, Layout\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mfrom std.sys import argv\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22mfrom std.math import exp, cos, sin, sqrt, log\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[16G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Rewriting pointer\u001b[21Gadditions\u001b[31Gto\u001b[34Gun"]
