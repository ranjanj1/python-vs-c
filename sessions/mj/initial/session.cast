[683.537, "\u001b[H\u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 156 +\u001b[38;2;51;51;51m            var qv = q.unsafe_offset(h * HS).unsafe_load[width=HS]()                                  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 157 +\u001b[38;2;51;51;51m            var kv = krow.unsafe_offset((h // kv_mul) * HS).unsafe_load[width=HS]()                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 158 +\u001b[38;2;51;51;51m            att[unsafe_offset=h * seq_len + t] = (qv * kv).reduce_add() / sqrt_hs                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 159 +\u001b[38;2;51;51;51m    for h in range(n_heads):                                                                          \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 160 +\u001b[38;2;51;51;51m        softmax(att.unsafe_offset(h * seq_len), npos)                                                 \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 161 +\u001b[38;2;51;51;51m        xb.unsafe_offset(h * HS).unsafe_store(SIMD[DType.float32, HS](0))                             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 162 +\u001b[38;2;51;51;51m    for t in range(npos):    "]
[683.538, "                                                                         \u001b[49m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 163 +\u001b[38;2;51;51;51m        var vrow = vb.unsafe_offset(t * kv_dim)                                                       \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m    \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 164 +\u001b[38;2;51;51;51m        for h in range(n_heads):                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m    \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 165 +\u001b[38;2;51;51;51m            var a = att[unsafe_offset=h * seq_len + t]                                                \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 166 +\u001b[38;2;51;51;51m            var o = xb.unsafe_offset(h * HS)                                                          \u001b[49m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 167 +\u001b[38;2;51;51;51m            o.unsafe_store(                                                                           \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m \u001b[4G  \u001b[38"]
