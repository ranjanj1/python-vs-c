[275.289, "(\"max\")\"\"\",\"\"\"\u001b[65Gvar\u001b[69Greason:\u001b[77GString\"\"\"),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m]\r\u001b[1B \u001b[2m\u2502\u001b[22m for a,b in rep:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Ga\u001b[17Gin\u001b[20Gs,a;\u001b[25Gs=s.replace(a,b)\r\u001b[1B \u001b[2m\u2502\u001b[22m o\u001b[6Gen('mj.mojo','w').wr\u001b[27Gte(s)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmojo build mj.mojo -o mj 2>&1\u001b[34G|\u001b[36Ghead\u001b[41G-40\u001b[45G&&\u001b[48Gtime\u001b[53Gpython3\u001b[61Gcheck.py\u001b[70G--\u001b[73G./mj\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis command requires approval\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't a"]
