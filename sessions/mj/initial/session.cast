[281.415, "\u001b[H\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m774\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mmj.mojo\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m# MJ: llama2.c (reference/run.c) inference in Mojo 1.2.0, standard library only.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m# Single-threaded, float32 weights and activations, batch size 1.\r\u001b[5C\u001b[1B\u001b[2m  3 \u001b[22m# Speaks the line protocol in INTERFACE.md on stdin/stdout.\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mfrom std.memory.alloc import alloc, Layout\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mfrom std.sys import argv\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mfrom std.math import exp, cos, sin, sqrt, log\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102"]
[281.415, "mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing the remaining few by hand, plus the \u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check\u001b[15Gpasses\u001b[22G(max\u001b[27Glogit\u001b[33Gerror\u001b[39G~1.8e-5\u001b[47Gvs\u001b[50Gtolerance\u001b[60G5e-4).\u001b[67GRunning\u001b[75Gthe\u001b[79Gfull\u001b[84Gcheck\u001b[90Gover\u001b[95Gall\u001b[99Gprompts\u001b[107Gand\u001b[111G64\u001b[114Gtokens:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time python3 check.py --tokens 64 --prompts 3 -- ./mj\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[281.416, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mRun full va\u001b[14Gidatio\u001b[21G check\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m time pyt\u001b[11Gon3\u001b[15Gcheck.py --tokens\u001b[33G64 --prompts 3 -- ./mj\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[281.416, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gtime\u001b[42Gpython3\u001b[50Gcheck.py\u001b[59G--tokens\u001b[68G64\u001b[71G--prompts\u001b[81G3\u001b[83G--\u001b[86G./mj\u001b[103G\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
