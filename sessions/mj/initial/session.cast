[919.138, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mFIXED:\u001b[12G\u001b[22mrunning\u001b[20Geach\u001b[25Gfixture\u001b[33Gsequence\u001b[42Greproduces\u001b[53Gthe\u001b[57Gexpected\u001b[66Gcontinuation\u001b[79Gtokens.\r\u001b[2C\u001b[1B- \u001b[1mSeveral commands sent at once:\u001b[22m all are answer\u001b[51Gd correctly.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mStopping:\u001b[22m \u001b[38;2;87;105;247mGENERATE 0\u001b[39m,\u001b[27Ga \u001b[38;2;87;105;247mstop\u001b[39m ending \u001b[42Gnd a \u001b[38;2;87;105;247mcontext\u001b[55G\u001b[39mending\u001b[62Gall\u001b[66Gbehave\u001b[73Glike\u001b[78Grun.c.\u001b[85GFor\u001b[89Gexample,\u001b[98Gan\u001b[101G877-token\u001b[111Gprompt\r\u001b[2C\u001b[1B \u001b[5Gyields\u001b[12Gexactly\u001b[20G1024\u001b[25G\u2212 877 +\u001b[33G1 = 148 new t\u001b[47Gkens.\u001b[53G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed\u001b[22m (one thread): about\u001b[29G120 tok/s at short context and about\u001b[66G110 tok/s averaged\u001b[85Gover a fu\u001b[95Gl 1024-positio\u001b[111Grun.\u001b[K\r\u001b[2C\u001b[1BReading the 438 MB of\u001b[25Gweights\u001b[33Gon this\u001b[41Gmachine caps\u001b[54Git\u001b[57Gat\u001b[60Gabout\u001b[66G141\u001b[70Gtok/s,\u001b[77Gso\u001b[80Gthe\u001b[84Gmain\u001b[89Gloops\u001b[95Greach\u001b[101Groughly\u001b[109G86%\u001b[113Gof\u001b[116Gthat\r\u001b[2C\u001b[1Blimit.\u001b[10GWhat\u001b[15Gmade\u001b[20Gthe\u001b[24Gdifference:\r\u001b[2C\u001b[1B- \u001b[1mMatrix multiply:\u001b[22m 2 r\u001b"]
[919.138, "[26Gws\u001b[29Gat a time\u001b[39Gwith 32-wide SIMD and explicit\u001b[70GFMA, chosen by\u001b[85Gbenchmarking several s\u001b[108Gzes. Software\r\u001b[2C\u001b[1B  prefetc\u001b[13G didn't help.\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mAttention:\u001b[22m reads the KV cach\u001b[34G in\u001b[38Gposition\u001b[47Gorder,\u001b[54Gcovering\u001b[63Gall\u001b[67Gheads\u001b[73Gper\u001b[77Grow,\u001b[82Gwhich\u001b[88Ggave\u001b[93Gabout\u001b[99G17%\u001b[103Gmore\u001b[108Gspeed\u001b[114Gat\u001b[117Glong\r\u001b[2C\u001b[1B \u001b[5Gcontext. The head size is a compile-\u001b[42Gime parameter for 16, 32, 64 and\u001b[75G128, with\u001b[85Ga general path fo\u001b[103G other \u001b[111Gizes. I\u001b[K\r\u001b[4C\u001b[1Bforc\u001b[10Gd that genera\u001b[24G path\u001b[30Gon\u001b[33Gand\u001b[37Git\u001b[40Galso\u001b[45Gpasses\u001b[52Gthe\u001b[56Gcheck.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmall deviations from run.c, all in NOTES.md:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoPE constants:\u001b[22m Mojo's fl\u001b[31Gat32 power function is less accurate\u001b[68Gthan\u001b[73GC's\u001b[77G\u001b[38;2;87;105;247mpowf\u001b[39m.\u001b[83GI\u001b[85Gcompute\u001b[93Gthose\u001b[99G32\u001b[102Gconstants\u001b[112Gin\r\u001b[4C\u001b[1Bfloat64\u001b[13Gand\u001b[17Ground\u001b[23Gto\u001b[26Gfloat32\u001b[34Gso\u001b[37Gthey\u001b[42Gmatch.\u001b[49GThe\u001b[53Gmain\u001b[58Gcomputation\u001b[70Gstays\u001b[76Gfloa"]
[919.139, "t32.\r\u001b[2C\u001b[1B- \u001b[1mRoPE cos/s\u001b[16Gn:\u001b[22m computed once per token instead\u001b[51Gof\u001b[54Gonce\u001b[59Gper\u001b[63Glayer.\u001b[70GThe\u001b[74Gvalues\u001b[81Gare\u001b[85Gidentical.\r\u001b[4C\u001b[1B\u001b[1mV\u001b[7Gcab lookup:\u001b[22m a\u001b[21Ghash tab\u001b[30Ge replaces the sorted binary\u001b[59Gsearch. The vocab\u001b[77Ghas no duplicate strings, so it returns\u001b[117Gthe\r\u001b[4C\u001b[1Bsame ids.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mKV ca\u001b[11Ghe:\u001b[22m not\u001b[19Gwiped between\u001b[33Gcommands.\u001b[43GEvery command restarts at position 0 and only reads cache\u001b[101Grows\u001b[106Git\u001b[109Ghas\u001b[113Gjust\r\u001b[2C\u001b[1B \u001b[5Gwritten, so the\u001b[21Gre\u001b[24Gul\u001b[27Gs are the same.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mstdin:\u001b[22m read\u001b[17Gthrough\u001b[25Gmy\u001b[28Gown\u001b[32Gline\u001b[37Gbuffer.\u001b[45GMojo's\u001b[52G\u001b[38;2;87;105;247minput()\u001b[60G\u001b[39mopens\u001b[66Ga\u001b[68Gnew\u001b[72Gbuffered\u001b[81Greader\u001b[88Gon\u001b[91Geach\u001b[96Gcall\u001b[101Gand\u001b[105Gcould\u001b[111Glose\u001b[116Glines\r\u001b[2C\u001b[1B \u001b[5Gwhen comma\u001b[16Gds\u001b[19Garrive tog\u001b[30Gther.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247m\u001b[1mexp\u001b[39m:\u001b[22m come\u001b[15G from\u001b[21GMojo's standard\u001b[37Glibrary\u001b[45Gand\u001b[49Gcan\u001b[53Gdiffer\u001b[60Gfrom\u001b[65GC's\u001b[69G\u001b[38;2;87;105;247"]
[919.14, "mexpf\u001b[74G\u001b[39min\u001b[77Gthe\u001b[81Glast\u001b[86Gbit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BOnly\u001b[10Gthis model's shape h\u001b[31Gs \u001b[34Gctually been run; other shapes\u001b[65Grely on the\u001b[77Ggener\u001b[83Gl code paths.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mFIXED\u001b[39m/\u001b[38;2;87;105;247mLOGITS\u001b[18G\u001b[39mwith\u001b[23Gmore\u001b[28Gthan\u001b[33G1024\u001b[38Gids\u001b[42Gprocess\u001b[50Gonly\u001b[55Gthe\u001b[59Gfirst\u001b[65G1024\u001b[70Gand\u001b[74Greport\u001b[81Gthat\u001b[86Gcount.\r\u001b[2C\u001b[1B- The weights\u001b[17Gare\u001b[21Gloaded\u001b[28Ginto\u001b[33Gmemory\u001b[40G(about\u001b[47G0.4\u001b[51GGB)\u001b[55Grather\u001b[62Gthan\u001b[67Gmemory-mapped.\r\u001b[4C\u001b[1BPassing the public check doesn't guarantee passing the final gate, which us\u001b[81Gs other input\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNO\u001b[6GES.md also\u001b[17Grecords the build and test commands.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCooked for 14m 38s \u00b7 done 5:13 PM\r\u001b[3B\u001b[39m\u276f\u00a0\r\u001b[21C\u001b[2B\u001b[38;2;102;102;102m? for shortcuts\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
