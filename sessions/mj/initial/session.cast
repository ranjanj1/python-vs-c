[356.974, "\u001b[71G(PIECE,\u001b[79GFIXED,\u001b[86Gedge\u001b[91Gcases)\u001b[98Gand\u001b[102Gmeasuring\u001b[112Gspeed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEvery\u001b[9Gfixture\u001b[17Gcheck\u001b[23Gpasses\u001b[30Gand\u001b[34Gthroughput\u001b[45Gis\u001b[48Gabout\u001b[54G80\u001b[57Gtok/s,\u001b[64Gso\u001b[67Gthere's\u001b[75Gheadroom.\u001b[85GI'm\u001b[89Gchecking\u001b[98Gthe\u001b[102Ghardware\u001b[111Gand\u001b[115Gthen\r\u001b[2C\u001b[1Btuning the matmul kernel.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDefault\u001b[11Gis\u001b[14Galready\u001b[22G-O3.\u001b[27GI'll\u001b[32Gmake\u001b[37Gthe\u001b[41Gmatmul\u001b[48Ggeneric\u001b[56Gover\u001b[61Grows-per-block\u001b[76Gand\u001b[80GSIMD\u001b[85Gwidth\u001b[91G(compile-time\u001b[105Gparameters)\u001b[117Gand\r\u001b[2C\u001b[1Bbenchmark a few configurations.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(mj.mojo)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[38;3H"]
