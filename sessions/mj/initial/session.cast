[628.099, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm adding a head-size-specialized attention path for HS=64 that keeps q and the output accumulator in SIMD registers,\r\u001b[2C\u001b[1Bplus a vectorized softmax, with the generic path kept as fallback.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(mj.mojo)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m14\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 318 \u001b[22m                 var qh = self.q.unsafe_offset(h * head_size)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 319 \u001b[22m                 var att = self.att.unsafe_offset(h * seq_len)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 320 \u001b[22m                 var hoff = loff + (h // kv_mul) * head_size\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m21\u001b[28G\u001b[38;2;51;51;51mvar kb = self.key_cache.unsafe_offset(hoff)\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 322 +\u001b[38;2;51;51;51m                var vb = self.value_cache.unsafe_offset(hoff)                                         \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 323"]
