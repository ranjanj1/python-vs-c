[918.478, "[1BReading the 438 MB of weights\u001b[33Gon this machine caps it at\u001b[67G41\u001b[75G, so th\u001b[83G main loops reach roughly 86% of\u001b[116Gthat\r\u001b[2C\u001b[1Blimit. What\u001b[15Gmade the difference:\u001b[36G\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mMatrix multiply:\u001b[22m 2\u001b[24Grows at a time\u001b[39Gwith\u001b[44G32-wide\u001b[52GSIMD\u001b[57Gand\u001b[61Gexplicit\u001b[70GFMA,\u001b[75Gchosen\u001b[82Gby\u001b[85Gbenchmarking\u001b[98Gseveral\u001b[106Gsizes.\u001b[113GSoftware\r\u001b[2C\u001b[1B \u001b[5Gprefetch didn't help.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttention:\u001b[22m reads the KV\u001b[29Gcache\u001b[35Gin\u001b[38Gposition\u001b[47Gorder,\u001b[54Gcovering\u001b[63Gall\u001b[67Gheads\u001b[73Gper\u001b[77Grow,\u001b[82Gwhich\u001b[88Ggave\u001b[93Gabout\u001b[99G17%\u001b[103Gmore\u001b[108Gspeed\u001b[114Gat\u001b[117Glong\r\u001b[2C\u001b[1B \u001b[5Gcontext. The head size is a compile-time pa\u001b[49Gameter fo\u001b[59G 16, 32, 64 and 128, wit\u001b[84G a general pa\u001b[98Gh for \u001b[105Gther sizes.\u001b[117GI\u001b[K\r\u001b[4C\u001b[1Bf\u001b[7Grc\u001b[10Gd that general path on\u001b[33Gand \u001b[38Gt also passes \u001b[53Ghe\u001b[56Gcheck.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSmall deviations from run.c, all in NOTES.md:\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mRoPE cons\u001b[15Gant\u001b[19G:\u001b[22m Mojo's float32 power function\u001b[51Gis"]
[918.48, "\u001b[54Gless\u001b[59Gaccurate\u001b[68Gthan\u001b[73GC's\u001b[77G\u001b[38;2;87;105;247mpowf\u001b[39m.\u001b[83GI\u001b[85Gcompute\u001b[93Gthose\u001b[99G32\u001b[102Gconstants\u001b[112Gin\r\u001b[2C\u001b[1B \u001b[5Gfloat64 and round t\u001b[25G float32 so th\u001b[40Gy\u001b[42Gmat\u001b[46Gh. The main comp\u001b[63Gt\u001b[66Gion stays float32.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoPE cos/sin:\u001b[22m computed \u001b[29Gnce per\u001b[38Goken instead of once per l\u001b[65Gyer.\u001b[70GThe values are\u001b[85Gidentical.\r\u001b[4C\u001b[1B\u001b[1mV\u001b[7Gcab lookup\u001b[19G\u001b[22ma hash table replaces the \u001b[46Gorted binary\u001b[59Gs\u001b[61Garch. The vocab ha\u001b[81Gno duplicate strings,\u001b[103Gso\u001b[106Git\u001b[109Greturns\u001b[117Gthe\r\u001b[2C\u001b[1B \u001b[5Gsame ids.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[15G\u001b[22mnot\u001b[19Gwiped\u001b[25Gbetween\u001b[33Gcommands.\u001b[43GEvery\u001b[49Gcommand\u001b[57Grestarts\u001b[66Gat\u001b[69Gposition\u001b[78G0\u001b[80Gand\u001b[84Gonly\u001b[89Greads\u001b[95Gcache\u001b[101Grows\u001b[106Git\u001b[109Ghas\u001b[113Gjust\r\u001b[2C\u001b[1B \u001b[5Gwritten, so \u001b[18Ghe r\u001b[23Gsults are\u001b[33Gthe same\u001b[43G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mstdin:\u001b[22m read\u001b[19Grough my own lin\u001b[37Gbuffer.\u001b[45GMojo's\u001b[52G\u001b[38;2;87;105;247minput()\u001b[60G\u001b[39mopens\u001b[66Ga\u001b[68Gnew\u001b[72Gbuffered\u001b[81Gre"]
