[597.465, "\u001b[H\u001b[9G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m7\u001b[24G\u001b[38;2;51;51;51mxout[unsafe_offset=i + r] =\u001b[52Gs\u001b[54G \u001b[56G \u001b[58G   \u001b[62G \u001b[64G                   \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G+= R                  \u001b[45G \u001b[47G  \u001b[50G \u001b[52G \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m  89 \u001b[22m     while i < d:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m90\u001b[16G\u001b[22m    xout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)\r\u001b[8C\u001b[1B\u001b[2m1\u001b[20G\u001b[22mi += 1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mShell\u001b[9Gquoting\u001b[17Gissue\u001b[23G(zsh\u001b[28Gdoesn't\u001b[36Gword-split);\u001b[49Gretrying.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults\u001b[11Glook\u001b[16Gnoisy\u001b[22G(R=2\u001b[27Gruns\u001b[32Gdisagree),\u001b[43Gso\u001b[46GI'm\u001b[50Gre-running\u001b[61Gthe\u001b[65Gcandidates\u001b[76Ginterleaved,\u001b[89Gseveral\u001b[97Gtimes\u001b[103Geach.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mR"]
[597.466, "=2\u001b[7Grows\u001b[12G\u00d7\u001b[14G32-wide\u001b[22GSIMD\u001b[27Gis\u001b[30Gconsistently\u001b[43Gbest\u001b[48G(~118\u001b[54Gtok/s,\u001b[61Gup\u001b[64Gfrom\u001b[69G~87).\u001b[75GOne\u001b[79Gmore\u001b[84Gexperiment:\u001b[96Gsoftware\u001b[105Gprefetch.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPrefetch\u001b[12Ggives\u001b[18Gnothing,\u001b[27Gso\u001b[30GI'm\u001b[34Gkeeping\u001b[42Gthe\u001b[46Gplain\u001b[52Gloop\u001b[57Gat\u001b[60GR=2,\u001b[65GW=32.\u001b[71GThroughput\u001b[82Gdrops\u001b[88Gat\u001b[91Glong\u001b[96Gcontext\u001b[104G(FIXED\u001b[111G1024\r\u001b[1B \u001b[3Gav\u001b[6Graged\u001b[12G~68 tok/s vs ~118\u001b[30Gat short), so the \u001b[49Gttention loops are next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mBenchmarking\u001b[16Glong-context\u001b[29GFIXED\u001b[35G1024\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1B  \u23bf  $ cat > /tmp/mjtest/bench2.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport subprocess, sys, time\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mexe, d\u001b[13G= sys.argv[1], sys.argv[2]\r\u001b[5C\u001b[1Bp = subprocess.Popen([exe, d + '/model.bin', d + '/tokenizer.bin'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, \r\u001b[5C\u001b[1Btext=Tr"]
[597.466, "ue, bufsize=1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert p.stdout.r\u001b[24Gadline().strip() == 'READY'\r\u001b[5C\u001b[1Bt = time\u001b[15Gtime()\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
