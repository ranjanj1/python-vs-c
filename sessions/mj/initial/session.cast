[285.36, "emory.alloc import alloc, Layout\r\u001b[7C\u001b[1B\u001b[2m6\u001b[19G\u001b[22msys import argv\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[19G\u001b[22mio.f\u001b[24Gle_desc\u001b[32Giptor import RawFileDescriptor\r\u001b[7C\u001b[1B\u001b[2m8\u001b[19G\u001b[22mmath import ex\u001b[34G, cos, sin, sqrt, log\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing\u001b[10Gthe\u001b[14Gremaining\u001b[24Gfew\u001b[28Gby\u001b[31Ghand,\u001b[37Gplus\u001b[42Gthe\u001b[46G\u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick\u001b[9Gcheck\u001b[15Gpasses\u001b[22G(max\u001b[27Glogit\u001b[33Gerror\u001b[39G~1.8e-5\u001b[47Gvs\u001b[50Gtolerance\u001b[60G5e-4).\u001b[67GRunning\u001b[75Gthe\u001b[79Gfull\u001b[84Gcheck\u001b[90Gover\u001b[95Gall\u001b[99Gprompts\u001b[107Gand\u001b[111G64\u001b[114Gtokens:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b"]
