[346.851, "\u001b[H     \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22mfrom std.\u001b[20Gemory.alloc impo\u001b[37Gt alloc, Layout\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22mfrom std.sys import argv\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mfrom std.io.file_descriptor import RawFileDescriptor\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22mfrom std.math import exp, cos, sin, sqrt, log\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22mcomptime FPtr = Pointer[Float32, MutUntrackedOrigin]\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +764 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFixing the remaining\u001b[24Gfew\u001b[28Gby\u001b[31Ghand,\u001b[37Gplus\u001b[42Gthe\u001b[46G\u001b[38;2;87;105;247mencode\u001b[53G\u001b[39morigin\u001b[60Gerror.\r\u001b[2C\u001b[4BQuick check passes (max logit error ~1.8e-5 vs tole\u001b[55Gance\u001b[60G5e-4)\u001b[67GRunning\u001b[75Gthe\u001b[79Gfull\u001b[84Gcheck\u001b[90Gover\u001b[95Gall\u001b[99Gprompts\u001b[107Gand\u001b[111G64\u001b[114Gtokens:\r\u001b[6C\u001b[2B\u001b[38;2;102;102;102m\u001b[1m1\u001b[2"]
[346.853, "2G\u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BF\u001b[5Gll check pas\u001b[18Ges.\u001b[22GNow verifying commands check.py doesn't exercise (PIECE,\u001b[79GFIXED, \u001b[87Gdge cases) and \u001b[103Gea\u001b[106Guring speed.\u001b[K\r\u001b[2C\u001b[4BEvery fixture check pass\u001b[28Gs and thr\u001b[38Gughput\u001b[45Gis about\u001b[54G80 tok/s, so th\u001b[70Gre's headroom. I'm checking\u001b[98Gthe\u001b[102Ghardware and then\r\u001b[2C\u001b[1Btuning\u001b[10Gthe\u001b[14Gmatmul\u001b[21Gkernel.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDefault is\u001b[14Galready -O3. I'll\u001b[32Gmake\u001b[37Gthe\u001b[41Gmatmul\u001b[48Ggeneric\u001b[56Gover\u001b[61Grows-per-block\u001b[76Gand\u001b[80GSIMD\u001b[85Gwidth\u001b[91G(compile-time\u001b[105Gparameters)\u001b[117Gand\r\u001b[2C\u001b[1Bbenchmark\u001b[13Ga\u001b[15Gfew\u001b[19Gconfigurations.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Reading \u001b[1m1\u001b[22m file\u2026\u001b[K\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
