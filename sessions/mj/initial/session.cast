[809.136, "load[width=32]()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22ma1\u001b[19G+=\u001b[22Gp.unsafe_offset(j\u001b[40G+\u001b[42G32).unsafe_load[width=32]()\r\u001b[1B \u001b[2m\u2502\u001b[22m     \u001b[9G       j += 64\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gto\u001b[15G += (a0 + a1).reduce_add()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mvar\u001b[16Gdt\u001b[19G=\u001b[21GFloat64(perf_counter_ns()\u001b[47G-\u001b[49Gt0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         if dt < best:\u001b[26Gbest\u001b[31G=\u001b[33Gdt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(\"GB/s\",\u001b[22GFloat64(n\u001b[32G*\u001b[34G4)\u001b[37G/\u001b[39Gbest,\u001b[45G\"ms\",\u001b[51Gbest\u001b[56G/\u001b[58G1e6,\u001b[63Gtot)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[8G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m mojo build\u001b[15G/\u001b[17Gmp/\u001b[21Gjtest/bw.mojo -o\u001b[38G/tmp/mjtest/bw 2>&1 | grep -iA5 error;\u001b[77G/tmp/mjtest/bw\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
