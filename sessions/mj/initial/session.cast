[607.052, "\u001b[H\u001b[9G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m6\u001b[24G\u001b[38;2;51;51;51m    s += rb[unsafe_offset=r\u001b[52G*\u001b[54Gn\u001b[56G+\u001b[58Gjj]\u001b[62G*\u001b[64Gx[unsafe_offset=jj]\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[20G\u001b[38;2;51;51;51m \u001b[22G  xout[unsafe_offset=i\u001b[45G+\u001b[47Gr]\u001b[50G=\u001b[52Gs\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m  88 +\u001b[38;2;51;51;51m        i += R                                                                                        \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m89\u001b[16G\u001b[22mwhile i < d:\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m0\u001b[20G\u001b[22mxout[unsafe_offset=i] = dot(w.unsafe_offset(i * n), x, n)\r\u001b[5C\u001b[1B\u001b[2m  91 \u001b[22m         i += 1\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mShell\u001b[9Gquoting\u001b[17Gissue\u001b[23G(zsh\u001b[28Gdoesn't\u001b[36Gword-split);\u001b[49Gretrying.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults\u001b[11Glook\u001b[16Gnoisy\u001b[22G(R=2\u001b[27Gruns\u001b[32Gdisagree),\u001b[43Gso\u001b[46GI'm\u001b[50Gre-running\u001b[61Gthe\u001b[65Gcandidates\u001b[76Ginterleaved,\u001b[8"]
[607.053, "9Gseveral\u001b[97Gtimes\u001b[103Geach.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mR=2\u001b[7Grows\u001b[12G\u00d7\u001b[14G32-wide\u001b[22GSIMD\u001b[27Gis\u001b[30Gconsistently\u001b[43Gbest\u001b[48G(~118\u001b[54Gtok/s,\u001b[61Gup\u001b[64Gfrom\u001b[69G~87).\u001b[75GOne\u001b[79Gmore\u001b[84Gexperiment:\u001b[96Gsoftware\u001b[105Gprefetch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPr\u001b[6Gfetch\u001b[12Ggives nothing, so\u001b[30GI'm keeping the pl\u001b[49Gin loop at R=2, W=32. Throughput\u001b[82Gdrops\u001b[88Gat\u001b[91Glong\u001b[96Gcontext\u001b[104G(FIXED\u001b[111G1024\r\u001b[2C\u001b[1Baveraged\u001b[12G~68\u001b[16Gtok/s\u001b[22Gvs\u001b[25G~118\u001b[30Gat\u001b[33Gshort),\u001b[41Gso\u001b[44Gthe\u001b[48Gattention\u001b[58Gloops\u001b[64Gare\u001b[68Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmarking long-context FIXED 1024\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/mjtest/bench2.py <<'EOF'\r\u001b[5C\u001b[1Bimport\u001b[13Gsubprocess, sys, time\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mexe, d = sys.argv[1], sys.argv[2]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp = subprocess."]
[607.053, "Popen([exe, d + '/model.bin', d + '/tokenizer.bin'], stdin=subprocess.PIPE, stdout=subprocess.PIPE, \r\u001b[5C\u001b[1Btext=True, bufsiz\u001b[24G=1)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert p\u001b[15Gstdout.readline().strip() == 'READY'\r\u001b[5C\u001b[1Bt = time.time()\u2026\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
