[678.918, "loat32, HS](a), o.unsafe_load[width=HS]())                           \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 171 +\u001b[38;2;51;51;51m            )                                                                                         \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 172 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 173 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m 174 \u001b[22m def attention_head[HS: Int](\u001b[41G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 175 \u001b[22m     q: FPtr, att: FPtr, kb: FPtr, vb: FPtr, stride: Int, npos: Int, xb: FPtr, sqrt_hs: Float32\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 176 \u001b[22m ):\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
