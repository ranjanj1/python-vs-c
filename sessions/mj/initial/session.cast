[873.579, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPosition-major attention brings FIXED 1024 to ~109 tok/s (from\u001b[66G93).\u001b[71GNow\u001b[75GI'll\u001b[80Gtidy\u001b[85Gthe\u001b[89Gdispatch\u001b[98Gand\u001b[102Gremove\u001b[109Gthe\r\u001b[2C\u001b[1Bsuperseded\u001b[14Gper-head\u001b[23Gkernel.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck passes. That benchmark\u001b[32Gnumber\u001b[39G(101.6\u001b[46Gvs\u001b[49G~109)\u001b[55Gcould\u001b[61Gbe\u001b[64Gnoise,\u001b[71Gso\u001b[74GI'm\u001b[78Grerunning\u001b[88Git\u001b[91Gand\u001b[95Galso\u001b[100Gtesting\u001b[108Gthe\u001b[112Ggeneric\r\u001b[2C\u001b[1Bfallback\u001b[12Gpath\u001b[17Gby\u001b[20Gforcing\u001b[28Git\u001b[31Gon.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth paths pass at about\u001b[28G120\u001b[32Gtok/s\u001b[38Gshort-context\u001b[52Gand\u001b[56G110\u001b[60Gtok/s\u001b[66Gat\u001b[69Gfull\u001b[74Gcontext.\u001b[83GNext\u001b[88GI'll\u001b[93Gmeasure\u001b[101Gthis\u001b[106Gmachine's\r\u001b[2C\u001b[1Bsingle-core\u001b[15Gstreaming-read\u001b[30Gceiling\u001b[38Gto\u001b[4"]
[873.58, "1Gsee\u001b[45Ghow\u001b[49Gmuch\u001b[54Gheadroom\u001b[63Gremains.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe streaming-read ceiling works out to about 141 tok/s, and\u001b[64Gat\u001b[67Groughly\u001b[75G120\u001b[79Gtok/s\u001b[85Gwe're\u001b[91Gnear\u001b[96G86%\u001b[100Gof\u001b[103Git,\u001b[107Gso\u001b[110GI'll\u001b[115Gstop\r\u001b[2C\u001b[1Btuning.\u001b[11GNext\u001b[16GI'll\u001b[21Gfree\u001b[26Gthe\u001b[30Gthree\u001b[36Gscratch\u001b[44Gbuffers\u001b[52Gthat\u001b[57G\u001b[38;2;87;105;247mencode\u001b[64G\u001b[39mleaks\u001b[70Gon\u001b[73Geach\u001b[78Gcall.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything still passes. One more edge\u001b[42Gcase,\u001b[48Gthe\u001b[52G\u001b[38;2;87;105;247mcontext\u001b[60G\u001b[39mstop:\u001b[66Ga\u001b[68Glong\u001b[73Gprompt\u001b[80Gnear\u001b[85Gseq_len=1024.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe \u001b[38;2;87;105;247mcontext\u001b[39m stop matches the reference loop exactly:\u001b[56G877\u001b[60Gprompt\u001b[67Gtokens\u001b[74G"]
[873.581, "give\u001b[79G1024\u001b[84G\u2212\u001b[86G877\u001b[90G+\u001b[92G1\u001b[94G=\u001b[96G148\u001b[100Gnew\u001b[104Gtokens.\u001b[112GA\u001b[114Gfinal\r\u001b[2C\u001b[1Bpass over the source, then NOTES.md.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[40;1H\u001b[38;3H"]
