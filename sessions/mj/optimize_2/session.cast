[3.573, "\u001b[H\u001b[5GLOGITS on the dev\u001b[23Glopment workload  \u001b[47G0\u001b[60G1\r\u001b[4C\u001b[2BFIXED,\u001b[12G1024 positions    \u001b[31G        \u001b[44G1\u001b[46G1 tok/s \u001b[57G121 tok/s \r\u001b[4C\u001b[2BTime to \u001b[38;2;87;105;247mREADY\u001b[39m        \u001b[44G0.069 s  \u001b[57G0.090 s  \r\u001b[2C\u001b[1B\u2514\u001b[42G\u2534\u001b[55G\u2534\u001b[68G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary\u001b[13Gbuffer\u001b[20Gand\u001b[24Grearranging\u001b[36Git\u001b[39Gfrom\u001b[44Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m, b\u001b[18Gyond ch\u001b[26Gck.py:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEarlier protocol tests:\u001b[29G\u001b[22mPIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[2C\u001b[1B  are unchanged.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mUnshared classifier\u001b[22m (the supplied model does\u001b[50G't\u001b[53Guse one):\u001b[63Ga temporary checkpoint bui\u001b[90Gt\u001b[92Gfor this gave bit-identical\u001b[K\r\u001b[4C\u001b[1Blogits and the"]
