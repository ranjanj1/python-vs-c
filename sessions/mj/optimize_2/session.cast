[56.014, "TS write costs\u001b[40G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/agentlab/pvc/mj;\u001b[31Gpython3\u001b[39G-I\u001b[42G-\u001b[44G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p='prof/in\u001b[15Gtrument.py'; s=open(p).read()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s=s.replace(\"\"\"ope\u001b[23G(dst, 'w').write(s)\"\"\",\"\"\"# time \u001b[57Grgmax (index 8, calls 9)\u001b[82Gand\u001b[86Gthe\u001b[90GLOGITS\u001b[97Gfile\u001b[102Gwrites\u001b[109G(index\u001b[116G10)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace(\"\u001b[23Gdef\u001b[27Gargmax(self)\u001b[40G->\u001b[43GInt:\\\\n\",\u001b[53G\"\u001b[58Gdef\u001b[62Gargmax(self)\u001b[75G->\u001b[78GInt:\\\\n\u001b[93Gvar\u001b[97G_tg\u001b[101G=\r\u001b[1B \u001b[2m\u2502\u001b[22m perf_counter_ns()\\\\n        var r\u001b[38G=\u001b[40Gself.argmax_()\\\\n\u001b[65Gself.prof[unsafe_offse"]
[56.015, "t=8]\u001b[92G+=\u001b[95GInt(perf_counter_ns()\u001b[117G-\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m_tg)\\\\n\u001b[19Gself.prof[unsafe_offset=9]\u001b[46G+=\u001b[49G1\\\\n\u001b[61Greturn\u001b[68Gr\\\\n\\\\n\u001b[79Gdef\u001b[83Gargmax_(self)\u001b[97G->\u001b[100GInt:\\\\n\",\u001b[110G1)\r\u001b[1B \u001b[2m\u2502\u001b[22m s = s.replace(\"                f.write_bytes(Span(unsafe_ptr=lb, length=model.vocab_size * 4))\", \"\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m var _tw = perf_counter_ns()\\\\n                f.write_bytes(Span(unsafe_ptr=lb, length=model.vocab_size * 4))\\\\n\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m            model.prof[unsafe_offset=10] += Int(perf_counter_ns() - _tw)\", 1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace('\u001b[31Gprint(\"PROF\u001b[43Gtokens\",\u001b[52Gntok,\u001b[58Gfile=RawFileDescriptor(2))',\u001b[87G'\u001b[100Gprint(\"PROF\u001b[112Gtokens\",\r\u001b[1B \u001b[2m\u2502\u001b[22m ntok, file=RawFil\u001b[22GDescriptor(2))\\\\n    \u001b[44G       print(\"PROF\u001b[63Gargmax us/call\", Float64(model\u001b[94Gprof[unsafe_offset=8]) /\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m Float64(max(model.prof[unsafe_offset=9],\u001b[45G1)) /\u001b[51G1e3, \"call\u001b[62G\", model.prof[unsafe_off\u001b[87Get=9],\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m file=RawFileDe"]
[56.016, "scriptor(2))\\\\n    \u001b[38G   \u001b[42G   print(\"PROF LOGITS w\u001b[66Gite ms total\", Float64(model.prof[uns\u001b[104Gfe_offset=10])\u001b[119G/\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m 1\u001b[6G6, file=RawFileDescriptor(2))', 1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ope\u001b[8G(dst,\u001b[14G'w').write(s)\"\"\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen(p,'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15Gprof/instrument.py\u001b[34Gmj.mojo\u001b[42G/tmp/mjprof/mj_prof.mojo\u001b[67G&&\u001b[70Gmojo\u001b[75Gbuild\u001b[81G/tmp/mjprof/mj_prof.mojo\u001b[106G-o\r\u001b[1B \u001b[2m\u2502\u001b[22m /tmp/mjprof/mj_prof 2>&1 | grep -iA6 error | head -20; python3 -I\u001b[70Gprof/work.py /tmp/mjprof/mj_prof . 2 2>&1 |\u001b[114Ggrep\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m -v \"^pid\"\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[56.016, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gcd\u001b[40G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
