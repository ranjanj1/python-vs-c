[67.206, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRemaining limitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe Mojo\u001b[14Gruntime starts 4 worker threads of its own\u001b[57Gwhen the p\u001b[68Gocess launches.\u001b[84GThey\u001b[89Gsat\u001b[93Gidle\u001b[98Gfor\u001b[102G100%\u001b[107Gof\u001b[110Gthe\r\u001b[2C\u001b[1B \u001b[5Gprof\u001b[10Gle; I left them alone because\u001b[40Gthe rules forbid setting thread counts.\r\u001b[4C\u001b[1BLoading n\u001b[15Gw briefly needs an \u001b[35Gxtra 98\u001b[43GMB buff\u001b[51Gr, fre\u001b[58Gd befor\u001b[66G \u001b[38;2;87;105;247mREADY\u001b[39m.\u001b[74G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GI\u001b[7Gonly\u001b[12Gprofiled\u001b[21Gphase\u001b[27Gby\u001b[30Gphase\u001b[36Gat\u001b[39Gthe\u001b[43Gshort\u001b[49Gdevelopment\u001b[61Gcontexts\u001b[70G(at\u001b[74Gmost\u001b[79G82\u001b[82Gpositions).\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md has the\u001b[20Gprofiling \u001b[31Gvidence, the changes, the te\u001b[60Gts and the limitations.\u001b[84GThe\u001b[88Gprofiling\u001b[98Gtools\u001b[104Gare\u001b[108Gin\u001b[111G\u001b[38;2;87;105;247mprof/\u001b[117G\u001b[39mso\r\u001b[2C\u001b[1Bthe\u001b[7Gmeasurements\u001b[20Gcan\u001b[24Gbe\u001b[27Grepeated;\u001b[37G\u001b[38;2;87;105;247mmj.mojo\u001b[45G\u001b[39mitself\u001b[52Gcontains\u001b[61Gno\u001b[64Gprofiling\u001b[74Gcode.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GWorked for 10m 31s \u00b7 done 5:24"]
