[751.408, "0.5 else Float32(r\u001b[55G-\u001b[57G2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22melse:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 v =\u001b[24GFloat32(r\u001b[34G*\u001b[36G30\u001b[39G-\u001b[41G15)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mbuf[unsafe_offset=i]\u001b[37G=\u001b[39Gv\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     if tri\u001b[19Gl % 11 == 0: buf[unsafe_offset=0] = \u001b[56Gan\u001b[59G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G  if trial % 13 == 0: buf[unsafe_offset=n - 1] =\u001b[60Gnf    # max in the tail\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         \u001b[13Gf trial % 17\u001b[26G== 0: buf[unsafe_offset=0]\u001b[53G= inf\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gargmax_vec(buf,\u001b[31Gn)\u001b[34G!=\u001b[37Gargmax_ref(buf,\u001b[53Gn):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             bad += 1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mif\u001b[19Gbad\u001b[23G<\u001b[25G5:\u001b[28Gprint(\"MISMATCH\u001b[44Gtrial\",\u001b[52Gtrial,\u001b[59G\"n\",\u001b[64Gn,\u001b[67Gargmax_vec(buf,\u001b[83Gn),\u001b[87Gargmax_ref(buf,\u001b[103Gn))\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G print(\"argmax t\u001b[24Gia\u001b[27Gs 20000, misma\u001b[42Gches\", bad)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m '''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('/tmp/mjprof/argmax_test.mojo','w').write(test)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2"]
