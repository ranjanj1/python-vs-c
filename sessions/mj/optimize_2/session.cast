[389.005, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping attention \u001b[24Ganges\u001b[30Gnothing, so\u001b[42Ginterleaved work isn't\u001b[65Gthe\u001b[69Gcause.\u001b[76GNext\u001b[81GI'll\u001b[86Gcheck\u001b[92Gwhether\u001b[100Gthe\u001b[104Ggap\u001b[108Gis\u001b[111Gjust\r\u001b[2C\u001b[1Bbest-of-N\u001b[13G(microbenchmark)\u001b[30Gversus\u001b[37Gmean\u001b[42G(in-program)\u001b[55Gtiming:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe microbe\u001b[15Gchmark matmul\u001b[29Gaverages 7.09 ms, close to\u001b[56Gthe program's 7.28\u20137.43 ms, so the leftover ~4%\u001b[104Ggap isn't a clear\r\u001b[2C\u001b[1Blever. I'm now\u001b[18Gtiming\u001b[25Graw write syscalls\u001b[44Gfor\u001b[48Gthe\u001b[52G460\u001b[56G\u00d7\u001b[58G128\u001b[62GKB\u001b[65GLOGITS\u001b[72Goutput\u001b[79Gat\u001b[82Gdifferent\u001b[92Gchunk\u001b[98Gsizes\u001b[104Gto\u001b[107Gsee\u001b[111Gwhether\r\u001b[2C\u001b[1Bbatching\u001b[12Gthose\u001b[18Gwrites\u001b[25Gwould\u001b[31Ghelp.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBatching the wr\u001b[19Gtes showed no cons\u001b[38Gsten\u001b[43G gain, so LOGITS\u001b[60Gst\u001b[63Gys \u001b[67Gs it is. Next\u001b[81GI'll\u001b[86Gv\u001b["]
[389.006, "88Gctoriz\u001b[95G argmax while\u001b[109Gkeeping\u001b[117Gthe\r\u001b[2C\u001b[1Bfirst-maximum\u001b[17Gtie-breaking,\u001b[31Gand\u001b[35Gswitch\u001b[42Gthe\u001b[46GKV\u001b[49Gcache\u001b[55Gto\u001b[58Ga\u001b[60Ghead-major\u001b[71Glayout\u001b[78Gso\u001b[81Geach\u001b[86Ghead's\u001b[93Gkeys\u001b[98Gand\u001b[102Gvalues\u001b[109Gsit\r\u001b[2C\u001b[1Bcontiguously.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck passes. I need an exact\u001b[33Gbaseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[2C\u001b[1Bby\u001b[6Gundoing\u001b[14Gthe\u001b[18Gsingle\u001b[25Gedit:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mHead-major KV shows no gain, possibly a loss, and the\u001b[57Gworkload numbers are noisy.\u001b[85GBefore\u001b[92Gdeciding,\u001b[102GI'll\u001b[107Gtime\u001b[112Gthe\r\u001b[2C\u001b[1Battention\u001b[13Gphase\u001b[19Gdirectly\u001b[28Gwith\u001b[33Gthe\u001b[37Ginstrumented\u001b[50Gbuilds\u001b[57Gat\u001b[60Gfull\u001b[65G1024\u001b[70Gcontext:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;"]
[389.007, "102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention is only about 1% at these lengths,\u001b[48Gso\u001b[51Greverting\u001b[61Gthe\u001b[65Ghead-major\u001b[76GKV\u001b[79Gchange\u001b[86Gkeeps\u001b[92Gthe\u001b[96Greference\u001b[106Glayout.\u001b[114GNext\r\u001b[2C\u001b[1BI'll run a matmul-only copy of the forward to see whether the small ops between matmuls cause the gap to 7.09 ms.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2736\u001b[3GWandering\u2026 \u001b[27G\u001b[38;2;102;102;102m9\u001b[29G7\u001b[41G\u001b[38;2;153;153;153mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
