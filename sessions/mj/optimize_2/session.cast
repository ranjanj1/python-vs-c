[867.969, "\u001b[H\r\u001b[31B\u001b[38;2;102;102;102m\u23fa\u001b[39m\u001b[40;1H\u001b[38;3H"]
[868.02, "\u001b[H\r\u001b[33B\u001b[38;2;171;43;63m\u2722\u001b[19G\u001b[38;2;102;102;102m10s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m39.9k tokens)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[868.068, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gshor\u001b[12G-context ker\u001b[25Gel is\u001b[31Gslower in the\u001b[45Greal\u001b[50Gprogram,\u001b[59Gso\u001b[62GI'm\u001b[66Greverting\u001b[76Git,\u001b[80Gand\u001b[84GI'll\u001b[89Gvectorize\u001b[99Gargmax\u001b[106Gnext,\u001b[112Gkeeping\r\u001b[2C\u001b[1Bits\u001b[7Gexact\u001b[13Gsemantics\u001b[23Gand\u001b[27GNaN\u001b[31Gbehaviour.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe argmax\u001b[14Gcheck passes, and\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[2C\u001b[1Binfinities\u001b[14Gand\u001b[18Godd\u001b[22Glengths.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero mismatches in\u001b[22G20,000 adversarial trials,\u001b[49Gso\u001b[52Gthe\u001b[56Gresult\u001b[63Gis\u001b[66Gthe\u001b[70Gsame\u001b[75Gas\u001b[78Grun.c's\u001b[86Gloop.\u001b[92GMeasuring\u001b[102Gthe\u001b[106Ggain\u001b[111Gwith\u001b[116Gthe\r\u001b[2C\u001b[1Binstrumented\u001b[16Gbuild\u001b[22Gand\u001b[26Gthe\u001b"]
