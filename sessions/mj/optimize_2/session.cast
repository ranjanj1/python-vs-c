[116.395, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[2B\u001b[49mStarting point: the forward pass is 7.42 ms/token against a mea\u001b[67Gur\u001b[70Gd\u001b[72Gstreami\u001b[80Gg\u001b[82Gfloor of ~7.0 ms, so\u001b[103Gwhat'\u001b[110Glef\u001b[115Gis\r\u001b[2C\u001b[1Bsmall. First I'll get the full\u001b[34Gend-to-end split (forward v\u001b[63Geverything else, such a\u001b[87G arg\u001b[92Gax, LOGITS file writes\u001b[115Gand\r\u001b[2C\u001b[1Bprotocol). Then I'll check whether the\u001b[42G62.5\u001b[47GGB/s \"ceiling\" is\u001b[65Greally\u001b[72Gfixed.\u001b[79GOne\u001b[83Ghypothesis\u001b[94Gis\u001b[97Gthat\u001b[102Ghardware\r\u001b[2C\u001b[1Bprefetchers\u001b[15Gstop\u001b[20Gat\u001b[23G16\u001b[26GKB\u001b[29Gpage\u001b[34Gboundaries,\u001b[46Gwhich\u001b"]
[116.396, "[52Gsoftware\u001b[61Gprefetch\u001b[70Gfar\u001b[74Genough\u001b[81Gahead,\u001b[88Gor\u001b[91Gnon-temporal\u001b[104Gloads,\u001b[111Gmight\u001b[117Gget\r\u001b[2C\u001b[1Baround.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMemory\u001b[10Gbandwidth\u001b[20Gis\u001b[23Gcapped\u001b[30Gnear\u001b[35G63\u001b[38GGB/s,\u001b[44Gand\u001b[48Gper-load\u001b[57Gtweaks\u001b[64Gdon't\u001b[70Ghelp.\u001b[76GI'm\u001b[80Gnext\u001b[85Ginstrumenting\u001b[99Gargmax\u001b[106Gand\u001b[110Gthe\u001b[114GLOGITS\r\u001b[1B \u001b[3Gwrites, since matmul runs slightly \u001b[39Glower in the\u001b[52Greal\u001b[57Gprogram\u001b[65Gthan\u001b[70Gin\u001b[73Gthe\u001b[77Gmicrobenchmark.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[9G\u001b[22mshell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mArgmax\u001b[10Gcosts\u001b[16Gabout\u001b[22G40\u001b[25G\u00b5s\u001b[28Gper\u001b[32Gtoken\u001b[38Gand\u001b[42GLOGITS\u001b[49Gwrites\u001b[56Gabout\u001b[62G60\u001b[65G\u00b5s\u001b[68Gper\u001b[72Gposition,\u001b[82Gboth\u001b[87Gsmall.\u001b[94GThe\u001b[98Greal\u001b[103Ggap\u001b[107Gis\u001b[110Gthat\r\u001b[1B  matmuls run at ~60 GB/s inside the program versus 62.7 GB/s in the microbenchmark, so I'm building a copy whose\u001b[K\r\u001b[1C\u001b[1B forward pass\u001b[16Gr"]
[116.397, "uns\u001b[21Gonly\u001b[26Gmatmuls\u001b[34Gto\u001b[37Gfind\u001b[42Gwhat\u001b[47Gslows\u001b[53Gthe\u001b[57Gstream.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[9G\u001b[22mshell commands\u001b[24G\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Skipping attention\u001b[22Gchang\u001b[28Gs nothing, so interleaved work isn't\u001b[65Gthe\u001b[69Gcause.\u001b[76GNext I'll check\u001b[92Gwhether the gap is just\u001b[K\r\u001b[1C\u001b[1B be\u001b[6Gt-of-N\u001b[13G(m\u001b[16Gcrobenchmark) versus mean\u001b[42G(in-program)\u001b[55Gtiming:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Reporting\u001b[13Gmicrobenchmark mean vs b\u001b[38Gst timings\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/mjprof && sed -e 's/ var best = Float64(1e18)/ var best = Float64(1e18)\\n var sum = Float64(0)/' -e 's/ \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mif dt < best: best = dt/ if dt < best: best = dt\\n sum += dt/' -e 's/ print(name, \"ms\", best \\/ 1e6, \"GB\\/s\", bytes\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m\\/ best)/ print(name, \"best ms\", best \\/ 1e6, \"mean ms\", sum \\/ 6e6, \u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;226;130;98mWandering\u2026\u001b[38;2;215;119;87m"]
