[612.287, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gis\u001b[16Gonly\u001b[21Gabout\u001b[27G1%\u001b[30Gat\u001b[33Gthese\u001b[39Glengths,\u001b[48Gso\u001b[51Greverting\u001b[61Gthe\u001b[65Ghead-major\u001b[76GKV\u001b[79Gchange\u001b[86Gkeeps\u001b[92Gthe\u001b[96Greference\u001b[106Glayout.\u001b[114GNext\r\u001b[1B \u001b[5Gll run a\u001b[14Gmatmul-only copy\u001b[31Gof the\u001b[38Gforward to see wheth\u001b[59Gr the small ops betw\u001b[80Gen matmuls cause \u001b[98Ghe gap\u001b[105Gto 7.09\u001b[113Gms.\u001b[117G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul-only\u001b[15Gruns\u001b[20Galready\u001b[28Gsit\u001b[32Gat\u001b[35Gthe\u001b[39Gmemory\u001b[46Gceiling,\u001b[55Gso\u001b[58Gthe\u001b[62G~0.18\u001b[68Gms\u001b[71Gof\u001b[74Gnon-matmul\u001b[85Gwork\u001b[90Gper\u001b[94Gposition\u001b[103Gleaves\u001b[110Gthe\u001b[114Gbus\r\u001b[1B \u001b[3Gidle. I'm checki\u001b[20Gg the prefetch API\u001b[39Gto s\u001b[44Ge\u001b[46Gwhether\u001b[54GI can str\u001b[64Gam\u001b[67Gthe next weight matrix into L2\u001b[98Gduring\u001b[106Ghat gap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm\u001b[7Gadding\u001b[14Ga\u001b[16Gprefetch_ahead\u001b[31Ghelper\u001b[38Gth"]
[612.288, "at\u001b[43Gissues\u001b[50Gone\u001b[54Gprefetch\u001b[63Gper\u001b[67G128-byte\u001b[76Gline,\u001b[82Gcalled\u001b[89Gat\u001b[92Gthe\u001b[96Gstart\u001b[102Gof\u001b[105Geach\u001b[110Gof\u001b[113Gthe\u001b[117Gfour\r\u001b[1B \u001b[3Gn\u001b[5Gn-matmul gaps\u001b[20Ger lay\u001b[27Gr, with the\u001b[39Gam\u001b[42Gun\u001b[45G left as a compile-time parameter for\u001b[83Gsweeping.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmachine\u001b[15Ggot\u001b[19Gnoisy\u001b[25Gmidway\u001b[32G(means\u001b[39Gjumped\u001b[46Gto\u001b[49G8\u201310\u001b[54Gms\u001b[57Gfor\u001b[61Gevery\u001b[67Gvariant).\u001b[77GChecking\u001b[86Gsystem\u001b[93Gload\u001b[98Gbefore\u001b[105Gtrusting\r\u001b[1B \u001b[3Ganything:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load from other processes is around 3 on this 4-P-core M1, so single runs can't be trusted. I'm switching\u001b[109Gto\u001b[112Gan\u001b[115GA/B\r\u001b[2C\u001b[1Bharness that alternates all variants in short fixed rounds and compares their medians and minima.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;"]
