[769.253, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gshort-context\u001b[21Gkernel\u001b[28Gis\u001b[31Gslower\u001b[38Gin\u001b[41Gthe\u001b[45Greal\u001b[50Gprogram,\u001b[59Gso\u001b[62GI'm\u001b[66Greverting\u001b[76Git,\u001b[80Gand\u001b[84GI'll\u001b[89Gvectorize\u001b[99Gargmax\u001b[106Gnext,\u001b[112Gkeeping\r\u001b[2C\u001b[1Bits exact semantics and\u001b[27GNaN\u001b[31Gbehaviour.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe argmax check passe\u001b[26G, and I'm now confirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[2C\u001b[1Binfinities\u001b[14Gand\u001b[18Godd\u001b[22Glengths.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero mi\u001b[11Gmatches in 20,000 adversarial trials, so the result is the\u001b[70Gsam\u001b[74G as\u001b[78Grun.c's loop. Measuring th\u001b[105G gain with\u001b[116Gthe\r\u001b[2C\u001b[1Binstrumented\u001b[16Gbuild an\u001b[26Gthe\u001b[30Ginterleaved\u001b[42GA/B:\u001b[47G\u001b[K\r\u001b[2B\u001b[38;2;102;102;10"]
[769.253, "2m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; cp /tmp/mjprof/argmax_test.mojo prof/; python3 -I prof/instrument.py mj.mojo \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m/tmp/mjprof/am_prof.mojo && mojo build /tmp/mjprof/am_prof.mojo -o /tmp/mjprof/am_prof 2>&1 | grep -i error; \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mpython3 -I prof/work.py /tmp/mjprof/am_prof . 1 2>&1 | grep -i \"argmax\\|GENERATE\"; c\u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mMeasure argmax time"]
