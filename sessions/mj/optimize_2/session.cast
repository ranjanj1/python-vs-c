[248.668, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[39m Skipping attention changes nothing, so interleaved work\u001b[59Gisn't\u001b[65Gthe\u001b[69Gcause.\u001b[76GNext\u001b[81GI'll\u001b[86Gcheck\u001b[92Gwhether\u001b[100Gthe\u001b[104Ggap\u001b[108Gis\u001b[111Gjust\r\u001b[2C\u001b[1Bbest-of-N (microbenchmark) versus mean (in-program)\u001b[55Gtiming:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m \u001b[10Ghell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe microbenchmark matmul\u001b[29Gaverages\u001b[38G7.09\u001b[43Gms,\u001b[47Gclose\u001b[53Gto\u001b[56Gthe\u001b[60Gprogram's\u001b[70G7.28\u20137.43\u001b[80Gms,\u001b[84Gso\u001b[87Gthe\u001b[91Gleftover\u001b[100G~4%\u001b[104Ggap\u001b[108Gisn't\u001b[114Ga\u001b[116Gclear\r\u001b[2C\u001b[1Blever. I'm now timing raw\u001b[29Gwrite\u001b[35Gsyscalls\u001b[44Gfor\u001b[48Gthe\u001b[52G460\u001b[56G\u00d7\u001b[58G128\u001b[62GKB\u001b[65GLOGITS\u001b[72Goutput\u001b[79Gat\u001b[82Gdifferent\u001b[92Gchunk\u001b[98Gsizes\u001b[104Gto\u001b[107Gsee\u001b[111Gwhether\r\u001b[2C\u001b[1Bbatching those writes would help.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBatching\u001b[12Gthe\u001b[16Gwrites\u001b[23Gshowed\u001b[30Gno\u001b[33Gconsistent\u001b[44Ggain,\u001b[50Gso\u001b[53GLOGITS\u001b[60Gstay"]
[248.668, "s\u001b[66Gas\u001b[69Git\u001b[72Gis.\u001b[76GNext\u001b[81GI'll\u001b[86Gvectorize\u001b[96Gargmax\u001b[103Gwhile\u001b[109Gkeeping\u001b[117Gthe\r\u001b[1B  first-maximum tie-breaking, and switch the KV cache to a head-major layout so each head's keys and values sit\u001b[K\r\u001b[1C\u001b[1B contiguously.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m f\u001b[12Gl\u001b[14G, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Check pas\u001b[13Ges. I need an exact baseline\u001b[42Gfrom the start\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[1C\u001b[1B by undoing the single edi\u001b[29G:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m A/B\u001b[7Gbaseline\u001b[16Gvs\u001b[19Ghe\u001b[22Gd-major\u001b[30GKV\u001b[33Gcache\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /Users/agentlab/pvc/mj; python3 -I - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102ms=open('/tmp/mjprof/noattn.mojo').read()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102ma=\"\"\" if pos >= 0:\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mpass\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102melif head_size == 6"]
