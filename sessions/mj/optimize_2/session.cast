[400.093, "\u001b[H \u001b[3Glever. I'm \u001b[15Gow timing raw\u001b[29Gwrite syscalls for the 460\u001b[56G\u00d7 128 KB LOGITS output at different chunk sizes\u001b[104Gto see whether\u001b[K\r\u001b[2C\u001b[1Bbatching those\u001b[18Gwrites\u001b[25Gwould help.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBatching\u001b[12Gthe\u001b[16Gwrites\u001b[23Gshowed\u001b[30Gno\u001b[33Gconsistent\u001b[44Ggain,\u001b[50Gso\u001b[53GLOGITS\u001b[60Gstays\u001b[66Gas\u001b[69Git\u001b[72Gis.\u001b[76GNext\u001b[81GI'll\u001b[86Gvectorize\u001b[96Gargmax\u001b[103Gwhile\u001b[109Gkeeping\u001b[117Gthe\r\u001b[1B \u001b[3Gfirst-maximum t\u001b[19Ge-breaking, and sw\u001b[38Gtch \u001b[43Ghe KV cache to a\u001b[60Ghe\u001b[63Gd-m\u001b[67Gjor layout so\u001b[81Geach\u001b[86Gh\u001b[88Gad's k\u001b[95Gys and values\u001b[109Gsit\u001b[K\r\u001b[2C\u001b[1Bcontiguously.\u001b[17G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck\u001b[9Gpasses.\u001b[17GI\u001b[19Gneed\u001b[24Gan\u001b[27Gexact\u001b[33Gbaseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[10"]
