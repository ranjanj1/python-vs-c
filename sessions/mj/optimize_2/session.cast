[113.737, "\u001b[H\u001b[3GNOTES.md\u001b[12Ghas\u001b[16Gthe\u001b[20Gprofiling\u001b[30Gevidence,\u001b[40Gthe\u001b[44Gchanges,\u001b[53Gthe\u001b[57Gtests\u001b[63Gand\u001b[67Gthe\u001b[71Glimitations.\u001b[84GThe\u001b[88Gprofiling\u001b[98Gtools\u001b[104Gare\u001b[108Gin\u001b[111G\u001b[38;2;87;105;247mprof/\u001b[117G\u001b[39mso\r\u001b[2C\u001b[1Bthe\u001b[7Gmeasurements\u001b[20Gcan\u001b[24Gbe\u001b[27Grepeated;\u001b[37G\u001b[38;2;87;105;247mmj.mojo\u001b[45G\u001b[39mitself\u001b[52Gcontains\u001b[61Gno\u001b[64Gprofiling\u001b[74Gcode.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GWorked for 10m 31s \u00b7 done 5:24 PM\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStarting\u001b[12Gpoint:\u001b[19Gthe\u001b[23Gforward\u001b[31Gpa"]
[113.738, "ss\u001b[36Gis\u001b[39G7.42\u001b[44Gms/token\u001b[53Gagainst\u001b[61Ga\u001b[63Gmeasured\u001b[72Gstreaming\u001b[82Gfloor\u001b[88Gof\u001b[91G~7.0\u001b[96Gms,\u001b[100Gso\u001b[103Gwhat's\u001b[110Gleft\u001b[115Gis\r\u001b[1B \u001b[3Gsmall.\u001b[10GFirst I'll get th\u001b[28G full end-to-end split (f\u001b[54Grward vs every\u001b[69Ghing else,\u001b[80Gsuch\u001b[85Gas a\u001b[90Gg\u001b[92Gax, LOGITS file writ\u001b[113Gs and\u001b[K\r\u001b[2C\u001b[1Bp\u001b[5Go\u001b[7Gocol). Then I'l\u001b[24Gcheck whether\u001b[38Gthe 62.5 GB/s\u001b[52G\"ceiling\" is\u001b[65Gre\u001b[68Glly fix\u001b[76Gd. One hypothesis\u001b[94Gis\u001b[97Gthat\u001b[102Ghardware\r\u001b[2C\u001b[1Bprefetchers\u001b[15Gstop\u001b[20Gat\u001b[23G16\u001b[26GKB\u001b[29Gpage\u001b[34Gboundaries,\u001b[46Gwhich\u001b[52Gsoftware\u001b[61Gprefetch\u001b[70Gfar\u001b[74Genough\u001b[81Gahead,\u001b[88Gor\u001b[91Gnon-temporal\u001b[104Gloads,\u001b[111Gmight\u001b[117Gget\r\u001b[2C\u001b[1Baround.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMemory bandwidth is capped near 63 GB/s, \u001b[45Gnd per-load\u001b[57Gtweaks don't\u001b[70Ghelp.\u001b[76GI'm\u001b[80Gnext\u001b[85Ginstrumenting\u001b[99Gargmax\u001b[106Gand\u001b[110Gthe\u001b[114GLOGITS\r\u001b[2C\u001b[1Bwrites,\u001b[11Gsince\u001b[17Gmatmul\u001b[24Gruns\u001b[29Gslightly\u001b[38Gslowe"]
[113.74, "r\u001b[45Gin\u001b[48Gthe\u001b[52Greal\u001b[57Gprogram\u001b[65Gthan\u001b[70Gin\u001b[73Gthe\u001b[77Gmicrobenchmark.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mArgmax costs about 40 \u00b5s per\u001b[32Gtoken\u001b[38Gand\u001b[42GLOGITS\u001b[49Gwrites\u001b[56Gabout\u001b[62G60\u001b[65G\u00b5s\u001b[68Gper\u001b[72Gposition,\u001b[82Gboth\u001b[87Gsmall.\u001b[94GThe\u001b[98Greal\u001b[103Ggap\u001b[107Gis\u001b[110Gthat\r\u001b[2C\u001b[1Bmatmuls run at ~60 GB/s\u001b[27Ginside\u001b[34Gthe\u001b[38Gprogram\u001b[46Gversus\u001b[53G62.7\u001b[58GGB/s\u001b[63Gin\u001b[66Gthe\u001b[70Gmicrobenchmark,\u001b[86Gso\u001b[89GI'm\u001b[93Gbuilding\u001b[102Ga\u001b[104Gcopy\u001b[109Gwhose\r\u001b[2C\u001b[1Bforward pass runs only matmuls\u001b[34Gto\u001b[37Gfind\u001b[42Gwhat\u001b[47Gslows\u001b[53Gthe\u001b[57Gstream.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m \u001b[10Ghell commands \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping attention changes\u001b[30Gnothing,\u001b[39Gso\u001b[42Ginterleaved\u001b[54Gwork\u001b[59Gisn't\u001b[65Gthe\u001b[69Gcause.\u001b[76GNext\u001b[81GI'll\u001b[86Gcheck\u001b[92Gwhether\u001b[100Gthe\u001b[104Ggap\u001b[108Gis\u001b[111Gjust\r\u001b[2C\u001b[1Bbest-of-N (microbenchmark) versus mean (in-program)\u001b[55Gtiming:\r\u001b[5"]
