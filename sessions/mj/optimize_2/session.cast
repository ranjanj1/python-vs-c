[96.193, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStarting\u001b[12Gpoint:\u001b[19Gthe\u001b[23Gforward\u001b[31Gpass\u001b[36Gis\u001b[39G7.42\u001b[44Gms/token\u001b[53Gagainst\u001b[61Ga\u001b[63Gmeasured\u001b[72Gstreaming\u001b[82Gfloor\u001b[88Gof\u001b[91G~7.0\u001b[96Gms,\u001b[100Gso\u001b[103Gwhat's\u001b[110Gleft\u001b[115Gis\r\u001b[1B \u001b[3Gsm\u001b[6Gll. First I'll get the full end-to-end \u001b[46Gplit (forward vs\u001b[63Geverything else, such as\u001b[88Gargmax,\u001b[96GLOGITS\u001b[103Gfile writes\u001b[115Gand\r\u001b[2C\u001b[1Bprotocol). Then I'll check whether \u001b[39Ghe 62.5 GB/s \"ceiling\" is really fixed. One \u001b[84Gypothesis is that hardware\u001b[K\r\u001b[4C\u001b[1Befetchers stop at 16 KB pag\u001b[33G boundaries, which\u001b[52Gsoftware prefetch far enough ahead, or non-temporal loads,\u001b[111Gmight\u001b[117Gget\r\u001b[2C\u001b[1Ba\u001b[5Gound.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMemory\u001b[10Gbandwidth\u001b[20Gis\u001b[23Gcapped\u001b[30Gnear\u001b[35G63\u001b[38GGB/s,\u001b[44Gand\u001b[48Gper-load\u001b[57Gtweaks\u001b[64Gdon't\u001b[70Ghelp.\u001b[76GI'm\u001b[80Gnext\u001b[85Ginstrumenting\u001b[99Gargmax\u001b[106Gand\u001b[110Gthe\u001b[114GLOGITS\r\u001b[1B \u001b[3Gwrites, since matmul runs slightly"]
[96.195, "\u001b[38Gslower in\u001b[48Gthe re\u001b[55Gl\u001b[57Gprogram than\u001b[70Gin the microbenchma\u001b[90Gk.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mArgmax\u001b[10Gcosts\u001b[16Gabout\u001b[22G40\u001b[25G\u00b5s\u001b[28Gper\u001b[32Gtoken\u001b[38Gand\u001b[42GLOGITS\u001b[49Gwrites\u001b[56Gabout\u001b[62G60\u001b[65G\u00b5s\u001b[68Gper\u001b[72Gposition,\u001b[82Gboth\u001b[87Gsmall.\u001b[94GThe\u001b[98Greal\u001b[103Ggap\u001b[107Gis\u001b[110Gthat\r\u001b[1B \u001b[3Gmat\u001b[7Guls run at ~60\u001b[22GGB/s inside the\u001b[38Gprogram versus 62.7 GB/s in the microbenchmark, so I'm building a copy whose\r\u001b[2C\u001b[1Bforward\u001b[11Gpass runs only matmuls\u001b[35Go find what slow\u001b[53Gthe stream.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mComparing\u001b[13Gmatmul\u001b[20Gtiming\u001b[27Gwith\u001b[32Gand\u001b[36Gwithout\u001b[44Gattention\u001b[38;2;102;102;102m \u00b7 4s\r\u001b[1B  \u23bf  $ cd /Users/agentlab/pvc/mj; python3 -I - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102ms=open('/U\u001b[17Gers/agentlab/pvc/mj/mj.mojo').read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ma\u001b[8G\"\"\" if head_siz\u001b[24G == 64:\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102mttent\u001b[13Go"]
[96.196, "n_all[64]\"\"\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102mss\u001b[10Gr\u001b[12G s.count(a)==1\r\u001b[5C\u001b[1Bs=\u001b[9G.\u001b[11Gepla\u001b[16Ge(a,\"\"\" if pos >= 0:\r\u001b[5C\u001b[1Bpa\u001b[9Gs\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102melif head_size == 64:\r\u001b[5C\u001b[1Battention\u001b[16Gall[64]\"\"\")\r\u001b[5C\u001b[1Bopen('/tmp/mjprof/noattn.mojo','w').write(s)\r\u001b[5C\u001b[1BEOF\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mpyth\u2026 (3s \u00b7 2 lines)\r\u001b[5C\u001b[1B(c\u001b[9Grl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
