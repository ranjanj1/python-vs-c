[810.911, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gargmax\u001b[14Gcheck\u001b[20Gpasses,\u001b[28Gand\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[2C\u001b[1Binfinities and odd lengths.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero mismatches in 20,000 adversarial trials, so the result is the same as run.c's\u001b[86Gloop.\u001b[92GMeasuring\u001b[102Gthe\u001b[106Ggain\u001b[111Gwith\u001b[116Gthe\r\u001b[2C\u001b[1Binstrumented\u001b[16Gbuild\u001b[22Gand\u001b[26Gthe\u001b[30Ginterleaved\u001b[42GA/B:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gargmax ch\u001b[18Gge cut the per-c\u001b[35Gll cost\u001b[43Gfrom\u001b[48G40.5\u001b[53Gto\u001b[56G3.6\u001b[60G\u00b5s,\u001b[64Gand\u001b[68Gthe\u001b[72Ginterleaved\u001b[84GA/B\u001b[88Gis\u001b[91Gat\u001b[94Gor\u001b[97Gslightly\u001b[106Gahead\u001b[112Gof\r\u001b[2C\u001b[1Bbaseline,\u001b[13Gwhich\u001b[19Gis\u001b[22Gwithin\u001b[29Gnoise.\u001b[3"]
[810.912, "6GNext\u001b[41GI'll\u001b[46Gcheck\u001b[52Gwhat\u001b[57G\u001b[38;2;87;105;247mFileHandle.write_bytes\u001b[80G\u001b[39mdoes,\u001b[86Gsince\u001b[92Gthe\u001b[96G60\u001b[99G\u00b5s\u001b[102GLOGITS\u001b[109Gwrite\u001b[115Glooks\r\u001b[2C\u001b[1Bslow for one kernel copy.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mInspecting\u001b[14GFileHandle write_bytes implementation\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -n 555,606p /Users/Shared/pvc-kit/mojo/docs/stdlib-source/io/file.mojo | grep -v '^\\s*$' | grep -v '\"\"\"' | \r\u001b[5C\u001b[1Bhead -40; sed -n 512,555p /Users/Shared/pvc-kit/mojo/docs/stdlib-source/io/file.mojo | grep -n \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m\"external_call\\|while\\|write_once\\|def \"\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b"]
