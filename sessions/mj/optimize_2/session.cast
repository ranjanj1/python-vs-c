[751.661, "\u001b[H\u001b[2G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Attention is\u001b[16Gthe\u001b[20Glikely culpr\u001b[33Gt, since reduce_add is\u001b[56Ga\u001b[58Gtr\u001b[61Ge reduction\u001b[73Gand\u001b[77Gruled\u001b[83Gout.\u001b[88GI'm\u001b[92Gbenchmarking\u001b[105Gattention\u001b[115Galone\r\u001b[1C\u001b[1B on\u001b[6Gsynthetic\u001b[16Gdata\u001b[21Gat 64 and\u001b[31G512\u001b[35Gpositions,\u001b[46Gcomparing\u001b[56Gthe\u001b[60Gcurrent\u001b[68Gkernel\u001b[75Gagainst\u001b[83Gtwo\u001b[87Gvariants.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gper-head\u001b[16Gkernel is about\u001b[32G25%\u001b[36Gfaster\u001b[43Gat\u001b[46Gshort\u001b[52Gcontexts,\u001b[62Gwhere\u001b[68Gq\u001b[70Gand\u001b[74Gthe\u001b[78Gaccumulator\u001b[90Gstay\u001b[95Gin\u001b[98Gregisters,\u001b[109Gbut\r\u001b[1C\u001b[1B position-major\u001b[18Gorder\u001b[24Gwins badly at\u001b[38Glong ones\u001b[48G(1.56\u001b[54Gms vs 4.31 ms at 1024\u001b[76Gpositions).\u001b[88GI'm\u001b[92Gfinding\u001b[100Gthe\u001b[104Gcrossover\u001b[114Gpoint\r\u001b[1C\u001b[1B so\u001b[6GI\u001b[8Gcan\u001b[12Gswitch kernels by context\u001b[38Glength.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gmicroben"]
