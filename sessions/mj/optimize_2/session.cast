[16.04, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BThe startup cost was 55 ms at first. I cut it to about 20 ms by reading\u001b[75Geach\u001b[80Gmatrix\u001b[87Gfrom\u001b[92Gthe\u001b[96Gfile\u001b[101Gstraight\u001b[110Ginto\u001b[115Ga\r\u001b[2C\u001b[1Btemporary\u001b[13Gbuffer\u001b[20Gand\u001b[24Grearranging\u001b[36Git\u001b[39Gfrom\u001b[44Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExtra tests\u001b[22m, b\u001b[18Gyond ch\u001b[26Gck.py:\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEarlier protocol tests:\u001b[29G\u001b[22mPIECE,\u001b[36GFIXED,\u001b[43Gpipelined\u001b[53Ginput\u001b[59Gand\u001b[63Gthe\u001b[67G\u001b[38;2;87;105;247mstop\u001b[39m/\u001b[38;2;87;105;247mcontext\u001b[80G\u001b[39mendings\u001b[88Gall\u001b[92Gstill\u001b[98Gpass.\u001b[104GLong-run\u001b[113Goutputs\r\u001b[2C\u001b[1B  are unchanged.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mUnshared classifier\u001b[22m (the supplied model does\u001b[50G't\u001b[53Guse one):\u001b[63Ga temporary checkpoint bui\u001b[90Gt\u001b[92Gfor this gave bit-identical\u001b[K\r\u001b[4C\u001b[1Blogits and the\u001b[20Gsame\u001b[25Goutput.\u001b[33GI\u001b[35Gdeleted\u001b[43Git\u001b[46Gafterwards\u001b[57Gbecause\u001b[65Gthe\u001b[69Gdisk\u001b[74Gis\u001b[77G98%\u001b[81Gfull.\r\u001b[4C\u001b[1B\u001b[1mOther code paths, via temporary builds:\u001b[45G\u001b[22mf\u001b[47Grcing\u001b[53Gth\u001b[58Gld layout everywher\u001b[78G, and a\u001b[87Glock\u001b[92Gsize that leaves l"]
