[800.365, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe per-he\u001b[14Gd kernel is about 25% faster\u001b[43Gat \u001b[47Ghort contexts, where\u001b[68Gq and the accumulator stay in registe\u001b[106Gs, but\u001b[K\r\u001b[2C\u001b[1Bp\u001b[5Gsitio\u001b[11G-major order wins badly a\u001b[39Go\u001b[42G ones\u001b[48G(1.56\u001b[54Gms\u001b[57Gvs\u001b[60G4.31\u001b[65Gms\u001b[68Gat\u001b[71G1024\u001b[76Gpositions).\u001b[88GI'm\u001b[92Gfinding\u001b[100Gthe\u001b[104Gcrossover\u001b[114Gpoint\r\u001b[2C\u001b[1Bso\u001b[6GI\u001b[8Gcan\u001b[12Gswitch\u001b[19Gkernels\u001b[27Gby\u001b[30Gcontext\u001b[38Glength.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe microbenchmark's crossover sits\u001b[39Gnear 150 positions,\u001b[59Gbut i\u001b[65G r\u001b[68Gruns the same positions and so flatt\u001b[105Grs the short\r\u001b[3C\u001b[1Bache, sinc\u001b[18Ge rea\u001b[24G program's 438 MB\u001b[42Gof weights\u001b[53Gevict it b\u001b[64Gtw\u001b[67Gen tokens. I'll\u001b[83Gadd\u001b[87Gthe\u001b[91Gper-head\u001b[100Gkernel\u001b[107Gup\u001b[110Gto\u001b[113Ga\r\u001b[2C\u001b[1Bcompile-time\u001b[16Gthreshold\u001b[26Gand\u001b[30Gconfirm\u001b[38Gthe\u001b[42Ggain\u001b[47Gunder\u001b[53Gthe\u001b[57Ginter"]
[800.366, "leaved\u001b[69GA/B\u001b[73Gharness.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gshor\u001b[12G-context ker\u001b[25Gel is\u001b[31Gslower in the\u001b[45Greal\u001b[50Gprogram,\u001b[59Gso\u001b[62GI'm\u001b[66Greverting\u001b[76Git,\u001b[80Gand\u001b[84GI'll\u001b[89Gvectorize\u001b[99Gargmax\u001b[106Gnext,\u001b[112Gkeeping\r\u001b[2C\u001b[1Bits\u001b[7Gexact\u001b[13Gsemantics\u001b[23Gand\u001b[27GNaN\u001b[31Gbehaviour.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe argmax\u001b[14Gcheck passes, and\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[2C\u001b[1Binfinities\u001b[14Gand\u001b[18Godd\u001b[22Glengths.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero mismatches in\u001b[22G20,000 adversarial trials,\u001b[49Gso\u001b[52Gthe\u001b[56Gresult\u001b[63Gis\u001b[66Gthe\u001b[70Gsame\u001b[75Gas\u001b[78Grun.c's\u001b[86Gloop.\u001b[92GMeasuring\u001b[102Gthe\u001b[106Ggain\u001b[111Gwith\u001b[116Gthe\r\u001b[2C\u001b[1Bins"]
