[439.709, "\u001b[H\u001b[3Glever.\u001b[10GI'm\u001b[14Gnow\u001b[18Gtiming\u001b[25Graw\u001b[29Gwrite\u001b[35Gsyscalls\u001b[44Gfor\u001b[48Gthe\u001b[52G460\u001b[56G\u00d7\u001b[58G128\u001b[62GKB\u001b[65GLOGITS\u001b[72Goutput\u001b[79Gat\u001b[82Gdifferent\u001b[92Gchunk\u001b[98Gsizes\u001b[104Gto\u001b[107Gsee\u001b[111Gwhether\r\u001b[2C\u001b[1Bbatching those writes would help.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBatching\u001b[12Gthe\u001b[16Gwrites\u001b[23Gshowed\u001b[30Gno\u001b[33Gconsistent\u001b[44Ggain,\u001b[50Gso\u001b[53GLOGITS\u001b[60Gstays\u001b[66Gas\u001b[69Git\u001b[72Gis.\u001b[76GNext\u001b[81GI'll\u001b[86Gvectorize\u001b[96Gargmax\u001b[103Gwhile\u001b[109Gkeeping\u001b[117Gthe\r\u001b[2C\u001b[1Bfirst-maximum tie-breaking,\u001b[31Gand\u001b[35Gswitch\u001b[42Gthe\u001b[46GKV\u001b[49Gcache\u001b[55Gto\u001b[58Ga\u001b[60Ghead-major\u001b[71Glayout\u001b[78Gso\u001b[81Geach\u001b[86Ghead's\u001b[93Gkeys\u001b[98Gand\u001b[102Gvalues\u001b[109Gsit\r\u001b[2C\u001b[1Bcontiguously.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[37G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck passes. I need\u001b[24Gan\u001b[27Gexact\u001b[33Gbaseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Greb"]
[439.71, "uild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[2C\u001b[1Bby\u001b[6Gundoing\u001b[14Gthe\u001b[18Gsingle\u001b[25Gedit:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mHead-major KV shows no\u001b[26Ggain,\u001b[32Gpossibly\u001b[41Ga\u001b[43Gloss,\u001b[49Gand\u001b[53Gthe\u001b[57Gworkload\u001b[66Gnumbers\u001b[74Gare\u001b[78Gnoisy.\u001b[85GBefore\u001b[92Gdeciding,\u001b[102GI'll\u001b[107Gtime\u001b[112Gthe\r\u001b[2C\u001b[1Battention\u001b[13Gphase\u001b[19Gdirectly\u001b[28Gwith\u001b[33Gthe\u001b[37Ginstrumented\u001b[50Gbuilds\u001b[57Gat\u001b[60Gfull\u001b[65G1024\u001b[70Gcontext:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention is only ab\u001b[24Gut\u001b[27G1% \u001b[31Gt \u001b[34Ghese lengths,\u001b[48Gso\u001b[51Greverting\u001b[61Gthe\u001b[65Ghead-major\u001b[76GKV\u001b[79Gchange\u001b[86Gkeeps\u001b[92Gthe\u001b[96Greference\u001b[106Glayout.\u001b[114GNext\r\u001b[1B  I'll run a matmul-only copy of the forward to see whether the small ops between matmuls cause the gap to 7.09\u001b[113Gms.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m"]
