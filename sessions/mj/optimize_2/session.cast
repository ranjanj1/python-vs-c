[438.522, "\u001b[H\r\u001b[33B\u001b[38;2;174;112;51m\u001b[1m\u00b7\u001b[3G\u001b[22mWandering\u2026 \u001b[18G\u001b[38;2;102;102;102m8\u001b[40G\u001b[38;2;154;128;79mstill thinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[438.633, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe microbe\u001b[15Gchmark matmul\u001b[29Gaverages 7.09 ms, close to\u001b[56Gthe program's 7.28\u20137.43 ms, so the leftover ~4%\u001b[104Ggap isn't a clear\r\u001b[2C\u001b[1Blever. I'm now\u001b[18Gtiming\u001b[25Graw write syscalls\u001b[44Gfor\u001b[48Gthe\u001b[52G460\u001b[56G\u00d7\u001b[58G128\u001b[62GKB\u001b[65GLOGITS\u001b[72Goutput\u001b[79Gat\u001b[82Gdifferent\u001b[92Gchunk\u001b[98Gsizes\u001b[104Gto\u001b[107Gsee\u001b[111Gwhether\r\u001b[2C\u001b[1Bbatching\u001b[12Gthose\u001b[18Gwrites\u001b[25Gwould\u001b[31Ghelp.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBatching the wr\u001b[19Gtes showed no cons\u001b[38Gsten\u001b[43G gain, so LOGITS\u001b[60Gst\u001b[63Gys \u001b[67Gs it is. Next\u001b[81GI'll\u001b[86Gv\u001b[88Gctoriz\u001b[95G argmax while\u001b[109Gkeeping\u001b[117Gthe\r\u001b[2C\u001b[1Bfirst-maximum\u001b[17Gtie-breaking,\u001b[31Gand\u001b[35Gswitch\u001b[42Gthe\u001b[46GKV\u001b[49Gcache\u001b[55Gto\u001b[58Ga\u001b[60Ghead-major\u001b[71Glayout\u001b[78Gso\u001b[81Geach\u001b[86Ghead's\u001b[93Gkeys\u001b[98Gand\u001b[102Gvalues\u001b[109Gsit\r\u001b[2C\u001b[1Bcontiguously.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1"]
[438.637, "B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck passes. I need an exact\u001b[33Gbaseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[2C\u001b[1Bby\u001b[6Gundoing\u001b[14Gthe\u001b[18Gsingle\u001b[25Gedit:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mHead-major KV shows no gain, possibly a loss, and the\u001b[57Gworkload numbers are noisy.\u001b[85GBefore\u001b[92Gdeciding,\u001b[102GI'll\u001b[107Gtime\u001b[112Gthe\r\u001b[2C\u001b[1Battention\u001b[13Gphase\u001b[19Gdirectly\u001b[28Gwith\u001b[33Gthe\u001b[37Ginstrumented\u001b[50Gbuilds\u001b[57Gat\u001b[60Gfull\u001b[65G1024\u001b[70Gcontext:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention is only about 1% at these lengths, so rever\u001b[57Ging\u001b[65Ghe\u001b[68Gd-major KV change keeps the ref\u001b[100Grence layout. Next\r\u001b[2C\u001b[1BI'll\u001b[8Grun\u001b[12Ga\u001b[14Gmatmul-only\u001b[26Gcopy\u001b[31Gof\u001b[34Gthe\u001b[38Gforward\u001b[46Gto\u001b[49Gsee\u001b[53Gwhether\u001b[61Gthe\u001b[65Gsmall\u001b[71Gops\u001b[75Gbetween\u001b[83Gm"]
[438.638, "atmuls\u001b[91Gcause\u001b[97Gthe\u001b[101Ggap\u001b[105Gto\u001b[108G7.09\u001b[113Gms.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul-only runs already sit at the memory\u001b[46Gceiling,\u001b[55Gso\u001b[58Gthe\u001b[62G~0.18\u001b[68Gms\u001b[71Gof\u001b[74Gnon-matmul\u001b[85Gwork\u001b[90Gper\u001b[94Gposition\u001b[103Gleaves\u001b[110Gthe\u001b[114Gbus\r\u001b[2C\u001b[1Bidle. I'm checking the prefetch API to see whether I can stream the next\u001b[76Gweight\u001b[83Gmatrix\u001b[90Ginto\u001b[95GL2\u001b[98Gduring\u001b[105Gthat\u001b[110Ggap.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[3GWandering\u2026 \u001b[26G\u001b[38;2;102;102;102m2\u001b[28G5\u001b[40G\u001b[38;2;161;161;161mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
