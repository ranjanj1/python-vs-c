[845.176, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gshor\u001b[12G-context ker\u001b[25Gel is\u001b[31Gslower in the\u001b[45Greal\u001b[50Gprogram,\u001b[59Gso\u001b[62GI'm\u001b[66Greverting\u001b[76Git,\u001b[80Gand\u001b[84GI'll\u001b[89Gvectorize\u001b[99Gargmax\u001b[106Gnext,\u001b[112Gkeeping\r\u001b[2C\u001b[1Bits\u001b[7Gexact\u001b[13Gsemantics\u001b[23Gand\u001b[27GNaN\u001b[31Gbehaviour.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe argmax\u001b[14Gcheck passes, and\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[2C\u001b[1Binfinities\u001b[14Gand\u001b[18Godd\u001b[22Glengths.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero mismatches in\u001b[22G20,000 adversarial trials,\u001b[49Gso\u001b[52Gthe\u001b[56Gresult\u001b[63Gis\u001b[66Gthe\u001b[70Gsame\u001b[75Gas\u001b[78Grun.c's\u001b[86Gloop.\u001b[92GMeasuring\u001b[102Gthe\u001b[106Ggain\u001b[111Gwith\u001b[116Gthe\r\u001b[2C\u001b[1Binstrumented\u001b[16Gbuild\u001b[22Gand\u001b[26Gthe\u001b"]
[845.177, "[30Ginterleaved\u001b[42GA/B:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe argmax change cut the\u001b[29Gper-call cost from 40.5 to 3.6 \u00b5s, and the interleaved A/B is a\u001b[93G or slightly ahead of\u001b[115G\u001b[K\r\u001b[2C\u001b[1Bbaseline, which is within\u001b[29Gnoise.\u001b[36GNext\u001b[41GI'll\u001b[46Gcheck\u001b[52Gwhat\u001b[57G\u001b[38;2;87;105;247mFileHandle.write_bytes\u001b[80G\u001b[39mdoes,\u001b[86Gsince\u001b[92Gthe\u001b[96G60\u001b[99G\u00b5s\u001b[102GLOGITS\u001b[109Gwrite\u001b[115Glooks\r\u001b[2C\u001b[1Bslow\u001b[8Gfor\u001b[12Gone\u001b[16Gkernel\u001b[23Gcopy.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gwrite loop already does the \u001b[36Ginimum\u001b[43Gc\u001b[45Gpying, so the\u001b[59G~60\u001b[63G\u00b5s is just the kernel filling the page c\u001b[104Gche with 128\u001b[117GKB,\u001b[K\r\u001b[2C\u001b[1Ba\u001b[5Gd I'm leaving it since\u001b[28Gmemory-mapping\u001b[43Gwould\u001b[49Gneed\u001b[54Glibc\u001b[59GFFI\u001b[63Gfor\u001b[67Gunder\u001b[73G1%\u001b[76Ggain.\u001b[82GNext\u001b[87GI'll\u001b[92Grun\u001b[96Gthe\u001b[100Gfinal\u001b[106Gregression\u001b[117Gpass\r\u001b[2C\u001b[1Bon\u001b[6Gthe\u001b[10Gvectorized-argm"]
[845.177, "ax\u001b[28Gbuild.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running full regression tests and saving tools\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd\u001b[11G/Users/agentlab/pvc/mj; mojo build mj.\u001b[50Gojo\u001b[54G-o mj 2>&1\u001b[65G| grep -ic\u001b[76G\"error\\|warning\"; python3 check.py -- ./mj |\r\u001b[5C\u001b[1Btail -1; python3\u001b[23Gcheck.py --tokens 64 --prom\u001b[51Gts 3 -- ./mj; python3 -I /tmp/mjtest/t.py /Users/agentlab/pvc/mj 2>&1 \r\u001b[5C\u001b[1B| g\u001b[10Gep -v \"^T \"; python3 -I /tmp/mjtest/ctx.py /Users/agentlab/pvc/mj\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
