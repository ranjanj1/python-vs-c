[643.245, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gkc\u001b[15G=\u001b[17Gfa(L\u001b[22G*\u001b[24Gseq\u001b[28G*\u001b[30Gkvd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     var vc = fa(L *\u001b[24Gseq\u001b[28G*\u001b[30Gkvd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gq\u001b[14G=\u001b[16Gfa(768)\r\u001b[1B \u001b[2m\u2502\u001b[22m     var att = fa(12 * seq)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     var xb = fa(768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvar\u001b[12Gbest\u001b[17G=\u001b[19GFloat64(1e18)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     var chk: Float32\u001b[25G=\u001b[27G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Grep\u001b[16Gin\u001b[19Grange(15):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     var\u001b[16Gt0 = perf_counter_ns()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for l in \u001b[22Gange(L):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mvar\u001b[20Gkb\u001b[23G=\u001b[25Gkc.unsafe_offset(l\u001b[44G*\u001b[46Gseq\u001b[50G*\u001b[52Gkvd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             var vb =\u001b[25Gvc.unsafe_offset(l\u001b[44G*\u001b[46Gseq\u001b[50G*\u001b[52Gkvd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mcomptime\u001b[25Gif\u001b[28Gwhich\u001b[34G==\u001b[37G1:\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G   \u001b[19G v1[64](q, att, kb,\u001b[39Gvb, kvd, seq, npos, xb, 8.0, 12, 1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         \u001b[16Gelif\u001b[21Gwhich\u001b[27G==\u001b[30G2:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[2"]
[643.246, "2mv2[64,\u001b[27G8](q,\u001b[33Gatt,\u001b[38Gkb,\u001b[42Gvb,\u001b[46Gkvd,\u001b[51Gseq,\u001b[56Gnpos,\u001b[62Gxb,\u001b[66G8.0,\u001b[71G12,\u001b[75G1)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             else:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mv3[64](q,\u001b[30Gatt,\u001b[35Gkb,\u001b[39Gvb,\u001b[43Gkvd,\u001b[48Gseq,\u001b[53Gnpos,\u001b[59Gxb,\u001b[63G8.0,\u001b[68G12,\u001b[72G1)\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8G    \u001b[13G   chk += xb[unsafe_offset=5]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G v\u001b[14Gr\u001b[16Gdt = Float64(perf_counter_n\u001b[44G() -\u001b[49Gt0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gdt\u001b[18G<\u001b[20Gbest:\u001b[26Gbest\u001b[31G=\u001b[33Gdt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(name, \"npos\",\u001b[28Gnpos,\u001b[34G\"ms/token\u001b[44G(12\u001b[48Glayers)\",\u001b[58Gbest\u001b[63G/\u001b[65G1e6,\u001b[70Gchk)\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1B\u001b[22m \u001b[2m\u2502\u001b[22m d\u001b[7G main():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G for np in [64, 512, 1024]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbench[1](np,\u001b[25G\"V1\u001b[29Gcurrent\u001b[44G\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         bench[2](np,\u001b[25G\"V2\u001b[29Gper-head\u001b[38Gregs\u001b[44G\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbench[3](np,\u001b[25G\"V3\u001b[29G4-pos\u001b[35Gscores\u001b[44G\")\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m mojo build /tmp/mjprof/"]
[643.246, "\u001b[28Gttn.mojo -o /tmp/mjprof/attn 2>&1 | grep -iA6 error | head\u001b[87G-20; /\u001b[94Gmp/mjprof/attn\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mmojo build, grep -iA6 error\u001b[22m,\u001b[65Gand\u001b[69G\u001b[1m/tmp/mjprof/attn\u001b[86G\u001b[22mcommands\u001b[95Gin\u001b[98G\u001b[1m/Users/agentlab/pvc/mj\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo"]
