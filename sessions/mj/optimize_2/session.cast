[562.613, "\u2502\u001b[4G\u001b[22mcat\u001b[8G>\u001b[10G/tmp/mjprof/ab.py\u001b[28G<<'EOF'\r\u001b[1B \u001b[2m\u2502\u001b[22m # I\u001b[9Gerleaved A/B: all\u001b[27Gvarian\u001b[34Gs load\u001b[41Gd at once, alternate short FIXED-64 rounds, report\u001b[92Gmin/m\u001b[98Gdian ms\u001b[106Gper position.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m impo\u001b[9Gt subprocess, s\u001b[25Gs, time,\u001b[34Gstatistics\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22md\u001b[6G=\u001b[8Gsys.argv[1];\u001b[21Gexes\u001b[26G=\u001b[28Gsys.argv[2:];\u001b[42Grounds\u001b[49G=\u001b[51G12\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ps = []\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Ge\u001b[10Gin\u001b[13Gexes:\r\u001b[1B \u001b[2m\u2502\u001b[22m     p = subprocess.Popen([e, d\u001b[35G+ '/\u001b[40Godel.bin', d +\u001b[55G'/tok\u001b[61Gnizer.bin'],\u001b[74Gstdin=subprocess.PIPE, s\u001b[99Gd\u001b[101Gut=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m text=True, bufsize=1)\u001b[26G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Gp.stdout.readline().strip()\u001b[43G==\u001b[46G'READY';\u001b[55Gps.append(p)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m cmd = 'FIXED ' + ' '.join(['1']\u001b[36G+\u001b[38G['300']\u001b[46G*\u001b[48G63)\u001b[52G+\u001b[54G'\\n'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mts\u001b[7G=\u001b[9G[[]\u001b[13Gfor\u001b[17G_\u001b[19Gin\u001b[22Gexes]\r\u001b[1B \u001b[2m\u2502\u001b[22m for r \u001b[12G r\u001b[15Gnge(rounds):\u001b[K\r\u001b[1C\u001b[1B\u001b["]
[562.614, "2m\u2502\u001b[22m     for i, p in \u001b[21Gnumerate(ps if r % 2 == 0 \u001b[48Glse ps[::-1]):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mk\u001b[14G=\u001b[16Gi\u001b[18Gif\u001b[21Gr\u001b[23G%\u001b[25G2\u001b[27G==\u001b[30G0\u001b[32Gelse\u001b[37Glen(ps)\u001b[45G-\u001b[47G1\u001b[49G-\u001b[51Gi\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         t = time.perf_counter();\u001b[37Gp.stdin.write(cmd);\u001b[57Gp.stdin.flush();\u001b[74Gp.stdout.readline();\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mts[k].append((time.perf_counter()\u001b[38G-\u001b[40Gt)\u001b[43G/\u001b[45G64\u001b[48G*\u001b[50G1e3)\r\u001b[1B \u001b[2m\u2502\u001b[22m for e, t, p in\u001b[19Gzip(exes, ts, ps):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f'{e.split(\"/\")[-1]:>12}:\u001b[40Gmin\u001b[44G{min(t):.3f}\u001b[58Gmedian\u001b[65G{statistics.median(t):.3f}\u001b[92Gms/position')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write('QUIT\\n');\u001b[33Gp.stdin.flush();\u001b[50Gp.wait()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/agentlab/pvc/mj;\u001b[31Gpython3\u001b[39G-I\u001b[42G/tmp/mjprof/ab.py\u001b[60G.\u001b[62G/tmp/mjprof/pf_0\u001b[79G/tmp/mjprof/pf_64\u001b[97G/tmp/mjprof/pf_128\r\u001b[1B \u001b[2m\u2502\u001b[22m /tmp/mjpr\u001b[14Gf/pf_256 /tmp/mjprof/pf_512\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[562.615, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mcat\u001b[22m and \u001b[1mpython3 -I /tmp/mjprof/ab.py . /tmp/mjprof/pf_0 /tmp/mjprof/pf_64 \r\u001b[6C\u001b[1B/tmp/mjprof/pf_128 /tmp/mjprof/pf_256 /tmp/mjprof/pf_512\u001b[64G\u001b[22mcommands\u001b[73Gin\u001b[76G\u001b[1m/Users/agentlab/pvc/mj\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cance"]
