[116.247, "\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMemory bandwid\u001b[18Gh\u001b[20Gis capped near 63 GB/s, and per-l\u001b[54Gad tweaks\u001b[64Gdon't help. I'm\u001b[80Gnext\u001b[85Ginstrumenting\u001b[99Gargmax\u001b[106Gand\u001b[110Gthe\u001b[114GLOGITS\r\u001b[2C\u001b[1Bwrites,\u001b[11Gsince\u001b[17Gmatmul\u001b[24Gruns\u001b[29Gslightly\u001b[38Gslower\u001b[45Gin\u001b[48Gthe\u001b[52Greal\u001b[57Gprogram\u001b[65Gthan\u001b[70Gin\u001b[73Gthe\u001b[77Gmicrobenchmark.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Argmax costs about 40 \u00b5s per token and LOGITS writes about 60 \u00b5s per position, both small. The real gap is that\u001b[K\r\u001b[1B  matmuls run at ~60 GB/s inside the program versus 62.7 GB/s in the microbenchmark, so I'm building a copy whose\u001b[K\r\u001b[2C\u001b[1Bforward\u001b[11Gpass\u001b[16Gruns\u001b[21Gonly\u001b[26Gmatmuls\u001b[34Gto\u001b[37Gfind\u001b[42Gwhat\u001b[47Gslows\u001b[53Gthe\u001b[57Gstream.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping attention changes nothing, so interleaved work isn't the cause. Next\u001b[81GI'll check whe\u001b[96G"]
[116.247, "her the\u001b[104Ggap is\u001b[111Gjust\u001b[K\r\u001b[2C\u001b[1Bbest-of-N\u001b[13G(microbenchmark)\u001b[30Gversus\u001b[37Gmean\u001b[42G(in-program)\u001b[55Gtiming:\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mReporting microbenchmark\u001b[28Gmean\u001b[33Gvs\u001b[36Gbest\u001b[41Gtimings\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/mjprof && sed -e 's/ var best = Float64(1e18)/ var best = Float64(1e18)\\n var sum = Float64(0)/' -e 's/ \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mif dt < best: best = dt/ if dt < best: best = dt\\n sum += dt/' -e 's/ print(name, \"ms\", best \\/ 1e6, \"GB\\/s\", bytes\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m\\/ best)/ print(name, \"best ms\", best \\/ 1e6, \"mean ms\", sum \\/ 6e6, \u2026\u001b[77G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b"]
