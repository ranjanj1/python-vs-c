[810.376, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gper-head\u001b[16Gkernel\u001b[23Gis\u001b[26Gabout\u001b[32G25%\u001b[36Gfaster\u001b[43Gat\u001b[46Gshort\u001b[52Gcontexts,\u001b[62Gwhere\u001b[68Gq\u001b[70Gand\u001b[74Gthe\u001b[78Gaccumulator\u001b[90Gstay\u001b[95Gin\u001b[98Gregisters,\u001b[109Gbut\r\u001b[2C\u001b[1Bposition-major order\u001b[24Gwins\u001b[29Gbadly\u001b[35Gat\u001b[38Glong\u001b[43Gones\u001b[48G(1.56\u001b[54Gms\u001b[57Gvs\u001b[60G4.31\u001b[65Gms\u001b[68Gat\u001b[71G1024\u001b[76Gpositions).\u001b[88GI'm\u001b[92Gfinding\u001b[100Gthe\u001b[104Gcrossover\u001b[114Gpoint\r\u001b[2C\u001b[1Bso\u001b[6GI\u001b[8Gcan\u001b[12Gswitch\u001b[19Gkernels\u001b[27Gby\u001b[30Gcontext\u001b[38Glength.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmicrobenchmark's\u001b[24Gcrossover\u001b[34Gsits\u001b[39Gnear\u001b[44G150\u001b[48Gpositions,\u001b[59Gbut\u001b[63Git\u001b[66Greruns\u001b[73Gthe\u001b[77Gsame\u001b[82Gpositions\u001b[92Gand\u001b[96Gso\u001b[99Gflatters\u001b[108Gthe\u001b[112Gshort\r\u001b[2C\u001b[1Bcache, since the real\u001b[25Gprogram's\u001b[35G438\u001b[39GMB\u001b[42Gof\u001b[45Gweights\u001b[53Gevict\u001b[59Git\u001b[62Gbetween\u001b[70Gtokens.\u001b[78GI'll\u001b[83Gadd\u001b[87Gthe\u001b[91Gper-head\u001b[100Gkernel\u001b[107Gup\u001b[110Gto\u001b[113Ga\r\u001b[2C\u001b[1Bcompile-time\u001b[16Gthreshold\u001b[26Gand"]
[810.378, "\u001b[30Gconfirm\u001b[38Gthe\u001b[42Ggain\u001b[47Gunder\u001b[53Gthe\u001b[57Ginterleaved\u001b[69GA/B\u001b[73Gharness.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gshort-context\u001b[21Gkernel\u001b[28Gis\u001b[31Gslower\u001b[38Gin\u001b[41Gthe\u001b[45Greal\u001b[50Gprogram,\u001b[59Gso\u001b[62GI'm\u001b[66Greverting\u001b[76Git,\u001b[80Gand\u001b[84GI'll\u001b[89Gvectorize\u001b[99Gargmax\u001b[106Gnext,\u001b[112Gkeeping\r\u001b[2C\u001b[1Bits exact semantics and\u001b[27GNaN\u001b[31Gbehaviour.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gargmax\u001b[14Gcheck\u001b[20Gpasses,\u001b[28Gand\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[2C\u001b[1Binfinities and odd lengths.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero\u001b[8Gmismatches\u001b[19Gin\u001b[22G20,000\u001b[29Gadversarial\u001b[41Gtrials,\u001b[49Gso\u001b[52Gthe\u001b[56Gresult\u001b[63Gis\u001b[66Gthe\u001b[70Gsame\u001b[75Gas\u001b[78Grun.c's\u001b[86Gloop.\u001b"]
