[439.16, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChe\u001b[7Gk passes. I need an exact baseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[2C\u001b[1Bby\u001b[6Gundoing\u001b[14Gthe\u001b[18Gsingle\u001b[25Gedit:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mHead-major KV\u001b[17Gshows no gain, pos\u001b[36Gibly a loss,\u001b[49Gand the workload numbers are\u001b[78Gn\u001b[80Gisy. Before deciding,\u001b[102GI'\u001b[105Gl time the\r\u001b[2C\u001b[1Battenti\u001b[11Gn phase\u001b[19Gdirectly\u001b[28Gwith\u001b[33Gthe\u001b[37Ginstrumented\u001b[50Gbuilds\u001b[57Gat\u001b[60Gfull\u001b[65G1024\u001b[70Gcontext:\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102man \u001b[1m1\u001b[22m she\u001b[13Gl command \u001b[39m\u001b[K\r\u001b[2C\u001b[2BAttention i\u001b[15G only about\u001b[27G1% a\u001b[33Gthese l\u001b[41Gngths, so\u001b[51Greverting the\u001b[65Ghead-major KV\u001b[79Gchange keeps the r\u001b[98Gference layout. Next\u001b[K\r\u001b[2C\u001b[1BI'll run a\u001b[14Gmatmul-only copy\u001b[31Gof\u001b[34Gth"]
