[197.201, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[20G\u001b[22mvar\u001b[24Gvo\u001b[27G=\u001b[29Gself.value_cache.unsafe_offset(loff\u001b[65G+\u001b[67G(g\u001b[70G*\u001b[72Gseq_len\u001b[80G+\u001b[82Gpos)\u001b[87G*\u001b[89Ghead_size)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mfor\u001b[24Gj\u001b[26Gin\u001b[29Grange(head_size):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                    \u001b[24Gko[unsafe_offset=j]\u001b[44G=\u001b[46Gk[unsafe_offset=g\u001b[64G*\u001b[66Ghead_size\u001b[76G+\u001b[78Gj]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mvo[unsafe_offset=j]\u001b[44G=\u001b[46Gv[unsafe_offset=g\u001b[64G*\u001b[66Ghead_size\u001b[76G+\u001b[78Gj]\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G     # multihead attention, p\u001b[41Gsitio\u001b[47Gs 0..pos\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mvar\u001b[20Gnpos\u001b[25G=\u001b[27Gpos\u001b[31G+\u001b[33G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             for h in\u001b[25Grange(self.n_heads):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mvar\u001b[24Ghoff\u001b[29G=\u001b[31Gloff\u001b[36G+\u001b[38G(h\u001b[41G//\u001b[44Gkv_mul)\u001b[52G*\u001b[54Gseq_len\u001b[62G*\u001b[64Ghead_size\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G     \u001b[16G    var qh = self.q.unsafe_offset(h * he\u001b[57Gd_size)\u001b[65G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G   \u001b[15G  \u001b[18G  var att = self.att.unsafe_off\u001b[50Get(h * seq_len)\u001b[66G\u001b[K\r\u001b[1C\u001b[1B\u001b[2"]
[197.203, "m\u2502\u001b[22m       \u001b[11G    \u001b[16G    var kb = se\u001b[32Gf.key_cache.unsafe_offs\u001b[56Gt(hoff)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mvar\u001b[24Gvb\u001b[27G=\u001b[29Gself.value_cache.unsafe_offset(hoff)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 var xbh\u001b[28G=\u001b[30Gself.xb.unsafe_offset(h\u001b[54G*\u001b[56Ghead_size)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mif\u001b[23Ghead_size\u001b[33G==\u001b[36G64:\r\u001b[1B \u001b[2m\u2502\u001b[22m        \u001b[12G         \u001b[22G  \u001b[25Gtt\u001b[28Gnti\u001b[32Gn_head[64](qh, att, kb, vb, npos, xbh, sqrt_hs)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         \u001b[13G       \u001b[21Glif head_size == 128:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mattention_head[128](qh,\u001b[48Gatt,\u001b[53Gkb,\u001b[57Gvb,\u001b[61Gnpos,\u001b[67Gxbh,\u001b[72Gsqrt_hs)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 elif\u001b[25Ghead_size\u001b[35G==\u001b[38G32:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mattention_head[32](qh,\u001b[47Gatt,\u001b[52Gkb,\u001b[56Gvb,\u001b[60Gnpos,\u001b[66Gxbh,\u001b[71Gsqrt_hs)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G             elif head_size ==\u001b[38G16:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G   \u001b[14G   \u001b[18G      attention_head[16](qh, a\u001b[49Gt,\u001b[52Gkb,\u001b[56Gvb, npos, xbh, sqr\u001b[75G_hs)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[1"]
[197.204, "2G     \u001b[18G  else:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mattention_head_generic(qh,\u001b[51Gatt,\u001b[56Gkb,\u001b[60Gvb,\u001b[64Gnpos,\u001b[70Gxbh,\u001b[75Gsqrt_hs,\u001b[84Ghead_size)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'''+s[a1:]\r\u001b[1B \u001b[2m\u2502\u001b[22m open(p,'w').\u001b[21G(s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m mojo build mj.mojo\u001b[23G-o\u001b[26Gmj\u001b[29G2>&1\u001b[34G|\u001b[36Ggrep\u001b[41G-iA6\u001b[46G\"error\\|warning\"\u001b[63G|\u001b[65Ghead\u001b[70G-20;\u001b[75Gpython3\u001b[83Gcheck.py\u001b[92G--tokens\u001b[101G64\u001b[104G--prompts\u001b[114G3\u001b[116G--\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m./mj\u001b[9G|\u001b[11Gtail\u001b[16G-2;\u001b[20Gfor\u001b[24Gi\u001b[26Gin\u001b[29G1\u001b[31G2;\u001b[34Gdo\u001b[37Gpython3\u001b[45G-I\u001b[48G/tmp/mjtest/bench2.py\u001b[70G/tmp/mjtest/../mjprof/mj_g\u001b[97G.\u001b[99G2>/dev/null\u001b[111G|\u001b[113Ghead\r\u001b[1B \u001b[2m\u2502\u001b[22m -0; done; cp mj\u001b[20G/tmp/mjprof/mj_kv;\u001b[39Gfor\u001b[43Gi\u001b[45Gin\u001b[48G1\u001b[50G2;\u001b[53Gdo\u001b[56Gpython3\u001b[64G-I\u001b[67G/tmp/mjtest/bench2.py\u001b[89G./mj\u001b[94G.;\u001b[97Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[197.204, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
