[550.807, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck passes. I need an exact\u001b[33Gbaseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[2C\u001b[1Bby\u001b[6Gundoing\u001b[14Gthe\u001b[18Gsingle\u001b[25Gedit:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mHead-major KV shows no gain, possibly a loss, and the\u001b[57Gworkload numbers are noisy.\u001b[85GBefore\u001b[92Gdeciding,\u001b[102GI'll\u001b[107Gtime\u001b[112Gthe\r\u001b[2C\u001b[1Battention\u001b[13Gphase\u001b[19Gdirectly\u001b[28Gwith\u001b[33Gthe\u001b[37Ginstrumented\u001b[50Gbuilds\u001b[57Gat\u001b[60Gfull\u001b[65G1024\u001b[70Gcontext:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention is only about 1% at these lengths, so rever\u001b[57Ging\u001b[65Ghe\u001b[68Gd-major KV change keeps the ref\u001b[100Grence layout. Next\r\u001b[2C\u001b[1BI'll\u001b[8Grun\u001b[12Ga\u001b[14Gmatmul-only\u001b[26Gcopy\u001b[31Gof\u001b[34Gthe\u001b[38Gforward\u001b[46Gto\u001b[49Gsee\u001b[53Gwhether\u001b[61Gthe\u001b[65Gsmall\u001b[71Gops\u001b[75Gbet"]
[550.807, "ween\u001b[83Gmatmuls\u001b[91Gcause\u001b[97Gthe\u001b[101Ggap\u001b[105Gto\u001b[108G7.09\u001b[113Gms.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmul-only runs already sit at\u001b[35Gthe\u001b[39Gmemory\u001b[46Gceiling, so the ~0.18 ms\u001b[71Gof non-matmul work\u001b[90Gper position leaves\u001b[110Gthe bus\r\u001b[2C\u001b[1Bidle.\u001b[9GI'm\u001b[13Gchecking\u001b[22Gthe\u001b[26Gprefetch\u001b[35GAPI\u001b[39Gto\u001b[42Gsee\u001b[46Gwhether\u001b[54GI\u001b[56Gcan\u001b[60Gstream\u001b[67Gthe\u001b[71Gnext\u001b[76Gweight\u001b[83Gmatrix\u001b[90Ginto\u001b[95GL2\u001b[98Gduring\u001b[105Gthat\u001b[110Ggap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm adding\u001b[14Ga \u001b[17Gref\u001b[21Gtch_ahead helper that issu\u001b[48Gs one\u001b[54Gprefetch per 128-byt\u001b[75G line, call\u001b[87Gd at the\u001b[96Gstart\u001b[102Gof\u001b[105Geach\u001b[110Gof\u001b[113Gthe\u001b[117Gfour\r\u001b[2C\u001b[1Bnon-matmul\u001b[14Ggaps\u001b[19Gper\u001b[23Glayer,\u001b[30Gwith\u001b[35Gthe\u001b[39Gamount\u001b[46Gleft\u001b[51Gas\u001b[54Ga\u001b[56Gcompile-time\u001b[69Gparameter\u001b[79Gfor\u001b[83Gsweeping.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Sweeping next-matrix pre"]
