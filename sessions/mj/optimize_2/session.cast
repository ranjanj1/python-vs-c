[821.62, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gshort-context\u001b[21Gkernel\u001b[28Gis\u001b[31Gslower\u001b[38Gin\u001b[41Gthe\u001b[45Greal\u001b[50Gprogram,\u001b[59Gso\u001b[62GI'm\u001b[66Greverting\u001b[76Git,\u001b[80Gand\u001b[84GI'll\u001b[89Gvectorize\u001b[99Gargmax\u001b[106Gnext,\u001b[112Gkeeping\r\u001b[1B \u001b[3Gits\u001b[7Gexac\u001b[12G semantics a\u001b[25Gd NaN\u001b[31Gbehaviour.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gargmax\u001b[14Gcheck\u001b[20Gpasses,\u001b[28Gand\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[1B \u001b[3Ginfinities\u001b[14Gand odd lengths.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mZero\u001b[8Gmismatches\u001b[19Gin\u001b[22G20,000\u001b[29Gadversarial\u001b[41Gtrials,\u001b[49Gso\u001b[52Gthe\u001b[56Gresult\u001b[63Gis\u001b[66Gthe\u001b[70Gsame\u001b[75Gas\u001b[78Grun.c's\u001b[86Gloop.\u001b[92GMeasuring\u001b[102Gthe\u001b[106Ggain\u001b[111Gwith\u001b[116Gthe\r\u001b[1B \u001b[3Ginstrumented build\u001b[22Gand the interleaved A/B:\u001b[K\r\u001b[2C\u001b[1"]
[821.621, "B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gargmax\u001b[14Gchange\u001b[21Gcut\u001b[25Gthe\u001b[29Gper-call\u001b[38Gcost\u001b[43Gfrom\u001b[48G40.5\u001b[53Gto\u001b[56G3.6\u001b[60G\u00b5s,\u001b[64Gand\u001b[68Gthe\u001b[72Ginterleaved\u001b[84GA/B\u001b[88Gis\u001b[91Gat\u001b[94Gor\u001b[97Gslightly\u001b[106Gahead\u001b[112Gof\r\u001b[1B \u001b[3Gbaseline, which is within\u001b[29Gnoise. Next I'll check what \u001b[38;2;87;105;247mFileHandle.write_bytes\u001b[39m does, since \u001b[93Ghe 60 \u00b5s LOGITS write\u001b[115Glooks\r\u001b[2C\u001b[1Bslow for one kernel copy.\u001b[29G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gwrite\u001b[13Gloop\u001b[18Galready\u001b[26Gdoes\u001b[31Gthe\u001b[35Gminimum\u001b[43Gcopying,\u001b[52Gso\u001b[55Gthe\u001b[59G~60\u001b[63G\u00b5s\u001b[66Gis\u001b[69Gjust\u001b[74Gthe\u001b[78Gkernel\u001b[85Gfilling\u001b[93Gthe\u001b[97Gpage\u001b[102Gcache\u001b[108Gwith\u001b[113G128\u001b[117GKB,\r\u001b[1B \u001b[3Gand\u001b[7GI'm leaving it since memory-\u001b[36Gapping\u001b[43Gw\u001b[45Guld need libc\u001b[59GFFI\u001b[63Gfor under 1% gain. Next I'll run the fin\u001b[104Gl regression\u001b[117Gpass\r\u001b[2C\u001b[1Bo\u001b[5G the vectoriz"]
[821.622, "ed-argmax\u001b[28Gbuild.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11Gfull\u001b[16Gregression\u001b[27Gtests\u001b[33Gand\u001b[37Gsaving\u001b[44Gtools\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1B  \u23bf  $ cd /Users/agentlab/pvc/mj; mojo build mj.mojo -o mj 2>&1 | grep -ic \"error\\|warning\"; python3 check.py -- ./mj | \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mtail\u001b[11G-1; python3 check.py --tokens 64 --pro\u001b[50Gpts\u001b[54G3 -- ./mj;\u001b[65Gpython3 -I\u001b[76G/tmp/mjtest/t.py /Users/agentlab/pvc/mj 2>&1\r\u001b[5C\u001b[1B| grep -v \"^T \";\u001b[23Gpython3 -I /tmp/mjtest/ctx.\u001b[51Gy /Users/agentlab/pvc/mj\u2026 (3s \u00b7 3 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ct\u001b[10Gl+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
