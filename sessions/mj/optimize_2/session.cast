[872.592, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gargmax\u001b[14Gcheck\u001b[20Gpasses,\u001b[28Gand\u001b[32GI'm\u001b[36Gnow\u001b[40Gconfirming\u001b[51Git\u001b[54Gmatches\u001b[62Grun.c's\u001b[70Gscalar\u001b[77Gloop\u001b[82Gon\u001b[85Gtricky\u001b[92Ginputs\u001b[99Glike\u001b[104Gties,\u001b[110GNaNs,\r\u001b[1C\u001b[1B infinities \u001b[16Gd odd lengths.\u001b[31G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Zero mismatches in 20,000 adversarial trials, so the result is the same as\u001b[78Grun.c's loop. Measuring\u001b[102Gthe\u001b[106Ggain\u001b[111Gwith\u001b[116Gthe\r\u001b[1C\u001b[1B instrume\u001b[12Gt\u001b[15G build\u001b[22Gand\u001b[26Gthe\u001b[30Ginterleaved\u001b[42GA/B:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The argmax change cut the per-call\u001b[38Gcost\u001b[43Gfrom\u001b[48G40.5\u001b[53Gto\u001b[56G3.6\u001b[60G\u00b5s,\u001b[64Gand\u001b[68Gthe\u001b[72Ginterleaved\u001b[84GA/B\u001b[88Gis\u001b[91Gat\u001b[94Gor\u001b[97Gslightly\u001b[106Gahead\u001b[112Gof\r\u001b[1C\u001b[1B baseline, which is\u001b[22Gwi\u001b[25Ghin\u001b[29Gnoise. N\u001b[38Gxt I'll check what\u001b[57G\u001b[38;2;87;105;247mFileHandle.w"]
[872.594, "rite_bytes\u001b[39m does, since\u001b[92Gthe 60 \u00b5s\u001b[102GLOGITS\u001b[109Gwrite\u001b[115Glooks\r\u001b[1C\u001b[1B slow\u001b[8Gfor one\u001b[16Gkern\u001b[21Gl copy.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gwrite\u001b[13Gloop\u001b[18Galready\u001b[26Gdoes\u001b[31Gthe\u001b[35Gminimum\u001b[43Gcopying,\u001b[52Gso\u001b[55Gthe\u001b[59G~60\u001b[63G\u00b5s\u001b[66Gis\u001b[69Gjust\u001b[74Gthe\u001b[78Gkernel\u001b[85Gfilling\u001b[93Gthe\u001b[97Gpage\u001b[102Gcache\u001b[108Gwith\u001b[113G128\u001b[117GKB,\r\u001b[1C\u001b[1B and I'm leav\u001b[16Gng i\u001b[21G since memory-mapping would need libc FFI for under 1%\u001b[76Ggain. Next I'll run the final\u001b[106Gregression\u001b[117Gpass\r\u001b[1C\u001b[1B on\u001b[6Gthe vectorized-argmax build.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything passes,\u001b[22Ga\u001b[24Gd the log\u001b[34Gt errors ar\u001b[46G unchanged beca\u001b[62Gse argmax doesn't\u001b[80Gtouch the log\u001b[94Gts. Updating\u001b[107GNOTES.md:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Appending\u001b[13Gpass\u001b[18G3\u001b[20Gprofiling\u001b[30Gnotes\u001b[36Gto\u001b[39GNOTES.md\r\u001b[1B"]
