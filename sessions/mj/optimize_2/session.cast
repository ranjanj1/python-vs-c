[552.931, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCheck\u001b[9Gpasses.\u001b[17GI\u001b[19Gneed\u001b[24Gan\u001b[27Gexact\u001b[33Gbaseline\u001b[42Gfrom\u001b[47Gthe\u001b[51Gstart\u001b[57Gof\u001b[60Gthis\u001b[65Gpass,\u001b[71Gso\u001b[74GI'll\u001b[79Grebuild\u001b[87Git\u001b[90Gfrom\u001b[95Gthe\u001b[99Gsaved\u001b[105Gexperiment\u001b[116Gcopy\r\u001b[2C\u001b[1Bby undoing the single\u001b[25Gedit:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mHead-major\u001b[14GKV\u001b[17Gshows\u001b[23Gno\u001b[26Ggain,\u001b[32Gpossibly\u001b[41Ga\u001b[43Gloss,\u001b[49Gand\u001b[53Gthe\u001b[57Gworkload\u001b[66Gnumbers\u001b[74Gare\u001b[78Gnoisy.\u001b[85GBefore\u001b[92Gdeciding,\u001b[102GI'll\u001b[107Gtime\u001b[112Gthe\r\u001b[2C\u001b[1Battention phase directly\u001b[28Gwith\u001b[33Gthe\u001b[37Ginstrumented\u001b[50Gbuilds\u001b[57Gat\u001b[60Gfull\u001b[65G1024\u001b[70Gcontext:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gis\u001b[16Gonly\u001b[21Gabout\u001b[27G1%\u001b[30Gat\u001b[33Gthese\u001b[39Glengths,\u001b[48Gso\u001b[51Greverting\u001b[61Gthe\u001b[65Ghead-major\u001b[76GKV\u001b[79Gch"]
