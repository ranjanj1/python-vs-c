[166.723, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Measuring file write cost by chunk size\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -I - <<'EOF'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mimport os, time, tempfile\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102md = tempfile.mkdtemp(); buf = os.urandom(128000)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mfor chunk in (1, 8, 32):\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mbest = 1e9\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mfor _ in range(5):\r\u001b[5C\u001b[1Bt = time.perf_counter(); fd = os.open(d + '/x', os.O_WRONLY | os.O_CREAT | os.O_TRUNC)\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mbig = buf * chunk\r\u001b[5C\u001b[1Bfor _ in range(460 // chunk): os.write(fd\u2026\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[166.724, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mMeasure file write cost by chunk size\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m python3 -I\u001b[15G- <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m impo\u001b[9Gt\u001b[11Gos, time,\u001b[21Gtempfile\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22md\u001b[6G=\u001b[8Gtempfile.mkdtemp();\u001b[28Gbuf\u001b[32G=\u001b[34Gos.urandom(128000)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for chunk in (1, 8, 32):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mbest\u001b[13G=\u001b[15G1e9\r\u001b[1B \u001b[2m\u2502\u001b[22m     for\u001b[12G_ in range(5):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         t = time.perf_count\u001b[33G();\u001b[37Gfd =\u001b[42Gos.o\u001b[47G"]
[166.725, "en(d + '/x', os.O_WRONLY\u001b[72G|\u001b[74Gos.O_CREAT\u001b[85G|\u001b[87Gos.O_TRUNC)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbig\u001b[16G=\u001b[18Gbuf\u001b[22G*\u001b[24Gchunk\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for _ in range(460\u001b[31G//\u001b[34Gchunk):\u001b[42Gos.write(fd,\u001b[55Gbig)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mos.close(fd);\u001b[26Gbest\u001b[31G=\u001b[33Gmin(best,\u001b[43Gtime.perf_counter()\u001b[63G-\u001b[65Gt)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G print(f'{chunk:2d} positions per write: {best*1e3:.1f} ms for\u001b[70G{460//chunk*chunk} positi\u001b[96Gns =\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m {b\u001b[7Gst/(460//chunk*chunk)*1e6:.0f} us/position')\u001b[52G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[26G\u001b[K\r"]
