[23.934, "\u2502\u001b[22m             elif name == 'readinto_mv_slice':\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m                 a = array('f', [0.0]) * nfl; mv = memoryview(a).cast('B'); got = f.readinto(mv[0:])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22melse:\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     \u001b[13G   \u001b[17G   a = array('f');\u001b[36Ga.fromfile(f,\u001b[50Gnfl);\u001b[56Ggot\u001b[60G=\u001b[62G4\u001b[64G*\u001b[66Glen(a)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mprint(sys.implementation.name,\u001b[43Gname,\u001b[49G'ok',\u001b[55Ggot\u001b[59G==\u001b[62G4\u001b[64G*\u001b[66Gnfl,\u001b[71Ground(time.perf_counter()\u001b[97G-\u001b[99Gt0,\u001b[103G3),\u001b[107Ga[12345])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  except Exception as e:\u001b[31G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      print(sys.implementation.name, nam\u001b[47G, 'ERR', type(e).__name__,\u001b[74Ge)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  a = None\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m $PYPY -I /tmp/p1bench/pypyload.py;\u001b[39Gpython3\u001b[47G-I\u001b[50G/tmp/p1bench/pypyload.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[23.934, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m A var\u001b[8Gable\u001b[13Gin this command\u001b[29Gcan't\u001b[35Gbe\u001b[38Gchecked\u001b[46Gbefore\u001b[53Git\u001b[56Gruns\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
