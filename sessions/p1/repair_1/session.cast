[450.566, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[12G\u001b[22mout[i]=v0;out[i+1]=v1;out[i+2]=v2;out[i+3]=v3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  return out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef IDX():  # plain in\u001b[28Gxe\u001b[31G scalar loop, no\u001b[48Gslicing\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  out=[0.0]*d\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gi\u001b[14Gin\u001b[17Grange(d):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   b=i*n; v=0.0\u001b[25G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gj\u001b[18Gin\u001b[21Grange(n):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             v+=W[b+j]*x[j]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout[i]=v\r\u001b[1B \u001b[2m\u2502\u001b[22m     return out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8GIDX4():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     out=[0.0]*d\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gi\u001b[14Gin\u001b[17Grange(0,d,4):\r\u001b[1B \u001b[2m\u2502\u001b[22m         b0=i*n;\u001b[20Gb1=b0+n; b2=b1+n; b3=b2+n; v0=v1=v2=v3=0.0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   for j in range(n):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mc=x[j]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             v0+=W[b0+j]*c;\u001b[31Gv1+=W[b1+j]*c;\u001b[46Gv2+=W[b2+j]*c;\u001b[61Gv3+=W[b3+j]*c\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout[i]=v0;out[i+1]=v1;out[i+2]=v2;out[i+3]=v3\r\u001b[1B \u001b[2m\u2502\u001b["]
[450.567, "22m   \u001b[7G r\u001b[10Gturn out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ref=C4()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gf\u001b[10Gin\u001b[13G(C4,IDX,IDX4):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     best=1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12G_\u001b[14Gin\u001b[17Grange(5):\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8G    s=tim\u001b[18G.perf_counter(); r=f(); best=min(best,time.perf_counter()-s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     assert r==ref, f.__name__\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(f\"{sys.implementation.name:7s}\u001b[45G{f.__name__:5s}\u001b[61G{best*1e9/(n*d):6.2f}\u001b[83Gns/MAC\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin/pypy3\u001b[71G-I\u001b[74G/tmp/p1bench/pk.py;\u001b[94Gpython3\u001b[102G-I\r\u001b[1B \u001b[2m\u2502\u001b[22m /tmp/p1bench/pk.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
