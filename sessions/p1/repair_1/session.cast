[45.61, "\u001b[H\u001b[3G-\u001b[5GInner sums are still\u001b[26Gaccumulat\u001b[36Gd in Python's\u001b[50G64-bit\u001b[57Gfloats\u001b[64Gand\u001b[68Grounded\u001b[76Gto\u001b[79Gfloat32\u001b[87Gwhen\u001b[92Gstored.\u001b[100GThat's\u001b[107Gwhy\u001b[111Gthe\u001b[115Glogits\r\u001b[4C\u001b[1Bdiffer\u001b[12Gslightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md\u001b[12Gnow\u001b[16Ghas\u001b[20Ga\u001b[22Gsection\u001b[30Gfor\u001b[34Gthis\u001b[39Gpass\u001b[44Gwith\u001b[49Gthe\u001b[53Gcost\u001b[58Gbreakdown,\u001b[69Gthe\u001b[73GA/B\u001b[77Gtimings,\u001b[86Gthe\u001b[90Gloader\u001b[97Gcomparison\u001b[108Gand\u001b[112Gthe\u001b[116Gtest\r\u001b[2C\u001b[1Bresults.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GSaut\u00e9ed for 8m 9s \u00b7 done 2:57 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mThe\u001b[7Gimplementation failed\u001b[29Gthis\u001b[34Gcheck: (1) decod\u001b[51G d\u001b[54Gffers for 2 tokens, first 3: \u001b[38;2;87;105;247mPIECE 0 3\u001b[38;2;0;0;0m and \u001b[38;2;87;105;247mPIECE 1 3\u001b[38;2;0;0;0m answered \u001b[38;2;87;105;247mHEX \r\u001b[2C\u001b[1B00\u001b[38;2;0;0;0m, the reference answers \u001b[38;2;87;105;247mHEX \u001b[38;2;0;0;0m with nothing after it. (2) The same run.py, unchanged, must a\u001b[96Gso start on PyPy 7.3"]
[45.611, ".21 \r\u001b[2C\u001b[1B(/Users/Shared/pvc-k\u001b[24Gt/py/pypy-3.11.15-mac\u001b[46Gs-a\u001b[50Grch64\u001b[56Gnone/bin/pypy3 -I run.py);\u001b[83Git stops at load with: line\u001b[111G50,\u001b[116Gn\r\u001b[2C\u001b[1B__in\u001b[8Gt__: k = f.\u001b[20Geadinto(mv[got:]) Typ\u001b[42GError: a read-write bytes-like object is required, not 'memoryview'. Fix it \r\u001b[1B\u001b[39m  \u001b[38;2;0;0;0mwithin the same rules and remaining step budget.\u001b[39m                                                                      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTwo\u001b[7Gfixes\u001b[13Gare\u001b[17Gneeded:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6G\u001b[38;2;87;105;247m\u001b[1mPIECE\u001b[39m for byte 0x00:\u001b[22m the refer\u001b[37Gnce\u001b[41Gdecod\u001b[47Gs \u001b[50Gnto\u001b[54Ga C string,\u001b[66Gwhich\u001b[72Gends\u001b[77Gat\u001b[80Ga\u001b[82GNUL\u001b[86Gbyte,\u001b[92Gso\u001b[95G\u001b[38;2;87;105;247m<0x00>\u001b[102G\u001b[39mcomes\u001b[108Gout\u001b[112Gempty.\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;87;105;247mrun.py\u001b[39m needs\u001b[19Gto cut decod\u001b[32Gd\u001b[34Gpieces at the f\u001b[50Grst\u001b[54GNUL.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPyPy loader:\u001b[19G\u001b[22mPyPy\u001b[24Gwon't\u001b[30Glet\u001b[34G\u001b[38;2;87;105;247mreadinto\u001b[43G\u001b[39mwrite\u001b[49Ginto\u001b[54Ga\u001b[56Gslice\u001b["]
[45.612, "62Gof\u001b[65Ga\u001b[67Gcast\u001b[72Gmemoryview.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFirst\u001b[9GI'll\u001b[14Gcheck\u001b[20Gwhat\u001b[25GPyPy\u001b[30Gaccepts:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247m/tmp/p1bench\u001b[16G\u001b[39mseems\u001b[22Gto\u001b[25Gbe\u001b[28Ggone\u001b[33G(probably\u001b[43Gcleaned\u001b[51Gbetween\u001b[59Gsessions).\u001b[70GI'll\u001b[75Grecreate\u001b[84Git\u001b[87Gand\u001b[91Gretry:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m \u001b[10Ghell comma\u001b[21Gd \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mf.readinto(data)\u001b[39m reads straight\u001b[35Ginto\u001b[40Gthe\u001b[44Garray\u001b[50Gin\u001b[53Gone\u001b[57Gcall\u001b[62Gon\u001b[65Gboth\u001b[70Ginterpreters,\u001b[84Gwith\u001b[89G\u001b[38;2;87;105;247mfromfile\u001b[98G\u001b[39mas\u001b[101Gthe\u001b[105Gfallback\u001b[114Gon\u001b[117Ga\r\u001b[2C\u001b[1Bshort read. I'll also make decode stop at\u001b[45Gthe\u001b[49Gfirst\u001b[55GNUL\u001b[59Gbyte,\u001b[65Gas\u001b[68GC\u001b[70Gstrings\u001b[78Gdo.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3GTemp\u001b[38;2;245;149;117meri\u001b[38;2;215;119;87mn"]
