[497.781, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mf.readinto(data)\u001b[20G\u001b[39mreads\u001b[26Gstraight\u001b[35Ginto\u001b[40Gthe\u001b[44Garray\u001b[50Gin\u001b[53Gone\u001b[57Gcall\u001b[62Gon\u001b[65Gboth\u001b[70Ginterpreters,\u001b[84Gwith\u001b[89G\u001b[38;2;87;105;247mfromfile\u001b[98G\u001b[39mas\u001b[101Gthe\u001b[105Gfallback\u001b[114Gon\u001b[117Ga\r\u001b[2C\u001b[1Bshort read. I'll also\u001b[25Gmake\u001b[30Gdecode\u001b[37Gstop\u001b[42Gat\u001b[45Gthe\u001b[49Gfirst\u001b[55GNUL\u001b[59Gbyte,\u001b[65Gas\u001b[68GC\u001b[70Gstrings\u001b[78Gdo.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow\u001b[7Gthe\u001b[11Gsame\u001b[16Gprotocol\u001b[25Gscript\u001b[32Gon\u001b[35Gboth\u001b[40Ginterpreters,\u001b[54Gcovering\u001b[63Gthe\u001b[67Gfailing\u001b[75GPIECE\u001b[81Gcases,\u001b[88Gother\u001b[94GPIECEs,\u001b[102GENCODE,\u001b[110GFIXED,\r\u001b[2C\u001b[1BLOGITS and GENERATE.\u001b[24GI'll\u001b[29Gdiff\u001b[34Gstdout\u001b[41Gand\u001b[45Gthe\u001b[49GLOGITS\u001b[56Gfiles\u001b[62Gbetween\u001b[70Gthem:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Ginterpreters\u001b[21Gproduce\u001b[29Gidentical\u001b[39Goutput,\u001b[47Gbut\u001b[51GPyPy\u001b[56Gruns\u001b[61Gthis\u001b[66G"]
[497.781, "script\u001b[73Gfar\u001b[77Gslower\u001b[84G(265.8\u001b[91Gs\u001b[93Gagainst\u001b[101G107.0\u001b[107Gs\u001b[109Gon\u001b[112GCPython),\r\u001b[2C\u001b[1Bprobably because the\u001b[24Gloop\u001b[29Gshapes\u001b[36GI\u001b[38Gtuned\u001b[44Gfor\u001b[48GCPython\u001b[56Gdon't\u001b[62Gsuit\u001b[67GPyPy's\u001b[74GJIT.\u001b[79GNext\u001b[84GI'm\u001b[88Gprinting\u001b[97Gthe\u001b[101GPIECE\u001b[107Glines.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mPIECE 0 3\u001b[13G\u001b[39mand\u001b[17G\u001b[38;2;87;105;247mPIECE 1 3\u001b[27G\u001b[39mnow\u001b[31Greturn\u001b[38Gjust\u001b[43G\u001b[38;2;87;105;247mHEX \u001b[39m,\u001b[49Gwhile\u001b[55Gother\u001b[61Gbyte\u001b[66Gpieces\u001b[73Gare\u001b[77Gunchanged.\u001b[88GNext\u001b[93GI'll\u001b[98Grun\u001b[102Ga\u001b[104Gquick\u001b[110GPyPy\r\u001b[2C\u001b[1Bmicro-benchmark of matmul\u001b[29Gloop\u001b[34Gshapes\u001b[41Gto\u001b[44Gsee\u001b[48Gwhether\u001b[56Gone\u001b[60Gloop\u001b[65Gworks\u001b[71Gfor\u001b[75Gboth\u001b[80Ginterpreters.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPyPy and CPython favour opposite loop shapes:\u001b[49Gthe\u001b[53Gcurrent\u001b[61Gzip\u001b[65Gkernel\u001b[72Gis\u001b[75Gslow\u001b[80Gon\u001b[83GPyPy\u001b[88G(47.8\u001b[94Gns/M"]
