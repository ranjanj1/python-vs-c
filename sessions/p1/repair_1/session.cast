[569.853, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u273b\u001b[3G\u001b[38;2;219;123;91mTempering\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
[569.972, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow the same protocol script on both interpr\u001b[48Gters, covering the failing PIECE\u001b[81Gcases,\u001b[88Gother\u001b[94GPIECEs,\u001b[102GENCODE,\u001b[110GFIXED,\r\u001b[2C\u001b[1BLOGITS\u001b[10Gand\u001b[14GGENERATE.\u001b[24GI'll\u001b[29Gdiff\u001b[34Gstdout\u001b[41Gand\u001b[45Gthe\u001b[49GLOGITS\u001b[56Gfiles\u001b[62Gbetween\u001b[70Gthem:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth interpreters produce\u001b[29Gidentical output, but PyPy\u001b[56Gru\u001b[59Gs this script far slower\u001b[84G(265.8 s against\u001b[101G107.0\u001b[107Gs on CPython),\r\u001b[2C\u001b[1Bprobably\u001b[12Gbecause\u001b[20Gthe\u001b[24Gloop\u001b[29Gshapes\u001b[36GI\u001b[38Gtuned\u001b[44Gfor\u001b[48GCPython\u001b[56Gdon't\u001b[62Gsuit\u001b[67GPyPy's\u001b[74GJIT.\u001b[79GNext\u001b[84GI'm\u001b[88Gprinting\u001b[97Gthe\u001b[101GPIECE\u001b[107Glines.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mPIECE 0 3\u001b[39m and \u001b[38;2;87;105;247mPIECE 1 3\u001b[39m now return jus\u001b[42G"]
[569.972, " \u001b[38;2;87;105;247mHEX \u001b[39m, whil\u001b[54G oth\u001b[59Gr byte pieces are unchanged. N\u001b[90Gxt I'll\u001b[98Grun\u001b[102Ga\u001b[104Gquick\u001b[110GPyPy\r\u001b[2C\u001b[1Bmicro-benchmark\u001b[19Gof\u001b[22Gmatmul\u001b[29Gloop\u001b[34Gshapes\u001b[41Gto\u001b[44Gsee\u001b[48Gwhether\u001b[56Gone\u001b[60Gloop\u001b[65Gworks\u001b[71Gfor\u001b[75Gboth\u001b[80Ginterpreters.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPyPy\u001b[8Gand CPython favour\u001b[27Gopposite\u001b[36Gloop shap\u001b[46Gs: the current\u001b[61Gzip kernel is\u001b[75Gslow\u001b[82G PyPy (47.8 n\u001b[96G/MAC)\u001b[102Gw\u001b[104Gile th\u001b[111G indexed\r\u001b[2C\u001b[1Bloop is fast th\u001b[19Gre (3.9 ns/MAC), and the reverse\u001b[52Gholds\u001b[58Gon\u001b[61GCPython.\u001b[70GI'll\u001b[75Gkeep\u001b[80Gone\u001b[84G\u001b[38;2;87;105;247mrun.py\u001b[91G\u001b[39mand\u001b[95Gselect\u001b[102Gthe\u001b[106Gkernel\u001b[113Gat\r\u001b[2C\u001b[1Bimport\u001b[10Gtime\u001b[15Gbased\u001b[21Gon\u001b[24G\u001b[38;2;87;105;247msys.implementation.name\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mO\u001b[6GPyPy\u001b[11Gthe sc\u001b[18Gipt now\u001b[26Gtakes\u001b[32G23.4\u001b[37Gs\u001b[39Ginstead\u001b["]
