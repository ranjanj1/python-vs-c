[602.439, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u00b7\u001b[41G\u001b[38;2;173;173;173mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[602.559, "\u001b[H\r\u001b[11C\u001b[33B\u001b[38;2;245;149;117m\u2026\u001b[41G\u001b[38;2;169;169;169mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
