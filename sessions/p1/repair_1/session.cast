[602.11, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[19G\u001b[38;2;102;102;102m2\u001b[39m\u001b[40;1H\u001b[38;3H"]
[602.214, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[41G\u001b[38;2;181;181;181mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
