[18.115, "\u001b[H\u001b[5Gconverting rows to\u001b[24Glists\u001b[30Gjust\u001b[35Gbefore\u001b[42Guse\u001b[53G27\u201333\r\u001b[2C\u001b[1B\u2502 (\u001b[38;2;87;105;247mtolist()\u001b[39m)                                    \u2502                                                                 \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[4C\u001b[1B8 rows per\u001b[16Gpass\u001b[53Gslower\u001b[60Gin\u001b[63Gthe\u001b[67Greal\u001b[72Gmodel:\u001b[79G2.33\u001b[84Gvs\u001b[87G2.28\u001b[92Gs/token,\u001b[101G3.22\u001b[106Gvs\u001b[109G2.88\u001b[114Gs\r\u001b[2C\u001b[1B\u2502                                               \u2502 at position 1000                                                \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500"]
[18.116, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOther per-command costs (cache reset, argmax, encoding) are each under 0.2% of one forward pass, so I left them alone.\r\u001b[2C\u001b[2B\u001b[1mWhat changed:\u001b[22m the\u001b[21Gl\u001b[23Gader now read\u001b[37G \u001b[39Ghe checkpoi\u001b[51Gt straight into a pr\u001b[72G-sized\u001b[79Gfloat32 a\u001b[89Gr\u001b[91Gy.\u001b[94GBefore, it\u001b[105Gbuilt a\u001b[K\r\u001b[2C\u001b[1Btemporary\u001b[13G438\u001b[17GMB\u001b[20Gcopy\u001b[25Gfirst.\u001b[32GThe\u001b[36GKV\u001b[39Gcaches\u001b[46Gare\u001b[50Gallocated\u001b[60Gthe\u001b[64Gsame\u001b[69Gway.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests:\u001b[22m checker PASS at 57.1 s; my command sc\u001b[48Gipt (all six comm\u001b[66Gnds, 45\u001b[74Gforward\u001b[82Gpasses)\u001b[90Gruns\u001b[95Gin\u001b[98G105.5\u001b[104Gs\u001b[106Gwith\u001b[111Goutput\u001b[118Gand\r\u001b[2C\u001b[1BLOGITS\u001b[10Gfile\u001b[15Gidentical\u001b[25Gto\u001b[28Gthe\u001b[32Goriginal;\u001b[42Glogits\u001b[49Gare\u001b[53Gbit-identical\u001b[67Gacross\u001b[74Gversions.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRemaining limitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G"]
[18.117, "Weights\u001b[13Gkept\u001b[18Gpermanently\u001b[30Gas\u001b[33GPython\u001b[40Glists\u001b[46Gwould\u001b[52Gbe\u001b[55Gabout\u001b[61G20%\u001b[65Gfaster,\u001b[73Gbut\u001b[77Gneed\u001b[82Gabout\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGiB\u001b[109Gmachine.\u001b[118GI\r\u001b[2C\u001b[1B  still judge that too\u001b[26Grisky.\r\u001b[4C\u001b[1BInner \u001b[12Gums are still accumulated in Py\u001b[44Ghon's 64-bit floats and rounded to flo\u001b[83Gt32 when\u001b[92Gstored. That's why t\u001b[113Ge logits\r\u001b[4C\u001b[1Bdiffer sligh\u001b[18Gly fr\u001b[24Gm\u001b[26Gthe C reference.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md\u001b[12Gnow \u001b[17Gas a section\u001b[30Gfo\u001b[33G this pass\u001b[44Gwith\u001b[49Gthe\u001b[53Gcost\u001b[58Gbreakdown,\u001b[69Gthe\u001b[73GA/B\u001b[77Gtimings,\u001b[86Gthe\u001b[90Gloader\u001b[97Gcomparison\u001b[108Gand\u001b[112Gthe\u001b[116Gtest\r\u001b[2C\u001b[1Bresults.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GSaut\u00e9ed for 8m 9s \u00b7 done 2:57 PM\r\u001b[2B\u001b[48;2;240;240;240m\u276f \u001b[38;2;0;0;0mThe implementation failed this check: (1) decode differs for 2 tokens, first 3: \u001b[38;2;87;105;247mPIECE 0 3\u001b[38;2;0;0;0m and \u001b[38;2;87;105;247mPIECE 1 3\u001b[38;2;0;0;0m answered \u001b[38;2;87;105;247mHEX \u001b[39m \r\u001b[1B  \u001b[38;2;87;105;247m00\u001b["]
