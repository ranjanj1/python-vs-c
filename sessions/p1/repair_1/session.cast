[0.662, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Gunpacking\u001b[15Ginterleaved\u001b[27Gweights\u001b[35Gwith\u001b[51G\u2502\u001b[53G21.8\u201323.9\u001b[117G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[5G\u001b[38;2;87;105;247mstruct.iter_unpack\u001b[51G\u001b[39m\u2502\u001b[117G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Gconverting\u001b[16Grows\u001b[21Gto\u001b[24Glists\u001b[30Gjust\u001b[35Gbefore\u001b[42Guse\u001b[51G\u2502\u001b[53G27\u201333\u001b[117G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[5G(\u001b[38;2;87;105;247mtolist()\u001b[39m)\u001b[51G\u2502\u001b[117G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.663, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5G8\u001b[7Grows\u001b[12Gper\u001b[16Gpass\u001b[51G\u2502\u001b[53Gslower\u001b[60Gin\u001b[63Gthe\u001b[67Greal\u001b[72Gmodel:\u001b[79G2.33\u001b[84Gvs\u001b[87G2.28\u001b[92Gs/token,\u001b[101G3.22\u001b[106Gvs\u001b[109G2.88\u001b[114Gs\u001b[117G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[51G\u2502\u001b[53Gat\u001b[56Gposition\u001b[65G1000\u001b[117G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[2BOther\u001b[9Gper-command\u001b[21Gcosts\u001b[27G(cache\u001b[34Greset,\u001b[41Gargmax,\u001b[49Gencoding)\u001b[59Gare\u001b[63Geach\u001b[68Gunder\u001b[74G0.2%\u001b[79Gof\u001b[82Gon"]
[0.663, "e\u001b[86Gforward\u001b[94Gpass,\u001b[100Gso\u001b[103GI\u001b[105Gleft\u001b[110Gthem\u001b[115Galone.\r\u001b[2C\u001b[2B\u001b[1mWhat changed:\u001b[17G\u001b[22mthe\u001b[21Gloader\u001b[28Gnow\u001b[32Greads\u001b[38Gthe\u001b[42Gcheckpoint\u001b[53Gstraight\u001b[62Ginto\u001b[67Ga\u001b[69Gpre-sized\u001b[79Gfloat32\u001b[87Garray.\u001b[94GBefore,\u001b[102Git\u001b[105Gbuilt\u001b[111Ga\r\u001b[2C\u001b[1Btemporary\u001b[13G438\u001b[17GMB\u001b[20Gcopy\u001b[25Gfirst.\u001b[32GThe\u001b[36GKV\u001b[39Gcaches\u001b[46Gare\u001b[50Gallocated\u001b[60Gthe\u001b[64Gsame\u001b[69Gway.\r\u001b[2C\u001b[2B\u001b[1mTests:\u001b[10G\u001b[22mchecker\u001b[18GPASS\u001b[23Gat\u001b[26G57.1\u001b[31Gs;\u001b[34Gmy\u001b[37Gcommand\u001b[45Gscript\u001b[52G(all\u001b[57Gsix\u001b[61Gcommands,\u001b[71G45\u001b[74Gforward\u001b[82Gpasses)\u001b[90Gruns\u001b[95Gin\u001b[98G105.5\u001b[104Gs\u001b[106Gwith\u001b[111Goutput\u001b[118Gand\r\u001b[2C\u001b[1BLOGITS\u001b[10Gfile\u001b[15Gidentical\u001b[25Gto\u001b[28Gthe\u001b[32Goriginal;\u001b[42Glogits\u001b[49Gare\u001b[53Gbit-identical\u001b[67Gacross\u001b[74Gversions.\r\u001b[2C\u001b[2B\u001b[1mRemaining limitations:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GWeights\u001b[13Gkept\u001b[18Gpermanently\u001b[30Gas\u001b[33GPython\u001b[40Glists\u001b[46Gwould\u001b[52Gbe\u001b[55Gabout\u001b[61G20%\u001b[65Gfaster,\u001b[73Gbut\u001b[77Gneed\u001b[82Gabout\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGiB\u001b[109Gmachine.\u001b[118GI\r\u001b[4C\u001b[1Bstill\u001b[11Gjudge"]
[0.664, "\u001b[17Gthat\u001b[22Gtoo\u001b[26Grisky.\r\u001b[2C\u001b[1B-\u001b[5GInner\u001b[11Gsums\u001b[16Gare\u001b[20Gstill\u001b[26Gaccumulated\u001b[38Gin\u001b[41GPython's\u001b[50G64-bit\u001b[57Gfloats\u001b[64Gand\u001b[68Grounded\u001b[76Gto\u001b[79Gfloat32\u001b[87Gwhen\u001b[92Gstored.\u001b[100GThat's\u001b[107Gwhy\u001b[111Gthe\u001b[115Glogits\r\u001b[4C\u001b[1Bdiffer\u001b[12Gslightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference.\r\u001b[2C\u001b[2BNOTES.md\u001b[12Gnow\u001b[16Ghas\u001b[20Ga\u001b[22Gsection\u001b[30Gfor\u001b[34Gthis\u001b[39Gpass\u001b[44Gwith\u001b[49Gthe\u001b[53Gcost\u001b[58Gbreakdown,\u001b[69Gthe\u001b[73GA/B\u001b[77Gtimings,\u001b[86Gthe\u001b[90Gloader\u001b[97Gcomparison\u001b[108Gand\u001b[112Gthe\u001b[116Gtest\r\u001b[2C\u001b[1Bresults.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GSaut\u00e9ed for 8m 9s \u00b7 done 2:57 PM\r\u001b[102C\u001b[1B\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m\u276f\u00a0\u001b[7m"]
