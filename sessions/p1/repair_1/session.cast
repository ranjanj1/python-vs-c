[432.139, "\u001b[H\u001b[3G1.\u001b[6G\u001b[38;2;87;105;247m\u001b[1mPIECE\u001b[39m for byte 0x00:\u001b[22m the refer\u001b[37Gnce\u001b[41Gdecod\u001b[47Gs \u001b[50Gnto\u001b[54Ga C string,\u001b[66Gwhich\u001b[72Gends\u001b[77Gat\u001b[80Ga\u001b[82GNUL\u001b[86Gbyte,\u001b[92Gso\u001b[95G\u001b[38;2;87;105;247m<0x00>\u001b[102G\u001b[39mcomes\u001b[108Gout\u001b[112Gempty.\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;87;105;247mrun.py\u001b[39m needs\u001b[19Gto cut decod\u001b[32Gd\u001b[34Gpieces at the f\u001b[50Grst\u001b[54GNUL.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPyPy loader:\u001b[19G\u001b[22mPyPy\u001b[24Gwon't\u001b[30Glet\u001b[34G\u001b[38;2;87;105;247mreadinto\u001b[43G\u001b[39mwrite\u001b[49Ginto\u001b[54Ga\u001b[56Gslice\u001b[62Gof\u001b[65Ga\u001b[67Gcast\u001b[72Gmemoryview.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BFirst\u001b[9GI'll\u001b[14Gcheck\u001b[20Gwhat\u001b[25GPyPy\u001b[30Gaccepts:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247m/tmp/p1bench\u001b[16G\u001b[39mseems\u001b[22Gto\u001b[25Gbe\u001b[28Ggone\u001b[33G(probably\u001b[43Gcleaned\u001b[51Gbetween\u001b[59Gsessions).\u001b[70GI'll\u001b[75Grecreate\u001b[84Git\u001b[87Gand\u001b[91Gretry:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mf.readinto(data)"]
[432.14, "\u001b[20G\u001b[39mreads straight into the array \u001b[51Gn one call on\u001b[65Gboth\u001b[70Ginterpreters,\u001b[84Gwith\u001b[89G\u001b[38;2;87;105;247mfromfile\u001b[98G\u001b[39mas\u001b[101Gthe\u001b[105Gfallback\u001b[114Gon\u001b[117Ga\r\u001b[2C\u001b[1Bshort\u001b[9Gread.\u001b[15GI'll\u001b[20Galso\u001b[25Gmake\u001b[30Gdecode\u001b[37Gstop\u001b[42Gat\u001b[45Gthe\u001b[49Gfirst\u001b[55GNUL\u001b[59Gbyte,\u001b[65Gas\u001b[68GC\u001b[70Gstrings\u001b[78Gdo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow the same protocol script on both interpr\u001b[48Gters, covering the failing PIECE\u001b[81Gcases,\u001b[88Gother\u001b[94GPIECEs,\u001b[102GENCODE,\u001b[110GFIXED,\r\u001b[2C\u001b[1BLOGITS\u001b[10Gand\u001b[14GGENERATE.\u001b[24GI'll\u001b[29Gdiff\u001b[34Gstdout\u001b[41Gand\u001b[45Gthe\u001b[49GLOGITS\u001b[56Gfiles\u001b[62Gbetween\u001b[70Gthem:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running protocol workload on CPython and PyPy, comparing\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/p1bench && PYPY=/Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin/pypy3\r\u001b[5C\u001b[1Bfor impl in cpy pypy; do cat > work_$impl.txt <<EOF\r\u001b[11C\u001b[1B0\r\u001b[13C\u001b[1B3\u001b[39m\u001b[K\r\u001b[11C\u001b[1B\u001b[38;2;102;102;102m1 9038\r\u001b"]
[432.14, "[11C\u001b[1B26\u001b[15G 13\r\u001b[11C\u001b[1B3\u001b[14G300\r\u001b[5C\u001b[1BPIECE 1 4\u001b[39m\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;102;102;102mOnce upon a\u001b[25Gtime, there was a little girl named Lily.\r\u001b[6C\u001b[1BNCODE\u001b[13Gh\u00e9llo w\u00f6rld \u2603 \u65e5\u672c\r\u001b[5C\u001b[1BE\u2026\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
