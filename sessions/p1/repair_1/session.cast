[58.157, "ench && PYPY=/Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin/pypy3\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m for impl in cpy pypy; do cat > work_$impl.txt <<EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mPIECE\u001b[10G0\u001b[12G3\r\u001b[1B \u001b[2m\u2502\u001b[22m PIECE 1 3\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mPIECE\u001b[10G1\u001b[12G9038\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m PIECE 263 13\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mPIECE 3 300\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m PIECE 1 4\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mENCODE\u001b[11GOnce\u001b[16Gupon\u001b[21Ga\u001b[23Gtime,\u001b[29Gthere\u001b[35Gwas\u001b[39Ga\u001b[41Glittle\u001b[48Ggirl\u001b[53Gnamed\u001b[59GLily.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ENCODE h\u00e9llo w\u00f6rld \u2603\u001b[25G\u65e5\u672c\u001b[30G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mENCODE\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m FIXED 1 9038 2501 263\u001b[26G931\u001b[30G29892\u001b[36G727\u001b[40G471\u001b[44G263\u001b[48G2217\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mLOGITS\u001b[11G/tmp/p1bench/lg_$impl.f32\u001b[37G1\u001b[39G9038\u001b[44G2501\u001b[49G263\u001b[53G931\r\u001b[1B \u001b[2m\u2502\u001b[22m GENERATE 24\u001b[16GOnce up\u001b[24Gn a\u001b[28Gtim\u001b[33G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mGENERATE\u001b[13G1\u001b[15GThe\u001b[19Gcat\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m QUIT\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m done\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b"]
[58.157, "[22m /usr/bin/time -p python3 -I /Us\u001b[36Gr\u001b[38G/agen\u001b[44Glab/pvc/p1/run.p\u001b[61G /Users/agentlab/pvc/p1/model.bin\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/Users/agentlab/pvc/p1/tokenizer.bin\u001b[41G<\u001b[43Gwork_cpy.txt\u001b[56G>\u001b[58Gout_cpy.txt\u001b[70G2>\u001b[73Gtime_cpy.txt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m /usr/bin/time -p $PYPY\u001b[27G-I\u001b[30G/Users/agentlab/pvc/p1/run.py\u001b[60G/Users/agentlab/pvc/p1/model.bin\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/Users/agentlab/pvc/p1/tokenizer.bin\u001b[41G<\u001b[43Gwork_pypy.txt\u001b[57G>\u001b[59Gout_pypy.txt\u001b[72G2>\u001b[75Gtime_pypy.txt\r\u001b[1B \u001b[2m\u2502\u001b[22m cat -A\u001b[11Gout_pypy.txt 2>/dev/null | \u001b[39Gead -8 || head\u001b[54G-8 out_pypy.txt; echo ...;\u001b[81Gt\u001b[83Gil -3 out_pypy.txt\u001b[102G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m diff out_cpy.txt out_pypy.txt\u001b[34G&& echo \"stdout identica\u001b[59G CPython vs PyPy\";\u001b[78Gcmp\u001b[82Glg_cpy.f32\u001b[93Glg_pypy.f32\u001b[105G&&\u001b[108Gecho\u001b[113G\"LOGITS\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22midentical\u001b[14GCPython\u001b[22Gvs\u001b[25GPyPy\";\u001b[32Gcat\u001b[36Gtime_pypy.txt\u001b[50G|\u001b[52Ggrep\u001b[57G-v\u001b[60G'^$'\u001b[65G|\u001b[67Gtail\u001b[72G-4;\u001b[76Ggrep\u001b[81Greal\u001b[86Gtime_cpy.txt\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c"]
[58.158, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
