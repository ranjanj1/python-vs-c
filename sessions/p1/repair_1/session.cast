[589.739, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn PyPy\u001b[11Gthe script\u001b[22Gnow takes 23.4 s instead of 265.8 \u001b[57G, with stdout and\u001b[75GLOGITS identical to\u001b[95GCPython. Now th\u001b[111G checker\r\u001b[2C\u001b[1Bon bo\u001b[9Gh \u001b[12Gnterpr\u001b[19Gters:\u001b[K\r\u001b[2C\u001b[4BBoth tes\u001b[12Gs pass now, \u001b[25Gi\u001b[27Gh the same logi\u001b[43G err\u001b[48Grs. The\u001b[57Gupplied check.py missed the PIECE 0 3\u001b[95Gcase, so\u001b[104GI verified that\r\u001b[4C\u001b[1Be directly, and I'm\u001b[25Gupdating\u001b[34GNOTES.md\u001b[43Gnext.\r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m5\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 244 \u001b[22m   The only faster layout I measured is weights kept permanently as Python float lists\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m 245 \u001b[22m   (about 16 ns/MAC, roughly 20% faster). It costs about 3.5 GB, which I judged too much\r\u001b[5C\u001b[1B\u001b[2m 246 \u001b[22m   for this 8 GiB machine.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;207;34;"]
[589.74, "46m\u001b[48;2;255;220;220m 247 -\u001b[38;2;51;51;51m- PIECE for the `<0x00>` byte token prints `HEX 00` (the decoded byte). C's `safe_printf`             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 248 -\u001b[38;2;51;51;51m  would treat that piece as an empty string.                                                          \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 247 +\u001b[38;2;51;51;51m- PIECE follows C string semantics: decoded pieces end at the first NUL byte, so the                  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 248 +\u001b[38;2;51;51;51m  `<0x00>` byte token (id 3) answers `HEX ` with nothing after it, like the reference. Before         \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 249 +\u001b[38;2;51;51;51m  session 4 it answered `HEX 00`, which failed an external check.                                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 250 +\u001b[38;2;51;51;51m- On PyPy, compute uses a different (indexed) scalar kernel, selected at import time. Both            \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 251 +\u001b[38;2;51;51;51m  kernels give bit-identical re"]
[589.741, "sults.                                                                 \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 252 \u001b[22m - Inputs longer than seq_len: FIXED/LOGITS process only the first seq_len ids. GENERATE reports\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 253 \u001b[22m   `context`. `GENERATE 0 \u2026` answers `DONE 0 max` without running the model.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[589.742, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;102;102;102m\u2026\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mNOTES.md\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;"]
[589.742, "102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[589.756, "\u001b[H\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 249 +\u001b[38;2;51;51;51m   | `array.fromfile` | ok, 0.09 s | ok, 0.43 s |                                                                 \r\u001b[1B\u001b[38;2;36;138;61m 250 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 251 +\u001b[38;2;51;51;51m3. **PyPy kernel:** with the crash fixed, PyPy ran the protocol script about 2.5x slower than                     \r\u001b[1B\u001b[38;2;36;138;61m 252 +\u001b[38;2;51;51;51m   CPython (265.8 s vs 107.0 s). The zip-over-array-slices loop tuned for CPython is a bad                        \r\u001b[1B\u001b[38;2;36;138;61m 253 +\u001b[38;2;51;51;51m   shape for PyPy's JIT. Micro-benchmark at 768x2048, ns per multiply-add:                                        \r\u001b[1B\u001b[38;2;36;138;61m 254 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 255 +\u001b[38;2;51;51;51m   | kernel | P"]
[589.763, "yPy | CPython |                                                                                    \r\u001b[1B\u001b[38;2;36;138;61m 256 +\u001b[38;2;51;51;51m   |---|---|---|                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 257 +\u001b[38;2;51;51;51m   | zip over 4 array slices (`_dots_zip`) | 47.8 | 20.6 |                                                        \r\u001b[1B\u001b[38;2;36;138;61m 258 +\u001b[38;2;51;51;51m   | indexed loop, 1 row per pass | 4.6 | 46.9 |                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 259 +\u001b[38;2;51;51;51m   | indexed loop, 4 rows per pass (`_dots_indexed`) | 3.9 | 39.2 |                                               \r\u001b[1B\u001b[38;2;36;138;61m 260 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 261 +\u001b[38;2;51;51;51m   `run.py` keeps both and picks one at import time with `sys.implementation.name`.        "]
[589.764, "                       \r\u001b[1B\u001b[38;2;36;138;61m 262 +\u001b[38;2;51;51;51m   Both are explicit scalar loops with the same per-row left-to-right summation, so the                           \r\u001b[1B\u001b[38;2;36;138;61m 263 +\u001b[38;2;51;51;51m   results are bit-identical (asserted in the benchmark, and confirmed end to end below).                         \r\u001b[1B\u001b[38;2;36;138;61m 264 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 265 +\u001b[38;2;51;51;51mResults:                                                                                                          \r\u001b[1B\u001b[38;2;36;138;61m 266 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 267 +\u001b[38;2;51;51;51m| test\u001b[14G| result |   \u001b[28G \u001b[30G      \u001b[37G          \u001b[48G       \u001b[56G      \u001b[63G   \u001b[67G  \u001b[70G   \u001b[74G     \u001b[80G   \u001b[84G     \u001b[90G  \u001b[93G   \u001b[114G       \r\u001b[1B\u001b[38"]
[589.766, ";2;36;138;61m 268 +\u001b[38;2;51;51;51m|---|---|      \u001b[23G    \u001b[28G     \u001b[34G   \u001b[38G  \u001b[41G       \u001b[49G    \u001b[54G \u001b[56G    \u001b[61G       \u001b[69G     \u001b[75G   \u001b[79G    \u001b[84G   \u001b[88G          \u001b[99G      \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 269 +\u001b[38;2;51;51;51m| PIECE 0 3 / PIECE\u001b[27G1 3 (CPython and PyPy) |\u001b[52G`HEX `\u001b[59G/ `HEX ` | \u001b[71G      \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 270 +\u001b[38;2;51;51;51m| protocol script stdout, CPython vs PyPy | identical |  \u001b[65G       \u001b[73G        \u001b[82G  \u001b[85G      \u001b[92G     \u001b[98G    \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 271 +\u001b[38;2;51;51;51m| LOGITS file (5 x 32000), CPython v\u001b[44G PyPy\u001b[50G|\u001b[52Gbitwise\u001b[60Gidentical\u001b[70G|\u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 272 +\u001b[38;2;51;51;51m| protocol script wall time | CPython 107.0 s, PyPy 265.8 s \u2192 **23.4 s** with the indexed kernel |                \r\u001b[1B\u001b[38;2;36;138;61m 273 +\u001b[38;2;51;51;51m| `check.py -- python3 -I run.py` | PASS, 58.8 s (errors 1.14e-5 / 1.53e-5 / 1.62e-5) |                           \r\u001b[1B\u001b[38;2;36;138;61m 274 +\u001b[38;2;51;51"]
[589.766, ";51m| `check.py -- pypy3 -I run.py` | PASS, 10.9 s (same errors) |                                                    \r\u001b[1B\u001b[38;2;36;138;61m 275 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;36;138;61m 276 +\u001b[38;2;51;51;51mThe supplied `check.py` passed even with the old `HEX 00` answer, so it doesn't cover that                        \r\u001b[1B\u001b[38;2;36;138;61m 277 +\u001b[38;2;51;51;51mcase. I verified it directly with the PIECE lines above.                                                          \r\u001b[1B\u001b[38;2;36;138;61m 278 +\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[49m\u001b[2m 279 \u001b[22m ## Precision (limitation)\r\u001b[1B\u001b[2m 280 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 281 \u001b[22m The Python standard library has no float32 scalar arithmetic. All stored tensors are float32:\u001b[39m\u001b[40;1H\u001b[36;2H\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[589.767, "\u001b]0;\u25d0 Claude Code\u0007"]
[589.772, "\u001b[H\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m PyPy and CPython favour opposite loop shapes: the current zip kernel is slow on PyPy (47.8 ns/MAC) while the indexed\u001b[K\r\u001b[1B  loop is fast there (3.9 ns/MAC), and the reverse holds on CPython. I'll keep one \u001b[38;2;87;105;247mrun.py\u001b[39m and select the kernel at\u001b[K\r\u001b[1B  import time based on \u001b[38;2;87;105;247msys.implementation.name\u001b[39m.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m On PyPy the script now takes 23.4 s instead of 265.8 s, with stdout and LOGITS identical to CPython. Now the checker\u001b[K\r\u001b[1B  on both interpreters:\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Both tests pass now, with the same logit errors. The supplied check.py missed the PIECE 0 3 case, so I verified that\u001b[K\r\u001b[1B  one directly, and I'm updating NOTES.md next.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mA"]
[589.773, "dded \u001b[1m5\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 244 \u001b[22m   The only faster layout I measured is weights kept permanently as Python float lists\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 245 \u001b[22m   (about 16 ns/MAC, roughly 20% faster). It costs about 3.5 GB, which I judged too much\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 246 \u001b[22m   for this 8 GiB machine.\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 247 -\u001b[38;2;51;51;51m- PIECE for the `<0x00>` byte token prints `HEX 00` (the decoded byte). C's `safe_printf`             \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 248 -\u001b[38;2;51;51;51m  would treat that piece as an empty string.                                                          \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 247 +\u001b[38;2;51;51;51m- PIECE follo\u001b[26Gs C\u001b[30Gstring\u001b[37Gsemantics: decoded pieces end\u001b[67Gat the first\u001b[80GNUL byt\u001b[88G, so the\u001b[97G      \u001b[104G \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 248 "]
[589.773, "+\u001b[38;2;51;51;51m  `<0x00>` byte token (id 3)\u001b[41Ganswers\u001b[49G`HEX\u001b[54G`\u001b[56Gwith nothing after it, like\u001b[84Gthe reference.\u001b[99GBefore\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 249 +\u001b[38;2;51;51;51m  session\u001b[22G4 it answered `HEX\u001b[41G00`, which\u001b[52Gfailed an external\u001b[71Gcheck.\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 250 +\u001b[38;2;51;51;51m-\u001b[14GOn\u001b[17GPyPy,\u001b[23Gcompute\u001b[31Guses\u001b[36Ga\u001b[38Gdifferent\u001b[48G(indexed)\u001b[58Gscalar\u001b[65Gkernel,\u001b[73Gselected\u001b[82Gat\u001b[85Gimport\u001b[92Gtime.\u001b[98GBoth\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 251 +\u001b[38;2;51;51;51m  kernels give bit-identical results.  \u001b[52G   \u001b[56G    \u001b[61G   \u001b[65G       \u001b[73G  \u001b[76G  \u001b[79G       \u001b[87G     \u001b[93G    \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 252 \u001b[22m - Inputs longer than seq_len: FIXED/LOGITS process only the first seq_len ids. GENERATE reports\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 253 \u001b[22m   `context`. `GENERATE 0 \u2026` answers `DONE 0 max` without running the model."]
[589.774, "\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m \u001b[1mUpdate\u001b[22m(NOTES.md)\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[39m \u001b[38;2;215;119;87mTempering\u2026 \u001b[38;2;102;102;102m(9m 40s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m10.4k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[589.774, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
[589.786, "\u001b[H\u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 250 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 251 +\u001b[38;2;51;51;51m3. **PyPy kernel:** with the crash fixed, PyPy ran the protocol script about 2.5x slower than         \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 252 +\u001b[38;2;51;51;51m   CPython (265.8 s vs 107.0 s). The zip-over-array-slices loop tuned for CPython is a bad            \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 253 +\u001b[38;2;51;51;51m   shape for PyPy's JIT. Micro-benchmark at 768x2048, ns per multiply-add:                            \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 254 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 255 +\u001b[38;2;51;51;51m   | kernel | PyPy | CPython |                                                                        \r\u001b[2"]
[589.787, "C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 256 +\u001b[38;2;51;51;51m   |---|---|---|                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 257 +\u001b[38;2;51;51;51m   | zip over 4 array slices (`_dots_zip`) | 47.8 | 20.6 |                                            \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G  \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 258 +\u001b[38;2;51;51;51m   | indexed loop, 1 row per pass | 4.6 | 46.9 |                                                      \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 259 +\u001b[38;2;51;51;51m   | indexed loop, 4 rows per pass (`_dots_indexed`) | 3.9 | 39.2 |                                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 260 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 261 +\u001b[38;2;51;51;51m   `run.py` keeps both and picks one at import time with `sys.implementation.name`.         "]
[589.788, "          \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 262 +\u001b[38;2;51;51;51m   Both are explicit scalar loops with the same per-row left-to-right summation, so the               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 263 +\u001b[38;2;51;51;51m   results are bit-identical (asserted in the benchmark, and confirmed end to end below).             \u001b[115G\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 264 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 265 +\u001b[38;2;51;51;51mResults:                                                                                              \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 266 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 267 +\u001b[38;2;51;51;51m| test | result |                                                              "]
[589.788, "                       \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 268 +\u001b[38;2;51;51;51m|---|---|                                                                                             \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 269 +\u001b[38;2;51;51;51m| PIECE 0 3 / PIECE 1 3 (CPython and PyPy) | `HEX ` / `HEX ` |                                        \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 270 +\u001b[38;2;51;51;51m| protocol script stdout, CPython vs PyPy | identical |                                               \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 271 +\u001b[38;2;51;51;51m| LOGITS file (5 x 32000), CPython vs PyPy | bitwise identical |                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 272 +\u001b[38;2;51;51;51m| protocol script wall time | CPython 107.0 s, PyPy 265.8 s \u2192 **23.4 s** with the indexed kernel |    \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m73\u001b[12G\u001b[38;2;51;51;51m|\u001b[14G`check.py -- python3 -I run.py` |\u001b[48GPASS, 58.8 s (errors 1.14e-5 / 1.53e-5 / 1.62e-5)\u001b[98G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m74\u001b[12G\u001b[38;2;51;51;51m|\u001b[15Gcheck.py -- pypy3 -I run.py` | PASS, 10.9 s (s"]
[589.789, "ame errors) |\u001b[75G   \u001b[79G    \u001b[84G   \u001b[88G          \u001b[99G      \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m75\u001b[14G\u001b[38;2;51;51;51m       \u001b[22G \u001b[24G  \u001b[27G        \u001b[36G    \u001b[41G    \u001b[46G     \u001b[52G      \u001b[59G  \u001b[62G        \u001b[71G      \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m76\u001b[12G\u001b[38;2;51;51;51mThe supplied `check.py`\u001b[36Gpassed even\u001b[48Gw\u001b[50Gth the old `HEX 00` answ\u001b[75Gr, so it doesn'\u001b[92Gcov\u001b[96Gr\u001b[98Gthat\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m77\u001b[12G\u001b[38;2;51;51;51mcas\u001b[16G. I ver\u001b[24Gfied it \u001b[33Girectly\u001b[41Gwith \u001b[47Ghe\u001b[50GPIECE\u001b[56Glines\u001b[62Gabove.\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 278 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[7C\u001b[1B\u001b[49m\u001b[2m79\u001b[12G\u001b[22m## Precision\u001b[25G(limitation)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 280 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 281 \u001b[22m The Python standard library has no float32 scalar arithmetic. All stored tensors are float32:\u001b[39m\u001b[40;1H\u001b[38;3H"]
