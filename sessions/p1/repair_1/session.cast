[503.274, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow\u001b[7Gthe\u001b[11Gsame\u001b[16Gprotocol\u001b[25Gscript\u001b[32Gon\u001b[35Gboth\u001b[40Ginterpreters,\u001b[54Gcovering\u001b[63Gthe\u001b[67Gfailing\u001b[75GPIECE\u001b[81Gcases,\u001b[88Gother\u001b[94GPIECEs,\u001b[102GENCODE,\u001b[110GFIXED,\r\u001b[1B \u001b[3GLOGITS and GENERATE. I'll diff stdout and th\u001b[48G LOGITS files between them:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Ginterpreters\u001b[21Gproduce\u001b[29Gidentical\u001b[39Goutput,\u001b[47Gbut\u001b[51GPyPy\u001b[56Gruns\u001b[61Gthis\u001b[66Gscript\u001b[73Gfar\u001b[77Gslower\u001b[84G(265.8\u001b[91Gs\u001b[93Gagainst\u001b[101G107.0\u001b[107Gs\u001b[109Gon\u001b[112GCPython),\r\u001b[1B \u001b[3Gprobably because the loop\u001b[29Gshapes I tuned for CPython\u001b[56Gdo\u001b[59G't suit PyPy's JIT. Next\u001b[84GI'm printing the\u001b[101GPIECE\u001b[107Glines.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mPIECE 0 3\u001b[13G\u001b[39mand\u001b[17G\u001b[38;2;87;105;247mPIECE 1 3\u001b[27G\u001b[39"]
[503.275, "mnow\u001b[31Greturn\u001b[38Gjust\u001b[43G\u001b[38;2;87;105;247mHEX \u001b[39m,\u001b[49Gwhile\u001b[55Gother\u001b[61Gbyte\u001b[66Gpieces\u001b[73Gare\u001b[77Gunchanged.\u001b[88GNext\u001b[93GI'll\u001b[98Grun\u001b[102Ga\u001b[104Gquick\u001b[110GPyPy\r\u001b[1B \u001b[3Gmicro-benchmark of matmul loop shapes \u001b[42Go see wheth\u001b[54Gr on\u001b[59G loop works for both interpret\u001b[90Grs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPyPy\u001b[8Gand\u001b[12GCPython\u001b[20Gfavour\u001b[27Gopposite\u001b[36Gloop\u001b[41Gshapes:\u001b[49Gthe\u001b[53Gcurrent\u001b[61Gzip\u001b[65Gkernel\u001b[72Gis\u001b[75Gslow\u001b[80Gon\u001b[83GPyPy\u001b[88G(47.8\u001b[94Gns/MAC)\u001b[102Gwhile\u001b[108Gthe\u001b[112Gindexed\r\u001b[1B \u001b[3Gloop\u001b[8Gis fast there (3.9\u001b[27Gns/MAC),\u001b[36Gand the r\u001b[46Gverse holds on\u001b[61GCPython. I'll\u001b[75Gkeep\u001b[82Ge \u001b[38;2;87;105;247mrun.py\u001b[39m and \u001b[96Gelect\u001b[102Gt\u001b[104Ge kern\u001b[111Gl at\u001b[K\r\u001b[2C\u001b[1Bimport time bas\u001b[19Gd on \u001b[38;2;87;105;247msys.implementation.name\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn\u001b[6GPyPy\u001b[11Gthe\u001b[15Gscript"]
[503.275, "\u001b[22Gnow\u001b[26Gtakes\u001b[32G23.4\u001b[37Gs\u001b[39Ginstead\u001b[47Gof\u001b[50G265.8\u001b[56Gs,\u001b[59Gwith\u001b[64Gstdout\u001b[71Gand\u001b[75GLOGITS\u001b[82Gidentical\u001b[92Gto\u001b[95GCPython.\u001b[104GNow\u001b[108Gthe\u001b[112Gchecker\r\u001b[1B \u001b[3Go\u001b[6Gboth\u001b[11Ginterp\u001b[18Geters:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11Gchecker\u001b[19Gunder\u001b[25GCPython\u001b[33Gand\u001b[37GPyPy\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ (time python3 check.py -- python3\u001b[42G-I run.py) > /tmp/p1bench/check_cpy.log 2>&1; cat /tmp/p1bench/check_cpy.log; \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m(time python3 check.py -- /Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin\u001b[93Gpy\u001b[96Gy3 -I run.py) > \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m/\u001b[8Gmp/p1bench/check_pypy.log 2>&1; c\u001b[42Gt /tmp/p1bench\u001b[57Gcheck_pypy.log (3\u001b[75G)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
