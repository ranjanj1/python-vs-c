[440.774, "\u001b[H\u001b[3G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m seems to\u001b[25Gbe gone (\u001b[35Grobably\u001b[43Gcleaned\u001b[51Gbetween\u001b[59Gsessions).\u001b[70GI'll\u001b[75Grecreate\u001b[84Git\u001b[87Gand\u001b[91Gretry:\r\u001b[2C\u001b[4B\u001b[38;2;87;105;247mf.readinto(data)\u001b[39m reads straight into the array in on\u001b[56G call on both\u001b[70Ginterpret\u001b[80Grs,\u001b[84Gwith \u001b[38;2;87;105;247mfromfile\u001b[98G\u001b[39mas\u001b[101Gthe\u001b[105Gfallback\u001b[114Gon\u001b[117Ga\r\u001b[2C\u001b[1Bshort\u001b[9Gread.\u001b[15GI'll\u001b[20Galso\u001b[25Gmake\u001b[30Gdecode\u001b[37Gstop\u001b[42Gat\u001b[45Gthe\u001b[49Gfirst\u001b[55GNUL\u001b[59Gbyte,\u001b[65Gas\u001b[68GC\u001b[70Gstrings\u001b[78Gdo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNow \u001b[8Ghe same protocol\u001b[25Gscript on both interpr\u001b[48Gters, covering the failing PIECE cases,\u001b[88Gother\u001b[94GPIECEs,\u001b[102GENCODE,\u001b[110GFIXED,\r\u001b[2C\u001b[1BLOGITS\u001b[10Gand\u001b[14GGENERATE.\u001b[24GI'll\u001b[29Gdiff\u001b[34Gstdout\u001b[41Gand\u001b[45Gthe\u001b[49GLOGITS\u001b[56Gfiles\u001b[62Gbetween\u001b[70Gthem:\r\u001b[2C\u001b[1B\u001b[K\r\u001b["]
[440.775, "2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth interpreters produce\u001b[29Gidentical output, but PyPy\u001b[56Gruns this script far\u001b[77Gslower\u001b[84G(265.8\u001b[91Gs\u001b[93Gagainst\u001b[101G107.0\u001b[107Gs\u001b[109Gon\u001b[112GCPython),\r\u001b[2C\u001b[1Bprobably\u001b[12Gbecause\u001b[20Gthe\u001b[24Gloop\u001b[29Gshapes\u001b[36GI\u001b[38Gtuned\u001b[44Gfor\u001b[48GCPython\u001b[56Gdon't\u001b[62Gsuit\u001b[67GPyPy's\u001b[74GJIT.\u001b[79GNext\u001b[84GI'm\u001b[88Gprinting\u001b[97Gthe\u001b[101GPIECE\u001b[107Glines.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Showing PIECE output lines with end markers\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ head -7 /tm\u001b[20G/p1bench/\u001b[30Gut_pypy.txt | sed 's/$/|/'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBas"]
