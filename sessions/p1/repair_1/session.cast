[31.095, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mls\u001b[7G/tmp/p1bench\u001b[20G2>&1\u001b[25G|\u001b[27Ghead\u001b[32G-3;\u001b[36Gmkdir\u001b[42G-p\u001b[45G/tmp/p1bench\u001b[58G&&\u001b[61Gcat\u001b[65G>\u001b[67G/tmp/p1bench/pypyload.py\u001b[92G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import sys,\u001b[16Gos,\u001b[20Gtim\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m from array\u001b[15Gimport\u001b[22Garray\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mP\u001b[6G=\u001b[8G'/Users/agentlab/pvc/p1/model.bin'\r\u001b[1B \u001b[2m\u2502\u001b[22m nfl = (os.path.getsize(P) - 28)\u001b[36G//\u001b[39G4\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gname\u001b[13Gin\u001b[16G('readinto_array',\u001b[35G'readinto_mv_slice',\u001b[56G'fromfile'):\r\u001b[1B \u001b[2m\u2502\u001b[22m     t0 = time.perf_counter()\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     try:\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         with open(P, 'rb') as f:\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m             f.seek(28)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m             if name == 'readinto_array':\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22ma\u001b[22G=\u001b[24Garray('f',\u001b[35G[0.0])\u001b[42G*\u001b[44Gnfl;\u001b[49Ggot\u001b[53G=\u001b[55Gf.readinto(a)\r\u001b[1B \u001b[2m\u2502\u001b[22m "]
[31.096, "  \u001b[7G     \u001b[13G   elif name\u001b[26G==\u001b[29G'readinto_mv_slice':\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22ma\u001b[22G=\u001b[24Garray('f',\u001b[35G[0.0])\u001b[42G*\u001b[44Gnfl;\u001b[49Gmv\u001b[52G=\u001b[54Gmemoryview(a).cast('B');\u001b[79Ggot\u001b[83G=\u001b[85Gf.readinto(mv[0:])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G          else:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      \u001b[13G     \u001b[19G a\u001b[22G= array('f'); a.fromfile(f, nfl); got\u001b[60G=\u001b[62G4\u001b[64G*\u001b[66Glen(a)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G      print(sys.implementa\u001b[33Gion.name,\u001b[43Gname,\u001b[49G'ok', got ==\u001b[62G4 * nfl, round(tim\u001b[81G.perf_counter()\u001b[97G-\u001b[99Gt0,\u001b[103G3),\u001b[107Ga[12345])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mexcept\u001b[15GException\u001b[25Gas\u001b[28Ge:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   print(sys.implementation.name,\u001b[43Gname,\u001b[49G'ERR',\u001b[56Gtype(e).__name__,\u001b[74Ge)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22ma\u001b[10G=\u001b[12GNone\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin/pypy3\u001b[71G-I\u001b[74G/tmp/p1bench/pypyload.py;\u001b[100Gpython3\u001b[108G-I\r\u001b[1B \u001b[2m\u2502\u001b[22m /tmp/p1bench/pypyload.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c"]
