[24.362, "\u001b[H\u001b[3G\u001b[1mRemaining limitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GWeights kept permanently as Python lists would be\u001b[55Gabout\u001b[61G20%\u001b[65Gfaster,\u001b[73Gbut\u001b[77Gneed\u001b[82Gabout\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGiB\u001b[109Gmachine.\u001b[118GI\r\u001b[4C\u001b[1Bstill\u001b[11Gjudge\u001b[17Gthat\u001b[22Gtoo\u001b[26Grisky.\r\u001b[1B  - Inner sums are still accumulated in Python's 64-bit floats and rounded to float32 when stored. That's why the logits\r\u001b[1C\u001b[1B   differ slightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B NOTES.md now has a section for this pass\u001b[44Gwith\u001b[49Gthe\u001b[53Gcost\u001b[58Gbreakdown,\u001b[69Gthe\u001b[73GA/B\u001b[77Gtimings,\u001b[86Gthe\u001b[90Gloader\u001b[97Gcomparison\u001b[108Gand\u001b[112Gthe\u001b[116Gtest\r\u001b[1B  results.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mSaut\u00e9ed for 8m 9s \u00b7 done 2:57 PM\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mThe implementation failed this check: (1) decode differs for 2 tokens, first 3: \u001b[38;2;87;105;247mPIECE 0 3\u001b[38;2;0;0;0m and \u001b[38;2;87;105;247mPIECE 1 3\u001b[38;2;0;0;"]
[24.363, "0m answered \u001b[38;2;87;105;247mHEX \u001b[39m \r\u001b[1B  \u001b[38;2;87;105;247m00\u001b[38;2;0;0;0m, the reference answers \u001b[38;2;87;105;247mHEX \u001b[38;2;0;0;0m with nothing after it. (2) The same run.py, unchanged, must also start on PyPy 7.3.21 \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0m(/Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin/pypy3 -I run.py); it stops at load with: line 50, in \u001b[39m   \r\u001b[1B  \u001b[38;2;0;0;0m__init__: k = f.readinto(mv[got:]) TypeError: a read-write bytes-like object is required, not 'memoryview'. Fix it \u001b[39m   \r\u001b[1B  \u001b[38;2;0;0;0mwithin the same rules and remaining step budget.\u001b[39m                                                                      \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Two\u001b[7Gfixes are\u001b[17Gne\u001b[20Gded:\u001b[25G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B 1.\u001b[6G\u001b[38;2;87;105;247m\u001b[1mPIECE\u001b[39m for byte 0x00:\u001b[27G\u001b[22mth\u001b[30G reference decodes\u001b[49Ginto\u001b[54Ga\u001b[56GC\u001b[58Gstring,\u001b[66Gwhich\u001b[72Gends\u001b[77Gat\u001b[80Ga\u001b[82GNUL\u001b[86Gbyte,\u001b[92Gso\u001b[95G\u001b[38;2;87;105;247m<0x00>\u001b[102G\u001b[39mcomes\u001b[108Gout\u001b[112Gempty.\r\u001b[1C\u001b[1B \u001b[6"]
[24.364, "G\u001b[38;2;87;105;247mrun.py\u001b[13G\u001b[39mneeds\u001b[19Gto\u001b[22Gcut decoded pieces at\u001b[44Gthe first NUL.\u001b[K\r\u001b[1C\u001b[1B 2.\u001b[6G\u001b[1mPyPy loader:\u001b[22m PyPy won't l\u001b[32Gt \u001b[38;2;87;105;247mreadinto\u001b[39m write into\u001b[54Ga\u001b[56Gslice\u001b[62Gof\u001b[65Ga\u001b[67Gcast\u001b[72Gmemoryview.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B First\u001b[9GI'll\u001b[14Gch\u001b[17Gck what\u001b[25GPyPy\u001b[30Gaccepts:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Testing\u001b[11Gloader variants on PyPy and CPython\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ PYPY=/Users/Shared/pvc-kit/py/pypy-3.11.15-macos-aarch64-none/bin/pypy3; $PYPY --version; cat > \r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m/tmp/p1bench/pypyload.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mimport sys, os, time\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mfrom array import array\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mP = '/Users/agentlab/pvc/p1/model.bin'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mnfl = (os.path.getsize(P) - 28) // 4\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfor name in ('readinto_array', 'readinto_mv_sli\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[39m "]
