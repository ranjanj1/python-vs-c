[48.591, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[22m \u001b[5G     \u001b[11G    \u001b[16G   \u001b[20Gif not k:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m      \u001b[12G        \u001b[21G   rais\u001b[30GValueE\u001b[37Gror('short\u001b[48Gread\u001b[53Gon\u001b[56Gcheckpoint')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mgot\u001b[24G+=\u001b[27Gk\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12G   \u001b[16Gdel\u001b[20Gmv\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m '''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mnew='''\u001b[23G#\u001b[25G(readinto\u001b[35Gon\u001b[38Gthe\u001b[42Garray\u001b[48Gitself:\u001b[56GPyPy\u001b[61Grejects\u001b[69Gsliced/cast\u001b[81Gmemoryviews\u001b[93Ghere)\r\u001b[1B \u001b[2m\u2502\u001b[22m             data = array('f', [0.0])\u001b[41G*\u001b[43Gnfl\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mgot\u001b[20G=\u001b[22Gf.readinto(data)\u001b[39Gor\u001b[42G0\r\u001b[1B \u001b[2m\u2502\u001b[22m             if got != 4 * nfl:          # short read: fall back to a plain fromfile\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m                 f.seek(28)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m                 data = array('f')\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m                 data.fromfile(f, nfl)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m '''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert\u001b[11Gold\u001b[15Gin\u001b[18Gs;\u001b[21Gs=s.replace(old,new)\r\u001b[1B \u001b[2m\u2502\u001b[22m old2='''\u001b[13G   \u001b[17G       if\u001b[27Ghexd:\r\u001b"]
[48.592, "[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mpiece\u001b[26G=\u001b[28Gbytes([int(hexd,\u001b[45G16)])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G      return piece\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'''\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m new2='''      \u001b[19G    \u001b[24Gif hexd:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mpiece\u001b[26G=\u001b[28Gbytes([int(hexd,\u001b[45G16)])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   #\u001b[14Gt\u001b[17G C\u001b[20Gpiece is a NUL-\u001b[36Germinated\u001b[46Gstring:\u001b[54Gthe\u001b[58G<0x00>\u001b[65Gbyte\u001b[70Gpiece\u001b[76Gdecodes\u001b[84Gto\u001b[87G\"\"\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mz\u001b[14G=\u001b[16Gpiece.find(b'\\\\0')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         if z >= 0:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mpiece\u001b[22G=\u001b[24Gpiece[:z]\r\u001b[1B \u001b[2m\u2502\u001b[22m         return piece\u001b[25G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'''\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m assert old2 in s; s=s.replace(old2,new2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen(p,'w').write(s)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m grep\u001b[9G-n \"readinto\\|find(b'\" run.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[48.592, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G-\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
