[602.779, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[11G\u001b[38;2;245;149;117mg\u001b[41G\u001b[38;2;157;157;157mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[602.84, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 7s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[602.893, "\u001b[H\r\u001b[28C\u001b[33B\u001b[38;2;102;102;102m4\u001b[39m\u001b[40;1H\u001b[38;3H"]
[602.933, "\u001b[H\u001b[6Gdoesn't cover this case: it passed with the old \u001b[38;2;87;105;247mHEX 00\u001b[39m too. So I checked it directly on both interpreters.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mPyPy crash at load:\u001b[22m PyPy rejects \u001b[38;2;87;105;247mreadinto\u001b[39m into a slice of a cast memoryview. The loader now reads straight into\u001b[118Gthe\r\u001b[5C\u001b[1Bfloat32 array itself, which works on both interpreters, and falls back to \u001b[38;2;87;105;247marray.fromfile\u001b[39m on a short read.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne extra change you didn't ask for:\u001b[22m once PyPy started, it ran my command script 2.5\u00d7 slower than CPython (265.8\u001b[116Gs\u001b[118Gvs\r\u001b[2C\u001b[1B107.0 s). The loop I had tuned for CPython is a bad fit for PyPy's JIT. So \u001b[38;2;87;105;247mrun.py\u001b[39m now contains a second\u001b[K\r\u001b[2C\u001b[1Bmatrix-multiply loop written with plain indexing and picks one by interpreter at import time. Both are scalar loops\r\u001b[2C\u001b[1Bthat sum in the same order, so results stay bit-identical.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[602.934, "\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[6G  per multiply-add    \u2502         PyPy          \u2502          CPython          \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5Gloop tuned for CPython \u2502 47.8 ns               \u2502 20.6 ns (used on CPython) \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5Gplain indexed loop     \u2502 3.9 ns (used on PyPy) \u2502 39.2 ns                   \u2502\u001b[K\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[602.935, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[6G      \u001b[26Gtest\u001b[52G\u2502\u001b[63GCPython\u001b[80G\u2502\u001b[96GPyPy\u001b[116G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5G\u001b[38;2;87;105;247mcheck.py\u001b[52G"]
[602.936, "\u001b[39m\u2502\u001b[54GPASS,\u001b[60G58.8\u001b[65Gs\u001b[80G\u2502\u001b[82GPASS,\u001b[88G10.9\u001b[93Gs\u001b[116G\u2502\r\u001b[1B \u001b[3G\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B  \u2502 logit errors (positions\u001b[29G0\u001b[31G/ 4 /\u001b[37G12)\u001b[52G\u2502\u001b[54G1.14e-5\u001b[62G/\u001b[64G1.53e-5\u001b[72G/\u001b[80G\u2502\u001b[82Gsame\u001b[116G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G                                 \u001b[52G\u2502\u001b[54G1.62e-5\u001b[80G\u2502\u001b[116G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Gmy command scrip"]
[602.937, "t (all six commands, 45        \u2502 107.0 s                   \u2502 23.4 s (265.8\u001b[96Gs\u001b[98Gbefore\u001b[105Gthe\u001b[109Gsecond\u001b[116G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[5Gforward passes)                                \u2502                           \u2502  loop)                          \u001b[116G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Gstdout and LOGITS file                         \u2502 identical across          \u2502 identical across interpreters   \u001b[116G\u2502\r\u001b[2C\u001b[1B\u2502\u001b[6G                                              \u2502 interpreters              \u2502                     \u001b[116G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[602.938, "\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gprecision\u001b[17Glimitation\u001b[28Gis\u001b[31Gunchanged:\u001b[42Ginner\u001b[48Gsums\u001b[53Guse\u001b[57G64-bit\u001b[64Gfloats\u001b[71Gand\u001b[75Gare\u001b[79Grounded\u001b[87Gto\u001b[90Gfloat32\u001b[98Gwhen\u001b[103Gstored,\u001b[111Gso\u001b[114Glogits\r\u001b[1B \u001b[3Gdiffer slightly from the C reference. The benchmark scripts\u001b[63Gin\u001b[66G\u001b[38;2;87;105;247m/tmp/p1bench\u001b[79G\u001b[39mhad\u001b[83Gbeen\u001b[88Gwiped\u001b[94Gbetween\u001b[102Gsessions\u001b[111Gand\u001b[115GI\r\u001b[1B  recreated the ones I needed. NOTES.md has a new section covering the commands, the loader\u001b[93Gand\u001b[97Gloop\u001b[102Gcomparisons\u001b[114Gon\u001b[117Gboth\u001b[40;1H\u001b[38;3H"]
[602.987, "\u001b]0;\u2733 Claude Code\u0007"]
[602.991, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mOne extra change\u001b[20Gy\u001b[22Gu didn't ask for:\u001b[22m once PyPy started, it ran\u001b[66Gmy co\u001b[72Gmand script 2.5\u00d7 slower than CPython (265.8 s\u001b[118Gvs\u001b[K\r\u001b[2C\u001b[1B107.0 s). The loop I had\u001b[28Gtuned\u001b[34Gf\u001b[37G CPython is a bad fit for PyPy's JIT. So \u001b[38;2;87;105;247mrun.py\u001b[39m now contains\u001b[101Gecond\u001b[K\r\u001b[2C\u001b[1Bmatrix-multiply\u001b[19Gloop\u001b[24Gwritten\u001b[32Gwith\u001b[37Gplain\u001b[43Gindexing\u001b[52Gand\u001b[56Gpicks\u001b[62Gone\u001b[66Gby\u001b[69Ginterpreter\u001b[81Gat\u001b[84Gimport\u001b[91Gtime.\u001b[97GBoth\u001b[102Gare\u001b[106Gscalar\u001b[113Gloops\r\u001b[2C\u001b[1Bthat sum in the same order, so results stay bit-identical.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502   \u001b[8Gper\u001b[12Gmul\u001b[16Giply-add    \u2502 \u001b[31G  \u001b[34G    PyPy    \u001b[47G     \u2502        \u001b[63GCPython\u001b[80G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[602.991, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 loop tuned for CPython \u2502 47.8 ns               \u2502 20.6 ns (used on CPython) \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 plain indexed loop     \u2502 3.9 ns (used on PyPy) \u2502 39.2 ns                   \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[602.992, "\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                      test                      \u2502          CPython          \u2502\u001b[96GPyPy\u001b[116G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 \u001b[38;2;87;105;247mcheck.py\u001b[39m                                       \u2502 PASS, 58.8 s              \u2502 PASS, 10.9 s                      \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[602.992, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 logit errors (positions 0 / 4 / 12)            \u2502 1.14e-5 / 1.53e-5 /       \u2502 same                              \u2502\r\u001b[4C\u001b[1B        \u001b[54G1.62e-\u001b[61G   \u001b[65G \u001b[82G     \u001b[88G    \u001b[93G \r\u001b[4C\u001b[2Bmy command \u001b[17Gcript (all six commands,\u001b[42G45\u001b[55G07.0 s\u001b[62G \u001b[64G       \u001b[72G \u001b[82G23.4\u001b[87Gs\u001b[89G(265.8\u001b[96Gs\u001b[98Gbefore\u001b[105Gthe\u001b[109Gsecond\r\u001b[4C\u001b[1Bforward\u001b[13Gpasses)\u001b[54G       \u001b[83Gloop)\r\u001b[4C\u001b[2Bstdout \u001b[16GLOGITS\u001b[23Gfi\u001b[26Ge\u001b[28G   \u001b[32G         \u001b[42G  \u001b[54Gidentical\u001b[64Gacross\u001b[82Gidentical acro\u001b[97Gs interpreters    \r\u001b[4C\u001b[1B       \u001b[13G       \u001b[54Ginterpreters\u001b[83G     \r\u001b[2C\u001b[1B\u2514\u001b[52G\u2534\u001b[80G\u2534\u001b[116G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gprecision\u001b[17Glimitation\u001b[28Gis\u001b[31Gunchanged:\u001b[42Ginner\u001b[48Gsums use 64-bi\u001b[63G floats\u001b[71Gand\u001b[75Gare\u001b[79Grounded\u001b[87Gto\u001b[90Gfloat32\u001b[98Gwhen\u001b[103Gstored,\u001b[111Gso\u001b[114Glogits\r\u001b[2C\u001b[1Bdiffer slightly from the C reference. "]
[602.993, "The benchmark scripts in \u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m had been wiped between sessions and I\u001b[K\r\u001b[2C\u001b[1Brecreated\u001b[13Gthe\u001b[17Gones\u001b[22GI\u001b[24Gneeded.\u001b[32GNOTES.md\u001b[41Ghas\u001b[45Ga\u001b[47Gnew\u001b[51Gsection\u001b[59Gcovering\u001b[68Gthe\u001b[72Gcommands,\u001b[82Gthe\u001b[86Gloader\u001b[93Gand\u001b[97Gloop\u001b[102Gcomparisons\u001b[114Gon\u001b[117Gboth\r\u001b[2C\u001b[1Binterpreters,\u001b[17Gand \u001b[22Ghe results.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GWorked for 9m 52s \u00b7 done 7:29 PM\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[21C\u001b[2B\u001b[38;2;102;102;102m? for shortcuts\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
