[591.393, "script wall time |\u001b[42GCPython 107.0 s, PyPy 265.8 s \u2192 **\u001b[77G3.4\u001b[81Gs**\u001b[85Gwith\u001b[90Gthe\u001b[94Gindexed\u001b[102Gkernel\u001b[109G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m73\u001b[12G\u001b[38;2;51;51;51m|\u001b[14G`check.py\u001b[24G--\u001b[27Gpython3\u001b[35G-I\u001b[38Grun.py`\u001b[46G|\u001b[48GPASS,\u001b[54G58.8\u001b[59Gs\u001b[61G(errors\u001b[69G1.14e-5\u001b[77G/\u001b[79G1.53e-5\u001b[87G/\u001b[89G1.62e-5)\u001b[98G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m74\u001b[12G\u001b[38;2;51;51;51m|\u001b[14G`check.py\u001b[24G-- \u001b[28Gypy3 -I run.py` | PASS,\u001b[52G10.9 s\u001b[59G(same error\u001b[71G) |                     \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m75\u001b[15G\u001b[38;2;51;51;51m    \u001b[20G   \u001b[24G        \u001b[33G      \u001b[40G     \u001b[46G    \u001b[51G   \u001b[55G    \u001b[60G       \u001b[68G             \u001b[82G          \u001b[93G  \u001b[96G   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m76\u001b[12G\u001b[38;2;51;51;51mThe supplied `check.py` passed ev\u001b[46Gn with the old `HEX 00` answer, so it doesn't cov\u001b[96Gr that\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m77\u001b[12G\u001b[38;2;51;51;51mcase.\u001b[18GI\u001b[20Gverified\u001b[29Git\u001b[32Gdirectly\u001b[41Gwith\u001b[46Gthe\u001b[50GPIECE\u001b[56Glines\u001b[62Gabove.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m78\u001b[12G\u001b[38;2;51;51;51m        \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m "]
[591.394, "279 \u001b[22m ## Precision (limitation)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 280 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 281 \u001b[22m The Python standard library has no float32 scalar arithmetic. All stored tensors are float32:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[591.395, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 182 \u001b[22m ### Change made (session 3)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 183 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 184 \u001b[22m 5. **Loader:** the checkpoint is read straight into a pre-sized float32 array with\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 185 -\u001b[38;2;51;51;51m   `readinto`, looping until the whole file is read. There is no temporary 438 MB `bytes`                         \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 185 +\u001b[38;2;51;51;51m   `readinto`. In session 4 this became `readinto` on the array itself, because PyPy rejects                      \r\u001b[1B\u001b[38;2;36;138;61m 186 +\u001b[38;2;51;51;51m   the memoryview slice used here at first. There is no temporary 438 MB `bytes`                                  \r\u001b[1B\u001b[49m\u001b[2m 187 \u001b[22m    object. The KV caches are allocated as `array('f',[0.0])*N` instead of from a temporary\r\u001b[1B\u001b[2m 188 "]
[591.396, "\u001b[22m    `bytes(4N)`. Compute is unchanged, so logits and protocol output are bit-identical to v0/v1.\r\u001b[1B\u001b[2m 189 \u001b[22m \r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mNOTES.md\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[592.375, "\u001b]0;\u25d1 Claude Code\u0007"]
[592.38, "\u001b[H\u001b[8G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m52\u001b[12G\u001b[38;2;51;51;51m   CPython\u001b[23G(265.8\u001b[30Gs\u001b[32Gvs\u001b[35G107.0\u001b[41Gs).\u001b[45GThe\u001b[49Gzip-over-array-slices\u001b[71Gloop\u001b[76Gtuned\u001b[82Gfor\u001b[86GCPython\u001b[94Gis\u001b[97Ga\u001b[99Gbad\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m53\u001b[15G\u001b[38;2;51;51;51mshape\u001b[21Gfor\u001b[25GPyPy's\u001b[32GJIT.\u001b[37GMicro-benchmark\u001b[53Gat\u001b[56G768x2048,\u001b[66Gns\u001b[69Gper\u001b[73Gmultiply-add:\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m54\u001b[12G\u001b[38;2;51;51;51m \u001b[14G    \u001b[19G \u001b[21G      \u001b[28G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m55\u001b[12G\u001b[38;2;51;51;51m   | kernel\u001b[24G|\u001b[26GPyPy\u001b[31G|\u001b[33GCPython\u001b[41G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m56\u001b[12G\u001b[38;2;51;51;51m \u001b[14G |---|---|---|   \u001b[32G \u001b[34G \u001b[36G        \u001b[45G   \u001b[49G     \u001b[55G \u001b[57G    \u001b[62G \u001b[64G \u001b[66G    \u001b[71G \u001b[73G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m57\u001b[12G\u001b[38;2;51;51;51m \u001b[14G | zip over 4 array slices (`_dot\u001b[48G_zip`) | 47.8 | 20.6\u001b[69G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m58\u001b[12G\u001b[38;2;51;51;51m \u001b[14G | indexed loop,\u001b[31G1 row per pass | 4.6 | 46.9 |    \u001b[65G         \u001b[75G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m59\u001b[12G\u001b[38;2;51;51;51m \u001b[14G | indexe"]
[592.381, "d loop, 4 rows per\u001b[42Gpass (`_dots_indexed`) | 3.9 | 39.\u001b[77G | \u001b[81G   \u001b[85G    \u001b[90G   \u001b[94G       \u001b[102G      \u001b[109G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m60\u001b[12G\u001b[38;2;51;51;51m \u001b[14G         \u001b[24G  \u001b[27G       \u001b[35G  \u001b[38G       \u001b[46G \u001b[48G     \u001b[54G    \u001b[59G \u001b[61G       \u001b[69G       \u001b[77G \u001b[79G       \u001b[87G \u001b[89G        \u001b[98G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m61\u001b[12G\u001b[38;2;51;51;51m \u001b[14G `run.py`\u001b[24Gkee\u001b[28Gs both and picks one at\u001b[52Gimport\u001b[59Gtime with `\u001b[71Gys.implementation.name`.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m62\u001b[15G\u001b[38;2;51;51;51mBoth\u001b[20Gare\u001b[24Gexplicit\u001b[33Gscalar\u001b[40Gloops\u001b[46Gwith\u001b[51Gthe\u001b[55Gsame\u001b[60Gper-row\u001b[68Gleft-to-right\u001b[82Gsummation,\u001b[93Gso\u001b[96Gthe\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m63\u001b[12G\u001b[38;2;51;51;51m   results are bit-identical (ass\u001b[46Grted in the benchmark, and confirmed end to end b\u001b[96Glow). \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m64\u001b[12G\u001b[38;2;51;51;51m     \u001b[18G \u001b[20G        \u001b[29G  \u001b[32G        \u001b[41G    \u001b[46G   \u001b[50G     \u001b[56G     \u001b[62G      \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m65\u001b[12G\u001b[38;2;51;51;51mResults:\r\u001b[5C\u001b[1B\u001b[38;2;36;13"]
[592.382, "8;61m 266 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 267 +\u001b[38;2;51;51;51m| test | result |                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 268 +\u001b[38;2;51;51;51m|---|---|                                                                                             \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 269 +\u001b[38;2;51;51;51m| PIECE 0 3 / PIECE 1 3 (CPython and PyPy) | `HEX ` / `HEX ` |                                        \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 270 +\u001b[38;2;51;51;51m| protocol script stdout, CPython vs PyPy | identical |                                               \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 271 +\u001b[38;2;51;51;51m| LOGITS file (5 x 32000), CPython vs PyPy | bitwise identical |                                      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 272 +\u001b[38;2;51;51;51m| protocol script wall time | CPyt"]
[592.382, "hon 107.0 s, PyPy 265.8 s \u2192 **23.4 s** with the indexed kernel |    \u001b[49m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 273 +\u001b[38;2;51;51;51m| `check.py -- python3 -I run.py` | PASS, 58.8 s (errors 1.14e-5 / 1.53e-5 / 1.62e-5) |               \r\u001b[1C\u001b[1B\u001b[49m\u001b[39m    \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 274 +\u001b[38;2;51;51;51m| `check.py -- pypy3 -I run.py` | PASS, 10.9 s (same errors) |                                        \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 275 +\u001b[38;2;51;51;51m                                                                                                      \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 276 +\u001b[38;2;51;51;51mThe supplied `check.py` passed even with the old `HEX 00` answer, so it doesn't cover that            \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 277 +\u001b[38;2;51;51;51mcase. I verified it directly with the PIECE lines above.                                              \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;"]
[592.383, "2;220;255;220m 278 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m 279 \u001b[22m ## Precision (limitation)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 280 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 281 \u001b[22m The Python standard library has no float32 scalar arithmetic. All stored tensors are float32:\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m \u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;223;127;95mTempering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(9m 42s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m10.5k tokens)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[592.384, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
[592.392, "\u001b[H\u001b[8G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m6\u001b[15G\u001b[38;2;51;51;51mBoth are explicit \u001b[34Gcalar loops with the same per\u001b[64Grow left-to-right\u001b[82Gsummation, so the   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m6\u001b[15G\u001b[38;2;51;51;51mresults are bit-identical (asserted in \u001b[55Ghe benchmark,\u001b[69Gand\u001b[73Gconf\u001b[78Grmed end\u001b[87Gto\u001b[90Gend\u001b[94Gbelow).\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m6\r\u001b[7C\u001b[1B6\u001b[12G\u001b[38;2;51;51;51mResults:   \u001b[24G \u001b[26G    \u001b[31G \u001b[33G       \u001b[41G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m6\u001b[15G\u001b[38;2;51;51;51m             \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m|\u001b[14Gtest |\u001b[21Gresult\u001b[28G|    \u001b[34G      \u001b[41G             \u001b[55G \u001b[57G    \u001b[62G \u001b[64G    \u001b[69G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m|---|---|   \u001b[25G     \u001b[31G \u001b[33G   \u001b[37G   \u001b[41G    \u001b[46G \u001b[48G   \u001b[52G \u001b[54G    \u001b[59G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m|\u001b[14GPIECE 0 3 / PIECE 1 3 (CPython and PyPy) | `HEX \u001b[63G / `HEX\u001b[71G`\u001b[73G|   \u001b[78G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m|\u001b[14Gprotocol\u001b[23Gscript\u001b[30Gstdout,\u001b[38GCPython\u001b[46Gvs\u001b[49GPyP"]
[592.393, "y\u001b[54G|\u001b[56Gidentical\u001b[66G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m|\u001b[14GLOGITS file (5 x 32000),\u001b[39GCPython vs PyPy | bi\u001b[60Gwise \u001b[66Gdentical |                   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m|\u001b[14Gpr\u001b[18Gocol script wall time\u001b[40G| CPython 107.0 s, PyPy 265.8 s \u2192 **23.4 s** wi\u001b[88Gh the indexed\u001b[102Gkernel\u001b[109G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m|\u001b[14G`check.py --\u001b[27Gpy\u001b[30Ghon3 -I run.py` | PASS,\u001b[54G58.8 s (errors\u001b[69G1.14e-5 / 1.53\u001b[84G-5\u001b[87G/ 1.62e-5) |  \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m|\u001b[14G`check.py\u001b[24G--\u001b[27Gpypy3\u001b[33G-I\u001b[36Grun.py`\u001b[44G|\u001b[46GPASS,\u001b[52G10.9\u001b[57Gs\u001b[59G(same\u001b[65Gerrors)\u001b[73G|\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m        \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51mThe\u001b[16Gsupplied\u001b[25G`check.py`\u001b[36Gpassed\u001b[43Geven\u001b[48Gwith\u001b[53Gthe\u001b[57Gold\u001b[61G`HEX\u001b[66G00`\u001b[70Ganswer,\u001b[78Gso\u001b[81Git\u001b[84Gdoesn't\u001b[92Gcover\u001b[98Gthat\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51mcas\u001b[16G. I verified it\u001b[32Gdirectly\u001b[41Gwith\u001b[46Gth"]
[592.393, "e\u001b[50GPIECE\u001b[56Glines\u001b[62Gabove.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 279 \u001b[22m ## Precision (limitation)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 280 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 281 \u001b[22m The Python standard library has no float32 scalar arithmetic. All stored tensors are float32:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 182 \u001b[22m ### Change made (session 3)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 183 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 184 \u001b[22m 5. **Loader:** the checkpoint is read straight into a pre-sized float32 array with\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 185 -\u001b[38;2;51;51;51m   `readinto`, looping until the whole file is read. There is no temporary 438 MB `bytes`             \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 185 +\u001b[38;2;51;51;51m   `readinto`. In session 4 this b"]
[592.394, "ecame `readinto` on the array itself, because PyPy rejects          \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 186 +\u001b[38;2;51;51;51m   the memoryview slice used here at first. There is no temporary 438 MB `bytes`                      \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m1\u001b[9G7\u001b[12G\u001b[22m   object.\u001b[23GThe KV caches are \u001b[42Gllocated as `array('f',[0.0])*N` instead of from a\u001b[93Gtemporary\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 188 \u001b[22m    `bytes(4N)`. Compute is unchanged, so logits and protocol output are bit-identical to v0/v1.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 189 \u001b[22m \u001b[39m\u001b[K\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m1\u001b[29G3\u001b[39m\u001b[40;1H\u001b[38;3H"]
