[450.755, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m \u001b[38;2;87;105;247mf.readinto(data)\u001b[39m reads straight into the array \u001b[51Gn one\u001b[57Gcall\u001b[62Gon\u001b[65Gboth\u001b[70Ginterpreters,\u001b[84Gwith\u001b[89G\u001b[38;2;87;105;247mfromfile\u001b[98G\u001b[39mas\u001b[101Gthe\u001b[105Gfallback\u001b[114Gon\u001b[117Ga\r\u001b[1C\u001b[1B short read. I'll\u001b[20Galso\u001b[25Gmake\u001b[30Gdecode\u001b[37Gstop\u001b[42Gat\u001b[45Gthe\u001b[49Gfirst\u001b[55GNUL\u001b[59Gbyte,\u001b[65Gas\u001b[68GC\u001b[70Gstrings\u001b[78Gdo.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Now\u001b[7Gthe\u001b[11Gsame\u001b[16Gprotocol script\u001b[32Gon\u001b[35Gboth\u001b[40Ginterpreters,\u001b[54Gcovering\u001b[63Gthe\u001b[67Gfailing\u001b[75GPIECE\u001b[81Gcases,\u001b[88Gother\u001b[94GPIECEs,\u001b[102GENCODE,\u001b[110GFIXED,\r\u001b[1C\u001b[1B LOGITS\u001b[10Gand GENERATE.\u001b[24GI'll\u001b[29Gdiff\u001b[34Gstdout\u001b[41Gand\u001b[45Gthe\u001b[49GLOGITS\u001b[56Gfiles\u001b[62Gbetween\u001b[70Gthem:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Both\u001b[8Ginterpreters produce identical\u001b[39Goutput,\u001b[47Gbut\u001b[51GPyPy\u001b[56Gruns\u001b[61Gthis\u001b[66Gscrip"]
[450.756, "t\u001b[73Gfar\u001b[77Gslower\u001b[84G(265.8\u001b[91Gs\u001b[93Gagainst\u001b[101G107.0\u001b[107Gs\u001b[109Gon\u001b[112GCPython),\r\u001b[1C\u001b[1B probably\u001b[13Gecause\u001b[20Gthe loop\u001b[29Gshapes I\u001b[38Gtuned for CPython don't suit\u001b[67GPyPy's\u001b[74GJIT.\u001b[79GNext\u001b[84GI'm\u001b[88Gprinting\u001b[97Gthe\u001b[101GPIECE\u001b[107Glines.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m \u001b[38;2;87;105;247mPIECE 0 3\u001b[39m and \u001b[38;2;87;105;247mPIECE 1 3\u001b[39m now return just \u001b[38;2;87;105;247mHEX \u001b[39m, while other\u001b[61Gbyte\u001b[66Gpieces\u001b[73Gare\u001b[77Gunchanged.\u001b[88GNext\u001b[93GI'll\u001b[98Grun\u001b[102Ga\u001b[104Gquick\u001b[110GPyPy\r\u001b[1C\u001b[1B micro-benchmark\u001b[19Gof\u001b[22Gmatmul\u001b[29Gloop\u001b[34Gshapes\u001b[41Gto\u001b[44Gsee\u001b[48Gwhether\u001b[56Gone\u001b[60Gloop\u001b[65Gworks\u001b[71Gfor\u001b[75Gboth\u001b[80Ginterpreters.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Benchmarking kernel shapes\u001b[30Gon\u001b[33GPyPy\u001b[38Gand\u001b[42GCPython\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/p1bench/pk.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport time, random, sys\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mfrom a"]
