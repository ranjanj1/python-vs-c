[216.043, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsmoke\u001b[13Gtest\u001b[18Glooks\u001b[24Gright:\u001b[31G\"Once\u001b[37Gupon\u001b[42Ga\u001b[44Gtime\"\u001b[50G\u2192\u001b[52G\u001b[38;2;87;105;247m, there was\u001b[39m,\u001b[65Gat\u001b[68Gabout\u001b[74G2.6\u001b[78Gs\u001b[80Gper\u001b[84Gtoken.\u001b[91GNow\u001b[95Gthe\u001b[99Gvalidation\u001b[110Grun:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWhile\u001b[9Gthe\u001b[13Gchecker\u001b[21Gruns\u001b[26G(it\u001b[30Gmay\u001b[34Gtake\u001b[39Gseveral\u001b[47Gminutes\u001b[55Gat\u001b[58Gthis\u001b[63Gspeed),\u001b[71GI'll\u001b[76Gwrite\u001b[82GNOTES.md\u001b[91Gand\u001b[95Gadd\u001b[99Gthe\u001b[103Gresults\u001b[111Gonce\u001b[116Git\r\u001b[1B \u001b[3Gfinishes.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(NOTES.md)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m67\u001b[22m lines\u001b[21Gto\u001b[24G\u001b[1mNOTES.md\r\u001b[1B\u001b[22m     \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m# P1 \u2014 pure Python port of reference/run.c\r\u001b[7C\u001b[1B\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mImplementation: `run.py` (Python 3.12 standard library only: `sys`, `math`, `struct`, `array`).\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10"]
[216.044, "G\u001b[22mStart: `py\u001b[21Gh\u001b[24G3\u001b[26Grun.py <checkp\u001b[41Gint\u001b[45Gbin> <tokenizer.bin>`, then the INTERFACE.md line protocol.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22m## Commands run\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22m```\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mpython3 --version                      # Python 3.12.13 (/Users/Shared/pvc-kit/stdlib/bin/python3)\r\u001b[6C\u001b[1B\u001b[2m10\u001b[19G\u001b[22mc '...struct.unpack(\"7i\")...'\u001b[51Gread model header: dim 768, hidden 2048, 12 layers,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +57 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39mBackground\u001b[14Gcommand\u001b[22G\"Run\u001b[27Gthe\u001b[31Gsupplied\u001b[40Gvalidation\u001b[51Gtests\"\u001b[58Gcompleted\u001b[68G(exit\u001b[74Gcode\u001b[79G0)\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gchecker\u001b[15Gappends\u001b[23Gthe\u001b[27Gmodel\u001b[33Gand\u001b[37Gtokenizer\u001b[47Gpaths\u001b[53Gitself,\u001b[61Gso\u001b[64GI'll\u001b[69Gpass\u001b[74Gonly\u001b[79Gthe\u001b[83Gprogram:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b"]
[216.044, "[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The checker is running now with the right invocation, \u001b[38;2;87;105;247mpython3 check.py -- python3 -I run.py\u001b[39m. At about 2.6 s per\u001b[115Gtoken\r\u001b[2C\u001b[1Bit\u001b[6Gwill\u001b[11Gtake\u001b[16Ga\u001b[18Gfew\u001b[22Gminutes.\u001b[31GI'll\u001b[36Greport\u001b[43Gthe\u001b[47Gresult\u001b[54Gand\u001b[58Gadd\u001b[62Git\u001b[65Gto\u001b[68GNOTES.md\u001b[77Gwhen\u001b[82Git\u001b[85Gfinishes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mBrewed for 3m 20s \u00b7\u001b[23Gdone 2:37 PM \u00b7 1\u001b[40Gsh\u001b[43Gll still running\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[31C\u001b[2B\u001b[38;2;102;102;102m\u2193 to manag\u001b[43G\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
