[86.795, "G\"ns/mac\",\u001b[86Ge/(n*d)*1e9)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m t(\"slice-array sum map\", lambda: [sum(map(mul, W[i*n:(i+1)*n],\u001b[67Gx))\u001b[71Gfor\u001b[75Gi\u001b[77Gin\u001b[80Grange(d)])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt(\"memoryview\u001b[18Gsum\u001b[22Gmap\",\u001b[28Glambda:\u001b[36G[sum(map(mul,\u001b[50Gmv[i*n:(i+1)*n],\u001b[67Gx))\u001b[71Gfor\u001b[75Gi\u001b[77Gin\u001b[80Grange(d)])\r\u001b[1B \u001b[2m\u2502\u001b[22m t(\"sli\u001b[11Ge-arr\u001b[17Gy \u001b[20Gum ma\u001b[26G xa\", lambd\u001b[38G: [sum(map(mul, W[i*n:(i+1)*n],\u001b[70Gxa)) for i\u001b[81Gin range(d)])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def loop():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mout=[]\r\u001b[1B \u001b[2m\u2502\u001b[22m     for i in range(d):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mr=W[i*n:(i+1)*n];\u001b[30Gv=0.0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gj\u001b[18Gin\u001b[21Grange(n):\u001b[31Gv+=r[j]*x[j]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout.append(v)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt(\"explicit\u001b[16Gloop\",\u001b[23Gloop)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gloop2():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mout=[]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gi\u001b[14Gin\u001b[17Grange(d):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mv=0.0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Ga,b\u001b[20Gin\u001b[23Gzip(W[i*n:(i+1)*n],x):\u001b[46Gv+=a*b\r\u001b[1C\u001b[1B"]
[86.796, "\u001b[2m\u2502\u001b[12G\u001b[22mout.append(v)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt(\"zip\u001b[11Gloop\",\u001b[18Gloop2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-I\u001b[15G/tmp/p1bench/b.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
