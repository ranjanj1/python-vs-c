[148.973, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P1 port of reference/run.c (llama2.c) -- Python standard library only, scalar loops.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  3 \r\u001b[2C\u001b[1B\u001b[22m\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22mSpeaks the line protocol described \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md on stdin/stdout.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mPrecision: \u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m weights, activations, KV cache \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m logits are stored \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m float32\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m(array(\u001b[38;2;24;54;145m'f'\u001b[38;2;51;51;51m)); every vector produced by an operation \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m rounded to float32 when\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22mstored, \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m \u001b[38"]
[148.974, ";2;167;29;93min\u001b[38;2;51;51;51m the C reference.  Inner dot-product accumulators are Python\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mfloats (the only scalar \u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mtype\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m the standard library), see NOTES.md.\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +408 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll make\u001b[13Gthe\u001b[17Gattention\u001b[27Gvalue\u001b[33Gaccumulation\u001b[46Gconsistent\u001b[57Gwith\u001b[62Gthe\u001b[66Gmatmuls\u001b[74G(accumulate\u001b[86Gas\u001b[89GPython\u001b[96Gfloats,\u001b[104Ground\u001b[110Gto\u001b[113Gfloat32\r\u001b[2C\u001b[1Bon\u001b[6Gstore) so there are no per-element struct calls in the inner\u001b[67Gloop:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[148.975, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mrun.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 191 \u001b[22m                     a = att[t]\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 192 \u001b[22m                     j = \u001b[38;2;0;134;179m0\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 193 \u001b[22m                     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m vc[b:b + hs]:\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 194 -\u001b[38;2;51;51;51m                  "]
[148.976, "      acc[j] = \u001b[48;2;255;199;199mf32(acc[j] + f32(\u001b[48;2;255;220;220ma * c\u001b[48;2;255;199;199m))\u001b[48;2;255;220;220m                                                         \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 194 +\u001b[38;2;51;51;51m                        acc[j] \u001b[48;2;178;255;178m+\u001b[48;2;220;255;220m= a * c                                                                           \r\u001b[1B\u001b[49m\u001b[2m 195 \u001b[22m                         j += \u001b[38;2;0;134;179m1\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 196 -\u001b[38;2;51;51;51m                xb[qo:qo + hs] = acc                                                                              \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 196 +\u001b[38;2;51;51;51m                xb[qo:qo + hs] = \u001b[48;2;178;255;178mrf32(\u001b[48;2;220;255;220macc\u001b[48;2;178;255;178m)\u001b[48;2;220;255;220m                                                                        \r\u001b[1B\u001b[49m\u001b[2m 197 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 198 \u001b[22m             xb2 = \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.matmul(xb,"]
[148.976, " \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.o_wo + l * dim * dim, dim, dim)\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 199 \u001b[22m             x = rf32([x[i] + xb2[i] \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(dim)])\u001b[39m\u001b[40;1H\u001b[36;2H"]
[149.008, "\u001b[H\r\u001b[16B\u001b[38;2;102;102;102m \u001b[39m\u001b[40;1H\u001b[36;2H"]
