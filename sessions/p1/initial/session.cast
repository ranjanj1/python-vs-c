[184.04, "      xb2 = \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.matmul(xb, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.o_wo + l * dim * dim, dim, dim)\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[12G\u001b[22m            x = rf32([x[i] + xb2[i] \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(dim)])\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe smoke test\u001b[18Glo\u001b[21Gks right: \"Once\u001b[37Gupon\u001b[42Ga\u001b[44Gtime\"\u001b[50G\u2192\u001b[52G\u001b[38;2;87;105;247m, there was\u001b[39m,\u001b[65Gat\u001b[68Gabout\u001b[74G2.6\u001b[78Gs\u001b[80Gper\u001b[84Gtoken.\u001b[91GNow\u001b[95Gthe\u001b[99Gvalidation\u001b[110Grun:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
