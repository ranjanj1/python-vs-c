[184.036, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22mSpeaks the line protocol described \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md on stdin/stdout.\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mPr\u001b[13Gci\u001b[16Gion:\u001b[21G\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m weights, activations, KV cache \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m l\u001b[62Ggits are st\u001b[74Gred \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m float32\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m(array(\u001b[38;2;24;54;145m'f'\u001b[38;2;51;51;51m)); every vector produced by an operation \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m rounded to float32 when\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22mstored, \u001b[38;2;167;29;93mas\u001b[21Gin\u001b[38;2;51;51;51m th\u001b[27G C reference.  I\u001b[44Gner dot-product\u001b[60Gaccumul\u001b[68Gtor\u001b[72G a\u001b[76G Python\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22mfloats (the only scalar \u001b[3"]
