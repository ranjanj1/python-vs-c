[208.771, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsmoke\u001b[13Gtest\u001b[18Glooks\u001b[24Gright:\u001b[31G\"Once\u001b[37Gupon\u001b[42Ga\u001b[44Gtime\"\u001b[50G\u2192\u001b[52G\u001b[38;2;87;105;247m, there was\u001b[39m,\u001b[65Gat\u001b[68Gabout\u001b[74G2.6\u001b[78Gs\u001b[80Gper\u001b[84Gtoken.\u001b[91GNow\u001b[95Gthe\u001b[99Gvalidation\u001b[110Grun:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWhile\u001b[9Gthe\u001b[13Gchecker\u001b[21Gruns\u001b[26G(it\u001b[30Gmay\u001b[34Gtake\u001b[39Gseveral\u001b[47Gminutes\u001b[55Gat\u001b[58Gthis\u001b[63Gspeed),\u001b[71GI'll\u001b[76Gwrite\u001b[82GNOTES.md\u001b[91Gand\u001b[95Gadd\u001b[99Gthe\u001b[103Gresults\u001b[111Gonce\u001b[116Git\r\u001b[2C\u001b[1Bfinishes.\u001b[K\r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m67\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1mNOTES.md\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m# P1 \u2014 pure Python port of reference/run.c\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22mImplementation: `ru"]
