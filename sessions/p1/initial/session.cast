[181.914, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P1 port of reference/run.c (llama2.c) -- Python standard library only, scalar loops.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage:\u001b[17Gpython3 run.py <checkpo\u001b[41Gnt.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22mSpeaks the line protocol described \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md on stdin/stdout.\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mPrecision: \u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m w\u001b[27Gights, activations, KV cach\u001b[55G \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m logits are stored \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m float32\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m(ar\u001b[14Gay(\u001b[38;2;24;54;145m'f'\u001b[38;2;51;51;51m));\u001b[24Gev\u001b[27Gry\u001b[30Gv\u001b[32Gctor produced by an operation \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m rounded"]
[181.915, "\u001b[73Gto float32 when\r\u001b[6C\u001b[1B\u001b[2m 9\u001b[10G\u001b[22mst\u001b[13Gred, \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m the C reference.  Inner\u001b[48Gdot-product accumulator\u001b[72G are Python\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mfloats (the only scalar \u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mtype\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m the standard library), see NOTES.md.\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +408 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll make\u001b[13Gthe att\u001b[21Gntion value accumulation consistent\u001b[57Gwith th\u001b[65G matmuls\u001b[74G(accumulate\u001b[86Gas\u001b[89GPython\u001b[96Gfloats,\u001b[104Ground\u001b[110Gto\u001b[113Gfloat32\r\u001b[2C\u001b[1Bon\u001b[6Gstore)\u001b[13Gso\u001b[16Gthere\u001b[22Gare\u001b[26Gno\u001b[29Gper-element\u001b[41Gstruct\u001b[48Gcalls\u001b[54Gin\u001b[57Gthe\u001b[61Ginner\u001b[67Gloop:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[32G\u001b[22ma\u001b[36Gatt[t]\r\u001b[8C\u001b[1B\u001b[2m2\u001b[32G\u001b[22mj =\u001b["]
[181.915, "36G\u001b[38;2;0;134;179m0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 193 \u001b[22m                     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m vc[b:b + hs]:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 194 -\u001b[38;2;51;51;51m                        acc[j] = \u001b[48;2;255;199;199mf32(acc[j] + f32(\u001b[48;2;255;220;220ma * c\u001b[48;2;255;199;199m))\u001b[48;2;255;220;220m                                             \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 194 +\u001b[38;2;51;51;51m                        acc[j] \u001b[48;2;178;255;178m+\u001b[48;2;220;255;220m= a * c                                                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 195 \u001b[22m                         j += \u001b[38;2;0;134;179m1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 196 -\u001b[38;2;51;51;51m                xb[qo:qo + hs] = acc                                                                  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 196 +\u001b[38;2;51;51;51m                xb[qo:qo + hs] = \u001b[48;2;178;255;178mrf32(\u001b[48;2;220"]
