[150.362, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22mfloats (the only scalar \u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mtype\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m the standard library), see NOTES.md.\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m\u2026 +408 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll make the attention value accumulation consistent with the matmuls (accumulate as Python floats,\u001b[104Ground\u001b[110Gto\u001b[113Gfloat32\r\u001b[2C\u001b[1Bon\u001b[6Gstore)\u001b[13Gso\u001b[16Gthere\u001b[22Gare\u001b[26Gno\u001b[29Gper-element\u001b[41Gstruct\u001b[48Gcalls\u001b[54Gin\u001b[57Gthe\u001b[61Ginner\u001b[67Gloop:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m191 \u001b[22m         \u001b[21G   \u001b[25G       a\u001b[34G= att[\u001b[41G]\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m192 \u001b[22m            \u001b[24G     \u001b[30G  j = \u001b[38;2;0;134;179m0\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[9G3 \u001b[22m      \u001b[18G  \u001b[21G  \u001b[24G   \u001b[28G \u001b[30G  \u001b[38;2;167"]
[150.363, ";29;93mfor\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93min\u001b[41G\u001b[38;2;51;51;51mvc[b:b\u001b[48G+ hs]:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 194 -\u001b[38;2;51;51;51m                        acc[j] = \u001b[48;2;255;199;199mf32(acc[j] + f32(\u001b[48;2;255;220;220ma * c\u001b[48;2;255;199;199m))\u001b[48;2;255;220;220m                                             \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 194 +\u001b[38;2;51;51;51m                        acc[j] \u001b[48;2;178;255;178m+\u001b[48;2;220;255;220m= a * c                                                               \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 195 \u001b[22m                         j += \u001b[38;2;0;134;179m1\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 196 -\u001b[38;2;51;51;51m                xb[qo:qo + hs] = acc                                                                  \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 196 +\u001b[38;2;51;51;51m                xb[qo:qo + hs] = \u001b[48;2;178;255;178mrf32(\u001b[48;2;220;255;220macc\u001b[48;2;178;255;178m)\u001b[48;2;220;255;220m                    "]
[150.365, "                                        \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 197 \u001b[22m \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 198 \u001b[22m             xb2 = \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.matmul(xb, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.o_wo + l * dim * dim, dim, dim)\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m 199 \u001b[22m             x = rf32([x[i] + xb2[i] \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(dim)])\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time (printf 'ENCODE Once upon a time\\nPIECE 1 9038\\nPIECE 0 13\\nFIXED 1 9038 2501\\nGENERATE 3 Once upon a \r\u001b[5C\u001b[1Btime\\nQUIT\\n' | python3 -I run.py model.bin tokenizer.bin)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[150.366, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mSmoke-test the protocol commands\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mtime (printf 'ENCODE Once upon a time\\nPIECE 1 9038\\nPIECE 0 13\\nFIXED\u001b[75G1\u001b[77G9038\u001b[82G2501\\nGENERATE\u001b[97G3\u001b[99GOnce\u001b[104Gupon\u001b[109Ga\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtime\\nQUIT\\n'\u001b[18G|\u001b[20Gpython3\u001b[28G-I\u001b[31Grun.py\u001b[38Gmodel.bin\u001b[48Gtokenizer.bin)\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c"]
[150.366, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Ggroup\u001b[10Gin\u001b[13Gparentheses\u001b[25Gin\u001b[28Gthis\u001b[33Gcommand\u001b[41Gcan't\u001b[47Gbe\u001b[50Gchecked\u001b[58Gbefore\u001b[65Git\u001b[68Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
