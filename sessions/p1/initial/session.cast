[154.955, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P1 port of reference/run.c (llama2.c) -- Python standard library only, scalar loops.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22mSpeaks\u001b[17Gthe line protocol descr\u001b[41Gbed \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md on stdin/stdout.\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mPrecision: \u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m weights, activations, KV cache \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m logits are stored \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m float32\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m(array(\u001b[38;2;24;54;145m'f'\u001b[38;2;51;51;51m)); ev\u001b[27Gry vector produced by an op\u001b[55Gration \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m rounded to float32 when\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22msto\u001b[14Ged, \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[24G\u001b[38;2;51;51;51mth\u001b[2"]
[154.956, "7G C\u001b[30Gr\u001b[32Gference.  Inner dot-product accumulators\u001b[73Gare Python\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22mfl\u001b[13Gats (the only scalar \u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mtype\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[48G\u001b[38;2;51;51;51mthe standard library), \u001b[72Gee NOTES.md.\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +408 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gmake\u001b[13Gthe\u001b[17Gattention\u001b[27Gvalue\u001b[33Gaccumulation\u001b[46Gconsistent\u001b[57Gwith\u001b[62Gthe\u001b[66Gmatmuls\u001b[74G(accumulate\u001b[86Gas\u001b[89GPython\u001b[96Gfloats,\u001b[104Ground\u001b[110Gto\u001b[113Gfloat32\r\u001b[1B \u001b[3Gon store)\u001b[13Gso ther\u001b[21G are no per-element struct calls in\u001b[57Gthe inn\u001b[65Gr loop:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 191 \u001b[22m                     a = att[t]\r\u001b[8C\u001b[1B\u001b[2m2\u001b[32G\u001b[22mj\u001b[36G\u001b[38;2;0;134;179m0\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[32G\u001b[22m\u001b[38;2;167;29"]
