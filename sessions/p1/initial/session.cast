[185.158, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll make\u001b[13Gthe\u001b[17Gattention\u001b[27Gvalue\u001b[33Gaccumulation\u001b[46Gconsistent\u001b[57Gwith\u001b[62Gthe\u001b[66Gmatmuls\u001b[74G(accumulate\u001b[86Gas\u001b[89GPython\u001b[96Gfloats,\u001b[104Ground\u001b[110Gto\u001b[113Gfloat32\r\u001b[2C\u001b[1Bon\u001b[6Gstore) so there are no per-element struct calls in the inner\u001b[67Gloop:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[22m lines, removed \u001b[1m2\u001b[22m lines\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m191 \u001b[22m            \u001b[24G     \u001b[30G  a = att[t]\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[9G2 \u001b[22m      \u001b[18G  \u001b[21G  \u001b[24G   \u001b[28G \u001b[30G  j = \u001b[38;2;0;134;179m0\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m93 \u001b[22m     \u001b[17G    \u001b[22G    \u001b[27G     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m vc[b:b\u001b[48G+ hs]:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 194 -\u001b[38;2;51;51;51m                        acc[j] = \u001b[48;2;255;199;199mf32(acc[j] + f32(\u001b[48;2;255;220;220ma * c\u001b[48;2;255;199;199m))\u001b[48;2;255;220;220m       "]
[185.159, "                                      \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 194 +\u001b[38;2;51;51;51m                        acc[j] \u001b[48;2;178;255;178m+\u001b[48;2;220;255;220m= a * c                                                               \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 195 \u001b[22m                         j += \u001b[38;2;0;134;179m1\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 196 -\u001b[38;2;51;51;51m                xb[qo:qo + hs] = acc                                                                  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 196 +\u001b[38;2;51;51;51m                xb[qo:qo + hs] = \u001b[48;2;178;255;178mrf32(\u001b[48;2;220;255;220macc\u001b[48;2;178;255;178m)\u001b[48;2;220;255;220m                                                            \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 197 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 198 \u001b[22m             xb2 = \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.matmul(xb, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.o_wo + l * dim * dim, dim, dim)\r\u001b[8C\u001b[1B\u001b["]
[185.16, "2m9\u001b[24G\u001b[22mx\u001b[26G=\u001b[28Grf32([x[i] + xb2[i] \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(dim)])\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe smoke test looks right: \"Once upon a time\" \u2192 \u001b[38;2;87;105;247m, there was\u001b[39m, at about 2.6 s per token. Now the validation run:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time python3 check.py -- python3 -I run.py model.bin tokenizer.bin 2>&1 | tail -40\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[185.16, "\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mRun the supplied validation tests\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m time python3 chec\u001b[22G.py -- python3\u001b[37G-I run.py model.bin tokenizer.bin 2>&1 |\u001b[78Gtail -40\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[185.161, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gtime\u001b[42Gpython3\u001b[50Gcheck.py\u001b[59G--\u001b[62Gpython3\u001b[70G-I\u001b[73Grun.py\u001b[80Gmodel.bin\u001b[90Gtokenizer.bin\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
[185.17, "\u001b[H\r\u001b[10C\u001b[21Bthe supplied validation\u001b[35Gtests\u001b[40;1H\u001b[35;2H"]
