[151.886, "\u001b[H\u001b[7G\u001b[38;2;51;51;51m\u001b[2m 1\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P1 port of reference/run.c (llama2.c) -- Python standard library only, scalar loops.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  3 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mSpeaks the line protocol described \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md on stdin/stdout.\r\u001b[5C\u001b[1B\u001b[2m  6 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mPrecision: \u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m weights, activations, KV cache \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m logits are stored \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m float32\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m(array(\u001b[38;2;24;54;145m'f'\u001b[38;2;51;51;51m)); every vector produced by an operation \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m rounded to float32 when\r\u001b["]
[151.887, "6C\u001b[1B\u001b[2m \u001b[9G \u001b[22mstored,\u001b[18G\u001b[38;2;167;29;93mas\u001b[21Gin\u001b[24G\u001b[38;2;51;51;51mthe\u001b[28GC\u001b[30Greference.  Inner dot-product accumulators are Python\r\u001b[7C\u001b[1B\u001b[2m0 \u001b[22mfloats\u001b[17G(the\u001b[22Gonly\u001b[27Gscalar\u001b[34G\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mtype\u001b[38;2;51;51;51m \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m the standard library), see NOTES.md.\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +408 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll make the attention value accumulation consistent with the matmuls (accumulate as Python floats, round to float32\r\u001b[2C\u001b[1Bon\u001b[6Gstore) so there are no per-element struct\u001b[48Gcalls\u001b[54Gin\u001b[57Gthe\u001b[61Ginner\u001b[67Gloop:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m2\u001b[14G\u001b[22mlines,\u001b[21Gremoved\u001b[29G\u001b[1m2\u001b[31G\u001b[22mlines\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[24G\u001b[22m   \u001b[28G \u001b[30G  a = \u001b[38Gt[t]\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[24G\u001b[22m \u001b[26G \u001b[28G    j = \u001b[38;2;0;134;179m0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51"]
[151.888, ";51m\u001b[2m 193 \u001b[22m                     \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m vc[b:b + hs]:\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 194 -\u001b[38;2;51;51;51m                        acc[j] = \u001b[48;2;255;199;199mf32(acc[j] + f32(\u001b[48;2;255;220;220ma * c\u001b[48;2;255;199;199m))\u001b[48;2;255;220;220m                                             \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 194 +\u001b[38;2;51;51;51m                        acc[j] \u001b[48;2;178;255;178m+\u001b[48;2;220;255;220m= a * c                                                               \u001b[49m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 195 \u001b[22m                         j += \u001b[38;2;0;134;179m1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 196 -\u001b[38;2;51;51;51m                xb[qo:qo + hs] = acc                                                                  \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 196 +\u001b[38;2;51;51;51m                xb[qo:qo + hs] = \u001b[48;2;178;255;178mrf32(\u001b[48;2;220;25"]
[151.889, "5;220macc\u001b[48;2;178;255;178m)\u001b[48;2;220;255;220m                                                            \u001b[49m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 197 \u001b[22m \u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 198 \u001b[22m             xb2 = \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.matmul(xb, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.o_wo + l * dim * dim, dim, dim)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 199 \u001b[22m             x = rf32([x[i] + xb2[i] \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(dim)])\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Smok\u001b[8G-test \u001b[15Ghe protocol \u001b[28Gommands\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time (printf 'ENCODE Once upon a time\\nPIECE 1 9038\\nPIECE 0 13\\nFIXED 1 9038 2501\\nGENERATE 3 Once upon a \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mtime\\nQUIT\\n' | python3 -I run.py model.bin tokenizer.bin)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;223;127;95mPrecipitating\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(2m 18s \u00b7 \u2193\u001b[30G"]
[151.889, "14.1k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102"]
