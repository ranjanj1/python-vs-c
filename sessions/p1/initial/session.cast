[186.026, "\u001b[H \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22mSpeaks the line protocol described \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md on stdin/stdout.\r\u001b[5C\u001b[1B\u001b[2m  6 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mPrecision: \u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m weights, activations, KV cache \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m logits are stored \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m float32\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m(array(\u001b[38;2;24;54;145m'f'\u001b[38;2;51;51;51m)); every vector produced by an operation \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m rounded to float32 when\r\u001b[6C\u001b[1B\u001b[2m \u001b[9G \u001b[22mstored,\u001b[18G\u001b[38;2;167;29;93mas\u001b[21Gin\u001b[24G\u001b[38;2;51;51;51mthe\u001b[28GC\u001b[30Greference.  Inner dot-product accumulators are Python\r\u001b[7C\u001b[1B\u001b[2m0 \u001b[22mfloats\u001b[17G(the\u001b[22Gonly\u001b[27Gscalar\u001b[34G\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mtype\u001b[38;2;5"]
