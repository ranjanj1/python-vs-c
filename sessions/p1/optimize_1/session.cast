[67.275, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProf\u001b[8Gle this implementation on\u001b[34Gthe supplied development workloads. Improve performance within the same rules and \u001b[39m    \r\u001b[2C\u001b[1B\u001b[38;2;0;0;0mremaini\u001b[11Gg budget. Pres\u001b[27Gve the interface and corr\u001b[53Gctn\u001b[57Gss requirements. Do\u001b[77Gnot\u001b[81Guse hidden evaluation\u001b[105Gputs, external \r\u001b[1B\u001b[39m  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe previous checker\u001b[24Grun\u001b[28Gwas killed before it printed any\u001b[61Ghi\u001b[64Gg, so I still have\u001b[83Gno\u001b[86Gvalidation\u001b[97Gresult.\u001b[105GI'll\u001b[110Grestart\u001b[118Git\r\u001b[2C\u001b[1Bin\u001b[6Gthe\u001b[10Gbackground\u001b[21Gon\u001b[24Gthe\u001b[28Gcurrent\u001b[36Gversion\u001b[44Gand\u001b[48Gbenchmark\u001b[58Galternatives\u001b[71Gmeanwhile.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b"]
[67.276, "[39m8 GiB RAM and\u001b[17G8 cores,\u001b[26Gthough\u001b[33Gc\u001b[35Gm\u001b[37Gute\u001b[41Gmust\u001b[46Gstay\u001b[51Gsingle-threaded.\u001b[68GNext\u001b[73GI'll\u001b[78Gbenchmark\u001b[88Gmatmul\u001b[95Ginner-loop\u001b[106Gvariants\u001b[115Gthat\r\u001b[2C\u001b[1Bare\u001b[7Gall\u001b[11Gstill\u001b[17Gexplicit\u001b[26Gscalar\u001b[33Gloops:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll variants produce identical resu\u001b[39Gts,\u001b[43Gand unr\u001b[51Gl\u001b[53Ging four rows\u001b[67Gper pass gives about\u001b[88Ga 22% speedup with no extra\u001b[K\r\u001b[2C\u001b[1Bme\u001b[6Gory. Keeping weights as Python float lists\u001b[49Gwould add another ~20%, but at roughly\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGB\u001b[108Gmachine,\u001b[117Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gcounting\u001b[16Gdistinct\u001b[25Gweight\u001b[32Gvalues\u001b[39Gto\u001b[42Gsee\u001b[46Gif\u001b[49Gdeduplication\u001b[63Gmakes\u001b[69Gthat\u001b[74Gaffordable.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Estimate distinct float32 weight values\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/p1bench/uniq.py <<'EOF'\r\u001b[5C\u001b[1Bimport struct, sys\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102mr\u001b[9Gm array import ar\u001b[27Gay\u001b[39m\u001b[K\r"]
