[26.467, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gchecker\u001b[15Gis\u001b[18Grunning\u001b[26Gnow\u001b[30Gwith\u001b[35Gthe\u001b[39Gright\u001b[45Ginvocation,\u001b[57G\u001b[38;2;87;105;247mpython3 check.py -- python3 -I run.py\u001b[39m.\u001b[96GAt\u001b[99Gabout\u001b[105G2.6\u001b[109Gs\u001b[111Gper\u001b[115Gtoken\r\u001b[1B \u001b[3Git will take a few\u001b[22Gminutes.\u001b[31GI'll r\u001b[38Gport the result and\u001b[58Gadd it to\u001b[68GNOTES.md when\u001b[82Git\u001b[85Gfinishes.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GBrewed\u001b[11Gor 3m 20s \u00b7 done 2:37 PM \u00b7 1 shell still running\r\u001b[2C\u001b[2B\u001b[39mBackground shell command didn't finish before \u001b[51Ge\u001b[53Gprevious session ended\u001b[K\r\u001b[2B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimpleme"]
[26.468, "ntations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gprevious\u001b[16Gchecker\u001b[24Grun\u001b[28Gwas\u001b[32Gkilled\u001b[39Gbefore\u001b[46Git\u001b[49Gprinted\u001b[57Ganything,\u001b[67Gso\u001b[70GI\u001b[72Gstill\u001b[78Ghave\u001b[83Gno\u001b[86Gvalidation\u001b[97Gresult.\u001b[105GI'll\u001b[110Grestart\u001b[118Git\r\u001b[1B \u001b[3Gin the background \u001b[22Gn the\u001b[28Gcurrent ver\u001b[40Gion and benchmark alternat\u001b[67Gves meanwhile.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[39m Checking RAM and CPU count\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -c \"import os; print(os.sysconf('SC_PHYS_PAGES')*os.sysconf('SC_PAGE_SIZE')/2**30, 'GiB', \u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mos.cpu_count())\"\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[26.468, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mCheck RAM and CPU count\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m python3 -c \"import os; print(os.sysconf('SC_PHYS_PAGES')*os.sysconf('SC_PAGE_SIZE')/2**30,\u001b[95G'GiB',\u001b[102Gos.cpu_count())\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
