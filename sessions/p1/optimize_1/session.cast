[62.571, "[13Gand\u001b[17G8\u001b[19Gcores,\u001b[26Gthough\u001b[33Gcompute\u001b[41Gmust\u001b[46Gstay\u001b[51Gsingle-threaded.\u001b[68GNext\u001b[73GI'll\u001b[78Gbenchmark\u001b[88Gmatmul\u001b[95Ginner-loop\u001b[106Gvariants\u001b[115Gthat\r\u001b[2C\u001b[1Bare all still explicit scalar loops:\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All variants produce identical results, and unrolling four rows per pass gives about\u001b[88Ga\u001b[90G22%\u001b[94Gspeedup\u001b[102Gwith\u001b[107Gno\u001b[110Gextra\r\u001b[1C\u001b[1B memory. Keeping weights as Python float\u001b[43Glists\u001b[49Gwould\u001b[55Gadd\u001b[59Ganother\u001b[67G~20%,\u001b[73Gbut\u001b[77Gat\u001b[80Groughly\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGB\u001b[108Gmachine,\u001b[117Gso\r\u001b[1B  I'm counting distinct weight values to see if deduplication makes that affordable.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Estima\u001b[10Ge distinct float32\u001b[29Gweight\u001b[36Gvalues\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/p1bench/uniq.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport struct, sys\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfrom array import a"]
[62.572, "rray\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mf=open(sys.argv[1],'rb'); f.read(28)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102ma=array('I'); a.frombytes(f.read(4*20_000_000))\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mfor n in (1_000_000, 5_000_000, 20_000_000):\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102ms=set(a[:n]); print(n, len(s), len(s)/n)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mEOF\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mpython3 -I /tmp/p1bench/uniq.py model.bin\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;238;142;110mPontificating\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(52s \u00b7 \u2193\u001b[27G5.3k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G   \u001b[40G   \u001b[44G                                         \u001b[86G        \u001b[95G  \u001b[98G     \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
