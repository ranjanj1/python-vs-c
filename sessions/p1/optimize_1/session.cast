[103.271, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m8\u001b[5GGiB\u001b[9GRAM\u001b[13Gand\u001b[17G8\u001b[19Gcores,\u001b[26Gthough\u001b[33Gcompute\u001b[41Gmust\u001b[46Gstay\u001b[51Gsingle-threaded.\u001b[68GNext\u001b[73GI'll\u001b[78Gbenchmark\u001b[88Gmatmul\u001b[95Ginner-loop\u001b[106Gvariants\u001b[115Gthat\r\u001b[1B \u001b[3Gare all still\u001b[17Gexplicit\u001b[26Gscalar\u001b[33Gl\u001b[35Go\u001b[37Gs:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gvariants\u001b[16Gproduce\u001b[24Gidentical\u001b[34Gresults,\u001b[43Gand\u001b[47Gunrolling\u001b[57Gfour\u001b[62Grows\u001b[67Gper\u001b[71Gpass\u001b[76Ggives\u001b[82Gabout\u001b[88Ga\u001b[90G22%\u001b[94Gspeedup\u001b[102Gwith\u001b[107Gno\u001b[110Gextra\r\u001b[1B \u001b[3Gmemory. Keeping weights as Python f\u001b[39Goat\u001b[43Glists w\u001b[51Gu\u001b[53Gd add another\u001b[67G~20%, but at roughly\u001b[88G3.5 GB on this 8 GB machine,\u001b[117Gso\r\u001b[2C\u001b[1BI'\u001b[6G counting distinct weight values to see if\u001b[49Gdeduplication makes that affordable.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m"]
