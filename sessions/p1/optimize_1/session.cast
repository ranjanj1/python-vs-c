[152.721, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m8 GiB RAM and 8 cores, tho\u001b[30Ggh compute must stay single-thr\u001b[62Gaded. Next I'll b\u001b[80Gnchmark\u001b[88Gmatmul\u001b[95Ginner-loop\u001b[106Gvariants\u001b[115Gthat\r\u001b[2C\u001b[1Bare\u001b[7Gall\u001b[11Gstill\u001b[17Gexplicit\u001b[26Gscalar\u001b[33Gloops:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gvariants produce identical results,\u001b[43Gand\u001b[47Gunrolling\u001b[57Gfour\u001b[62Grows\u001b[67Gper\u001b[71Gpass\u001b[76Ggives\u001b[82Gabout\u001b[88Ga\u001b[90G22%\u001b[94Gspeedup\u001b[102Gwith\u001b[107Gno\u001b[110Gextra\r\u001b[2C\u001b[1Bmemory.\u001b[11GKeeping\u001b[19Gweights\u001b[27Gas\u001b[30GPython\u001b[37Gfloat\u001b[43Glists\u001b[49Gwould\u001b[55Gadd\u001b[59Ganother\u001b[67G~20%,\u001b[73Gbut\u001b[77Gat\u001b[80Groughly\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGB\u001b[108Gmachine,\u001b[117Gso\r\u001b[2C\u001b[1BI'm counting distinct\u001b[25Gweight\u001b[32Gvalues\u001b[39Gto\u001b[42Gsee\u001b[46Gif\u001b[49Gdeduplication\u001b[63Gmakes\u001b[69Gthat\u001b[74Gaffordable.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r"]
[152.722, "\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDeduplication would still lea\u001b[33Ge the\u001b[39Glist layout around 2\u20133 GB since \u001b[72Gbout 64% of the\u001b[88Gfirst\u001b[94G20M\u001b[98Gweights\u001b[106Gare\u001b[110Gdistinct,\r\u001b[2C\u001b[1Bso\u001b[6GI'm\u001b[10Gdropping\u001b[19Git\u001b[22Gand\u001b[26Gtuning\u001b[33Gthe\u001b[37Gunroll\u001b[44Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mC\u001b[5Glumn\u001b[10Gunrolling loses\u001b[26Go\u001b[28Gt, wi\u001b[35G 4 o\u001b[40G 6 rows per\u001b[52Gpass\u001b[57Groughly\u001b[65Gtied\u001b[70G(~21\u001b[75Gvs\u001b[78G~27\u001b[82Gns/MAC);\u001b[91GI'm\u001b[95Ggoing\u001b[101Gwith\u001b[106G4,\u001b[109Gplus\u001b[114Ga\r\u001b[2C\u001b[1Bremainder\u001b[13Gpath\u001b[18Gfor\u001b[22Gother\u001b[28Gshapes,\u001b[36Gand\u001b[40Gprofiling\u001b[50Gthe\u001b[54Gfull\u001b[59Gbaseline\u001b[68Gforward\u001b[76Gpass\u001b[81Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39mBackground command\u001b[22G\"Run check\u001b[33Gr on baseline version, \u001b[57Gogging to file\" com\u001b[77Gleted (exit\u001b[89Gcode\u001b[94G0)\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102mead \u001b[1m1\u001b[22m fi\u001b[13Ge\u001b[15G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m"]
[152.723, "\u23fa\u001b[3G\u001b[39mThe baseline passes at 1.6\u001b[30G-5 error \u001b[40Gnd 75 s, with matmul at\u001b[64G97% of forward \u001b[80Gime. Next I'm\u001b[94Gunrolling\u001b[104Gmatmul,\u001b[112Gbatching\r\u001b[2C\u001b[1Bthe\u001b[7Gfloat32\u001b[15Groundings,\u001b[26Gand\u001b[30Gchecking\u001b[39Ghow\u001b[43Gfloat32\u001b[51Gconversion\u001b[62Ghandles\u001b[70Goverflow.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[3GPontificat\u001b[38;2;245;149;117ming\u001b[38;2;215;119;87m\u2026 \u001b[23G\u001b[38;2;102;102;102m1\u001b[30G11.3k tokens \u00b7 \u001b[38;2;157;157;157mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
