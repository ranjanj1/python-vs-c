[690.356, "\u001b[H\u001b[3G4.\u001b[6G\u001b[1mBug fix in SwiGLU:\u001b[22m the old\u001b[33Gshortcut\u001b[42Gset the activation\u001b[61Gto zero for inputs bel\u001b[84Gw \u221288\u001b[91GOverflow\u001b[100Gnow\u001b[104Ggoes\u001b[109Gto\u001b[112G\u001b[38;2;87;105;247minf\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gexactly as float32 do\u001b[28Gs,\u001b[31Gso inputs between\u001b[49G\u221288.72 and \u221288 are handl\u001b[74Gd as in C. None of the t\u001b[99Gsts hit this ca\u001b[115Ge.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502       \u001b[23Gtest\u001b[47G\u2502\u001b[52Gbefore\u001b[62G\u2502\u001b[71Gafter\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 \u001b[38;2;87;105;247mchec"]
