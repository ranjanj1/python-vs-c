[153.032, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39mBackground command \"Run \u001b[28Ghecker \u001b[36Gn baseline\u001b[47Gversion,\u001b[56Glogging\u001b[64Gto\u001b[67Gfile\"\u001b[73Gcompleted\u001b[83G(exit\u001b[89Gcode\u001b[94G0)\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102mead \u001b[1m1\u001b[22m fi\u001b[13Ge\u001b[15G\u001b[39m\u001b[K\r\u001b[2C\u001b[2BThe\u001b[7Gb\u001b[9Gseline\u001b[17Gasses at 1.6e-5 e\u001b[35Gror and\u001b[43G75 s, with matmul at 97% of\u001b[71Gforward time. Next\u001b[90GI'm\u001b[94Gunrolling matmul, batching\r\u001b[2C\u001b[1Bthe float32 roundin\u001b[23Gs, and\u001b[30Gchecking how\u001b[43Gfloat32 conversio\u001b[61G handles overflow.\u001b[80G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -I -c \"\r\u001b[5C\u001b[1Bfrom array import array\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mfor v in (3.4028235677973366e38, 3.5e38, 1e39, float('inf')):\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;102;102;102mtry: print(v, array('f',[v]).tolist())\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mexcept Exception as e: print(v, 'ERR', e)\r\u001b[2C\u001b[1B\u001b[39m"]
