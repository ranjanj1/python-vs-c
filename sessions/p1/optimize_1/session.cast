[183.072, "[22m zip(\u001b[9Gtt,vc[b:b+la\u001b[22Gt:kv_dim],vc[b+1:b+1+last:kv_dim],vc[b+2:b+2+last:kv_dim],vc[b+3:b+3+last:kv_d\u001b[101Gm]):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G v0+=a0*c;\u001b[26Gv1+=a1*\u001b[34G; v2+=a2*c; v3+=a3*c\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout[i]=v0;out[i+1]=v1;out[i+2]=v2;out[i+3]=v3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     return out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert\u001b[11Gold()==new()\r\u001b[1B \u001b[2m\u2502\u001b[22m for f in (\u001b[15Gld,new):\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G s=time.perf_counte\u001b[27G()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12G_\u001b[14Gin\u001b[17Grange(20):\u001b[28Gf()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f.__name__,\u001b[26G(time.perf_counter()-s)/20*1e9/(hs*npos),\u001b[68G\"ns/MAC\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 -I /tmp/p1benc\u001b[27G/b4.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
