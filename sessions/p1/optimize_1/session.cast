[205.096, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m Background command \"Run\u001b[27Gchecker on baseline\u001b[47Gversion,\u001b[56Glogging\u001b[64Gto\u001b[67Gfile\"\u001b[73Gcompleted\u001b[83G(exit\u001b[89Gcode\u001b[94G0)\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[41G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gbaseline\u001b[16Gpasses\u001b[23Gat\u001b[26G1.6e-5\u001b[33Gerror\u001b[39Gand 75 s,\u001b[49Gwith\u001b[54Gmatmul\u001b[61Gat 97% of forward\u001b[79Gtime.\u001b[85GNext\u001b[90GI'm\u001b[94Gunrolling\u001b[104Gmatmul,\u001b[112Gbatching\r\u001b[1C\u001b[1B the\u001b[7Gfloat32\u001b[15Groundings, and\u001b[30Gchecking\u001b[39Ghow\u001b[43Gfloat32\u001b[51Gconversion\u001b[62Ghandles\u001b[70Goverflow.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m \u001b[38;2;87;105;247marray('f')\u001b[39m overflows\u001b[24Gto\u001b[27G\u001b[38;2;87;105;247minf\u001b[31G\u001b[39mlike\u001b[36Ga\u001b[38GC\u001b[40Gfloat\u001b[46Gcast,\u001b[52Gso\u001b[55GSwiGLU\u001b[62Gnow\u001b[66Gmatches\u001b[74G\u001b[38;2;87;105;247mexpf\u001b[79G\u001b[39mexactly,\u001b[88Gwhich\u001b[94Galso\u001b[99Gcorr"]
[205.097, "ects\u001b[108Gthe\u001b[112Gold\u001b[116G\u001b[38;2;87;105;247mval <\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;87;105;247m-88\u001b[7G\u001b[39mshortc\u001b[15G. Next I'm rewriting\u001b[36Gthe\u001b[40Ghot\u001b[44Gpaths.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Before\u001b[10Greplacing\u001b[20Geverything, I'll\u001b[37Gtime\u001b[42Gthe\u001b[46Gattention\u001b[56Grestructure\u001b[68Gin\u001b[71Gisolation\u001b[81Gat\u001b[84Ga\u001b[86Glong\u001b[91Gcontext\u001b[99G(pos\u001b[104G500):\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Bit-identical and\u001b[21Gabout\u001b[27G35%\u001b[31Gfaster.\u001b[39GNow\u001b[43Gapplying\u001b[52Gall\u001b[56Gof\u001b[59Git\u001b[62Gto\u001b[65G\u001b[38;2;87;105;247mrun.py\u001b[39m:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Replace\u001b[11Gforward/matmul\u001b[26Gwith\u001b[31Gunrolled\u001b[40Gversions\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102msrc = open('run.py').read()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mstart = src.index(' # -- blocks ---')\u001b[44G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102me"]
