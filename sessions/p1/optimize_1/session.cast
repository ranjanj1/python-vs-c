[153.033, "\u2502\u001b[22m python3 -I -c \"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfrom\u001b[9Garray\u001b[15Gimport\u001b[22Garray\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for v in (3.4028235677973366e38,\u001b[37G3.5e38,\u001b[45G1e39,\u001b[51Gfloat('inf')):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mtry:\u001b[13Gprint(v,\u001b[22Garray('f',[v]).tolist())\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G except Exception as e: print(v, 'ERR', e)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \"\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b["]
