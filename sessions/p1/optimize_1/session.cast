[690.357, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 logits, LOGITS files, protocol output     \u2502 \u2013            \u2502 identical to before \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe checker's largest logit error is \u001b[41Gnchanged at\u001b[53G1.6e-5.\u001b[61GA forward pass at p\u001b[81Gsition\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRejected:\u001b[13G\u001b[22mstoring\u001b[21Gthe\u001b[25Gweights\u001b[33Gas\u001b[36GPython\u001b[43Gfloat\u001b[49Glists\u001b[55Gwould\u001b[61Gbe\u001b[64Gabout\u001b[70G20%\u001b[74Gfaster.\u001b[82GBut\u001b[86Git\u001b[89Gneeds\u001b[95Groughly\u001b[103G3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB machin\u001b[13G and \u001b[19Gdds 4.4 s \u001b[30Go loading, so it risks\u001b[53Gswapping.\u001b[63GI also left ou\u001b[79G\u001b[38;2;87;105;247mmath.sumprod\u001b[39m and \u001b[38;2;87;105;247msum(map(...))\u001b[39m:\u001b[111Gthey\u001b[116Gdo\r\u001b[2C\u001b[1Bthe\u001b[7Gdot\u001b[11Gproduct\u001b[19Gin\u001b[22GC,\u001b["]
[690.358, "25Gwhich\u001b[31Ggoes\u001b[36Gbeyond\u001b[43G\"scalar\u001b[51Gloops\".\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- Inner\u001b[11Gsums are accumulated in Pyth\u001b[41G's 64-bit\u001b[51Gfl\u001b[54Gats and\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[4C\u001b[1Bdiffer\u001b[12Gslightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference\u001b[42Ginstead\u001b[50Gof\u001b[53Gmatching\u001b[62Gbit\u001b[66Gfor\u001b[70Gbit.\u001b[75GRounding\u001b[84Gevery\u001b[90Gpartial\u001b[98Gsum\u001b[102Gwould\u001b[108Gmake\u001b[113Git\u001b[116Gabout\r\u001b[2C\u001b[1B  40\u00d7 slower.\r\u001b[5C\u001b[1Bt is\u001b[12Gtill slow: about 2.3 s\u001b[35Gper token, so sever\u001b[55Gl mi\u001b[60Gutes per 100\u001b[73Gtokens.\u001b[81G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe matrix-mu\u001b[19Gtiply routine is now 98% of the ti\u001b[54Ge, so further gains within P1\u001b[84Gwould\u001b[90Gneed \u001b[96G different way of storing\r\u001b[4C\u001b[1Bthe\u001b[9Gweights.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNO\u001b[6GES.\u001b[10Gd now has the commands, profiling\u001b[44Gtables, changes, test \u001b[67Gesult\u001b[74Gand limitations. The\u001b[95Gbenchma\u001b[103Gk scripts are in\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m, outside\u001b[25Gthe\u001b[29Gpr"]
