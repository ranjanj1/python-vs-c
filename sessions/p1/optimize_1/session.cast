[98.321, "es, though c\u001b[35Gmpute must stay single-thread\u001b[65Gd. Next\u001b[73GI'll benchmark\u001b[88Gmatmul\u001b[95Gi\u001b[97Gner-loop variants that\r\u001b[2C\u001b[1Bare\u001b[7Gall still expli\u001b[23Git scalar loop\u001b[38G:\u001b[K\r\u001b[2C\u001b[4BAll vari\u001b[12Gnts pr\u001b[19Gduce identic\u001b[32Gl results, and unrolling four\u001b[62Grow\u001b[66G per\u001b[71Gpass gives about\u001b[88Ga 22%\u001b[94Gspeedup with no\u001b[110Gextra\u001b[K\r\u001b[2C\u001b[1Bmemory. Kee\u001b[19Gweights as Python\u001b[37Gfloat lists would\u001b[55Gadd\u001b[59Ganother\u001b[67G~20%,\u001b[73Gbut\u001b[77Gat\u001b[80Groughly\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGB\u001b[108Gmachine,\u001b[117Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gcounting\u001b[16Gdistinct\u001b[25Gweight\u001b[32Gvalues\u001b[39Gto\u001b[42Gsee\u001b[46Gif\u001b[49Gdeduplication\u001b[63Gmakes\u001b[69Gthat\u001b[74Gaffordable.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mDeduplication would still leave\u001b[35Gthe\u001b[39Glist\u001b[44Glayout\u001b[51Garound\u001b[58G2\u20133\u001b[62GGB\u001b[65Gsince\u001b[71Gabout\u001b[77G64%\u001b[81Gof\u001b[84Gthe\u001b[88Gfirst\u001b[94G20M\u001b[98Gweights\u001b[106Gare\u001b[110Gdistinct,\r\u001b[2C\u001b[1Bso\u001b[6GI'm dropping it and tuning the unroll next.\r\u001b[5C"]
