[393.311, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAbout 22% faster\u001b[20Gper\u001b[24Gtoken\u001b[30G(2.93\u001b[36G\u2192\u001b[38G2.27\u001b[43Gs)\u001b[46Gwith\u001b[51Gbit-identical\u001b[65Glogits.\u001b[73GNext,\u001b[79Gthe\u001b[83Glong-context\u001b[96Gcost,\u001b[102Gtiming\u001b[109Ga\u001b[111Gsingle\r\u001b[2C\u001b[1Bforward at pos 1000 for each version:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell\u001b[15Gcommands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m At context position 1000, a forward pass takes 2.89 s versus about 2.27 s at short context, and dots (the matmul and\u001b[K\r\u001b[1C\u001b[1B attention arithmetic)\u001b[25Gis\u001b[28Gnow\u001b[32G98%\u001b[36Gof\u001b[39Gthe\u001b[43Gtime.\u001b[49GNext\u001b[54GI'll\u001b[59Gmeasure\u001b[67Gwhat\u001b[72Gstoring\u001b[80Gthe\u001b[84Gweights\u001b[92Gas\u001b[95Gpre-boxed\u001b[105GPython\u001b[112Gfloat\r\u001b[1C\u001b[1B lists actually costs in RSS, load time and speed.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Keeping\u001b[11Gweights as lists would be about 20% faster, but\u001b[59Gon this\u001b[67G8\u001b[69GGB\u001b[72Gmachine\u001b[80Git\u001b[83Gcosts\u001b[89Groughly\u001b[97G3.5\u001b[101GGB\u001b[104Gmore\u001b[1"]
[393.312, "09Gmemory\u001b[116Gand\r\u001b[1C\u001b[1B 4.4 s more \u001b[16Gad time,\u001b[25Gso I'm\u001b[32Grejecting\u001b[42Git\u001b[45Gand\u001b[49Gnoting\u001b[56Gthat\u001b[61Gin\u001b[64GNOTES.md.\u001b[74GRunning\u001b[82Gthe\u001b[86Gchecker\u001b[94Gon\u001b[97Gthe\u001b[101Gunrolled\r\u001b[1C\u001b[1B array-backed\u001b[16Gdesign\u001b[23Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The checker shows the same\u001b[30Gerror\u001b[36Gfigures\u001b[44Gas before,\u001b[55Gand\u001b[59Gwall\u001b[64Gtime\u001b[69Gdropped\u001b[77Gfrom\u001b[82G75.0\u001b[87Gs\u001b[89Gto\u001b[92G57.1\u001b[97Gs.\u001b[100GNext\u001b[105GI'll\u001b[110Grun\u001b[114Gboth\r\u001b[1C\u001b[1B versions \u001b[13Ghrough the same command script\u001b[44Gand\u001b[48Gdiff\u001b[53Gall\u001b[57Goutput,\u001b[65GLOGITS\u001b[72Gfiles\u001b[78Gincluded.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running identical protocol\u001b[30Gworkload\u001b[39Gthrough\u001b[47Gboth\u001b[52Gversions\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/p1bench && cat > work.txt <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mENCODE Once upon a time, there was a little girl named Lily.\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mENCODE h\u00e9llo w\u00f6rld \u2603 \u65e5"]
