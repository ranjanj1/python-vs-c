[393.229, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
