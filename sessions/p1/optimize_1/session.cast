[307.734, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBit-identical\u001b[17Gand\u001b[21Gabout\u001b[27G35%\u001b[31Gfaster.\u001b[39GNow\u001b[43Gapplying\u001b[52Gall\u001b[56Gof\u001b[59Git\u001b[62Gto\u001b[65G\u001b[38;2;87;105;247mrun.py\u001b[39m:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExcept\u001b[10Gfor\u001b[14Gthe\u001b[18Gcorrected\u001b[28GSwiGLU\u001b[35Goverflow\u001b[44Gedge,\u001b[50Gthe\u001b[54Gnew\u001b[58Gcode\u001b[63Gshould\u001b[70Ggive\u001b[75Gthe\u001b[79Gsame\u001b[84Gbits\u001b[89Gas\u001b[92Gv0.\u001b[96GI'll\u001b[101Gcheck\u001b[107Glogits\u001b[114Gbitwise\r\u001b[1B \u001b[3Gon a short\u001b[14Gsequence and time both:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAbout\u001b[9G22%\u001b[13Gfaster\u001b[20Gper\u001b[24Gtoken\u001b[30G(2.93\u001b[36G\u2192\u001b[38G2.27\u001b[43Gs)\u001b[46Gwith\u001b[51Gbit-identical\u001b[65Glogits.\u001b[73GNext,\u001b[79Gthe\u001b[83Glong-context\u001b[96Gcost,\u001b[102Gtiming\u001b[109Ga\u001b[111Gsingle\r\u001b[1B \u001b[3Gforward at pos 1000 for \u001b[28Gach version:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2"]
[307.735, "\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6Gcontext\u001b[14Gposition\u001b[23G1000,\u001b[29Ga\u001b[31Gforward\u001b[39Gpass\u001b[44Gtakes\u001b[50G2.89\u001b[55Gs\u001b[57Gversus\u001b[64Gabout\u001b[70G2.27\u001b[75Gs\u001b[77Gat\u001b[80Gshort\u001b[86Gcontext,\u001b[95Gand\u001b[99Gdots\u001b[104G(the\u001b[109Gmatmul\u001b[116Gand\r\u001b[1B \u001b[3Ga\u001b[5Gtention arithmetic) is now 98% of\u001b[39Gthe time. Next I'll mea\u001b[63Gure what storing\u001b[80Gt\u001b[82Ge weigh\u001b[90Gs as\u001b[95Gpre-b\u001b[101Gxed Python float\u001b[K\r\u001b[2C\u001b[1Blists actu\u001b[14Glly costs in RSS,\u001b[32Gload time and speed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mMeasuring\u001b[13Gmemory/time\u001b[25Gof\u001b[28Glist-of-rows\u001b[41Gweights\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1C\u001b[1B \u23bf  $ cat > /tmp/p1bench/listmem.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport time, resource, \u001b[30Gys\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfrom array import array\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mt0=time.perf_c\u001b[21Gunte\u001b[26G()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mf=open('/Users/agentlab/pvc/p1/model.bin','rb'); f.read(28)\r\u001b[5C\u001b[1Ba\u001b[8Garray('f'); a.frombytes(f.read())\u001b[39m\u001b"]
