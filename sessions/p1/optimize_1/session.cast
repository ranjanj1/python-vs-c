[215.925, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe baseline passes at 1.6e-5 error and\u001b[43G75\u001b[46Gs,\u001b[49Gwith\u001b[54Gmatmul\u001b[61Gat\u001b[64G97%\u001b[68Gof\u001b[71Gforward\u001b[79Gtime.\u001b[85GNext\u001b[90GI'm\u001b[94Gunrolling\u001b[104Gmatmul,\u001b[112Gbatching\r\u001b[2C\u001b[1Bthe float32 roundings, and\u001b[30Gchecking\u001b[39Ghow\u001b[43Gfloat32\u001b[51Gconversion\u001b[62Ghandles\u001b[70Goverflow.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247marray('f')\u001b[39m overflows to \u001b[38;2;87;105;247minf\u001b[39m like a C float cast, so SwiGLU now matches\u001b[74G\u001b[38;2;87;105;247mexpf\u001b[79G\u001b[39mexactly,\u001b[88Gwhich\u001b[94Galso\u001b[99Gcorrects\u001b[108Gthe\u001b[112Gold\u001b[116G\u001b[38;2;87;105;247mval <\r\u001b[2C\u001b[1B-88\u001b[39m shortcut.\u001b[17GNext\u001b[22GI'm\u001b[26Grewriting\u001b[36Gthe\u001b[40Ghot\u001b[44Gpaths.\r\u001b[2B  \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Before replacing everything, I'll time the attention restructure in isolation at\u001b[84Ga\u001b[86Glong\u001b[91Gcontext\u001b[99G(pos\u001b[104G500):\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b"]
