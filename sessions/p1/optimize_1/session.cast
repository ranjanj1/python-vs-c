[100.25, "\u001b[H\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m8\u001b[5GGiB RAM and 8 cores, though compute must\u001b[46Gstay\u001b[51Gsingle-threaded.\u001b[68GNext\u001b[73GI'll\u001b[78Gbenchmark\u001b[88Gmatmul\u001b[95Ginner-loop\u001b[106Gvariants\u001b[115Gthat\r\u001b[2C\u001b[1Bare all still\u001b[17Gexplicit\u001b[26Gscalar\u001b[33Gloops:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[9G\u001b[22mshell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m All variants produce identical results, and unrolling four rows per pass gives about a 22% speedup with no extra\u001b[K\r\u001b[1C\u001b[1B memory. Keeping\u001b[19Gweights\u001b[27Gas\u001b[30GPython\u001b[37Gfloat\u001b[43Glists\u001b[49Gwould\u001b[55Gadd\u001b[59Ganother\u001b[67G~20%,\u001b[73Gbut\u001b[77Gat\u001b[80Groughly\u001b[88G3.5\u001b[92GGB\u001b[95Gon\u001b[98Gthis\u001b[103G8\u001b[105GGB\u001b[108Gmachine,\u001b[117Gso\r\u001b[1C\u001b[1B I'm counting distinct weight values to see if deduplication makes that affordable.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Deduplication would still leave the\u001b[39Glist\u001b["]
