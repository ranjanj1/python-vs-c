[327.092, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExcept\u001b[10Gfor\u001b[14Gthe\u001b[18Gcorrected\u001b[28GSwiGLU\u001b[35Goverflow\u001b[44Gedge,\u001b[50Gthe\u001b[54Gnew\u001b[58Gcode\u001b[63Gshould\u001b[70Ggive\u001b[75Gthe\u001b[79Gsame\u001b[84Gbits\u001b[89Gas\u001b[92Gv0.\u001b[96GI'll\u001b[101Gcheck\u001b[107Glogits\u001b[114Gbitwise\r\u001b[1B \u001b[3Gon a short sequence and time\u001b[32Gboth:\u001b[K\r\u001b[2C\u001b[4BAbout 22% f\u001b[15Gster per token (2.93 \u2192 2.27\u001b[43Gs) with bit-identical\u001b[65Glogits.\u001b[73GNext,\u001b[79Gthe\u001b[83Glong-context\u001b[96Gcost,\u001b[102Gtiming\u001b[109Ga\u001b[111Gsingle\r\u001b[2C\u001b[1Bforward\u001b[11Gat\u001b[14Gpos\u001b[18G1000\u001b[23Gfor\u001b[27Geach\u001b[32Gversion:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt\u001b[6Gcontex\u001b[14Gposition\u001b[23G1000, a forward\u001b[39Gpass\u001b[44Gtakes\u001b[50G2.89\u001b[55Gs\u001b[57Gversus\u001b[64Gabout\u001b[70G2.27\u001b[75Gs\u001b[77Gat\u001b[80Gshort\u001b[86Gcontext,\u001b[95Gand\u001b[99Gdots\u001b[104G(the\u001b[109Gmatmul\u001b[116Gand\r\u001b[2C\u001b[1Battention\u001b[13Garithmetic)\u001b[25Gis\u001b[28Gnow\u001b[32G98%\u001b[36Gof\u001b[39Gthe\u001b[43Gtime.\u001b[49GNext\u001b[54GI'll\u001b[59Gmeasure\u001b[67Gwhat\u001b[72Gstoring\u001b[80Gthe\u001b[84Gweights\u001b[92Gas\u001b[95Gpre-boxed\u001b[105GPyt"]
[327.093, "hon\u001b[112Gfloat\r\u001b[2C\u001b[1Blists actually costs\u001b[24Gin\u001b[27GRSS,\u001b[32Gload\u001b[37Gtime\u001b[42Gand\u001b[46Gspeed.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mKeeping\u001b[11Gweights\u001b[19Gas\u001b[22Glists\u001b[28Gwould\u001b[34Gbe\u001b[37Gabout\u001b[43G20%\u001b[47Gfaster,\u001b[55Gbut\u001b[59Gon\u001b[62Gthis\u001b[67G8\u001b[69GGB\u001b[72Gmachine\u001b[80Git\u001b[83Gcosts\u001b[89Groughly\u001b[97G3.5\u001b[101GGB\u001b[104Gmore\u001b[109Gmemory\u001b[116Gand\r\u001b[2C\u001b[1B4.4 s more load time,\u001b[25Gso\u001b[28GI'm\u001b[32Grejecting\u001b[42Git\u001b[45Gand\u001b[49Gnoting\u001b[56Gthat\u001b[61Gin\u001b[64GNOTES.md.\u001b[74GRunning\u001b[82Gthe\u001b[86Gchecker\u001b[94Gon\u001b[97Gthe\u001b[101Gunrolled\r\u001b[2C\u001b[1Barray-backed\u001b[16Gdesign\u001b[23Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[13G\u001b[22mshell command\u2026\u001b[28G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ (time python3 check.py -- python3 -I run.py) > /tmp/p1bench/check_v1.log 2>&1; cat /tmp/p1bench/check_v1.log\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
