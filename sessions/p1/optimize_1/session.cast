[690.227, "\u001b[H\u001b[3G  \u001b[6Gindexing a\u001b[17Glist \u001b[23Glement by element: 36.9\u001b[47G\u2192 24.2 ns per multiply-add\u001b[74Gat posi\u001b[82Gion\u00a0500.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mFloat32 rounding:\u001b[22m done a who\u001b[36G vector at\u001b[47Ga\u001b[49Gtime\u001b[54Ginst\u001b[59Gad of one v\u001b[71Glue at a time, with\u001b[91Gthe\u001b[95Gsame\u001b[100Grounding\u001b[109Gpoints\u001b[116Gas\r\u001b[2C\u001b[1B  \u001b[6Gthe C code.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mBug fix in SwiGLU:\u001b[25G\u001b[22mthe\u001b[29Gold\u001b[33Gshortcut\u001b[42Gset\u001b[46Gthe\u001b[50Gactivation\u001b[61Gto\u001b[64Gzero\u001b[69Gfor\u001b[73Ginputs\u001b[80Gbelow\u001b[86G\u221288.\u001b[91GOverflow\u001b[100Gnow\u001b[104Ggoes\u001b[109Gto\u001b[112G\u001b[38;2;87;105;247minf\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gexactly as float32\u001b[25Gdo\u001b[28Gs, so inputs between \u221288.72 and \u221288\u001b[64Gare handled as in C. None of the tests hit this\u001b[112Gcase.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1"]
