[326.849, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBefore replacing everything,\u001b[32GI'll\u001b[37Gtime\u001b[42Gthe\u001b[46Gattention\u001b[56Grestructure\u001b[68Gin\u001b[71Gisolation\u001b[81Gat\u001b[84Ga\u001b[86Glong\u001b[91Gcontext\u001b[99G(pos\u001b[104G500):\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBit-identical and about\u001b[27G35%\u001b[31Gfaster.\u001b[39GNow\u001b[43Gapplying\u001b[52Gall\u001b[56Gof\u001b[59Git\u001b[62Gto\u001b[65G\u001b[38;2;87;105;247mrun.py\u001b[39m:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExcept\u001b[10Gfor\u001b[14Gthe\u001b[18Gcorrected\u001b[28GSwiGLU\u001b[35Goverflow\u001b[44Gedge,\u001b[50Gthe\u001b[54Gnew\u001b[58Gcode\u001b[63Gshould\u001b[70Ggive\u001b[75Gthe\u001b[79Gsame\u001b[84Gbits\u001b[89Gas\u001b[92Gv0.\u001b[96GI'll\u001b[101Gcheck\u001b[107Glogits\u001b[114Gbitwise\r\u001b[2C\u001b[1Bon a short sequence and\u001b[27Gtime\u001b[32Gboth:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAbout\u001b[9G22%\u001b[13Gfaster\u001b[20Gper\u001b[24Gtoken\u001b[30G(2.93\u001b[36G\u2192\u001b[38G2.27\u001b[43Gs)\u001b["]
[326.851, "46Gwith\u001b[51Gbit-identical\u001b[65Glogits.\u001b[73GNext,\u001b[79Gthe\u001b[83Glong-context\u001b[96Gcost,\u001b[102Gtiming\u001b[109Ga\u001b[111Gsingle\r\u001b[2C\u001b[1Bforward at pos 1000 for\u001b[27Geach\u001b[32Gversion:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAt context position 1000, a forward pass takes 2\u001b[52G89\u001b[55Gs\u001b[57Gversus\u001b[64Gabout\u001b[70G2.27\u001b[75Gs\u001b[77Gat\u001b[80Gshort\u001b[86Gcontext,\u001b[95Gand\u001b[99Gdots\u001b[104G(the\u001b[109Gmatmul\u001b[116Gand\r\u001b[2C\u001b[1Battention\u001b[13Garithmetic)\u001b[25Gis\u001b[28Gnow\u001b[32G98%\u001b[36Gof\u001b[39Gthe\u001b[43Gtime.\u001b[49GNext\u001b[54GI'll\u001b[59Gmeasure\u001b[67Gwhat\u001b[72Gstoring\u001b[80Gthe\u001b[84Gweights\u001b[92Gas\u001b[95Gpre-boxed\u001b[105GPython\u001b[112Gfloat\r\u001b[1B \u001b[3Glists actually costs in RSS, l\u001b[34Gad time and speed.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mKeeping weights as lists would\u001b[34Gbe\u001b[37Gabout\u001b[43G20%\u001b[47Gfaster,\u001b[55Gbut\u001b[59Gon\u001b[62Gthis\u001b[67G8\u001b[69GGB\u001b[72Gmachine\u001b[80Git\u001b[83Gcosts\u001b[89Groughly\u001b[97G3.5\u001b[101GGB\u001b[104Gmore\u001b[109Gmemory\u001b[116Gand\r\u001b[2C\u001b"]
[326.851, "[1B4.4 s more load time, so I'm rejecting it and noting that in NOTES.md.\u001b[74GRunning\u001b[82Gthe\u001b[86Gchecker\u001b[94Gon\u001b[97Gthe\u001b[101Gunrolled\r\u001b[2C\u001b[1Barray-backed design next.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[32C\u001b[2B\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
