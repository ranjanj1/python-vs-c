[689.195, "beyond \"scalar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GInner\u001b[11Gsums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[2C\u001b[1B \u001b[5Gdiffer slightly fro\u001b[25G the C\u001b[32Greference instead o\u001b[52G m\u001b[56Gchi\u001b[60Gg\u001b[62Gbit for\u001b[70Gbit. Rounding every partial sum\u001b[103Gould make \u001b[115G about\u001b[40;1H\u001b[38;3H"]
[689.289, "\u001b[H\u001b[3G   per-iteration\u001b[20Goverhead.\u001b[30GIt\u001b[33Gdrops\u001b[39Gfrom\u001b[44Gabout\u001b[50G27\u001b[53Gto\u001b[56G21\u001b[59Gns\u001b[62Gper\u001b[66Gmultiply-add.\u001b[80GEach\u001b[85Grow\u001b[89Gis\u001b[92Gstill\u001b[98Gsummed\u001b[105Gin\u001b[108Gthe\u001b[112Gsame\r\u001b[2C\u001b[1B  \u001b[6Gorder as the C code,\u001b[27Gs\u001b[29G results don't cha\u001b[48Gge.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mAttention:\u001b[22m it\u001b[20Gus\u001b[23Gs the same \u001b[36Gutine. The weighted\u001b[56Gsum of values now rea\u001b[78Gs\u001b[80Gstrided columns of the cache instead\u001b[117Gof\r\u001b[5C\u001b[1Bin\u001b[10Gxing\u001b[15Ga list el\u001b[25Gment\u001b[30Gby e\u001b[35Gement: 36.9 \u2192 24.2\u001b[54Gns\u001b[57Gper\u001b[61Gmultiply-add\u001b[74Gat\u001b[77Gposition\u00a0500.\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mFloat32 rounding:\u001b[22m don\u001b[29Ga whole vector at\u001b[47Ga time in\u001b[57Gtead of on\u001b[68G value at a\u001b[80Gtime, with the same rounding\u001b[109Gpoints as\u001b[K\r\u001b[5C\u001b[1Bthe C code.\u001b[K\r\u001b[2C\u001b[1B4\u001b[6G\u001b[1mBug fix\u001b[14Gin Sw\u001b[20GGLU:\u001b[22m th\u001b[29Gold shortcu\u001b[41G set the activation t\u001b[63G zero\u001b[69Gfor inputs\u001b[80Gbelow\u001b[86G\u221288.\u001b[91GOv\u001b[94Grflow\u001b[100Gn\u001b[102Gw goes\u001b[109Gt\u001b[111G \u001b[38;2;87;105;247minf\u001b[116G\u001b[39m\u001b[K\r\u001b[5C\u001b[1Bexactly as float32\u001b[25Gdoes,\u001b[3"]
[689.291, "1Gso\u001b[34Ginputs\u001b[41Gbetween\u001b[49G\u221288.72\u001b[56Gand\u001b[60G\u221288\u001b[64Gare\u001b[68Ghandled\u001b[76Gas\u001b[79Gin\u001b[82GC.\u001b[85GNone\u001b[90Gof\u001b[93Gthe\u001b[97Gtests\u001b[103Ghit\u001b[107Gthis\u001b[112Gcase.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[23Gtest\u001b[47G\u2502\u001b[52Gbefore\u001b[62G\u2502\u001b[71Gafter\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[47G\u253c\u001b[62G\u253c\u001b[84G\u2524\r\u001b[4C\u001b[1B\u001b[38;2;87;105;247mcheck.py\u001b[23G\u001b[39m    \u001b[49GPASS, 75.0\u001b[60Gs\u001b[64GPASS,\u001b[70G57.1 s\r\u001b[4C\u001b[2Btime per\u001b[14Gtoken,\u001b[21Gshort\u001b[27Gcontext\u001b[49G2.93 s    \u001b[60G \u001b[64G2.27 s    \u001b[75G \r\u001b[4C\u001b[2Bmy 45-step t\u001b[18Gst\u001b[22Gcript (all six\u001b[37Gcommands)\u001b[49G136.4 s\u001b[64G105.5 s\r\u001b[4C\u001b[2Blogits, LOGITS files, protocol output    \u001b[49G\u2013    \u001b[55G \u001b[64Gidentical\u001b[74Gto\u001b[77Gbefore\r\u001b[2C\u001b[1B\u2514\u001b[47G\u2534\u001b[62G\u2534\u001b[84G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe checker's largest logit error is u"]
[689.293, "nchanged at 1.6e-5. A forward pass at position\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[2B\u001b[1mRejected:\u001b[22m storing the\u001b[25Gweights as Pytho\u001b[42G float lists would\u001b[61Gbe about 20% fas\u001b[78Ger. But it needs roughly 3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB\u001b[6Gmachine\u001b[14Gand\u001b[18Gadds\u001b[23G4.4\u001b[27Gs\u001b[29Gto\u001b[32Gloading,\u001b[41Gso\u001b[44Git\u001b[47Grisks\u001b[53Gswapping.\u001b[63GI\u001b[65Galso\u001b[70Gleft\u001b[75Gout\u001b[79G\u001b[38;2;87;105;247mmath.sumprod\u001b[92G\u001b[39mand\u001b[96G\u001b[38;2;87;105;247msum(map(...))\u001b[39m:\u001b[111Gthey\u001b[116Gdo\r\u001b[2C\u001b[1Bthe dot product in C,\u001b[26Gh\u001b[28Gc\u001b[30G goe\u001b[36Gbeyond\u001b[43G\"sc\u001b[47Glar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B- Inner sums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[4C\u001b[1Bdiffer\u001b[12Gslightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference\u001b[42Ginstead\u001b[50Gof\u001b[53Gmatching\u001b[62Gbit\u001b[66Gfor\u001b[70Gbit.\u001b[75GRounding\u001b[84Gevery\u001b[90Gpartial\u001b[98Gsum\u001b[102Gwould\u001b[108Gmake\u001b[113Git"]
[689.293, "\u001b[116Gabout\r\u001b[2C\u001b[1B \u001b[5G40\u00d7 slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[40;1H\u001b[38;3H"]
[689.428, "\u001b[H\u001b[6Gorder as \u001b[16Ghe C code, so\u001b[30Gresults don't\u001b[44Gchange.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mAttention:\u001b[22m it uses the same routine. The weighted\u001b[56Gsum\u001b[60Gof\u001b[63Gvalues\u001b[70Gnow\u001b[74Greads\u001b[80Gstrided\u001b[88Gcolumns\u001b[96Gof\u001b[99Gthe\u001b[103Gcache\u001b[109Ginstead\u001b[117Gof\r\u001b[2C\u001b[1B  \u001b[6Gindexing a\u001b[17Glist \u001b[23Glement by element: 36.9\u001b[47G\u2192 24.2 ns per multiply-add\u001b[74Gat posi\u001b[82Gion\u00a0500.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mFloat32 rounding:\u001b[22m done a who\u001b[36G vector at\u001b[47Ga\u001b[49Gtime\u001b[54Ginst\u001b[59Gad of one v\u001b[71Glue at a time, with\u001b[91Gthe\u001b[95Gsame\u001b[100Grounding\u001b[109Gpoints\u001b[116Gas\r\u001b[2C\u001b[1B  \u001b[6Gthe C code.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mBug fix in SwiGLU:\u001b[25G\u001b[22mthe\u001b[29Gold\u001b[33Gshortcut\u001b[42Gset\u001b[46Gthe\u001b[50Gactivation\u001b[61Gto\u001b[64Gzero\u001b[69Gfor\u001b[73Ginputs\u001b[80Gbelow\u001b[86G\u221288.\u001b[91GOverflow\u001b[100Gnow\u001b[104Ggoes\u001b[109Gto\u001b[112G\u001b[38;2;87;105;247minf\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gexactly as float32\u001b[25Gdo\u001b[28Gs, so inputs between \u221288.72 and \u221288\u001b[64Gare handled as in C. None of the tests hit this\u001b[112Gcase.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b"]
[689.43, "[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                   test                    \u2502    before    \u2502        after        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 \u001b[38;2;87;105;247mcheck.py\u001b[39m                                  \u2502 PASS, 75.0 s \u2502 PASS, 57.1 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 time per token, short context  "]
[689.431, "           \u2502 2.93 s       \u2502 2.27 s              \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 my 45-step test script (all six commands) \u2502 136.4 s      \u2502 105.5 s             \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 logits, LOGITS files, protocol output     \u2502 \u2013            \u2502 identical to before \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2"]
[689.433, "C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gchecker's\u001b[17Glargest\u001b[25Glogit\u001b[31Gerror\u001b[37Gis\u001b[40Gunchanged\u001b[50Gat\u001b[53G1.6e-5.\u001b[61GA\u001b[63Gforward\u001b[71Gpass\u001b[76Gat\u001b[79Gposition\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRejected:\u001b[13G\u001b[22mstoring\u001b[21Gthe\u001b[25Gweights\u001b[33Gas\u001b[36GPython\u001b[43Gfloat\u001b[49Glists\u001b[55Gwould\u001b[61Gbe\u001b[64Gabout\u001b[70G20%\u001b[74Gfaster.\u001b[82GBut\u001b[86Git\u001b[89Gneeds\u001b[95Groughly\u001b[103G3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB machine and adds 4.4 s to loading, so it risk\u001b[52G \u001b[54Gwapping. I also\u001b[70Gleft ou\u001b[78G \u001b[38;2;87;105;247mmath.sumprod\u001b[39m and \u001b[38;2;87;105;247msum(map(...))\u001b[39m: they do\u001b[K\r\u001b[2C\u001b[1Bthe dot product in C, which goes beyond \"scalar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GInner\u001b[11Gsums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[2C\u001b[1B \u001b[5Gdiffer slightly fro\u001b[25G the C\u001b[32Greference instead o\u001b[52G m\u001b[56Gchi\u001b[60Gg\u001b["]
[689.433, "62Gbit for\u001b[70Gbit. Rounding every partial sum\u001b[103Gould make \u001b[115G about\r\u001b[4C\u001b[1B40\u00d7 slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt i\u001b[10G still\u001b[17Gslow:\u001b[23Gabout\u001b[29G2.3\u001b[33Gs\u001b[35Gper\u001b[39Gtoken,\u001b[46Gso\u001b[49Gseveral\u001b[57Gminutes\u001b[65Gper\u001b[69G100\u001b[73Gtokens.\u001b[40;1H\u001b[38;3H"]
[689.443, "\u001b[H\r\u001b[102C\u001b[35B\u001b[K\u001b[40;1H\u001b[38;3H"]
[689.723, "\u001b[H\r\u001b[4C\u001b[34BThe\u001b[9Gmatrix-multiply\u001b[25Groutine\u001b[33Gis\u001b[36Gnow\u001b[40G98%\u001b[44Gof\u001b[47Gthe\u001b[51Gtime,\u001b[57Gso\u001b[60Gfurther\u001b[68Ggains\u001b[74Gwithin\u001b[81GP1\u001b[84Gwould\u001b[90Gneed\u001b[95Ga\u001b[97Gdifferent\u001b[107Gway\u001b[111Gof\u001b[114Gstoring\u001b[40;1H\u001b[38;3H"]
[689.83, "\u001b[H\u001b[3G2.\u001b[6G\u001b[1mAttention:\u001b[22m it uses the same routine. The weighted\u001b[56Gsum\u001b[60Gof\u001b[63Gvalues\u001b[70Gnow\u001b[74Greads\u001b[80Gstrided\u001b[88Gcolumns\u001b[96Gof\u001b[99Gthe\u001b[103Gcache\u001b[109Ginstead\u001b[117Gof\r\u001b[2C\u001b[1B  \u001b[6Gindexing a\u001b[17Glist \u001b[23Glement by element: 36.9\u001b[47G\u2192 24.2 ns per multiply-add\u001b[74Gat posi\u001b[82Gion\u00a0500.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mFloat32 rounding:\u001b[22m done a who\u001b[36G vector at\u001b[47Ga\u001b[49Gtime\u001b[54Ginst\u001b[59Gad of one v\u001b[71Glue at a time, with\u001b[91Gthe\u001b[95Gsame\u001b[100Grounding\u001b[109Gpoints\u001b[116Gas\r\u001b[2C\u001b[1B  \u001b[6Gthe C code.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mBug fix in SwiGLU:\u001b[25G\u001b[22mthe\u001b[29Gold\u001b[33Gshortcut\u001b[42Gset\u001b[46Gthe\u001b[50Gactivation\u001b[61Gto\u001b[64Gzero\u001b[69Gfor\u001b[73Ginputs\u001b[80Gbelow\u001b[86G\u221288.\u001b[91GOverflow\u001b[100Gnow\u001b[104Ggoes\u001b[109Gto\u001b[112G\u001b[38;2;87;105;247minf\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gexactly as float32\u001b[25Gdo\u001b[28Gs, so inputs between \u221288.72 and \u221288\u001b[64Gare handled as in C. None of the tests hit this\u001b[112Gcase.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[689.831, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502                   test                    \u2502    before    \u2502        after        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 \u001b[38;2;87;105;247mcheck.py\u001b[39m                                  \u2502 PASS, 75.0 s \u2502 PASS, 57.1 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 time per token, short context             \u2502 2.93 s       \u2502 2.27 s              \u2502\r\u001b[2C\u001b[1B\u251c"]
[689.832, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 my 45-step test script (all six commands) \u2502 136.4 s      \u2502 105.5 s             \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 logits, LOGITS files, protocol output     \u2502 \u2013            \u2502 identical to before \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gchecker's\u001b[17Glargest\u001b[25Glogit\u001b[31Gerror\u001b[37"]
[689.834, "Gis\u001b[40Gunchanged\u001b[50Gat\u001b[53G1.6e-5.\u001b[61GA\u001b[63Gforward\u001b[71Gpass\u001b[76Gat\u001b[79Gposition\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mRejected:\u001b[13G\u001b[22mstoring\u001b[21Gthe\u001b[25Gweights\u001b[33Gas\u001b[36GPython\u001b[43Gfloat\u001b[49Glists\u001b[55Gwould\u001b[61Gbe\u001b[64Gabout\u001b[70G20%\u001b[74Gfaster.\u001b[82GBut\u001b[86Git\u001b[89Gneeds\u001b[95Groughly\u001b[103G3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB machine and adds 4.4 s to loading, so it risk\u001b[52G \u001b[54Gwapping. I also\u001b[70Gleft ou\u001b[78G \u001b[38;2;87;105;247mmath.sumprod\u001b[39m and \u001b[38;2;87;105;247msum(map(...))\u001b[39m: they do\u001b[K\r\u001b[2C\u001b[1Bthe dot product in C, which goes beyond \"scalar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m- Inner sums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[4C\u001b[1Bdiffer\u001b[12Gslightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference\u001b[42Ginstead\u001b[50Gof\u001b[53Gmatching\u001b[62Gbit\u001b[66Gfor\u001b[70Gbit.\u001b[75GRounding\u001b[84Gevery\u001b[90Gpartial\u001b[98Gsum\u001b[102Gwould\u001b[1"]
[689.835, "08Gmake\u001b[113Git\u001b[116Gabout\r\u001b[2C\u001b[1B \u001b[5G40\u00d7 slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt is still s\u001b[19Gow: about 2.3 s per toke\u001b[44G, so sever\u001b[55Gl m\u001b[60Gutes per 100 tokens.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gmatrix-multiply\u001b[25Groutine\u001b[33Gis\u001b[36Gnow\u001b[40G98%\u001b[44Gof\u001b[47Gthe\u001b[51Gtime,\u001b[57Gso\u001b[60Gfurther\u001b[68Ggains\u001b[74Gwithin\u001b[81GP1\u001b[84Gwould\u001b[90Gneed\u001b[95Ga\u001b[97Gdifferent\u001b[107Gway\u001b[111Gof\u001b[114Gstoring\r\u001b[2C\u001b[1B \u001b[5Gthe weights.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\u001b[40;1H\u001b[38;3H"]
