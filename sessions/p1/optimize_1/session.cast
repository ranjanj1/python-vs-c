[662.421, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExcept for\u001b[14Gthe corrected SwiGLU overflow\u001b[44Gedge,\u001b[50Gthe\u001b[54Gnew\u001b[58Gcode\u001b[63Gshould\u001b[70Ggive\u001b[75Gthe\u001b[79Gsame\u001b[84Gbits\u001b[89Gas\u001b[92Gv0.\u001b[96GI'll\u001b[101Gcheck\u001b[107Glogits\u001b[114Gbitwise\r\u001b[2C\u001b[1Bon\u001b[6Ga\u001b[8Gshort\u001b[14Gsequence\u001b[23Gand\u001b[27Gtime\u001b[32Gboth:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAbout 22% faster per tok\u001b[28Gn (2.93 \u2192 2.27\u001b[43Gs)\u001b[46Gwith\u001b[51Gbit-identical\u001b[65Glogits.\u001b[73GNext,\u001b[79Gthe\u001b[83Glong-context\u001b[96Gcost,\u001b[102Gtiming\u001b[109Ga\u001b[111Gsingle\r\u001b[2C\u001b[1Bforward\u001b[11Gat\u001b[14Gpos\u001b[18G1000\u001b[23Gfor\u001b[27Geach\u001b[32Gversion:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mA\u001b[5G context position 1000, a forward\u001b[39Gpass takes 2.89 s versu\u001b[63G about 2.27 s at\u001b[80Gs\u001b[82Gort con\u001b[90Gext,\u001b[95Gand d\u001b[101Gts (the matmul and\r\u001b[2C\u001b[1Battention \u001b[14Grithmetic) is now\u001b[32G98% of the time. Next\u001b[54GI'll\u001b[59Gmeasure\u001b[67Gwhat\u001b[72Gstoring\u001b[80Gthe\u001b[84Gweight"]
[662.423, "s\u001b[92Gas\u001b[95Gpre-boxed\u001b[105GPython\u001b[112Gfloat\r\u001b[2C\u001b[1Blists\u001b[9Gactually\u001b[18Gcosts\u001b[24Gin\u001b[27GRSS,\u001b[32Gload\u001b[37Gtime\u001b[42Gand\u001b[46Gspeed.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mKeeping w\u001b[13Gights\u001b[19Gas lists\u001b[28Gwould b\u001b[36G about 20% faster, but on this 8 GB machi\u001b[78Ge it costs roughly\u001b[97G3.5\u001b[101GGB mor\u001b[108G memory\u001b[116Gand\r\u001b[2C\u001b[1B4.4 s more load time, so I'm\u001b[32Grejecting\u001b[42Git\u001b[45Gand\u001b[49Gnoting\u001b[56Gthat\u001b[61Gin\u001b[64GNOTES.md.\u001b[74GRunning\u001b[82Gthe\u001b[86Gchecker\u001b[94Gon\u001b[97Gthe\u001b[101Gunrolled\r\u001b[2C\u001b[1Barray-backed\u001b[16Gdesign\u001b[23Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe checker shows the same error figures\u001b[45Gs before, and wall time dropped from 75.0 s\u001b[89Gto\u001b[92G57.1\u001b[97Gs.\u001b[100GNext\u001b[105GI'll\u001b[110Grun\u001b[114Gboth\r\u001b[2C\u001b[1Bversions\u001b[12Gthrough\u001b[20Gthe\u001b[24Gsame\u001b[29Gcommand\u001b[37Gscript\u001b[44Gand\u001b[48Gdiff\u001b[53Gall\u001b[57Goutput,\u001b[65GLOGITS\u001b[72Gfiles\u001b[78Gincluded.\r\u001b[2C\u001b[1B\u001b"]
[662.424, "[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProtocol \u001b[13Gutput and LOGITS\u001b[30Gfiles are identical between\u001b[58Gversions.\u001b[68GOn\u001b[71Gthis\u001b[76G45-forward\u001b[87Gworkload,\u001b[97Gwall\u001b[102Gtime\u001b[107Gwent\u001b[112Gfrom\r\u001b[2C\u001b[1B136.4\u001b[9Gs\u001b[11Gto\u001b[14G105.5\u001b[20Gs\u001b[22G(\u221223%).\u001b[30GNow\u001b[34Gupdating\u001b[43GNOTES.md:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Reading NOTES.md\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  NOTES.md\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;171;43;63m\u273b\u001b[39m \u001b[38;2;171;43;63mWaiting for API response\u001b[38;2;102;102;102m \u00b7 w\u001b[32Gll\u001b[35Gretry in 2m 40s \u00b7 check you\u001b[63G network\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
