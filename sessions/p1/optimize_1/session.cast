[212.002, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mColumn\u001b[10Gunrolling\u001b[20Gloses\u001b[26Gout,\u001b[31Gwith\u001b[36G4\u001b[38Gor\u001b[41G6\u001b[43Grows\u001b[48Gper\u001b[52Gpass\u001b[57Groughly\u001b[65Gtied\u001b[70G(~21\u001b[75Gvs\u001b[78G~27\u001b[82Gns/MAC);\u001b[91GI'm\u001b[95Ggoing\u001b[101Gwith\u001b[106G4,\u001b[109Gplus\u001b[114Ga\r\u001b[2C\u001b[1Bremainder path for other\u001b[28Gshapes,\u001b[36Gand\u001b[40Gprofiling\u001b[50Gthe\u001b[54Gfull\u001b[59Gbaseline\u001b[68Gforward\u001b[76Gpass\u001b[81Gnext.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39mBackground command\u001b[22G\"Run\u001b[27Gchecker\u001b[35Gon\u001b[38Gbaseline\u001b[47Gversion,\u001b[56Glogging\u001b[64Gto\u001b[67Gfile\"\u001b[73Gcompleted\u001b[83G(exit\u001b[89Gcode\u001b[94G0)\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[16G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gbaseline\u001b[16Gpasses\u001b[23Gat\u001b[26G1.6e-5\u001b[33Gerror\u001b[39Gand\u001b[43G75\u001b[46Gs,\u001b[49Gwith\u001b[54Gmatmul\u001b[61Gat\u001b[64G97%\u001b[68Gof\u001b[71Gforward\u001b[79Gtime.\u001b[85GNext\u001b[90GI'm\u001b[94Gunrolling\u001b[104Gmatmul,\u001b[112Gbatching\r\u001b[2C\u001b[1Bthe float32 roundings,\u001b[26Gand\u001b[30Gchecking\u001b[39Ghow\u001b[43Gfloat32\u001b[51Gconversion\u001b[62Ghandles\u001b[70Goverflow.\r\u001b"]
[212.003, "[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247marray('f')\u001b[14G\u001b[39moverflows\u001b[24Gto\u001b[27G\u001b[38;2;87;105;247minf\u001b[31G\u001b[39mlike\u001b[36Ga\u001b[38GC\u001b[40Gfloat\u001b[46Gcast,\u001b[52Gso\u001b[55GSwiGLU\u001b[62Gnow\u001b[66Gmatches\u001b[74G\u001b[38;2;87;105;247mexpf\u001b[79G\u001b[39mexactly,\u001b[88Gwhich\u001b[94Galso\u001b[99Gcorrects\u001b[108Gthe\u001b[112Gold\u001b[116G\u001b[38;2;87;105;247mval <\r\u001b[2C\u001b[1B-88\u001b[39m shortcut.\u001b[17GNext\u001b[22GI'm\u001b[26Grewriting\u001b[36Gthe\u001b[40Ghot\u001b[44Gpaths.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBefore replacing everything,\u001b[32GI'll\u001b[37Gtime\u001b[42Gthe\u001b[46Gattention\u001b[56Grestructure\u001b[68Gin\u001b[71Gisolation\u001b[81Gat\u001b[84Ga\u001b[86Glong\u001b[91Gcontext\u001b[99G(pos\u001b[104G500):\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBit-id\u001b[10Gntical and about 35%\u001b[31Gfaster. Now applying\u001b[52Gall\u001b[56Gof\u001b[59Git\u001b[62Gto\u001b[65G\u001b[38;2;87;105;247mrun.py\u001b[39m:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comma\u001b[21Gd \u001b[39m\u001b[K\r\u001b[5C"]
