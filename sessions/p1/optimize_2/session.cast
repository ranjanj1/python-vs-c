[485.813, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mModel init dropped from 0.79 s to\u001b[37G0.11\u001b[42Gs\u001b[44Gand\u001b[48Gpeak\u001b[53GRSS\u001b[57Gfrom\u001b[62G1.25\u001b[67Gto\u001b[70G0.53\u001b[75GGiB,\u001b[80Gwith\u001b[85Glogits\u001b[92Gstill\u001b[98Gbit-identical.\u001b[113GNext\r\u001b[2C\u001b[1BI'll\u001b[8Grun\u001b[12Gthe\u001b[16Gfull\u001b[21Gchecker\u001b[29Gand\u001b[33Gdiff\u001b[38Gthe\u001b[42Gprotocol\u001b[51Gscript's\u001b[60Goutput\u001b[67Gagainst\u001b[75Gthe\u001b[79Gearlier\u001b[87Gruns.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChecker: PASS, 57.1 s,\u001b[26Gsame\u001b[31Gerrors.\u001b[39GThe\u001b[43Gprotocol\u001b[52Gscript's\u001b[61Goutput\u001b[68Gand\u001b[72GLOGITS\u001b[79Gfile\u001b[84Gare\u001b[88Gidentical\u001b[98Gto\u001b[101Gthe\u001b[105Goriginal\u001b[114Gv0,\u001b[118Gat\r\u001b[2C\u001b[1B105.5\u001b[9Gs.\u001b[12GUpdating\u001b[21GNOTES.md:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m12\u001b[15G\u001b[22mlines\r\u001b[1B \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 40 \u001b[22m python3 -I /tmp/p1bench/run_v{0,1}.py model.bin tokenizer.bin < /tmp/p1bench/work.txt   # protocol diff\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m 41 \u001b[22m"]
