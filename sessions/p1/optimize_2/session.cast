[492.769, " byte fallback, empty), 3 PI\u001b[89GC\u001b[91G,\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m16\u001b[12G\u001b[22mFIXED of 10 ids, LOGITS of 5 ids, `GENERATE 24 Once upon a time`, and `GENERATE 1 The cat`.\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m6\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 237 \u001b[22m   take minutes per 100 tokens. Since `dots()` is 98% of the time, further gains within P1\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 238 \u001b[22m   would need a different weight representation (rejected above for memory) or a newer\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 239 \u001b[22m   interpreter.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 240 -\u001b[38;2;51;51;51m- Peak memory is about \u001b[48;2;255;199;199m1\u001b[48;2;255;220;220m GiB: the 0.44 GB weight array plus two 38 MB KV caches, which are            \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m40\u001b[12G\u001b[38;2;51;51;51m-\u001b[14GP\u001b[19Gmemory \u001b[27Gs\u001b[29Gabout \u001b[48;2;178;255;178m0.53\u001b[48;2;220;2"]
[492.77, "55;220m GiB:\u001b[45Gthe 0.44\u001b[54GGB weight array\u001b[70Gplus\u001b[75Gtwo\u001b[79G38\u001b[82GMB\u001b[85GKV\u001b[88Gcaches,\u001b[96Gwhich\u001b[102Gare\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 241 \u001b[22m   reallocated per command.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m42\u001b[12G\u001b[38;2;51;51;51m-\u001b[14GAfter tw\u001b[23G profiling passes, \u001b[43Ghe kernel is at\u001b[59Gits measured\u001b[72Gfloor\u001b[78Gfor\u001b[82Garray-backed\u001b[95Gweights\u001b[103Gin\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m43\u001b[12G\u001b[38;2;51;51;51m \u001b[14GCPython 3.12: ab\u001b[31Gut 10 ns/MAC of iteration and box\u001b[65Gng\u001b[68Gplus about 10 ns/MAC of arithmetic.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m44\u001b[14G\u001b[38;2;51;51;51mThe\u001b[18Gonly\u001b[23Gfaster\u001b[30Glayout\u001b[37GI\u001b[39Gmeasured\u001b[48Gis\u001b[51Gweights\u001b[59Gkept\u001b[64Gpermanently\u001b[76Gas\u001b[79GPython\u001b[86Gfloat\u001b[92Glists\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 245 +\u001b[38;2;51;51;51m  (about 16 ns/MAC, roughly 20% faster). It costs about 3.5 GB, which I judged too much               \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 246 +\u001b[38;2;51;51;51m  for this 8 GiB machine.                                                                             \r\u001b[7C\u001b[1B"]
[492.77, "\u001b[49m\u001b[2m47\u001b[12G\u001b[22m- PIECE for\u001b[24Gthe `<0x00>` byte token prints `HEX 00`\u001b[64G(the\u001b[69Gdecod\u001b[75Gd byte). C's `safe_printf`\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 248 \u001b[22m   would treat that piece as an empty string.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 249 \u001b[22m - Inputs longer than seq_len: FIXED/LOGITS process only the first seq_len ids. GENERATE reports\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m9\u001b[29G1\u001b[39m\u001b[40;1H\u001b[38;3H"]
