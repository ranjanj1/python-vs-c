[43.842, "ut\u001b[86Git\u001b[89Gneeds\u001b[95Groughly\u001b[103G3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB machine and adds 4.4 s to loading, so it risk\u001b[52G \u001b[54Gwapping. I also\u001b[70Gleft ou\u001b[78G \u001b[38;2;87;105;247mmath.sumprod\u001b[39m and \u001b[38;2;87;105;247msum(map(...))\u001b[39m: they do\u001b[K\r\u001b[2C\u001b[1Bthe dot product in C, which goes beyond \"scalar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m- Inner sums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[2C\u001b[1B \u001b[5Gdiffer slightly fro\u001b[25G the C\u001b[32Greference instead o\u001b[52G m\u001b[56Gchi\u001b[60Gg\u001b[62Gbit for\u001b[70Gbit. Rounding every partial sum\u001b[103Gould make \u001b[115G about\r\u001b[4C\u001b[1B40\u00d7 slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt i\u001b[10G still\u001b[17Gslow:\u001b[23Gabout\u001b[29G2.3\u001b[33Gs\u001b[35Gper\u001b[39Gtoken,\u001b[46Gso\u001b[49Gseveral\u001b[57Gminutes\u001b[65Gper\u001b[69G100\u001b[73Gtokens.\r\u001b[4C\u001b[1BThe matr\u001b[14Gx-mu\u001b[19Gtiply routine\u001b[33Gis now 98% of the time,\u001b[57Gso further gains within\u001b[81GP1\u001b[84Gwould\u001b[90Gneed\u001b[95"]
[43.844, "Ga\u001b[97Gdifferent\u001b[107Gway\u001b[111Gof\u001b[114Gstoring\r\u001b[2C\u001b[1B \u001b[5Gt\u001b[9Gweights.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md\u001b[12Gnow\u001b[16Ghas\u001b[20Gthe\u001b[24Gcommands,\u001b[34Gprofiling\u001b[44Gtables,\u001b[52Gchanges,\u001b[61Gtest\u001b[66Gresults\u001b[74Gand\u001b[78Glimitations.\u001b[91GThe\u001b[95Gbenchmark\u001b[105Gscripts\u001b[113Gare\u001b[117Gin\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m, outside the project \u001b[38Go\u001b[40Gder.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCrunched for 11m 12s \u00b7 done 2:48 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gremaining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2736\u001b[3GProcessing\u2026 \u001b[38;2;102;102;102m(39s \u00b7 "]
