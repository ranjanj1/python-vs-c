[43.937, "\u001b[H\r\u001b[4C\u001b[1Btime per\u001b[14Gtoken,\u001b[21Gshort\u001b[27Gcontext\u001b[49G2.93 s    \u001b[60G \u001b[64G2.27 s    \u001b[75G \r\u001b[4C\u001b[2Bmy 45-step t\u001b[18Gst\u001b[22Gcript (all six\u001b[37Gcommands)\u001b[49G136.4 s\u001b[64G105.5 s\r\u001b[4C\u001b[2Blogits, LOGITS files, protocol output    \u001b[49G\u2013    \u001b[55G \u001b[64Gidentical\u001b[74Gto\u001b[77Gbefore\r\u001b[2C\u001b[1B\u2514\u001b[47G\u2534\u001b[62G\u2534\u001b[84G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe checker's largest logit error is unchanged at 1.6e-5. A forward pass at position\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[2B\u001b[1mRejected:\u001b[22m storing the\u001b[25Gweights as Pytho\u001b[42G float lists would\u001b[61Gbe about 20% fas\u001b[78Ger. But it needs roughly 3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB\u001b[6Gmachine\u001b[14Gand\u001b[18Gadds\u001b[23G4.4\u001b[27Gs\u001b[29Gto\u001b[32Gloading,\u001b[41Gso\u001b[44Git\u001b[47Grisks\u001b[53Gswapping.\u001b[63GI\u001b[65Galso\u001b[70Gleft\u001b[75Gout\u001b[79G\u001b[38;2;87;105;247mmath.sumprod\u001b[92G\u001b[39mand\u001b[96G\u001b[38;2;87;105;247msum(map(...))\u001b[39m:\u001b[111Gthey\u001b[116Gdo\r\u001b[2C\u001b[1Bthe dot product in C,\u001b[26Gh\u001b[28Gc\u001b[30G goe\u001b[36Gbeyond\u001b[43G\"sc\u001b[47Glar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b["]
[43.938, "5GInner\u001b[11Gsums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[2C\u001b[1B  differ slightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference\u001b[42Ginstead\u001b[50Gof\u001b[53Gmatching\u001b[62Gbit\u001b[66Gfor\u001b[70Gbit.\u001b[75GRounding\u001b[84Gevery\u001b[90Gpartial\u001b[98Gsum\u001b[102Gwould\u001b[108Gmake\u001b[113Git\u001b[116Gabout\r\u001b[2C\u001b[1B \u001b[5G40\u00d7 slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt is still s\u001b[19Gow: about 2.3 s per toke\u001b[44G, so sever\u001b[55Gl m\u001b[60Gutes per 100 tokens.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gmatrix-multiply\u001b[25Groutine\u001b[33Gis\u001b[36Gnow\u001b[40G98%\u001b[44Gof\u001b[47Gthe\u001b[51Gtime,\u001b[57Gso\u001b[60Gfurther\u001b[68Ggains\u001b[74Gwithin\u001b[81GP1\u001b[84Gwould\u001b[90Gneed\u001b[95Ga\u001b[97Gdifferent\u001b[107Gway\u001b[111Gof\u001b[114Gstoring\r\u001b[2C\u001b[1B \u001b[5Gthe weights.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md now has\u001b[20Gthe\u001b[24Gcommands,\u001b[34Gprofiling\u001b[44Gtables,\u001b[52Gchanges,\u001b[61Gtest\u001b[66Gresults\u001b[74Gand\u001b[78Glimitations.\u001b[91GThe\u001b[95Gbenchmark\u001b[105Gscripts\u001b[113Gare\u001b[117Gin\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m,\u001b[17Goutside\u001b[2"]
