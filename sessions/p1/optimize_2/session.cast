[240.718, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn-the-fly tolist() runs slower\u001b[35G(27\u201333\u001b[42Gns/MAC\u001b[49Gagainst\u001b[57G20.3),\u001b[64Gso\u001b[67Gthe\u001b[71Gcurrent\u001b[79Gkernel\u001b[86Gis\u001b[89Gnear\u001b[94Gthe\u001b[98Gfloor\u001b[104Gfor\u001b[108Garray-backed\r\u001b[2C\u001b[1Bweights. Next I'll A/B an 8-row unroll in\u001b[45Gthe\u001b[49Greal\u001b[54Gforward\u001b[62Gpass,\u001b[68Galternating\u001b[80Gruns\u001b[85Gto\u001b[88Gcontrol\u001b[96Gnoise.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m The 8-row kernel is slower in the real model (2.33 vs 2.28 s/token), so I've rejected it and kept the 4-row one. Next\u001b[K\r\u001b[1C\u001b[1B I'll measure\u001b[16Gthe\u001b[20Gper-command\u001b[32Gcosts\u001b[38Goutside\u001b[46Gthe\u001b[50Gkernel,\u001b[58Gincluding\u001b[68Gthe\u001b[72Gtwo\u001b[76G38\u001b[79GMB\u001b[82GKV\u001b[85Gcache\u001b[91Greallocations\u001b[105Gin\u001b[108G\u001b[38;2;87;105;247mreset()\u001b[39m.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan\u001b[7G\u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Per-forward cost dwarfs the per-command\u001b[4"]
