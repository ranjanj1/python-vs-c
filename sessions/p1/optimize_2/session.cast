[475.203, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mModel init dropped from\u001b[27G0.79\u001b[32Gs\u001b[34Gto\u001b[37G0.11\u001b[42Gs\u001b[44Gand\u001b[48Gpeak\u001b[53GRSS\u001b[57Gfrom\u001b[62G1.25\u001b[67Gto\u001b[70G0.53\u001b[75GGiB,\u001b[80Gwith\u001b[85Glogits\u001b[92Gstill\u001b[98Gbit-identical.\u001b[113GNext\r\u001b[2C\u001b[1BI'll\u001b[8Grun\u001b[12Gthe\u001b[16Gfull\u001b[21Gchecker\u001b[29Gand\u001b[33Gdiff\u001b[38Gthe\u001b[42Gprotocol\u001b[51Gscript's\u001b[60Goutput\u001b[67Gagainst\u001b[75Gthe\u001b[79Gearlier\u001b[87Gruns.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChecker: PASS, 57.1 s,\u001b[26Gsame\u001b[31Gerrors.\u001b[39GThe\u001b[43Gprotocol\u001b[52Gscript's\u001b[61Goutput\u001b[68Gand\u001b[72GLOGITS\u001b[79Gfile\u001b[84Gare\u001b[88Gidentical\u001b[98Gto\u001b[101Gthe\u001b[105Goriginal\u001b[114Gv0,\u001b[118Gat\r\u001b[2C\u001b[1B105.5\u001b[9Gs.\u001b[12GUpdating\u001b[21GNOTES.md:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[475.205, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\r\u001b[1B\u001b[22m\u001b[39m \u001b[38;2;102;102;102mNOTES.md\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 40 \u001b[22m python3 -I /tmp/p1bench/run_v{0,1}.py model.bin tokenizer.bin < /tmp/p1bench/work.txt   # protocol diff\r\u001b[1B\u001b[2m 41 \u001b[22m ```\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 42 \u001b[22m \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 43 +\u001b[38;2;51;51;51mSecond profiling pass (session 3):                                                                                 \r\u001b[1B\u001b[38;2;36;138;61m 44 +\u001b[38;2;51;51;51m```  "]
[475.206, "                                                                                                              \r\u001b[1B\u001b[38;2;36;138;61m 45 +\u001b[38;2;51;51;51mpython3 -I /tmp/p1bench/b5.py            # split kernel cost: iteration vs arithmetic; struct.iter_unpack          \r\u001b[1B\u001b[38;2;36;138;61m 46 +\u001b[38;2;51;51;51mpython3 -I /tmp/p1bench/b6.py 768 768; ... 768 2048; ... 2048 768   # on-the-fly tolist() rows                     \r\u001b[1B\u001b[38;2;36;138;61m 47 +\u001b[38;2;51;51;51mpython3 -I /tmp/p1bench/ab.py            # real-model A/B: 4-row vs 8-row kernel (3 interleaved reps)              \r\u001b[1B\u001b[38;2;36;138;61m 48 +\u001b[38;2;51;51;51mpython3 -I /tmp/p1bench/percmd.py        # per-command costs: load, reset, argmax, encode                          \r\u001b[1B\u001b[38;2;36;138;61m 49 +\u001b[38;2;51;51;51mpython3 -I /tmp/p1bench/load.py frombytes|fromfile ; python3 -I /tmp/p1bench/load2.py   # loaders                  \r\u001b[1B\u001b[38;2;36;138;61m 50 +\u001b[38;2;51;51;51mpython3 -I /tmp/p1bench/cmp3.py run_v1 ; python3 -I /tmp/p1bench/cmp3.py run_v3  "]
