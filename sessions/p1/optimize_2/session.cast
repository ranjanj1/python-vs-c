[500.093, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;181;181;181mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[500.195, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u00b7\u001b[4G\u001b[38;2;245;149;117mr\u001b[7G\u001b[38;2;215;119;87me\u001b[41G\u001b[38;2;177;177;177mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[500.319, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;169;169;169mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[500.421, "\u001b[H\r\u001b[2C\u001b[33B\u001b[38;2;245;149;117mP\u001b[6G\u001b[38;2;215;119;87mc\u001b[19G\u001b[38;2;102;102;102m8\u001b[41G\u001b[38;2;165;165;165mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
