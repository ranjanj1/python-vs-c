[237.165, "\r\u001b[2C\u001b[1Bcall.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn-the-fly tolist() runs\u001b[28Gslower\u001b[35G(27\u201333\u001b[42Gns/MAC\u001b[49Gagainst\u001b[57G20.3),\u001b[64Gso\u001b[67Gthe\u001b[71Gcurrent\u001b[79Gkernel\u001b[86Gis\u001b[89Gnear\u001b[94Gthe\u001b[98Gfloor\u001b[104Gfor\u001b[108Garray-backed\r\u001b[2C\u001b[1Bweights.\u001b[12GNext\u001b[17GI'll\u001b[22GA/B\u001b[26Gan\u001b[29G8-row\u001b[35Gunroll\u001b[42Gin\u001b[45Gthe\u001b[49Greal\u001b[54Gforward\u001b[62Gpass,\u001b[68Galternating\u001b[80Gruns\u001b[85Gto\u001b[88Gcontrol\u001b[96Gnoise.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe 8-row\u001b[13Gk\u001b[15Grnel\u001b[20Gis slower in the real model\u001b[48G(2.33\u001b[54Gvs\u001b[57G2.28\u001b[62Gs/token),\u001b[72Gso\u001b[75GI've\u001b[80Grejected\u001b[89Git\u001b[92Gand\u001b[96Gkept\u001b[101Gthe\u001b[105G4-row\u001b[111Gone.\u001b[116GNext\r\u001b[1B  I'll measure the per-command costs outside\u001b[46Gthe\u001b[50Gkernel,\u001b[58Gincluding\u001b[68Gthe\u001b[72Gtwo\u001b[76G38\u001b[79GMB\u001b[82GKV\u001b[85Gcache\u001b[91Greallocations\u001b[105Gin\u001b[108G\u001b[38;2;87;105;247mreset()\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell com\u001b[19G"]
[237.166, "and \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-forward cost dwarfs\u001b[27Gthe\u001b[31Gper-command\u001b[43Goverhead,\u001b[53Gbut\u001b[57Gmodel\u001b[63Gload\u001b[68Gtakes\u001b[74G1.4\u001b[78Gs\u001b[80Gagainst\u001b[88Ga\u001b[90Graw\u001b[94Gread\u001b[99Gof\u001b[102G0.44\u001b[107Gs,\u001b[110Glikely\r\u001b[2C\u001b[1Bbecause \u001b[38;2;87;105;247mf.read()\u001b[39m allocates\u001b[30Ga\u001b[32G438\u001b[36GMB\u001b[39Gbytes\u001b[45Gobject\u001b[52Gbefore\u001b[59Gcopying.\u001b[68GI'm\u001b[72Gtesting\u001b[80Ga\u001b[82Gread\u001b[87Gdirectly\u001b[96Ginto\u001b[101Gthe\u001b[105Garray\u001b[111Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mfromfile\u001b[39m loads faster and with less peak\u001b[44Gmemory\u001b[51Gthan\u001b[56G\u001b[38;2;87;105;247mfrombytes(f.read())\u001b[39m,\u001b[77Gso\u001b[80GI'm\u001b[84Gtesting\u001b[92Gwhether\u001b[100Gpre-sizing\u001b[111Gand\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247mreadinto\u001b[12G\u001b[39mcan\u001b[16Gavoid\u001b[22Gthe\u001b[26Gtemporary\u001b[36Gbuffer,\u001b[44Gstarting\u001b[53Gwith\u001b[58Gthe\u001b[62GKV\u001b[65Gcaches.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m3\u001b["]
