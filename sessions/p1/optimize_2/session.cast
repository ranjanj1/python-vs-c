[302.606, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn-the-fly\u001b[14Gtolist()\u001b[23Gruns\u001b[28Gslower\u001b[35G(27\u201333\u001b[42Gns/MAC\u001b[49Gagainst\u001b[57G20.3),\u001b[64Gso\u001b[67Gthe\u001b[71Gcurrent\u001b[79Gkernel\u001b[86Gis\u001b[89Gnear\u001b[94Gthe\u001b[98Gfloor\u001b[104Gfor\u001b[108Garray-backed\r\u001b[1B \u001b[3Gweights. Next I'll A/B an 8-row un\u001b[38Gol\u001b[42Gin the real\u001b[54Gforward\u001b[62Gpass, alternating\u001b[81Guns \u001b[86Go control\u001b[96Gnoise.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7G8-row\u001b[13Gkernel\u001b[20Gis\u001b[23Gslower\u001b[30Gin\u001b[33Gthe\u001b[37Greal\u001b[42Gmodel\u001b[48G(2.33\u001b[54Gvs\u001b[57G2.28\u001b[62Gs/token),\u001b[72Gso\u001b[75GI've\u001b[80Grejected\u001b[89Git\u001b[92Gand\u001b[96Gkept\u001b[101Gthe\u001b[105G4-row\u001b[111Gone.\u001b[116GNext\r\u001b[1B \u001b[3GI'll measure the\u001b[20Gper-command costs outside t\u001b[49G kernel, inc\u001b[62Guding\u001b[69Ghe two 38 MB KV cache reallocations in \u001b[38;2;87;105;247mreset()\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m"]
[302.608, "\u23fa\u001b[3G\u001b[39mPer-forward\u001b[15Gcost\u001b[20Gdwarfs\u001b[27Gthe\u001b[31Gper-command\u001b[43Goverhead,\u001b[53Gbut\u001b[57Gmodel\u001b[63Gload\u001b[68Gtakes\u001b[74G1.4\u001b[78Gs\u001b[80Gagainst\u001b[88Ga\u001b[90Graw\u001b[94Gread\u001b[99Gof\u001b[102G0.44\u001b[107Gs,\u001b[110Glikely\r\u001b[1B \u001b[3Gbecause \u001b[38;2;87;105;247mf.read()\u001b[39m alloc\u001b[26Gtes a 438 MB\u001b[39Gbytes object before copying. I'm testing\u001b[80Ga read d\u001b[89Grectly into the array\u001b[111Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mfromfile\u001b[12G\u001b[39mloads\u001b[18Gfaster\u001b[25Gand\u001b[29Gwith\u001b[34Gless\u001b[39Gpeak\u001b[44Gmemory\u001b[51Gthan\u001b[56G\u001b[38;2;87;105;247mfrombytes(f.read())\u001b[39m,\u001b[77Gso\u001b[80GI'm\u001b[84Gtesting\u001b[92Gwhether\u001b[100Gpre-sizing\u001b[111Gand\r\u001b[1B \u001b[12Gcan avoid the temporary buffer,\u001b[44Gst\u001b[47Grting with the KV caches.\u001b[73G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m \u001b[38;2;87;105;247mreadinto\u001b[39m loads in about\u001b[27G0.1\u001b[31Gs\u001b[33Gand\u001b[37Ghalves\u001b[44Gpeak\u001b[49Gmemory,\u001b[57Gso\u001b[60GI'm\u001b[64Gapplying\u001b"]
[302.609, "[73Git\u001b[76Gto\u001b[79Grun.py\u001b[86Gwith\u001b[91Ga\u001b[93Gretry\u001b[99Gloop\u001b[104Gfor\u001b[108Gshort\u001b[114Greads\r\u001b[2C\u001b[1Band allocating the KV caches without\u001b[40Gtemporaries.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22G\u001b[22mshell comm\u001b[33Gnd \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mModel init dropped from 0.79 s to 0.11 s and peak RSS from 1.25 to 0.53 GiB, with logits\u001b[92Gstill\u001b[98Gbit-identical.\u001b[113GNext\r\u001b[2C\u001b[1BI'll run the full checker and diff the protocol script's\u001b[60Goutput\u001b[67Gagainst\u001b[75Gthe\u001b[79Gearlier\u001b[87Gruns.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
[302.619, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 2s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
