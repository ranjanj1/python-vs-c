[308.215, "n \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mfromfile\u001b[12G\u001b[39mloads\u001b[18Gfaster\u001b[25Gand\u001b[29Gwith\u001b[34Gless\u001b[39Gpeak\u001b[44Gmemory\u001b[51Gthan\u001b[56G\u001b[38;2;87;105;247mfrombytes(f.read())\u001b[39m,\u001b[77Gso\u001b[80GI'm\u001b[84Gtesting\u001b[92Gwhether\u001b[100Gpre-sizing\u001b[111Gand\r\u001b[1B \u001b[3G\u001b[38;2;87;105;247mreadinto\u001b[12G\u001b[39mcan avoid the temporary buff\u001b[41Gr,\u001b[44Gstarting with the KV caches.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mreadinto\u001b[12G\u001b[39mloads\u001b[18Gin\u001b[21Gabout\u001b[27G0.1\u001b[31Gs\u001b[33Gand\u001b[37Ghalves\u001b[44Gpeak\u001b[49Gmemory,\u001b[57Gso\u001b[60GI'm\u001b[64Gapplying\u001b[73Git\u001b[76Gto\u001b[79Grun.py\u001b[86Gwith\u001b[91Ga\u001b[93Gretry\u001b[99Gloop\u001b[104Gfor\u001b[108Gshort\u001b[114Greads\r\u001b[1B \u001b[3Gand allocating\u001b[18Gthe KV caches without t\u001b[42Gmpor\u001b[47Gries.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mModel\u001b[9Ginit\u001b[14Gdropped\u001b[22Gfrom\u001b[27G0.79\u001b[32Gs\u001b[34Gto\u001b[37G0.11\u001b"]
