[81.665, "\u001b[H\u001b[2G \u001b[5Gthe\u001b[9Gweigh\u001b[15Gs.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B NOTES.md now\u001b[16Ghas\u001b[20Gthe\u001b[24Gcommands,\u001b[34Gprofiling\u001b[44Gtables,\u001b[52Gchanges,\u001b[61Gtest\u001b[66Gresults\u001b[74Gand\u001b[78Glimitations.\u001b[91GThe\u001b[95Gbenchmark\u001b[105Gscripts\u001b[113Gare\u001b[117Gin\r\u001b[1C\u001b[1B \u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m, outside\u001b[25Gthe\u001b[29Gproject\u001b[37Gfolder.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mCrunched for 11m 12s \u00b7 done 2:48 PM\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Same\u001b[8Grequest again,\u001b[23Gso this is a second\u001b[43Gpass\u001b[48Gon\u001b[51Gtop"]
[81.666, "\u001b[55Gof\u001b[58Gthe\u001b[62G4-row\u001b[68Gkernel.\u001b[76GThe\u001b[80Gprofile\u001b[88Galready\u001b[96Gshows\u001b[102G\u001b[38;2;87;105;247mdots()\u001b[109G\u001b[39mat\u001b[112G98%\u001b[116Gof\r\u001b[1C\u001b[1B the\u001b[7Gtime. Any further gain has\u001b[34Gto\u001b[37Gcome\u001b[42Gfrom\u001b[47Gthe\u001b[51Gcost\u001b[56Gper\u001b[60Gmultiply-add\u001b[73Gin\u001b[76Gthat\u001b[81Gloop,\u001b[87Gso\u001b[90GI'll\u001b[95Gfirst\u001b[101Gmeasure\u001b[109Gwhat\u001b[114Gthat\r\u001b[1C\u001b[1B cost\u001b[8Gis made of.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Iteration accounts for about half the cost (9.9 ns/MAC\u001b[58Gwith\u001b[63Garray\u001b[69Gslices\u001b[76Gversus\u001b[83G5.7\u001b[87Gwith\u001b[92Gpre-built\u001b[102Glists),\u001b[110Gand\u001b[114Gfloat\r\u001b[1C\u001b[1B arithm\u001b[11Gic is \u001b[18Ghe\u001b[21Grest.\u001b[27GI'm\u001b[31Gnext\u001b[36Gtrying\u001b[43Gbulk\u001b[48G\u001b[38;2;87;105;247mtolist()\u001b[57G\u001b[39mconversion\u001b[68Gper\u001b[72Grow\u001b[76Ggroup\u001b[82Gto\u001b[85Gmove\u001b[90Gthe\u001b[94Gfloat\u001b[100Gboxing\u001b[107Ginto\u001b[112Gone\u001b[116GC\r\u001b[1C\u001b[1B call.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmarking on-the-fly\u001b[27Gtolist\u001b[34Grow\u001b[38Ggroups\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat"]
