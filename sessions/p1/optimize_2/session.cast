[81.367, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[22m         ou\u001b[15G[i]=v0;out[i+1]=v1;out[i+2]=v2;out[\u001b[51G+3]=v3\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  return out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m d\u001b[6Gf T8():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mout=[0.0]*d\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for i in\u001b[17Grange(0,d,8):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G     \u001b[11G b=i*n; g=W[b:b+8*n].tolis\u001b[38G(); v0=v1=v2=v3=v4=v5=v6=v7=0.0\u001b[70G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m      \u001b[12Gfor c,a0,a1,a2,a3,a4,a5,a6,a7\u001b[44G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mzip(x,g[:n],g[n:2*n],g[2*n:3*n],g[3*n:4*n],g[4*n:5*n],g[5*n:6*n],g[6*n:7*n],g[7*n:]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G  \u001b[8G  \u001b[11G     v0+=a0*c; v1+=a1*c; v2+=a2*c;\u001b[46Gv3+=a3*c; v4+=a4*c; v5+=a5*c; v6+=a6*c;\u001b[86Gv7+=a7*c\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   \u001b[9G   out[i:i+8]=[v0,v1,v2,v3,v4,v5,v6,v7]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m   return out\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8GWM():\u001b[15G#\u001b[17Gwhole\u001b[23Gmatrix\u001b[30Gtolist\u001b[37Gonce\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     out=[0.0]*d; L=W.tolist()\u001b[34G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for i in\u001b[17Grange(0,d,4):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mb=i*n;\u001b[19Gv0=v1="]
[81.368, "v2=v3=0.0\r\u001b[1B \u001b[2m\u2502\u001b[22m         for c,a0,a1,a2,a3 in zip(x,L[b:b+n],L[b+n:b+2*n],L[b+2*n:b+3*n],L[b+3*n:b+4*n]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mv0+=a0*c;\u001b[26Gv1+=a1*c;\u001b[36Gv2+=a2*c;\u001b[46Gv3+=a3*c\r\u001b[1B \u001b[2m\u2502\u001b[22m         out[i]=v0;out[i+1]=v1;out[i+2]=v2;out[i+3]=v3\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     return out\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m ref=C4()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gf\u001b[10Gin\u001b[13G(C4,T1,T2,T8,WM):\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8Gb\u001b[10Gst=1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G for _ in\u001b[17Grange(5):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G  \u001b[11G s=time\u001b[19Gperf_counter();\u001b[35Gr=f();\u001b[42Gbest=min(best,time.perf_counter()-s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Gr==ref,\u001b[23Gf.__name__\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f\"{f.__name__:4s}\u001b[32G{best*1e9/(n*d):6.2f}\u001b[54Gns/MAC\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 -I /tmp/p1bench/b6.py 768 768; python3\u001b[51G-I /tmp/p1bench/b6.py 768 2048;\u001b[83Gpython3 -I /tmp/p1bench/b6.py 2048\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m 768\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[81.368, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mcat, python3 -I /tmp/p1bench/b6.py 768 768, python3 -I /tmp/p1bench/b6.py 768 2048\u001b[22m,\r\u001b[6C\u001b[1Band\u001b[11G\u001b[1mpython3 -I /tmp/p1bench/b6.py 2048 768\u001b[50G\u001b[22mcommands\u001b[59Gin\u001b[62G\u001b[1m/Users/agentlab/pvc/p1\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b"]
