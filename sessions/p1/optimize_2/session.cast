[226.026, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProf\u001b[8Gle this implementation on\u001b[34Gthe supplied development workloads. Improve performance within the same rules and \u001b[39m    \r\u001b[2C\u001b[1B\u001b[38;2;0;0;0mremaini\u001b[11Gg budget. Pres\u001b[27Gve the interface and corr\u001b[53Gctn\u001b[57Gss requirements. Do\u001b[77Gnot\u001b[81Guse hidden evaluation\u001b[105Gputs, external \r\u001b[1B\u001b[39m  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSame request again, so this i\u001b[34Ga second pass on\u001b[51Gt\u001b[53Gp of the 4-row kernel.\u001b[76GT\u001b[78Ge pr\u001b[83Gfile already shows \u001b[38;2;87;105;247mdots()\u001b[109G\u001b[39mat 98% of\r\u001b[2C\u001b[1Bthe t\u001b[9Gme. Any \u001b[18Gurther\u001b[25Ggain\u001b[30Ghas\u001b[34Gto\u001b[37Gcome\u001b[42Gfrom\u001b[47Gthe\u001b[51Gcost\u001b[56Gper\u001b[60Gmultiply-add\u001b[73Gin\u001b[76Gthat\u001b[81Gloop,\u001b[87Gso\u001b[90GI'll\u001b[95Gfirst\u001b[101Gmeasure\u001b[109Gwhat\u001b[114Gthat\r\u001b[2C\u001b[1Bcost\u001b[8Gis\u001b[11Gmade\u001b[16Gof.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell"]
[226.027, " command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mIteration accounts for about half the cost (9.9 ns/MAC with array slices\u001b[76Gversus 5.7 with pre-built l\u001b[104Gsts), and float\r\u001b[2C\u001b[1Barithmetic\u001b[14Gis\u001b[17Gthe\u001b[21Grest.\u001b[27GI'm\u001b[31Gnext\u001b[36Gtrying\u001b[43Gbulk\u001b[48G\u001b[38;2;87;105;247mtolist()\u001b[57G\u001b[39mconversion\u001b[68Gper\u001b[72Grow\u001b[76Ggroup\u001b[82Gto\u001b[85Gmove\u001b[90Gthe\u001b[94Gfloat\u001b[100Gboxing\u001b[107Ginto\u001b[112Gone\u001b[116GC\r\u001b[2C\u001b[1Bcall.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn-t\u001b[8Ge-fly tolist() runs slower\u001b[35G(27\u201333\u001b[42Gns/MAC\u001b[49Gag\u001b[52Ginst 20.3), \u001b[65Go the current ker\u001b[83Gel is nea\u001b[93G the floor\u001b[104Gfor\u001b[108Garray-backed\r\u001b[2C\u001b[1Bweights.\u001b[12GNext\u001b[17GI'll\u001b[22GA/B\u001b[26Gan\u001b[29G8-row\u001b[35Gunroll\u001b[42Gin\u001b[45Gthe\u001b[49Greal\u001b[54Gforward\u001b[62Gpass,\u001b[68Galternating\u001b[80Gruns\u001b[85Gto\u001b[88Gcontrol\u001b[96Gnoise.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe 8-row k\u001b[15Grnel\u001b[20Gis sl\u001b[26Gwer in the r"]
[226.027, "eal model (2.33 vs 2.28 s/token),\u001b[72Gso I've rejected it and kep\u001b[100G the\u001b[105G4-row one. Next\r\u001b[2C\u001b[1BI'll\u001b[8Gmeasure\u001b[16Gthe\u001b[20Gper-command\u001b[32Gcosts\u001b[38Goutside\u001b[46Gthe\u001b[50Gkernel,\u001b[58Gincluding\u001b[68Gthe\u001b[72Gtwo\u001b[76G38\u001b[79GMB\u001b[82GKV\u001b[85Gcache\u001b[91Greallocations\u001b[105Gin\u001b[108G\u001b[38;2;87;105;247mreset()\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-forward cost dwarfs the per-command overhead, but model\u001b[63Gload\u001b[68Gtakes\u001b[74G1.4\u001b[78Gs\u001b[80Gagainst\u001b[88Ga\u001b[90Graw\u001b[94Gread\u001b[99Gof\u001b[102G0.44\u001b[107Gs,\u001b[110Glikely\r\u001b[2C\u001b[1Bbecause \u001b[38;2;87;105;247mf.read()\u001b[39m allocates\u001b[30Ga\u001b[32G438\u001b[36GMB\u001b[39Gbytes\u001b[45Gobject\u001b[52Gbefore\u001b[59Gcopying.\u001b[68GI'm\u001b[72Gtesting\u001b[80Ga\u001b[82Gread\u001b[87Gdirectly\u001b[96Ginto\u001b[101Gthe\u001b[105Garray\u001b[111Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[18C\u001b[2B\u001b[38;2;102;102;102m40\u001b[30G6\u001b[39m\u001b[40;1H\u001b[38;3H"]
