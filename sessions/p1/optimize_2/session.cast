[0.447, "\u001b[?1049h\u001b[2J\u001b[H\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h\u001b[?25l\u001b[?25l\u001b[H\u001b[3G4.\u001b[6G\u001b[1mBug fix in SwiGLU:\u001b[25G\u001b[22mthe\u001b[29Gold\u001b[33Gshortcut\u001b[42Gset\u001b[46Gthe\u001b[50Gactivation\u001b[61Gto\u001b[64Gzero\u001b[69Gfor\u001b[73Ginputs\u001b[80Gbelow\u001b[86G\u221288.\u001b[91GOverflow\u001b[100Gnow\u001b[104Ggoes\u001b[109Gto\u001b[112G\u001b[38;2;87;105;247minf\r\u001b[5C\u001b[1B\u001b[39mexactly\u001b[14Gas\u001b[17Gfloat32\u001b[25Gdoes,\u001b[31Gso\u001b[34Ginputs\u001b[41Gbetween\u001b[49G\u221288.72\u001b[56Gand\u001b[60G\u221288\u001b[64Gare\u001b[68Ghandled\u001b[76Gas\u001b[79Gin\u001b[82GC.\u001b[85GNone\u001b[90Gof\u001b[93Gthe\u001b[97Gtests\u001b[103Ghit\u001b[107Gthis\u001b[112Gcase.\r\u001b[2C\u001b[2B\u001b[1mResults:\r\u001b[2C\u001b[2B\u001b[22m\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[23Gtest\u001b[47G\u2502\u001b[52Gbefore\u001b[62G\u2502\u001b[71Gafter\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.447, "\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5G\u001b[38;2;87;105;247mcheck.py\u001b[47G\u001b[39m\u2502\u001b[49GPASS,\u001b[55G75.0\u001b[60Gs\u001b[62G\u2502\u001b[64GPASS,\u001b[70G57.1\u001b[75Gs\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Gtime\u001b[10Gper\u001b[14Gtoken,\u001b[21Gshort\u001b[27Gcontext\u001b[47G\u2502\u001b[49G2.93\u001b[54Gs\u001b[62G\u2502\u001b[64G2.27\u001b[69Gs\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Gmy\u001b[8G45-step\u001b[16Gtest\u001b[21Gscript\u001b[28G(all\u001b[33Gsix\u001b[37Gcommands)\u001b[47G\u2502\u001b[49G136.4\u001b[55Gs\u001b[62G\u2502\u001b[64G105.5\u001b[70Gs\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.448, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5Glogits,\u001b[13GLOGITS\u001b[20Gfiles,\u001b[27Gprotocol\u001b[36Goutput\u001b[47G\u2502\u001b[49G\u2013\u001b[62G\u2502\u001b[64Gidentical\u001b[74Gto\u001b[77Gbefore\u001b[84G\u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[2BThe\u001b[7Gchecker's\u001b[17Glargest\u001b[25Glogit\u001b[31Gerror\u001b[37Gis\u001b[40Gunchanged\u001b[50Gat\u001b[53G1.6e-5.\u001b[61GA\u001b[63Gforward\u001b[71Gpass\u001b[76Gat\u001b[79Gposition\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[2B\u001b[1mRejected:\u001b[13G\u001b[22mstoring\u001b[21Gthe\u001b[25Gweights\u001b[33Gas\u001b[36GPython\u001b[43Gfloat\u001b[49Glists\u001b[55Gwould\u001b[61Gbe\u001b[64Gabout\u001b[70G20%\u001b[74Gfaster.\u001b[82GBut\u001b[86Git\u001b[89Gneeds\u001b[95Groughly\u001b[103G3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB\u001b[6Gmachine\u001b[14Gand\u001b[18Gadds\u001b[23G"]
[0.448, "4.4\u001b[27Gs\u001b[29Gto\u001b[32Gloading,\u001b[41Gso\u001b[44Git\u001b[47Grisks\u001b[53Gswapping.\u001b[63GI\u001b[65Galso\u001b[70Gleft\u001b[75Gout\u001b[79G\u001b[38;2;87;105;247mmath.sumprod\u001b[92G\u001b[39mand\u001b[96G\u001b[38;2;87;105;247msum(map(...))\u001b[39m:\u001b[111Gthey\u001b[116Gdo\r\u001b[2C\u001b[1Bthe\u001b[7Gdot\u001b[11Gproduct\u001b[19Gin\u001b[22GC,\u001b[25Gwhich\u001b[31Ggoes\u001b[36Gbeyond\u001b[43G\"scalar\u001b[51Gloops\".\r\u001b[2C\u001b[2B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GInner\u001b[11Gsums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[4C\u001b[1Bdiffer\u001b[12Gslightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference\u001b[42Ginstead\u001b[50Gof\u001b[53Gmatching\u001b[62Gbit\u001b[66Gfor\u001b[70Gbit.\u001b[75GRounding\u001b[84Gevery\u001b[90Gpartial\u001b[98Gsum\u001b[102Gwould\u001b[108Gmake\u001b[113Git\u001b[116Gabout\r\u001b[4C\u001b[1B40\u00d7\u001b[9Gslower.\r\u001b[2C\u001b[1B-\u001b[5GIt\u001b[8Gis\u001b[11Gstill\u001b[17Gslow:\u001b[23Gabout\u001b[29G2.3\u001b[33Gs\u001b[35Gper\u001b[39Gtoken,\u001b[46Gso\u001b[49Gseveral\u001b[57Gminutes\u001b[65Gper\u001b[69G100\u001b[73Gtokens.\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gmatrix-multiply\u001b[25Groutine\u001b[33Gis\u001b[36Gnow\u001b[40G98%\u001b[44Gof\u001b[47Gthe\u001b[51Gtime,\u001b[57Gso\u001b[60Gfurther"]
[0.449, "\u001b[68Ggains\u001b[74Gwithin\u001b[81GP1\u001b[84Gwould\u001b[90Gneed\u001b[95Ga\u001b[97Gdifferent\u001b[107Gway\u001b[111Gof\u001b[114Gstoring\r\u001b[4C\u001b[1Bthe\u001b[9Gweights.\r\u001b[2C\u001b[2BNOTES.md\u001b[12Gnow\u001b[16Ghas\u001b[20Gthe\u001b[24Gcommands,\u001b[34Gprofiling\u001b[44Gtables,\u001b[52Gchanges,\u001b[61Gtest\u001b[66Gresults\u001b[74Gand\u001b[78Glimitations.\u001b[91GThe\u001b[95Gbenchmark\u001b[105Gscripts\u001b[113Gare\u001b[117Gin\r\u001b[2C\u001b[1B\u001b[38;2;87;105;247m/tmp/p1bench\u001b[39m,\u001b[17Goutside\u001b[25Gthe\u001b[29Gproject\u001b[37Gfolder.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GCrunched for 11m 12s \u00b7 done 2:48 PM\r\u001b[102C\u001b[1B\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m\u276f\u00a0\u001b[7m \r\u001b[1B\u001b[27m\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[0.449, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7 ? for shortcuts \u00b7 \u2190 for agents\u001b[39m\u001b[40;1H\u001b[38;3H"]
[0.47, "\u001b[>0q\u001b[?u\u001b]7501;?\u0007\u001b[c"]
[3.614, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults:\u001b[22m\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[23Gtest\u001b[47G\u2502\u001b[52Gbefore\u001b[62G\u2502\u001b[71Gafter\u001b[84G\u2502\r\u001b[2C\u001b[1B\u251c\u001b[47G\u253c\u001b[62G\u253c\u001b[84G\u2524\r\u001b[4C\u001b[1B\u001b[38;2;87;105;247mcheck.py\u001b[23G\u001b[39m    \u001b[49GPASS, 75.0\u001b[60Gs\u001b[64GPASS,\u001b[70G57.1 s\r\u001b[4C\u001b[2Btime per\u001b[14Gtoken,\u001b[21Gshort\u001b[27Gcontext\u001b[49G2.93 s    \u001b[60G \u001b[64G2.27 s    \u001b[75G \r\u001b[4C\u001b[2Bmy 45-step t\u001b[18Gst\u001b[22Gcript (all six\u001b[37Gcommands)\u001b[49G136.4 s\u001b[64G105.5 s\r\u001b[4C\u001b[2Blogits, LOGITS files, protocol output    \u001b[49G\u2013    \u001b[55G \u001b[64Gidentical\u001b[74Gto\u001b[77Gbefore\r\u001b[2C\u001b[1B\u2514\u001b[47G\u2534\u001b[62G\u2534\u001b[84G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe checker's largest logit error is unchanged at 1.6e-5. A forward pass at position\u001b[88G1000\u001b[93Gtakes\u001b[99G2.89\u001b[104Gs.\r\u001b[2C\u001b[2B\u001b[1mRejected:\u001b[22m storing the\u001b[25Gweights as Pytho\u001b[42G float lists would"]
[3.615, "\u001b[61Gbe about 20% fas\u001b[78Ger. But it needs roughly 3.5\u001b[107GGB\u001b[110Gon\u001b[113Gthis\u001b[118G8\r\u001b[2C\u001b[1BGB\u001b[6Gmachine\u001b[14Gand\u001b[18Gadds\u001b[23G4.4\u001b[27Gs\u001b[29Gto\u001b[32Gloading,\u001b[41Gso\u001b[44Git\u001b[47Grisks\u001b[53Gswapping.\u001b[63GI\u001b[65Galso\u001b[70Gleft\u001b[75Gout\u001b[79G\u001b[38;2;87;105;247mmath.sumprod\u001b[92G\u001b[39mand\u001b[96G\u001b[38;2;87;105;247msum(map(...))\u001b[39m:\u001b[111Gthey\u001b[116Gdo\r\u001b[2C\u001b[1Bthe dot product in C,\u001b[26Gh\u001b[28Gc\u001b[30G goe\u001b[36Gbeyond\u001b[43G\"sc\u001b[47Glar loops\".\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GInner\u001b[11Gsums\u001b[16Gare\u001b[20Gaccumulated\u001b[32Gin\u001b[35GPython's\u001b[44G64-bit\u001b[51Gfloats\u001b[58Gand\u001b[62Grounded\u001b[70Gto\u001b[73Gfloat32\u001b[81Gwhen\u001b[86Gstored.\u001b[94GThat\u001b[99Gis\u001b[102Gwhy\u001b[106Gthe\u001b[110Glogits\r\u001b[2C\u001b[1B  differ slightly\u001b[21Gfrom\u001b[26Gthe\u001b[30GC\u001b[32Greference\u001b[42Ginstead\u001b[50Gof\u001b[53Gmatching\u001b[62Gbit\u001b[66Gfor\u001b[70Gbit.\u001b[75GRounding\u001b[84Gevery\u001b[90Gpartial\u001b[98Gsum\u001b[102Gwould\u001b[108Gmake\u001b[113Git\u001b[116Gabout\r\u001b[2C\u001b[1B \u001b[5G40\u00d7 slower.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GIt is still s\u001b[19Gow: about 2.3 s per toke\u001b[44G, so sever\u001b[55Gl m\u001b[60Gutes per 100 tokens.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5"]
