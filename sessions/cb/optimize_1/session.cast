[4.137, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mAttention:\u001b[16G\u001b[22mper head, the scores (\u001b[38;2;87;105;247mK @ q\u001b[39m) and the weig\u001b[58Gted value sum\u001b[72G(\u001b[38;2;87;105;247mV\u1d40 @ att\u001b[39m) are also BLAS matrix-v\u001b[106Gctor calls.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEverything else\u001b[21G\u001b[22mis\u001b[24Gcopied\u001b[31Gfrom\u001b[36Gthe\u001b[40Greference:\u001b[51Grmsnorm,\u001b[60Gsoftmax,\u001b[69GRoPE,\u001b[75GSwiGLU,\u001b[83Gargmax\u001b[90Gties\u001b[95G(lowest\u001b[103Gindex\u001b[109Gwins),\u001b[116Gand\r\u001b[2C\u001b[1B \u001b[5Gthe tokenizer's \u001b[22Gncode/decode. All maths is\u001b[49Gfloat32 and compiled without fast-math. The progr\u001b[99Gm starts no\u001b[111Gthreads\r\u001b[2C\u001b[1B \u001b[5Gand sets no thread\u001b[26Gunts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m each command starts at posi\u001b[43Gion 0, and the rows the prev\u001b[72Gous command wrote are zeroed\u001b[101Gfirs\u001b[106G.\u001b[108G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop rule:\u001b[22m prompt toke\u001b[28Gs are\u001b[34Gforced,\u001b[42Gthen\u001b[47Git\u001b[50Gstops\u001b[56Gwith\u001b[61G\u001b[38;2;87;105;247mstop\u001b[66G\u001b[39mon\u001b[69Gtoken\u001b[75G1,\u001b[78G\u001b[38;2;87;105;247mmax\u001b[82G\u001b[39mafter\u001b[88Gmax_new\u001b[96Gtokens,\u001b[104Gor\u001b[107G\u001b[38;2;87;105;247mcontext\u001b[115G\u001b[39mat\r\u001b[2C\u001b[1B "]
