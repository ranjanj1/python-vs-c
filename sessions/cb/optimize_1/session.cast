[306.199, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m 96% of\u001b[10Gth\u001b[13G time goes to \u001b[38;2;87;105;247msgemv\u001b[39m, and memory\u001b[45Gbandwidth (~25\u201330\u001b[63GGB/s) \u001b[70Gs\u001b[72Gthe bottleneck. Si\u001b[91Gce\u001b[94Gthe\u001b[98Gmatmuls\u001b[106Gmust\u001b[111Gstay\u001b[116GBLAS\r\u001b[1C\u001b[1B calls,\u001b[10GI'll microbench\u001b[26Gark the varia\u001b[40Gts that compute the \u001b[61Gam\u001b[64G \u001b[38;2;87;105;247mW(d,n) @ x\u001b[39m product\u001b[84Gto find the fastest call\u001b[109Gand\u001b[113Glayout.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The pure-BLAS floor\u001b[23Gis\u001b[26Gabout\u001b[32G11.9\u001b[37Gms\u001b[40Gper\u001b[44Gtoken,\u001b[51Gyet\u001b[55Gthe\u001b[59Gprogram\u001b[67Gtakes\u001b[73G13.3\u001b[78Gms,\u001b[82Gso\u001b[85GI\u001b[87Gsuspect\u001b[95Gthe\u001b[99Gweight\u001b[106Glayout\u001b[113Gscatters\r\u001b[1C\u001b[1B each\u001b[8Gtoken's reads across seven memory regions. I'll reorder\u001b[64Gthe\u001b[68Gweights layer by la\u001b[88Ger and load them with\u001b[110Gpread\u001b[116Ginto\r\u001b[1C\u001b[1B the aligned buffer,\u001b[23Gdropping\u001b[32Gthe\u001b[36Gmma"]
