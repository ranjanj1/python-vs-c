[176.618, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mCrunched for 4m 51s \u00b7 done 4:20 PM\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gstart\u001b[14Gby\u001b[17Gfinding\u001b[25Gthe\u001b[29Gdevelopment\u001b[41Gworkloads\u001b[51Gand\u001b[55Gmeasuring\u001b[65Ga\u001b[67Gbaseline.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm benchmarking the\u001b[24Gthree\u001b[30Gfixture\u001b[38Gprompts\u001b[46Gon\u001b[49Gthis\u001b[54GM1\u001b[57G(8\u001b[60GGB),\u001b[65Gwith\u001b[70GAccelerate\u001b[81Gtested\u001b[88Gboth\u001b[93Gsingle-threaded\u001b[109Gand\u001b[113Gat\r\u001b[2C\u001b[1Bdefault\u001b["]
[176.62, "11Gthreading.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBaseline holds at about\u001b[27G14\u001b[30Gms\u001b[33Gper\u001b[37Gforward\u001b[45Gpass\u001b[50G(~70\u001b[55Gtokens/s)\u001b[65Gwith\u001b[70Geither\u001b[77Gthread\u001b[84Gsetting,\u001b[93Gwhich\u001b[99Gworks\u001b[105Gout\u001b[109Gto\u001b[112Groughly\r\u001b[2C\u001b[1B31\u001b[6GGB/s\u001b[11Gof\u001b[14Gweight\u001b[21Greads.\u001b[28GI'm\u001b[32Gadding\u001b[39Goptional\u001b[48Gtimers\u001b[55Gnext\u001b[60Gto\u001b[63Gsee\u001b[67Gwhere\u001b[73Gthe\u001b[77Gtime\u001b[82Ggoes\u001b[87Ginside\u001b[94Ga\u001b[96Gforward\u001b[104Gpass.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m96% \u001b[8Gf the time goes to \u001b[38;2;87;105;247msgemv\u001b[39m, and memory bandwidth\u001b[55G(~25\u201330\u001b[63GGB/s)\u001b[69Gis\u001b[72Gthe\u001b[76Gbottleneck.\u001b[88GSince\u001b[94Gthe\u001b[98Gmatmuls\u001b[106Gmust\u001b[111Gstay\u001b[116GBLAS\r\u001b[1B  calls, I'll microbenchmark the variants that\u001b[48Gcompute\u001b[56Gthe\u001b[60Gsame\u001b[65G\u001b[38;2;87;105;247mW(d,n) @ x\u001b[76G\u001b[39mproduct\u001b[84Gto\u001b[87Gfind\u001b[92Gthe\u001b[96Gfastest\u001b[104Gcall\u001b[109Gand\u001b[113Glayout.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mR"]
[176.621, "an \u001b[1m1\u001b[22m shell\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe pure-BLAS floor is\u001b[26Gabout\u001b[32G11.9\u001b[37Gms\u001b[40Gper\u001b[44Gtoken,\u001b[51Gyet\u001b[55Gthe\u001b[59Gprogram\u001b[67Gtakes\u001b[73G13.3\u001b[78Gms,\u001b[82Gso\u001b[85GI\u001b[87Gsuspect\u001b[95Gthe\u001b[99Gweight\u001b[106Glayout\u001b[113Gscatters\r\u001b[2C\u001b[1Beach token's reads across\u001b[29Gseven\u001b[35Gmemory\u001b[42Gregions.\u001b[51GI'll\u001b[56Greorder\u001b[64Gthe\u001b[68Gweights\u001b[76Glayer\u001b[82Gby\u001b[85Glayer\u001b[91Gand\u001b[95Gload\u001b[100Gthem\u001b[105Gwith\u001b[110Gpread\u001b[116Ginto\r\u001b[2C\u001b[1Bthe aligned buffer, dropping\u001b[32Gthe\u001b[36Gmmap-then-copy\u001b[51Gstep.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mReading cb.c\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  cb.c\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[3G\u001b[38;2;234;138;106mTwisting\u2026\u001b[38;2;215;119;87m \u001b[25G\u001b[38;2;102;102;102m8\u001b[27G2\u001b[39G\u001b[38;2;165;165;165mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
