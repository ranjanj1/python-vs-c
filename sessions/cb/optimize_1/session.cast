[1364.896, "d\u001b[55Gthe\u001b[59Glegacy\u001b[66Gfreq_cis\u001b[75Gskip,\u001b[81Gbut\u001b[85Gthat\u001b[90Gonly\u001b[95Gmatters\u001b[103Gfor\u001b[107Gmodels\u001b[114Gwith\r\u001b[2C\u001b[1Bunshared classifier weights,\u001b[32Gand\u001b[36Gthis\u001b[41Gone\u001b[45Gshares\u001b[52Gthem,\u001b[58Gso\u001b[61Gthe\u001b[65Gexperiment\u001b[76Gstill\u001b[82Gholds.\u001b[89GI'm\u001b[93Gtreating\u001b[102Git\u001b[105Gas\u001b[108Ga\u001b[110Gthrowaway\r\u001b[2C\u001b[1Bvariant\u001b[11Gthat\u001b[16Gwon't\u001b[22Gbe\u001b[25Gkept.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mIn\u001b[6Gerleaved benchmark of four KV layou\u001b[42G variants\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ uptime; VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 10 /tmp/cbtest/v_cur /tmp/cbtest/v_hm \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m/tmp/cbtest/v_kv\u001b[23G/tmp/cbtest/v_vtp; VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ablong.py \"$PWD\" 4 \r\u001b[5C\u001b[1B/tmp/cbtest/v_cur /tmp/cbtest/v_hm /tmp/cbtest/v_kv /tmp/cbtest/v_vtp\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
