[1796.39, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMost of the remaining\u001b[25Gattention\u001b[35Gtime\u001b[40Ggoes\u001b[45Gto\u001b[48Gthe\u001b[52Gtransposed\u001b[63G\u001b[38;2;87;105;247msgemv\u001b[69G\u001b[39mcall,\u001b[75Gat\u001b[78G1.13\u001b[83Gs\u001b[85Gversus\u001b[92G0.46\u001b[97Gs\u001b[99Gfor\u001b[103Gthe\u001b[107Gscores.\r\u001b[2C\u001b[1BStoring\u001b[11GV\u001b[13Gtransposed\u001b[24Gper\u001b[28Ghead\u001b[33Gwould\u001b[39Gturn\u001b[44Gthat\u001b[49Ginto\u001b[54Ga\u001b[56GNoTrans\u001b[64G\u001b[38;2;87;105;247msgemv\u001b[70G\u001b[39mwith\u001b[75Gthe\u001b[79Gsame\u001b[84Gshape.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the previous\u001b[29Gbuild\u001b[35Gwithin\u001b[42G9e-6\u001b[47Gover\u001b[52G1024\u001b[57Gpositions\u001b[67Gwith\u001b[72Gno\u001b[75Gargmax\u001b[82Gchanges.\u001b[91GNext\u001b[96GI'll\u001b[101Gmeasure\u001b[109Gboth\u001b[114Gthe\r\u001b[2C\u001b[1Bshort\u001b[9Gfixture\u001b[17Gworkload\u001b[26Gand\u001b[30Ga\u001b[32G1024-position\u001b[46Glong-context\u001b[59Grun\u001b[63Gagainst\u001b[71Gthe\u001b[75Gbuild\u001b[81Gfrom\u001b[86Gbefore\u001b[93Gthe\u001b[97GKV-cache\u001b[106Gchanges,\r\u001b[1B \u001b[3Ginterleaved.\u001b[16G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new KV lay"]
[1796.391, "out is\u001b[24Grunning\u001b[32Gslower\u001b[39Geven\u001b[44Gon\u001b[47Gshort\u001b[53Gsequences,\u001b[64Gwhich\u001b[70Gis\u001b[73Gunexpected.\u001b[85GLoad\u001b[90Gis\u001b[93Gabove\u001b[99G3,\u001b[102Gso\u001b[105GI'm\u001b[109Grerunning\r\u001b[2C\u001b[1Bwith\u001b[8Gmore\u001b[13Grounds\u001b[20Gbefore\u001b[27Gconcluding\u001b[38Ganything.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new layout runs about\u001b[29G1.4\u001b[33Gms\u001b[36Gslower\u001b[43Gon\u001b[46Gshort\u001b[52Gsequences\u001b[62Gand\u001b[66Gisn't\u001b[72Gfaster\u001b[79Gat\u001b[82G1024\u001b[87Gpositions,\u001b[98Glikely\u001b[105Gbecause\u001b[113Gthe\r\u001b[2C\u001b[1Btransposed\u001b[14GV\u001b[16Gcache\u001b[22Gcauses\u001b[29Gcache-set\u001b[39Gconflicts.\u001b[50GI'm\u001b[54Gtesting\u001b[62Ga\u001b[64Ghead-major-only\u001b[80Gbuild\u001b[86Gand\u001b[90Ga\u001b[92Gpadded\u001b[99Gtransposed\u001b[110Gbuild\u001b[116Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe padded variant's\u001b[24Gtext\u001b[29Gsubstitution\u001b[42Galso\u001b[47Galtered\u001b[55Gthe\u001b[59Glegacy\u001b[66Gfreq_cis\u001b[75Gskip,\u001b[81Gbut\u001b[85Gthat\u001b[90Gonly\u001b[95Gmatters\u001b[103Gfor\u001b[107Gmodels\u001b[114Gwith\r\u001b[2C\u001b[1Bunshared\u001b[12Gclassifier"]
[1796.392, "\u001b[23Gweights,\u001b[32Gand\u001b[36Gthis\u001b[41Gone\u001b[45Gshares\u001b[52Gthem,\u001b[58Gso\u001b[61Gthe\u001b[65Gexperiment\u001b[76Gstill\u001b[82Gholds.\u001b[89GI'm\u001b[93Gtreating\u001b[102Git\u001b[105Gas\u001b[108Ga\u001b[110Gthrowaway\r\u001b[1B \u001b[3Gvariant that won'\u001b[21G be kept.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEven the head-major-only\u001b[28Gvariant\u001b[36Gruns about 1 m\u001b[52Gslower\u001b[59Gon\u001b[62Gshort\u001b[68Gsequences,\u001b[79Gwhich\u001b[85Gits\u001b[89Gsmall\u001b[95Gchange\u001b[102Gshouldn't\u001b[112Gcause.\r\u001b[1B  I'm reversing the launch order in my harness to rule out a bias before trusting these numbers.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m3\u001b[29G4\u001b[39m\u001b[40;1H\u001b[38;3H"]
[1796.402, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 7s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[1796.437, "\u001b[H\r\u001b[31B\u001b[38;2;102;102;102m \r\u001b[4C\u001b[2B\u001b[38;2;215;119;87mi\u001b[18G\u001b[38;2;102;102;102m40\u001b[39m\u001b[40;1H\u001b[38;3H"]
[1796.657, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[4Gw\u001b[39m\u001b[40;1H\u001b[38;3H"]
