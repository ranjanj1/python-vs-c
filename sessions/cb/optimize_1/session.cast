[313.804, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[3GTwisting\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
[313.855, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBaseline\u001b[12Gholds\u001b[18Gat\u001b[21Gabout\u001b[27G14\u001b[30Gms\u001b[33Gper\u001b[37Gforward\u001b[45Gpass\u001b[50G(~70\u001b[55Gtokens/s)\u001b[65Gwith\u001b[70Geither\u001b[77Gthread\u001b[84Gsetting,\u001b[93Gwhich\u001b[99Gworks\u001b[105Gout\u001b[109Gto\u001b[112Groughly\r\u001b[1B \u001b[3G31 GB/s of weigh\u001b[21Greads. I'\u001b[31G adding optional timers\u001b[55Gnext to see w\u001b[69Gere the\u001b[78Gim\u001b[81G goes inside a for\u001b[100Ga\u001b[102Gd pass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m96%\u001b[7Gof\u001b[10Gthe\u001b[14Gtime\u001b[19Ggoes\u001b[24Gto\u001b[27G\u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[34Gand\u001b[38Gmemory\u001b[45Gbandwidth\u001b[55G(~25\u201330\u001b[63GGB/s)\u001b[69Gis\u001b[72Gthe\u001b[76Gbottleneck.\u001b[88GSince\u001b[94Gthe\u001b[98Gmatmuls\u001b[106Gmust\u001b[111Gstay\u001b[116GBLAS\r\u001b[1B \u001b[3Gcalls,\u001b[10GI'll microb\u001b[22Gnchmark the\u001b[34Gvariants that compute the same \u001b[38;2;87;105;247mW(d,n) @ x\u001b[76G\u001b[39mproduct to find the fastest call and layout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm"]
[313.856, "and \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpure-BLAS\u001b[17Gfloor\u001b[23Gis\u001b[26Gabout\u001b[32G11.9\u001b[37Gms\u001b[40Gper\u001b[44Gtoken,\u001b[51Gyet\u001b[55Gthe\u001b[59Gprogram\u001b[67Gtakes\u001b[73G13.3\u001b[78Gms,\u001b[82Gso\u001b[85GI\u001b[87Gsuspect\u001b[95Gthe\u001b[99Gweight\u001b[106Glayout\u001b[113Gscatters\r\u001b[1B \u001b[3Geach token's reads across seven me\u001b[38Gory \u001b[43Gegions.\u001b[51GI'll r\u001b[58Gorder the weights layer\u001b[82Gby\u001b[85Glayer and\u001b[95Gload them with pread into\u001b[K\r\u001b[2C\u001b[1Bthe aligned buffer, d\u001b[26Gpping the m\u001b[38Gap-th\u001b[44Gn-copy\u001b[51Gstep.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad\u001b[8Gtime\u001b[13Gdropped\u001b[21Gfrom\u001b[26Gabout\u001b[32G1.0\u001b[36Gs\u001b[38Gto\u001b[41G0.07\u20130.2\u001b[50Gs,\u001b[53Gbut\u001b[57Gper-token\u001b[67Gspeed\u001b[73Gstayed\u001b[80Gwithin\u001b[87Gnoise\u001b[93Gnear\u001b[98G70\u001b[101Gforwards/s.\u001b[113GNext\r\u001b[1B \u001b[3GI'll\u001b[8Gco\u001b[11Gpare mean\u001b[21Gand best-of in\u001b[36Gthe microbenchmark and chec\u001b[64G sy\u001b[68Gt\u001b[70Gm load for a steadier number.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm"]
