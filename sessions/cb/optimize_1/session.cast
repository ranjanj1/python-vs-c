[30.89, "\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'll\u001b[8Gstar\u001b[14Gby finding the\u001b[29Gdevelopment workloads and measuring a baseline.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm benchmarking the thre\u001b[29G fixture prompts on this M1 (8 GB),\u001b[65Gwith Accelerate tested both single-thread\u001b[107Gd\u001b[109Gand\u001b[113Gat\r\u001b[1C\u001b[1B default threading.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmarking baseline on fixture workloads\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > /tmp/cbtest/work.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m# dev workload driver: fixture prompts only. usage: work.py <dir> <exe> [reps]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport json, subprocess, sys, time, os, tempfile\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102md, exe = sys.argv[1], sys.argv[2]; reps = int(sys.argv[3]) if len(sys.argv) > 3 else 3\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mfx = json.load(open(os.path.join(d, 'fixtures.js\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[39m \u001b[38;2;245;1"]
