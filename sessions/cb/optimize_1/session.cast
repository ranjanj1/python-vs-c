[1341.168, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Most\u001b[8Gof\u001b[11Gthe\u001b[15Gremaining\u001b[25Gattention\u001b[35Gtime\u001b[40Ggoes\u001b[45Gto\u001b[48Gthe\u001b[52Gtransposed\u001b[63G\u001b[38;2;87;105;247msgemv\u001b[69G\u001b[39mcall,\u001b[75Gat\u001b[78G1.13\u001b[83Gs\u001b[85Gversus\u001b[92G0.46\u001b[97Gs\u001b[99Gfor\u001b[103Gthe\u001b[107Gscores.\r\u001b[1C\u001b[1B Storing V transposed\u001b[24Gper\u001b[28Ghead would\u001b[39Gturn that into a NoTrans \u001b[38;2;87;105;247msgemv\u001b[70G\u001b[39mwith\u001b[75Gthe\u001b[79Gsame\u001b[84Gshape.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[27G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Logits\u001b[10Gmatch\u001b[16Gthe\u001b[20Gprevious\u001b[29Gbuild within 9e-6\u001b[47Gover\u001b[52G1024 posi\u001b[62Gions\u001b[67Gwith no argmax changes. Next I'll measure\u001b[109Gboth\u001b[114Gthe\r\u001b[1C\u001b[1B short\u001b[9Gfixture\u001b[17Gworkload\u001b[26Gand a 1024-position long-context run against\u001b[71Gthe bu\u001b[78Gld from\u001b[86Gbefore the KV-cac\u001b[105G chang\u001b[112Gs,\r\u001b[1C\u001b[1B interleaved.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[28G\u001b[39m\u001b[K\r\u001b[1C\u001b["]
[1341.169, "1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gnew\u001b[11GKV\u001b[14Glayout\u001b[21Gis\u001b[24Grunning slow\u001b[37Gr even on short sequences, which is unexpected. Load\u001b[90Gis\u001b[93Gabove\u001b[99G3,\u001b[102Gso\u001b[105GI'm\u001b[109Grerunning\r\u001b[1C\u001b[1B with more rounds\u001b[20Gbefore concluding\u001b[38Ganything.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The new layout runs about 1.4 ms slower on\u001b[46Gshort sequence\u001b[61G \u001b[63Gnd is\u001b[69G't faster\u001b[79Gat 1024\u001b[87Gpositions, lik\u001b[102Gly because\u001b[113Gthe\r\u001b[1C\u001b[1B tran\u001b[8Gposed V cache causes\u001b[29Gcache-set\u001b[39Gconflicts.\u001b[50GI'm\u001b[54Gtesting\u001b[62Ga\u001b[64Ghead-major-only\u001b[80Gbuild\u001b[86Gand\u001b[90Ga\u001b[92Gpadded\u001b[99Gtransposed\u001b[110Gbuild\u001b[116Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Building head-major-onl\u001b[27G and padded-transposed\u001b[50GV\u001b[52Gvariants\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cbtest && python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102ms = open('/Users/agentlab/pvc/cb/cb.c').read()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mdef s"]
