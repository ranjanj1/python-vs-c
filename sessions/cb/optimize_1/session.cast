[201.497, "\u001b[H\u001b[2G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'll\u001b[8Gstar\u001b[14Gby finding \u001b[26Ghe deve\u001b[35Gpment\u001b[41Gworkloads \u001b[52Gnd measuring\u001b[65Ga\u001b[67Gbaseline.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm\u001b[7Gbenchmarking the\u001b[24Gthree fixture p\u001b[40Gompts on\u001b[49Gthis\u001b[54GM1\u001b[57G(8 GB), with Accelerate tested\u001b[88Gboth\u001b[93Gsingle-threaded\u001b[109Gand\u001b[113Gat\r\u001b[1C\u001b[1B default\u001b[11Gthreading.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Basel\u001b[9Gne holds \u001b[19Gt about 14 ms\u001b[33Gper forward\u001b[45Gpass (~70\u001b[55Gtokens/s)\u001b[65Gwith\u001b[70Geither\u001b[77Gthread\u001b[84Gsetting,\u001b[93Gwhich\u001b[99Gworks\u001b[105Gout\u001b[109Gto\u001b[112Groughly\r\u001b[1C\u001b[1B 31\u001b[6GGB/s\u001b[11Gof\u001b[14Gweight\u001b[21Greads.\u001b[28GI'm\u001b[32Gadding\u001b[39Goptional\u001b[48Gtimers\u001b[55Gnext\u001b[60Gto\u001b[63Gsee\u001b[67Gwhere\u001b[73Gthe\u001b[77Gtime\u001b[82Ggoes\u001b[87Ginside\u001b[94Ga\u001b[96Gforward\u001b[104Gpass.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0"]
[201.498, ";0;0m\u23fa\u001b[39m 96% of the time goes to \u001b[38;2;87;105;247msgemv\u001b[39m, and memory bandwidth (~25\u201330 GB/s)\u001b[69Gis the bottleneck.\u001b[88GSince the\u001b[98Gmatmuls must stay BLAS\r\u001b[1C\u001b[1B calls, I'l\u001b[15Gmicrobench\u001b[26Gark\u001b[30Gthe variants that compute\u001b[56Gthe sa\u001b[63Ge \u001b[38;2;87;105;247mW(d,n) @ x\u001b[76G\u001b[39mproduct to\u001b[87Gf\u001b[89Gnd the fa\u001b[99Gtest call and\u001b[113Glayout.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gpure-BLAS\u001b[17Gfloor\u001b[23Gis\u001b[26Gabout\u001b[32G11.9\u001b[37Gms\u001b[40Gper\u001b[44Gtoken,\u001b[51Gyet\u001b[55Gthe\u001b[59Gprogram\u001b[67Gtakes\u001b[73G13.3\u001b[78Gms,\u001b[82Gso\u001b[85GI\u001b[87Gsuspect\u001b[95Gthe\u001b[99Gweight\u001b[106Glayout\u001b[113Gscatters\r\u001b[1C\u001b[1B each\u001b[8Gtoken's\u001b[18Gads across\u001b[29Gseven\u001b[35Gmemory\u001b[42Gregions.\u001b[51GI'll\u001b[56Greorder\u001b[64Gthe\u001b[68Gweights\u001b[76Glayer\u001b[82Gby\u001b[85Glayer\u001b[91Gand\u001b[95Gload\u001b[100Gthem\u001b[105Gwith\u001b[110Gpread\u001b[116Ginto\r\u001b[1C\u001b[1B the\u001b[7Galigned\u001b[15Gbuffer, dropping\u001b[32Gthe\u001b[36Gmmap-then-copy\u001b[51Gstep.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Reorder\u001b[11Gweights"]
