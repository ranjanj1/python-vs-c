[1363.77, "tch\u001b[16Gthe\u001b[20Gprevious\u001b[29Gbuild\u001b[35Gwithin\u001b[42G9e-6\u001b[47Gover\u001b[52G1024\u001b[57Gpositions\u001b[67Gwith\u001b[72Gno\u001b[75Gargmax\u001b[82Gchanges.\u001b[91GNext\u001b[96GI'll\u001b[101Gmeasure\u001b[109Gboth\u001b[114Gthe\r\u001b[2C\u001b[1Bshort fixture workload\u001b[26Gand\u001b[30Ga\u001b[32G1024-position\u001b[46Glong-context\u001b[59Grun\u001b[63Gagainst\u001b[71Gthe\u001b[75Gbuild\u001b[81Gfrom\u001b[86Gbefore\u001b[93Gthe\u001b[97GKV-cache\u001b[106Gchanges,\r\u001b[2C\u001b[1Binterleaved.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new KV layout is\u001b[24Grunning\u001b[32Gslower\u001b[39Geven\u001b[44Gon\u001b[47Gshort\u001b[53Gsequences,\u001b[64Gwhich\u001b[70Gis\u001b[73Gunexpected.\u001b[85GLoad\u001b[90Gis\u001b[93Gabove\u001b[99G3,\u001b[102Gso\u001b[105GI'm\u001b[109Grerunning\r\u001b[2C\u001b[1Bwith\u001b[8Gmore\u001b[13Grounds\u001b[20Gbefore\u001b[27Gconcluding\u001b[38Ganything.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new layout runs about 1.4 ms slower on \u001b[47Ghort\u001b[52Gseque\u001b[58Gces\u001b[62Gand\u001b[66Gisn't\u001b[72Gfaster\u001b[79Gat\u001b[82G1024\u001b[87Gpositions,\u001b[98Glikely\u001b[105Gbecause\u001b[113Gthe\r\u001b[1B  transposed V cache cause"]
[1363.771, "s cache-set conflicts.\u001b[50GI'm\u001b[54Gtesting\u001b[62Ga\u001b[64Ghead-major-only\u001b[80Gbuild\u001b[86Gand\u001b[90Ga\u001b[92Gpadded\u001b[99Gtransposed\u001b[110Gbuild\u001b[116Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comman\u001b[22G \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe padded variant's text substitution\u001b[42Galso\u001b[47Galtered\u001b[55Gthe\u001b[59Glegacy\u001b[66Gfreq_cis\u001b[75Gskip,\u001b[81Gbut\u001b[85Gthat\u001b[90Gonly\u001b[95Gmatters\u001b[103Gfor\u001b[107Gmodels\u001b[114Gwith\r\u001b[2C\u001b[1Bunshared classifier weights, and this one shares them, so\u001b[61Gthe\u001b[65Gexperiment\u001b[76Gstill\u001b[82Gholds.\u001b[89GI'm\u001b[93Gtreating\u001b[102Git\u001b[105Gas\u001b[108Ga\u001b[110Gthrowaway\r\u001b[2C\u001b[1Bvariant that\u001b[16Gwon't\u001b[22Gbe\u001b[25Gkept.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[28C\u001b[2B\u001b[38;2;102;102;102m5\u001b[39m\u001b[40;1H\u001b[38;3H"]
