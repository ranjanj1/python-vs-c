[358.744, "ard.\u001b[109GNext\u001b[114GI'll\r\u001b[2C\u001b[1Badd\u001b[7Ga\u001b[9G\u001b[38;2;87;105;247m-DCB_PROFILE\u001b[22G\u001b[39moption\u001b[29Gto\u001b[32G\u001b[38;2;87;105;247mcb.c\u001b[37G\u001b[39mto\u001b[40Gfind\u001b[45Gthe\u001b[49Gremaining\u001b[59Ggap.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmachine\u001b[15Gis\u001b[18Gnoisy:\u001b[25Gthe\u001b[29Gsame\u001b[34Gmicrobenchmark\u001b[49Gnow\u001b[53Ggives\u001b[59G12.2\u201314.5\u001b[69Gms\u001b[72Gbest-of.\u001b[81GI'll\u001b[86Gcheck\u001b[92Gwhether\u001b[100Gmemory\u001b[107Gpressure\u001b[116Gon\r\u001b[2C\u001b[1Bthis 8 GB machine is behind it.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mChecking mem\u001b[16Gry pressure and\u001b[32GCPU\u001b[36Gload\u001b[41G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ vm_stat | head -12; /usr/bin/memory_pressure 2>/dev/null | tail -3; uptime; ps -Ao pcpu,rss,comm -r 2>/dev/null |\r\u001b[5C\u001b[1Bhead -8\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[358.745, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mCheck memory pressure and CPU load\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mvm_stat\u001b[12G|\u001b[14Ghead\u001b[19G-12;\u001b[24G/usr/bin/memory_pressure\u001b[49G2>/dev/null\u001b[61G|\u001b[63Gtail\u001b[68G-3;\u001b[72Guptime;\u001b[80Gps\u001b[83G-Ao\u001b[87Gpcpu,rss,comm\u001b[101G-r\u001b[104G2>/dev/null\u001b[116G|\r\u001b[1B \u001b[2m\u2502\u001b[22m \u001b[6Gad -8\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c"]
