[710.416, "''\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m              vbase,\u001b[24Ghead_size,\u001b[35Gatt,\u001b[40G1,\u001b[43G0.0f,\u001b[49GS.xb\u001b[54G+\u001b[56Gh\u001b[58G*\u001b[60Ghead_size,\u001b[71G1);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22muint64_t\u001b[25Ga3\u001b[28G=\u001b[30Gclock_gettime_nsec_np(CLOCK_UPTIME_RAW);\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G         AT[0]\u001b[22G+= (a1-a0)*1e-9; AT[1] +=\u001b[48G(a2-a1)*1e-9; AT[2] += (a3-a2)*1e-9;''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s = s.replace(''' \u001b[23G     \u001b[29G    softmax(att,\u001b[46Gpos +\u001b[52G1);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ''', '''       \u001b[20G    softmax(att, pos + 1);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22muint64_t\u001b[25Ga2\u001b[28G=\u001b[30Gclock_gettime_nsec_np(CLOCK_UPTIME_RAW);\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace('\u001b[23Gfor\u001b[27G(int\u001b[32Gi\u001b[34G=\u001b[36G0;\u001b[39Gi\u001b[41G<\u001b[43GP_N;\u001b[48Gi++)\u001b[53Gtot\u001b[57G+=\u001b[60GPT[i];',\u001b[69G'\u001b[74Gfor\u001b[78G(int\u001b[83Gi\u001b[85G=\u001b[87G0;\u001b[90Gi\u001b[92G<\u001b[94GP_N;\u001b[99Gi++)\u001b[104Gtot\u001b[108G+=\u001b[111GPT[i];\\n\r\u001b[1B \u001b[2m\u2502\u001b[22m   fpr\u001b[10Gntf(stderr, \"attn: scores %.3f s, \u001b[45Gcal\u001b[49G+softmax %.3f s, values %.3f s\\\\n\", AT[0], AT[1], AT[2]);')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502"]
[710.417, "\u001b[22m open('cb_att.c',\u001b[21G'w').write(s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mclang\u001b[10G-O2\u001b[14G-DCB_PROFILE\u001b[27G-o\u001b[30Gcbatt\u001b[36Gcb_att.c\u001b[45G-framework\u001b[56GAccelerate\u001b[67G&&\u001b[70Gcd\u001b[73G/Users/agentlab/pvc/cb\u001b[96G&&\u001b[99Gpython3\u001b[107G-\u001b[109G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import subprocess, json\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfx\u001b[7G=\u001b[9Gjson.load(open('fixtures.json'))\r\u001b[1B \u001b[2m\u2502\u001b[22m s\u001b[6Gq =\u001b[10G(fx['prompts'][0]['seq'] * 20)[:1024]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p = subpro\u001b[15Gess.Popen(['/tmp/cbtest/cbatt', 'model.bin',\u001b[60G'tokenizer.bin'],\u001b[78Gstdin=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mstdout=subprocess.PIPE,\u001b[28Gstderr=subprocess.PIPE,\u001b[52Gtext=True,\u001b[63Gbufsize=1)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p.stdout.readline();\u001b[25Gp.stdin.write('FIXED\u001b[46G'\u001b[48G+\u001b[50G'\u001b[52G'.join(map(str,\u001b[68Gseq))\u001b[74G+\u001b[76G'\\n');\u001b[83Gp.stdin.flush();\u001b[100Gp.stdout.readline()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('QUIT\\n');\u001b[29Gp.stdin.flush();\u001b[46Gprint(p.stderr.read().splitlines()[0])\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1B\u001b[38;2;175;17"]
