[642.837, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad\u001b[8Gaverage\u001b[16Gis\u001b[19G5.4\u001b[23Gon\u001b[26G8\u001b[28Gcores,\u001b[35Gso\u001b[38Gsingle\u001b[45Gruns\u001b[50Gare\u001b[54Gunreliable;\u001b[66GI'll\u001b[71Gcompare\u001b[79Gthe\u001b[83Gfour\u001b[88Gvariants\u001b[97Gplus\u001b[102Gtwo\u001b[106Gother\u001b[112GBLAS\r\u001b[1B \u001b[3Gcalls usin\u001b[14G interleaved,\u001b[28Grep\u001b[32Gated runs and medi\u001b[51Gns.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gaccess-ordered\u001b[22Glayout\u001b[29Gwins\u001b[34Gat\u001b[37Gabout\u001b[43G13.3\u001b[48Gms\u001b[51Gper\u001b[55Gforward,\u001b[64Gahead\u001b[70Gof\u001b[73Gthe\u001b[77Galigned\u001b[85Gcopy\u001b[90Gand\u001b[94Gthe\u001b[98Goriginal\u001b[107Gmmap,\u001b[113Gwhile\r\u001b[1B \u001b[3Gt\u001b[7Goth\u001b[11Gr sgemm and sgemv\u001b[29Gvarian\u001b[36Gs gave\u001b[43Gno gain, so\u001b[55GI'm keeping the plain\u001b[77GRowMajor sgemv. Next\u001b[98GI'll profile attention\r\u001b[2C\u001b[1Bat l\u001b[8Gng cont\u001b[16Gxt, since GENERATE can reach 1024 po\u001b[53Gitions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m"]
[642.839, "\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gnow\u001b[17Gtakes\u001b[23G15%\u001b[27Gof\u001b[30Gthe\u001b[34Gforward\u001b[42Gpass\u001b[47Gbecause\u001b[55Gthe\u001b[59GKV\u001b[62Gcache\u001b[68Gis\u001b[71Glaid\u001b[76Gout\u001b[80G\u001b[38;2;87;105;247m[layer][pos][kv_dim]\u001b[39m,\u001b[102Gso\u001b[105Geach\u001b[110Ghead's\r\u001b[1B \u001b[3G256-byte rows\u001b[17Gare \u001b[22Gtrided 3 KB\u001b[34Gapart. I'm \u001b[46Gwit\u001b[50Ghing\u001b[59Gcache to\u001b[68Ghead-maj\u001b[77Gr order so each head's K/V blo\u001b[108Gk\u001b[110Gis\u001b[K\r\u001b[2C\u001b[1Bcontiguous.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChecks\u001b[10Gpass.\u001b[16GThe\u001b[20Gfixtures\u001b[29Gonly\u001b[34Gcover\u001b[40Gshort\u001b[46Gsequences,\u001b[57Gso\u001b[60GI'll\u001b[65Gcompare\u001b[73Gfull\u001b[78G1024-position\u001b[92Glogits\u001b[99Gagainst\u001b[107Gthe\u001b[111Gprevious\r\u001b[1B \u001b[3Gbuild (old cac\u001b[20Glayo\u001b[25Gt) and re-profile a\u001b[45Gtentio\u001b[52G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mComparing\u001b[13Glong-context\u001b[26Glogits\u001b[33Gand\u001b[37Gre-profile\u001b[48Gattention\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cat > /tmp/cbtest/cmp.py <<'EOF'\u001b[39m\u001b["]
