[1050.026, "\u001b[H\u001b[3G256-byte\u001b[12Grows\u001b[17Gare\u001b[21Gstrided\u001b[29G3\u001b[31GKB\u001b[34Gapart.\u001b[41GI'm\u001b[45Gswitching\u001b[55Gthe\u001b[59Gcache\u001b[65Gto\u001b[68Ghead-major\u001b[79Gorder\u001b[85Gso\u001b[88Geach\u001b[93Ghead's\u001b[100GK/V\u001b[104Gblock\u001b[110Gis\r\u001b[1B \u001b[3Gcontiguous.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mChecks\u001b[10Gpass.\u001b[16GThe\u001b[20Gfixtures\u001b[29Gonly\u001b[34Gcover\u001b[40Gshort\u001b[46Gsequences,\u001b[57Gso\u001b[60GI'll\u001b[65Gcompare\u001b[73Gfull\u001b[78G1024-position\u001b[92Glogits\u001b[99Gagainst\u001b[107Gthe\u001b[111Gprevious\r\u001b[1B \u001b[3Gbuild (old cache layout) a\u001b[30Gd re-profile at\u001b[46Gen\u001b[49Gion.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Ghead-major\u001b[18Gcache\u001b[24Gmatches\u001b[32Gthe\u001b[36Gold\u001b[40Glogits\u001b[47Gexactly\u001b[55Gacross\u001b[62Gall\u001b[66G1024\u001b[71Gpositions\u001b[81Gand\u001b[85Gcut\u001b[89Gattention\u001b[99Gfrom\u001b[104G2.5\u001b[108Gto\u001b[111G1.8\u001b[115Gms\u001b[118Gper\r\u001b[1B \u001b[3Gf\u001b[5Grward. Next I'll split attention into its\u001b[47Gsco\u001b[51Ge, softmax, a\u001b[65Gd\u001b[67"]
[1050.027, "Gvalue steps to\u001b[82Gfind the\u001b[91Gr\u001b[93Gmaining\u001b[101Gcost.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMost of the remaining\u001b[25Gattention\u001b[35Gtime\u001b[40Ggoes\u001b[45Gto\u001b[48Gthe\u001b[52Gtransposed\u001b[63G\u001b[38;2;87;105;247msgemv\u001b[69G\u001b[39mcall,\u001b[75Gat\u001b[78G1.13\u001b[83Gs\u001b[85Gversus\u001b[92G0.46\u001b[97Gs\u001b[99Gfor\u001b[103Gthe\u001b[107Gscores.\r\u001b[2C\u001b[1BStoring\u001b[11GV\u001b[13Gtransposed\u001b[24Gper\u001b[28Ghead\u001b[33Gwould\u001b[39Gturn\u001b[44Gthat\u001b[49Ginto\u001b[54Ga\u001b[56GNoTrans\u001b[64G\u001b[38;2;87;105;247msgemv\u001b[70G\u001b[39mwith\u001b[75Gthe\u001b[79Gsame\u001b[84Gshape.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the previou\u001b[28G buil\u001b[34G within 9e-6 \u001b[48Gver 1024\u001b[57Gpositions\u001b[67Gwith\u001b[72Gno\u001b[75Gargmax\u001b[82Gchanges.\u001b[91GNext\u001b[96GI'll\u001b[101Gmeasure\u001b[109Gboth\u001b[114Gthe\r\u001b[1B  short fixture workload and a 1024-position long-context run against the build from before the KV-cache\u001b[106Gchanges,\r\u001b[2C\u001b[1Binterleaved.\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K"]
