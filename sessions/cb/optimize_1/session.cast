[1797.398, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits match the previous\u001b[29Gbuild\u001b[35Gwithin\u001b[42G9e-6\u001b[47Gover\u001b[52G1024\u001b[57Gpositions\u001b[67Gwith\u001b[72Gno\u001b[75Gargmax\u001b[82Gchanges.\u001b[91GNext\u001b[96GI'll\u001b[101Gmeasure\u001b[109Gboth\u001b[114Gthe\r\u001b[2C\u001b[1Bshort\u001b[9Gfixture\u001b[17Gworkload\u001b[26Gand\u001b[30Ga\u001b[32G1024-position\u001b[46Glong-context\u001b[59Grun\u001b[63Gagainst\u001b[71Gthe\u001b[75Gbuild\u001b[81Gfrom\u001b[86Gbefore\u001b[93Gthe\u001b[97GKV-cache\u001b[106Gchanges,\r\u001b[1B \u001b[3Ginterleaved.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gnew\u001b[11GKV\u001b[14Glayout\u001b[21Gis\u001b[24Grunning\u001b[32Gslower\u001b[39Geven\u001b[44Gon\u001b[47Gshort\u001b[53Gsequences,\u001b[64Gwhich\u001b[70Gis\u001b[73Gunexpected.\u001b[85GLoad\u001b[90Gis\u001b[93Gabove\u001b[99G3,\u001b[102Gso\u001b[105GI'm\u001b[109Grerunning\r\u001b[1B \u001b[3Gwith mor\u001b[12G rounds befor\u001b[26G conclud\u001b[35Gng anything.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new layout runs about\u001b[29G1.4\u001b[33Gms\u001b[36Gsl"]
[1797.4, "ower\u001b[43Gon\u001b[46Gshort\u001b[52Gsequences\u001b[62Gand\u001b[66Gisn't\u001b[72Gfaster\u001b[79Gat\u001b[82G1024\u001b[87Gpositions,\u001b[98Glikely\u001b[105Gbecause\u001b[113Gthe\r\u001b[2C\u001b[1Btransposed\u001b[14GV\u001b[16Gcache\u001b[22Gcauses\u001b[29Gcache-set\u001b[39Gconflicts.\u001b[50GI'm\u001b[54Gtesting\u001b[62Ga\u001b[64Ghead-major-only\u001b[80Gbuild\u001b[86Gand\u001b[90Ga\u001b[92Gpadded\u001b[99Gtransposed\u001b[110Gbuild\u001b[116Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mT\u001b[6G padded variant's text substitutio\u001b[41G also\u001b[47Galtered\u001b[55Gthe\u001b[59Glegacy\u001b[66Gfreq_cis\u001b[75Gskip,\u001b[81Gbut\u001b[85Gthat\u001b[90Gonly\u001b[95Gmatters\u001b[103Gfor\u001b[107Gmodels\u001b[114Gwith\r\u001b[1B  unshared classifier weights, and this one shares them, so the experiment still holds. I'm treating it as a throwaway\u001b[K\r\u001b[2C\u001b[1Bvariant that won't be kept.\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Even the head-major-only variant runs about 1 ms slower on short sequences, which\u001b[85Gits\u001b[89Gsmall\u001b[95Gchange\u001b[102Gshouldn't\u001b[112Gcause.\r\u001b[1C\u001b[1B I'm reversing "]
[1797.4, "the launch order in my harness\u001b[48Gto\u001b[51Grule\u001b[56Gout\u001b[60Ga\u001b[62Gbias\u001b[67Gbefore\u001b[74Gtrusting\u001b[83Gthese\u001b[89Gnumbers.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Checking launch-order bias in A/B\u001b[37Gharness\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 10 /tmp/cbtest/v_vtp /tmp/cbtest/v_kv /tmp/cbtest/v_hm \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m/tmp/cbtest/v_cur; VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 10 /tmp/cbtest/v_cur /tmp/cbtest/v_cur\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;234;138;106mTwisting\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(29m 40s \u00b7 \u2193\u001b[26G33.5k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1797.401, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
