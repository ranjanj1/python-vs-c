[392.148, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The pure-BLAS\u001b[17Gfloor\u001b[23Gis\u001b[26Gabout\u001b[32G11.9\u001b[37Gms\u001b[40Gper\u001b[44Gtoken,\u001b[51Gyet\u001b[55Gthe\u001b[59Gprogram\u001b[67Gtakes\u001b[73G13.3\u001b[78Gms,\u001b[82Gso\u001b[85GI\u001b[87Gsuspect\u001b[95Gthe\u001b[99Gweight\u001b[106Glayout\u001b[113Gscatters\r\u001b[1C\u001b[1B each\u001b[8Gtoken's\u001b[16Greads\u001b[22Gacross\u001b[29Gseven\u001b[35Gmemory\u001b[42Gregions.\u001b[51GI'll\u001b[56Greorder\u001b[64Gthe\u001b[68Gweights\u001b[76Glayer\u001b[82Gby\u001b[85Glayer\u001b[91Gand\u001b[95Gload\u001b[100Gthem\u001b[105Gwith\u001b[110Gpread\u001b[116Ginto\r\u001b[1C\u001b[1B the alig\u001b[12Ged buffer, dropping \u001b[33Ghe mmap-then-copy\u001b[51Gstep.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load time\u001b[13Gdropped\u001b[21Gfrom\u001b[26Gabout\u001b[32G1.0\u001b[36Gs\u001b[38Gto\u001b[41G0.07\u20130.2\u001b[50Gs,\u001b[53Gbut\u001b[57Gper-token\u001b[67Gspeed\u001b[73Gstayed\u001b[80Gwithin\u001b[87Gnoise\u001b[93Gnear\u001b[98G70\u001b[101Gforwards/s.\u001b[113GNext\r\u001b[1C\u001b[1B I'll compare mean and best-of in the\u001b[40Gmicrobenchmark\u001b[55Gand\u001b[59Gcheck\u001b[65Gsystem\u001b[72Gload\u001b[77Gfor\u001b[81Ga\u001b[83Gsteadier\u001b[92Gnumber.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b"]
[392.149, "[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The microbenchmark's\u001b[24G~12.5\u001b[30Gms/token\u001b[39Gis\u001b[42Gthe\u001b[46Grealistic\u001b[56Gfloor,\u001b[63Gand\u001b[67Gthe\u001b[71Gprogram\u001b[79Gsits\u001b[84Gat\u001b[87G~14.5\u001b[93Gms\u001b[96Gper\u001b[100Gforward.\u001b[109GNext\u001b[114GI'll\r\u001b[1C\u001b[1B add a \u001b[38;2;87;105;247m-DCB_PROFILE\u001b[22G\u001b[39moption\u001b[29Gto\u001b[32G\u001b[38;2;87;105;247mcb.c\u001b[37G\u001b[39mto\u001b[40Gfind\u001b[45Gthe\u001b[49Gremaining\u001b[59Ggap.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gmachine is noisy: the same microbenchmark \u001b[50Gow gives 12\u001b[62G2\u201314.5 ms best-of\u001b[80G I'l\u001b[85G check\u001b[92Gwhether\u001b[100Gmemory\u001b[107Gpressure\u001b[116Gon\r\u001b[1C\u001b[1B thi\u001b[8G8\u001b[10GGB machine\u001b[21Gis behind it.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load\u001b[8Gaverage\u001b[16Gis 5.4 on 8 cores, so single runs are unreliable; I'll compare the four variants\u001b[97Gplus\u001b[102Gtwo\u001b[106Gother\u001b[112GBLAS\r\u001b[1C\u001b[1B calls\u001b"]
