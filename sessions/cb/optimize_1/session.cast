[1797.118, "\u001b]0;\u2733 Claude Code\u0007"]
[1797.126, "\u001b[H\r\u001b[2C\u001b[1BThe new\u001b[11GKV layout \u001b[22Gs runni\u001b[30Gg slower even on short sequenc\u001b[61Gs, which is unexpected.\u001b[85GLoad is above\u001b[99G3, so I'm rerunning\r\u001b[2C\u001b[1Bwith more\u001b[13Grou\u001b[17Gds b\u001b[22Gfor\u001b[26G concluding anything.\u001b[K\r\u001b[2C\u001b[4BThe new layou\u001b[17G runs ab\u001b[27Gt\u001b[29G1.4 ms slower on short\u001b[52Gsequences and isn't\u001b[72Gfaster \u001b[80Gt\u001b[82G1024 positions, \u001b[99Gikely because the\u001b[K\r\u001b[2C\u001b[1Btransposed V cache c\u001b[24Guses c\u001b[31Gche-set conflicts. I'm \u001b[56Gs\u001b[58Ging a head-major-only build\u001b[86Gand a padded tr\u001b[102Gnsposed build\u001b[116Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpadded\u001b[14Gvariant's\u001b[24Gtext\u001b[29Gsubstitution\u001b[42Galso\u001b[47Galtered\u001b[55Gthe\u001b[59Glegacy\u001b[66Gfreq_cis\u001b[75Gskip,\u001b[81Gbut\u001b[85Gthat\u001b[90Gonly\u001b[95Gmatters\u001b[103Gfor\u001b[107Gmodels\u001b[114Gwith\r\u001b[1B \u001b[3Gunshared classifier weights,\u001b[32Gand this o\u001b[43Ge shares th\u001b[55Gm, so the exper\u001b[71Gment still holds. I'm\u001b[93Gtreating\u001b[102Git\u001b[105Gas a throwaway\r\u001b[2C\u001b[1Bvariant that won't be k"]
[1797.127, "ept.\u001b[K\r\u001b[2C\u001b[4BEv\u001b[6Gn the head-major-only variant\u001b[36Gruns ab\u001b[44Gut 1 ms\u001b[53Glow\u001b[57Gr on\u001b[62Gshort sequences,\u001b[79Gwhich its \u001b[90Gmall change shouldn't cause.\r\u001b[2C\u001b[1BI'm reversing the launch order in my harness to rule out a\u001b[62Gbias before trusting these numbers.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mChecking launch-order\u001b[25Gbias\u001b[30Gin\u001b[33GA/B\u001b[37Gharness\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 10 /tmp/cbtest/v_vtp /tmp/cbtest/v_kv /tmp/cbtest/v_hm \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m/tmp/cbtest/v_cur; VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 10 /tmp/cbtest/v_cur /tmp/cbtest/v_cur\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[1797.128, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mCheck launch-order bias in A/B harness\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m VECLIB_MAXIMUM_THREADS=1 python3\u001b[37G/tmp/cbte\u001b[47Gt/ab.py \"$PWD\"\u001b[62G10 /tmp/cbtest/v_vtp\u001b[83G/tmp/cbtest/v_kv\u001b[100G/tmp/cbtest/v_hm\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/tmp/cbtest/v_cur;\u001b[23GVECLIB_MAXIMUM_THREADS=1\u001b[48Gpython3\u001b[56G/tmp/cbtest/ab.py\u001b[74G\"$PWD\"\u001b[81G10\u001b[84G/tmp/cbtest/v_cur\u001b[102G/tmp/cbtest/v_cur\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[1797.129, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mQuoted\u001b[9Gtext\u001b[14Gin\u001b[17Gthis\u001b[22Gcommand\u001b[30Gcan't\u001b[36Gbe\u001b[39Gchecked\u001b[47Gbefore\u001b[54Git\u001b[57Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
