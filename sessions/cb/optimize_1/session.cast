[1048.376, "\u001b[H\r\u001b[26B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new KV layout is running slower even on short sequences, which is unexpected. Load is above 3,\u001b[102Gso\u001b[105GI'm\u001b[109Grerunning\r\u001b[2C\u001b[1Bwith more rounds before concluding anything.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[28C\u001b[2B\u001b[38;2;102;102;102m8\u001b[39m\u001b[40;1H\u001b[38;3H"]
