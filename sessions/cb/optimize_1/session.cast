[357.723, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBaseline \u001b[13Golds at about\u001b[27G14\u001b[30Gms\u001b[33Gper\u001b[37Gforward\u001b[45Gpass\u001b[50G(~70\u001b[55Gtokens/s)\u001b[65Gwith\u001b[70Geither\u001b[77Gthread\u001b[84Gsetting,\u001b[93Gwhich\u001b[99Gworks\u001b[105Gout\u001b[109Gto\u001b[112Groughly\r\u001b[2C\u001b[1B31\u001b[6GGB/s\u001b[11Gof\u001b[14Gweight\u001b[21Greads.\u001b[28GI'm\u001b[32Gadding\u001b[39Goptional\u001b[48Gtimers\u001b[55Gnext\u001b[60Gto\u001b[63Gsee\u001b[67Gwhere\u001b[73Gthe\u001b[77Gtime\u001b[82Ggoes\u001b[87Ginside\u001b[94Ga\u001b[96Gforward\u001b[104Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m96% of the\u001b[14Gtime goes to \u001b[38;2;87;105;247msgemv\u001b[39m, and memory bandwidth\u001b[55G(~25\u201330\u001b[63GGB/s) is the bottleneck. Sinc\u001b[94Gthe matmuls must\u001b[111Gstay\u001b[116GBLAS\r\u001b[2C\u001b[1Bcalls,\u001b[10GI'll\u001b[15Gmicrobenchmark\u001b[30Gthe\u001b[34Gvariants\u001b[43Gthat\u001b[48Gcompute\u001b[56Gthe\u001b[60Gsame\u001b[65G\u001b[38;2;87;105;247mW(d,n) @ x\u001b[76G\u001b[39mproduct\u001b[84Gto\u001b[87Gfind\u001b[92Gthe\u001b[96Gfastest\u001b[104Gcall\u001b[109Gand\u001b[113Glayout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3"]
[357.727, "G\u001b[39mThe pure-BLAS fl\u001b[20Gor is \u001b[27Gbou\u001b[31G 11.9 ms per token, ye\u001b[54G the program takes 13.3 ms, so I\u001b[87Gsuspect the w\u001b[101Gight \u001b[107Gayout\u001b[113Gscatters\r\u001b[2C\u001b[1Beach\u001b[8Gtoken's\u001b[16Greads\u001b[22Gacross\u001b[29Gseven\u001b[35Gmemory\u001b[42Gregions.\u001b[51GI'll\u001b[56Greorder\u001b[64Gthe\u001b[68Gweights\u001b[76Glayer\u001b[82Gby\u001b[85Glayer\u001b[91Gand\u001b[95Gload\u001b[100Gthem\u001b[105Gwith\u001b[110Gpread\u001b[116Ginto\r\u001b[2C\u001b[1Bthe aligned buffer, dropping\u001b[32Gthe\u001b[36Gmmap-then-copy\u001b[51Gstep.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[37G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad t\u001b[10Gme \u001b[14Gropped from about\u001b[32G1.0\u001b[36Gs to 0.07\u20130.2 s, but\u001b[57Gper-token\u001b[67Gspeed\u001b[73Gstayed\u001b[80Gwithin\u001b[87Gnoise\u001b[93Gnear\u001b[98G70\u001b[101Gforwards/s.\u001b[113GNext\r\u001b[2C\u001b[1BI'll\u001b[8Gcompare\u001b[16Gmean\u001b[21Gand\u001b[25Gbest-of\u001b[33Gin\u001b[36Gthe\u001b[40Gmicrobenchmark\u001b[55Gand\u001b[59Gcheck\u001b[65Gsystem\u001b[72Gload\u001b[77Gfor\u001b[81Ga\u001b[83Gsteadier\u001b[92Gnumber.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe m"]
[357.728, "icrobenchm\u001b[19Grk's ~12.5 ms/token is the realistic floor, and th\u001b[70G pr\u001b[74Ggram sits at ~14.5 ms per\u001b[100Gforward.\u001b[109GNext\u001b[114GI'll\r\u001b[2C\u001b[1Badd\u001b[7Ga\u001b[9G\u001b[38;2;87;105;247m-DCB_PROFILE\u001b[22G\u001b[39moption\u001b[29Gto\u001b[32G\u001b[38;2;87;105;247mcb.c\u001b[37G\u001b[39mto\u001b[40Gfind\u001b[45Gthe\u001b[49Gremaining\u001b[59Ggap.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmachine is noisy: the\u001b[29Gsame micr\u001b[39Gbenchmark\u001b[49Gnow gives\u001b[59G12.2\u201314.5\u001b[69Gms\u001b[72Gbest-of.\u001b[81GI'll\u001b[86Gcheck\u001b[92Gwhether\u001b[100Gmemory\u001b[107Gpressure\u001b[116Gon\r\u001b[2C\u001b[1Bthis\u001b[8G8\u001b[10GGB\u001b[13Gmachine\u001b[21Gis\u001b[24Gbehind\u001b[31Git.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
