[30.887, "\u001b[H\u001b[2G - The\u001b[9GRoPE cos/sin\u001b[22Gvalues\u001b[29Gare\u001b[33Gcomputed\u001b[42Gonce\u001b[47Gper\u001b[51Gtoken\u001b[57Ginstead\u001b[65Gof\u001b[68Gonce\u001b[73Gper\u001b[77Glayer.\u001b[84GThey\u001b[89Gdon't\u001b[95Gdepend\u001b[102Gon\u001b[105Gthe\u001b[109Glayer,\u001b[116Gso\r\u001b[1C\u001b[1B \u001b[4G the values are id\u001b[24Gtical.\u001b[31G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[1mLimitations\u001b[22m\u001b[K\r\u001b[1C\u001b[1B - Results are\u001b[17Gnot bit-\u001b[26Gxact\u001b[31Gwith\u001b[36Gthe\u001b[40Greference,\u001b[51Gbecause\u001b[59GAccelerate\u001b[70Gadds\u001b[75Gup\u001b[78Gthe\u001b[82Gproducts\u001b[91Gin\u001b[94Ga\u001b[96Gdifferent\u001b[106Gorder.\u001b[113GA\r\u001b[1C\u001b[1B \u001b[4G near-tie between\u001b[22Gtwo top tokens could in princ\u001b[52Gple pick a\u001b[63Gdifferent\u001b[73Gtoken\u001b[79Gon\u001b[82Gother\u001b[88Ginputs.\r\u001b[1C\u001b[1B - Accelerate may use several\u001b[32Gthreads\u001b[40Ginternally\u001b[51Gunless\u001b[58Gthe\u001b[62Gharness\u001b[70Glimits\u001b[77Git.\u001b[81GThe\u001b[85Gprogram\u001b[93Gleaves\u001b[100Gthat\u001b[105Gto\u001b[108Gthe\u001b[112Gharness,\r\u001b[1C\u001b[1B \u001b[4G as\u001b[8Gthe rules require.\r\u001b[1C\u001b[1B -\u001b[5GFor inputs the interface doesn't\u001b[38Gdefine,\u001b[46GI\u001b[48Gmade\u001b[53Gchoices:\u001b[62GFIXED/LOGITS\u001b[75Gwith\u001b[80Gmore\u001b[85Gthan\u001b[90G1024\u001b[95Gids\u001b[99Gprocess\u001b[107Gonly\u001b[112Gthe\u001b"]
