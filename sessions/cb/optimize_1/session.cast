[155.986, "\u001b[H\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'll star\u001b[14Gby finding the development workloads and\u001b[55Gmeasuring \u001b[66G baseline.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm benchmarking the three fixture prompts on this M1 (8 GB), with Accelerate tested both single-threaded\u001b[109Gand\u001b[113Gat\r\u001b[1C\u001b[1B default threa\u001b[17Ging.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Baseline holds\u001b[18Gat about 14 ms p"]
[155.987, "er forward pa\u001b[48Gs (~70\u001b[55Gtokens/s)\u001b[65Gwith\u001b[70Geither\u001b[77Gthread\u001b[84Gsetting,\u001b[93Gwhich\u001b[99Gworks\u001b[105Gout\u001b[109Gto\u001b[112Groughly\r\u001b[1C\u001b[1B 31\u001b[6GGB/s\u001b[11Gof weight reads. I'm adding optio\u001b[45Gal\u001b[48Gtimers n\u001b[57Gxt to see where\u001b[73Gthe\u001b[77Gtime\u001b[82Ggoes\u001b[87Ginside\u001b[94Ga\u001b[96Gforward\u001b[104Gpass.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m 96%\u001b[7Gof\u001b[10Gth\u001b[13G time goes to \u001b[38;2;87;105;247msgemv\u001b[39m, and \u001b[39Gemory bandwidth (~25\u201330 GB/s) is the bottleneck.\u001b[88GSince the matmuls must stay BLAS\r\u001b[1C\u001b[1B calls,\u001b[10GI'l\u001b[14G microbenchmark the variants that compute the same \u001b[38;2;87;105;247mW(d,n) @ x\u001b[39m product to find the fastes\u001b[103G call an\u001b[113Glayout.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Microbenchmark\u001b[18GBLAS\u001b[23Gcall\u001b[28Gvariants\u001b[37Gfor\u001b[41Gtoken\u001b[47Gmatmuls\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cd /tmp/cbtest && cat > mb.c <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m#define ACCELERATE_NEW_LAPACK\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;1"]
