[1365.296, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMost\u001b[8Gof\u001b[11Gthe\u001b[15Gremaining\u001b[25Gattention\u001b[35Gtime\u001b[40Ggoes\u001b[45Gto\u001b[48Gthe\u001b[52Gtransposed\u001b[63G\u001b[38;2;87;105;247msgemv\u001b[69G\u001b[39mcall,\u001b[75Gat\u001b[78G1.13\u001b[83Gs\u001b[85Gversus\u001b[92G0.46\u001b[97Gs\u001b[99Gfor\u001b[103Gthe\u001b[107Gscores.\r\u001b[1B \u001b[3GStoring\u001b[11GV tr\u001b[16Gnsposed\u001b[24Gper head w\u001b[35Guld\u001b[39Gtur\u001b[44Gthat in\u001b[52Go a NoTrans\u001b[64G\u001b[38;2;87;105;247msgemv\u001b[70G\u001b[39mwith the same shape.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits\u001b[10Gmatch\u001b[16Gthe\u001b[20Gprevious\u001b[29Gbuild\u001b[35Gwithin\u001b[42G9e-6\u001b[47Gover\u001b[52G1024\u001b[57Gpositions\u001b[67Gwith\u001b[72Gno\u001b[75Gargmax\u001b[82Gchanges.\u001b[91GNext\u001b[96GI'll\u001b[101Gmeasure\u001b[109Gboth\u001b[114Gthe\r\u001b[1B \u001b[3Gs\u001b[5Gort fixture worklo\u001b[24Gd and a 1024-p\u001b[39Gsiti\u001b[46Glong-context run aga\u001b[67Gnst the build from before the KV-cache ch\u001b[109Gng\u001b[112Gs,\u001b[K\r\u001b[2C\u001b[1Binterleaved.\u001b[16G\u001b[K\r\u001b[6C\u001b[4Bnew KV\u001b[14Gl\u001b[16Gyout i\u001b[24Grunning \u001b[33Glower eve"]
[1365.297, "n on\u001b[47Gshort sequ\u001b[58Gnc\u001b[61Gs, which is unexpected.\u001b[85GLo\u001b[88Gd\u001b[90Gis above 3, so I'\u001b[108G r\u001b[111Grunn\u001b[116Gng\r\u001b[2C\u001b[1Bwit\u001b[7G more rounds before concluding anything.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The new layout runs about 1.4 ms slower on short sequences and isn't faster at 1024 positions, likely because\u001b[113Gthe\r\u001b[2C\u001b[1Btransposed V cache causes cache-set conflicts. I'm testing a head-major-only build and a padded transposed\u001b[110Gbuild\u001b[116Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The padded variant's\u001b[24Gtext\u001b[29Gsubstitution\u001b[42Galso\u001b[47Galtered\u001b[55Gthe\u001b[59Glegacy\u001b[66Gfreq_cis\u001b[75Gskip,\u001b[81Gbut\u001b[85Gthat\u001b[90Gonly\u001b[95Gmatters\u001b[103Gfor\u001b[107Gmodels\u001b[114Gwith\r\u001b[1C\u001b[1B unshared classifier weights, and this one shares them, so the experiment still holds.\u001b[89GI'm\u001b[93Gtreating\u001b[102Git\u001b[105Gas\u001b[108Ga\u001b[110Gthrowaway\r\u001b[1C\u001b[1B variant that won't be kept.\u001b[K\r\u001b[1B"]
[1365.297, "\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Interl\u001b[10Gaved benchmark of four KV la\u001b[39Gout variants\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ uptime; VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 10 /tmp/cbtest/v_cur /tmp/cbtest/v_hm \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m/tmp/cbtest/v_kv /tmp/cbtest/v_vtp; VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ablong.py \"$PWD\" 4 \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m/tmp/cbtest/v_cur /tmp/cbtest/v_hm /tmp/cbtest/v_kv /tmp/cbtest/v_vtp\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;238;142;110mTwisting\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(22m 28s \u00b7 \u2193\u001b[26G32.6k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
