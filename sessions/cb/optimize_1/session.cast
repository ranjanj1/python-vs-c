[571.364, "\u001b[H\r\u001b[2C\u001b[2BLoad time dropped from about 1.0 s t\u001b[40G 0.07\u20130.2 s, but per-token speed\u001b[73Gstayed within noise near\u001b[98G70 forwards/s.\u001b[113GNext\u001b[K\r\u001b[2C\u001b[1BI'll compare \u001b[17Gean and best-of i\u001b[35G the micr\u001b[45Gbenchmark\u001b[55Gand\u001b[59Gch\u001b[62Gck syst\u001b[70Gm \u001b[73Goad\u001b[77Gf\u001b[79Gr \u001b[82G steadier number.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The microbenchmark's ~12.5 ms/token is the realistic floor, and the program sits at ~14.5 ms per forward.\u001b[109GNext\u001b[114GI'll\r\u001b[2C\u001b[1Badd a \u001b[38;2;87;105;247m-DCB_PROFILE\u001b[39m option to \u001b[38;2;87;105;247mcb.c\u001b[39m to\u001b[40Gfind\u001b[45Gthe\u001b[49Gremaining\u001b[59Ggap.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m3\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmachine\u001b[15Gis\u001b[18Gnoisy:\u001b[25Gthe\u001b[29Gsame\u001b[34Gmicrobenchmark\u001b[49Gnow\u001b[53Ggives\u001b[59G12.2\u201314.5\u001b[69Gms\u001b[72Gbest-of.\u001b[81GI'll\u001b[86Gcheck\u001b[92Gwhether\u001b[100Gmemory\u001b[107Gpressure\u001b[116Gon\r\u001b[1B  this 8 GB machine is behind it.\u001b[K\r\u001b[1C\u001b[1B\u001b["]
[571.365, "K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Load average is 5.4 on 8 cores, so single runs are unreliable; I'll compare the four variants plus two other BLAS\u001b[K\r\u001b[1C\u001b[1B ca\u001b[6Gls using interleaved, repeated runs and medians.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The access-ordered layout wins at about 13.3 ms per forward, ah\u001b[67Gad of the al\u001b[80Ggned copy and the original\u001b[107Gmmap,\u001b[113Gwhile\r\u001b[1C\u001b[1B the \u001b[8Gther sgemm and sgemv variants gave no gain\u001b[52Gso I'm k\u001b[61Geping th\u001b[70G plain\u001b[77GRowMajor\u001b[86Gsgemv.\u001b[93GNext\u001b[98GI'll\u001b[103Gprofile\u001b[111Gattention\r\u001b[1C\u001b[1B at long context, since\u001b[26GGENERATE\u001b[35Gcan\u001b[39Greach\u001b[45G1024\u001b[50Gpositions.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Profiling a 1024-position FIXED run\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ clang -O2 -Wall -DCB_PROFILE -o /tmp/cbtest/cbp cb.c -framework Accelerate && python3 - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b"]
[571.366, "[38;2;102;102;102mimport subprocess, json, time, os\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mfx = json.load(open('fixtures.json'))\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mseq = (fx['prompts'][0]['seq'] * 20)[:1024]\r\u001b[5C\u001b[1Bp = subprocess.Popen(['/tmp/cbtest/cbp', 'model.bin', 'tokenizer.bin'], stdin=subproc\u2026\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[39m \u001b[38;2;238;142;110mTwisting\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(9m 19s \u00b7 \u2193\u001b[25G20.6k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[39m\u001b[K\r\u001b[6C\u001b[1B         \u001b[17G        \u001b[26G  \u001b[29G                      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
