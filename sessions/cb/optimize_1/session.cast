[266.404, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gstart\u001b[14Gby\u001b[17Gfinding\u001b[25Gthe\u001b[29Gdevelopment\u001b[41Gworkloads\u001b[51Gand\u001b[55Gmeasuring\u001b[65Ga\u001b[67Gbaseline.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm benchmarking the\u001b[24Gthree\u001b[30Gfixture\u001b[38Gprompts\u001b[46Gon\u001b[49Gthis\u001b[54GM1\u001b[57G(8\u001b[60GGB),\u001b[65Gwith\u001b[70GAccelerate\u001b[81Gtested\u001b[88Gboth\u001b[93Gsingle-threaded\u001b[109Gand\u001b[113Gat\r\u001b[2C\u001b[1Bdefault\u001b[11Gthreading.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBaseline holds a\u001b[21Gabout 14 \u001b[31Gs per forward pass (~70\u001b[55Gtokens/s) wit\u001b[69G either\u001b[78Ghr\u001b[81Gad setting, which \u001b[100Go\u001b[102Gks out to\u001b[112Groughly\r\u001b[2C\u001b[1B31\u001b[6GGB/s\u001b[11Gof\u001b[14Gweight\u001b[21Greads.\u001b[28GI'm\u001b[32Gadding\u001b[39Goptional\u001b[48Gtimers\u001b[55Gnext\u001b[60Gto\u001b[63Gsee\u001b[67Gwhere\u001b[73Gthe\u001b[77Gtime\u001b[82Ggoes\u001b[87Ginside\u001b[94Ga\u001b[96Gforward\u001b[104Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3"]
[266.405, "G\u001b[39m96% of\u001b[10Gthe time go\u001b[22Gs to \u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[34Gand memory bandwidth (~25\u201330 GB/s) is the\u001b[76Gbottleneck. Since the matmuls must stay BLAS\r\u001b[2C\u001b[1Bcalls,\u001b[10GI'll\u001b[15Gmicrobenchmark\u001b[30Gthe\u001b[34Gvariants\u001b[43Gthat\u001b[48Gcompute\u001b[56Gthe\u001b[60Gsame\u001b[65G\u001b[38;2;87;105;247mW(d,n) @ x\u001b[76G\u001b[39mproduct\u001b[84Gto\u001b[87Gfind\u001b[92Gthe\u001b[96Gfastest\u001b[104Gcall\u001b[109Gand\u001b[113Glayout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe pure-BLAS floor is about 11.9 \u001b[38Gs pe\u001b[43G token,\u001b[51Gyet th\u001b[58G program takes 13.3 ms,\u001b[82Gso\u001b[85GI suspect\u001b[95Gthe weight layout scatters\r\u001b[2C\u001b[1Beach token's reads ac\u001b[26Gss seven me\u001b[38Gory r\u001b[44Ggions.\u001b[51GI'll reorder\u001b[64Gthe\u001b[68Gweights\u001b[76Glayer\u001b[82Gby\u001b[85Glayer\u001b[91Gand\u001b[95Gload\u001b[100Gthem\u001b[105Gwith\u001b[110Gpread\u001b[116Ginto\r\u001b[2C\u001b[1Bthe\u001b[7Galigned\u001b[15Gbuffer,\u001b[23Gdropping\u001b[32Gthe\u001b[36Gmmap-then-copy\u001b[51Gstep.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Reorder weights per layer,\u001b[30Gload\u001b[35Gvia\u001b[39Gpread,\u001b[46Gtest\r\u001b[1B\u001b[38;2;102;102;102m  "]
[266.405, "\u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mpath = '/Users/agentlab/pvc/cb/cb.c'\r\u001b[5C\u001b[1Bs = open(path).read\u001b[26G)\u001b[39m\u001b[K\r\u001b[9C\u001b[1B\u001b[38;2;102;102;102mstart\u001b[16G= s.index('typedef struct\u001b[42G{\\\u001b[45G float *token_embedding_table')\r\u001b[5C\u001b[1Bold_end = s.index('} Weights;\\n') + len('} Weights;\\n')\r\u001b[5C\u001b[1Bs = s[:old\u001b[17Gs\u001b[19Gart] + '''typedef\u001b[37Gstruct {\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfloat *rms_att, *rms_ffn, *wq, *wk, *wv, *wo, *w1, *w\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[3G\u001b[38;2;226;130;98mTwisting\u2026\u001b[14G\u001b[38;2;102;102;102m4\u001b[18G9\u001b[25G11.3k tokens)\u001b[39m\u001b[40;1H\u001b[38;3H"]
