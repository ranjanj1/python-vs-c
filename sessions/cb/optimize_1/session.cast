[1796.876, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[3GT\u001b[39m\u001b[40;1H\u001b[38;3H"]
[1796.997, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[39m\u001b[40;1H\u001b[38;3H"]
