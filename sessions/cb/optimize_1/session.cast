[1049.371, "\u001b[H\r\u001b[2C\u001b[1BThe head-major cache matches the old logit\u001b[47Gexactly\u001b[55Gacross\u001b[62Gall 1024\u001b[71Gpositions and cut attention from 2.5 to 1.8 ms\u001b[118Gper\r\u001b[2C\u001b[1Bforward.\u001b[12GNext\u001b[17GI'll split attention into it\u001b[46G score, softmax, and value steps\u001b[79Gto find the remaining cost.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMost\u001b[8Gof\u001b[11Gthe\u001b[15Gremaining\u001b[25Gattention\u001b[35Gtime\u001b[40Ggoes\u001b[45Gto\u001b[48Gthe\u001b[52Gtransposed\u001b[63G\u001b[38;2;87;105;247msgemv\u001b[69G\u001b[39mcall,\u001b[75Gat\u001b[78G1.13\u001b[83Gs\u001b[85Gversus\u001b[92G0.46\u001b[97Gs\u001b[99Gfor\u001b[103Gthe\u001b[107Gscores.\r\u001b[1B \u001b[3GStoring V transposed per head would turn \u001b[45Ghat into a NoTrans \u001b[38;2;87;105;247msgemv\u001b[39m with the same shape.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLogits\u001b[10Gmatch\u001b[16Gthe\u001b[20Gprevious\u001b[29Gbuild\u001b[35Gwithin\u001b[42G9e-6\u001b[47Gover\u001b[52G1024\u001b[57Gpositions\u001b[67Gwith\u001b[72Gno\u001b[75Gargmax\u001b[82Gchanges.\u001b[91GNext\u001b[96GI'll\u001b[101Gmeasur"]
[1049.372, "e\u001b[109Gboth\u001b[114Gthe\r\u001b[1B \u001b[3Gs\u001b[5Gort fixture workload and a\u001b[32G1024-position long-context run against\u001b[71Gthe build\u001b[81Gfrom before the KV-cache changes,\u001b[115G\u001b[K\r\u001b[2C\u001b[1Binterleaved.\u001b[K\r\u001b[2C\u001b[4BThe new\u001b[11GKV layout \u001b[22Gs runni\u001b[30Gg slower even on short sequenc\u001b[61Gs, which is unexpected.\u001b[85GLoad is above\u001b[99G3, so I'm rerunning\r\u001b[2C\u001b[1Bwith more\u001b[13Grou\u001b[17Gds b\u001b[22Gfor\u001b[26G concluding anything.\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRepeating A/B with reversed\u001b[31Gorder\u001b[37Gand\u001b[41Gmore\u001b[46Grounds\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 12 /tmp/cbtest/v_kv /tmp/cbtest/v_cur; \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mVECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ablong.py \"$PWD\" 6 /tmp/cbtest/v_kv /tmp/cbtest/v_cur; uptime\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
