[345.849, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBaseline holds a\u001b[21Gabout 14 \u001b[31Gs per forward pass (~70\u001b[55Gtokens/s) wit\u001b[69G either\u001b[78Ghr\u001b[81Gad setting, which \u001b[100Go\u001b[102Gks out to\u001b[112Groughly\r\u001b[2C\u001b[1B31\u001b[6GGB/s\u001b[11Gof\u001b[14Gweight\u001b[21Greads.\u001b[28GI'm\u001b[32Gadding\u001b[39Goptional\u001b[48Gtimers\u001b[55Gnext\u001b[60Gto\u001b[63Gsee\u001b[67Gwhere\u001b[73Gthe\u001b[77Gtime\u001b[82Ggoes\u001b[87Ginside\u001b[94Ga\u001b[96Gforward\u001b[104Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m96% of\u001b[10Gthe time go\u001b[22Gs to \u001b[38;2;87;105;247msgemv\u001b[39m,\u001b[34Gand memory bandwidth (~25\u201330 GB/s) is the\u001b[76Gbottleneck. Since the matmuls must stay BLAS\r\u001b[2C\u001b[1Bcalls,\u001b[10GI'll\u001b[15Gmicrobenchmark\u001b[30Gthe\u001b[34Gvariants\u001b[43Gthat\u001b[48Gcompute\u001b[56Gthe\u001b[60Gsame\u001b[65G\u001b[38;2;87;105;247mW(d,n) @ x\u001b[76G\u001b[39mproduct\u001b[84Gto\u001b[87Gfind\u001b[92Gthe\u001b[96Gfastest\u001b[104Gcall\u001b[109Gand\u001b[113Glayout.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b"]
[345.85, "[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe pure-BLAS floor is about 11.9 \u001b[38Gs pe\u001b[43G token,\u001b[51Gyet th\u001b[58G program takes 13.3 ms,\u001b[82Gso\u001b[85GI suspect\u001b[95Gthe weight layout scatters\r\u001b[2C\u001b[1Beach token's reads ac\u001b[26Gss seven me\u001b[38Gory r\u001b[44Ggions.\u001b[51GI'll reorder\u001b[64Gthe\u001b[68Gweights\u001b[76Glayer\u001b[82Gby\u001b[85Glayer\u001b[91Gand\u001b[95Gload\u001b[100Gthem\u001b[105Gwith\u001b[110Gpread\u001b[116Ginto\r\u001b[2C\u001b[1Bthe\u001b[7Galigned\u001b[15Gbuffer,\u001b[23Gdropping\u001b[32Gthe\u001b[36Gmmap-then-copy\u001b[51Gstep.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad\u001b[8Gti\u001b[11Ge dropped\u001b[21Gfrom about 1.0\u001b[36Gs to 0.07\u20130.2 s, but per-to\u001b[64Gen \u001b[68Gp\u001b[70Ged stayed within noise near 70\u001b[101Gforwards/s.\u001b[113GNext\r\u001b[2C\u001b[1BI'll\u001b[8Gcompare\u001b[16Gmean\u001b[21Gand\u001b[25Gbest-of\u001b[33Gin\u001b[36Gthe\u001b[40Gmicrobenchmark\u001b[55Gand\u001b[59Gcheck\u001b[65Gsystem\u001b[72Gload\u001b[77Gfor\u001b[81Ga\u001b[83Gsteadier\u001b[92Gnumber.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b"]
