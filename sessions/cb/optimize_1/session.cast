[391.894, "3Gsys.argv[3:]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m fx = json.load(open(os.path.join(d,\u001b[40G'fixtures.json')))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mseqs\u001b[9G=\u001b[11G['\u001b[14G'.join(map(str,\u001b[30Gp['seq']))\u001b[41Gfor\u001b[45Gp\u001b[47Gin\u001b[50Gfx['prompts']];\u001b[66Gntok\u001b[71G=\u001b[73Gsum(len(p['seq'])\u001b[91Gfor\u001b[95Gp\u001b[97Gin\u001b[100Gfx['prompts'])\r\u001b[1B \u001b[2m\u2502\u001b[22m procs = {}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for\u001b[8Ge in exes:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp\u001b[10G=\u001b[12Gsubprocess.Popen([e,\u001b[33Gos.path.join(d,\u001b[49G'model.bin'),\u001b[63Gos.path.join(d,\u001b[79G'tokenizer.bin')],\u001b[98Gstdin=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m stdout=subprocess.PIPE,\u001b[28Gtext=True,\u001b[39Gbufsize=1)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdout.readline();\u001b[29Gprocs[e]\u001b[38G=\u001b[40Gp\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G fo\u001b[11G s in seqs: p.stdin.write(f'FIXED {s}\\n'); p.stdin.flush();\u001b[72G.stdout.readline()  # warm\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m res = {e: [] for e in exes}\u001b[32G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gr\u001b[10Gin\u001b[13Grange(rounds):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for e in (exes if\u001b[26Gr\u001b[28G%\u001b[30G2\u001b[32G==\u001b[35G0\u001b[37Gelse\u001b[42Gexes[::-1]):\r\u001b[1C\u001b[1B"]
[391.895, "\u001b[2m\u2502\u001b[12G\u001b[22mp\u001b[14G=\u001b[16Gprocs[e];\u001b[26Gt\u001b[28G=\u001b[30Gtime.perf_counter()\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     for \u001b[18Gin \u001b[22Geqs: p.\u001b[30Gtdin.write(f'FIXED\u001b[49G{s}\\n'); p.stdin.flush(); p.stdout.readline()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G \u001b[10G  res[e].append((time.perf_counter()\u001b[47G-\u001b[49Gt)\u001b[52G/\u001b[54Gntok\u001b[59G*\u001b[61G1e3)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Ge\u001b[10Gin\u001b[13Gexes:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     procs[e].stdin.write('QUIT\\n');\u001b[40Gprocs[e].stdin.flush();\u001b[64Gprocs[e].wait()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(f'{os.path.basename(e):10s}\u001b[42Gmedian\u001b[49G{statistics.median(res[e]):6.2f}\u001b[83Gmin\u001b[87G{min(res[e]):6.2f}\u001b[106Gms/forward')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[8G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m cd /Users/agentlab/pvc/cb && uptime && VECLIB_MAXIMUM_THREADS=1\u001b[68Gpython3\u001b[76G/tmp/cbtest/ab.py\u001b[94G\"$PWD\"\u001b[101G8\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/tmp/cbtest/v_mmap\u001b[23G/tmp/cbtest/v_aligned\u001b[45G/tmp/cbtest/v_cur\u001b[63G/tmp/cbtest/v_gemm\u001b[82G/tmp/cbtest/v_ct\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
