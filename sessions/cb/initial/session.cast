[170.071, "\u001b[H\u001b[6G\u001b[38;2;102;102;102massert rd() == 'READY'\r\u001b[5C\u001b[1Btext = ' '.join(f'word{i}' for i in range(200))\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mp.std\u001b[12Gn.write(\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mTest context limit and measure generation time\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[170.072, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3 - <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport subprocess\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G= subprocess.Popen(['./cb', 'model.bin', 'tokenizer.bin'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtext=True, bufsize=1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrd = lambda: p.stdout.readline().rstrip('\\n')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert rd() == 'READY'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtext = ' '.join(f'word{i}'\u001b[31Gfor\u001b[35Gi\u001b[37Gin\u001b[40Grange(200))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write(f'ENCODE {text}\\n');\u001b[39Gp.stdin.flush();\u001b[56Gn\u001b[58G=\u001b[60Glen(rd().split())\u001b[78G-\u001b[80G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write(f'GENERATE 5000\u001b[34G{text}\\n');\u001b[46Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mc\u001b[6G= 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwhile True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22ms\u001b[10G=\u001b[12Grd()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     if s.startswith('DONE'):\u001b[33Gbreak\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[2"]
[170.073, "2mc\u001b[10G+=\u001b[13G1\r\u001b[1B \u001b[2m\u2502\u001b[22m prin\u001b[9G('prompt', n, 'expect\u001b[31Gd', 1024 - n + 1\u001b[49G'got', c, \u001b[60G)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m impor\u001b[11Gtim\u001b[15G; t = time.time()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('GENERATE\u001b[28G256\u001b[32GOnce\u001b[37Gupon\u001b[42Ga\u001b[44Gtime\\n');\u001b[54Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m while not rd().startswith('DONE'):\u001b[39Gpass\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('256-ish\u001b[19Gtokens\u001b[26Gin',\u001b[31Ground(time.time()\u001b[49G-\u001b[51Gt,\u001b[54G3),\u001b[58G's')\r\u001b[1B \u001b[2m\u2502\u001b[22m p.stdin.write('QUIT\\n'); p.\u001b[32Gtdin.flush(); p.wai\u001b[52G()\u001b[55G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[8G\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to pr"]
