[256.638, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<math.h>\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdint.h>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[11G\u001b[22m\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +437 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth the quick check and the\u001b[32Gfull\u001b[37Gcheck\u001b[43Gpass,\u001b[49Gwith\u001b[54Gerrors\u001b[61Gwell\u001b[66Gunder\u001b[72Gtolerance.\u001b[83GNext\u001b[88GI'm\u001b[92Gtesting\u001b[100Gthe\u001b[104Gcommands\u001b[113Gcheck.py\r\u001b[2C\u001b[1Bdoesn't cover, including\u001b[28GPIECE,\u001b[35GFIXED,\u001b[42Gan\u001b[45Gempty\u001b[51Gprompt,\u001b[59Gthe\u001b[63Gcontext\u001b[71Glimit,\u001b[78Gand\u001b[82GQUIT.\r\u001b[6C\u001b[2B\u001b[38;2;102;102;102m\u001b[1m1\u001b[22G\u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BAll fixture outputs,\u001b[25Grgmax\u001b[31Gs, byte to\u001b[42Gens, and \u001b[53Ge st\u001b[58Gp and quit behav"]
[256.639, "iour \u001b[80Gheck out. I'm next testing the cont\u001b[116Gxt\u001b[K\r\u001b[2C\u001b[1Bstop a\u001b[11Gseq_len and t\u001b[25Gming a 256-token\u001b[42Ggen\u001b[46Gra\u001b[49Gion.\u001b[K\r\u001b[2C\u001b[4BThe\u001b[7Gcon\u001b[11Gext\u001b[15Gsto\u001b[19G i\u001b[22G right, since 691 prompt\u001b[47Gtokens give 334 new ones \u001b[73Gt about 66 t\u001b[86Gk/s. The weight\u001b[102G star\u001b[108G 28 by\u001b[116Gs\u001b[K\r\u001b[2C\u001b[1Binto\u001b[8Gthe mmap and aren't 16-byte alig\u001b[41Ged, so I'm copying\u001b[60Gthem\u001b[65Ginto\u001b[70Gan\u001b[73Galigned\u001b[81Gbuffer\u001b[88Gto\u001b[91Gtest\u001b[96Gwhether\u001b[104GBLAS\u001b[109Gspeeds\u001b[116Gup.\r\u001b[6C\u001b[4Baligned\u001b[15Gcopy\u001b[23Gabou\u001b[28G 10% faster\u001b[40Gand avoids page faults\u001b[63Gon the first c\u001b[78Gmmand, so I'm adding i\u001b[101G to \u001b[38;2;87;105;247mcb.c\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(cb.c)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[256.639, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mcb.c\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;102;102;102m\u2026\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[256.64, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mcb.c\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[256.652, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe context stop\u001b[20Gis\u001b[23Gright,\u001b[30Gsince\u001b[36G691\u001b[40Gprompt\u001b[47Gtokens\u001b[54Ggive\u001b[59G334\u001b[63Gnew\u001b[67Gones\u001b[72Gat\u001b[75Gabout\u001b[81G66\u001b[84Gtok/s.\u001b[91GThe\u001b[95Gweights\u001b[103Gstart\u001b[109G28\u001b[112Gbytes\r\u001b[2C\u001b[1Binto\u001b[8Gthe\u001b[12Gmmap\u001b[17Gand\u001b[21Garen't\u001b[28G16-byte\u001b[36Galigned,\u001b[45Gso\u001b[48GI'm\u001b[52Gcopying\u001b[60Gthem\u001b[65Ginto\u001b[70Gan\u001b[73Galigned\u001b[81Gbuffer\u001b[88Gto\u001b[91Gtest\u001b[96Gwhether\u001b[104GBLAS\u001b[109Gspeeds\u001b[116Gup.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTh\u001b[6G aligned copy is about 10% faster and avoids\u001b[52Gage faults\u001b[63Gon \u001b[67Ghe first command, so\u001b[88GI'm\u001b[92Gadding\u001b[99Git\u001b[102Gto\u001b[105G\u001b[38;2;87;105;247mcb.c\u001b[39m.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(cb.c)\u001b[K\r\u001b[2B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[256.653, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mcb.c\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 60 \u001b[22m     kv_dim = (C.dim * C.n_kv_heads) / C.n_heads;\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 61 \u001b[22m     kv_mul = C.n_heads / C.n_kv_heads;\r\u001b[1B\u001b[2m 62 \u001b[22m     \u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m \u001b[38;2;0"]
[256.653, ";134;179mlong\u001b[38;2;51;51;51m L = (\u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m)C.n_layers;\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 63 -\u001b[38;2;51;51;51m    float *p = data + sizeof(Config) / sizeof(float);                                                              \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 63 +\u001b[38;2;51;51;51m    \u001b[38;2;150;152;150m/* Copy the float32 weights (unchanged) into a page-aligned buffer: the file\u001b[38;2;51;51;51m                                   \r\u001b[1B\u001b[38;2;36;138;61m 64 +\u001b[38;2;51;51;51m     * places them at byte offset \u001b[38;2;0;134;179m28\u001b[38;2;51;51;51m, and aligned rows measured ~\u001b[38;2;0;134;179m10\u001b[38;2;51;51;51m% faster in sgemv. */                           \r\u001b[1B\u001b[38;2;36;138;61m 65 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m nfl = ((\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)fsize - \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(Config)) / \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;"]
[256.654, "179mfloat\u001b[38;2;51;51;51m);                                                 \r\u001b[1B\u001b[38;2;36;138;61m 66 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m *p = \u001b[38;2;0;134;179mNULL\u001b[38;2;51;51;51m;                                                                                               \r\u001b[1B\u001b[38;2;36;138;61m 67 +\u001b[38;2;51;51;51m    \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m (posix_memalign((\u001b[38;2;0;134;179mvoid\u001b[38;2;51;51;51m **)&p, \u001b[38;2;0;134;179m16384\u001b[38;2;51;51;51m, nfl * \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m))) { \u001b[38;2;0;134;179mfprintf\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mstderr\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m\"malloc failed\\n\"\u001b[38;2;51;51;51m); \u001b[38;2;0;134;179mexit\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m); }  \r\u001b[1B\u001b[38;2;36;138;61m 68 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179mmemcpy\u001b[38;2;51;51;51m(p, data + \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(Config) / \u001b[38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m), nfl * \u001b["]
[256.655, "38;2;167;29;93msizeof\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mfloat\u001b[38;2;51;51;51m));                                         \r\u001b[1B\u001b[38;2;36;138;61m 69 +\u001b[38;2;51;51;51m    munmap(data, (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)fsize);                                                                                   \r\u001b[1B\u001b[38;2;36;138;61m 70 +\u001b[38;2;51;51;51m    close(fd);                                                                                                     \r\u001b[1B\u001b[49m\u001b[2m 71 \u001b[22m     W.token_embedding_table = p; p += (\u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m)C.vocab_size * C.dim;\r\u001b[1B\u001b[2m 72 \u001b[22m     W.rms_att_weight = p;        p += L * C.dim;\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 73 \u001b[22m     W.wq = p;                    p += L * C.dim * (C.n_heads * head_size);\u001b[39m\u001b[40;1H\u001b[36;2H"]
[256.721, "\u001b[H\r\u001b[12B\u001b[38;2;102;102;102m\u23fa\u001b[39m\u001b[40;1H\u001b[36;2H"]
