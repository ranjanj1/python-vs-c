[129.57, "\u001b[H\r\u001b[1B  \u001b[38;2;102;102;102mRead \u001b[1m2\u001b[22m files, listed \u001b[1m1\u001b[22m directory, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The model is a 768-dim,\u001b[27G12-layer,\u001b[37G32k-vocab\u001b[47Gnetwork\u001b[55Gwith\u001b[60Gshared\u001b[67Gweights\u001b[75Gand\u001b[79G1024-token\u001b[90Gcontext.\u001b[99GI'm\u001b[103Gwriting\u001b[111Gthe\u001b[115GC\u001b[117Gport\r\u001b[2C\u001b[1Bnow,\u001b[8Grouting\u001b[16Gevery\u001b[22Gmatrix-vector\u001b[36Gproduct\u001b[44Gthrough\u001b[52Gcblas_sgemv.\r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mWrite\u001b[22m(cb.c)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m447\u001b[22m lines to \u001b[1mcb.c\u001b[22m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m/* CB port of reference/run.c (llama2.c): C + Apple Accelerate BLAS, float32.\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m * Matrix-\u001b[38;2;0;134;179mvector\u001b[38;2;51;51;51m products use cblas_sgemv with the \u001b[38;2;121;93;163msame\u001b[38;2;51;51;51m \u001b[38;2;0;134;179m(d,n)\u001b[38;2;51;51;51m @ \u001b[38;2;0;134;179m(n,)\u001b[38;2;51;51;51m shapes as the\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m * reference matmul; ev"]
[129.57, "erything \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m follows the reference loops. Single sequence,\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m * batch size \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, greedy decoding, \u001b[38;2;0;134;179mstdin\u001b[38;2;51;51;51m/\u001b[38;2;0;134;179mstdout\u001b[38;2;51;51;51m protocol from INTERFACE.md. */\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93mdefine\u001b[38;2;150;152;150m ACCELERATE_NEW_LAPACK\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<Accelerate/Accelerate.h>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<fcntl.h>\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<math.h>\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdint.h>\r\u001b[1B\u001b[39m \u001b[3G "]
