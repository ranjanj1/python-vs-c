[203.643, "54;145mAccelerate/Accelerate.h>\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 7\u001b[20G\u001b[22m\u001b[38;2;24;54;145mfcntl\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<math.h>\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdint.h>\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +437 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth the quick check\u001b[24Gand\u001b[28Gthe\u001b[32Gfull\u001b[37Gcheck\u001b[43Gpass,\u001b[49Gwith\u001b[54Gerrors\u001b[61Gwell\u001b[66Gunder\u001b[72Gtolerance.\u001b[83GNext\u001b[88GI'm\u001b[92Gtesting\u001b[100Gthe\u001b[104Gcommands\u001b[113Gcheck.py\r\u001b[2C\u001b[1Bdoesn't\u001b[11Gcover,\u001b[18Gincluding\u001b[28GPIECE,\u001b[35GFIXED,\u001b[42Gan\u001b[45Gempty\u001b[51Gprompt,\u001b[59Gthe\u001b[63Gcontext\u001b[71Glimit,\u001b[78Gand\u001b[82GQUIT.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell com"]
[203.644, "mand \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll fixture ou\u001b[18Gputs, argmax\u001b[31Gs, byte\u001b[39Gtok\u001b[43Gns, a\u001b[49Gd th\u001b[55Gstop\u001b[60Gand\u001b[64Gquit\u001b[69Gbehaviour\u001b[79Gcheck\u001b[85Gout.\u001b[90GI'm\u001b[94Gnext\u001b[99Gtesting\u001b[107Gthe\u001b[111Gcontext\r\u001b[1B  stop at seq_len and timing\u001b[30Ga\u001b[32G256-token\u001b[42Ggeneration.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe context stop is right, since 691 prompt tokens\u001b[54Ggive\u001b[59G334\u001b[63Gnew\u001b[67Gones\u001b[72Gat\u001b[75Gabout\u001b[81G66\u001b[84Gtok/s.\u001b[91GThe\u001b[95Gweights\u001b[103Gstart\u001b[109G28\u001b[112Gbytes\r\u001b[2C\u001b[1Binto the mmap and aren't 16-byte\u001b[36Galigned,\u001b[45Gso\u001b[48GI'm\u001b[52Gcopying\u001b[60Gthem\u001b[65Ginto\u001b[70Gan\u001b[73Galigned\u001b[81Gbuffer\u001b[88Gto\u001b[91Gtest\u001b[96Gwhether\u001b[104GBLAS\u001b[109Gspeeds\u001b[116Gup.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m6\u001b[29G1\u001b[39m\u001b[40;1H\u001b[38;3H"]
