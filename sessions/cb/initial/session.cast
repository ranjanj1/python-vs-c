[305.499, "\u001b[H\r\u001b[18C\u001b[33B\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
[305.624, "\u001b[H\u001b[7G\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22m```\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +42 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've written the CB port as one file, \u001b[38;2;87;105;247mcb.c\u001b[39m, built as \u001b[38;2;87;105;247m./cb\u001b[39m, and it passes both the default check and the full check\r\u001b[2C\u001b[1B(\u001b[38;2;87;105;247mpython3 check.py --tokens 64 --prompts 3 -- ./cb\u001b[39m). The largest logit error is about 3e-5, well under the 5e-4\u001b[K\r\u001b[2C\u001b[1Btolerance.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMatmuls:\u001b[22m every matrix-vector product in the reference is one \u001b[38;2;87;105;247mcblas_sgemv\u001b[39m call with the same \u001b[38;2;87;105;247m(d,n) @ (n,)\u001b[39m shape,\u001b[117Gone\r\u001b[4C\u001b[1Btoken at a time. That covers q/k/v/o, w1/w3/w2 and the classifier. Prompts are not batched into larger matrix\r\u001b[4C\u001b[1Bmultiplies.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttention:\u001b[22m per head, the scores (\u001b[38;2;87;105;247mK @ q\u001b[39m) and the weighted value sum (\u001b[38;2;87;105;247mV\u1d40 @ att\u001b[39m)\u001b[83Gare\u001b[87Galso\u001b[92GBLAS\u001b[97Gm"]
[305.625, "atrix-vector\u001b[111Gcalls.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEverything else\u001b[22m is copied from the reference: rmsnorm,\u001b[60Gsoftmax,\u001b[69GRoPE,\u001b[75GSwiGLU,\u001b[83Gargmax\u001b[90Gties\u001b[95G(lowest\u001b[103Gindex\u001b[109Gwins),\u001b[116Gand\r\u001b[4C\u001b[1Bthe tokenizer's encode/decode. All maths is float32 and compiled without fast-math.\u001b[89GThe\u001b[93Gprogram\u001b[101Gstarts\u001b[108Gno\u001b[111Gthreads\r\u001b[4C\u001b[1Band\u001b[9Gsets\u001b[14Gno\u001b[17Gthread\u001b[24Gcounts.\r\u001b[2C\u001b[1B- \u001b[1mKV cache:\u001b[22m each command\u001b[28Gstarts\u001b[35Gat\u001b[38Gposition\u001b[47G0,\u001b[50Gand\u001b[54Gthe\u001b[58Grows\u001b[63Gthe\u001b[67Gprevious\u001b[76Gcommand\u001b[84Gwrote\u001b[90Gare\u001b[94Gzeroed\u001b[101Gfirst.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop rule:\u001b[16G\u001b[22mprompt\u001b[23Gtokens\u001b[30Gare\u001b[34Gforced,\u001b[42Gthen\u001b[47Git\u001b[50Gstops\u001b[56Gwith\u001b[61G\u001b[38;2;87;105;247mstop\u001b[66G\u001b[39mon\u001b[69Gtoken\u001b[75G1,\u001b[78G\u001b[38;2;87;105;247mmax\u001b[82G\u001b[39mafter\u001b[88Gmax_new\u001b[96Gtokens,\u001b[104Gor\u001b[107G\u001b[38;2;87;105;247mcontext\u001b[115G\u001b[39mat\r\u001b[1B \u001b[3G  1024 po\u001b[13Gitions. If max_ne\u001b[31G and the context\u001b[48Glimit\u001b[54Gare\u001b[58Ghit\u001b[62Gon\u001b[65Gthe\u001b[69Gsame\u001b[74Gtoken,\u001b[81Git\u001b[84Greports\u001b[92G\u001b[38;2;87;105;247mma"]
[305.626, "x\u001b[39m;\u001b[97Gthe\u001b[101Ginterface\u001b[111Gdoesn't\r\u001b[4C\u001b[1Bsay\u001b[9Gwhich\u001b[15Gshould\u001b[22Gwin.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[1mMy own tests\u001b[22m (b\u001b[19Gyond\u001b[24Gcheck.py,\u001b[34Gall\u001b[38Gcorrect)\r\u001b[2C\u001b[1B-\u001b[5GPIECE output matches every piece in the fixtures,\u001b[55Gincluding\u001b[65Graw-byte\u001b[74Gtokens.\r\u001b[2C\u001b[1B-\u001b[5GFIXED\u001b[11Gargmaxes\u001b[20Gmatch\u001b[26Gthe\u001b[30Gfixture\u001b[38Gtokens.\r\u001b[2C\u001b[1B-\u001b[5GThe edge cases\u001b[20Gwork:\u001b[26Gan\u001b[29Gempty\u001b[35Gprompt,\u001b[43G\u001b[38;2;87;105;247mGENERATE 0\u001b[39m,\u001b[55Gstopping\u001b[64Gon\u001b[67Gtoken\u001b[73G1,\u001b[76Gand\u001b[80GQUIT\u001b[85Gexiting\u001b[93Gwith\u001b[98Gcode\u00a00.\r\u001b[2C\u001b[1B-\u001b[5GA 691-token prompt produced exactly 334 new tokens before reporting \u001b[38;2;87;105;247mcontext\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges that don't change the numbers\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GAt load, the weights\u001b[26Gare\u001b[30Gcopied\u001b[37Ginto\u001b[42Gan\u001b[45Galigned\u001b[53Gbuffer\u001b[60Ginstead\u001b[68Gof\u001b[71Gread\u001b[76Gin\u001b[79Gplace\u001b[85Gfrom\u001b[90Gthe\u001b[94Gfile.\u001b[100GThey\u001b[105Gare\u001b[109Gthe\u001b[113Gsame\r\u001b[4C\u001b[1Bfloat32 values,\u001b[21Gand\u001b[25Git\u001b[28Gmeasured\u001b[37Gabout\u001b[43G10%\u001b[47Gfaster.\r\u001b[2C\u001b[1B-\u001b[5GThe RoPE "]
[305.627, "cos/sin values are computed once per token instead of\u001b[68Gonce\u001b[73Gper\u001b[77Glayer.\u001b[84GThey\u001b[89Gdon't\u001b[95Gdepend\u001b[102Gon\u001b[105Gthe\u001b[109Glayer,\u001b[116Gso\r\u001b[4C\u001b[1Bthe values\u001b[16Gare\u001b[20Gidentical.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  -\u001b[K\u001b[40;1H\u001b[38;3H"]
