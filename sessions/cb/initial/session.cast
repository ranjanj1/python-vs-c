[306.018, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've written the\u001b[20GCB\u001b[23Gport\u001b[28Gas\u001b[31Gone\u001b[35Gfile,\u001b[41G\u001b[38;2;87;105;247mcb.c\u001b[39m,\u001b[47Gbuilt\u001b[53Gas\u001b[56G\u001b[38;2;87;105;247m./cb\u001b[39m,\u001b[62Gand\u001b[66Git\u001b[69Gpasses\u001b[76Gboth\u001b[81Gthe\u001b[85Gdefault\u001b[93Gcheck\u001b[99Gand\u001b[103Gthe\u001b[107Gfull\u001b[112Gcheck\r\u001b[2C\u001b[1B(\u001b[38;2;87;105;247mpython3 check.py --tokens 64 --prompts 3 -- ./cb\u001b[39m).\u001b[55GThe\u001b[59Glargest\u001b[67Glogit\u001b[73Gerror\u001b[79Gis\u001b[82Gabout\u001b[88G3e-5,\u001b[94Gwell\u001b[99Gunder\u001b[105Gthe\u001b[109G5e-4\r\u001b[1B \u001b[3Gtol\u001b[7Grance.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mWhat it does\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mMatmuls:\u001b[14G\u001b[22mevery\u001b[20Gmatrix-vector\u001b[34Gproduct\u001b[42Gin\u001b[45Gthe\u001b[49Greference\u001b[59Gis\u001b[62Gone\u001b[66G\u001b[38;2;87;105;247mcblas_sgemv\u001b[78G\u001b[39mcall\u001b[83Gwith\u001b[88Gthe\u001b[92Gsame\u001b[97G\u001b[38;2;87;105;247m(d,n) @ (n,)\u001b[110G\u001b[39mshape,\u001b[117Gone\r\u001b[2C\u001b[1B  token at a\u001b[16Gtime.\u001b[22GThat\u001b[27Gcovers\u001b[34Gq/k/v/o,\u001b[43Gw1/w3/w2\u001b[52Gand\u001b[56Gthe\u001b[60Gclassifier.\u001b[72GPrompts\u001b[80Gare\u001b[84Gnot\u001b[88Gbatched\u001b[96Ginto\u001b[101Glarger\u001b[108Gmatrix\r\u001b[2C\u001b[1B \u001b[5Gmultiplies.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttenti"]
[306.02, "on:\u001b[16G\u001b[22mper head, the scores (\u001b[38;2;87;105;247mK @ q\u001b[39m) and the weig\u001b[58Gted value sum\u001b[72G(\u001b[38;2;87;105;247mV\u1d40 @ att\u001b[39m) are also BLAS matrix-v\u001b[106Gctor calls.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEverything else\u001b[21G\u001b[22mis\u001b[24Gcopied\u001b[31Gfrom\u001b[36Gthe\u001b[40Greference:\u001b[51Grmsnorm,\u001b[60Gsoftmax,\u001b[69GRoPE,\u001b[75GSwiGLU,\u001b[83Gargmax\u001b[90Gties\u001b[95G(lowest\u001b[103Gindex\u001b[109Gwins),\u001b[116Gand\r\u001b[2C\u001b[1B \u001b[5Gthe tokenizer's \u001b[22Gncode/decode. All maths is\u001b[49Gfloat32 and compiled without fast-math. The progr\u001b[99Gm starts no\u001b[111Gthreads\r\u001b[2C\u001b[1B \u001b[5Gand sets no thread\u001b[26Gunts.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m each command starts at posi\u001b[43Gion 0, and the rows the prev\u001b[72Gous command wrote are zeroed\u001b[101Gfirs\u001b[106G.\u001b[108G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStop rule:\u001b[22m prompt toke\u001b[28Gs are\u001b[34Gforced,\u001b[42Gthen\u001b[47Git\u001b[50Gstops\u001b[56Gwith\u001b[61G\u001b[38;2;87;105;247mstop\u001b[66G\u001b[39mon\u001b[69Gtoken\u001b[75G1,\u001b[78G\u001b[38;2;87;105;247mmax\u001b[82G\u001b[39mafter\u001b[88Gmax_new\u001b[96Gtokens,\u001b[104Gor\u001b[107G\u001b[38;2;87;105;247mcontext\u001b[115G\u001b[39mat\r\u001b[2C\u001b[1B \u001b[5G1024 positions. If "]
