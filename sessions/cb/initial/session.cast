[254.091, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m447\u001b[22m lines to \u001b[1mcb.c\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;150;152;150m/* CB port of reference/run.c (llama2.c): C + Apple Accelerate BLAS, float32.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m * Matrix-\u001b[38;2;0;134;179mvector\u001b[38;2;51;51;51m products use cblas_sgemv with the \u001b[38;2;121;93;163msame\u001b[38;2;51;51;51m \u001b[38;2;0;134;179m(d,n)\u001b[38;2;51;51;51m @ \u001b[38;2;0;134;179m(n,)\u001b[38;2;51;51;51m shapes as the\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22m * reference matmul; everything \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m follows the reference loops. Single sequence,\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m * batch size \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, greedy decoding, \u001b[38;2;0;134;179mstdin\u001b[38;2;51;51;51m/\u001b[38;2;0;134;179mstdout\u001b[38;2;51;51;51m protocol from INTERFACE.md. */\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m\u001b[38;2;167;29;93mdefine\u001b[38;2;150;152;150m ACCELERATE_NEW_LAPACK\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 6\u001b[20G\u001b[22m\u001b[38;2;24;54;145mAccelerate/Accelerate.h>\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  7 "]
[254.092, "\u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<fcntl.h>\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<math.h>\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdint.h>\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +437 lines \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBoth\u001b[8Gthe\u001b[12Gquick\u001b[18Gcheck\u001b[24Gand\u001b[28Gthe\u001b[32Gfull\u001b[37Gcheck\u001b[43Gpass,\u001b[49Gwith\u001b[54Gerrors\u001b[61Gwell\u001b[66Gunder\u001b[72Gtolerance.\u001b[83GNext\u001b[88GI'm\u001b[92Gtesting\u001b[100Gthe\u001b[104Gcommands\u001b[113Gcheck.py\r\u001b[1B \u001b[3Gdoesn't cover, includin\u001b[27G PIECE, FIXED, a\u001b[44G empty\u001b[51Gpromp\u001b[57G, the context lim\u001b[75Gt, and QUIT.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1"]
[254.094, "m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gfixture\u001b[15Goutputs,\u001b[24Gargmaxes,\u001b[34Gbyte\u001b[39Gtokens,\u001b[47Gand\u001b[51Gthe\u001b[55Gstop\u001b[60Gand\u001b[64Gquit\u001b[69Gbehaviour\u001b[79Gcheck\u001b[85Gout.\u001b[90GI'm\u001b[94Gnext\u001b[99Gtesting\u001b[107Gthe\u001b[111Gcontext\r\u001b[1B \u001b[3Gstop at seq_len and\u001b[23Gt\u001b[25Gming\u001b[30Ga 256-token generatio\u001b[52G.\u001b[54G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The context stop is right, since 691 prompt tokens give 334\u001b[63Gnew\u001b[67Gones\u001b[72Gat\u001b[75Gabout\u001b[81G66\u001b[84Gtok/s.\u001b[91GThe\u001b[95Gweights\u001b[103Gstart\u001b[109G28\u001b[112Gbytes\r\u001b[2C\u001b[1Binto the mmap and aren't 16-byte aligned, so I'm\u001b[52Gcopying\u001b[60Gthem\u001b[65Ginto\u001b[70Gan\u001b[73Galigned\u001b[81Gbuffer\u001b[88Gto\u001b[91Gtest\u001b[96Gwhether\u001b[104GBLAS\u001b[109Gspeeds\u001b[116Gup.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe aligned copy is about 10% faster and avoids page\u001b[56Gfaults\u001b[63Gon\u001b[66Gthe\u001b[70Gfirst\u001b[76Gcommand,\u001b[85Gso\u001b[88GI"]
