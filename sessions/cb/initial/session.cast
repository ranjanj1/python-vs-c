[153.497, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mfx\u001b[7G=\u001b[9Gjson.load(open('fixtures.json'))\r\u001b[1B \u001b[2m\u2502\u001b[22m p = subprocess.Popen(['./cb', 'model.bin', 'tokenizer.bin'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m text=True, bufsize=1)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m rd = lambda: p.stdout.readline().rstrip('\\n')\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m def ask(s): p.stdin.write(s + '\\n'); p.stdin.flush(); return rd()\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m assert rd() == 'READY'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mbad\u001b[8G=\u001b[10G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for pr in fx['prompts']:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mseq\u001b[12G=\u001b[14Gpr['seq']\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G for i, w\u001b[17Gnt in enumerate(p\u001b[35G['pieces']):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G    got\u001b[16G= ask(f'PIECE {seq[i]} {seq[i+1]}')\u001b[52G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Ggot\u001b[19G!=\u001b[22Gwant:\u001b[28Gbad\u001b[32G+=\u001b[35G1;\u001b[38Gprint('PIECE\u001b[51Gmismatch',\u001b[62Gi,\u001b[65Ggot,\u001b[70Gwant)\r\u001b[1B \u001b[2m\u2502\u001b[22m     r = ask('FIXED\u001b[23G'\u001b[25G+\u001b[27G'\u001b[29G'.join(map(str,\u001b[45Gseq))).split()\r\u001b[1B \u001b[2m\u2502\u001b[22m     n =\u001b[12Glen(pr['\u001b[21Geq']) - 0\r\u001b[1C\u001b[1B\u001b[2"]
[153.498, "m\u2502\u001b[6G\u001b[22m  # argmax at forced positions after prompt should equal next seq token\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  am = list(map(int, r[2:]))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  plen = len(seq) - len(pr['ids'])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  if am[plen-1:-1] != pr['ids'][:len(am)-plen]: bad += 1; print('FIXED argmax mismatch')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  print('stop policy fixture:', pr['stop'])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('byte piece:', ask('PIECE 5 13'), ask('PIECE\u001b[55G1\u001b[57G3'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('empty gen:', ask('GENERATE\u001b[38G0\u001b[40Ghi'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('GENERATE\u001b[28G3\u001b[30G\\n');\u001b[36Gp.stdin.flush();\u001b[53Gprint('empty\u001b[66Gprompt:',\u001b[76G[rd()\u001b[82Gfor\u001b[86G_\u001b[88Gin\u001b[91Grange(4)])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('GENERATE 2000\u001b[33GOnce\u001b[38Gupon\u001b[43Ga\u001b[45Gtime\\n');\u001b[55Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mlines = []\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwhile True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22ms\u001b[10G=\u001b[12Grd();\u001b[18Glines.append(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     if s.startswith('DONE'):\u001b[33Gbreak\r\u001b"]
