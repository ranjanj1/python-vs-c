[259.845, "t = p;        p += L * C.dim;\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m 73 \u001b[22m     W.wq = p;                    p += L * C.dim * (C.n_heads * head_size);\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Rebuilding\u001b[14Gand rerunning\u001b[28Gall checks\u001b[38;2;102;102;102m \u00b7 2s\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ clang -O2 -Wall -Wextra -o cb cb.c -framework Accelerate 2>&1 && python3 check.py --tokens 64 --prompts 3 -- ./cb\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m&& python3 check.py -- ./cb | tail -1 && python3 /tmp/cbtest/extra.py \"$PWD\" | tail -4\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;226;130;98mBeboppin'\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(4m 4s \u00b7 \u2193\u001b[25G17.0k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
