[259.842, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe context stop is right, since 691 prompt tokens give 334\u001b[63Gnew\u001b[67Gones\u001b[72Gat\u001b[75Gabout\u001b[81G66\u001b[84Gtok/s.\u001b[91GThe\u001b[95Gweights\u001b[103Gstart\u001b[109G28\u001b[112Gbytes\r\u001b[2C\u001b[1Binto the mmap and aren't 16-byte aligned, so I'm\u001b[52Gcopying\u001b[60Gthem\u001b[65Ginto\u001b[70Gan\u001b[73Galigned\u001b[81Gbuffer\u001b[88Gto\u001b[91Gtest\u001b[96Gwhether\u001b[104GBLAS\u001b[109Gspeeds\u001b[116Gup.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe aligned copy is about 10% faster and avoids page faults on the first command, so I'm adding it to \u001b[38;2;87;105;247mcb.c\u001b[39m.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(cb.c)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m8\u001b[22m lines, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 60 \u001b[22m     kv_dim = (C.dim * C.n_kv_heads) / C.n_heads;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 61 \u001b[22m     kv_mul = C.n_heads / C.n_kv_heads;\u001b["]
[259.843, "39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 62 \u001b[22m     \u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m L = (\u001b[38;2;0;134;179munsigned\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mlong\u001b[38;2;51;51;51m)C.n_layers;\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 63 -\u001b[38;2;51;51;51m    float *p = data + sizeof(Config) / sizeof(float);                                                  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 63 +\u001b[38;2;51;51;51m    \u001b[38;2;150;152;150m/* Copy the float32 weights (unchanged) into a page-aligned buffer: the file\u001b[38;2;51;51;51m                       \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 64 +\u001b[38;2;51;51;51m     * places them at byte offset \u001b[38;2;0;134;179m28\u001b[38;2;51;51;51m, and aligned rows measured ~\u001b[38;2;0;134;179m10\u001b[38;2;51;51;51m% faster in sgemv. */               \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 65 +\u001b[38;2;51;51;51m    \u001b[38;2;0;134;179msize_t\u001b[38;2;51;51;51m nfl = ((\u001b[38;2;0;134;179msize_t\u001b[38"]
