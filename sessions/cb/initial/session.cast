[262.871, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcontext\u001b[15Gstop\u001b[20Gis\u001b[23Gright,\u001b[30Gsince\u001b[36G691\u001b[40Gprompt\u001b[47Gtokens\u001b[54Ggive\u001b[59G334\u001b[63Gnew\u001b[67Gones\u001b[72Gat\u001b[75Gabout\u001b[81G66\u001b[84Gtok/s.\u001b[91GThe\u001b[95Gweights\u001b[103Gstart\u001b[109G28\u001b[112Gbytes\r\u001b[1B \u001b[3Ginto the mmap and aren't 16-byt\u001b[36Galigned, so I'm copying them into an aligned\u001b[81Gbuffer to\u001b[91Gtest whether BLAS\u001b[109Gspeeds up.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Galigned\u001b[15Gcopy\u001b[20Gis\u001b[23Gabout\u001b[29G10%\u001b[33Gfaster\u001b[40Gand\u001b[44Gavoids\u001b[51Gpage\u001b[56Gfaults\u001b[63Gon\u001b[66Gthe\u001b[70Gfirst\u001b[76Gcommand,\u001b[85Gso\u001b[88GI'm\u001b[92Gadding\u001b[99Git\u001b[102Gto\u001b[105G\u001b[38;2;87;105;247mcb.c\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(cb.c)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m8\u001b[22m lines,\u001b[21Gremoved\u001b[29G\u001b[1m1\u001b[31G\u001b[22mline\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 60 \u001b[22m     kv_dim = (C.dim * C.n_kv_heads) / C.n_heads;\r\u001b[7C\u001b[1B\u001b[2m1\u001b[18G\u001b[22mmul\u001b[24GC.n_heads / C.n\u001b[40Gkv_heads;\u001b["]
