[247.873, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m3\u001b[13G\u001b[22mreference matmul; everything \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m follows the reference loops. Single sequence,\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m * batch size \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, greedy decoding, \u001b[38;2;0;134;179mstdin\u001b[38;2;51;51;51m/\u001b[38;2;0;134;179mstdout\u001b[38;2;51;51;51m protocol from INTERFACE.md. */\r\u001b[7C\u001b[1B\u001b[2m5\u001b[11G\u001b[22m\u001b[38;2;167;29;93mdefine\u001b[38;2;150;152;150m ACCELERATE_NEW_LAPACK\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[20G\u001b[22m\u001b[38;2;24;54;145mA\u001b[22Gce\u001b[25Gerate/Accelerate.h>\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[20G\u001b[22m\u001b[38;2;24;54;145mfcntl.h>\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[20G\u001b[22m\u001b[38;2;24;54;145mmath.h>\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 9\u001b[24G\u001b[22m\u001b[38;2;24;54;145mnt.h>\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +437 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m"]
[247.874, "B\u001b[5Gth the quick\u001b[18Gcheck a\u001b[26Gd\u001b[28Gthe full check pass, with errors well under tolerance. Next\u001b[88GI'm\u001b[92Gtesting\u001b[100Gthe\u001b[104Gcommands\u001b[113Gcheck.py\r\u001b[2C\u001b[1Bdoesn't\u001b[11Gcover,\u001b[18Gincluding\u001b[28GPIECE,\u001b[35GFIXED,\u001b[42Gan\u001b[45Gempty\u001b[51Gprompt,\u001b[59Gthe\u001b[63Gcontext\u001b[71Glimit,\u001b[78Gand\u001b[82GQUIT.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll fixture outputs, argmaxes, by\u001b[37Ge tokens, \u001b[48Gnd the\u001b[55Gstop\u001b[60Gand\u001b[64Gquit\u001b[69Gbehaviour\u001b[79Gcheck\u001b[85Gout.\u001b[90GI'm\u001b[94Gnext\u001b[99Gtesting\u001b[107Gthe\u001b[111Gcontext\r\u001b[2C\u001b[1Bstop\u001b[8Gat\u001b[11Gseq_len\u001b[19Gand\u001b[23Gtiming\u001b[30Ga\u001b[32G256-token\u001b[42Ggeneration.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe context stop is right, sinc\u001b[36G691 prompt tokens give 334 new ones at about\u001b[81G66 tok/s.\u001b[91GThe weights start\u001b[109G28 bytes\u001b[K\r\u001b[2C\u001b[1Binto\u001b[8Gthe\u001b[12Gmmap\u001b[17Gand\u001b[21Garen't\u001b[28G16-byte\u001b[36Galigned,\u001b[45Gso\u001b[48GI'm\u001b[52Gcopying\u001b[60Gthem\u001b[65Gi"]
