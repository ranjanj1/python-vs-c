[343.937, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u273b\u001b[4G\u001b[38;2;245;149;117mr\u001b[7G\u001b[38;2;215;119;87ms\u001b[46G\u001b[38;2;181;181;181mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
