[47.713, "\u001b[H\r\u001b[8C\u001b[33B\u001b[38;2;245;149;117mo\u001b[12G\u001b[38;2;215;119;87mi\u001b[43G\u001b[38;2;173;173;173mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
