[168.151, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll\u001b[8Gcontinue,\u001b[18Gbut\u001b[22Gwith\u001b[27Glighter\u001b[35Gbenchmarks:\u001b[47Gat\u001b[50Gmost\u001b[55Gtwo\u001b[59Gprocesses\u001b[69Gat\u001b[72Ga\u001b[74Gtime\u001b[79Gand\u001b[83Gfewer\u001b[89Grounds.\u001b[97GCurrent\u001b[105Gstate:\u001b[112Gthe\r\u001b[2C\u001b[1Baccess-ordered weight\u001b[25Glayout\u001b[32Gand\u001b[36G\u001b[38;2;87;105;247mpread\u001b[42G\u001b[39mloading\u001b[50Gare\u001b[54Gclear\u001b[60Gwins.\u001b[66GThe\u001b[70GKV-cache\u001b[79Glayout\u001b[86Gchanges\u001b[94Gare\u001b[98Gnot:\u001b[103Gon\u001b[106Gthe\u001b[110Gshort\r\u001b[2C\u001b[1Bdevelopment\u001b[15Gworkloads\u001b[25Gthey\u001b[30Gmeasured\u001b[39G1\u20131.4\u001b[45Gms\u001b[48Gslower\u001b[55Gper\u001b[59Gforward,\u001b[68Gand\u001b[72Gat\u001b[75G1024\u001b[80Gpositions\u001b[90Gthey\u001b[95Gwere\u001b[100Gwithin\u001b[107Gnoise.\u001b[114GI'll\r\u001b[1B \u001b[3Grever\u001b[9G the KV c\u001b[19Gche to the \u001b[31Geference l\u001b[42Gy\u001b[47Gand keep the re\u001b[63Gt.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The checks pass. Now one bit-exactness comparison\u001b[53Gwith\u001b[58Gthe\u001b[62Gpre-KV\u001b[69Gbuild\u001b[75Gat\u001b[78G1024\u001b[83Gpositions,\u001b[94Gthen\u001b[99Ga\u001b[101Gfinal\u001b[107"]
[168.152, "Gtwo-process\r\u001b[2C\u001b[1Bbenchmark\u001b[13Gof\u001b[16Gthe\u001b[20Goriginal\u001b[29Gbuild\u001b[35Gagainst\u001b[43Gthe\u001b[47Gfinal\u001b[53Gone.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfinal\u001b[13Gbuild\u001b[19Gand\u001b[23Gthe\u001b[27Goriginal\u001b[36Gmmap\u001b[41Gbuild\u001b[47Gnow\u001b[51Gcome\u001b[56Gout\u001b[60Gabout\u001b[66Gequal,\u001b[73Gcontradicting\u001b[87Gthe\u001b[91Gearlier\u001b[99G13.3\u001b[104Gvs\u001b[107G16.5\u001b[112Gms\r\u001b[1B \u001b[3Gresult, so I suspect load or launch-order bi\u001b[48Gs\u001b[50Gin my harness. I'm\u001b[69Grunning a\u001b[79Gquick check: the same binary against\r\u001b[2C\u001b[1Bits\u001b[7Glf, th\u001b[14Gn the pair\u001b[25Gin reversed order.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mR\u001b[8Gse-order\u001b[17GA/B and sequential work\u001b[41Goad runs\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ VECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/ab.py \"$PWD\" 6 ./cb /tmp/cbtest/v_mmap; uptime; \r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mVECLIB_MAXIMUM_THREADS=1 python3 /tmp/cbtest/work.py \"$PWD\" /tmp/cbtest/v_mmap 2; VECLIB_MAXIMUM_THREADS=1 python3 \r\u001b[5C\u001b[1B/tmp/cbtest/work.py \"$PWD\" "]
