[279.466, "m      \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'll continu\u001b[16G,\u001b[18Gbut with lighter benchmarks: at\u001b[50Gmost two processes at a tim\u001b[79Gand fewer rounds. Current s\u001b[107Gate: the\r\u001b[2C\u001b[1Bacc\u001b[7Gss-ordered weight\u001b[25Glayout \u001b[33Gnd \u001b[38;2;87;105;247mpread\u001b[39m loading ar\u001b[53G cl\u001b[57Gar wins. The KV-cache layou\u001b[85G changes ar\u001b[97G not: on the \u001b[111Ghort\u001b[K\r\u001b[2C\u001b[1Bd\u001b[7Glopment workloads they\u001b[30Gm\u001b[32Gasured 1\u20131.4 ms slow\u001b[53Gr per forward,\u001b[68Gand\u001b[72Gat\u001b[75G1024\u001b[80Gpositions\u001b[90Gthey\u001b[95Gwere\u001b[100Gwithin\u001b[107Gnoise.\u001b[114GI'll\r\u001b[2C\u001b[1Brevert\u001b[10Gthe\u001b[14GKV\u001b[17Gcache\u001b[23Gto\u001b[26Gthe\u001b[30Greference\u001b[40Glayout\u001b[47Gand\u001b[51Gkeep\u001b[56Gthe\u001b[60Grest.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe chec\u001b[12Gs pass.\u001b[20GNow o\u001b[26Ge bit-exactnes\u001b[41G compar\u001b[49Gson\u001b[53Gwith\u001b[58Gthe\u001b[62Gpre-KV\u001b[69Gbuild\u001b[75Gat\u001b[78G1024\u001b[83Gpositions,\u001b[94Gthen\u001b[99Ga\u001b[101Gfinal\u001b[107Gtwo-process\r\u001b[2C\u001b[1Bbenchmark\u001b[13Gof\u001b[16Gthe\u001b[20Goriginal\u001b[29Gbuil"]
