[321.764, "lopment workloads\u001b[25Gthey me\u001b[33Gsured 1\u20131.4 ms slow\u001b[53Gr p\u001b[57Gr forward, and at 1024 posi\u001b[85Gions they w\u001b[97Gre within noi\u001b[111Ge. I'll\r\u001b[2C\u001b[1Br\u001b[7Grt the KV cache to the\u001b[30Gr\u001b[32Gference layout and k\u001b[53Gep the rest.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gchecks\u001b[14Gpass.\u001b[20GNow\u001b[24Gone\u001b[28Gbit-exactness\u001b[42Gcomparison\u001b[53Gwith\u001b[58Gthe\u001b[62Gpre-KV\u001b[69Gbuild\u001b[75Gat\u001b[78G1024\u001b[83Gpositions,\u001b[94Gthen\u001b[99Ga\u001b[101Gfinal\u001b[107Gtwo-process\r\u001b[1B \u001b[3Gbenchmar\u001b[12G of the\u001b[20Gorigi\u001b[26Gal build again\u001b[41Gt the f\u001b[49Gnal\u001b[53Gone.\u001b[58G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfinal\u001b[13Gbuild\u001b[19Gand\u001b[23Gthe\u001b[27Goriginal\u001b[36Gmmap\u001b[41Gbuild\u001b[47Gnow\u001b[51Gcome\u001b[56Gout\u001b[60Gabout\u001b[66Gequal,\u001b[73Gcontradicting\u001b[87Gthe\u001b[91Gearlier\u001b[99G13.3\u001b[104Gvs\u001b[107G16.5\u001b[112Gms\r\u001b[1B \u001b[3Gresult, so I suspect load or l\u001b[34Gunch-order bias in \u001b[54Gy\u001b["]
[321.765, "56Gharness. I'm running a quick check: the same binary again\u001b[114Gt\r\u001b[2C\u001b[1Bit\u001b[6Ge\u001b[8Gf\u001b[11Gthen\u001b[16Gthe pair in reversed order.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoad\u001b[8Gspiked\u001b[15Gto\u001b[18G15\u001b[21Gduring\u001b[28Gthe\u001b[32Gruns,\u001b[38Gso\u001b[41GI'm\u001b[45Gdiscounting\u001b[57Gthe\u001b[61Gnoisy\u001b[67Gones.\u001b[73GThe\u001b[77Gaccess-ordered\u001b[92Glayout\u001b[99Gwon\u001b[103Gor\u001b[106Gtied\u001b[111Gthe\r\u001b[1B \u001b[3Ginterleav\u001b[15Gc\u001b[17Gmparisons (median gain 0.2\u20133 m\u001b[48G per forward), and\u001b[67Gsequential run\u001b[82G show 70 versus 61 forwards/s; I'm\r\u001b[2C\u001b[1Bstopping \u001b[13Gxperiment\u001b[23G here to write up the re\u001b[48Gults.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mReading\u001b[11GNOTES.md\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102m \u23bf  NOTES.md\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;171;43;63m\u273d\u001b[3GTransmogrifying\u2026 \u001b[38;2;102;102;102m(5m 16s \u00b7 \u2193\u001b[32G4.0k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a qu\u001b[32Gck\u001b[35Gside question without inter\u001b[63Gupting Claude's current work\u001b[39m\u001b[40;1H\u001b[38;3H"]
