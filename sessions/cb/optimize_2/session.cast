[168.154, "\u001b[15GMUM_THREADS=1\u001b[29Gpython3 /tmp/cbtest/ab.py \"$PWD\" 6 ./cb\u001b[69G/tmp/cbtest/v_mmap; uptim\u001b[95G;\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m VECLIB_MAXIMUM_THREADS=1 python3\u001b[37G/tmp/cbtest/work.py\u001b[57G\"$PWD\"\u001b[64G/tmp/cbtest/v_mmap\u001b[83G2;\u001b[86GVECLIB_MAXIMUM_THREADS=1\u001b[111Gpython3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m/tmp/cbtest/work.py\u001b[24G\"$PWD\"\u001b[31G./cb\u001b[36G2\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mQuoted\u001b[9Gtext\u001b[14Gin\u001b[17Gthis\u001b[22Gcommand\u001b[30Gcan't\u001b[36Gbe\u001b[39Gchecked\u001b[47Gbefore\u001b[54Git\u001b[57Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;"]
