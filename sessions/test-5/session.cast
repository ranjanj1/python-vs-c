[15.965, "\u001b]0;\u2733 Sum.c sum of 1 to 100\u0007"]
[15.968, "\u001b[?25l\u001b[H\r\u001b[21B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI\u001b[5Gwrote\u001b[11G\u001b[38;2;87;105;247msum.c\u001b[39m,\u001b[18Gcompiled\u001b[27Git\u001b[30Gwith\u001b[35Gclang\u001b[41G(\u001b[38;2;87;105;247m-Wall\u001b[39m,\u001b[49Gno\u001b[52Gwarnings)\u001b[62Gand\u001b[66Gran\u001b[70Git.\u001b[74GIt\u001b[77Gprints\u001b[84G\u001b[1m5050\u001b[22m,\u001b[90Gwhich\u001b[96Gis\u001b[99Gthe\u001b[103Gcorrect\u001b[111Gsum\u001b[115Gof\u001b[118G1\r\u001b[2C\u001b[1Bto\u001b[6G100.\u001b[11GThe\u001b[15Gcompiled\u001b[24Gprogram\u001b[32Gis\u001b[35G\u001b[38;2;87;105;247msum\u001b[39m,\u001b[40Gin\u001b[43Gthe\u001b[47Gsame\u001b[52Gdirectory.\r\u001b[2B\u001b[38;2;102;102;102m\u273b\u001b[3GCooked for 8s \u00b7 done 10:14 AM\r\u001b[8B\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[38C\u001b[2B\u001b[K\u001b[40;1H\u001b[38;3H\u001b[?25h"]
