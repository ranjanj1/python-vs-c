[10.84, "\u001b[?25l\u001b[H\r\u001b[8B\u001b[38;2;44;122;57m\u23fa\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m10\u001b[15G\u001b[22mlines\u001b[21Gto\u001b[24G\u001b[1msum.c\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#\u001b[38;2;167;29;93minclude\u001b[38;2;150;152;150m \u001b[38;2;24;54;145m<stdio.h>\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \r\u001b[5C\u001b[1B  3 \u001b[22m\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mmain\u001b[38;2;0;134;179m(void)\u001b[38;2;51;51;51m {\r\u001b[5C\u001b[1B\u001b[2m  4 \u001b[22m    \u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m sum = \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m;\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m    \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m (\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m i = \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m; i <= \u001b[38;2;0;134;179m100\u001b[38;2;51;51;51m; i++) {\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m        sum += i;\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22m    }\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m    \u001b[38;2;0;134;179mprintf\u001b[38;2;51;51;51m(\u001b[38;2;24;54;145m\"%d\\n\"\u001b[38;2;51;51;51m, sum);\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m    \u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m;\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m}\u001b[39m\u001b[40;1H\u001b[38;3H\u001b["]
