[550.784, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSession\u001b[11Gtime\u001b[16Gdropped\u001b[24Gfrom\u001b[29G7.5\u001b[33Gs\u001b[35Gto\u001b[38G5.3\u001b[42Gs\u001b[44Gand\u001b[48Ggeneration\u001b[59Gruns\u001b[64Gat\u001b[67Gabout\u001b[73G99\u2013108\u001b[80Gtok/s,\u001b[87Gbut\u001b[91Gstartup\u001b[99Gweight\u001b[106Gprep\u001b[111Grose\u001b[116Gfrom\r\u001b[1B \u001b[3G~0.35 to 0.78 s because the new\u001b[36Giling\u001b[42Gcopy is slower. I'm benchmarking copy-l\u001b[82Gop variants next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcopy\u001b[12Gkernel\u001b[19Gaccounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mtile_into\u001b[13G\u001b[39mtakes\u001b[19G0.76\u001b[24Gs\u001b[26Gon\u001b[29Gthe\u001b[33Greal\u001b[38Gweights,\u001b[47Gversus\u001b[54Gabout\u001b[60G0.15\u001b[65Gs\u001b[67Gpredicted,\u001b[78Gbecause\u001b[86Gthe\u001b[90Gmachine\u001b[98Gis\u001b[101Gshort\u001b[107Gon\u001b[110Gmemory\u001b[117Gwith\r\u001b[1B \u001b[3Gheavy compression\u001b[21G"]
[550.785, " I'm\u001b[26Gcomparing old and new loading back to back next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading\u001b[11Gtakes\u001b[17Gabout\u001b[23Gthe\u001b[27Gsame\u001b[32Gtime\u001b[37Gin\u001b[40Gboth\u001b[45Gversions\u001b[54Gwithin\u001b[61Gone\u001b[65Gprocess,\u001b[74Gso\u001b[77Gthe\u001b[81Gextra\u001b[87Gcost\u001b[92Gcomes\u001b[98Gfrom\u001b[103Gfirst-touch\u001b[115Gpage\r\u001b[1B \u001b[3Gfaults in fresh processe\u001b[28G under memory pressure. I'm now c\u001b[62Gmparing the\u001b[74Gtwo v\u001b[80Grsions\u001b[87Gin fresh processes, and\u001b[K\r\u001b[2C\u001b[1Bmemory-mapping the \u001b[23Gheckpoi\u001b[31Gt is a wa\u001b[42Gto avoid the 438 MB of fresh anonymous memory.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmemmap\u001b[14Gsource\u001b[21Gwins\u001b[26Gin\u001b[29Gfresh\u001b[35Gprocesses\u001b[45G(about\u001b[52G0.40\u001b[57Gs\u001b[59Gversus\u001b[66G0.48\u20130.80\u001b[76Gs),\u001b[80Gso\u001b[83GI'm\u001b[87Gswitching\u001b[97Gto\u001b[100Git\u001b[103Gand\u001b[107Gusing\u001b[113Gthe\r\u001b[1B \u001b[3Gfaster branch-fr\u001b[20Ge 16\u00d716 copy for full tiles, with a generic path for any pad"]
