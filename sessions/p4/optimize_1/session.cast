[349.67, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[6G\u001b[22m      self.x = np.zeros(dim,\u001b[35GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      self.xb = np.zeros(nq\u001b[34G*\u001b[36GT,\u001b[39GF32)\u001b[50G#\u001b[52Gpadded\u001b[59Gto\u001b[62Gwhole\u001b[68Gtiles\u001b[74G(outputs\u001b[83Gof\u001b[86Gwo\u001b[89G/\u001b[91Gw2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      self.xb2 = np.zeros(nq\u001b[35G*\u001b[37GT,\u001b[40GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      self.qkv = np.zeros((nq\u001b[36G+\u001b[38G2\u001b[40G*\u001b[42Gnk)\u001b[46G*\u001b[48GT,\u001b[51GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      self.h13\u001b[21G=\u001b[23Gnp.zeros(2\u001b[34G*\u001b[36Gnh\u001b[39G*\u001b[41GT,\u001b[44GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mself.att\u001b[21G=\u001b[23Gnp.zeros((n_heads,\u001b[42Gseq_len),\u001b[52GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         self.logits_buf\u001b[28G=\u001b[30Gnp.zeros(nv\u001b[42G*\u001b[44GT,\u001b[47GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mself.logits\u001b[24G=\u001b[26Gself.logits_buf[:vocab]\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     self.rope_c = np.z\u001b[31Gros(dim //\u001b[42G2,\u001b[45GF32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G  self.rope_s = np.zeros(dim // 2, F32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[22m     def reset(self):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22m#\u001b[14Gclean\u001b[20GKV\u001b[23Gcache\u001b[29Gfor\u001b[33Gevery\u001b[39G"]
[349.671, "command\u001b[47G(positions\u001b[58Grestart\u001b[66Gat\u001b[69G0)\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G  self.key_cach\u001b[26G.fill(0)\u001b[35G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G  self.v\u001b[19Glue_c\u001b[25Gche.fill(0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[22m     def forward(self,\u001b[26Gtoken,\u001b[33Gpos):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mforward(token,\u001b[27Gpos,\u001b[32Gself.emb,\u001b[42Gself.rms_att,\u001b[56Gself.wqkv,\u001b[67Gself.wo,\u001b[76Gself.rms_ffn,\u001b[90Gself.w13,\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G     \u001b[16G  \u001b[19G self.w2, self.rms_final,\u001b[45Gself.wcls, s\u001b[58Glf.key_cache, self.value_cache,\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12G    \u001b[17G   self.x, self.xb[:se\u001b[40Gf.dim],\u001b[48Gself.xb2[:self.\u001b[64Gim],\u001b[69Gself.qkv, self.h13, self.att,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mself.logits_buf,\u001b[37Gself.rope_c,\u001b[50Gself.rope_s,\u001b[63Gself.n_heads,\u001b[77Gself.n_kv_heads,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 self.kv_dim,\u001b[33Gself.k_off,\u001b[45Gself.v_off,\u001b[57Gself.hidden_dim,\u001b[74Gself.h3_off)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gself.logits\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[8G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 -\u001b[14G<<'EOF'\u001b[K"]
[349.672, "\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s = open('run.py').re\u001b[26Gd()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mi\u001b[6G=\u001b[8Gs.index('#\u001b[19G----------------------------------------------------------------------------\\n#\u001b[99Gtokenizer')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m open('run.py', 'w').write(open('/tmp/p4_head.py').read()\u001b[61G+\u001b[63G'\\n\\n'\u001b[70G+\u001b[72Gs[i:])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m py\u001b[7Ghon3 -c\u001b[15G\"import ast;\u001b[28Gst.parse(open('run\u001b[47Gpy').read())\" && grep -n\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"argmax(model.logits)\\|model.logits\\|allv\\[pos\\]\"\u001b[54Grun.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gaborted\u001b[17G(timeout,\u001b[27Gresource\u001b[36Glimit,\u001b[43Gor\u001b[46Gover-length)\r\u001b[1B\u001b[K\r\u001b[1B Do yo"]
