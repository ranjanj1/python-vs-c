[366.51, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gcheck.py\u001b[21G--tokens\u001b[30G64\u001b[33G--prompts\u001b[43G3\u001b[45G--\u001b[48Gpython3\u001b[56Grun.py\u001b[63G&&\u001b[66Gcat\u001b[70G>\u001b[72Gscratch/ab.py\u001b[86G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\"\"A/B:\u001b[12Gscratch/run_v1.py\u001b[30G(before)\u001b[39Gvs\u001b[42Grun.py\u001b[49G(after)\u001b[57Gon\u001b[60Gthe\u001b[64Gdev\u001b[68Gsequences:\u001b[79Gbitwise\u001b[87Glogits\u001b[94G+\u001b[96Ginterleaved\u001b[108Gtiming.\"\"\"\r\u001b[1B \u001b[2m\u2502\u001b[22m import os, sys, time, sta\u001b[30Gistics, json, importlib.util\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import numpy\u001b[17Gas np\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mROOT\u001b[9G=\u001b[11Gos.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m sys.path.insert(0, ROOT);\u001b[30Gos.chdir(ROOT)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gload(name,\u001b[19Gpath):\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8Gspec = importlib.util.spec_from_file_location(name, path); mod\u001b[71G= importlib.util.module_fr\u001b[98Gm_spec(spec);\u001b[112G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m spec.loader.exec_module(mod); return\u001b[41Gmod\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m old = load('run_v1', os.path.join(ROOT,\u001b[44G'scratch', 'run_v1.py'))\u001b[K\r\u001b[1C\u001b[1B\u001b[2"]
[366.512, "m\u2502\u001b[4G\u001b[22mnew\u001b[8G=\u001b[10Gload('run',\u001b[22Gos.path.join(ROOT,\u001b[41G'run.py'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m fx = json.load(open('fixtures.json'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmo\u001b[7G=\u001b[9Gold.Model('model.bin');\u001b[33Gmn\u001b[36G=\u001b[38Gnew.Model('model.bin')\r\u001b[1B \u001b[2m\u2502\u001b[22m def seqrun(m, seq):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mm.reset();\u001b[19Gout\u001b[23G=\u001b[25Gnp.empty((len(seq),\u001b[45Gm.vocab),\u001b[55Gnp.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for p, t\u001b[17Gin\u001b[20Genumerate(seq):\u001b[36Gout[p]\u001b[43G=\u001b[45Gm.forward(t,\u001b[58Gp)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15Gout\r\u001b[1B \u001b[2m\u2502\u001b[22m for k,\u001b[11Gpr in enumer\u001b[24Gte(fx['prompts\u001b[39G]):\u001b[43G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8Ga = seqr\u001b[17Gn(mo,\u001b[23Gpr['seq']); b = seqrun(mn,\u001b[50Gpr['seq'])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint(f'prompt\u001b[23G{k}:\u001b[28G{len(pr[\"seq\"])}\u001b[45Gpositions,\u001b[56Glogits\u001b[63Gbitwise\u001b[71Gidentical:\u001b[82G{np.array_equal(a,\u001b[101Gb)}\u001b[106Gmax|diff|\r\u001b[1B \u001b[2m\u2502\u001b[22m {float(np\u001b[14Gabs(a-b).max()):.3g}')\r\u001b[1B \u001b[2m\u2502\u001b[22m seq = fx['prompts'][2]['seq']\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mR\u001b[6G= {'before': [], 'after': []}\u001b["]
[366.513, "K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor _ in range(int(sys.argv[1]) if len(sys.argv) > 1 else 6):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for name, m in (('before', mo), ('after', mn)):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      t = time.perf_counter(); seqrun(m, seq); R[name].append((time.perf_counter() - t) / len(seq))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor k, v in R.items():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  print(f'{k:7s} median {statistics.median(v)*1e3:.3f} ms/token  min {min(v)*1e3:.3f}')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f'speedup (median) {statistics.median(R[\"before\"]) / statistics.median(R[\"after\"]):.3f}x')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gscratch/ab.py\u001b[26G8\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[366.514, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
