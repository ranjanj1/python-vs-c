[360.11, "\u001b[H\r\u001b[2C\u001b[1BFusing \u001b[11Gurned\u001b[17Gout slower, while tiling\u001b[42Gthe classifier\u001b[57Ghelped (a\u001b[68Gut\u001b[71G1.9 ms\u001b[78Gversus 2.2 ms), so I'm \u001b[102Gesting column\r\u001b[2C\u001b[1Btiling\u001b[10Gon the\u001b[17Glayer matrices next.\u001b[K\r\u001b[2C\u001b[4BColumn\u001b[11Giles of 128\u2013256 hit abou\u001b[36G 60 GB/s on every layer shape, beating\u001b[75Gthe 56 GB/s probe with bitwi\u001b[104Ge-identical\r\u001b[2C\u001b[1Bresults. Next\u001b[17GI'm checking the unroll\u001b[41Gfactor\u001b[48Ginside\u001b[55Gtiles\u001b[61Gand\u001b[65Gthe\u001b[69Gclassifier\u001b[80Gat\u001b[83GT=256.\r\u001b[2C\u001b[4BWith T=128 and a 4-row unroll, every\u001b[40Gmatrix now hits about 62 GB/s, so I'm moving the design to column tiles built\u001b[118Gat\r\u001b[2C\u001b[1Bload \u001b[9Gime, fusing\u001b[21Gt\u001b[24G q/k/v and w1/w3\u001b[41Gc\u001b[43Glls,\u001b[48Gprecomputing\u001b[61GRoPE p\u001b[68Gr po\u001b[73Gition,\u001b[81Gnd unrolling\u001b[94Gattention\u001b[104G2\u00d7.\u001b[108GI'll\u001b[113Gkeep\u001b[118Gthe\r\u001b[2C\u001b[1Bcurrent\u001b[11Gversion\u001b[19Gas\u001b[22Gscratch/run_v1.py\u001b[40Gfor\u001b[44GA/B\u001b[48Gtesting\u001b[56Gand\u001b[60Grewrite\u001b[68Grun.py.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa"]
