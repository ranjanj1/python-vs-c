[60.33, "\u001b[H\u001b[2G   the reference's encoding and decoding rules.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[1mLimitations (details in NOTES.md)\r\u001b[1C\u001b[1B\u001b[22m - The transposed copy of the weights takes about 1 GB of memory at peak during\u001b[82Gloading.\u001b[91GThat\u001b[96Gincludes\u001b[105Gan\u001b[108Gextra\u001b[114G98\u001b[117GMB\r\u001b[1C\u001b[1B   for the classifier,\u001b[25Gwhich\u001b[31Gshares\u001b[38Gits\u001b[42Gweights\u001b[50Gwith\u001b[55Gthe\u001b[59Gembedding\u001b[69Gtable.\r\u001b[1C\u001b[1B - Numba's compile cache is written\u001b[38Gto\u001b[41G\u001b[38;2;87;105;247m__pycache__/\u001b[54G\u001b[39mnext\u001b[59Gto\u001b[62G\u001b[38;2;87;105;247mrun.py\u001b[39m.\u001b[70GWithout\u001b[78Git,\u001b[82Gstartup\u001b[90Gcompiles\u001b[99Gfor\u001b[103Ga\u001b[105Gfew\u001b[109Gseconds.\r\u001b[1C\u001b[1B - These protocol cases aren't defined in INTERFACE.md,\u001b[58Gso\u001b[61GI\u001b[63Gchose:\r\u001b[1C\u001b[1B   - an empty piece prints \u001b[38;2;87;105;247mHEX \u001b[39m (trailing space,\u001b[51Gno\u001b[54Gbytes);\r\u001b[1C\u001b[1B   - FIXED or LOGITS with more than \u001b[38;2;87;105;247mseq_len\u001b[46G\u001b[39mids\u001b[50Gprocesses\u001b[60Gonly\u001b[65Gthe\u001b[69Gfirst\u001b[75G\u001b[38;2;87;105;247mseq_len\u001b[39m;\r\u001b[1C\u001b[1B   - if \u001b[38;2;87;105;247mmax\u001b[39m and \u001b[38;2;87;105;"]
[60.332, "247mcontext\u001b[39m happen on the same token, it reports\u001b[63G\u001b[38;2;87;105;247mmax\u001b[39m;\r\u001b[1C\u001b[1B   - token ids are not range-checked.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B NOTES.md has the commands I ran and these limitations. The benchmark and test helpers\u001b[89GI\u001b[91Gwrote\u001b[97Gare\u001b[101Gin\u001b[104G\u001b[38;2;87;105;247mscratch/\u001b[39m;\u001b[114G\u001b[38;2;87;105;247mrun.py\r\u001b[1C\u001b[1B\u001b[39m doesn't use them. I didn't touch the harness, fixtures or rules.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mWorked for 8m 38s \u00b7 done 3:11 PM\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r"]
[60.333, "\u001b[1C\u001b[1B \u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The fixtures in \u001b[38;2;87;105;247mfixtures.json\u001b[39m are the development workloads, so I'll profile the 9 ENCODE strings and the three\u001b[K\r\u001b[1C\u001b[1B prompts\u001b[11Grun\u001b[15Gas\u001b[18GGENERATE\u001b[27G64\u001b[30Gand\u001b[34GLOGITS\u001b[41Gover\u001b[46G69\u201382\u001b[52Gpositions.\u001b[63GChecking\u001b[72Gthe\u001b[76Gmachine\u001b[84Gfirst.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm profiling on an M1 with 8 GB and a load average near 3,\u001b[63Gso\u001b[66GI'll\u001b[71Grely\u001b[76Gon\u001b[79Gbest-of/median\u001b[94Gtimings.\u001b[103GI'm\u001b[107Gbuilding\u001b[116Gtwo\r\u001b[1C\u001b[1B profiler parts: end-to-end timing of the\u001b[44Gdev\u001b[48Gworkload\u001b[57Gand\u001b[61Ga\u001b[63Gper-phase\u001b[73Gbreakdown\u001b[83Gof\u001b[86Gone\u001b[90Gforward\u001b[98Gpass.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m \u001b[1mWrite\u001b[22m(scratch/profile.py)\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2722\u001b[39m \u001b[38;2;219;123;91mFluttering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(53s \u00b7 \u2193\u001b[39m \u001b"]
