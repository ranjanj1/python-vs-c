[496.787, "\u001b[H\u001b[6G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix-vector work now takes\u001b[32Gabout\u001b[38G91%\u001b[42Gof\u001b[45Gthe\u001b[49Gtime\u001b[54Gat\u001b[57Groughly\u001b[65G57\u001b[68GGB/s,\u001b[74Gwith\u001b[79Gattention\u001b[89Gdown\u001b[94Gto\u001b[97G0.25\u001b[102Gms.\u001b[106GNext\u001b[111GI'll\u001b[116Gtry\u001b[120Ga\r\u001b[2C\u001b[1Bfew more tile shapes and\u001b[28Gunrolls\u001b[36Gon\u001b[39Gthe\u001b[43Glargest\u001b[51Gmatrix.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m sh\u001b[12Gll command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gvariants\u001b[16Gland\u001b[21Gat\u001b[24G56\u201361\u001b[30GGB/s,\u001b[36Gwithin\u001b[43Gnoise\u001b[49Gof\u001b[52Geach\u001b[57Gother,\u001b[64Gso\u001b[67GT=128\u001b[73Gwith\u001b[78Ga\u001b[80G4-row\u001b[86Gunroll\u001b[93Gstays.\u001b[100GThe\u001b[104Gmatrix\u001b[111Gkernels\r\u001b[1B  are at the bandwidth plateau. Next, end-to-end and startup:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Session time dropped from 7.5 s to 5.3 s and generation runs at about 99\u2013108 tok/s, but startup weight prep rose from\u001b[K"]
[496.788, "\r\u001b[1C\u001b[1B ~0.35 to\u001b[12G0.78 s because\u001b[27Gthe\u001b[31Gnew\u001b[35Gtiling\u001b[42Gcopy\u001b[47Gis\u001b[50Gslower.\u001b[58GI'm\u001b[62Gbenchmarking\u001b[75Gcopy-loop\u001b[85Gvariants\u001b[94Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Th\u001b[6G copy kernel\u001b[19Gaccounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Time steps inside model\u001b[27Gloading\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport time, numpy as np, run\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102morig = run.tile_into\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102macc = {'tile_into': 0.0}\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mdef timed(*a):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G \u001b[6G\u001b[38;2;102;102;102mt = time.perf_counter(); r = orig(*a); acc['tile_into'] += time.perf_counter() - t; return r\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mrun.tile_in"]
