[32.812, "\u001b[H\u001b[3G-\u001b[5G\u001b[1mPrecision:\u001b[22m I checke\u001b[26Gthe compiled \u001b[40Gypes and\u001b[49Gthe\u001b[53Ggenerated LLVM\u001b[68Gcode.\u001b[74GEverything\u001b[85Gis\u001b[88Gfloat32,\u001b[97Gwith\u001b[102Gno\u001b[105Gdouble\r\u001b[2C\u001b[1B \u001b[5Garithmetic, no fast-math\u001b[30Gflags and no threads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSame work as \u001b[38;2;87;105;247mrun.c\u001b[39m:\u001b[22m the classifier\u001b[40Gruns at every\u001b[54Gposition,\u001b[64Gincluding\u001b[74Gforced\u001b[81Gprompt\u001b[88Gtokens.\u001b[96GThe\u001b[100Gtokenizer\u001b[110Greproduces\r\u001b[2C\u001b[1B \u001b[5Gthe reference's encoding and decoding rules.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (details in NOTES.md)\r\u001b[2C\u001b[1B\u001b[22m- The transposed copy of the weights\u001b[40Gtakes\u001b[46Gabout\u001b[52G1\u001b[54GGB\u001b[57Gof\u001b[60Gmemory\u001b[67Gat\u001b[70Gpeak\u001b[75Gduring\u001b[82Gloading.\u001b[91GThat\u001b[96Gincludes\u001b[105Gan\u001b[108Gextra\u001b[114G98\u001b[117GMB\r\u001b[2C\u001b[1B \u001b[5Gfor\u001b[10Ghe cla\u001b[17Gsifier,\u001b[25Gwhic\u001b[30G shares its w\u001b[44Gights with the e\u001b[61Gbedding table.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNumba's\u001b[14Gompile cache \u001b[28Gs writt\u001b[36Gn\u001b[38Gto \u001b[38;2;87;105;247m__pycache__/\u001b[39m next\u001b[59Gto \u001b[38;2;87;105;247mrun.py\u001b[39m. Without\u001b[78Git,"]
