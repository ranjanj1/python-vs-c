[740.065, "\u001b[H\u001b[8G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m11\u001b[14G\u001b[38;2;51;51;51mshared\u001b[21Gwith\u001b[26Gthe 98 MB embedding) stay\u001b[52Gresi\u001b[57Gent. Th\u001b[65G checkpoint\u001b[77Gis mapped read-only durin\u001b[103G load.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m12\u001b[14G\u001b[38;2;51;51;51mLoad time depends heavily on\u001b[43GOS memory pressure: the f\u001b[69Grst load in a fresh process after    \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m13\u001b[14G\u001b[38;2;51;51;51mrecompiling or under\u001b[35Gpressure was seen at\u001b[56Gup\u001b[59Gto\u001b[62G~1.6\u001b[67Gs.\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 214 +\u001b[38;2;51;51;51m- **Long contexts**: attention and the KV-cache stores grow with position. They are 3% at the dev     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 215 +\u001b[38;2;51;51;51m  workloads' \u226482 positions, but larger near seq_len = 1024. That range was only exercised by          \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m16\u001b[14G\u001b[38;2;51;51;51m`edge.py\u001b[23G (~10.8 s\u001b[34Gor 1016 forced + 9 new positi\u001b[64Gns), not profiled in det\u001b[89Gil.     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 217 +\u001b[38;2;51;51;51m- **Startup** (~1.3\u20131.6 s): ~0.55 s is importing numpy+numba, "]
[740.065, "~0.4 s is loading and tiling, and       \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 218 +\u001b[38;2;51;51;51m  ~0.1 s is a warm-up forward. There is no further easy cut within the rules.                         \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 219 \u001b[22m - **Numba on-disk cache** (`cache=True`) writes compiled code to `__pycache__/` beside `run.py`.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 220 \u001b[22m   Without it (e.g. a read-only dir with no fallback), the first start compiles for a few seconds.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 221 \u001b[22m   Before `READY`, a single warm-up forward runs and the KV cache is reset afterwards.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 226 \u001b[22m   not range-checked (bounds checks are off in the kernels).\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 227 \u001b[22m - The tokenizer and protocol handling are plain Python (not compute); only the arithmetic is\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 228 \u001b[22m   compiled.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m  91 -\u001b[38;2;51;51;51m- Throughpu"]
[740.066, "t on this machine moved a lot between runs (roughly 62\u2013104 tok/s for the same command),    \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  92 -\u001b[38;2;51;51;51m  apparently from other load, so the speed figures above are rough.                                   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m29\u001b[16G\u001b[38;2;51;51;51mMe\u001b[19Gsurement noise**: the machine was shared a\u001b[62Gd memory-pressured\u001b[81Gthroughout. I\u001b[95Gentical \u001b[104G   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m30\u001b[14G\u001b[38;2;51;51;51mcommands v\u001b[25Gried by \u00b115\u201330% betw\u001b[46Gen\u001b[49Gruns,\u001b[55Gso \u001b[59Gr\u001b[61Gat the\u001b[68Gfigures as\u001b[79Gmedians under\u001b[93Gthat\u001b[98Gload.\r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ rm -rf scratch/__pycache__ && python3 check.py --tokens 64 --prompts 3 -- python3 run.py | tail -1 && ls scratch\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[740.067, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mFinal validation and list scratch files\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mrm -rf scratch/__pycache__ && python3 check.py --tokens 64 --prompts 3 -- python3 run.py | tail -1 && ls scratch\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[740.067, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mrm -rf scratch/__pycache__\u001b[22m and \u001b[1mpython3 check.py --tokens 64 --prompts 3 -- python3 \r\u001b[6C\u001b[1Brun.py\u001b[14G\u001b[22mcommands\u001b[23Gin\u001b[26G\u001b[1m/Users/agentlab/pvc/p4\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
