[762.918, "\u001b[H\u001b[3G  same\u001b[10Gorder as \u001b[38;2;87;105;247mrun.c\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mCombined matrix calls:\u001b[28G\u001b[22mthe\u001b[32Gq/k/v\u001b[38Gmatrices\u001b[47Gand\u001b[51Gthe\u001b[55Gw1/w3\u001b[61Gmatrices\u001b[70Gare\u001b[74Geach\u001b[79Ghandled\u001b[87Gin\u001b[90Gone\u001b[94Gcall\u001b[99Gper\u001b[103Glayer.\r\u001b[2C\u001b[1B- \u001b[1mAtt\u001b[9Gntion:\u001b[16G\u001b[22munrolled\u001b[25Gby\u001b[28Gtwo,\u001b[33Gkeeping\u001b[41Gthe\u001b[45Gsame\u001b[50Gorder\u001b[56Gof\u001b[59Gadditions\u001b[69G(0.44\u001b[75G\u2192\u001b[77G0.25\u001b[82Gms\u001b[85Gper\u001b[89Gtoken).\r\u001b[4C\u001b[1B\u001b[1mRoPE:\u001b[22m the cos/sin valu\u001b[28Gs are computed\u001b[43Gonce per position instead of on\u001b[75Ge per layer.\u001b[88GThe values are bi\u001b[106G-identical.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLoading:\u001b[22m \u001b[15Ghe checkpoint\u001b[29Gis memory-mapped\u001b[46Gand copied \u001b[58Gnto the tiled layout\u001b[79Gwith a faster loop.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults\u001b[22m (medians on a shared, memory-p\u001b[42Gessured M1, so expect \u00b115\u201330% run-to-ru\u001b[82G variati\u001b[92G):\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500"]
[762.919, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[61G\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5G        \u001b[14G   \u001b[18G          \u001b[29G  \u001b[32G      \u2502  Before  \u2502  After  \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Forward pass, ms per tok\u001b[30Gn \u001b[33G     \u2502 8.9\u201310.0 \u2502 7.7\u20138.3 \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 64 tokens/s             \u2502 68\u201390    \u2502 94\u2013114  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Full check-equivalent session    \u2502 7.5 s    \u2502 5.4 s   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c"]
