[547.769, "ession. I'm comparing\u001b[36Gold\u001b[40Gand\u001b[44Gnew\u001b[48Gloading\u001b[56Gback\u001b[61Gto\u001b[64Gback\u001b[69Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Loading takes about the same time in both versions\u001b[54Gwithin one process, so the extra\u001b[87Gcost\u001b[92Gcomes\u001b[98Gfrom\u001b[103Gfirst-touch\u001b[115Gpage\r\u001b[1C\u001b[1B faults\u001b[10Gin fre\u001b[17Gh processes under memory pressure.\u001b[52GI'm\u001b[56Gnow\u001b[60Gcomparing\u001b[70Gthe\u001b[74Gtwo\u001b[78Gversions\u001b[87Gin\u001b[90Gfresh\u001b[96Gprocesses,\u001b[107Gand\r\u001b[1C\u001b[1B memory-mapping the checkpoi\u001b[31Gt is a\u001b[38Gway to\u001b[45Gavoid\u001b[51Gthe\u001b[55G438\u001b[59GMB\u001b[62Gof\u001b[65Gfresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gmemmap\u001b[14Gsou\u001b[18Gce wins in f\u001b[31Gesh proc\u001b[40Gsses (\u001b[47Gbout\u001b[52G0.40\u001b[57Gs\u001b[59Gversus\u001b[66G0.48\u20130.80\u001b[76Gs),\u001b[80Gso\u001b[83GI'm\u001b[87Gswitching\u001b[97Gto\u001b[100Git\u001b[103Gand\u001b[107Gusing\u001b[113Gthe\r\u001b[1C\u001b[1B faster\u001b[10Gbr\u001b[13Gn\u001b[15Gh-free 16\u00d716\u001b[28Gcopy\u001b[33G"]
