[441.274, "\u001b[38;2;51;51;51m.n_heads, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.n_kv_heads,\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 379 \u001b[22m                 \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.kv_dim, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.k_off, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.v_off, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.hidden_dim, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.h3_off)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m 380 \u001b[22m         \u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.logits\u001b[39m\u001b[K\r\u001b[2C\u001b[4BLogits match the old ou\u001b[27Gput bit for bit on all three dev prompts, and the forward pass is 1.16\u00d7 faster\u001b[106G(about 57\u001b[116GGB/s\u001b[K\r\u001b[2C\u001b[1Beffective). Next I'm\u001b[24Gup\u001b[27Gating the phas\u001b[43Gprofiler fo\u001b[55G the\u001b[60Gnew\u001b[64Gkernel\u001b[71Glayout.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix-vector work now takes about 91% of the time\u001b[54Gat\u001b[57Groughly\u001b[65G57\u001b[68GGB/s,\u001b[74Gwith\u001b[79Gattention\u001b[89Gdown\u001b[94Gto\u001b[97G0.25\u001b[102Gms."]
[441.276, "\u001b[106GNext\u001b[111GI'll\u001b[116Gtry\u001b[120Ga\r\u001b[2C\u001b[1Bfew more tile shapes and unrolls on the largest matrix.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell com\u001b[19Gand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll variants land at 56\u201361 GB/s,\u001b[36Gwithin\u001b[43Gnoise\u001b[49Gof\u001b[52Geach\u001b[57Gother,\u001b[64Gso\u001b[67GT=128\u001b[73Gwith\u001b[78Ga\u001b[80G4-row\u001b[86Gunroll\u001b[93Gstays.\u001b[100GThe\u001b[104Gmatrix\u001b[111Gkernels\r\u001b[2C\u001b[1Bare at the bandwidth plateau.\u001b[33GNext,\u001b[39Gend-to-end\u001b[50Gand\u001b[54Gstartup:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[38;3H"]
