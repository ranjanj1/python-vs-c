[138.187, "\u001b[H\u001b[2G\u001b[38;2;87;105;247m\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mInterleav\u001b[12Gd classifier tile-size benchmark\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m cat > scratch/bench_cls2.py <<'EOF'\u001b[40G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import sys, os, time, statist\u001b[34Gcs, numpy\u001b[44Gas np\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msys.path.insert(0,\u001b[23Gos.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[1B \u001b[2m\u2502\u001b[22m import \u001b[12Gun\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m from numba import\u001b[22Gnjit\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mF32 = np.float32\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m@njit(boundscheck"]
[138.187, "=False)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef cls_tiled(out, x, wtiles):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  nt = wtiles.shape[0]; T = wtiles.shape[2]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for t in range(nt):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      run.matmul_t(out[t * T:(t + 1) * T], x, wtiles[t])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm\u001b[6G= run.Model('model.bin')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mx\u001b[6G= np.random.default_rng(0).standard_normal(m.dim).astype(F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mTs = (256, 500, 640, 800, 1280, 1600, 2000, 3200)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mW\u001b[6G= {T: np.ascontiguousarray(m.wcls.reshape(m.dim,\u001b[55Gm.vocab\u001b[63G//\u001b[66GT,\u001b[69GT).transpose(1,\u001b[85G0,\u001b[88G2))\u001b[92Gfor\u001b[96GT\u001b[98Gin\u001b[101GTs}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdel m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mout\u001b[8G=\u001b[10Gnp.zeros(32000,\u001b[26GF32);\u001b[32Gres\u001b[36G=\u001b[38G{T:\u001b[42G[]\u001b[45Gfor\u001b[49GT\u001b[51Gin\u001b[54GTs}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for T in Ts: cls_tiled(out,\u001b[32Gx,\u001b[35GW[T])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gr\u001b[10Gin\u001b[13Grange(12):\r\u001b[1B \u001b[2m\u2502\u001b[22m     for T in Ts:\u001b[21G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G     t\u001b[14G= ti"]
[138.188, "me.perf_co\u001b[29Gnter(); cls_tiled(out, x, W[T]); res[T].append(time.perf_counter()\u001b[96G-\u001b[98Gt)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8GT\u001b[10Gin\u001b[13GTs:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f'T={T:5d}\u001b[25Gmedian\u001b[32G{statistics.median(res[T])*1e3:.3f}\u001b[68Gms\u001b[72Gmin\u001b[76G{min(res[T])*1e3:.3f}\u001b[98Gms\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m{98.3e6/min(res[T])/1e9:.1f}\u001b[33GGB/s')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/bench_cls2.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon'"]
[138.188, "t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/bench_cls2.py\u001b[74G\u001b[22mcommands\u001b[83Gin\u001b[86G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
