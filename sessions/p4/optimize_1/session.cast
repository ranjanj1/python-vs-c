[513.264, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix-vector\u001b[17Gwork now takes about 91% of th\u001b[48G \u001b[50Gi\u001b[52Ge at roughly\u001b[65G57\u001b[68GGB/s,\u001b[74Gwith\u001b[79Gattention\u001b[89Gdown\u001b[94Gto\u001b[97G0.25\u001b[102Gms.\u001b[106GNext\u001b[111GI'll\u001b[116Gtry\u001b[120Ga\r\u001b[2C\u001b[1Bfew\u001b[7Gmore\u001b[12Gtile\u001b[17Gshapes\u001b[24Gand\u001b[28Gunrolls\u001b[36Gon\u001b[39Gthe\u001b[43Glargest\u001b[51Gmatrix.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gvariants land at\u001b[24G56\u201361 GB/s, within n\u001b[45Gise of each o\u001b[59Gher,\u001b[64Gso\u001b[67GT=128\u001b[73Gwith\u001b[78Ga\u001b[80G4-row\u001b[86Gunroll\u001b[93Gstays.\u001b[100GThe\u001b[104Gmatrix\u001b[111Gkernels\r\u001b[2C\u001b[1Bare\u001b[7Gat\u001b[10Gthe\u001b[14Gbandwidth\u001b[24Gplateau.\u001b[33GNext,\u001b[39Gend-to-end\u001b[50Gand\u001b[54Gstartup:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSession time dropped from 7.5 s\u001b[36Go 5.3\u001b[42Gs and generation runs at about 99\u2013108 t\u001b[82Gk/s, but startup weight\u001b[106Gprep\u001b[111Grose\u001b["]
[513.266, "116Gfrom\r\u001b[2C\u001b[1B~0.35\u001b[9Gto\u001b[12G0.78\u001b[17Gs\u001b[19Gbecause\u001b[27Gthe\u001b[31Gnew\u001b[35Gtiling\u001b[42Gcopy\u001b[47Gis\u001b[50Gslower.\u001b[58GI'm\u001b[62Gbenchmarking\u001b[75Gcopy-loop\u001b[85Gvariants\u001b[94Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcopy\u001b[12Gkernel\u001b[19Gaccounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mtile_into\u001b[39m takes 0\u001b[21G76 s\u001b[26Gon the real weights, versus about 0.15 s predicted,\u001b[78Gbecause\u001b[86Gthe\u001b[90Gmachine\u001b[98Gis\u001b[101Gshort\u001b[107Gon\u001b[110Gmemory\u001b[117Gwith\r\u001b[2C\u001b[1Bheavy\u001b[9Gcompression.\u001b[22GI'm\u001b[26Gcomparing\u001b[36Gold\u001b[40Gand\u001b[44Gnew\u001b[48Gloading\u001b[56Gback\u001b[61Gto\u001b[64Gback\u001b[69Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Comparing v1 vs new model load time\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > \u001b[15Gcratch/bench"]
