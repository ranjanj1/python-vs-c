[512.957, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatrix-vector\u001b[17Gwork\u001b[22Gnow\u001b[26Gtakes\u001b[32Gabout\u001b[38G91%\u001b[42Gof\u001b[45Gthe\u001b[49Gtime\u001b[54Gat\u001b[57Groughly\u001b[65G57\u001b[68GGB/s,\u001b[74Gwith\u001b[79Gattention\u001b[89Gdown\u001b[94Gto\u001b[97G0.25\u001b[102Gms.\u001b[106GNext\u001b[111GI'll\u001b[116Gtry\u001b[120Ga\r\u001b[1B \u001b[3Gfew more tile\u001b[17Gshapes and unrolls on the larg\u001b[48Gs\u001b[50G \u001b[52Gatrix.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gvariants\u001b[16Gland\u001b[21Gat\u001b[24G56\u201361\u001b[30GGB/s,\u001b[36Gwithin\u001b[43Gnoise\u001b[49Gof\u001b[52Geach\u001b[57Gother,\u001b[64Gso\u001b[67GT=128\u001b[73Gwith\u001b[78Ga\u001b[80G4-row\u001b[86Gunroll\u001b[93Gstays.\u001b[100GThe\u001b[104Gmatrix\u001b[111Gkernels\r\u001b[1B \u001b[3Gare\u001b[7Gat the bandwidth\u001b[24Gplateau. Next, end-t\u001b[45G-end and star\u001b[59Gup:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSession\u001b[11Gtime\u001b[16Gdropped\u001b[24Gfrom\u001b[29G7.5\u001b[33Gs\u001b[35Gto\u001b[38G5.3\u001b[42Gs\u001b[44Gand\u001b[48Ggeneration\u001b[59Gruns\u001b[64Gat\u001b[67Gabout\u001b[73G99\u2013108\u001b[80Gtok/s,\u001b[87Gbut\u001b[91Gstartup\u001b"]
[512.958, "[99Gweight\u001b[106Gprep\u001b[111Grose\u001b[116Gfrom\r\u001b[1B \u001b[3G~0.35 to 0.78 s because the new\u001b[36Giling\u001b[42Gcopy is slower. I'm benchmarking copy-l\u001b[82Gop variants next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcopy\u001b[12Gkernel\u001b[19Gaccounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mtile_into\u001b[13G\u001b[39mtakes\u001b[19G0.76\u001b[24Gs\u001b[26Gon\u001b[29Gthe\u001b[33Greal\u001b[38Gweights,\u001b[47Gversus\u001b[54Gabout\u001b[60G0.15\u001b[65Gs\u001b[67Gpredicted,\u001b[78Gbecause\u001b[86Gthe\u001b[90Gmachine\u001b[98Gis\u001b[101Gshort\u001b[107Gon\u001b[110Gmemory\u001b[117Gwith\r\u001b[1B \u001b[3Gheavy compression\u001b[21G I'm\u001b[26Gcomparing old and new loading back to back next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mComparing\u001b[13Gv1\u001b[16Gvs\u001b[19Gnew\u001b[23Gmodel\u001b[29Gload\u001b[34Gtime\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1"]
