[128.034, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/profile.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m lines to \u001b[1mscratch/profile.py\r\u001b[1B\u001b[22m     \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsage: python3 scratch/profile.py [e2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m  e2\u001b[15G \u001b[17G  : drive `pyt\u001b[32Gon3 run.py`\u001b[44Gover t\u001b[51Ge protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m   \u001b[19G \u001b[21Gtiming every command (median over repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[12G\u001b[22mphases\u001b[19G:\u001b[21Gper-phase breakdow\u001b[40G of one forwa\u001b[54Gd \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C"]
[128.035, "\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[12G\u001b[22m      \u001b[19G \u001b[21G(same kernels, Python-driven so each phase can be timed).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\r\u001b[6C\u001b[1B\u001b[2m10\u001b[17G\u001b[22mnumpy\u001b[23G\u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling\u001b[13Gshows\u001b[19Ga\u001b[21Gforward\u001b[29Gpass\u001b[34Gat\u001b[37Gabout\u001b[43G10\u001b[46Gms/token\u001b[55G(44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[1B \u001b[3GI'm trying c\u001b[16Gntiguous column tiles t\u001b[40G keep\u001b[46Gits \u001b[51Gutputs in\u001b[61GL1.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mBenchmarking\u001b[16Gtiled\u001b[22Gclassifier\u001b[33Glayouts\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ cat > scratch/bench_c"]
[128.036, "ls.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport sys, os, time, statistics, numpy as np\r\u001b[5C\u001b[1Bsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[5C\u001b[1Bimport run\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfrom numba import njit\r\u001b[5C\u001b[1BF32 = np.float32\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m@njit(boundscheck=False)\r\u001b[5C\u001b[1Bdef cls_tiled(out, x, wtiles, k):\r\u001b[5C\u001b[1B# wti\u001b[12Ges: (n_tiles, n, T) \u2026 (3s \u00b7 12 lines)\r\u001b[5C\u001b[1B(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[128.134, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm\u001b[7Gprofiling\u001b[17Gon\u001b[20Gan\u001b[23GM1\u001b[26Gwith\u001b[31G8\u001b[33GGB\u001b[36Gand\u001b[40Ga\u001b[42Gload\u001b[47Gaverage\u001b[55Gnear\u001b[60G3,\u001b[63Gso\u001b[66GI'll\u001b[71Grely\u001b[76Gon\u001b[79Gbest-of/median\u001b[94Gtimings.\u001b[103GI'm\u001b[107Gbuilding\u001b[116Gtwo\r\u001b[2C\u001b[1Bprofiler\u001b[12Gparts:\u001b[19Gend-to-end\u001b[30Gtiming\u001b[37Gof\u001b[40Gthe\u001b[44Gdev\u001b[48Gworkload\u001b[57Gand\u001b[61Ga\u001b[63Gper-phase\u001b[73Gbreakdown\u001b[83Gof\u001b[86Gone\u001b[90Gforward\u001b[98Gpass.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mWrite\u001b[22m(scratch/profile.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m lines to \u001b[1mscratch/profile.py\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsag\u001b[15G:\u001b[17Gpython3 scratc\u001b[32G/profile.py\u001b[44G[e2e|p\u001b[51Gases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22me2e\u001b[19G:\u001b[21Gdrive `python3 run.py` over"]
[128.135, " the protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m      \u001b[19G \u001b[21Gtiming every comma\u001b[40Gd (median ove\u001b[54G repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[12G\u001b[22mphases\u001b[19G:\u001b[21Gper-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 9\u001b[17G\u001b[22mjson,\u001b[23Gos, subprocess, sys, tempfile, time, statistics\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling sh\u001b[16Gws a forward pass at ab\u001b[40Gut 10\u001b[46Gms/t\u001b[51Gken (44.8\u001b[61G"]
