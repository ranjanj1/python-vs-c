[93.051, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProf\u001b[8Gle this implementation on\u001b[34Gthe supplied development workloads. Improve performance within the same rules and \u001b[39m    \r\u001b[2C\u001b[1B\u001b[38;2;0;0;0mremaini\u001b[11Gg budget. Pres\u001b[27Gve the interface and corr\u001b[53Gctn\u001b[57Gss requirements. Do\u001b[77Gnot\u001b[81Guse hidden evaluation\u001b[105Gputs, external \r\u001b[1B\u001b[39m  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe fixtures in \u001b[38;2;87;105;247mfixtures.json\u001b[39m are the\u001b[41Gdevelopment workl\u001b[59Gads, so I'll\u001b[72Gprofile th\u001b[84G9 ENCODE\u001b[93Gstrings\u001b[101Gand\u001b[105Gthe\u001b[109Gthree\r\u001b[2C\u001b[1Bprompts\u001b[11Grun\u001b[15Gas\u001b[18GGENERATE\u001b[27G64\u001b[30Gand\u001b[34GLOGITS\u001b[41Gover\u001b[46G69\u201382\u001b[52Gpositions.\u001b[63GChecking\u001b[72Gthe\u001b[76Gmachine\u001b[84Gfirst.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[3"]
[93.051, "9m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm profiling on an M1 with 8 GB and\u001b[40Ga load ave\u001b[51Gage ne\u001b[58Gr 3,\u001b[63Gso I'll rely on best-of/m\u001b[89Gdian timing\u001b[101G. I'm\u001b[107Gbuilding\u001b[116Gtwo\r\u001b[2C\u001b[1Bprofiler\u001b[12Gparts:\u001b[19Gend-to-end\u001b[30Gtiming\u001b[37Gof\u001b[40Gthe\u001b[44Gdev\u001b[48Gworkload\u001b[57Gand\u001b[61Ga\u001b[63Gper-phase\u001b[73Gbreakdown\u001b[83Gof\u001b[86Gone\u001b[90Gforward\u001b[98Gpass.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mWrite\u001b[22m(scratch/profile.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m lines to \u001b[1mscratch/profile.py\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsag\u001b[15G:\u001b[17Gpython3 scratc\u001b[32G/profile.py\u001b[44G[e2e|p\u001b[51Gases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22me2e\u001b[19G:\u001b[21Gdrive `python3 run.py` over the protocol exactly like check.py --tokens \u001b[3"]
[93.052, "8;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m      \u001b[19G \u001b[21Gtiming every comma\u001b[40Gd (median ove\u001b[54G repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[12G\u001b[22mphases\u001b[19G:\u001b[21Gper-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 9\u001b[17G\u001b[22mjson,\u001b[23Gos, subprocess, sys, tempfile, time, statistics\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 scratch/profile.py all 3 2>&1 | tee scratch/profile_before.txt\r\u001b[2B\u001b[38;2;215;119;87m\u2733\u001b[3G\u001b[38;2;245;149;117mFluttering\u2026\u001b[39m\u001b[40;1H\u001b[38;"]
