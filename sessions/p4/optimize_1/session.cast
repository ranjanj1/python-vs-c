[761.686, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u273d\u001b[20G\u001b[38;2;102;102;102m17s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m54.2k tokens)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[761.807, "\u001b[H\u001b[3G\u001b[1mProfiling.\u001b[22m I used only the \u001b[38;2;87;105;247mfixtures.json\u001b[39m workloads that \u001b[38;2;87;105;247mcheck.py\u001b[39m runs. A forward pass took 10.0 ms per token and\u001b[116Gis\r\u001b[2C\u001b[1Blimited by memory bandwidth: 438 MB of weights are read per token, and one M1 core streams about 56 GB/s at best.\u001b[117GThe\r\u001b[2C\u001b[1Bfinal classifier was the main problem: 30% of the time at only 32 GB/s, because its 128 KB output vector kept falling\r\u001b[2C\u001b[1Bout of the L1 cache. The other matrix multiplies ran at 51\u201355 GB/s and attention took 4%.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTiled weights:\u001b[20G\u001b[22mevery\u001b[26Gweight\u001b[33Gmatrix\u001b[40Gis\u001b[43Gstored\u001b[50Gin\u001b[53Gblocks\u001b[60Gof\u001b[63G128\u001b[67Goutput\u001b[74Gcolumns.\u001b[83GEach\u001b[88Gblock\u001b[94Gstreams\u001b[102Gcontiguously\u001b[115Gand\r\u001b[4C\u001b[1Bits outputs stay in L1, which raised all matrix multiplies to about\u001b[73G58\u201360\u001b[79GGB/s.\u001b[85GEach\u001b[90Goutput\u001b[97Gis\u001b[100Gstill\u001b[106Gsummed\u001b[113Gin\u001b[116Gthe\r\u001b[4C\u001b[1Bsame order as \u001b[38;2;87;105;247mrun.c\u001b[39m.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mC"]
[761.809, "ombined matrix calls:\u001b[28G\u001b[22mthe\u001b[32Gq/k/v\u001b[38Gmatrices\u001b[47Gand\u001b[51Gthe\u001b[55Gw1/w3\u001b[61Gmatrices\u001b[70Gare\u001b[74Geach\u001b[79Ghandled\u001b[87Gin\u001b[90Gone\u001b[94Gcall\u001b[99Gper\u001b[103Glayer.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttention:\u001b[22m unrolled by two, keeping the same order of additions (0.44 \u2192 0.25 ms per token).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoPE:\u001b[22m the cos/sin values are computed once per position instead of once per layer. The values are bit-identical.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLoading:\u001b[22m the checkpoint is memory-mapped and copied into the tiled layout with a faster loop.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults\u001b[11G\u001b[22m(medians\u001b[20Gon\u001b[23Ga\u001b[25Gshared,\u001b[33Gmemory-pressured\u001b[50GM1,\u001b[54Gso\u001b[57Gexpect\u001b[64G\u00b115\u201330%\u001b[72Grun-to-run\u001b[83Gvariation):\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[1B \u001b[3G\u2502  \u001b[7G       \u001b[15G   \u001b[19G  \u001b[22G         \u001b[32G   \u001b[36G  \u2502  Befo\u001b[46Ge  \u2502  Aft\u001b[56Gr  \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c"]
[761.81, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[1B \u001b[3G\u2502 Forward pass, ms\u001b[22Gper\u001b[26Gtoken\u001b[38G\u2502\u001b[40G8.9\u201310.0\u001b[49G\u2502\u001b[51G7.7\u20138.3\u001b[59G\u2502\r\u001b[1B  \u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502\u001b[5GGENERATE 64 tokens/s \u001b[38G\u2502\u001b[40G68\u201390\u001b[49G\u2502\u001b[51G94\u2013114\u001b[59G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5GFull check-equivalent session    \u2502 7.5 s    \u2502 5.4 s   \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5GStartup to \u001b[38;2;87;105;247mR"]
[761.811, "EADY\u001b[39m                 \u2502 1.7 s    \u2502 1.45 s  \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[K\r\u001b[2C\u001b[1B\u2502\u001b[5G~1024-position long-context test \u2502 15.8 s   \u2502 10.8 s  \u2502\u001b[K\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests beyond \u001b[38;2;87;105;247mcheck.py\u001b[39m:\u001b[22m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOld vs new forward pass:\u001b[30G\u001b[22mbitwise\u001b[38Gidentical\u001b[48Gon\u001b[51Gall\u001b[55Gthree\u001b[61Gdev\u001b[65Gsequences.\r\u001b[1B \u001b[3G- \u001b[1mSynthetic checkpoints:\u001b[28G\u001b[22mcover cases the\u001b[44Gsupplied\u001b[53Gmodel\u001b[59Gnever\u001b[65Ghits\u001b[70G(dimensions\u001b[82Gthat\u001b[87Gneed\u001b[92Gpadding\u001b[100Gto\u001b[103Gwhole\u001b[109Gtiles,\u001b[116Gfewer\r\u001b[1B    key/value heads than query heads, unshared classifier weights, running to \u001b[38;2;87;105;247mseq_len\u001b[39m). T"]
