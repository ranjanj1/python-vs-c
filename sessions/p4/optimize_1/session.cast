[142.033, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsage: python3 scratch/profile.py [e2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22m  e2\u001b[15G \u001b[17G  : drive `pyt\u001b[32Gon3 run.py`\u001b[44Gover t\u001b[51Ge protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m   \u001b[19G \u001b[21Gtiming every command (median over repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[12G\u001b[22mphases\u001b[19G:\u001b[21Gper-phase breakdow\u001b[40G of one forwa\u001b[54Gd \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[12G\u001b[22m      \u001b[19G \u001b[21G(same kernels, Python-driven so each phase can be timed).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\r\u001b[6C\u001b[1B\u001b[2m10\u001b[17G\u001b"]
[142.063, "[22mnumpy\u001b[23G\u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling\u001b[13Gshows\u001b[19Ga\u001b[21Gforward\u001b[29Gpass\u001b[34Gat\u001b[37Gabout\u001b[43G10\u001b[46Gms/token\u001b[55G(44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[1B \u001b[3GI'm trying c\u001b[16Gntiguous column tiles t\u001b[40G keep\u001b[46Gits \u001b[51Gutputs in\u001b[61GL1.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling\u001b[10Ghelps\u001b[16G(\u22481.8\u001b[22Gms\u001b[25Gvs\u001b[28G2.0\u20132.7\u001b[36Gms),\u001b[41Gbut\u001b[45Gthe\u001b[49Gtimings\u001b[57Gare\u001b[61Gnoisy\u001b[67Gand\u001b[71Gdon't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[1B \u001b[3Gmore til\u001b[12G sizes that divide 3\u001b[33G000, interleav\u001b[48Gd, using\u001b[57Gth\u001b[61G2-row\u001b[67Gkernel:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mInterleaved\u001b[15Gclassifier\u001b[26G"]
[142.064, "tile-size\u001b[36Gbenchmark\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ cat > scratch/bench_cls2.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport sys, os, time, statistics, numpy as np\r\u001b[5C\u001b[1Bsys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[5C\u001b[1Bimport run\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfrom numba import njit\r\u001b[5C\u001b[1BF32 = np.float32\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m@njit(boundscheck=False)\r\u001b[5C\u001b[1Bdef cls_tiled(out, x, wtiles):\r\u001b[5C\u001b[1Bnt = wtiles.shape[0];\u001b[28GT = wt\u2026 (3s \u00b7 9 lines)\r\u001b[5C\u001b[1B(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[142.116, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsag\u001b[15G:\u001b[17Gpython3 scratc\u001b[32G/profile.py\u001b[44G[e2e|p\u001b[51Gases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22me2e\u001b[19G:\u001b[21Gdrive `python3 run.py` over the protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m      \u001b[19G \u001b[21Gtiming every comma\u001b[40Gd (median ove\u001b[54G repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[12G\u001b[22mphases\u001b[19G:\u001b[21Gper-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b["]
[142.116, "39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 9\u001b[17G\u001b[22mjson,\u001b[23Gos, subprocess, sys, tempfile, time, statistics\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling sh\u001b[16Gws a forward pass at ab\u001b[40Gut 10\u001b[46Gms/t\u001b[51Gken (44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gtrying\u001b[14Gcontiguous\u001b[25Gcolumn\u001b[32Gtiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling h\u001b[12Glps (\u22481.8 ms vs 2.0\u2013\u001b[33G.7 ms), but th\u001b[48G timings\u001b[57Gar\u001b[61Gnoisy\u001b[67Gand don't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[2C\u001b[1Bmore\u001b[8Gtile\u001b[13Gsizes\u001b[19Gthat\u001b[24Gdivide\u001b[31G32000,\u001b[38Ginterleaved,"]
