[264.989, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gl\u001b[14Gin\u001b[17Grange(wt.shape[0]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for t in range(wt.shape[1]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mrun.matmul_t(out[t\u001b[35G*\u001b[37GT:(t\u001b[42G+\u001b[44G1)\u001b[47G*\u001b[49GT],\u001b[53Gx,\u001b[56Gwt[l,\u001b[62Gt])\r\u001b[1B \u001b[2m\u2502\u001b[22m @njit(boundscheck=False)\u001b[29G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def lay\u001b[13Gs_plain(out, x, w):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8Gfor l in range(w.shape[0]):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mrun.matmul_t(out,\u001b[30Gx,\u001b[33Gw[l])\r\u001b[1B \u001b[2m\u2502\u001b[22m m = run.Model('model.bin')\r\u001b[1B \u001b[2m\u2502\u001b[22m def tile(w,\u001b[16GT):  # (L, n, d) -> (L, d/T,\u001b[45Gn,\u001b[48GT)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  L, n, d = w.shape\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  return\u001b[15Gnp.ascontiguousarray(w.reshape(L,\u001b[49Gn,\u001b[52Gd\u001b[54G//\u001b[57GT,\u001b[60GT).transpose(0,\u001b[76G2,\u001b[79G1,\u001b[82G3))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcases = {}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor name, w in (('w1 768->2048',\u001b[37Gm.w1),\u001b[44G('w2\u001b[49G2048->768',\u001b[61Gm.w2),\u001b[68G('wq\u001b[73G768->768',\u001b[84Gm.wq)):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  n, d = w.shape[1], w.shape[2]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G"]
[264.991, "\u001b[22m  x = np.random.default_rng(2).standard_normal(n).astype(F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  ref = np.zeros(d, F32); layers_plain(ref,\u001b[50Gx,\u001b[53Gw)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  cases[f'{name} plain']\u001b[31G=\u001b[33G(layers_plain,\u001b[48G(np.zeros(d,\u001b[61GF32),\u001b[67Gx,\u001b[70Gw),\u001b[74Gw.nbytes,\u001b[84Gref)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for T in (128, 256, 384, 512,\u001b[38G1024):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      if d % T == 0 and T\u001b[32G<\u001b[34Gd:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          cases[f'{name}\u001b[31GT={T}']\u001b[39G=\u001b[41G(layers_tiled,\u001b[56G(np.zeros(d,\u001b[69GF32),\u001b[75Gx,\u001b[78Gtile(w,\u001b[86GT)),\u001b[91Gw.nbytes,\u001b[101Gref)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mR\u001b[6G=\u001b[8G{c:\u001b[12G[]\u001b[15Gfor\u001b[19Gc\u001b[21Gin\u001b[24Gcases}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for f, a, _, _ in cases.values():\u001b[38Gf(*a)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8G_\u001b[10Gin\u001b[13Grange(12):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G f\u001b[10Gr c, (f, a, _, _)\u001b[29Gn cases.items():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G  t = time.perf_counter(); f(*a); R[c].append(time.perf_counter()\u001b[76G-\u001b[78Gt)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gc,\u001b[11G(f,\u001b[15Ga,\u001b[18Gnb,\u001b[22G"]
[264.991, "ref)\u001b[27Gin\u001b[30Gcases.items():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f'{c:22s}\u001b[24Gmedian\u001b[31G{statistics.median(R[c])*1e3:7.3f}\u001b[66Gms\u001b[70Gmin\u001b[74G{min(R[c])*1e3:7.3f}\u001b[96G{nb/min(R[c])/1e9:5.1f}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mGB/s\u001b[10Gsame={np.array_equal(a[0],\u001b[37Gref)}')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/bench_t\u001b[28Gl\u001b[30G.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/b"]
[264.992, "ench_tile.py\u001b[74G\u001b[22mcommands\u001b[83Gin\u001b[86G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
