[360.35, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mColum\u001b[11Giles of 128\u2013256 hit about 60 GB/s on\u001b[48Gevery layer \u001b[61Ghape, beating\u001b[75Gthe\u001b[79G56\u001b[82GGB/s\u001b[87Gprobe\u001b[93Gwith\u001b[98Gbitwise-identical\r\u001b[2C\u001b[1Bresults.\u001b[12GNext\u001b[17GI'm\u001b[21Gchecking\u001b[30Gthe\u001b[34Gunroll\u001b[41Gfactor\u001b[48Ginside\u001b[55Gtiles\u001b[61Gand\u001b[65Gthe\u001b[69Gclassifier\u001b[80Gat\u001b[83GT=256.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mW\u001b[5Gth T=128 and \u001b[19G 4-row unroll, every\u001b[40Gmatrix\u001b[47Gnow\u001b[51Ghits\u001b[56Gabout\u001b[62G62\u001b[65GGB/s,\u001b[71Gso\u001b[74GI'm\u001b[78Gmoving\u001b[85Gthe\u001b[89Gdesign\u001b[96Gto\u001b[99Gcolumn\u001b[106Gtiles\u001b[112Gbuilt\u001b[118Gat\r\u001b[2C\u001b[1Bload\u001b[8Gtime,\u001b[14Gfusing\u001b[21Gthe\u001b[25Gq/k/v\u001b[31Gand\u001b[35Gw1/w3\u001b[41Gcalls,\u001b[48Gprecomputing\u001b[61GRoPE\u001b[66Gper\u001b[70Gposition,\u001b[80Gand\u001b[84Gunrolling\u001b[94Gattention\u001b[104G2\u00d7.\u001b[108GI'll\u001b[113Gkeep\u001b[118Gthe\r\u001b[2C\u001b[1Bcurrent version as scratch/run_v1.py\u001b[40Gfor\u001b[44GA/B\u001b[48Gtesting\u001b[56Gand\u001b[60Grewrite\u001b[68Grun.py.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b["]
[360.351, "K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWriting\u001b[11Gthe\u001b[15Gnew\u001b[19Gkernels\u001b[27Gand\u001b[31Gthe\u001b[35G\u001b[38;2;87;105;247mModel\u001b[41G\u001b[39mclass.\u001b[48GThe\u001b[52Gtokenizer\u001b[62Gand\u001b[66Gprotocol\u001b[75Gcode\u001b[80Gare\u001b[84Gunchanged.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI found a bug: when a\u001b[25Gdimension\u001b[35Gisn't\u001b[41Ga multi\u001b[49Gl\u001b[51G \u001b[53Gf 128, the last tile writes past the slice end, so\u001b[104GI'm\u001b[108Gpassing the\u001b[K\r\u001b[2C\u001b[1Bf\u001b[5Gll padd\u001b[13Gd buffers to \u001b[38;2;87;105;247mforward\u001b[39m instead.\u001b[K\r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded\u001b[12G\u001b[1m1\u001b[14G\u001b[22mline,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m 374 \u001b[22m     \u001b[38;2;167;29;93mdef\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mforward\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mself, token, pos\u001b[38;2;51;51;51m):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 375 \u001b[22m         forward(token, pos, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.emb, \u001b[38;2;0;134;179mself\u001b[38"]
