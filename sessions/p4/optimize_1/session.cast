[646.424, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling\u001b[10Gand\u001b[14Gpadding\u001b[22Gcheck\u001b[28Gout,\u001b[33Gand\u001b[37Gthe\u001b[41Gfresh-process\u001b[55Gload\u001b[60Gis\u001b[63Gdown\u001b[68Gto\u001b[71Gabout\u001b[77G0.37\u001b[82Gs.\u001b[85GNext\u001b[90GI'll\u001b[95Grun\u001b[99Ga\u001b[101Gwhole-model\r\u001b[1B \u001b[3Gc\u001b[5Gmparison against v1 on \u001b[29G small sy\u001b[39Gthe\u001b[43Gic checkpoint covering n\u001b[68Gn-multiple-of-128 dimensi\u001b[94Gns,\u001b[98Gg\u001b[101Guped-query attention\r\u001b[2C\u001b[1Band unshared classifier weights.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gv2\u001b[10Goutput\u001b[17Gmatches\u001b[25Gv1\u001b[28Gbit-for-bit\u001b[40Gon\u001b[43Gall\u001b[47Gthree\u001b[53Gsynthetic\u001b[63Gshapes,\u001b[71Gcovering\u001b[80Gpadding,\u001b[89Ggrouped-query\u001b[103Gattention\u001b[113Gand\u001b[117Gthe\r\u001b[1B \u001b[3Gunshared classifier. Next\u001b[29GI'm running the\u001b[45Gfull check,\u001b[57Gthe edge-case tests and the end-to-end pr\u001b[99Gf\u001b[101Gle.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything\u001b[14Gpasses,\u001b[22Gand\u001b[26Gthe\u001b[30G1024-posi"]
[646.424, "tion\u001b[44Gruns\u001b[49Gdropped\u001b[57Gfrom\u001b[62Gabout\u001b[68G15.8\u001b[73Gs\u001b[75Gto\u001b[78G10.8\u001b[83Gs.\u001b[86GRe-verifying\u001b[99Gthe\u001b[103Gprecision\u001b[113Grules\u001b[119Gon\r\u001b[1B \u001b[3Gthe \u001b[8Gew kernels (no float64, no fast-math flags):\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new kernels are compliant.\u001b[34GSaving\u001b[41Gthe\u001b[45Gfinal\u001b[51Gprofile\u001b[59Gas\u001b[62Gevidence:\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[28G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 scratch/profile.py all 4 2>&1 | tee scratch/profile_after.txt; rm -f scratch/profile_after_e2e.txt; \r\u001b[5C\u001b[1Buptime\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[646.425, "\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mFinal profile run saved to file\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gscratch/profile.py\u001b[31Gall\u001b[35G4\u001b[37G2>&1\u001b[42G|\u001b[44Gtee\u001b[48Gscratch/profile_after.txt;\u001b[75Grm\u001b[78G-f\u001b[81Gscratch/profile_after_e2e.txt;\u001b[112Guptime\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[646.426, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mpython3 scratch/profile.py all 4, tee scratch/profile_after.txt\u001b[22m,\u001b[101Gand\u001b[105G\u001b[1mrm -f \r\u001b[6C\u001b[1Bscratch/profile_after_e2e.txt\u001b[37G\u001b[22mcommands\u001b[46Gin\u001b[49G\u001b[1m/Users/agentlab/pvc/p4\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
