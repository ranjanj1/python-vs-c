[185.93, "\u001b[H\r\u001b[19C\u001b[33B\u001b[38;2;102;102;102m7\u001b[42G\u001b[38;2;172;156;127mstill thinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[185.997, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsage:\u001b[17Gpython3 scratch/profile.py\u001b[44G[\u001b[46G2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\r\u001b[6C\u001b[1B\u001b[2m 4\u001b[10G\u001b[22m  e2e \u001b[17G  : drive `python3 run.py` over the protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m           timing every command (median over repeats).\r\u001b[5C\u001b[1B\u001b[2m  6 \u001b[22m  phases : per-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b"]
[185.998, "[38;2;167;29;93mas\u001b[38;2;51;51;51m np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfil\u001b[10Gng\u001b[14Ghow\u001b[19Ga forward pass at about 10 ms/token (44.8\u001b[61GGB/s); the classifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gtrying\u001b[14Gcontiguous\u001b[25Gcolumn\u001b[32Gtiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling helps (\u22481.8 ms\u001b[25Gvs\u001b[28G2.0\u20132.7 ms),\u001b[41Gbut the timings are noisy and don't\u001b[77Gfollow tile size cleanly. Re-runn\u001b[111Gng wi\u001b[117Gh\r\u001b[2C\u001b[1Bmore tile sizes that divide 32000,\u001b[38Ginterleaved,\u001b[51Gusing\u001b[57Gthe\u001b[61G2-row\u001b[67Gkernel:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSmall tiles of 256\u20131280 columns bring the\u001b[45Gclassifier\u001b[56Gto\u001b[59Gabout\u001b["]
[186.0, "65G1.9\u001b[69Gms,\u001b[73Gso\u001b[76GI'm\u001b[80Gusing\u001b[86Gthe\u001b[90Glargest\u001b[98Gdivisor\u001b[106Gof\u001b[109Gvocab\u001b[115Gup\u001b[118Gto\r\u001b[2C\u001b[1B1280 and falling back to zero-padding\u001b[41Gwhen\u001b[46Gnone\u001b[51Gexists.\u001b[59GNext\u001b[64GI'll\u001b[69Gmeasure\u001b[77Gthe\u001b[81Gsingle-core\u001b[93Gread-bandwidth\u001b[108Gceiling\u001b[116Gto\r\u001b[2C\u001b[1Bsee how much headroom\u001b[25Gremains.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe layer matmuls\u001b[21Galready\u001b[29Grun\u001b[33Gnear\u001b[38Gthe\u001b[42Gone-core\u001b[51Gceiling\u001b[59Gof\u001b[62Gabout\u001b[68G56\u001b[71GGB/s,\u001b[77Gso\u001b[80Gthe\u001b[84Gremaining\u001b[94Ggains\u001b[100Gare\u001b[104Gin\u001b[107Gthe\r\u001b[2C\u001b[1Bclassifier, fused q/k/v and w1/w3\u001b[37Gkernels,\u001b[46Gand\u001b[50Gsome\u001b[55Gattention\u001b[65Gand\u001b[69GRoPE\u001b[74Gwork.\u001b[80GI'm\u001b[84Gprototyping\u001b[96Ga\u001b[98Gnew\u001b[102Gforward\u001b[110Gpass\u001b[115Gthat\r\u001b[2C\u001b[1Bmust produce bitwise-identical\u001b[34Glogits.\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[3GFluttering\u2026 \u001b[28G\u001b[38;2;102;102;102m3\u001b[30G8\u001b[42G\u001b[38;2;185;185;185mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[186.009, "\u001b[H\r\u001b[41C\u001b[33B\u001b[38;2;102;102;102mthought for 14s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
