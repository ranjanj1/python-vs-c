[508.687, "l.module_from_spec(spec);\r\u001b[1B \u001b[2m\u2502\u001b[22m spec.loader.exec_module(mod); return mod\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m mods\u001b[9G= [('v1',\u001b[19Gload('run_v1', 'scratch/run_v1.py')), ('new', load('run', 'run.py'))]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gname,\u001b[14Gmod\u001b[18Gin\u001b[21Gmods:\u001b[28G#\u001b[30Gcompile/warm\u001b[43Gkernels\u001b[51Gon\u001b[54Ga\u001b[56Gtiny\u001b[61Gcall\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     m = mod.Model('model.bin');\u001b[36Gdel\u001b[40Gm;\u001b[43Ggc.collect()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gr\u001b[10Gin\u001b[13Grange(3):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G for\u001b[12Gname, mod in mods:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mt\u001b[14G=\u001b[16Gtime.perf_counter();\u001b[37Gm\u001b[39G=\u001b[41Gmod.Model('model.bin');\u001b[65Gdt\u001b[68G=\u001b[70Gtime.perf_counter()\u001b[90G-\u001b[92Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         del m; gc.collect()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mprint(f'{name:4s}\u001b[30GModel()\u001b[38G{dt:.3f}s')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/bench_m\u001b[28Gdelload.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[508.687, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/bench_modelload.py\u001b[79G\u001b[22mcommands\u001b[88Gin\u001b[91G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
