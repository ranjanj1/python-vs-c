[762.393, "\u001b[H\u001b[3Gout of the\u001b[14GL1 cache. The other matrix multiplies ran \u001b[59G51\u201355 GB/s and\u001b[74Gattention\u001b[84Gtook\u001b[89G4%.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mTiled weights:\u001b[22m every weig\u001b[31Gt matrix is s\u001b[45Gored in blocks of 128 output\u001b[74Gcolumns. Each block\u001b[94Gstreams\u001b[102Gcontiguously\u001b[115Gand\r\u001b[4C\u001b[1Bits\u001b[9Goutputs\u001b[17Gstay\u001b[22Gin\u001b[25GL1,\u001b[29Gwhich\u001b[35Graised\u001b[42Gall\u001b[46Gmatrix\u001b[53Gmultiplies\u001b[64Gto\u001b[67Gabout\u001b[73G58\u201360\u001b[79GGB/s.\u001b[85GEach\u001b[90Goutput\u001b[97Gis\u001b[100Gstill\u001b[106Gsummed\u001b[113Gin\u001b[116Gthe\r\u001b[2C\u001b[1B  same order\u001b[16Gas\u001b[19G\u001b[38;2;87;105;247mrun.c\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mCombined ma\u001b[17Grix calls:\u001b[22m the q/k/v matrices and the w1/w3 matrices are\u001b[74Geach handled in \u001b[91Gne\u001b[94Gcall per layer.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mAttention:\u001b[22m unrolled\u001b[25Gby t\u001b[30Go, keep\u001b[38Gng the same order of additi\u001b[66Gns (0.44 \u2192 \u001b[78G.25 ms\u001b[85Gper t\u001b[91Gken).\u001b[97G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mRoPE:\u001b[22m th\u001b[14G co\u001b[18G/sin values\u001b[30Gare\u001b[34Gcomputed\u001b[43Gonce\u001b[48Gper\u001b[52Gposition\u001b[61Ginstead\u001b[69Gof\u001b[72Gonce\u001b[77Gper"]
[762.395, "\u001b[81Glayer.\u001b[88GThe\u001b[92Gvalues\u001b[99Gare\u001b[103Gbit-identical.\r\u001b[4C\u001b[1B\u001b[1mL\u001b[7Gad\u001b[11Gg:\u001b[22m the checkpoint is\u001b[32Gmemory-mapped and copied into the tiled layout\u001b[79Gwith a faster loop.\u001b[99G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults\u001b[11G\u001b[22m(m\u001b[14Gdians o\u001b[23Ga shared, memory-pressured M1, \u001b[55Go expect \u00b115\u201330%\u001b[72Grun-to-\u001b[80Gun va\u001b[86Giation):\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502      \u001b[11G        \u001b[20G  \u001b[23G \u001b[25G       \u001b[33G     \u2502  B\u001b[43Gfore  \u2502  After  \u2502\u001b[K\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Forward pass, ms per token       \u2502 8.9\u201310.0 \u2502 7.7\u20138.3 \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500"]
[762.396, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 GENERATE 64 tokens/s             \u2502 68\u201390    \u2502 94\u2013114  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Full check-equivalent session    \u2502 7.5 s    \u2502 5.4 s   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Startup to \u001b[38;2;87;105;247mREADY\u001b[39m                 \u2502 1.7 s    \u2502 1.45 s  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ~1024-position long-context test \u2502 15.8 s   \u2502 10.8 s  \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[762.398, "\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests beyond \u001b[38;2;87;105;247mcheck.py\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOld vs new forward pass:\u001b[30G\u001b[22mbitwise\u001b[38Gidentical\u001b[48Gon\u001b[51Gall\u001b[55Gthree\u001b[61Gdev\u001b[65Gsequences.\r\u001b[2C\u001b[1B- \u001b[1mSynth\u001b[11Gtic checkpoints:\u001b[28G\u001b[22mcover\u001b[34Gcases\u001b[40Gthe\u001b[44Gsupplied\u001b[53Gmodel\u001b[59Gnever\u001b[65Ghits\u001b[70G(dimensions\u001b[82Gthat\u001b[87Gneed\u001b[92Gpadding\u001b[100Gto\u001b[103Gwhole\u001b[109Gtiles,\u001b[116Gfewer\r\u001b[4C\u001b[1Bkey/value\u001b[15Gheads\u001b[21Gthan\u001b[26Gquery\u001b[32Gheads,\u001b[39Gunshared\u001b[48Gclassifier\u001b[59Gweights,\u001b[68Grunning\u001b[76Gto\u001b[79G\u001b[38;2;87;105;247mseq_len\u001b[39m).\u001b[89GThey\u001b[94Gare\u001b[98Gbitwise\u001b[106Gidentical\u001b[116Gto\r\u001b[2C\u001b[1B \u001b[5Gthe old version at every\u001b[30Gposition.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTiled matrix mult\u001b[23Gply\u001b[28G\u001b[22ma di\u001b[33Ge\u001b[35Gt tes\u001b[41G shows it match\u001b[57Gs\u001b[59Ga plain sequential floa\u001b[83G32 sum.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[40;1H\u001b[38;3H"]
