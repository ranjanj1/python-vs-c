[523.619, "\u001b[H\u001b[3GAll variants l\u001b[18Gnd at 56\u201361 GB/s, w\u001b[38Gthin noise of each other, so T=128 with a 4-row unroll stays. The matrix kernels\u001b[K\r\u001b[2C\u001b[1Bare at\u001b[10Gthe bandwidth plateau. Next, end-to-end and startup:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Session time dropped from 7.5 s to 5.3 s\u001b[44Gand\u001b[48Ggeneration\u001b[59Gruns\u001b[64Gat\u001b[67Gabout\u001b[73G99\u2013108\u001b[80Gtok/s,\u001b[87Gbut\u001b[91Gstartup\u001b[99Gweight\u001b[106Gprep\u001b[111Grose\u001b[116Gfrom\r\u001b[2C\u001b[1B~0.35 to 0.78 s because\u001b[27Gthe\u001b[31Gnew\u001b[35Gtiling\u001b[42Gcopy\u001b[47Gis\u001b[50Gslower.\u001b[58GI'm\u001b[62Gbenchmarking\u001b[75Gcopy-loop\u001b[85Gvariants\u001b[94Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe copy kernel accounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b["]
[523.62, "38;2;0;0;0m\u23fa\u001b[39m \u001b[38;2;87;105;247mtile_into\u001b[39m takes 0.76 s on the real weights, versus about 0.15 s predicted, because the machine is short on memory with\r\u001b[1C\u001b[1B heavy compression.\u001b[22GI'm\u001b[26Gcomparing\u001b[36Gold\u001b[40Gand\u001b[44Gnew\u001b[48Gloading\u001b[56Gback\u001b[61Gto\u001b[64Gback\u001b[69Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Lo\u001b[6Gding takes about the same\u001b[32Gtime in\u001b[40Gboth\u001b[45Gversions\u001b[54Gwithin\u001b[61Gone\u001b[65Gprocess,\u001b[74Gso\u001b[77Gthe\u001b[81Gextra\u001b[87Gcost\u001b[92Gcomes\u001b[98Gfrom\u001b[103Gfirst-touch\u001b[115Gpage\r\u001b[1C\u001b[1B faults in fresh proc\u001b[24Gsses\u001b[29Gunder\u001b[35Gmemory\u001b[42Gpressure.\u001b[52GI'm\u001b[56Gnow\u001b[60Gcomparing\u001b[70Gthe\u001b[74Gtwo\u001b[78Gversions\u001b[87Gin\u001b[90Gfresh\u001b[96Gprocesses,\u001b[107Gand\r\u001b[1C\u001b[1B memory-mapping the checkpoint is a w\u001b[40Gy t\u001b[44G avoid the 438 MB of fresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Co\u001b[7Ga\u001b[9Ging fresh-process\u001b[27Gload\u001b[32Gwith\u001b[37Gfromfile\u001b[46Gvs\u001b[49Gmemmap\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/"]
