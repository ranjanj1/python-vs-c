[521.571, "\u001b[H\r\u001b[25B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading takes about the same time in both versions\u001b[54Gwithin\u001b[61Gone\u001b[65Gprocess,\u001b[74Gso\u001b[77Gthe\u001b[81Gextra\u001b[87Gcost\u001b[92Gcomes\u001b[98Gfrom\u001b[103Gfirst-touch\u001b[115Gpage\r\u001b[2C\u001b[1Bfaults in fresh processes under memory pressure. I'm now comparing the\u001b[74Gtwo\u001b[78Gversions\u001b[87Gin\u001b[90Gfresh\u001b[96Gprocesses,\u001b[107Gand\r\u001b[2C\u001b[1Bmemory-mapping the checkpoint is a way to avoid\u001b[51Gthe\u001b[55G438\u001b[59GMB\u001b[62Gof\u001b[65Gfresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m1\u001b[30G4\u001b[39m\u001b[40;1H\u001b[38;3H"]
