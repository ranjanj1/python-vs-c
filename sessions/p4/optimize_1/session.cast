[764.511, "[82Gthat\u001b[87Gneed\u001b[92Gpadding\u001b[100Gto\u001b[103Gwhole\u001b[109Gtiles,\u001b[116Gfewer\r\u001b[2C\u001b[1B \u001b[5Gkey/value heads than query head\u001b[37G, unshared classifi\u001b[57Gr\u001b[59Gw\u001b[61Gights, runn\u001b[73Gng to \u001b[38;2;87;105;247mseq_len\u001b[39m). They are bi\u001b[101Gwise identical\u001b[116Gto\u001b[K\r\u001b[4C\u001b[1Bthe old version\u001b[21Gat every position.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTiled matrix multiply:\u001b[22m a\u001b[30Gdirect test\u001b[42Gshows\u001b[48Git\u001b[51Gmatches\u001b[59Ga\u001b[61Gplain\u001b[67Gsequential\u001b[78Gfloat32\u001b[86Gsum.\r\u001b[4C\u001b[1B\u001b[1mEdg\u001b[9G cases:\u001b[22m PIECE, empty\u001b[30Gpromp\u001b[36G, \u001b[38;2;87;105;247mGENERATE 0\u001b[39m and \u001b[54Ghe \u001b[38;2;87;105;247mcontext\u001b[39m stop b\u001b[72Ghave as before.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPrecision rules:\u001b[22m re-checked every kernel; there\u001b[53Gis no float64 and no fast-math.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTried and rejected:\r\u001b[2C\u001b[1B\u001b[22m- Combining matrices\u001b[24Gwithout\u001b[32Gtiling\u001b[39Gwas\u001b[43Gslower.\r\u001b[4C\u001b[1BOther tile widths and unroll depths were \u001b[47Githin\u001b[53Gnoise\u001b[59Gof\u001b[62Gthe\u001b[66Gchosen\u001b[73Gones.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\r\u001b[2C\u001b[1B\u001b[22m- About 91% of\u001b[18Gthe\u001b[22"]
