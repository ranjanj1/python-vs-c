[764.243, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Full check-equivalent session    \u2502 7.5 s    \u2502 5.4 s   \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Startup to \u001b[38;2;87;105;247mREADY\u001b[39m                 \u2502 1.7 s    \u2502 1.45 s  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 ~1024-position long-context test \u2502 15.8 s   \u2502 10.8 s  \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests beyond \u001b[38;2;87;105;247mcheck.py\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mOld vs new forward pass:\u001b[22m bitwise ide"]
[764.245, "ntical on all three\u001b[61Gdev\u001b[65Gsequences.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSynthetic checkpoints:\u001b[28G\u001b[22mcover\u001b[34Gcases\u001b[40Gthe\u001b[44Gsupplied\u001b[53Gmodel\u001b[59Gnever\u001b[65Ghits\u001b[70G(dimensions\u001b[82Gthat\u001b[87Gneed\u001b[92Gpadding\u001b[100Gto\u001b[103Gwhole\u001b[109Gtiles,\u001b[116Gfewer\r\u001b[2C\u001b[1B  key/value heads than\u001b[26Gquery\u001b[32Gheads,\u001b[39Gunshared\u001b[48Gclassifier\u001b[59Gweights,\u001b[68Grunning\u001b[76Gto\u001b[79G\u001b[38;2;87;105;247mseq_len\u001b[39m).\u001b[89GThey\u001b[94Gare\u001b[98Gbitwise\u001b[106Gidentical\u001b[116Gto\r\u001b[2C\u001b[1B \u001b[5Gthe old version at every\u001b[30Gposition.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTiled matrix mult\u001b[23Gply\u001b[28G\u001b[22ma di\u001b[33Ge\u001b[35Gt tes\u001b[41G shows it match\u001b[57Gs\u001b[59Ga plain sequential floa\u001b[83G32 sum.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mEdge cases:\u001b[22m PIECE, empty prompt, \u001b[38;2;87;105;247mGENERATE 0\u001b[39m and the \u001b[38;2;87;105;247mcontext\u001b[39m \u001b[66Gtop behave as before.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrecision rules:\u001b[22m re-checked every kernel;\u001b[47Gthere\u001b[53Gis\u001b[56Gno\u001b[59Gfloat64\u001b[67Gand\u001b[71Gno\u001b[74Gfast-math.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTried and rejected:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BCombining matrices without tiling\u001b[39"]
