[138.825, "\u001b[H\u001b[2G    \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[1C\u001b[1B\u001b[39m    \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22mUsage: python3 scratch/profile.py [e2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m  e2e    : drive `python3 run.py` over the protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22m           timing every command (median over repeats).\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m  phases : per-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m           (same kernels, Python-driven so each phase can be timed).\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b"]
[138.826, "[2m  8 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m\u2026 +176 lines \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Profiling shows a forward pass at about\u001b[43G10 ms/token (44.8 GB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[1C\u001b[1B I'm t\u001b[9Gying contiguous column\u001b[32Gtiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Tiling\u001b[10Ghelps\u001b[16G(\u22481.8\u001b[22Gms\u001b[25Gvs\u001b[28G2.0\u20132.7\u001b[36Gms),\u001b[41Gbut\u001b[45Gthe\u001b[49Gtimings\u001b[57Gare\u001b[61Gnoisy\u001b[67Gand\u001b[71Gdon't\u001b[77Gfollow\u001b[8"]
[138.827, "4Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[1C\u001b[1B m\u001b[5Gre\u001b[8Gtile size\u001b[18G that divide 32000,\u001b[38Ginterleaved,\u001b[51Gusing the\u001b[61G2-row\u001b[67Gkernel:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Interleaved classifier\u001b[26Gtile-size\u001b[36Gbenchmark\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/bench_cls2.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport sys, os, time, statistics, numpy as np\u001b[52G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102msys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport run\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfrom numba import njit\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mF32 = np.float32\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m@njit(boundscheck=False)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mdef cls_tiled(out, x, wtiles):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mnt = wtiles.shape[0]; T = wt\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[39m \u001b[38;2;238;142;110mFluttering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(2m 10s \u00b7 \u2193"]
[138.828, "\u001b[27G10.0k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G   \u001b[40G   \u001b[44G                             \u001b[74G        \u001b[83G  \u001b[86G                 \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
