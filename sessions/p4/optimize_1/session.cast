[167.588, "\u001b[H\u001b[2G\u001b[38;2;102;102;102mMeasure single-core streaming bandwidth ceiling\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m cat > scratch/b\u001b[20Gnch_bw.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport numpy as np, time, statistics\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfrom numba\u001b[15Gimport\u001b[22Gnjit\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mF32 = np.float32\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m@njit(boundscheck=False)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef stream(out, w):  # out[i] += w[j, i]: pure streaming read,\u001b[67Gvectorized,\u001b[79Gout\u001b[83Gin\u001b[86GL1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for j in range(w.shape[0]):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      r = w[j]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      for\u001b[16Gi\u001b[18Gin\u001b[21Grange(w.shap"]
[167.589, "e[1]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          out[i] += r[i]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m@njit(boundscheck=False)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef stream2(out,\u001b[21Gw):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mj\u001b[10G=\u001b[12G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     while j + 2 <= w.shape[0]:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mr0\u001b[15G=\u001b[17Gw[j];\u001b[23Gr1\u001b[26G=\u001b[28Gw[j\u001b[32G+\u001b[34G1]\r\u001b[1B \u001b[2m\u2502\u001b[22m         for i in\u001b[21Grange(w.shape[1]):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G      \u001b[14G  v = out[i]; v += r0[i]; v += r1[i]; out[i] =\u001b[61Gv\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mj\u001b[14G+=\u001b[17G2\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m a = np.ones((100000,\u001b[25G1024),\u001b[32GF32)\u001b[38G#\u001b[40G410\u001b[44GMB,\u001b[48Glike\u001b[53Gone\u001b[57Gtoken's\u001b[65Gweights\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mout\u001b[8G=\u001b[10Gnp.zeros(1024,\u001b[25GF32);\u001b[31Gstream(out,\u001b[43Ga[:10]);\u001b[52Gstream2(out,\u001b[65Ga[:10])\r\u001b[1B \u001b[2m\u2502\u001b[22m for nam\u001b[12G, f\u001b[16Gin (('numba\u001b[28Gstream u1', lambda: s\u001b[50Gream(out, a)), ('numba stream u2', lambda: str\u001b[98Gm2(out, a)), ('numpy\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m sum', \u001b[11Gambda: a.sum())):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mts\u001b[11G=\u001b[13G[]\r\u001b[1C\u001b[1B\u001b[2m"]
