[645.88, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading takes about the \u001b[28Game time in both versions within \u001b[62Gne process,\u001b[74Gso th\u001b[80G extra\u001b[87Gcost comes from first-touch\u001b[115Gpage\r\u001b[2C\u001b[1Bfaults in fresh pro\u001b[23Gesses u\u001b[31Gder memor\u001b[42Gpressure. I'm now comparing the two versions in\u001b[90Gfresh\u001b[96Gprocesses,\u001b[107Gand\r\u001b[2C\u001b[1Bmemory-mapping\u001b[18Gthe\u001b[22Gcheckpoint\u001b[33Gis\u001b[36Ga\u001b[38Gway\u001b[42Gto\u001b[45Gavoid\u001b[51Gthe\u001b[55G438\u001b[59GMB\u001b[62Gof\u001b[65Gfresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe memmap sourc\u001b[20G wins in fresh processes (about 0.40 s versus 0.48\u20130.80 s), so I'm switching\u001b[97Gto\u001b[100Git\u001b[103Gand\u001b[107Gusing\u001b[113Gthe\r\u001b[2C\u001b[1Bfaster\u001b[10Gbranch-free\u001b[22G16\u00d716\u001b[28Gcopy\u001b[33Gfor\u001b[37Gfull\u001b[42Gtiles,\u001b[49Gwith\u001b[54Ga\u001b[56Ggeneric\u001b[64Gpath\u001b[69Gfor\u001b[73Gany\u001b[77Gpadded\u001b[84Gtail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling and\u001b[14Gpadding\u001b[22Gcheck\u001b"]
[645.882, "[28Gout, and the fresh-process load is dow\u001b[67G to about 0.37 s. Next I'll run a whole-model\u001b[K\r\u001b[2C\u001b[1Bcomparison again\u001b[20Gt v1 on a small\u001b[36Gsynthetic\u001b[46Gcheckpoint\u001b[57Gcovering\u001b[66Gnon-multiple-of-128\u001b[86Gdimensions,\u001b[98Ggrouped-query\u001b[112Gattention\r\u001b[2C\u001b[1Band\u001b[7Gunshared\u001b[16Gclassifier\u001b[27Gweights.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe v2 output matches v1 bit-for-b\u001b[38Gt on all three synthetic shape\u001b[69G,\u001b[71Gcovering padding, grouped-query attention\u001b[113Gand\u001b[117Gthe\r\u001b[2C\u001b[1Bunshared\u001b[12Gclassifier.\u001b[24GNext\u001b[29GI'm\u001b[33Grunning\u001b[41Gthe\u001b[45Gfull\u001b[50Gcheck,\u001b[57Gthe\u001b[61Gedge-case\u001b[71Gtests\u001b[77Gand\u001b[81Gthe\u001b[85Gend-to-end\u001b[96Gprofile.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEv\u001b[6Grything pas\u001b[18Ges, and the 1024-po\u001b[38Gition runs dropped\u001b[57Gfrom\u001b[62Gabout\u001b[68G15.8\u001b[73Gs\u001b[75Gto\u001b[78G10.8\u001b[83Gs.\u001b[86GRe-verifying\u001b[99Gthe\u001b[103Gprecision\u001b[113Grules\u001b[119Gon\r\u001b[2C\u001b[1"]
[645.882, "Bthe\u001b[7Gnew\u001b[11Gkernels\u001b[19G(no\u001b[23Gfloat64,\u001b[32Gno\u001b[35Gfast-math\u001b[45Gflags):\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe new kernels are compliant. Saving the final profile as evidence:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
