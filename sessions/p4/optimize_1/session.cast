[168.158, "\u001b[H\u001b[2G    \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m\u2026 +176 lines \u001b[20G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Pro\u001b[7Giling sh\u001b[16Gws a forward pass\u001b[34Gat\u001b[37Gabout 10\u001b[46Gms/token (44.8\u001b[61GGB/s); the classifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[1C\u001b[1B I'm\u001b[7Gtrying\u001b[14Gcontiguous column tiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Tiling helps (\u22481.8 ms vs 2.0\u20132.7\u001b[36Gms),\u001b[41Gbut\u001b[45Gthe\u001b[49Gtimings\u001b[57Gare\u001b[61Gnoisy\u001b[67Gand\u001b[7"]
[168.159, "1Gdon't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[1C\u001b[1B more\u001b[8Gtil\u001b[12G sizes that divide\u001b[31G32000,\u001b[38Ginterleaved,\u001b[51Gusing\u001b[57Gthe\u001b[61G2-row\u001b[67Gkernel:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Small\u001b[9Gtiles of\u001b[18G256\u20131280 columns bring\u001b[41Gthe\u001b[45Gclassifier\u001b[56Gto\u001b[59Gabout\u001b[65G1.9\u001b[69Gms,\u001b[73Gso\u001b[76GI'm\u001b[80Gusing\u001b[86Gthe\u001b[90Glargest\u001b[98Gdivisor\u001b[106Gof\u001b[109Gvocab\u001b[115Gup\u001b[118Gto\r\u001b[1C\u001b[1B 1280\u001b[8Gand\u001b[12Gfalling\u001b[20Gback to\u001b[28Gzero-padding when none exists.\u001b[59GNext\u001b[64GI'll\u001b[69Gmeasure\u001b[77Gthe\u001b[81Gsingle-core\u001b[93Gread-bandwidth\u001b[108Gceiling\u001b[116Gto\r\u001b[1C\u001b[1B see\u001b[7Ghow\u001b[11Gmuch headroom\u001b[25Gremains.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Measuri\u001b[11Gg single-core\u001b[25Gstreaming bandwidth ceiling\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/bench_bw.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport numpy as np, time, statistics\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mfrom numba im"]
