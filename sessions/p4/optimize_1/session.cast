[134.097, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm profiling o\u001b[19G an M1 with 8 GB and a load\u001b[47Gaverage\u001b[55Gnear\u001b[60G3,\u001b[63Gso\u001b[66GI'll\u001b[71Grely\u001b[76Gon\u001b[79Gbest-of/median\u001b[94Gtimings.\u001b[103GI'm\u001b[107Gbuilding\u001b[116Gtwo\r\u001b[2C\u001b[1Bprofiler parts: end-to-end timing of the dev workload and a per-phase breakdown of one forward pass.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/profile.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m lines to \u001b[1mscratch/profile.py\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsage:\u001b[17Gpython3 scratch/profile.py [e2\u001b[48G|phas\u001b[54Gs|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22m  e2e    : drive `python3 run.py` over the prot"]
[134.098, "ocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m      \u001b[17G    timing eve\u001b[32Gy command (median over repeats).\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 6\u001b[10G\u001b[22m  phases : per-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +176 lines \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Profiling shows a forward pass at about\u001b[43G10\u001b[46Gms/token\u001b"]
[134.099, "[55G(44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[2C\u001b[1BI'm trying contiguous column tiles to keep its outputs\u001b[58Gin\u001b[61GL1.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling helps (\u22481.8 ms\u001b[25Gvs\u001b[28G2.0\u20132.7\u001b[36Gms),\u001b[41Gbut\u001b[45Gthe\u001b[49Gtimings\u001b[57Gare\u001b[61Gnoisy\u001b[67Gand\u001b[71Gdon't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[2C\u001b[1Bmore tile sizes that divide\u001b[31G32000,\u001b[38Ginterleaved,\u001b[51Gusing\u001b[57Gthe\u001b[61G2-row\u001b[67Gkernel:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
