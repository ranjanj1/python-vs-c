[522.849, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcat\u001b[8G>\u001b[10Gscratch/fresh_load.py\u001b[32G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import os, sys, time\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mROOT\u001b[9G=\u001b[11Gos.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\u001b[1B \u001b[2m\u2502\u001b[22m sys.path.ins\u001b[17Grt(0, ROOT); os.chdir(ROOT)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import numpy as np\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmode\u001b[9G=\u001b[11Gsys.argv[1]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m if mode == 'memmap':\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mnp.fromfile\u001b[20G=\u001b[22Glambda\u001b[29Gpath,\u001b[35Gdtype,\u001b[42Goffset:\u001b[50Gnp.memmap(path,\u001b[66Gdtype=dtype,\u001b[79Gmode='r',\u001b[89Goffset=offset)\r\u001b[1B \u001b[2m\u2502\u001b[22m import\u001b[11Grun\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m t = time.perf_count\u001b[24Gr();\u001b[29Gm = \u001b[34Gun.M\u001b[39Gdel('model.bin\u001b[54G); print(f'{mode:8s} M\u001b[77Gdel() {time.pe\u001b[92Gf_counter()-t:.3f}s')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gi\u001b[10Gin\u001b[13G1\u001b[15G2\u001b[17G3;\u001b[20Gdo\u001b[23Gpython3\u001b[31Gscratch/fresh_load.py\u001b[53Gfromfile;\u001b[63Gp"]
