[212.388, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling helps (\u22481.8 ms\u001b[25Gvs\u001b[28G2.0\u20132.7\u001b[36Gms),\u001b[41Gbut\u001b[45Gthe\u001b[49Gtimings\u001b[57Gare\u001b[61Gnoisy\u001b[67Gand\u001b[71Gdon't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[2C\u001b[1Bmore\u001b[8Gtile\u001b[13Gsizes\u001b[19Gthat\u001b[24Gdivide\u001b[31G32000,\u001b[38Ginterleaved,\u001b[51Gusing\u001b[57Gthe\u001b[61G2-row\u001b[67Gkernel:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSmall\u001b[9Gtiles\u001b[15Gof\u001b[18G256\u20131280\u001b[27Gcolumns\u001b[35Gbring\u001b[41Gthe\u001b[45Gclassifier\u001b[56Gto\u001b[59Gabout\u001b[65G1.9\u001b[69Gms,\u001b[73Gso\u001b[76GI'm\u001b[80Gusing\u001b[86Gthe\u001b[90Glargest\u001b[98Gdivisor\u001b[106Gof\u001b[109Gvocab\u001b[115Gup\u001b[118Gto\r\u001b[1B \u001b[3G1280 and falling back to\u001b[28Gzero-padding\u001b[41Gwhen\u001b[46Gnone\u001b[51Gexists.\u001b[59GNext\u001b[64GI'll\u001b[69Gmeasure\u001b[77Gthe\u001b[81Gsingle-core\u001b[93Gread-bandwidth\u001b[108Gceiling\u001b[116Gto\r\u001b[1B  see h\u001b[9Gw much\u001b[16Gheadroom\u001b[25Gremains.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe layer matmuls alread"]
[212.389, "y\u001b[29Grun\u001b[33Gnear\u001b[38Gthe\u001b[42Gone-core\u001b[51Gceiling\u001b[59Gof\u001b[62Gabout\u001b[68G56\u001b[71GGB/s,\u001b[77Gso\u001b[80Gthe\u001b[84Gremaining\u001b[94Ggains\u001b[100Gare\u001b[104Gin\u001b[107Gthe\r\u001b[2C\u001b[1Bclassifier, fused q/k/v and w1/w3 kernels, and some attention and RoPE work. I'm prototyping\u001b[96Ga\u001b[98Gnew\u001b[102Gforward\u001b[110Gpass\u001b[115Gthat\r\u001b[2C\u001b[1Bmust produce bitwise-identical\u001b[34Glogits.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/proto.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m167\u001b[22m lines to \u001b[1mscratch/proto.py\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Prototype forward variants vs run.forward on the dev sequence: bitwise equality + interleaved timing.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m    \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math, os, sys, time, statistics, json\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2"]
