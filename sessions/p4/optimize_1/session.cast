[573.95, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mtile_into\u001b[13G\u001b[39mtakes\u001b[19G0.76\u001b[24Gs\u001b[26Gon\u001b[29Gthe\u001b[33Greal\u001b[38Gweights,\u001b[47Gversus\u001b[54Gabout\u001b[60G0.15\u001b[65Gs\u001b[67Gpredicted,\u001b[78Gbecause\u001b[86Gthe\u001b[90Gmachine\u001b[98Gis\u001b[101Gshort\u001b[107Gon\u001b[110Gmemory\u001b[117Gwith\r\u001b[1B \u001b[3Gheavy compression\u001b[21G I'm\u001b[26Gcomparing old and new loading back to back next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading\u001b[11Gtakes\u001b[17Gabout\u001b[23Gthe\u001b[27Gsame\u001b[32Gtime\u001b[37Gin\u001b[40Gboth\u001b[45Gversions\u001b[54Gwithin\u001b[61Gone\u001b[65Gprocess,\u001b[74Gso\u001b[77Gthe\u001b[81Gextra\u001b[87Gcost\u001b[92Gcomes\u001b[98Gfrom\u001b[103Gfirst-touch\u001b[115Gpage\r\u001b[1B \u001b[3Gfaults in fresh processe\u001b[28G under memory pressure. I'm now c\u001b[62Gmparing the\u001b[74Gtwo v\u001b[80Grsions\u001b[87Gin fresh processes, and\u001b[K\r\u001b[2C\u001b[1Bmemory-mapping the \u001b[23Gheckpoi\u001b[31Gt is a wa\u001b[42Gto avoid the 438 MB of fresh anonymous memory.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102"]
[573.951, "mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gmemmap\u001b[14Gsource\u001b[21Gwins\u001b[26Gin\u001b[29Gfresh\u001b[35Gprocesses\u001b[45G(about\u001b[52G0.40\u001b[57Gs\u001b[59Gversus\u001b[66G0.48\u20130.80\u001b[76Gs),\u001b[80Gso\u001b[83GI'm\u001b[87Gswitching\u001b[97Gto\u001b[100Git\u001b[103Gand\u001b[107Gusing\u001b[113Gthe\r\u001b[1B \u001b[3Gfaster branch-fr\u001b[20Ge 16\u00d716 copy for full tiles, with a generic path for any padded tail.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling\u001b[10Gand\u001b[14Gpadding\u001b[22Gcheck\u001b[28Gout,\u001b[33Gand\u001b[37Gthe\u001b[41Gfresh-process\u001b[55Gload\u001b[60Gis\u001b[63Gdown\u001b[68Gto\u001b[71Gabout\u001b[77G0.37\u001b[82Gs.\u001b[85GNext\u001b[90GI'll\u001b[95Grun\u001b[99Ga\u001b[101Gwhole-model\r\u001b[1B \u001b[3Gcomparison\u001b[14Gagainst\u001b[22Gv1 on\u001b[28Ga small synthetic checkpoint covering \u001b[67Gon-multiple-of-128 dimensions, grouped-query attention\r\u001b[2C\u001b[1Band unshared cla\u001b[20Gsifier weights.\u001b[36G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mTesting\u001b[11Gawkward\u001b[19Gshapes\u001b[26Gvs\u001b[29Gv1\u001b[32Gon\u001b[35Gsynthetic\u001b[45Gmodels\u001b[38;2;102;102;102m \u00b7"]
[573.951, " 3s\r\u001b[1B  \u23bf  $ cat > scratch/test_synthetic.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m\"\"\"Synthetic \u001b[21Geckpoint with awkward shapes (padding, GQA, unshared classifier): new forward vs v1, bitwise.\"\"\"\r\u001b[5C\u001b[1Bimport os, sys, struct,\u001b[30Gtempfile, importlib.util\u001b[39m\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;102;102;102mnumpy as\u001b[22Gnp\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mROOT =\u001b[13Gos.\u001b[17Gath.dirname(os.path.dirname(os.path.abspath(__file__)))\r\u001b[5C\u001b[1Bsys.path.i\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[574.119, "\u001b[H\r\u001b[53C\u001b[24B\u001b[38;2;102;102;102m4\u001b[39m\u001b[40;1H\u001b[38;3H"]
[574.151, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcopy\u001b[12Gkernel\u001b[19Gaccounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mtile_into\u001b[39m takes 0\u001b[21G76 s\u001b[26Gon the real weights, versus about 0.15 s predicted,\u001b[78Gbecause\u001b[86Gthe\u001b[90Gmachine\u001b[98Gis\u001b[101Gshort\u001b[107Gon\u001b[110Gmemory\u001b[117Gwith\r\u001b[2C\u001b[1Bheavy\u001b[9Gcompression.\u001b[22GI'm\u001b[26Gcomparing\u001b[36Gold\u001b[40Gand\u001b[44Gnew\u001b[48Gloading\u001b[56Gback\u001b[61Gto\u001b[64Gback\u001b[69Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading takes about the \u001b[28Game time in both versions within \u001b[62Gne process,\u001b[74Gso th\u001b[80G extra\u001b[87Gcost comes from first-touch\u001b[115Gpage\r\u001b[2C\u001b[1Bfaults in fresh pro\u001b[23Gesses u\u001b[31Gder memor\u001b[42Gpressure. I'm now comparing the two versions in\u001b[90Gfresh\u001b[96Gprocesses,\u001b["]
[574.151, "107Gand\r\u001b[2C\u001b[1Bmemory-mapping\u001b[18Gthe\u001b[22Gcheckpoint\u001b[33Gis\u001b[36Ga\u001b[38Gway\u001b[42Gto\u001b[45Gavoid\u001b[51Gthe\u001b[55G438\u001b[59GMB\u001b[62Gof\u001b[65Gfresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe memmap sourc\u001b[20G wins in fresh processes (about 0.40 s versus 0.48\u20130.80 s), so I'm switching\u001b[97Gto\u001b[100Git\u001b[103Gand\u001b[107Gusing\u001b[113Gthe\r\u001b[2C\u001b[1Bfaster\u001b[10Gbranch-free\u001b[22G16\u00d716\u001b[28Gcopy\u001b[33Gfor\u001b[37Gfull\u001b[42Gtiles,\u001b[49Gwith\u001b[54Ga\u001b[56Ggeneric\u001b[64Gpath\u001b[69Gfor\u001b[73Gany\u001b[77Gpadded\u001b[84Gtail.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling and\u001b[14Gpadding\u001b[22Gcheck\u001b[28Gout, and the fresh-process load is dow\u001b[67G to about 0.37 s. Next I'll run a whole-model\u001b[K\r\u001b[2C\u001b[1Bcomparison again\u001b[20Gt v1 on a small\u001b[36Gsynthetic\u001b[46Gcheckpoint\u001b[57Gcovering\u001b[66Gnon-multiple-of-128\u001b[86Gdimensions,\u001b[98Ggrouped-query\u001b[112Gattention\r\u001b[2C\u001b[1Band\u001b[7Gunshared\u001b[16Gclassifier\u001b[27Gweights.\r\u001b[1B\u001b[K"]
