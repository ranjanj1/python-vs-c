[284.941, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[8G\u001b[22mT\u001b[10G=\u001b[12Gwt.shape[3]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gl\u001b[14Gin\u001b[17Grange(wt.shape[0]):\r\u001b[1B \u001b[2m\u2502\u001b[22m         for t in range(wt.shape[1]):\r\u001b[1B \u001b[2m\u2502\u001b[22m        \u001b[12G   \u001b[16Go = ou\u001b[23G[t*T:(t+1)*T]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          if k == 1: mm1(o, x, wt[l, t])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m       \u001b[16Gelif\u001b[21Gk\u001b[23G==\u001b[26G2:\u001b[29Grun.matmul_t(o,\u001b[45Gx,\u001b[48Gwt[l,\u001b[54Gt])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          else: mm4(o, x, wt[l, t])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm\u001b[6G= run.Model('model.bin')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef tile(w, T):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  L, n, d = w.shape\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  return np.ascontiguousarray(w.reshape(L,\u001b[49Gn,\u001b[52Gd\u001b[54G//\u001b[57GT,\u001b[60GT).transpose(0,\u001b[76G2,\u001b[79G1,\u001b[82G3))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcases = {}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor name, w in (('w1', m.w1),\u001b[34G('w2',\u001b[41Gm.w2),\u001b[48G('cls',\u001b[56Gm.wcls[None])):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  n, d = w.shape[1], w.shape[2]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  x = np.random.default_rng(2).standard_normal(n).a"]
[284.942, "stype(F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12GT\u001b[14Gin\u001b[17G(128,\u001b[23G256):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         wt = tile(w,\u001b[25GT)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gk\u001b[18Gin\u001b[21G(1,\u001b[25G2,\u001b[28G4):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G         ca\u001b[19Ges[f'{name} T={T} u{k}'] = (tiled, (np.zer\u001b[62Gs(d, F32), x, wt, k), w.nbytes)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     del wt\u001b[15G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mR\u001b[6G=\u001b[8G{c:\u001b[12G[]\u001b[15Gfor\u001b[19Gc\u001b[21Gin\u001b[24Gcases}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for f, a, _ in cases.values():\u001b[35Gf(*a)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8G_\u001b[10Gin\u001b[13Grange(10):\r\u001b[1B \u001b[2m\u2502\u001b[22m     for c, (f, a, _) in cases.i\u001b[36Gems():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G  t = time.perf_counter(); f(*a);\u001b[44GR[c].append(time.perf_counter()\u001b[76G-\u001b[78Gt)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gc,\u001b[11G(f,\u001b[15Ga,\u001b[18Gnb)\u001b[22Gin\u001b[25Gcases.items():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f'{c:16s}\u001b[24Gmedian\u001b[31G{statistics.median(R[c])*1e3:7.3f}\u001b[66Gms\u001b[70Gmin\u001b[74G{min(R[c])*1e3:7.3f}\u001b[96G{nb/min(R[c])/1e9:5.1f}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mGB/s')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b["]
