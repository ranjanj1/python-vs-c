[118.96, "\u001b[H\r\u001b[33B\u001b[38;2;150;108;30m\u001b[1m\u2733\u001b[22m\u001b[39m\u001b[40;1H\u001b[38;3H"]
[119.096, "\u001b[H\r\u001b[2B  \u001b[38;2;102;102;102mListed \u001b[1m1\u001b[22m directory \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The fixtures in \u001b[38;2;87;105;247mfixtures.json\u001b[39m are the development workloads, so I'll profile the 9 ENCODE strings and the three\u001b[K\r\u001b[2C\u001b[1Bprompts\u001b[11Grun\u001b[15Gas\u001b[18GGENERATE\u001b[27G64\u001b[30Gand\u001b[34GLOGITS\u001b[41Gover\u001b[46G69\u201382\u001b[52Gpositions.\u001b[63GChecking\u001b[72Gthe\u001b[76Gmachine\u001b[84Gfirst.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI'm \u001b[8Grofiling on an M1 with 8 GB and a load average near 3,\u001b[63Gso I'll rely\u001b[76Gon best-of/median\u001b[94Gtimings.\u001b[103GI'm\u001b[107Gbuilding\u001b[116Gtwo\r\u001b[2C\u001b[1Bprofiler\u001b[12Gparts:\u001b[19Gend-to-end\u001b[30Gtiming\u001b[37Gof\u001b[40Gthe\u001b[44Gdev\u001b[48Gworkload\u001b[57Gand\u001b[61Ga\u001b[63Gper-phase\u001b[73Gbreakdown\u001b[83Gof\u001b[86Gone\u001b[90Gforward\u001b[98Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/profile.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m li\u001b[19Ges to \u001b[1mscratch/profile.py\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2"]
[119.097, "m  1 \u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22mUsage: python3 scratch/profile.py [e2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m  e2e    : drive `python3 run.py` over the protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m           timing every command (median over repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22m  phases : per-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22m      \u001b[17G    (same kernels, Python-driv\u001b[48Gn so \u001b[54Gach phase can be timed).\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimp"]
[119.097, "ort\u001b[17G\u001b[38;2;51;51;51mjson, os, subp\u001b[32Gocess, sys, tempfile, time, statistics\r\u001b[6C\u001b[1B\u001b[2m10\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling shows a\u001b[21Gforward\u001b[29Gpass\u001b[34Gat\u001b[37Gabout\u001b[43G10\u001b[46Gms/token\u001b[55G(44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gtrying\u001b[14Gcontiguous\u001b[25Gcolumn\u001b[32Gtiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u2733\u001b[3GFluttering\u2026 \u001b[27G\u001b[38;2;102;102;102m8\u001b[29G4\u001b[41G\u001b[38;2;153;153;153mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
[119.105, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 24s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
