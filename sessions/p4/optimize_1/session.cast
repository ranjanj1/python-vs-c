[236.577, "proto.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m167\u001b[22m lines to \u001b[1mscratch/proto.py\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;24;54;145m\"\"\"Prototype forward variants vs run.forward on the dev sequence: bitwise equality + interleaved timing.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m    \u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math, os, sys, time, statistics, json\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22msys.path.insert(\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m run\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m\u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m nu\u001b[18Gba \u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m njit\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mF32 = np.float32\u001b[39m\u001b[K\r\u001b[7C\u001b[1"]
