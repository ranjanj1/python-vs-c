[163.842, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/profile.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m lines to \u001b[1mscratch/profile.py\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsage: python3 scratch/profile.py\u001b[44G[e2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22me2e\u001b[19G:\u001b[21Gdriv\u001b[27G`python3\u001b[36Grun.py` over the\u001b[53Gprotocol \u001b[63Gxactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m           timing every command (median over repeats).\r\u001b[7C\u001b[1B\u001b[2m6\u001b[10G\u001b[22m  phases : per-phase breakdown of\u001b[44Gone \u001b[49Gorward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[6C\u001b[1B\u001b[38;2;"]
[163.843, "51;51;51m\u001b[2m 7\u001b[10G\u001b[22m      \u001b[17G    (same kernels, Python-driven so each phase can be timed).\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling shows a forward\u001b[29Gpass\u001b[34Gat\u001b[37Gabout\u001b[43G10\u001b[46Gms/token\u001b[55G(44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gtrying\u001b[14Gcontiguous\u001b[25Gcolumn\u001b[32Gtiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling helps (\u22481.8 ms vs 2.0\u20132.7\u001b[36Gms), but the\u001b"]
[163.844, "[49Gtimings\u001b[57Gare\u001b[61Gnoisy\u001b[67Gand\u001b[71Gdon't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[1B  more tile sizes that divide 32000, interleaved,\u001b[51Gusing\u001b[57Gthe\u001b[61G2-row\u001b[67Gkernel:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSmall tiles of 256\u20131280 columns\u001b[35Gbring\u001b[41Gthe\u001b[45Gclassifier\u001b[56Gto\u001b[59Gabout\u001b[65G1.9\u001b[69Gms,\u001b[73Gso\u001b[76GI'm\u001b[80Gusing\u001b[86Gthe\u001b[90Glargest\u001b[98Gdivisor\u001b[106Gof\u001b[109Gvocab\u001b[115Gup\u001b[118Gto\r\u001b[2C\u001b[1B1280 and falling back\u001b[25Gto\u001b[28Gzero-padding\u001b[41Gwhen\u001b[46Gnone\u001b[51Gexists.\u001b[59GNext\u001b[64GI'll\u001b[69Gmeasure\u001b[77Gthe\u001b[81Gsingle-core\u001b[93Gread-bandwidth\u001b[108Gceiling\u001b[116Gto\r\u001b[2C\u001b[1Bsee how much headroom remains.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u273d\u001b[3GFluttering\u2026 \u001b[28G\u001b[38;2;102;102;102m2\u001b[30G1\u001b[42G\u001b[38;2;177;177;177mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
