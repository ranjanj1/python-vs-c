[124.963, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[39m I'm profiling on an\u001b[23GM1\u001b[26Gwith\u001b[31G8\u001b[33GGB\u001b[36Gand\u001b[40Ga\u001b[42Gload\u001b[47Gaverage\u001b[55Gnear\u001b[60G3,\u001b[63Gso\u001b[66GI'll\u001b[71Grely\u001b[76Gon\u001b[79Gbest-of/median\u001b[94Gtimings.\u001b[103GI'm\u001b[107Gbuilding\u001b[116Gtwo\r\u001b[1C\u001b[1B profiler\u001b[12Gparts:\u001b[19Gend-to-end\u001b[30Gtiming\u001b[37Gof\u001b[40Gthe\u001b[44Gdev\u001b[48Gworkload\u001b[57Gand\u001b[61Ga\u001b[63Gper-phase\u001b[73Gbreakdown\u001b[83Gof\u001b[86Gone\u001b[90Gforward\u001b[98Gpass.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mWrite\u001b[22m(scratch/profile.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m186\u001b[22m lines to \u001b[1mscratch/profile.py\u001b[22m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22mUsage: python3 scratch/profile.py [e2e|phases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22m  e2e    : drive `python3 run.py` over the protocol exac"]
[124.964, "tly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22m           timing every command (median over repeats).\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m  phases : per-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G \u001b[6G\u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m json, os, subprocess, sys, tempfile, time, statistics\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m\u2026 +176 lines \u001b[20G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b"]
[124.965, "[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Profiling\u001b[13Gshows a forward pass\u001b[34Gat about 10 m\u001b[48G/token\u001b[55G(44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[1C\u001b[1B I'm trying contig\u001b[21Gous column tiles to keep its outputs in L1.\u001b[66G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmarki\u001b[14Gg tiled classifier layout\u001b[40G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/bench_cls.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport sys, os, time, statistics, numpy as np\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102msys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport run\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfrom numba import njit\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mF32 = np.float32\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m@njit(boundscheck=False)\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mdef cls_tiled(out, x, wtiles, k):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102m# wtiles"]
[124.966, ": (n_tiles, n, T) \u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2722\u001b[39m \u001b[38;2;241;145;113mFluttering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(1m 57s \u00b7 \u2193\u001b[27G8.8k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G   \u001b[40G   \u001b[44G                            \u001b[73G        \u001b[82G  \u001b[85G                  \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
