[495.892, "e\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mTime\u001b[7Gsteps inside model loading\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m python3 - <<'EOF'\u001b[22G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import time,\u001b[17Gnum\u001b[21Gy as np, \u001b[31Gun\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22morig\u001b[9G=\u001b[11Grun.tile_into\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m acc = {'tile_into':\u001b[24G0.0}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gtimed(*a):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G t = time.perf_counter(); r = orig(*a); acc['tile_into']\u001b[64G+=\u001b[67Gtime.perf_counter() - t; re\u001b[95Gurn r\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5Gun.\u001b[9Gile_into = timed\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22morig_empty\u001b[15G=\u001b[17Gnp.empty\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m acc['np.empty'] = 0.0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22"]
[495.893, "mdef\u001b[8Gte(*a,\u001b[15G**k):\r\u001b[1B \u001b[2m\u2502\u001b[22m     t = time.perf_counter();\u001b[33Gr\u001b[35G= orig_empty(*a, **k); acc['np.empty'] += time.perf_counter() -\u001b[99Gt; re\u001b[105Gurn r\u001b[111G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m run.np.empty\u001b[17G=\u001b[19Gt\u001b[21G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt\u001b[6G=\u001b[8Gtime.perf_counter();\u001b[29Gm\u001b[31G=\u001b[33Grun.Model('model.bin');\u001b[57Gtot\u001b[61G=\u001b[63Gtime.perf_counter()\u001b[83G-\u001b[85Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m run.np.empty = orig_empty\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f'Model()\u001b[20Gtotal\u001b[26G{tot:.3f}s',\u001b[39G{k:\u001b[43Ground(v,\u001b[52G3)\u001b[55Gfor\u001b[59Gk,\u001b[62Gv\u001b[64Gin\u001b[67Gacc.items()})\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mvm_stat\u001b[12G|\u001b[14Gegrep\u001b[20G\"free|compress|Swap\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[495.894, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
