[444.57, "to-end\u001b[50Gand\u001b[54Gstartup:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Startup breakdown a\u001b[23Gd end-to-end profile\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport time; t=time.time()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport numpy, numba; t0=time.time()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport run; t1=time.time()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mm = run.Model('model.bin'); t2=time.time()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mtk = run.Tokenizer('tokenizer.bin', m.vocab); t3=time.time()\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mm.forward(1,0); run.argmax(m.logits); m.reset(); t4=time.time()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mprint(f'import numpy+\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;230;134;102mFluttering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(7m 9s \u00b7 \u2193\u001b[26G37.2k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G             "]
