[360.082, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe prototype is\u001b[20Gbitwise\u001b[28Gidentical\u001b[38Gbut\u001b[42Gno\u001b[45Gfaster\u001b[52G(9.2\u001b[57Gms/token\u001b[66Gboth\u001b[71Gways),\u001b[78Gand\u001b[82Gits\u001b[86Gduplicate\u001b[96Gweight\u001b[103Gcopies\u001b[110Gmight\r\u001b[2C\u001b[1Bstrain\u001b[10Gthis\u001b[15G8\u001b[17GGB\u001b[20Gmachine.\u001b[29GI'm\u001b[33Gmeasuring\u001b[43Geach\u001b[48Gchange\u001b[55Gon\u001b[58Gits\u001b[62Gown\u001b[66Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusing\u001b[11Gurned\u001b[17Gout slower,\u001b[29Gwhile tiling the classifier helped (abou\u001b[70G 1.9\u001b[75Gms\u001b[78Gversus\u001b[85G2.2\u001b[89Gms),\u001b[94Gso\u001b[97GI'm\u001b[101Gtesting\u001b[109Gcolumn\r\u001b[2C\u001b[1Btiling\u001b[10Gon\u001b[13Gthe\u001b[17Glayer\u001b[23Gmatrices\u001b[32Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCo\u001b[6Gumn\u001b[10Gtiles of 128\u2013256 hit abou\u001b[36G 60\u001b[40GGB/s\u001b[45Gon\u001b[48Gevery\u001b[54Glayer\u001b[60Gshape,\u001b[67Gbeating\u001b[75Gthe\u001b[79G56\u001b[82GGB/s\u001b[87Gprobe\u001b[93Gwith\u001b[98Gbitwise-identical\r\u001b[2C\u001b[1Bresults.\u001b[12GNext\u001b[17GI'm\u001b[21Gchecking\u001b[30Gthe\u001b[34Gunro"]
[360.083, "ll\u001b[41Gfactor\u001b[48Ginside\u001b[55Gtiles\u001b[61Gand\u001b[65Gthe\u001b[69Gclassifier\u001b[80Gat\u001b[83GT=256.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWith T=128 and a 4-row u\u001b[28Groll,\u001b[34Gevery matrix now hits about 62\u001b[65GGB/s, so I'm moving the design\u001b[96Gto\u001b[99Gcolumn\u001b[106Gtiles\u001b[112Gbuilt\u001b[118Gat\r\u001b[2C\u001b[1Bload\u001b[8Gtime,\u001b[14Gfusing\u001b[21Gthe\u001b[25Gq/k/v\u001b[31Gand\u001b[35Gw1/w3\u001b[41Gcalls,\u001b[48Gprecomputing\u001b[61GRoPE\u001b[66Gper\u001b[70Gposition,\u001b[80Gand\u001b[84Gunrolling\u001b[94Gattention\u001b[104G2\u00d7.\u001b[108GI'll\u001b[113Gkeep\u001b[118Gthe\r\u001b[2C\u001b[1Bcurrent version as scratch/run_v1.py\u001b[40Gfor\u001b[44GA/B\u001b[48Gtesting\u001b[56Gand\u001b[60Grewrite\u001b[68Grun.py.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWriti\u001b[9Gg\u001b[11Gthe new\u001b[19Gkernels and the \u001b[38;2;87;105;247mModel\u001b[39m class.\u001b[48GThe tokenize\u001b[61G and protocol code\u001b[80Gare\u001b[84Gunchanged.\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102mead \u001b[1m1\u001b[22m fi\u001b[13Ge\u001b[15G\u001b[39m\u001b[K\r\u001b[2C\u001b[2BI fou\u001b[9Gd\u001b[11Ga bug: wh\u001b[21Gn a dimension\u001b[35G"]
