[205.998, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Profile run.py on the supplied development workloads (fixtures.json prompts, as check.py runs them).\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22mUsag\u001b[15G:\u001b[17Gpython3 scratc\u001b[32G/profile.py\u001b[44G[e2e|p\u001b[51Gases|\u001b[38;2;0;134;179mall\u001b[38;2;51;51;51m] [repeats]\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[12G\u001b[22me2e\u001b[19G:\u001b[21Gdrive `python3 run.py` over the protocol exactly like check.py --tokens \u001b[38;2;0;134;179m64\u001b[38;2;51;51;51m --prompts \u001b[38;2;0;134;179m3\u001b[38;2;51;51;51m,\r\u001b[7C\u001b[1B\u001b[2m5\u001b[12G\u001b[22m      \u001b[19G \u001b[21Gtiming every comma\u001b[40Gd (median ove\u001b[54G repeats).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[12G\u001b[22mphases\u001b[19G:\u001b[21Gper-phase breakdown of one forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m, calling run.py\u001b[38;2;24;54;145m's compiled kernels phase by phase\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22m           (same kernels, Python-driven so each phase can be timed).\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b["]
[206.0, "39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 9\u001b[17G\u001b[22mjson,\u001b[23Gos, subprocess, sys, tempfile, time, statistics\r\u001b[5C\u001b[1B\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +176 lines \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mProfiling sh\u001b[16Gws a forward pass at ab\u001b[40Gut 10\u001b[46Gms/t\u001b[51Gken (44.8\u001b[61GGB/s);\u001b[68Gthe\u001b[72Gclassifier\u001b[83Gtakes\u001b[89G30%\u001b[93Gof\u001b[96Gthat\u001b[101Gat\u001b[104Gonly\u001b[109G32\u001b[112GGB/s,\u001b[118Gso\r\u001b[2C\u001b[1BI'm\u001b[7Gtrying\u001b[14Gcontiguous\u001b[25Gcolumn\u001b[32Gtiles\u001b[38Gto\u001b[41Gkeep\u001b[46Gits\u001b[50Goutputs\u001b[58Gin\u001b[61GL1.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling h\u001b[12Glps (\u22481.8 ms vs 2.0\u2013\u001b[33G.7 ms), but th\u001b[48G timings\u001b[57Gar\u001b[61Gnoisy\u001b[67Gand don't\u001b[77Gfollow\u001b[84Gtile\u001b[89Gsize\u001b[94Gcleanly.\u001b[103GRe-running\u001b[114Gwith\r\u001b[2C\u001b[1Bmore\u001b[8Gtile\u001b[13Gsizes\u001b[19Gthat\u001b[24Gdivide\u001b[31G32000,\u001b[38Ginterleaved,"]
[206.002, "\u001b[51Gusing\u001b[57Gthe\u001b[61G2-row\u001b[67Gkernel:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSmall tiles of 256\u20131280 columns br\u001b[41Gt\u001b[44G classifier to\u001b[59Gabout 1.9\u001b[70Gs, so I'm u\u001b[85G the larg\u001b[95Gst divisor of vocab up to\r\u001b[2C\u001b[1B1280 and falling back\u001b[25Gto zero-padding\u001b[41Gwhen\u001b[46Gnone\u001b[51Gexists.\u001b[59GNext\u001b[64GI'll\u001b[69Gmeasure\u001b[77Gthe\u001b[81Gsingle-core\u001b[93Gread-bandwidth\u001b[108Gceiling\u001b[116Gto\r\u001b[2C\u001b[1Bsee\u001b[7Ghow\u001b[11Gmuch\u001b[16Gheadroom\u001b[25Gremains.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe layer matmuls\u001b[21Galready run near the one-core ceiling of about 56 GB/s, so\u001b[80Gthe\u001b[84Gremaining \u001b[95Gains are in the\u001b[K\r\u001b[2C\u001b[1Bclassifier, fused q/k/v and w1/w3 kernels,\u001b[46Gand\u001b[50Gsome\u001b[55Gattention\u001b[65Gand\u001b[69GRoPE\u001b[74Gwork.\u001b[80GI'm\u001b[84Gprototyping\u001b[96Ga\u001b[98Gnew\u001b[102Gforward\u001b[110Gpass\u001b[115Gthat\r\u001b[2C\u001b[1Bmust\u001b[8Gproduce\u001b[16Gbitwise-identical\u001b[34Glogits.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;171;43;63m\u273b"]
