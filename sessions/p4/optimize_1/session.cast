[441.27, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI\u001b[5Gfound a bug: when a dimension isn't a multiple\u001b[52Gof\u001b[55G128,\u001b[60Gthe\u001b[64Glast\u001b[69Gtile\u001b[74Gwrites\u001b[81Gpast\u001b[86Gthe\u001b[90Gslice\u001b[96Gend,\u001b[101Gso\u001b[104GI'm\u001b[108Gpassing\u001b[116Gthe\r\u001b[2C\u001b[1Bfull padded buffers to \u001b[38;2;87;105;247mforward\u001b[39m instead.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[16G\u001b[22m\u001b[38;2;167;29;93mdef\u001b[20G\u001b[38;2;121;93;163mforward\u001b[38;2;51;51;51m(\u001b[32G\u001b[38;2;0;134;179m, token, pos\u001b[38;2;51;51;51m):\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[20G\u001b[22mforward(token, pos, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.emb, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.rms_att, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.wqkv, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.wo, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.rms_ffn, \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.w13,\r\u001b[7C\u001b[1B\u001b[2m76\u001b[20G\u001b[22m      \u001b[27G \u001b[38;2;0;134;179mself\u001b[38;2;51;51;51m.w2, \u001b"]
