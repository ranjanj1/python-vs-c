[359.577, "37G60\u001b[40GGB/s\u001b[45Gon\u001b[48Gevery\u001b[54Glayer\u001b[60Gshape,\u001b[67Gbeating\u001b[75Gthe\u001b[79G56\u001b[82GGB/s\u001b[87Gprobe\u001b[93Gwith\u001b[98Gbitwise-identical\r\u001b[2C\u001b[1Bresults. Next I'm checking\u001b[30Gthe\u001b[34Gunroll\u001b[41Gfactor\u001b[48Ginside\u001b[55Gtiles\u001b[61Gand\u001b[65Gthe\u001b[69Gclassifier\u001b[80Gat\u001b[83GT=256.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWith T=128 and a 4-row unroll, ever\u001b[40Gmatrix now h\u001b[53Gts\u001b[57Gbout 62 GB/s, so I'm\u001b[78Gmoving\u001b[85Gthe\u001b[89Gdesign\u001b[96Gto\u001b[99Gcolumn\u001b[106Gtiles\u001b[112Gbuilt\u001b[118Gat\r\u001b[2C\u001b[1Bload\u001b[8Gtime,\u001b[14Gfusing\u001b[21Gthe\u001b[25Gq/k/v\u001b[31Gand\u001b[35Gw1/w3\u001b[41Gcalls,\u001b[48Gprecomputing\u001b[61GRoPE\u001b[66Gper\u001b[70Gposition,\u001b[80Gand\u001b[84Gunrolling\u001b[94Gattention\u001b[104G2\u00d7.\u001b[108GI'll\u001b[113Gkeep\u001b[118Gthe\r\u001b[2C\u001b[1Bcurrent version as scratch/run_v1.py\u001b[40Gfor\u001b[44GA/B\u001b[48Gtesting\u001b[56Gand\u001b[60Grewrite\u001b[68Grun.py.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWriting\u001b[11Gthe new\u001b[19Gkernels and the \u001b[38;2;87;105;247mModel\u001b[41G\u001b[39mclass.\u001b[48GTh"]
