[563.557, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSession time dropped from 7.5 s\u001b[36Go 5.3\u001b[42Gs and generation runs at about 99\u2013108 t\u001b[82Gk/s, but startup weight\u001b[106Gprep\u001b[111Grose\u001b[116Gfrom\r\u001b[2C\u001b[1B~0.35\u001b[9Gto\u001b[12G0.78\u001b[17Gs\u001b[19Gbecause\u001b[27Gthe\u001b[31Gnew\u001b[35Gtiling\u001b[42Gcopy\u001b[47Gis\u001b[50Gslower.\u001b[58GI'm\u001b[62Gbenchmarking\u001b[75Gcopy-loop\u001b[85Gvariants\u001b[94Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcopy\u001b[12Gkernel\u001b[19Gaccounts\u001b[28Gfor\u001b[32Gonly\u001b[37G~0.15\u001b[43Gs\u001b[45Gof\u001b[48Gthe\u001b[52G0.7\u001b[56Gs.\u001b[59GTiming\u001b[66Geach\u001b[71Gstep\u001b[76Gof\u001b[79G\u001b[38;2;87;105;247mModel.__init__\u001b[94G\u001b[39mdirectly:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mtile_into\u001b[39m takes 0\u001b[21G76 s\u001b[26Gon the real weights, versus about 0.15 s predicted,\u001b[78Gbecause\u001b[86Gthe\u001b[90Gmachine\u001b[98Gis\u001b[101Gshort\u001b[107Gon\u001b[110Gmemory\u001b[117Gwith\r\u001b[2C\u001b[1Bheavy\u001b[9Gcompression.\u001b[22GI'm\u001b[26Gcomparing\u001b[36Gold\u001b[40Gand\u001b[44Gnew\u001b[48"]
[563.559, "Gloading\u001b[56Gback\u001b[61Gto\u001b[64Gback\u001b[69Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading takes about the \u001b[28Game time in both versions within \u001b[62Gne process,\u001b[74Gso th\u001b[80G extra\u001b[87Gcost comes from first-touch\u001b[115Gpage\r\u001b[2C\u001b[1Bfaults in fresh pro\u001b[23Gesses u\u001b[31Gder memor\u001b[42Gpressure. I'm now comparing the two versions in\u001b[90Gfresh\u001b[96Gprocesses,\u001b[107Gand\r\u001b[2C\u001b[1Bmemory-mapping\u001b[18Gthe\u001b[22Gcheckpoint\u001b[33Gis\u001b[36Ga\u001b[38Gway\u001b[42Gto\u001b[45Gavoid\u001b[51Gthe\u001b[55G438\u001b[59GMB\u001b[62Gof\u001b[65Gfresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe memmap sourc\u001b[20G wins in fresh processes (about 0.40 s versus 0.48\u20130.80 s), so I'm switching\u001b[97Gto\u001b[100Git\u001b[103Gand\u001b[107Gusing\u001b[113Gthe\r\u001b[2C\u001b[1Bfaster\u001b[10Gbranch-free\u001b[22G16\u00d716\u001b[28Gcopy\u001b[33Gfor\u001b[37Gfull\u001b[42Gtiles,\u001b[49Gwith\u001b[54Ga\u001b[56Ggeneric\u001b[64Gpath\u001b[69Gfor\u001b[73Gany\u001b[77Gpadded\u001b[84Gtail.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;1"]
[563.56, "02mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTiling and padding check out, and the fresh-process load is down to about\u001b[77G0.37\u001b[82Gs.\u001b[85GNext\u001b[90GI'll\u001b[95Grun\u001b[99Ga\u001b[101Gwhole-model\r\u001b[2C\u001b[1Bcomparison against v1 on a small synthetic checkpoint covering non-multiple-of-128 dimensions, grouped-query\u001b[112Gattention\r\u001b[2C\u001b[1Band unshared classifier weights.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m4\u001b[29G2\u001b[39m\u001b[40;1H\u001b[38;3H"]
