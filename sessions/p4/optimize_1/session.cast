[485.437, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gtile_c(dst,\u001b[20Gt0,\u001b[24Gsrc):\r\u001b[1B \u001b[2m\u2502\u001b[22m     # read rows\u001b[20Gj-blocked, write\u001b[37Geach\u001b[42Gtile\u001b[47Grow\u001b[51G(128\u001b[56Gcontiguous\u001b[67Gfloats)\u001b[75Gper\u001b[79Gj\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  L, d, n = src.shape\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  T = dst.shape[3]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  nfull = d // T\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for l in range(L):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      s = src[l]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      for t in range(nfull):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          blk = dst[l, t0 + t]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          r0 = t * T\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mfor\u001b[20Gj0\u001b[23Gin\u001b[26Grange(0,\u001b[35Gn,\u001b[38G32):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 j1 =\u001b[25Gmin(j0\u001b[32G+\u001b[34G32,\u001b[38Gn)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mfor\u001b[24Gc\u001b[26Gin\u001b[29Grange(T):\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G     \u001b[16G   \u001b[20G   \u001b[24Gsr = s[r0 + c]\u001b[39G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m           \u001b[15G    \u001b[20G   \u001b[24Gfor j in\u001b[33Grange(j0,\u001b[43Gj1):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[28G\u001b[22mblk[j,\u001b[35Gc]\u001b[38G=\u001b[40Gsr[j]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[2"]
