[546.877, "[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mback\u001b[13G=\u001b[15Gdst[:,\u001b[22G1:].transpose(0,\u001b[39G1,\u001b[42G3,\u001b[45G2).reshape(2,\u001b[59Gnt\u001b[62G*\u001b[64Grun.TILE,\u001b[74Gn)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     assert np.array_equal(back[:,\u001b[38G:d],\u001b[43GW)\u001b[46Gand\u001b[50Gnot\u001b[54Gnp.any(back[:,\u001b[69Gd:]),\u001b[75G(d,\u001b[79Gn)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mx\u001b[10G=\u001b[12Grng.standard_normal(n).astype(F32)\r\u001b[1B \u001b[2m\u2502\u001b[22m     out = np.zeros(nt\u001b[26G* run.TILE,\u001b[38GF32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     run.matvec_tiles(out, x, dst[0,\u001b[40G1:])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mref\u001b[12G=\u001b[14GW[0].astype(np.float64)\u001b[38G@\u001b[40Gx.astype(np.float64)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     seq = np.zeros(d,\u001b[26GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gr\u001b[14Gin\u001b[17Grange(d):\u001b[28G#\u001b[30Grun.c\u001b[36Gorder,\u001b[43Gfloat32\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G \u001b[13Gcc = F32(0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G  fo\u001b[15G j in range(n):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             acc =\u001b[22GF32(acc + F32(W[0, r, j] * x[j]))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mseq[r]\u001b[19G=\u001b[21Gacc\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f'd={d:5d}\u001b[25Gn={n:4d}:\u001b[35Gtiles\u001b[41Gok,\u001b[45Gp"]
