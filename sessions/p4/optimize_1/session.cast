[277.509, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/proto.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m167\u001b[22m lines to \u001b[1mscratch/proto.py\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Prototype forward variants vs run.forward on the dev sequence: bitwise equality + interleaved timing.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m \u001b[18Gath, os, sys, time, statistics, json\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22msys.path.insert(\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m run\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m numba \u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m njit\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22mF32 = np.float32\r\u001b[2C\u001b[1B\u001b"]
[277.511, "[39m   \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22mmatmul_t = run.matmul_t\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22msoftmax = run.softmax\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +158 lines \u001b[20G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gprototype\u001b[17Gis\u001b[20Gbitwise\u001b[28Gidentical\u001b[38Gbut\u001b[42Gno\u001b[45Gfaster\u001b[52G(9.2\u001b[57Gms/token\u001b[66Gboth\u001b[71Gways),\u001b[78Gand\u001b[82Gits\u001b[86Gduplicate\u001b[96Gweight\u001b[103Gcopies\u001b[110Gmight\r\u001b[1B \u001b[3Gstrain\u001b[11Ghis 8\u001b[17GGB machine.\u001b[29GI'm measuring each change on its own nex\u001b[70G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Fusing turned out slower, while tiling the\u001b[46Gclassifier\u001b[57Ghelped\u001b[64G(about\u001b[71G1.9\u001b[75Gms\u001b[78Gversus\u001b[85G2.2\u001b[89Gms),\u001b[94Gso\u001b[97GI'm\u001b[101Gtesting\u001b[109Gcolumn\r\u001b[2C\u001b[1Btiling on the layer matrices next.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mColumn tiles of 128\u2013256\u001b[27Gh"]
[277.511, "it\u001b[31Gabout\u001b[37G60\u001b[40GGB/s\u001b[45Gon\u001b[48Gevery\u001b[54Glayer\u001b[60Gshape,\u001b[67Gbeating\u001b[75Gthe\u001b[79G56\u001b[82GGB/s\u001b[87Gprobe\u001b[93Gwith\u001b[98Gbitwise-identical\r\u001b[2C\u001b[1Bresults. Next I'm checking the\u001b[34Gunroll\u001b[41Gfactor\u001b[48Ginside\u001b[55Gtiles\u001b[61Gand\u001b[65Gthe\u001b[69Gclassifier\u001b[80Gat\u001b[83GT=256.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[27C\u001b[2B\u001b[38;2;102;102;102m1\u001b[30G6\u001b[39m\u001b[40;1H\u001b[38;3H"]
