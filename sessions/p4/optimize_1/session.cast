[522.847, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLoading\u001b[11Gtakes\u001b[17Gabout\u001b[23Gthe\u001b[27Gsame\u001b[32Gtime\u001b[37Gin\u001b[40Gboth\u001b[45Gversions\u001b[54Gwithin\u001b[61Gone\u001b[65Gprocess,\u001b[74Gso\u001b[77Gthe\u001b[81Gextra\u001b[87Gcost\u001b[92Gcomes\u001b[98Gfrom\u001b[103Gfirst-touch\u001b[115Gpage\r\u001b[2C\u001b[1Bfaults in fresh processes\u001b[29Gunder\u001b[35Gmemory\u001b[42Gpressure.\u001b[52GI'm\u001b[56Gnow\u001b[60Gcomparing\u001b[70Gthe\u001b[74Gtwo\u001b[78Gversions\u001b[87Gin\u001b[90Gfresh\u001b[96Gprocesses,\u001b[107Gand\r\u001b[2C\u001b[1Bmemory-mapping\u001b[18Gthe\u001b[22Gcheckpoint\u001b[33Gis\u001b[36Ga\u001b[38Gway\u001b[42Gto\u001b[45Gavoid\u001b[51Gthe\u001b[55G438\u001b[59GMB\u001b[62Gof\u001b[65Gfresh\u001b[71Ganonymous\u001b[81Gmemory.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m sh\u001b[16Gll command\u2026\u001b[28G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/fresh_load.py <<'EOF'\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mimport os, sys, time\r\u001b[5C\u001b[1BROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102msys.path.insert(0, ROOT); os.chdir(ROOT)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mimport numpy as np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mmode = sys.argv[1]\r\u001b[2C"]
