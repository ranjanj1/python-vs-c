[751.149, "2;51;51;51m \u001b[14Gworkl\u001b[20Gads' \u226482 positions, but\u001b[44Glarger ne\u001b[54Gr seq_len = 1024. That range\u001b[83Gwas\u001b[87Gonly \u001b[93Gxercised\u001b[102Gby\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[14G\u001b[38;2;51;51;51m`edg\u001b[19G.py` (~10.8 s\u001b[33Gfor 1016 forced + 9 new positions), not prof\u001b[78Gled in \u001b[86Getail.    \u001b[97G      \u001b[104G     \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G**Startup** (~1.3\u20131.6 s):\u001b[40G~0.55\u001b[46Gs is im\u001b[54Gorting numpy+numba, ~0.4 s\u001b[81Gis loading and tiling,\u001b[104Gand\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[14G\u001b[38;2;51;51;51m~0.1 s is a\u001b[26Gwarm-up fo\u001b[37Gward. There is no f\u001b[57Grther easy cut\u001b[72Gwithin\u001b[79Gthe\u001b[83Grules.\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 219 \u001b[22m - **Numba on-disk cache** (`cache=True`) writes compiled code to `__pycache__/` beside `run.py`.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 220 \u001b[22m   Without it (e.g. a read-only dir with no fallback), the first start compiles for a few seconds.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 221 \u001b[22m   Before `READY`, a single warm-up forward runs and the KV cache is reset afterward"]
[751.15, "s.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 226 \u001b[22m   not range-checked (bounds checks are off in the kernels).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m27\u001b[14G\u001b[22mThe tokenizer and protocol handling are plain\u001b[60GPython (not compute); only the arithm\u001b[98Gtic is\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[14G\u001b[22mcompiled.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m  91 -\u001b[38;2;51;51;51m- Throughput on this machine moved a lot between runs (roughly 62\u2013104 tok/s for the same command),    \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  92 -\u001b[38;2;51;51;51m  apparently from other load, so the speed figures above are rough.                                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 229 +\u001b[38;2;51;51;51m- **Measurement noise**: the machine was shared and memory-pressured throughout. Identical            \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 230 +\u001b[38;2;51;51;51m  commands varied by \u00b115\u201330% between runs, so treat the figures as medians under that load.           \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b["]
[751.15, "K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOne wording fix in NOTES.md: the classifier tile-size result was misstated.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[751.151, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;102;102;102m\u2026\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mNOTES.md\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[751.162, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m 219 \u001b[22m - **Numba on-disk cache** (`cache=True`) writes compiled code to `__pycache__/` beside `run.py`.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 220 \u001b[22m   Without it (e.g. a read-only dir with no fallback), the first start compiles for a few seconds.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 221 \u001b[22m   Before `READY`, a single warm-up forward runs and the KV cache is reset afterwards.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m...\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 226 \u001b[22m   not range-checked (bounds checks are off in the kernels).\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 227 \u001b[22m - The tokenizer and protocol handling are plain Python (not compute); only the arithmetic is\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 228 \u001b[22m   compiled.\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m  91 -\u001b[38;2;51;51;51m- Throughput on this machine moved a lot between runs (roughly 62\u2013104 tok/s for the same command),    \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  92 -\u001b[38;2;51;51;51m  apparently from other load, so the spe"]
[751.163, "ed figures above are rough.                                   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m29\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G**Mea\u001b[20Gurement noise**: the mac\u001b[45Gin\u001b[49Gwas shared and memory-pressured th\u001b[84Goughout.\u001b[93GIdentical\r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 230 +\u001b[38;2;51;51;51m  commands varied by \u00b115\u201330% between runs, so treat the figures as medians under that load.           \r\u001b[5C\u001b[1B\u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOne wording fix in NOTES.md: the classifier tile-size result was misstated.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[751.163, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 91 \u001b[22m   u4 ~62 GB/s).\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 92 \u001b[22m - **Rejected:** fusing q/k/v or w1/w3 into one *untiled* wide matrix was slower (50 vs 54 GB/s;\r\u001b[1B\u001b[2m 93 \u001b[22m   40 vs 51 GB/s), because wider outputs stream worse (`bench_fuse.py`). Tile widths 64/256 and\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 94 -\u001b[38;2;51;51;51m  an 8-row unroll were within noise of T=128 with 4 rows (`bench_tile3.py`). \u001b[48;2;255;199;199mUntiled\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mclassifie"]
[751.164, "r\u001b[48;2;255;220;220m                    \r\u001b[1B\u001b[38;2;207;34;46m 95 -\u001b[38;2;51;51;51m  tiles of 256\u20133200 columns were \u22641.9 ms (`bench_cls*.py`).                                                        \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 94 +\u001b[38;2;51;51;51m  an 8-row unroll were within noise of T=128 with 4 rows (`bench_tile3.py`). \u001b[48;2;178;255;178mWith\u001b[48;2;220;255;220m \u001b[48;2;178;255;178ma 2-row\u001b[48;2;220;255;220m                          \r\u001b[1B\u001b[38;2;36;138;61m 95 +\u001b[38;2;51;51;51m  kernel, classifier tiles of 256\u20131280 columns reached ~1.9 ms (min), and wider tiles got worse                    \r\u001b[1B\u001b[38;2;36;138;61m 96 +\u001b[38;2;51;51;51m  (3200 columns: 2.5 ms) (`bench_cls*.py`).                                                                        \r\u001b[1B\u001b[49m\u001b[2m 97 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 98 \u001b[22m **After** (`scratch/profile_after.txt`): ~7.7\u20138.2 ms/token, 55\u201357 GB/s effective.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 99 \u001b[22m \u001b[39m\u001b[40;1H\u001b[36;2H"]
