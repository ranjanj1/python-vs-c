[259.179, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[4Gl\u001b[19G\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
[259.284, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe laye\u001b[12G matmuls already\u001b[29Grun\u001b[33Gnear\u001b[38Gthe\u001b[42Gone-core\u001b[51Gceiling\u001b[59Gof\u001b[62Gabout\u001b[68G56\u001b[71GGB/s,\u001b[77Gso\u001b[80Gthe\u001b[84Gremaining\u001b[94Ggains\u001b[100Gare\u001b[104Gin\u001b[107Gthe\r\u001b[1B  classifier, fused q/k/v and w1/w3 kernels,\u001b[46Gand\u001b[50Gsome\u001b[55Gattention\u001b[65Gand\u001b[69GRoPE\u001b[74Gwork.\u001b[80GI'm\u001b[84Gprototyping\u001b[96Ga\u001b[98Gnew\u001b[102Gforward\u001b[110Gpass\u001b[115Gthat\r\u001b[2C\u001b[1Bmust produce bitwise-identical logits.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(scratch/proto.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m167\u001b[22m lines to \u001b[1mscratch/proto.py\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"Prototype forward variants vs run.forward on the dev sequence: bitwise equality + interleaved timing.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m \u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m \u001b[18Gath, os, sys, time, statisti"]
[259.286, "cs, json\r\u001b[7C\u001b[1B\u001b[2m3\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[7C\u001b[1B\u001b[2m4\u001b[10G\u001b[22msys.path.insert(\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m run\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m numba \u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m njit\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22mF32 = np.float32\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22mmatmul_t = run.matmul_t\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22msoftmax = run.softmax\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +158 lines \u001b[20G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The prototype is bitwise identical but no\u001b[45Gfaster\u001b[52G(9.2\u001b[57Gms/token\u001b[66Gboth\u001b[71Gways),\u001b[78Gand\u001b[82Gits\u001b[86Gduplicate\u001b[96Gweight\u001b[103Gcopies\u001b[110Gmight\r\u001b[2C\u001b[1Bstrain this 8 GB machine. I'm measuring each change\u001b[55Gon\u001b[58Gits\u001b[62Gown\u001b[66Gn"]
[259.286, "ext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusing turned out slower,\u001b[29Gwhile\u001b[35Gtiling\u001b[42Gthe\u001b[46Gclassifier\u001b[57Ghelped\u001b[64G(about\u001b[71G1.9\u001b[75Gms\u001b[78Gversus\u001b[85G2.2\u001b[89Gms),\u001b[94Gso\u001b[97GI'm\u001b[101Gtesting\u001b[109Gcolumn\r\u001b[2C\u001b[1Btiling on the layer matrices\u001b[32Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[28C\u001b[2B\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
[259.297, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 9s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
