[443.897, "\u001b[H\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gbreakdo\u001b[19Gn and\u001b[25Gend-to-e\u001b[34Gd profile\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\u001b[26G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mimport time; t=time.time()\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mimport numpy, numba; t0=time.time()\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mimport run; t1=time.time()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mm = run.Model('model.bin'); t2=time.time()\r\u001b[5C\u001b[1Btk = run.Tokenizer('tokenizer.bin', m.vocab); t3=time.time()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mm.forward(1,0); run.argmax(m.logits); m.reset(); t4=time.time()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mprint(f'import numpy+\u2026\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[443.898, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mStartup breakdown and end-to-end profile\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12G-\u001b[14G<<'EOF'\r\u001b[1B \u001b[2m\u2502\u001b[22m import time; t=time.time()\u001b[31G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import numpy, numba; t0=\u001b[30Gme.\u001b[34Gime()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Grun;\u001b[16Gt1=time.time()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m m = run.Model('model.bin');\u001b[32Gt2=time.time()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtk\u001b[7G=\u001b[9Grun.Tokenizer('tokenizer.bin',\u001b[40Gm.vocab);\u001b[50Gt3=time.time()"]
[443.899, "\r\u001b[1B \u001b[2m\u2502\u001b[22m m.forward(1,0); ru\u001b[23G.argmax(m.l\u001b[35Ggits);\u001b[42Gm.res\u001b[48Gt(); t4=time.time()\u001b[68G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print(f'import numpy+\u001b[26Gumba {t0-t:.2f} \u001b[43Gimport run (load\u001b[60Gcached\u001b[67Gkernels)\u001b[76G{t1-t0:.2f}\u001b[89Gload+tile\u001b[99Gweights\u001b[107G{t2-t1:.2f}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtokenizer\u001b[14G{t3-t2:.2f}\u001b[27Gwarm-up\u001b[35Gfwd\u001b[39G{t4-t3:.2f}')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m t=time.time(); a=numpy.fromfile('model.bin',\u001b[49Gdtype='<f4',\u001b[62Goffset=28);\u001b[74Gprint(f'\u001b[84G(fromfile\u001b[94Galone\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m{time.time()-t:.2f})')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scr\u001b[16Gtch/profi\u001b[26Ge.py e2e 4 |\u001b[39Gtee scratch/profile_after_e2e.txt\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
