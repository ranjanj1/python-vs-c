[649.8, "thetic checkpoint covering \u001b[67Gon-multiple-of-128 dimensions, grouped-query attention\r\u001b[2C\u001b[1Band unshared cla\u001b[20Gsifier weights.\u001b[36G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gv2\u001b[10Goutput\u001b[17Gmatches\u001b[25Gv1\u001b[28Gbit-for-bit\u001b[40Gon\u001b[43Gall\u001b[47Gthree\u001b[53Gsynthetic\u001b[63Gshapes,\u001b[71Gcovering\u001b[80Gpadding,\u001b[89Ggrouped-query\u001b[103Gattention\u001b[113Gand\u001b[117Gthe\r\u001b[1B \u001b[3Gunshared classifier. Next I'm runn\u001b[38Gng the full check, the edge-ca\u001b[69Ge\u001b[71Gtests and the end-to-end profile.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything\u001b[14Gpasses,\u001b[22Gand\u001b[26Gthe\u001b[30G1024-position\u001b[44Gruns\u001b[49Gdropped\u001b[57Gfrom\u001b[62Gabout\u001b[68G15.8\u001b[73Gs\u001b[75Gto\u001b[78G10.8\u001b[83Gs.\u001b[86GRe-verifying\u001b[99Gthe\u001b[103Gprecision\u001b[113Grules\u001b[119Gon\r\u001b[1B \u001b[3Gth\u001b[6G new kernel\u001b[18G (no float64, no fa\u001b[38Gt-math flags):\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B"]
