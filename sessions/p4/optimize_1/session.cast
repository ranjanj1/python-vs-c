[124.125, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mF32\u001b[8G=\u001b[10Gnp.float32\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[22m @njit(boundscheck=False)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gcls_tiled(out,\u001b[23Gx,\u001b[26Gwtiles,\u001b[34Gk):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G # wtiles: (n_tiles, n, T) ; til\u001b[41Gt covers outputs t*T .. t*T+T-1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     nt\u001b[11G= wtiles.shape[0];\u001b[30GT =\u001b[34Gwtiles.shape[2]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gt\u001b[14Gin\u001b[17Grange(nt):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         o = out[t *\u001b[24GT:(t\u001b[29G+\u001b[31G1)\u001b[34G*\u001b[36GT]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gk\u001b[17G==\u001b[20G2:\u001b[23Grun.matmul_t(o,\u001b[39Gx,\u001b[42Gwtiles[t])\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     else: run.matmul_t4(o, x, wtiles[t])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm\u001b[6G=\u001b[8Grun.Model('model.bin')\r\u001b[1B \u001b[2m\u2502\u001b[22m x = np.\u001b[13Gndom.de\u001b[21Gault_rng(0).standard_normal(m.dim).astype(F32)\r\u001b[1B \u001b[2m\u2502\u001b[22m ref = np.zeros(m.vocab, F32); run.matmul_t4(ref,\u001b[53Gx,\u001b[56Gm.wcls)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef bench(f, *a):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  f(*a);\u001b[15Gts\u001b[18G=\u001b[20G[]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22"]
[124.125, "m  for _ in range(15):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      t = time.perf_counter(); f(*a); ts.append(time.perf_counter() - t)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  return statistics.median(ts), min(ts)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmd, mn = bench(run.matmul_t4, ref, x, m.wcls)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f'untiled u4: median {md*1e3:.3f} ms  min {mn*1e3:.3f}  {m.wcls.nbytes/mn/1e9:.1f}\u001b[93GGB/s')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor T in (500,\u001b[19G1000,\u001b[25G2000,\u001b[31G4000,\u001b[37G8000):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  wt = np.ascontiguousarray(m.wcls.reshape(m.dim, m.vocab // T, T).transpose(1,\u001b[86G0,\u001b[89G2))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  out = np.zeros(m.vocab,\u001b[32GF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  for k in (2,\u001b[21G4):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mmd,\u001b[16Gmn\u001b[19G=\u001b[21Gbench(cls_tiled,\u001b[38Gout,\u001b[43Gx,\u001b[46Gwt,\u001b[50Gk)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         print(f'T={T:5d}\u001b[29Gu{k}:\u001b[35Gmedian\u001b[42G{md*1e3:.3f}\u001b[55Gms\u001b[59Gmin\u001b[63G{mn*1e3:.3f}\u001b[77G{m.wcls.nbytes/mn/1e9:.1f}\u001b[104GGB/s\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22midentical={np.array_equal(out,\u001b[35Gref)}')\r\u001b[1B \u001b[2m"]
[124.126, "\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/bench_c\u001b[28Gs.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/bench_cls.py\u001b[73G\u001b[22mcommands\u001b[82Gin\u001b[85G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102m"]
