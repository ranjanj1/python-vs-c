[212.304, "atistics, json\r\u001b[5C\u001b[1B\u001b[2m  3 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m numpy \u001b[38;2;167;29;93mas\u001b[38;2;51;51;51m np\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22msys.path.insert(\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m run\u001b[21G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m numba \u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m njit\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mF32 = np.float32\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22mmatmul_t = run.matmul_t\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22msoftmax = run.softmax\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +158 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 scratch/proto.py 6\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
