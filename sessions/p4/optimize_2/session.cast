[863.12, "\u001b[H     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 217 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 218 +\u001b[38;2;51;51;51m## Second performance pass: tests                                                                     \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 219 +\u001b[38;2;51;51;51m                                                                                                      \r\u001b[1B\u001b[49m\u001b[39m     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 220 +\u001b[38;2;51;51;51m- `check.py` quick and `--tokens 64 --prompts 3`: PASS, same errors as before.                        \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 221 +\u001b[38;2;51;51;51m- `scratch/ab.py 8 run_v2` and `ab.py 6` (vs the first version): logits bitwise identical on all      \u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 222 +\u001b[38;2;51;51;51m \u001b[14Gth\u001b[17Gee dev sequences.\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b["]
[863.12, "1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 223 +\u001b[38;2;51;51;51m-\u001b[14G`scratch/longctx.py`:\u001b[36GFIXED\u001b[42G300\u001b[46Gand\u001b[50GFIXED\u001b[56G1024\u001b[61Ganswers\u001b[69Gidentical\u001b[79G(SHA-1)\u001b[87Gbetween\u001b[95Gthe\u001b[99Gprevious\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 224 +\u001b[38;2;51;51;51m  and curren\u001b[25G versions.      \u001b[52G \u001b[54G   \u001b[58G             \u001b[72G       \u001b[80G         \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 225 +\u001b[38;2;51;51;51m- `\u001b[23Gtest\u001b[28Gsyn\u001b[32Ghetic.py`:\u001b[43Gpadding,\u001b[52GGQA (1 and 4 kv\u001b[68Gheads), unshared cl\u001b[88Gssifier/embedding,\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 226 +\u001b[38;2;51;51;51m  sequen\u001b[21Ge lengths 40 and\u001b[38G33\u001b[41G(partial\u001b[50Gkey\u001b[54Gblocks) \u2014\u001b[65Gll bitwise identical\u001b[86Gto \u001b[90Ghe fir\u001b[97Gt\u001b[99Gversion.\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 227 +\u001b[38;2;51;51;51m- `\u001b[23Gt\u001b[25Gst_rese\u001b[36G`: after a\u001b[48G61-position c\u001b[62Gmmand \u001b[69Gnd a reset, the cach\u001b[90G is all-zero, \u001b[105Gnd a     \u001b["]
[863.121, "49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 228 +\u001b[38;2;51;51;51m  20-position\u001b[26Gsequence\u001b[35Ggives\u001b[41Gbitwise\u001b[49Gthe\u001b[53Gsame\u001b[58Glogits\u001b[65Gas\u001b[68Gon\u001b[71Ga\u001b[73Gfresh\u001b[79Gmodel.\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 229 +\u001b[38;2;51;51;51m- `\u001b[23Gedge.py`: unchanged behaviour,\u001b[54Gincluding the `context` \u001b[79Gtop at \u001b[88Gq_len.   \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 230 +\u001b[38;2;51;51;51m- `\u001b[23Gt\u001b[25Gst_tili\u001b[33Gg.py`, \u001b[41Glus\u001b[45GIR/type inspection of every kernel including\u001b[90G`embed`:\u001b[99Gno\u001b[102Gfloat64,\u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 231 +\u001b[38;2;51;51;51m  no double\u001b[24Garithmetic,\u001b[36Gno fast-math flags.   \u001b[59G      \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 232 +\u001b[38;2;51;51;51m  \u001b[15G                          \u001b[42G       \u001b[50G                      \u001b[73G       \u001b[81G                      \u001b[114G\u001b[49m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 233 +\u001b[38;2;51;51;51m"]
