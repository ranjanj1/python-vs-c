[449.749, "\u001b[H\r\u001b[26B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSoftmax is roughly 11% of attention cost at 1000 positions, so I'm going with the block-64 layout and noting\r\u001b[2C\u001b[1Blong-context costs as a limitation,\u001b[39Gstarting\u001b[48Gin\u001b[51G\u001b[38;2;87;105;247mrun.py\u001b[39m.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[29C\u001b[2B\u001b[38;2;102;102;102m9\u001b[32G2\u001b[39m\u001b[40;1H\u001b[38;3H"]
[449.763, "\u001b[H\r\u001b[43C\u001b[33B\u001b[38;2;102;102;102mthought for 6s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
