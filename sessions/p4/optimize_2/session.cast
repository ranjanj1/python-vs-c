[439.995, "\u001b[H\u001b[6G\u001b[38;2;102;102;102mimport os, sys, time, statistics\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, ROOT); os.chdir(ROOT)\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mimport n\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1B\u001b[22m\u001b[39m \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mMeasure softmax share at long context\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[439.996, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat > scratch/bench_attn_parts.py\u001b[38G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\"\"Attention\u001b[17Gat\u001b[20Glong\u001b[25Gcontext:\u001b[34Gtime\u001b[39Gof\u001b[42Gthe\u001b[46Gsoftmax\u001b[54G(expf)\u001b[61Gpart\u001b[66Galone,\u001b[73G144\u001b[77Grows\u001b[82G(12\u001b[86Glayers\u001b[93Gx\u001b[95G12\u001b[98Gheads).\"\"\"\r\u001b[1B \u001b[2m\u2502\u001b[22m import os,\u001b[15Gsy\u001b[18G, t\u001b[22Gme, statistics\u001b[37G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ROOT = os.\u001b[15Gath.dirname(os.path.dirname(\u001b[44Gs.path.abspath(__file__))); sys.path.\u001b[82Gnsert(0, ROOT); os.chd\u001b[105Gr(ROOT)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import\u001b[11Gnumpy as\u001b[20Gnp,\u001b[24Grun\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfrom\u001b[9Gnumba\u001b[15Gimport\u001b[22Gnjit\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m F32 = np.float32\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m@njit(boundscheck=False)\r\u001b[1B \u001b[2m\u2502\u001b[22m def soft\u001b[13Gax_rows(a\u001b[23Gt,\u001b[27G, reps):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for\u001b[12G_\u001b[14Gin\u001b[17Grange"]
[439.997, "(reps):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gh\u001b[18Gin\u001b[21Grange(att.shape[0]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             run.softmax(att[h],\u001b[36Gn)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22matt\u001b[8G=\u001b[10G(np.random.default_rng(0).standard_normal((144,\u001b[58G1024))\u001b[65G*\u001b[67G3).astype(F32)\r\u001b[1B \u001b[2m\u2502\u001b[22m s\u001b[6Gftmax_rows(att, 10, 1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for n in (80, 300, 1000):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mts\u001b[11G=\u001b[13G[]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for _ in range(9):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22ma\u001b[14G=\u001b[16Gatt.copy();\u001b[28Gt\u001b[30G=\u001b[32Gtime.perf_counter();\u001b[53Gsoftmax_rows(a,\u001b[69Gn,\u001b[72G1);\u001b[76Gts.append(time.perf_counter()\u001b[106G-\u001b[108Gt)\r\u001b[1B \u001b[2m\u2502\u001b[22m     pr\u001b[11Gnt(f'softmax over {n:4d} positions\u001b[46Gx 144 rows: {statistic\u001b[69G.median(ts)*1e3:.3f} m\u001b[92G per token')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/bench_attn_parts.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[439.997, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/bench_attn_parts.py\u001b[80G\u001b[22mcommands\u001b[89Gin\u001b[92G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
