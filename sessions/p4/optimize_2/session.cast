[352.543, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe checkpoint's pages sometimes fall out of the OS file cache, taking up to 952 ms on the first touch, and the\u001b[115Grest\r\u001b[2C\u001b[1Bof\u001b[6Gweight loading takes\u001b[27Gonly\u001b[32G130\u2013200\u001b[40Gms.\u001b[44GNext\u001b[49GI'll\u001b[54Glook\u001b[59Gat\u001b[62Gthe\u001b[66Gper-command\u001b[78Goverhead\u001b[87Goutside\u001b[95Gthe\u001b[99Gforward\u001b[107Gpass.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Non-forward-pass overheads are all small (dispatch, argmax, KV reset, and the LOGITS\u001b[88Gwrite),\u001b[96Gand\u001b[100Gthe\u001b[104Gkernels\u001b[112Gare\r\u001b[1C\u001b[1B already at the hardware limit.\u001b[34GNext\u001b[39GI'll\u001b[44Gtest\u001b[49Gputting\u001b[57Gall\u001b[61Gweights\u001b[69Ginto\u001b[74Gone\u001b[78Gbuffer\u001b[85Gin\u001b[88Gforward-pass\u001b[101Gorder,\u001b[108Gsince\u001b[114Gthe\r\u001b[1B  four separate arrays make each layer jump between memory streams.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The strided views weren't C-contiguous, so Numba fell back to a non-vec"]
[352.544, "torizing v\u001b[86Gsion, and the mach\u001b[105Gne is more\r\u001b[1C\u001b[1B loaded now, so that comparison\u001b[34Gis\u001b[37Ginvalid.\u001b[46GI'm\u001b[50Gredoing\u001b[58Git\u001b[61Gwith\u001b[66Gcontiguous\u001b[77Gper-layer\u001b[87Gviews\u001b[93Gfrom\u001b[98Gone\u001b[102Gflat\u001b[107Gbuffer,\u001b[115Geach\r\u001b[1C\u001b[1B layout measure\u001b[18G in its own proce\u001b[36Gs.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gsingle-buffer layout cam\u001b[32G in\u001b[36Gwi\u001b[39Ghin\u001b[43Gnoise, so I'm dropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b[111Gsharing\r\u001b[1C\u001b[1B the\u001b[7Gembedding weights,\u001b[26Gresetting\u001b[36Gonly\u001b[41Gthe\u001b[45GKV\u001b[48Gpositions\u001b[58Gthe\u001b[62Glast\u001b[67Gcommand\u001b[75Gused,\u001b[81Gand\u001b[85Gwriting\u001b[93Glogits\u001b[100Gdirectly.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Existi\u001b[10Gg tests\u001b[18Gstill\u001b[24Gpass\u001b[29Gwith\u001b[34Gbitwise-identical\u001b[52Goutput,\u001b[60Gbut\u001b[64Gthe\u001b[68Gpartia"]
[352.544, "l\u001b[76Greset\u001b[82Gneeds\u001b[88Gits\u001b[92Gown\u001b[96Gtest:\u001b[102Gafter\u001b[108Ga\u001b[110Glong\r\u001b[1C\u001b[1B comma\u001b[9Gd th\u001b[14Gn a short one,\u001b[29Gthe\u001b[33Gcache\u001b[39Gmust\u001b[44Gbe\u001b[47Gall\u001b[51Gzeros\u001b[57Gand\u001b[61Gmatch\u001b[67Ga\u001b[69Gfresh process. I'm\u001b[88Gwriti\u001b[94Gg\u001b[96Gthat\u001b[101Gtest\u001b[106Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Testing p\u001b[13Grtial KV-cache r\u001b[30Gset\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/test_reset.py <<'EOF'\u001b[44G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m\"\"\"Partial KV reset: after any command the cache must be all-zero again, and results must not depend on history.\"\"\"\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport os, sys, json\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, ROOT); os.chdir(ROOT)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mimport numpy as\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;226;130;98mNewspapering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(5m 45s \u00b7 \u2193\u001b[29G22.9k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick "]
