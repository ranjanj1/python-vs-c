[540.351, "\u001b[H\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Blocked keys are faster up to ~300 positions (1.11\u20131.53\u00d7) and bitwise identical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[1C\u001b[1B positions. Trying larger blocks for a better balance:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Block size 64 wins at every\u001b[31Gcontext length tested, up to\u001b[60G1.59\u00d7 faste\u001b[72G at 300 positions, so I'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttention\r\u001b[1C\u001b[1B takes about half\u001b[20Gof each\u001b[28Gtoken's time at position 1000, but dev workloads stay under 83\u001b[100G, \u001b[103Go I'll \u001b[111Ghec\u001b[115G what\r\u001b[1C\u001b[1B dominates\u001b[13Gthere.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Softmax is r\u001b[16Gughly 11% of attenti\u001b[38G cost\u001b[44Gat\u001b[47G1000\u001b[52Gpositions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[1"]
