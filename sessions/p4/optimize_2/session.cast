[539.994, "\u001b[4G\u001b[22msed\u001b[8G-i\u001b[11G''\u001b[14G\"s#p\u001b[19G=\u001b[21Gsubprocess.Popen(\\[sys.executable,\u001b[56G'run.py',\u001b[66G'model.bin',\u001b[79G'tokenizer.bin'\\]#p\u001b[99G=\r\u001b[1B \u001b[2m\u2502\u001b[22m subprocess.Pop\u001b[19Gn([\u001b[23Gys.executable,\u001b[38Gos.environ.get('PROG',\u001b[61G'run.py'), 'model.bin', '\u001b[87Gokenizer.bin']#\"\u001b[104G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m scratch/profile.py && grep -c \"PROG\"\u001b[41Gscratch/profile.py\u001b[60G&&\u001b[63Gcat\u001b[67G>\u001b[69Gscratch/longctx.py\u001b[88G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\"\"Long-context\u001b[20Gtiming:\u001b[28GGENERATE\u001b[37Gafter\u001b[43Ga\u001b[45G~1016-token\u001b[57Gprompt,\u001b[65Gand\u001b[69GFIXED\u001b[75Gover\u001b[80G300\u001b[84G/\u001b[86G1024\u001b[91Gpositions\u001b[101G(synthetic\u001b[112Gtoken\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ids\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtaken\u001b[10Gfrom\u001b[15Gthe\u001b[19Gdev\u001b[23Gprompt\u001b[30Gtexts\u001b[36Gonly).\u001b[43GUsage:\u001b[50Gpython3\u001b[58Gscratch/longctx.py\u001b[77G<program.py>\"\"\"\r\u001b[1B \u001b[2m\u2502\u001b[22m import os, sys, \u001b[21Gubproc\u001b[28Gss, tim\u001b[36G, jso\u001b[42G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ROOT\u001b[9G= \u001b[12Gs.path.dirname(os.path.dirname(os.pa\u001b[49Gh.abspath(__fil\u001b[65G__))); \u001b[73Gs.chdir(ROOT)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b"]
[539.995, "[22m fx = json.load(open('fixtures.json'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G=\u001b[8Gsubprocess.Popen([sys.executable,\u001b[42Gsys.argv[1],\u001b[55G'model.bin',\u001b[68G'tokenizer.bin'],\u001b[86Gstdin=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m stdout=subprocess.PIPE,\u001b[28Gtext=True,\u001b[39Gbufsize=1)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrd\u001b[7G=\u001b[9Glambda:\u001b[17Gp.stdout.readline().rstrip('\\n')\r\u001b[1B \u001b[2m\u2502\u001b[22m assert\u001b[11Grd() == 'READY'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m base = []\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gpr\u001b[11Gin\u001b[14Gfx['prompts']:\u001b[29Gbase\u001b[34G+=\u001b[37Gpr['seq']\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ids = (base * 20)[:1024]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mout\u001b[8G=\u001b[10G{}\r\u001b[1B \u001b[2m\u2502\u001b[22m for n in (300, 1024):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G t = time.perf_counter(); p.stdin.write('FIXED\u001b[54G'\u001b[56G+\u001b[58G'\u001b[60G'.join(map(str,\u001b[76Gids[:n]))\u001b[86G+\u001b[88G'\\n');\u001b[95Gp.stdin.flush();\u001b[112Gr\u001b[114G=\u001b[116Grd()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mout[f'FIXED\u001b[20G{n}']\u001b[26G=\u001b[28Gtime.perf_counter()\u001b[48G-\u001b[50Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     out[f'FIXED {n}\u001b[24Ganswer']\u001b[33G=\u001b[35Gr.split()[:6]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b"]
[539.995, "[22mp.stdin.write('QUIT\\n');\u001b[29Gp.stdin.flush();\u001b[46Gp.wait()\r\u001b[1B \u001b[2m\u2502\u001b[22m print(sys.argv[1],\u001b[23G{k: (round(v, 3) if \u001b[45Ginstance(v\u001b[57Gfloat) else\u001b[69Gv)\u001b[72Gfor k, v in\u001b[84Gout.item\u001b[93G()})\u001b[98G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gi\u001b[10Gin\u001b[13G1\u001b[15G2;\u001b[18Gdo\u001b[21Gpython3\u001b[29Gscratch/longctx.py\u001b[48Gscratch/run_v2.py;\u001b[67Gpython3\u001b[75Gscratch/longctx.py\u001b[94Grun.py;\u001b[102Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;10"]
