[466.386, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Single samples\u001b[18Gare too\u001b[26Gn\u001b[28Gisy to judge. I'll\u001b[47Grepeat\u001b[54Geach\u001b[59Gmeasurement\u001b[71G9\u001b[73Gtimes\u001b[79Gwith\u001b[84Ga\u001b[86Gcache\u001b[92Gflush\u001b[98Gbefore\u001b[105Geach\u001b[110Gand\u001b[114Gtake\r\u001b[1C\u001b[1B medians:\u001b[12G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Blocked\u001b[11Gkeys\u001b[16Gare\u001b[20Gfaster\u001b[27Gup to ~300 position\u001b[47G (1.11\u20131.53\u00d7)\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[1C\u001b[1B positions.\u001b[14GTrying\u001b[21Glarger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Block size\u001b[14G64\u001b[17Gwins\u001b[22Gat\u001b[25Gevery\u001b[31Gcontext\u001b[39Glength\u001b[46Gtested,\u001b[54Gup\u001b[57Gto\u001b[60G1.59\u00d7\u001b[66Gfaster\u001b[73Gat\u001b[76G300\u001b[80Gpositions,\u001b[91Gso\u001b[94GI'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttentio"]
