[397.703, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The single-buffer layout came i\u001b[35G within\u001b[43Gnoise, so I'm dropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b[111Gsharing\r\u001b[1C\u001b[1B th\u001b[6G embedding\u001b[17Gweights, resetting only the KV positions\u001b[58Gthe\u001b[62Glast\u001b[67Gcommand\u001b[75Gused,\u001b[81Gand\u001b[85Gwriting\u001b[93Glogits\u001b[100Gdirectly.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Existing\u001b[12Gtests still pass\u001b[29Gwith\u001b[34Gbitwise-identical\u001b[52Goutput,\u001b[60Gbut\u001b[64Gthe\u001b[68Gpartial\u001b[76Greset\u001b[82Gneeds\u001b[88Gits\u001b[92Gown\u001b[96Gtest:\u001b[102Gafter\u001b[108Ga\u001b[110Glong\r\u001b[1C\u001b[1B command\u001b[11Gthen \u001b[17G short one, the cache\u001b[39Gmust\u001b[44Gbe\u001b[47Gall\u001b[51Gzeros\u001b[57Gand\u001b[61Gmatch\u001b[67Ga\u001b[69Gfresh\u001b[75Gprocess.\u001b[84GI'm\u001b[88Gwriting\u001b[96Gthat\u001b[101Gtest\u001b[106Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gpartial"]
