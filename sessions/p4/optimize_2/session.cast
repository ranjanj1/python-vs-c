[492.128, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSingle samples\u001b[18Gare\u001b[22Gtoo\u001b[26Gnoisy\u001b[32Gto\u001b[35Gjudge.\u001b[42GI'll\u001b[47Grepeat\u001b[54Geach\u001b[59Gmeasurement\u001b[71G9\u001b[73Gtimes\u001b[79Gwith\u001b[84Ga\u001b[86Gcache\u001b[92Gflush\u001b[98Gbefore\u001b[105Geach\u001b[110Gand\u001b[114Gtake\r\u001b[2C\u001b[1Bmedians:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked keys are faster up to ~300 positions\u001b[48G(1.11\u20131.53\u00d7)\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[2C\u001b[1Bpositions.\u001b[14GTrying\u001b[21Glarger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsize 64 wins at every context length tested, up to 1.59\u00d7 faster \u001b[74Gt 300 positions,\u001b[91Gs\u001b[93G I'm adopting it. Attention\r\u001b[2C\u001b[1Btakes abou\u001b[14G half\u001b[20Gof\u001b[23Geach\u001b[28Gtoken's\u001b[36Gtime\u001b[41Gat\u001b[44Gposition\u001b[53G1000,\u001b["]
[492.128, "59Gbut\u001b[63Gdev\u001b[67Gworkloads\u001b[77Gstay\u001b[82Gunder\u001b[88G83\u001b[91Gpositions,\u001b[102Gso\u001b[105GI'll\u001b[110Gcheck\u001b[116Gwhat\r\u001b[2C\u001b[1Bdominates\u001b[13Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mS\u001b[5Gftmax is roughly\u001b[22G11% of at\u001b[32Gention\u001b[39Gcost at 1000 positions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[2C\u001b[1Blong-context\u001b[16Gcosts\u001b[22Gas\u001b[25Ga\u001b[27Glimitation,\u001b[39Gstarting\u001b[48Gin\u001b[51G\u001b[38;2;87;105;247mrun.py\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Applying blocked key cache\u001b[30Gand\u001b[34Gverifying\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $\u001b[8Gpytho\u001b[14G3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ms =\u001b[10Gopen('run.py').read()\r\u001b[5C\u001b[1Bdef rep(a, b):\r\u001b[5C\u001b[1Bglobal\u001b[14G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert s.count(a)\u001b[24G== 1, a;\u001b[33Gs = s.re\u001b[42Glace(a, b)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mrep('\u001b[13GTILE = 128 # output columns per weight tile (se\u001b[61G matvec_tiles)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m''',\u001b[11G'''TILE = 128 # o"]
