[700.535, "version\u001b[67Gby\u001b[70Greverting\u001b[80Gthis\u001b[85Gpass's\u001b[92Gedits\u001b[98Gso\u001b[101GI\u001b[103Gcan\u001b[107Grun\u001b[111Ga\u001b[113Gfair\u001b[118GA/B\r\u001b[2C\u001b[1Band\u001b[7Gconfirm\u001b[15Git\u001b[18Gmatches\u001b[26Gbitwise.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn the dev path the speedup\u001b[31Gis\u001b[34Gwithin\u001b[41Gnoise\u001b[47G(1.004\u00d7),\u001b[57Gas\u001b[60Gexpected\u001b[69Gat\u001b[72Gthese\u001b[78Gshort\u001b[84Gpositions,\u001b[95Gso\u001b[98GI'm\u001b[102Gmeasuring\u001b[112Gboth\r\u001b[2C\u001b[1Bversions\u001b[12Gend-to-end\u001b[23Gat\u001b[26Glonger\u001b[33Gcontexts\u001b[42Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe long-context FIXED\u001b[26Gruns\u001b[31Gare\u001b[35Gabout\u001b[41G5%\u001b[44Gfaster\u001b[51Gon\u001b[54Gboth\u001b[59Grounds\u001b[66G(300\u001b[71Gtokens:\u001b[79G2.60\u001b[84G\u2192\u001b[86G2.47\u001b[91Gs;\u001b[94G1024\u001b[99Gtokens:\u001b[107G10.40\u001b[113G\u2192\u001b[115G9.95\r\u001b[2C\u001b[1Bs).\u001b[7GI'm\u001b[11Gchecking\u001b[20Gthat\u001b[25Gthe\u001b[29Glong-context\u001b[42GFIXED\u001b[48Ganswers\u001b[56Gare\u001b[60Gfully\u001b[66Gidentical,\u001b[77Gthen\u001b[82Gprofiling\u001b[92Gthe\u001b[96Gend-to-end\u001b[107Gdev\u001b[111Gworkload\r\u001b[1B \u001b[3Gfor"]
