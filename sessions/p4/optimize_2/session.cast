[834.883, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe long-context answers\u001b[28Gmatch,\u001b[35Gand\u001b[39Gend-to-end\u001b[50Gdev\u001b[54Gtimings\u001b[62Gare\u001b[66Gwithin\u001b[73Gnoise\u001b[79Gbetween\u001b[87Gthe\u001b[91Gtwo\u001b[95Gversions.\u001b[105GI'm\u001b[109Gchecking\u001b[118Gthe\r\u001b[2C\u001b[1Bmemory\u001b[10Gsaving\u001b[17Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPeak memory dropped from\u001b[28G705\u001b[32GMB\u001b[35Gto\u001b[38G534\u001b[42GMB\u001b[45G(\u221224%),\u001b[53Gmainly\u001b[60Gfrom\u001b[65Gremoving\u001b[74Gthe\u001b[78G98\u001b[81GMB\u001b[84Gembedding\u001b[94Gcopy\u001b[99Gand\u001b[103Glimiting\u001b[112Gthe\r\u001b[2C\u001b[1Bpartial\u001b[11Greset\u001b[17Gto\u001b[20Gthe\u001b[24Gtouched\u001b[32Gpart\u001b[37Gof\u001b[40Gthe\u001b[44GKV\u001b[47Gcache.\u001b[54GFinal\u001b[60Gvalidation,\u001b[72Gthe\u001b[76Gprecision\u001b[86Gre-check,\u001b[96Gand\u001b[100Gthe\u001b[104Gsaved\u001b[110Gprofile\r\u001b[1B \u001b[3Gcome\u001b[8Gn\u001b[10Gxt.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mValidation passed, and\u001b[26Gthe\u001b[30GGB/s\u001b[35Gdrop\u001b[40Gto\u001b[43G54\u001b[46Glooks\u001b[52Glike\u001b[57Gmachine\u001b[65Gstate"]
[834.885, "\u001b[71Grather\u001b[78Gthan\u001b[83Ga\u001b[85Gregression,\u001b[97Gsince\u001b[103Gthe\u001b[107Gforward\u001b[115Gtime\r\u001b[2C\u001b[1Bmatches\u001b[11Gthe\u001b[15GA/B\u001b[19Gat\u001b[22G8.25\u001b[27Gms.\u001b[31GI'm\u001b[35Gupdating\u001b[44GNOTES.md\u001b[53Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe script stopped at\u001b[25Gits\u001b[29Gsecond\u001b[36Greplacement\u001b[48Gbefore\u001b[55Gwriting\u001b[63Ganything,\u001b[73Gso\u001b[76GNOTES.md\u001b[85Gis\u001b[88Gunchanged.\u001b[99GThe\u001b[103Gwording\u001b[111GI\u001b[113Gmatched\r\u001b[2C\u001b[1Bagainst\u001b[11Gdiffers\u001b[19Gfrom\u001b[24Gthe\u001b[28Gfile.\u001b[34GReading\u001b[42Gthe\u001b[46Gfile's\u001b[53Gcurrent\u001b[61Gtext:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe file's wording\u001b[22Gdiffers\u001b[30Gfrom\u001b[35Gwhat\u001b[40GI\u001b[42Goriginally\u001b[53Gwrote,\u001b[60Gso\u001b[63Gother\u001b[69Ganchors\u001b[77Gmay\u001b[81Gnot\u001b[85Gmatch\u001b[91Geither.\u001b[99GReading\u001b[107Gthe\u001b[111Gwhole\u001b[117Gfile\r\u001b[2C\u001b[1Bbefore\u001b[10Gediting:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI have the exact\u001b[20Gtext\u001b[25Gnow.\u001b[30GApplyin"]
