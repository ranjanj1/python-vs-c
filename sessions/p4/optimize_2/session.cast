[47.945, "\u001b[H\u001b[5G\u001b[1mEdge cases:\u001b[22m PIECE, empty prompt, \u001b[38;2;87;105;247mGENERATE 0\u001b[39m and\u001b[53Gthe \u001b[38;2;87;105;247mcontext\u001b[39m stop behave as before.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrecision rules:\u001b[22G\u001b[22mre-checked\u001b[33Gevery\u001b[39Gkernel;\u001b[47Gthere\u001b[53Gis\u001b[56Gno\u001b[59Gfloat64\u001b[67Gand\u001b[71Gno\u001b[74Gfast-math.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTried and rejected:\u001b[22m\u001b[K\r\u001b[4C\u001b[1BCombining matrices without tiling was slo\u001b[47Ger.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GOther\u001b[11Gtile\u001b[16Gwidths\u001b[23Gand\u001b[27Gunroll\u001b[34Gdepths\u001b[41Gwere\u001b[46Gwithin\u001b[53Gnoise\u001b[59Gof\u001b[62Gthe\u001b[66Gchosen\u001b[73Gones.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAbout\u001b[11G91% o\u001b[17G the\u001b[22Gtime is now matrix-ve\u001b[44Gtor work running near the single-core\u001b[82Gbandwidth\u001b[92Glimit.\u001b[99GLarge\u001b[105Gfurther\u001b[113Ggains\r\u001b[2C\u001b[1B \u001b[5Gw\u001b[7Guld need fewer weight bytes or more cores, \u001b[51Gnd the rules forbid both.\u001b[K\r\u001b[4C\u001b[1BLong cont\u001b[15Gxt\u001b[19Gweren't profiled in detail, becaus\u001b[54G \u001b[56Ghe dev workloads\u001b[73Gstop\u001b[78Gat\u001b[81G82\u001b[84Gpositions.\r\u001b[2C\u001b[1B-\u001b[5GMemory\u001b[12Guse\u001b[16Gis\u001b[19Gunchanged\u001b[2"]
