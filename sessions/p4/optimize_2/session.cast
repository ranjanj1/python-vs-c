[509.45, "\u001b[22m         self.emb_rows\u001b[26G=\u001b[28Gnp.array(src_emb,\u001b[46Gdtype=F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m''')\r\u001b[1B \u001b[2m\u2502\u001b[22m rep('''  \u001b[14G embed(x, emb, toke\u001b[34G)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ''',\u001b[9G'''  \u001b[15G for\u001b[20Gi in range(dim):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         x[i] = emb[token,\u001b[30Gi]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m rep('''        forward(token,\u001b[34Gpos,\u001b[39Gself.emb,\u001b[49G''',\u001b[54G'''\u001b[65Gforward(token,\u001b[80Gpos,\u001b[85Gself.emb_rows,\u001b[100G''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6Gundo\u001b[11GLOGITS\u001b[18Gwrite\u001b[24Gchange\r\u001b[1B \u001b[2m\u2502\u001b[22m rep('''np.empty((n, model.vocab), '<f4')''', '''np.empty((n, model.vocab), F32)''')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m rep('''    \u001b[16G     \u001b[22G  \u001b[25G \u001b[27Gallv.tofile(path)''', '''      \u001b[68Gallv.astype('<f4').tofile(path)''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('scratch/run_v2.py',\u001b[30G'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msed\u001b[8G-i\u001b[11G''\u001b[14G\"s#old\u001b[21G=\u001b[23Gload('run_v1',\u001b[38Gos.path.join(ROOT,\u001b[57G'scratch',\u001b[68G'run_v1.py'))#OLD\u001b[86G=\u001b[88Gsys.argv[2]\u001b[100Gi"]
[509.451, "f\u001b[103Glen(sys.argv)\u001b[117G>\u001b[119G2\r\u001b[1B \u001b[2m\u2502\u001b[22m e\u001b[6Gse 'run_v1'\\nold = load(OLD, os.path.join(ROOT, '\u001b[56Gcratch', OLD + '.py'))#\" scratch/ab.py &&\u001b[98Ggrep\u001b[103G-n \"OLD\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m scratch/ab.py\u001b[18G&& python3 scratch/ab.py\u001b[43G8\u001b[45Grun_v2\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gcp\u001b[40G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for y"]
