[606.035, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsize\u001b[14G64\u001b[17Gwins\u001b[22Gat\u001b[25Gevery\u001b[31Gcontext\u001b[39Glength\u001b[46Gtested,\u001b[54Gup\u001b[57Gto\u001b[60G1.59\u00d7\u001b[66Gfaster\u001b[73Gat\u001b[76G300\u001b[80Gpositions,\u001b[91Gso\u001b[94GI'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttention\r\u001b[2C\u001b[1Btakes about half of each\u001b[28Gtoken's\u001b[36Gtime\u001b[41Gat\u001b[44Gposition\u001b[53G1000,\u001b[59Gbut\u001b[63Gdev\u001b[67Gworkloads\u001b[77Gstay\u001b[82Gunder\u001b[88G83\u001b[91Gpositions,\u001b[102Gso\u001b[105GI'll\u001b[110Gcheck\u001b[116Gwhat\r\u001b[2C\u001b[1Bdominates\u001b[13Gthere.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSoftmax is roughly 11%\u001b[26Gof\u001b[29Gattention\u001b[39Gcost\u001b[44Gat\u001b[47G1000\u001b[52Gpositions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[2C\u001b[1Blong-context\u001b[16Gcosts\u001b[22Gas\u001b[25Ga\u001b[27Glimitation,\u001b[39Gstarting\u001b[48Gin\u001b[51G\u001b[38;2;87;105;247mrun.py\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b["]
[606.036, "38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gchecks\u001b[14Gpass,\u001b[20Gand\u001b[24GI'm\u001b[28Grebuilding\u001b[39Gthe\u001b[43Gprevious\u001b[52Gpass's\u001b[59Gversion\u001b[67Gby\u001b[70Greverting\u001b[80Gthis\u001b[85Gpass's\u001b[92Gedits\u001b[98Gso\u001b[101GI\u001b[103Gcan\u001b[107Grun\u001b[111Ga\u001b[113Gfair\u001b[118GA/B\r\u001b[1B \u001b[3Gand confirm it matches\u001b[26Gbit\u001b[30Gise.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn\u001b[6Gthe\u001b[10Gdev\u001b[14Gpath\u001b[19Gthe\u001b[23Gspeedup\u001b[31Gis\u001b[34Gwithin\u001b[41Gnoise\u001b[47G(1.004\u00d7),\u001b[57Gas\u001b[60Gexpected\u001b[69Gat\u001b[72Gthese\u001b[78Gshort\u001b[84Gpositions,\u001b[95Gso\u001b[98GI'm\u001b[102Gmeasuring\u001b[112Gboth\r\u001b[1B  versions end-to-end at longer contexts next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The long-context FIXED runs are about 5% faster on both rounds (300 tokens: 2.60 \u2192 2.47 s; 1024 tokens: 10.40 \u2192 9.95\u001b[K\r\u001b[1C\u001b[1B s). I'm\u001b[11Gchecking\u001b[20Gtha\u001b[24G the long-context FIXED\u001b[48Ganswers are fully identical,\u001b[77Gthen profiling the end-to-end dev work"]
[606.037, "load\r\u001b[1C\u001b[1B for both versions.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Verifying long-conte\u001b[25G answers and running e2e A/B\u001b[54G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' \"s# out\\[f'FIXED {n} answer'\\] = r.split()\\[:6\\]# import hashlib; out[f'FIXED {n} answer sha1'] = \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mhashlib.sha1(r.encode()).hexdigest()[:12]#\" scratch/longctx.py && python3 scratch/longctx.py scratch/run_v2.py && \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mpython3 scratch/longctx.py run.py && for i in 1 2; do PROG=scratch/run_v2.p\u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273b\u001b[3GNewspapering\u2026 \u001b[38;2;102;102;102m(9m 54s \u00b7 \u2193\u001b[29G35.1k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
