[450.467, "\u001b]0;\u25d1 Claude Code\u0007"]
[450.475, "\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpartial\u001b[15Greset\u001b[21Gis\u001b[24Gcorrect,\u001b[33Gand\u001b[37Gthe\u001b[41Gonly\u001b[46Gremaining\u001b[56Gnon-matvec\u001b[67Gcost\u001b[72Gis\u001b[75Gattention\u001b[85Gand\u001b[89Gkey\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[2C\u001b[1Btoken. I'm prototyping\u001b[26Ga\u001b[28Gblocked\u001b[36Gkey\u001b[40Glayout\u001b[47Gthat\u001b[52Gkeeps\u001b[58Gpositions\u001b[68Gcontiguous,\u001b[80Gwith\u001b[85Gthe\u001b[89Gbenchmark\u001b[99Gflushing\u001b[108Gcaches\r\u001b[2C\u001b[1Bbetween\u001b[11Gcalls.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSingle samples are too\u001b[26Gnoisy\u001b[32Gto\u001b[35Gjudge.\u001b[42GI'll\u001b[47Grepeat\u001b[54Geach\u001b[59Gmeasurement\u001b[71G9\u001b[73Gtimes\u001b[79Gwith\u001b[84Ga\u001b[86Gcache\u001b[92Gflush\u001b[98Gbefore\u001b[105Geach\u001b[110Gand\u001b[114Gtake\r\u001b[2C\u001b[1Bmedians:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked\u001b[11Gkeys\u001b[16Gare\u001b[20Gfaster\u001b[27Gup\u001b[30Gto\u001b[33G~300\u001b[38Gpositions\u001b[48G(1.11\u20131.53\u00d7"]
[450.477, ")\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[2C\u001b[1Bpositions. Trying larger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsize\u001b[14G64\u001b[17Gwins\u001b[22Gat\u001b[25Gevery\u001b[31Gcontext\u001b[39Glength\u001b[46Gtested,\u001b[54Gup\u001b[57Gto\u001b[60G1.59\u00d7\u001b[66Gfaster\u001b[73Gat\u001b[76G300\u001b[80Gpositions,\u001b[91Gso\u001b[94GI'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttention\r\u001b[1B \u001b[3Gtakes about half of each toke\u001b[33G's time\u001b[41Gat\u001b[44Gposition\u001b[53G1000,\u001b[59Gbut\u001b[63Gdev\u001b[67Gworkloads\u001b[77Gstay\u001b[82Gunder\u001b[88G83\u001b[91Gpositions,\u001b[102Gso\u001b[105GI'll\u001b[110Gcheck\u001b[116Gwhat\r\u001b[1B  dominates there.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Softmax is roughly\u001b[22G11%\u001b[26Gof\u001b[29Gattention\u001b[39Gcost\u001b[44Gat\u001b[47G1000\u001b[52Gpositions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[1C\u001b[1B long-context costs as a limitation,"]
