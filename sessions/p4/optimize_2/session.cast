[440.679, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExisting tests still pass with bitwise-identical output, but the partial reset needs its own test: after a long\r\u001b[2C\u001b[1Bcommand then\u001b[16Ga\u001b[18Gshort\u001b[24Gone,\u001b[29Gthe\u001b[33Gcache\u001b[39Gmust\u001b[44Gbe\u001b[47Gall\u001b[51Gzeros\u001b[57Gand\u001b[61Gmatch\u001b[67Ga\u001b[69Gfresh\u001b[75Gprocess.\u001b[84GI'm\u001b[88Gwriting\u001b[96Gthat\u001b[101Gtest\u001b[106Gnext.\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The partial reset is correct, and the only remaining non-matvec cost is attention\u001b[85Gand\u001b[89Gkey\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[1C\u001b[1B token. I'm prototyping a blocked key\u001b[40Glayout\u001b[47Gthat\u001b[52Gkeeps\u001b[58Gpositions\u001b[68Gcontiguous,\u001b[80Gwith\u001b[85Gthe\u001b[89Gbenchmark\u001b[99Gflushing\u001b[108Gcaches\r\u001b[1B  between calls.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Single samples are too n\u001b[28Gisy \u001b[33Go judge. I'll repe\u001b[52Gt e\u001b[56Gc\u001b[58G measurement 9 times with a cache flush\u001b[98G"]
