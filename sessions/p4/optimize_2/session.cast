[815.785, "py\u001b[82G(98\u001b[86GMB,\u001b[90Gbecause\u001b[98Git\u001b[101Gis\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mshared\u001b[13Gwith\u001b[18Gthe\u001b[22G98\u001b[25GMB\u001b[28Gembedding)\u001b[39Gstay\u001b[44Gresident.\u001b[54GThe\u001b[58Gcheckpoint\u001b[69Gis\u001b[72Gmapped\u001b[79Gread-only\u001b[89Gduring\u001b[96Gload.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   Load time depends\u001b[24Gheavily\u001b[32Gon\u001b[35GOS\u001b[38Gmemory\u001b[45Gpressure:\u001b[55Gthe\u001b[59Gfirst\u001b[65Gload\u001b[70Gin\u001b[73Ga\u001b[75Gfresh\u001b[81Gprocess\u001b[89Gafter\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mrecompiling\u001b[18Gor\u001b[21Gunder\u001b[27Gpressure\u001b[36Gwas\u001b[40Gseen\u001b[45Gat\u001b[48Gup\u001b[51Gto\u001b[54G~1.6\u001b[59Gs.''',\u001b[66G'''-\u001b[71G**Memory**:\u001b[83Gthe\u001b[87Gtiled\u001b[93Gweights\u001b[101G(438\u001b[106GMB)\u001b[110Gand\u001b[114Gthe\r\u001b[1B \u001b[2m\u2502\u001b[22m tiled classifier (98 MB, which\u001b[36Glso serves \u001b[48Ghe\u001b[51G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   embedding lookup when shared) s\u001b[38Gay resident. The peak\u001b[61Gootpr\u001b[67Gnt is 534\u001b[77GMB. The checkpoint\u001b[96Gis\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   mapped read-only\u001b[23Gduring\u001b[30Gload.\u001b[36GLoad\u001b[41Gtime\u001b[46Gdepends\u001b[54Gheavily\u001b[62Gon\u001b[65GOS\u001b[68Gmemory\u001b[75Gpressure:\u001b[85Gwhen\u001b[90Gthe\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mcheckpoint\u001b[17Ghas\u001b[2"]
[815.785, "1Gbeen\u001b[26Gevicted\u001b[34Gfrom\u001b[39Gthe\u001b[43Gfile\u001b[48Gcache,\u001b[55Greading\u001b[63Git\u001b[66Gcosts\u001b[72G~1\u001b[75Gs\u001b[77Gmore.''')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m rep('''- **Long contexts**:\u001b[32Gattention\u001b[42Gand\u001b[46Gthe\u001b[50GKV-cache\u001b[59Gstores\u001b[66Ggrow\u001b[71Gwith\u001b[76Gposition.\u001b[86GThey\u001b[91Gare\u001b[95G3%\u001b[98Gat\u001b[101Gthe\u001b[105Gdev\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mworkloads'\u001b[17G\u226482\u001b[21Gpositions,\u001b[32Gbut\u001b[36Glarger\u001b[43Gnear\u001b[48Gseq_len\u001b[56G=\u001b[58G1024.\u001b[64GThat\u001b[69Grange\u001b[75Gwas\u001b[79Gonly\u001b[84Gexercised\u001b[94Gby\r\u001b[1B \u001b[2m\u2502\u001b[22m   `edge.py` (~10.8 s for 1016 forced + 9 n\u001b[47Gw positions), not profiled in detail.''', '''- **Long contexts**:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m attention grows with\u001b[25Gposition.\u001b[35GIt\u001b[38Gis\u001b[41G~3%\u001b[45Gof\u001b[48Ga\u001b[50Gtoken\u001b[56Gat\u001b[59Gthe\u001b[63Gdev\u001b[67Gworkloads'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m\u226482\u001b[10Gpositions,\u001b[21Gbut\u001b[25G~4.2\u001b[30Gms\u001b[33Gper\u001b[37Gtoken\u001b[43G(about\u001b[50Ghalf)\u001b[56Gnear\u001b[61Gposition\u001b[70G1000:\u001b[76Gscore\u001b[82Gand\u001b[86Gvalue\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   arithmetic plus KV\u001b[25Greads,\u001b[32Gwith\u001b[37Gsoftmax\u001b[45G~11%.\u001b[51GThe\u001b[55Gblocked\u001b[63Gkey\u001b[6"]
[815.787, "7Gcache\u001b[73Ghelped\u001b[80Gup\u001b[83Gto\u001b[86G~300\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mpositions.\u001b[17GBeyond\u001b[24Gthat,\u001b[30Gvectorizing\u001b[42G`expf`\u001b[49Gwould\u001b[55Gchange\u001b[62Gits\u001b[66Gresults,\u001b[75Gand\u001b[79Gmulti-position\r\u001b[1B \u001b[2m\u2502\u001b[22m   prefill is excluded (see above), so\u001b[42Git\u001b[45Gwas not\u001b[53Gpursued furth\u001b[67Gr.''')\u001b[74G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m rep('''- **Startup** (~1.3\u20131.6 s): ~0.55 s\u001b[47Gis importing\u001b[60Gnumpy+numba, ~0.4 s \u001b[82G loading and tiling, and\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   ~0.1 s is\u001b[16Ga\u001b[18Gwarm-up\u001b[26Gforward.\u001b[35GThere\u001b[41Gis\u001b[44Gno\u001b[47Gfurther\u001b[55Geasy\u001b[60Gcut\u001b[64Gwithin\u001b[71Gthe\u001b[75Grules.''',\u001b[86G'''-\u001b[91G**Startup**\u001b[103G(~1.0\u001b[109Gs,\u001b[112Gmore\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22munder\u001b[10Gmemory\u001b[17Gpressure):\u001b[28G~0.6\u20130.85\u001b[38Gs\u001b[40Gis\u001b[43Gimporting\u001b[53Gnumpy+numba\u001b[65G(not\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   reducible from here),\u001b[28G~0.15\u20130.2\u001b[38Gs\u001b[40Gis\u001b[43Gloading\u001b[51Gand\u001b[55Gtiling,\u001b[63Gand\u001b[67G~0.1\u001b[72Gs\u001b[74Gis\u001b[77Gthe\u001b[81Gwarm-up\u001b[89Gforward,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mwhich\u001b[12Gloads\u001b[18Gthe\u001b[22Gcached\u001b[29Gkernels.''')\r\u001b[1B"]
