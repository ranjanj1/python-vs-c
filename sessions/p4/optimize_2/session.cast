[213.698, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gremaining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLast\u001b[8Gpass\u001b[13Gleft\u001b[18Gthe\u001b[22Gmatrix\u001b[29Gkernels\u001b[37Gnear\u001b[42Gthe\u001b[46Gsingle-core\u001b[58Gbandwidth\u001b[68Gceiling,\u001b[77Gso\u001b[80GI'll\u001b[85Gstart\u001b[91Gby\u001b[94Gre-profiling\u001b[107Gthe\u001b[111Gwhole\r\u001b[1B \u001b[3Gse\u001b[6Gsion to find where the\u001b[29Gr\u001b[31Gmaining time goes, including the parts outside the forward pass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gtakes\u001b[17G1.1\u20132.6\u001b[25Gs,\u001b[28Gmostly\u001b[35Gfrom\u001b[40G\u001b[38;2;87"]
[213.7, ";105;247mimport numba\u001b[53G\u001b[39mand\u001b[57Gweight\u001b[64Gpreparation,\u001b[77Gso\u001b[80GI'm\u001b[84Gsplitting\u001b[94Gthe\u001b[98Gweight\u001b[105Gstep\u001b[110Ginto\u001b[115Gfile\r\u001b[1B \u001b[3Gre\u001b[6Gds, page faults and the cop\u001b[34G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcheckpoint's\u001b[20Gpages\u001b[26Gsometimes\u001b[36Gfall\u001b[41Gout\u001b[45Gof\u001b[48Gthe\u001b[52GOS\u001b[55Gfile\u001b[60Gcache,\u001b[67Gtaking\u001b[74Gup\u001b[77Gto\u001b[80G952\u001b[84Gms\u001b[87Gon\u001b[90Gthe\u001b[94Gfirst\u001b[100Gtouch,\u001b[107Gand\u001b[111Gthe\u001b[115Grest\r\u001b[1B \u001b[3Gof weight loading takes \u001b[28Gnly 130\u2013200 ms. Next I'll look at t\u001b[65G per-command \u001b[79Gverhead\u001b[88Gutside the forward\u001b[107Gpass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNon-forward-pass\u001b[20Goverheads\u001b[30Gare\u001b[34Gall\u001b[38Gsmall\u001b[44G(dispatch,\u001b[55Gargmax,\u001b[63GKV\u001b[66Greset,\u001b[73Gand\u001b[77Gthe\u001b[81GLOGITS\u001b[88Gwrite),\u001b[96Gand\u001b[100Gthe\u001b[104Gkernels\u001b[112Gare\r\u001b[1B \u001b[3Galready \u001b[12Gt the hardwar\u001b[26G limit.\u001b[34GNext I'\u001b[44Gtest p"]
[213.701, "utting all weights into one buffer in\u001b[88Gforward-pass order, since the\r\u001b[2C\u001b[1Bfour sep\u001b[12Gra\u001b[15Ge arrays make each\u001b[34Glayer jump be\u001b[48Gween memory streams.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The strided views weren't C-contiguous, so\u001b[46GNumba\u001b[52Gfell\u001b[57Gback\u001b[62Gto\u001b[65Ga\u001b[67Gnon-vectorizing\u001b[83Gversion,\u001b[92Gand\u001b[96Gthe\u001b[100Gmachine\u001b[108Gis\u001b[111Gmore\r\u001b[2C\u001b[1Bloaded now, so that comparison is invalid. I'm redoing it with contiguous per-layer views from one flat buffer, each\r\u001b[2C\u001b[1Blayout measured in its own process.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[29C\u001b[2B\u001b[38;2;102;102;102m5\u001b[32G2\u001b[39m\u001b[40;1H\u001b[38;3H"]
