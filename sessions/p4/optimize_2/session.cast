[229.238, "e\r\u001b[1C\u001b[1B loaded now,\u001b[15Gso\u001b[18Gthat\u001b[23Gcomparison\u001b[34Gis\u001b[37Ginvalid.\u001b[46GI'm\u001b[50Gredoing\u001b[58Git\u001b[61Gwith\u001b[66Gcontiguous\u001b[77Gper-layer\u001b[87Gviews\u001b[93Gfrom\u001b[98Gone\u001b[102Gflat\u001b[107Gbuffer,\u001b[115Geach\r\u001b[1C\u001b[1B layout\u001b[10Gmeasured in its\u001b[26Gown\u001b[30Gprocess.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Comparing separate\u001b[22Gvs flat weight layout per process\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/bench_flat2.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m\"\"\"Separate per-matrix arrays vs one flat buffer in consumption order (contiguous views). Run one mode per \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mprocess.\"\"\"\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport os, sys, time, statistics, json, math, gc\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, ROOT)\u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2736\u001b[3G\u001b[38;2;245;149;117mNewspapering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(3m 42s \u00b7 \u2193\u001b[29G16.5k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw"]
