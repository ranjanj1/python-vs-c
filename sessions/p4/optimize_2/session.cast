[120.473, "\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The check\u001b[13Go\u001b[15Gnt's pages sometimes fall out of\u001b[48Gthe\u001b[52GOS\u001b[55Gfile\u001b[60Gcache,\u001b[67Gtaking\u001b[74Gup\u001b[77Gto\u001b[80G952\u001b[84Gms\u001b[87Gon\u001b[90Gthe\u001b[94Gfirst\u001b[100Gtouch,\u001b[107Gand\u001b[111Gthe\u001b[115Grest\r\u001b[1C\u001b[1B of\u001b[6Gweight loading take\u001b[26G only 130\u2013200 ms. Next\u001b[49GI'll\u001b[54Glook\u001b[59Gat\u001b[62Gthe\u001b[66Gper-command overhead outside the forward pass.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Measuring per-call overheads outside\u001b[40Gforward\u001b[71G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/overhead.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102m\"\"\"Per-call overheads outside the forward pass: dispatch of forward() with its 29 args, argmax, reset, LOGITS \r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mcopy/write.\"\"\"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport os, sys, time, statistics, tempfile\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, ROOT); o\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;223;127;95mNews"]
