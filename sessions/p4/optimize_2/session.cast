[889.65, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m (all bitwise identical):\u001b[36G\u001b[K\r\u001b[2C\u001b[1B1.\u001b[6GThe\u001b[10Gblocked\u001b[18Gkey-cache\u001b[28Glayout.\r\u001b[2C\u001b[1B2. No sep\u001b[13Grate 98 MB\u001b[24Gembedding copy:\u001b[40Gtoken\u001b[46Glookups\u001b[54Gread\u001b[59Gthe\u001b[63Gtiled\u001b[69Gclassifier\u001b[80Ginstead.\r\u001b[2C\u001b[1B3\u001b[10Greset clears only\u001b[28Gthe positions\u001b[42Gthe\u001b[46Gprevious\u001b[55Gcommand\u001b[63Gused.\u001b[69GThe\u001b[73Gcache\u001b[79Gis\u001b[82Gstill\u001b[88Gall-zero\u001b[97Gat\u001b[100Gthe\u001b[104Gstart\u001b[110Gof\u001b[113Gevery\r\u001b[2C\u001b[1B  \u001b[6Gc\u001b[8Gmmand.\u001b[K\r\u001b[2C\u001b[1B4\u001b[6GLOGITS writes its array directly, wi\u001b[44Gout an extra copy.\u001b[63G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured against the previous version\u001b[22m (reb\u001b[46Gilt by reverting\u001b[63Gthis\u001b[68Gpass's\u001b[75Gedits;\u001b[82Git\u001b[85Greproduces\u001b[96Gthat\u001b[101Gversion's\u001b[111Glogits\r\u001b[2C\u001b[1Bexactly):\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502\u001b[32G\u2502\u001b[36GPrevious\u001b[48G\u2502\u001b[53GCurrent\u001b[64G\u2502\r\u001b[2C"]
[889.652, "\u001b[1B\u251c\u001b[32G\u253c\u001b[48G\u253c\u001b[64G\u2524\r\u001b[4C\u001b[1BForward\u001b[13Gpass,\u001b[19Gms\u001b[22Gper\u001b[26Gtoken\u001b[34G8.29      \u001b[50G8.25 (noise)\r\u001b[4C\u001b[2BWhole \u001b[12Gev \u001b[16Gession   \u001b[26G     \u001b[34G4\u001b[36G70\u001b[39G/\u001b[41G5.39\u001b[46Gs\u001b[50G4\u001b[52G70\u001b[55G/ 4.93 s\r\u001b[4C\u001b[2BFIXED\u001b[11G1024 po\u001b[20Gtions\u001b[34G10.4\u001b[39Gs\u001b[41G    \u001b[46G \u001b[50G9\u001b[52G95\u001b[55Gs\u001b[57G    \u001b[62G \r\u001b[4C\u001b[2BPeak memory         \u001b[34G7\u001b[36G5 MB\u001b[50G534 MB\r\u001b[2C\u001b[1B\u2514\u001b[32G\u2534\u001b[48G\u2534\u001b[64G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI tried putting all weights in one buffer in the order they're\u001b[66Gused;\u001b[72Git\u001b[75Gwas\u001b[79Gwithin\u001b[86Gnoise,\u001b[93Gso\u001b[96GI\u001b[98Gdropped\u001b[106Git.\r\u001b[2C\u001b[2B\u001b[1mTests:\u001b[22m the full\u001b[19G\u001b[38;2;87;105;247mcheck.py\u001b[39m, bitwise compariso\u001b[47Gs against both earlier version\u001b[78G, \u001b[81Gdentical long-context answers,\u001b[112Gsynthetic\r\u001b[2C\u001b[1Bmodels\u001b[10Gwith\u001b[15Gawkward\u001b[23Gshapes,\u001b[31Ga\u001b[33Gnew\u001b[37Gtest\u001b[42Gthat\u001b[47Gthe\u001b[51Gpartial\u001b[59Greset\u001b[65Gleaves\u001b[72Gthe\u001b[76Gcache\u001b[82Gall-zero,\u001b[92Gthe\u001b[96Gedge-case\u001b[106Gtests,\u001b[113Gand\u001b[117Ga\r\u001b[2C\u001b[1Bre-check of the\u001b[19Gprecision\u001b[29Grules on every kernel."]
