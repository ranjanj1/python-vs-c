[834.909, "\u001b[H\r\u001b[2C\u001b[3BPeak memory dropped from\u001b[28G705 MB\u001b[35Gto 534 MB (\u221224%), ma\u001b[56Gnly from remov\u001b[72Gg the 98 MB \u001b[85Gmbedding copy and limiting the\u001b[K\r\u001b[2C\u001b[1Bpartial reset\u001b[17Gto \u001b[21Ghe\u001b[24Gtouched\u001b[32Gpart\u001b[37Gof\u001b[40Gthe\u001b[44GKV\u001b[47Gcache.\u001b[54GFinal\u001b[60Gvalidation,\u001b[72Gthe\u001b[76Gprecision\u001b[86Gre-check,\u001b[96Gand\u001b[100Gthe\u001b[104Gsaved\u001b[110Gprofile\r\u001b[2C\u001b[1Bcome\u001b[8Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mV\u001b[5Glid\u001b[9Gtion passed, and the GB/s dr\u001b[38Gp\u001b[41Go 54 looks like machine s\u001b[67Gate rather than a regression, since the forward time\r\u001b[2C\u001b[1Bmatches \u001b[12Ghe\u001b[15GA/B\u001b[19Gat\u001b[22G8.25\u001b[27Gms.\u001b[31GI'm\u001b[35Gupdating\u001b[44GNOTES.md\u001b[53Gnext.\r\u001b[6C\u001b[2B\u001b[38;2;102;102;102m\u001b[1m1\u001b[22G\u001b[22m \u001b[39m\u001b[K\r\u001b[2C\u001b[2BThe scr\u001b[11Gpt\u001b[14Gstopped\u001b[23Gt i\u001b[27Gs second \u001b[37Ge\u001b[39Glacement before writing any\u001b[67Ghing, so NOTES.md\u001b[85Gis unchanged. Th\u001b[103Gwording I ma\u001b[116Gch\u001b[119Gd\r\u001b[2C\u001b[1Bagainst\u001b[11Gdiffers\u001b[19Gfrom the file. Rea\u001b[38Ging the file's\u001b[53Gcurrent\u001b[61Gtext"]
[834.91, ":\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102mead \u001b[1m1\u001b[22m fi\u001b[13Ge\u001b[15G\u001b[39m\u001b[K\r\u001b[6C\u001b[2Bfile's\u001b[14Gwording\u001b[22Gdiffers fr\u001b[33Gm what I originally wrote, so\u001b[63Gother anchors may not\u001b[85Gmatch eith\u001b[96Gr\u001b[99GReading the\u001b[111Gwhole file\r\u001b[2C\u001b[1Bbefore e\u001b[13Gting:\u001b[19G\u001b[K\r\u001b[2C\u001b[4BI have the\u001b[14Gexact text now.\u001b[30GApplying the updates with \u001b[57Gargeted edits:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
