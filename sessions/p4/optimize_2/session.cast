[510.026, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Blocked keys are\u001b[20Gfaste\u001b[26G up to ~300 positions (1.11\u20131.53\u00d7) and bitwi\u001b[72G identical, but about\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[1C\u001b[1B positions.\u001b[14GTrying\u001b[21Glarger block\u001b[34G for a\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Block\u001b[9Gsize\u001b[14G64\u001b[17Gwins\u001b[22Gat\u001b[25Gevery\u001b[31Gcontext\u001b[39Glength\u001b[46Gtested,\u001b[54Gup\u001b[57Gto\u001b[60G1.59\u00d7\u001b[66Gfaster\u001b[73Gat\u001b[76G300\u001b[80Gpositions,\u001b[91Gso\u001b[94GI'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttention\r\u001b[1C\u001b[1B takes about half\u001b[20Gof\u001b[23Geach\u001b[28Gtoken's\u001b[36Gtime\u001b[41Gat\u001b[44Gposition\u001b[53G1000,\u001b[59Gbut\u001b[63Gdev\u001b[67Gworkloads\u001b[77Gstay\u001b[82Gunder\u001b[88G83\u001b[91Gpositions,\u001b[102Gso\u001b[105GI'll\u001b[110Gcheck\u001b[116Gwhat\r\u001b[1C\u001b[1B dominates\u001b[13Gthere.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Softmax is\u001b[14Groughly 11% of\u001b[29Gatt\u001b[33Gntion cost at\u001b[47G1000 positions,\u001b[63Gso\u001b[66"]
[510.028, "GI'm\u001b[70Ggoing\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[1C\u001b[1B long-context\u001b[16Gcost\u001b[21G as a limitation, start\u001b[45Gng\u001b[48Gin \u001b[38;2;87;105;247mrun.py\u001b[39m.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All checks\u001b[14Gpass,\u001b[20Gand I'm r\u001b[30Gbu\u001b[33Glding\u001b[39Gthe\u001b[43Gprevious\u001b[52Gpass's\u001b[59Gversion\u001b[67Gby\u001b[70Greverting\u001b[80Gthis\u001b[85Gpass's\u001b[92Gedits\u001b[98Gso\u001b[101GI\u001b[103Gcan\u001b[107Grun\u001b[111Ga\u001b[113Gfair\u001b[118GA/B\r\u001b[1C\u001b[1B and\u001b[7Gconfirm it matches bitw\u001b[31Gse.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Rebuilding\u001b[14Gpass-2 version and A/B against it\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cp run.py scratch/run_v3.py && python3 - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport re\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102ms = open('run.py').read()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mdef rep(b, a):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mglobal s\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102massert s.count(b) == 1, b[:80]; "]
[510.029, "s = s.replace(b, a)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m# undo blocked keys\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mrep('''KBLK = 64 # positions per key-cache block (see attention)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m''', '')\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mi = s.index(' B = kc.shape[3]\\n for h in r\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u2736\u001b[39m \u001b[38;2;215;119;87mNewspapering\u2026 \u001b[38;2;102;102;102m(8m 19s \u00b7 \u2193\u001b[29G32.8k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G    \u001b[37G  \u001b[40G \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
