[303.287, "Grest\r\u001b[1B \u001b[3Gof weight loading takes \u001b[28Gnly 130\u2013200 ms. Next I'll look at t\u001b[65G per-command \u001b[79Gverhead\u001b[88Gutside the forward\u001b[107Gpass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNon-forward-pass\u001b[20Goverheads\u001b[30Gare\u001b[34Gall\u001b[38Gsmall\u001b[44G(dispatch,\u001b[55Gargmax,\u001b[63GKV\u001b[66Greset,\u001b[73Gand\u001b[77Gthe\u001b[81GLOGITS\u001b[88Gwrite),\u001b[96Gand\u001b[100Gthe\u001b[104Gkernels\u001b[112Gare\r\u001b[1B \u001b[3Galready \u001b[12Gt the hardwar\u001b[26G limit.\u001b[34GNext I'\u001b[44Gtest putting all weights into one buffer in\u001b[88Gforward-pass order, since the\r\u001b[2C\u001b[1Bfour sep\u001b[12Gra\u001b[15Ge arrays make each\u001b[34Glayer jump be\u001b[48Gween memory streams.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gstrided\u001b[15Gviews\u001b[21Gweren't\u001b[29GC-contiguous,\u001b[43Gso\u001b[46GNumba\u001b[52Gfell\u001b[57Gback\u001b[62Gto\u001b[65Ga\u001b[67Gnon-vectorizing\u001b[83Gversion,\u001b[92Gand\u001b[96Gthe\u001b[100Gmachine\u001b[108Gis\u001b[111Gmore\r\u001b[1B \u001b[3Gloaded now,\u001b[15Gso that compariso"]
[303.288, "n is invalid.\u001b[46GI'\u001b[49G redoing it with contiguous per-lay\u001b[86G views from one flat buffer, each\r\u001b[3C\u001b[1Bayout\u001b[10Gmeasured in its own proce\u001b[36Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle-buffer\u001b[21Glayout\u001b[28Gcame\u001b[33Gin\u001b[36Gwithin\u001b[43Gnoise,\u001b[50Gso\u001b[53GI'm\u001b[57Gdropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b[111Gsharing\r\u001b[1B \u001b[3Gt\u001b[7Gembedding w\u001b[19Gights, resetting\u001b[36Gonly the KV po\u001b[51Gitions the last command use\u001b[79G, and w\u001b[87Giting \u001b[94Gogits directly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mLocating\u001b[12Gcode\u001b[17Gto\u001b[20Gchange\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102m \u23bf  run.py\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
