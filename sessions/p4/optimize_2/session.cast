[513.068, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked\u001b[11Gkeys\u001b[16Gare\u001b[20Gfaster\u001b[27Gup\u001b[30Gto\u001b[33G~300\u001b[38Gpositions\u001b[48G(1.11\u20131.53\u00d7)\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[1B \u001b[3Gpositions. Trying larger blocks for a better\u001b[48Gbalance:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsize\u001b[14G64\u001b[17Gwins\u001b[22Gat\u001b[25Gevery\u001b[31Gcontext\u001b[39Glength\u001b[46Gtested,\u001b[54Gup\u001b[57Gto\u001b[60G1.59\u00d7\u001b[66Gfaster\u001b[73Gat\u001b[76G300\u001b[80Gpositions,\u001b[91Gso\u001b[94GI'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttention\r\u001b[1B \u001b[3Gtakes\u001b[9Gabout half of each token's time at position 1000, but dev worklo\u001b[74Gds stay under 83\u001b[91Gp\u001b[93Gsitions, so I'll check what\r\u001b[2C\u001b[1Bdominates \u001b[14Ghere.\u001b[20G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSoftmax\u001b[11Gis\u001b[14Groughly\u001b[22G11%\u001b[26Gof\u001b[29Gattention\u001b[39Gcost\u001b[44Gat\u001b[47G1000\u001b[52Gpositions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing\u001b[76Gwith\u001b"]
