[352.213, "[1B\u001b[2m\u2502\u001b[22m     for p\u001b[15Gt in enumerate(\u001b[31Geq): out[p] = m.forward(t,\u001b[58Gp)\u001b[61G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     return out\u001b[19G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mshort\u001b[10G=\u001b[12Gfx['prompts'][0]['seq'][:20]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m fresh = seqrun(short)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mlong_\u001b[10G=\u001b[12Gfx['prompts'][2]['seq']\u001b[36G+\u001b[38Gfx['prompts'][1]['seq']\u001b[71G#\u001b[73G161\u001b[77Gpositions\r\u001b[1B \u001b[2m\u2502\u001b[22m s\u001b[6Gqru\u001b[10G(\u001b[12Gong_)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m again = seqrun(short)\u001b[26G         \u001b[36G    \u001b[41G   \u001b[45G  \u001b[48G         \u001b[58G   \u001b[62G    \u001b[67G    # after a\u001b[81Glonge\u001b[87G command\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm.reset()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print('cache all-zero after reset:', not m.key_cache.any()\u001b[63Gand\u001b[67Gnot\u001b[71Gm.value_cache.any(),\u001b[92G'\u001b[94Gused\u001b[99G=',\u001b[103Gm.used)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('short\u001b[17Gsequence\u001b[26Gidentical\u001b[36Gafter\u001b[42Ga\u001b[44Glonger\u001b[51Gone:',\u001b[58Gnp.array_equal(fresh,\u001b[80Gagain))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/test_r\u001b[27Gse\u001b[30G.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c"]
[352.214, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/test_reset.py\u001b[74G\u001b[22mcommands\u001b[83Gin\u001b[86G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
