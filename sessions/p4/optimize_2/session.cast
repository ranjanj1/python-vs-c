[867.672, "82G         \u001b[92G             \u001b[108G \u001b[110G    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m5\u001b[12G\u001b[38;2;51;51;51m`scratch/` holds\u001b[29Gonly benchmark/test helpers, the saved profiles,\u001b[78Gand\u001b[82Gearlier\u001b[90Gversions\u001b[99Gfor\u001b[103GA/B:\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m`run_v1.py` (first version),\u001b[41G`run_v2.py` (after the first performance pass) and `run_v3.py`           \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m(a snapshot of the current\u001b[39G`run.py`). `run.py` does not use an\u001b[76Gof it.\u001b[84G \u001b[86G  \u001b[89G                         \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[12G\u001b[38;2;51;51;51m   \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m9\u001b[12G\u001b[22m## Limitations / choices to note\r\u001b[5C\u001b[1B\u001b[2m 310 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 311 \u001b[22m - **Bandwidth ceiling**: 91% of the time is now matrix-vector work at ~58\u201360 GB/s, close to what\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(NOTES.md)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[867.672, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;102;102;102m\u2026\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[867.673, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mNOTES.md\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[867.684, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mNOTES.md\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 315 \u001b[22m - **Summation order**: each matvec output is summed in the same order as run.c. Numba emits no\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;"]
[867.685, "51m\u001b[2m 316 \u001b[22m   FMA (no `contract` flag), while the build that produced the fixtures may have fused\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 317 \u001b[22m   multiply-adds. The differences are ~1e-5 in the logits.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 318 -\u001b[38;2;51;51;51m- **Memory**: the tiled weights (438 MB) and the tiled classifier \u001b[48;2;255;199;199mcopy \u001b[48;2;255;220;220m(98 MB, \u001b[48;2;255;199;199mbecause\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mit\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mis\u001b[48;2;255;220;220m                      \r\u001b[1B\u001b[38;2;207;34;46m 319 -\u001b[38;2;51;51;51m  shared with the 98 MB embedding) stay resident. The checkpoint is mapped read-only during load.                 \r\u001b[1B\u001b[38;2;207;34;46m 320 -\u001b[38;2;51;51;51m  Load time depends heavily on OS memory pressure: the first load in a fresh process after                        \r\u001b[1B\u001b[38;2;207;34;46m 321 -\u001b[38;2;51;51;51m  recompiling or under pressure was seen at up to ~1.6 s.                                                         \r\u001b[1B\u001b[38"]
[867.686, ";2;207;34;46m 322 -\u001b[38;2;51;51;51m- **Long contexts**: attention \u001b[48;2;255;199;199mand\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mthe KV-cache stores grow \u001b[48;2;255;220;220mwith position. \u001b[48;2;255;199;199mThey\u001b[48;2;255;220;220m \u001b[48;2;255;199;199mare\u001b[48;2;255;220;220m 3% at the dev                 \r\u001b[1B\u001b[38;2;207;34;46m 323 -\u001b[38;2;51;51;51m  workloads' \u226482 positions, but larger near seq_len = 1024. That range was only exercised by                      \r\u001b[1B\u001b[38;2;207;34;46m 324 -\u001b[38;2;51;51;51m  `edge.py` (~10.8 s for 1016 forced + 9 new positions), not profiled in detail.                                  \r\u001b[1B\u001b[38;2;207;34;46m 325 -\u001b[38;2;51;51;51m- **Startup** (~1.3\u20131.6 s): ~0.55 s is importing numpy+numba, ~0.4 s is loading and tiling, and                   \r\u001b[1B\u001b[38;2;207;34;46m 326 -\u001b[38;2;51;51;51m  ~0.1 s is a warm-up forward. There is no further easy cut within the rules.                                     \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 318 +\u001b[38;2;51;51;51m- **Memo\u001b[16Gy**: the ti"]
[867.687, "led weights (438 MB) and the tiled\u001b[62Gclassifier (98 MB, \u001b[48;2;178;255;178mwhich\u001b[48;2;220;255;220m \u001b[48;2;178;255;178malso\u001b[48;2;220;255;220m \u001b[48;2;178;255;178mserves the\u001b[103G\u001b[48;2;220;255;220m    \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 319 +\u001b[38;2;51;51;51m  embedding lookup when\u001b[31Gshared) stay resident. The peak footprint is 534 MB. The\u001b[88Gcheckpoint is  \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 320 +\u001b[38;2;51;51;51m  mapped read-\u001b[22Gnly during load.\u001b[39GLoad time depe\u001b[54Gds heavily \u001b[66Gn\u001b[68GOS memory pressure:\u001b[88Gwhen\u001b[93Gthe\u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 321 +\u001b[38;2;51;51;51m  checkpoint\u001b[20Ghas\u001b[24Gbeen\u001b[29Gevicted\u001b[37Gfrom\u001b[42Gthe\u001b[46Gfile\u001b[51Gcache,\u001b[58Greading\u001b[66Git\u001b[69Gcosts\u001b[75G~1\u001b[78Gs\u001b[80Gmore.\u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 322 +\u001b[38;2;51;51;51m- **Long contexts**: attention \u001b[48;2;178;255;178mgrows\u001b[48;2;220;255;220m with position. \u001b[48;2;178;255;178mIt\u001b[48;2;220;255;220m \u001b[48;2;178;255;178mis\u001b[48;2;220;255;220m \u001b[48;2;178;255;178m~\u001b[48;2;220;255;220m3% \u001b[48;2;178;255;178mof a toke"]
[867.688, "n \u001b[48;2;220;255;220mat the dev\u001b[48;2;178;255;178m workloads'\u001b[48;2;220;255;220m                    \r\u001b[1B\u001b[38;2;36;138;61m 323 +\u001b[38;2;51;51;51m  \u226482 positions, but ~4.2 ms per token (about half) near position 1000: score and value                           \r\u001b[1B\u001b[38;2;36;138;61m 324 +\u001b[38;2;51;51;51m  arithmetic plus KV reads, with softmax ~11%. The blocked key cache helped up to ~300                            \r\u001b[1B\u001b[38;2;36;138;61m 325 +\u001b[38;2;51;51;51m  positions. Beyond that, vectorizing `expf` would change its results, and multi-position                         \r\u001b[1B\u001b[38;2;36;138;61m 326 +\u001b[38;2;51;51;51m  prefill is excluded (see above), so it was not pursued further.                                                 \r\u001b[1B\u001b[38;2;36;138;61m 327 +\u001b[38;2;51;51;51m- **Startup** (~1.0 s, more under memory pressure): ~0.6\u20130.85 s is importing numpy+numba (not                     \r\u001b[1B\u001b[38;2;36;138;61m 328 +\u001b[38;2;51;51;51m  reducible from here), ~0.15\u20130.2 s is loading and tiling, and ~0.1 s is the warm-up"]
[867.689, " forward,                     \r\u001b[1B\u001b[38;2;36;138;61m 329 +\u001b[38;2;51;51;51m  which loads the cached kernels.                                                                                 \r\u001b[1B\u001b[49m\u001b[2m 330 \u001b[22m - **Numba on-disk cache** (`cache=True`) writes compiled code to `__pycache__/` beside `run.py`.\r\u001b[1B\u001b[2m 331 \u001b[22m   Without it (e.g. a read-only dir with no fallback), the first start compiles for a few seconds.\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 332 \u001b[22m   Before `READY`, a single warm-up forward runs and the KV cache is reset afterwards.\u001b[39m\u001b[40;1H\u001b[36;2H"]
