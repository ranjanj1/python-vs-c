[44.653, "3Gse\u001b[6Gsion to find where the\u001b[29Gr\u001b[31Gmaining time goes, including the parts outside the forward pass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mProfiling\u001b[13Gfresh-process\u001b[27Gstartup\u001b[35Gphases\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ uptime; cat > scratch/startup_profile.py <<'EOF'\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m\"\"\"Fresh-process st\u001b[26Grtup breakdown of run.py up to READY (same steps as run.main).\"\"\"\r\u001b[5C\u001b[1Bimpo\u001b[11Gt time; T0 = \u001b[25Gime.\u001b[30Gerf_counter()\u001b[39m\u001b[K\r\u001b[12C\u001b[1B\u001b[38;2;102;102;102mos, sys\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mROOT =\u001b[15G.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, ROOT); os.chdir(ROOT)\r\u001b[5C\u001b[1B\u2026 (3s \u00b7 13 lines)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
