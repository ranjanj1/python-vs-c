[229.099, "kv_dim,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m m.k_off, m.v_off, m.hidden_dim,\u001b[36Gm.h3_off)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gm.logits.copy()\r\u001b[1B \u001b[2m\u2502\u001b[22m else:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  def go():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mm.reset()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for p, t in\u001b[24Genumerate(seq):\u001b[40Gm.forward(t,\u001b[53Gp)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gm.logits.copy()\r\u001b[1B \u001b[2m\u2502\u001b[22m \u001b[5Gut = go()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m np.save(f'/tmp/p4_flat_{mode}.npy', out)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ts = []\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8G_\u001b[10Gin\u001b[13Grange(6):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     t = time.perf_counter();\u001b[33Ggo();\u001b[39Gts.append((time.perf_counter()\u001b[70G-\u001b[72Gt)\u001b[75G/\u001b[77Glen(seq))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(f'{mode:5s}\u001b[22Gmedian\u001b[29G{statistics.median(ts)*1e3:.3f}\u001b[61Gms/token\u001b[71Gmin\u001b[75G{min(ts)*1e3:.3f}')\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for i\u001b[10Gin 1\u001b[15G2 3; do\u001b[23Gpython3 scratch/bench_flat2.py sep; python3 scratch/bench_flat2.py flat; done\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p\u001b[6Gthon3 -c \"import numpy as"]
