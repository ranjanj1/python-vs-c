[323.202, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcheckpoint's\u001b[20Gpages\u001b[26Gsometimes\u001b[36Gfall\u001b[41Gout\u001b[45Gof\u001b[48Gthe\u001b[52GOS\u001b[55Gfile\u001b[60Gcache,\u001b[67Gtaking\u001b[74Gup\u001b[77Gto\u001b[80G952\u001b[84Gms\u001b[87Gon\u001b[90Gthe\u001b[94Gfirst\u001b[100Gtouch,\u001b[107Gand\u001b[111Gthe\u001b[115Grest\r\u001b[1B \u001b[3Gof weight loading takes \u001b[28Gnly 130\u2013200 ms. Next I'll look at t\u001b[65G per-command \u001b[79Gverhead\u001b[88Gutside the forward\u001b[107Gpass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNon-forward-pass\u001b[20Goverheads\u001b[30Gare\u001b[34Gall\u001b[38Gsmall\u001b[44G(dispatch,\u001b[55Gargmax,\u001b[63GKV\u001b[66Greset,\u001b[73Gand\u001b[77Gthe\u001b[81GLOGITS\u001b[88Gwrite),\u001b[96Gand\u001b[100Gthe\u001b[104Gkernels\u001b[112Gare\r\u001b[1B \u001b[3Galready \u001b[12Gt the hardwar\u001b[26G limit.\u001b[34GNext I'\u001b[44Gtest putting all weights into one buffer in\u001b[88Gforward-pass order, since the\r\u001b[2C\u001b[1Bfour sep\u001b[12Gra\u001b[15Ge arrays make each\u001b[34Glayer jump be\u001b[48Gween memory streams.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[3"]
[323.203, "8;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gstrided\u001b[15Gviews\u001b[21Gweren't\u001b[29GC-contiguous,\u001b[43Gso\u001b[46GNumba\u001b[52Gfell\u001b[57Gback\u001b[62Gto\u001b[65Ga\u001b[67Gnon-vectorizing\u001b[83Gversion,\u001b[92Gand\u001b[96Gthe\u001b[100Gmachine\u001b[108Gis\u001b[111Gmore\r\u001b[1B \u001b[3Gloaded now,\u001b[15Gso that comparison is invalid.\u001b[46GI'\u001b[49G redoing it with contiguous per-lay\u001b[86G views from one flat buffer, each\r\u001b[3C\u001b[1Bayout\u001b[10Gmeasured in its own proce\u001b[36Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle-buffer\u001b[21Glayout\u001b[28Gcame\u001b[33Gin\u001b[36Gwithin\u001b[43Gnoise,\u001b[50Gso\u001b[53GI'm\u001b[57Gdropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b[111Gsharing\r\u001b[1B \u001b[3Gt\u001b[7Gembedding w\u001b[19Gights, resetting\u001b[36Gonly the KV po\u001b[51Gitions the last command use\u001b[79G, and w\u001b[87Giting \u001b[94Gogits directly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mApplying\u001b[12Gsmall\u001b[18Gchanges\u001b[26Gand\u001b[30Gverifying\u001b[40Gbitwise\u001b[48Gequality\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ python3 - <<"]
[323.203, "'EOF'\u001b[26G\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102ms\u001b[8G= ope\u001b[14G('run.py').read()\r\u001b[5C\u001b[1Bdef\u001b[10Grep(a, b, n=1\u001b[24G:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mglobal s\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102massert\u001b[14G.count(a) == n, (a, s.count(a)); s = s.replace(a, b)\r\u001b[5C\u001b[1B# 1) embeddi\u001b[19Gg lookup from a tiled \u001b[42Gn_tiles,\u001b[51Gdim, T) table\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mrep('''@njit(cache=True, boundscheck=Fals\u001b[48G)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102md\u001b[8Gf forward(token, pos, emb, ''', '''@njit(cache=True, bound\u2026 (3s)\r\u001b[5C\u001b[1B(ctrl+b to run i\u001b[23G background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
