[436.924, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle-buffer\u001b[21Glayout\u001b[28Gcame\u001b[33Gin\u001b[36Gwithin\u001b[43Gnoise,\u001b[50Gso\u001b[53GI'm\u001b[57Gdropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b[111Gsharing\r\u001b[2C\u001b[1Bthe embedding weights,\u001b[26Gresetting\u001b[36Gonly\u001b[41Gthe\u001b[45GKV\u001b[48Gpositions\u001b[58Gthe\u001b[62Glast\u001b[67Gcommand\u001b[75Gused,\u001b[81Gand\u001b[85Gwriting\u001b[93Glogits\u001b[100Gdirectly.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExisting\u001b[12Gtests\u001b[18Gstill\u001b[24Gpass\u001b[29Gwith\u001b[34Gbitwise-identical\u001b[52Goutput,\u001b[60Gbut\u001b[64Gthe\u001b[68Gpartial\u001b[76Greset\u001b[82Gneeds\u001b[88Gits\u001b[92Gown\u001b[96Gtest:\u001b[102Gafter\u001b[108Ga\u001b[110Glong\r\u001b[2C\u001b[1Bcommand then a short one, the cache must be all zeros and\u001b[61Gmatch\u001b[67Ga\u001b[69Gfresh\u001b[75Gprocess.\u001b[84GI'm\u001b[88Gwriting\u001b[96Gthat\u001b[101Gtest\u001b[106Gnext.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpartial\u001b[15Gres"]
[436.925, "et\u001b[21Gis\u001b[24Gcorrect,\u001b[33Gand\u001b[37Gthe\u001b[41Gonly\u001b[46Gremaining\u001b[56Gnon-matvec\u001b[67Gcost\u001b[72Gis\u001b[75Gattention\u001b[85Gand\u001b[89Gkey\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[2C\u001b[1Btoken. I'm prototyping\u001b[26Ga\u001b[28Gblocked\u001b[36Gkey\u001b[40Glayout\u001b[47Gthat\u001b[52Gkeeps\u001b[58Gpositions\u001b[68Gcontiguous,\u001b[80Gwith\u001b[85Gthe\u001b[89Gbenchmark\u001b[99Gflushing\u001b[108Gcaches\r\u001b[2C\u001b[1Bbetween\u001b[11Gcalls.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSingle\u001b[10Gsamples\u001b[18Gare\u001b[22Gtoo\u001b[26Gnoisy\u001b[32Gto\u001b[35Gjudge.\u001b[42GI'll\u001b[47Grepeat\u001b[54Geach\u001b[59Gmeasurement\u001b[71G9\u001b[73Gtimes\u001b[79Gwith\u001b[84Ga\u001b[86Gcache\u001b[92Gflush\u001b[98Gbefore\u001b[105Geach\u001b[110Gand\u001b[114Gtake\r\u001b[2C\u001b[1Bmedians:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked\u001b[11Gkeys\u001b[16Gare\u001b[20Gfaster\u001b[27Gup\u001b[30Gto\u001b[33G~300\u001b[38Gpositions\u001b[48G(1.11\u20131.53\u00d7)\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[2C\u001b[1Bpositions. Try"]
