[887.908, "\u001b[H\u001b[3G- \u001b[1mOverhead outside the forward pass\u001b[22m is small:\u001b[49GPyt\u001b[53Gon\u2192Numba call 1 \u00b5\u001b[71G, argmax 40\u001b[83G\u00b5s\u001b[86Gper\u001b[90Gtoken,\u001b[97GKV-cache\u001b[106Greset\u001b[112G1.3\u001b[116Gms\r\u001b[2C\u001b[1B \u001b[5Gper command, LOGITS file write\u001b[36G10 ms per command.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mStartup\u001b[22m is\u001b[16Gmostly \u001b[38;2;87;105;247mimport numba\u001b[39m (0.6\u20130.85 s). Separately, the\u001b[66GOS sometimes evicts\u001b[86Gthe\u001b[90Gmodel\u001b[96Gfile\u001b[101Gfrom\u001b[106Gits\u001b[110Gfile\u001b[115Gcache\r\u001b[2C\u001b[1B \u001b[5Gunder memory pressure, which adds\u001b[39G~1\u001b[43G to loading. A sm\u001b[61Gller memory\u001b[73Gfootprint\u001b[83Gi\u001b[86Gthe\u001b[90Gonly lever there.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKey cache:\u001b[22m each new\u001b[25Gkey was written as 64 values 4\u001b[56GKB\u001b[59Gapart.\u001b[66GStoring\u001b[74Gkeys\u001b[79Gin\u001b[82Gblocks\u001b[89Gof\u001b[92G64\u001b[95Gpositions\u001b[105Gmade\u001b[110Gkey\u001b[114Gstorage\r\u001b[2C\u001b[1B \u001b[5Gplus attenti\u001b[18Gn 1.17\u00d7 faster at\u001b[36G4\u001b[38G positions,\u001b[50G1.21\u00d7 at 80\u001b[62Gand\u001b[66G1.59\u00d7 a\u001b[74G 300, and no slower at\u00a01000.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m (all\u001b[16Gbitwis\u001b[23G id\u001b[27Gntical):\u001b[K\r\u001b[2C\u001b[1B1."]
[887.91, " The\u001b[10Gblocked key-cache layout.\u001b[36G\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GNo\u001b[9Gseparate\u001b[18G98\u001b[21GMB\u001b[24Gembedding\u001b[34Gcopy:\u001b[40Gtoken\u001b[46Glookups\u001b[54Gread\u001b[59Gthe\u001b[63Gtiled\u001b[69Gclassifier\u001b[80Ginstead.\r\u001b[2C\u001b[1B3. The reset\u001b[16Gclear\u001b[22G only \u001b[29Ghe positions\u001b[42Gthe\u001b[46Gprevious\u001b[55Gcommand\u001b[63Gused.\u001b[69GThe\u001b[73Gcache\u001b[79Gis\u001b[82Gstill\u001b[88Gall-zero\u001b[97Gat\u001b[100Gthe\u001b[104Gstart\u001b[110Gof\u001b[113Gevery\r\u001b[2C\u001b[1B  \u001b[6Gcommand.\u001b[K\r\u001b[2C\u001b[1B4\u001b[6GLOGITS writes its\u001b[24Garray dire\u001b[35Gtl\u001b[38G,\u001b[40Gwithout an ext\u001b[55Ga copy.\u001b[63G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mMeasured against the previous version\u001b[41G\u001b[22m(rebuilt\u001b[50Gby\u001b[53Greverting\u001b[63Gthis\u001b[68Gpass's\u001b[75Gedits;\u001b[82Git\u001b[85Greproduces\u001b[96Gthat\u001b[101Gversion's\u001b[111Glogits\r\u001b[2C\u001b[1Bexactly):\u001b[13G\u001b[K\r\u001b[2C\u001b[2B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[K\r\u001b[2C\u001b[1B\u2502        \u001b[32G\u2502\u001b[36GPrevious\u001b[48G\u2502\u001b[53GCurrent\u001b[64G\u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[887.911, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Forward pass, ms per token \u2502 8.29          \u2502 8.25 (noise)  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Whole dev session          \u2502 4.70 / 5.39 s \u2502 4.70 / 4.93 s \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 FIXED 1024 positions       \u2502 10.4 s        \u2502 9.95 s        \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 Peak memory                "]
