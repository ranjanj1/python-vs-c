[450.052, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSingle samples\u001b[18Gare \u001b[23Go\u001b[25G noisy to judge. I'll\u001b[47Grepeat each measurement 9 times with\u001b[84Ga cache flush before each and\u001b[114Gtake\r\u001b[2C\u001b[1Bmedians:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked keys are faster up to ~300 positions (1.11\u20131.53\u00d7) and bitwise identical, but a\u001b[90Gout 5% slower at 1000\u001b[K\r\u001b[2C\u001b[1Bpositions. Trying\u001b[21Glarger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[2C\u001b[4BBlock size 64 wins\u001b[22Gat every context length test\u001b[51Gd,\u001b[54Gup to 1.59\u00d7 fas\u001b[70Ger\u001b[73Gat 300 positions, so I'm\u001b[98Gadopting it. Attention\r\u001b[2C\u001b[1Btakes about\u001b[15Ghalf\u001b[20Gof\u001b[23Geach\u001b[28Gtoken's\u001b[36Gtime\u001b[41Gat\u001b[44Gposition\u001b[53G1000,\u001b[59Gbut\u001b[63Gdev\u001b[67Gworkloads\u001b[77Gstay\u001b[82Gunder\u001b[88G83\u001b[91Gpositions,\u001b[102Gso\u001b[105GI'll\u001b[110Gcheck\u001b[116Gwhat\r\u001b[2C\u001b[1Bdominates\u001b[13Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mS\u001b[5Gftmax i"]
[450.053, "s\u001b[14Groughly 11% of attenti\u001b[37Gn\u001b[39Gcost at 1000 positions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[2C\u001b[1Blong-context\u001b[16Gcosts\u001b[22Gas\u001b[25Ga\u001b[27Glimitation,\u001b[39Gstarting\u001b[48Gin\u001b[51G\u001b[38;2;87;105;247mrun.py\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ grep -n \"kc\\[hk, i, pos\\]\\|def attention\\|kh = kc\\[hk\\]\\|key_cache = np.zeros\\|key_cache\\[:, :, :, \u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102m:u\\]\\|^TILE\\|kc: (n_kv_heads\\|key_cache: (layer\" run.py; sed -n '/^def attention/,/^@njit/p' run.py | head -40\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[450.054, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mLocate key-cache code in run.py\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mgrep\u001b[9G-n\u001b[12G\"kc\\[hk,\u001b[21Gi,\u001b[24Gpos\\]\\|def\u001b[35Gattention\\|kh\u001b[49G=\u001b[51Gkc\\[hk\\]\\|key_cache\u001b[71G=\u001b[73Gnp.zeros\\|key_cache\\[:,\u001b[97G:,\u001b[100G:,\u001b[103G:u\\]\\|^TILE\\|kc:\r\u001b[1B \u001b[2m\u2502\u001b[22m (\u001b[6G_kv_heads\\|key_cache:\u001b[28G(layer\"\u001b[36Grun.py;\u001b[44Gsed\u001b[48G-n\u001b[51G'/^def\u001b[58Gattention/,/^@njit/p'\u001b[80Grun.py\u001b[87G|\u001b[89Ghead\u001b[94G-40\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[450.055, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Galways\u001b[23Gallow\u001b[29Gaccess\u001b[36Gto\u001b[39G\u001b[1m/Users/agentlab/pvc/p4\u001b[62G\u001b[22mfrom\u001b[67Gthis\u001b[72Gproject\u001b[103G\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
