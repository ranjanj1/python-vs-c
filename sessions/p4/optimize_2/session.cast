[712.109, "\u001b[H\u001b[3G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll ch\u001b[10Gcks\u001b[14Gpass,\u001b[20Gand\u001b[24GI'm\u001b[28Grebuilding\u001b[39Gthe\u001b[43Gprevious\u001b[52Gpass's\u001b[59Gversion\u001b[67Gby\u001b[70Greverting\u001b[80Gthis\u001b[85Gpass's\u001b[92Gedits\u001b[98Gso\u001b[101GI\u001b[103Gcan\u001b[107Grun\u001b[111Ga\u001b[113Gfair\u001b[118GA/B\r\u001b[2C\u001b[1Band\u001b[7Gconfirm\u001b[15Git\u001b[18Gmatches\u001b[26Gbitwise.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn\u001b[6Gthe dev path the speedup\u001b[31Gis\u001b[34Gwithin\u001b[41Gnoise\u001b[47G(1.004\u00d7),\u001b[57Gas\u001b[60Gexpected\u001b[69Gat\u001b[72Gthese\u001b[78Gshort\u001b[84Gpositions,\u001b[95Gso\u001b[98GI'm\u001b[102Gmeasuring\u001b[112Gboth\r\u001b[2C\u001b[1Bversions end-to-end at\u001b[26Glonger\u001b[33Gcontexts\u001b[42Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The long-context\u001b[20GFIXED\u001b[26Gruns\u001b[31Gare\u001b[35Gabout\u001b[41G5%\u001b[44Gfaster\u001b[51Gon\u001b[54Gboth\u001b[59Grounds\u001b[66G(300\u001b[71Gtokens:\u001b[79G2.60\u001b[84G\u2192\u001b[86G2.47\u001b[91Gs;\u001b[94G1024\u001b[99Gtokens:\u001b[107G10.40\u001b[113G\u2192\u001b[115G9.95\r\u001b[1C\u001b[1B s). I'm checking that the long-context FIXED a"]
[712.11, "nswers are fully identical, then profiling\u001b[92Gthe\u001b[96Gend-to-end\u001b[107Gdev\u001b[111Gworkload\r\u001b[1C\u001b[1B for both versions.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The long-context \u001b[21Gnswers\u001b[28Gmatch,\u001b[35Gand\u001b[39Gend-to-end\u001b[50Gdev\u001b[54Gtimings\u001b[62Gare\u001b[66Gwithin\u001b[73Gnoise\u001b[79Gbetween\u001b[87Gthe\u001b[91Gtwo\u001b[95Gversions.\u001b[105GI'm\u001b[109Gchecking\u001b[118Gthe\r\u001b[1C\u001b[1B me\u001b[6Gory saving next.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Peak\u001b[8Gmemory dropped from 705 MB to 534 MB (\u221224%), mainly\u001b[60Gfrom\u001b[65Gremoving\u001b[74Gthe\u001b[78G98\u001b[81GMB\u001b[84Gembedding\u001b[94Gcopy\u001b[99Gand\u001b[103Glimiting\u001b[112Gthe\r\u001b[1C\u001b[1B partial reset \u001b[18Go th\u001b[23G touched part of the\u001b[44GKV cache. Final validation,\u001b[72Gthe prec\u001b[81Gsion re-check, and the saved profile\r\u001b[1C\u001b[1B come next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Final checks and precision inspection\u001b[41G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python"]
