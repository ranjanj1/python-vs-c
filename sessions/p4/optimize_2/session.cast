[830.162, "\u001b[H \u001b[3Gs).\u001b[7GI'm checking\u001b[20Gthat the long-context FIXED answers are f\u001b[62Glly\u001b[66Gidentical, then profiling the end-to-end\u001b[107Gdev workload\r\u001b[2C\u001b[1Bfor\u001b[7Gboth v\u001b[14Grs\u001b[17Gons.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Glong-context\u001b[20Ganswers\u001b[28Gmatch,\u001b[35Gand\u001b[39Gend-to-end\u001b[50Gdev\u001b[54Gtimings\u001b[62Gare\u001b[66Gwithin\u001b[73Gnoise\u001b[79Gbetween\u001b[87Gthe\u001b[91Gtwo\u001b[95Gversions.\u001b[105GI'm\u001b[109Gchecking\u001b[118Gthe\r\u001b[1B \u001b[3Gmemory savi\u001b[15Gg next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPeak\u001b[8Gmemory\u001b[15Gdropped\u001b[23Gfrom\u001b[28G705\u001b[32GMB\u001b[35Gto\u001b[38G534\u001b[42GMB\u001b[45G(\u221224%),\u001b[53Gmainly\u001b[60Gfrom\u001b[65Gremoving\u001b[74Gthe\u001b[78G98\u001b[81GMB\u001b[84Gembedding\u001b[94Gcopy\u001b[99Gand\u001b[103Glimiting\u001b[112Gthe\r\u001b[1B \u001b[3Gpartial reset to the t\u001b[26Guched\u001b[32Gpar\u001b[36G of the KV cache. F\u001b[57Gal\u001b[60Gvalidati\u001b[69Gn, the precision r\u001b[88G-check, and the saved profile\r\u001b[2C\u001b[1Bcome next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b["]
[830.163, "2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mValidation\u001b[14Gpassed,\u001b[22Gand\u001b[26Gthe\u001b[30GGB/s\u001b[35Gdrop\u001b[40Gto\u001b[43G54\u001b[46Glooks\u001b[52Glike\u001b[57Gmachine\u001b[65Gstate\u001b[71Grather\u001b[78Gthan\u001b[83Ga\u001b[85Gregression,\u001b[97Gsince\u001b[103Gthe\u001b[107Gforward\u001b[115Gtime\r\u001b[1B \u001b[3Gm\u001b[5Gtches the A/B at\u001b[22G8.25 ms. I'm\u001b[35Gupdating NOTES.md next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gscript\u001b[14Gstopped\u001b[22Gat\u001b[25Gits\u001b[29Gsecond\u001b[36Greplacement\u001b[48Gbefore\u001b[55Gwriting\u001b[63Ganything,\u001b[73Gso\u001b[76GNOTES.md\u001b[85Gis\u001b[88Gunchanged.\u001b[99GThe\u001b[103Gwording\u001b[111GI\u001b[113Gmatched\r\u001b[1B \u001b[3Gagainst differs from the file. Reading th\u001b[45G fil\u001b[50G's cur\u001b[57Gent text:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfile's\u001b[14Gwording\u001b[22Gdiffers\u001b[30Gfrom\u001b[35Gwhat\u001b[40GI\u001b[42Goriginally\u001b[53Gwrote,\u001b[60Gso\u001b[63Gother\u001b[69Ganchors\u001b[77Gmay\u001b[81Gnot\u001b[85Gmatch\u001b[91Gei"]
