[862.378, "\u001b[H\u001b[8G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m22\u001b[14G\u001b[38;2;51;51;51mthree\u001b[20Gdev\u001b[24Gsequences.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m23\u001b[12G\u001b[38;2;51;51;51m- `scratch/longctx.py`: FIXED 300\u001b[46Gand\u001b[50GFIXED\u001b[56G1024\u001b[61Ganswers\u001b[69Gidentical\u001b[79G(SHA-1)\u001b[87Gbetween\u001b[95Gthe\u001b[99Gprevious\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m24\u001b[14G\u001b[38;2;51;51;51mand\u001b[18Gcurrent\u001b[26Gversions.\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[15G\u001b[38;2;51;51;51mscratch/test_synthetic.py`: padding, GQA (1 and 4 kv\u001b[68Gheads), un\u001b[79Gh\u001b[81Gred classifier/embedding,\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[12G\u001b[38;2;51;51;51m \u001b[14Gsequen\u001b[21Ge lengths\u001b[31G40 and 33 (partial\u001b[50Gkey blocks) \u2014 all bitwise identical \u001b[87Go the first version. \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G`scratch/test_res\u001b[32Gt\u001b[34Gpy`:\u001b[39Gafter\u001b[45Ga\u001b[47G161-position\u001b[60Gcommand\u001b[68Gand\u001b[72Ga\u001b[74Greset,\u001b[81Gthe\u001b[85Gcache\u001b[91Gis\u001b[94Gall-zero,\u001b[104Gand\u001b[108Ga\r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[12G\u001b[38;2;51;51;51m \u001b[14G20-position sequence gives bitwise the same logit\u001b[64G as on a fresh\u001b[79Gmodel. \u001b[87G     "]
[862.379, "  \u001b[95G   \u001b[99G        \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[12G\u001b[38;2;51;51;51m-\u001b[14G`scratch/edge.py`: unchanged\u001b[43Gbehaviour,\u001b[54Gincluding\u001b[64Gthe\u001b[68G`context`\u001b[78Gstop\u001b[83Gat\u001b[86Gseq_len.\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m30\u001b[28G\u001b[38;2;51;51;51mtiling.py`, plus IR/type inspection of ev\u001b[70Gry kernel including `embed`: no float64,\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m31\u001b[14G\u001b[38;2;51;51;51mno double ari\u001b[29Gmetic, no fast-math flags.      \u001b[62G \u001b[64G   \u001b[68G       \u001b[76G         \u001b[86G  \u001b[89G   \u001b[93G     \u001b[99G        \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m32\u001b[12G\u001b[38;2;51;51;51m \u001b[14G                        \u001b[39G     \u001b[45G \u001b[47G            \u001b[60G       \u001b[68G   \u001b[72G \u001b[74G      \u001b[81G   \u001b[85G     \u001b[91G  \u001b[94G         \u001b[104G   \u001b[108G \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m33\u001b[12G\u001b[38;2;51;51;51m## Considered\u001b[26Gand not done: mul\u001b[44Gi-position prefill  \u001b[65G  \u001b[68G  \u001b[71G \u001b[73G     \u001b[79G      \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m34\u001b[12G\u001b[38;2;51;51;51m \u001b[14G                  \u001b[33G         \u001b[43G          \u001b[54G         \u001b[64G   \u001b[68G         \u001b[78G    \u001b[83G  \u001b[86G        \r\u001b[8C\u001b"]
