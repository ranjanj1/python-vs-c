[752.322, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gchecks\u001b[14Gpass,\u001b[20Gand\u001b[24GI'm\u001b[28Grebuilding\u001b[39Gthe\u001b[43Gprevious\u001b[52Gpass's\u001b[59Gversion\u001b[67Gby\u001b[70Greverting\u001b[80Gthis\u001b[85Gpass's\u001b[92Gedits\u001b[98Gso\u001b[101GI\u001b[103Gcan\u001b[107Grun\u001b[111Ga\u001b[113Gfair\u001b[118GA/B\r\u001b[1B \u001b[3Gand\u001b[8Gonfirm it matches bitwise.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn\u001b[6Gthe\u001b[10Gdev\u001b[14Gpath\u001b[19Gthe\u001b[23Gspeedup\u001b[31Gis\u001b[34Gwithin\u001b[41Gnoise\u001b[47G(1.004\u00d7),\u001b[57Gas\u001b[60Gexpected\u001b[69Gat\u001b[72Gthese\u001b[78Gshort\u001b[84Gpositions,\u001b[95Gso\u001b[98GI'm\u001b[102Gmeasuring\u001b[112Gboth\r\u001b[1B \u001b[3Gversions end-\u001b[17Go-end\u001b[23Gat longer con\u001b[37Gexts next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Glong-context\u001b[20GFIXED\u001b[26Gruns\u001b[31Gare\u001b[35Gabout\u001b[41G5%\u001b[44Gfaster\u001b[51Gon\u001b[54Gboth\u001b[59Grounds\u001b[66G(300\u001b[71Gtokens:\u001b[79G2.60\u001b[84G\u2192\u001b[86G2.47\u001b[91Gs;\u001b[94G1024\u001b[99Gto"]
[752.323, "kens:\u001b[107G10.40\u001b[113G\u2192\u001b[115G9.95\r\u001b[1B \u001b[3Gs).\u001b[7GI'm checking\u001b[20Gthat the long-context FIXED answers are f\u001b[62Glly\u001b[66Gidentical, then profiling the end-to-end\u001b[107Gdev workload\r\u001b[2C\u001b[1Bfor\u001b[7Gboth v\u001b[14Grs\u001b[17Gons.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Glong-context\u001b[20Ganswers\u001b[28Gmatch,\u001b[35Gand\u001b[39Gend-to-end\u001b[50Gdev\u001b[54Gtimings\u001b[62Gare\u001b[66Gwithin\u001b[73Gnoise\u001b[79Gbetween\u001b[87Gthe\u001b[91Gtwo\u001b[95Gversions.\u001b[105GI'm\u001b[109Gchecking\u001b[118Gthe\r\u001b[1B \u001b[3Gmemory savi\u001b[15Gg next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPeak\u001b[8Gmemory\u001b[15Gdropped\u001b[23Gfrom\u001b[28G705\u001b[32GMB\u001b[35Gto\u001b[38G534\u001b[42GMB\u001b[45G(\u221224%),\u001b[53Gmainly\u001b[60Gfrom\u001b[65Gremoving\u001b[74Gthe\u001b[78G98\u001b[81GMB\u001b[84Gembedding\u001b[94Gcopy\u001b[99Gand\u001b[103Glimiting\u001b[112Gthe\r\u001b[1B \u001b[3Gpartial reset to the t\u001b[26Guched\u001b[32Gpar\u001b[36G of the KV cache. F\u001b[57Gal\u001b[60Gvalidati\u001b[69Gn, the precision r\u001b[88G-check, and the saved profile"]
