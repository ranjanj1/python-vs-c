[4.067, "\u001b[H\r\u001b[4C\u001b[1BGENERATE 64 tokens/s\u001b[26G     \u001b[40G68\u201390   \u001b[51G94\u2013114 \r\u001b[4C\u001b[2BFull check-equivalent\u001b[27Gsession\u001b[40G7.5 s\u001b[51G5.4 s \r\u001b[4C\u001b[2BStartup to \u001b[38;2;87;105;247mREADY\u001b[39m     \u001b[27G       \u001b[40G1\u001b[42G7\u001b[51G1\u001b[54G5 s\r\u001b[4C\u001b[2B~1024-\u001b[12Gosition long-context\u001b[33Gtest\u001b[41G5.8 s\u001b[52G0.8\r\u001b[2C\u001b[1B\u2514\u001b[38G\u2534\u001b[49G\u2534\u001b[59G\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests beyond \u001b[38;2;87;105;247mcheck.py\u001b[39m:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mOld vs new forward pass:\u001b[30G\u001b[22mbitwise\u001b[38Gidentical\u001b[48Gon\u001b[51Gall\u001b[55Gthree\u001b[61Gdev\u001b[65Gsequences.\r\u001b[2C\u001b[1B- \u001b[1mSynth\u001b[11Gtic checkpoints:\u001b[28G\u001b[22mcover\u001b[34Gcases\u001b[40Gthe\u001b[44Gsupplied\u001b[53Gmodel\u001b[59Gnever\u001b[65Ghits\u001b[70G(dimensions\u001b[82Gthat\u001b[87Gneed\u001b[92Gpadding\u001b[100Gto\u001b[103Gwhole\u001b[109Gtiles,\u001b[116Gfewer\r\u001b[2C\u001b[1B \u001b[5Gkey/value heads than query heads, unshared\u001b[48Gclassifie\u001b[58G weight\u001b[66G, ru\u001b[71Gning\u001b[76Gto\u001b[79G\u001b[38;2;87;105;247mseq_len\u001b[39m).\u001b[89GThey\u001b[94Gare\u001b[98Gbitwise\u001b[106Gidentical\u001b[116Gto\r\u001b[2C\u001b[1B \u001b[5Gthe old version at every position.\u001b[40G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTiled matrix multiply:\u001b"]
