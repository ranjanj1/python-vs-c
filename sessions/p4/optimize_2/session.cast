[381.635, "\u001b[H \u001b[2m\u2502\u001b[22m rng = np.ra\u001b[16Gdom.default_rng(0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m kc_c = np.zeros((L, KV, hs,\u001b[32GS), F32); kc_b =\u001b[49Gnp.zer\u001b[56Gs((L,\u001b[62GKV,\u001b[66GS // B, hs,\u001b[78GB), F32); vc = np.z\u001b[98Gros((L, S, KV *\u001b[114Ghs),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mF32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m vc2 = vc.copy()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22matt1\u001b[9G=\u001b[11Gnp.zeros((H,\u001b[24GS),\u001b[28GF32);\u001b[34Gatt2\u001b[39G=\u001b[41Gnp.zeros((H,\u001b[54GS),\u001b[58GF32);\u001b[64Gxb1\u001b[68G=\u001b[70Gnp.zeros(H\u001b[81G*\u001b[83Ghs,\u001b[87GF32);\u001b[93Gxb2\u001b[97G=\u001b[99Gnp.zeros(H\u001b[110G*\u001b[112Ghs,\u001b[116GF32)\r\u001b[1B \u001b[2m\u2502\u001b[22m big = np.ones(40_000_000,\u001b[30GF32)  #\u001b[38G160 MB to evi\u001b[52Gt L2 between tokens\u001b[73Glike the weight str\u001b[93Gam\u001b[96Gdoes\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m Ks = rng.s\u001b[15Gandard_no\u001b[25Gma\u001b[28G((S, L, KV\u001b[39G* hs)).astype(F32); Vs = rng.standard_normal((S,\u001b[88GL, KV * hs)).astype(F32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m Q =\u001b[8Grng.stand\u001b[19Gd_nor\u001b[26Gl((S, L, H * hs)).astyp\u001b[50G(F32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mres\u001b[8G=\u001b[10G{'current':\u001b[22G{},\u001b[26G'blocked':\u001b[37G{}}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ok = True\u001b[K\r\u001b[1C\u001b[1"]
