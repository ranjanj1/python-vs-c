[862.402, "on3 \u001b[23Gstartup_profile.py \u001b[43G         #\u001b[54Gx3: fresh-process startup bre\u001b[84Gkdown     \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 287 +\u001b[38;2;51;51;51mpython3 \u001b[23Gload\u001b[28Gparts.py   \u001b[40G    \u001b[45G       # x3: file-page \u001b[69Gs anonymous-page faults vs copy \u001b[102G        \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 288 +\u001b[38;2;51;51;51mpython3 scratch/overhead.py \u001b[36G  \u001b[39G         \u001b[49G   # dispatch,\u001b[64Gargmax,\u001b[72Greset,\u001b[79GLOGITS\u001b[86Gwrite\u001b[92Gcosts\u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 289 +\u001b[38;2;51;51;51mpython3\u001b[15Gscratch/bench_flat.py;\u001b[38Gfor\u001b[42Gi\u001b[44Gin\u001b[47G1\u001b[49G2\u001b[51G3;\u001b[54Gdo\u001b[57Gpython3\u001b[65Gscratch/bench_flat2.py\u001b[88Gsep;\u001b[93Gpython3\u001b[101Gscratch/bench_flat2.\r\u001b[1B\u001b[38;2;36;138;61m     +\u001b[38;2;51;51;51mpy flat; done     \u001b[26G   \u001b[30G   \u001b[34G     \u001b[40G              \u001b[55G       \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 290 +\u001b[38;2;51;51;51mpython3\u001b[15Gscratch/bench_kv.py\u001b[35G[32|64|128]\u001b[52G#\u001b[54Gblocked\u001b[62Gkey-cache\u001b[72Glayouts,\u001b[81Gbitwise\u001b[89G+\u001b[91Gtiming\u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 291 +\u001b[38;2;51;51;"]
[862.403, "51mpython3 scratch/bench_attn_parts.\u001b[41Gy  \u001b[45G   \u001b[49G   # softm\u001b[60Gx share at long context      \u001b[90G \u001b[92G         \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 292 +\u001b[38;2;51;51;51mpython3 check.py --\u001b[27Gokens 64 --prompts 3 --\u001b[51Gpython3 run.py  \u001b[68G     \u001b[74G     \u001b[80G  \u001b[83G             \u001b[97G       \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 293 +\u001b[38;2;51;51;51mpython3 scratch/\u001b[24Gest_synthetic.py; python3\u001b[50Gscratch/test_reset.py; python3 scratch/te\u001b[92Gt_tiling.py\u001b[104G    \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 294 +\u001b[38;2;51;51;51mcp run.py scratch/run_v3.py      \u001b[41G   \u001b[45G      \u001b[52G# snapshot\u001b[63Gof this pass's\u001b[78Gversion \u001b[87G   \u001b[91G    \u001b[96G     \u001b[102G   \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 295 +\u001b[38;2;51;51;51mpython3 -\u001b[17G<<EOF\u001b[23G\u001b[38;2;0;134;179m...\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrevert\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mthis\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mpass\u001b[38;2;51;51;51m'\u001b[38;2;0;134;179ms\u001b[38;2;51;51;51m \u001b[38;2;0;134;179medits\u001b[38;2;51;51;51m \u001b[38;2;0;134;179m...\u001b[38;2;51;51;51m \u001b[38;2;0;"]
[862.404, "134;179mEOF\u001b[38;2;51;51;51m  \u001b[38;2;0;134;179m-\u001b[38;2;51;51;51m> scratch/run_v2.py   # previous version for A/B           \r\u001b[1B\u001b[38;2;36;138;61m 296 +\u001b[38;2;51;51;51mpython3 scratch/ab.py\u001b[29G8 run_v2; pyth\u001b[44Gn3 scratch/ab.py 6   \u001b[66G        \u001b[75G   \u001b[79G            \u001b[92G         \u001b[102G     \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 297 +\u001b[38;2;51;51;51mpython3\u001b[15Gscratch/longctx.py scratch/\u001b[43Gun_v2.py; python3 scratch/longctx.py\u001b[80Grun.py   # x3, alternating \u001b[108G  \u001b[114G       \r\u001b[1B\u001b[38;2;36;138;61m 298 +\u001b[38;2;51;51;51mPROG=scrat\u001b[18Gh/run_v2.py\u001b[30Gpython3\u001b[38Gscratch/profile.py\u001b[57Ge2e\u001b[61G3;\u001b[64Gpython3\u001b[72Gscratch/profile.py\u001b[91Ge2e\u001b[95G3\u001b[99G#\u001b[101Gx2,\u001b[105Galternating     \r\u001b[1B\u001b[38;2;36;138;61m 299 +\u001b[38;2;51;51;51mprintf\u001b[14G'QUIT\\n'\u001b[23G|\u001b[25G/usr/bin/time\u001b[39G-l\u001b[42Gpython3\u001b[50G{scratch/run_v2.py|run.py}\u001b[77Gmodel.bin\u001b[87Gtokenizer.bin\u001b[103G#\u001b[105Gpeak\u001b[110Gmemory     \r\u001b[1B\u001b[38;2;36;138;61m 300 +\u001b[38;2;51;51;51mpython3 check.py -- python3 run.py; python3 scratch/edge.py                           "]
[862.405, "                            \r\u001b[1B\u001b[38;2;36;138;61m 301 +\u001b[38;2;51;51;51mNUMBA_CACHE_DIR=$(mktemp -d) python3 - <<EOF \u001b[38;2;0;134;179m...\u001b[38;2;51;51;51m \u001b[38;2;0;134;179minspect_types\u001b[38;2;51;51;51m / \u001b[38;2;0;134;179minspect_llvm\u001b[38;2;51;51;51m \u001b[38;2;0;134;179m...\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mEOF\u001b[38;2;51;51;51m                             \r\u001b[1B\u001b[38;2;36;138;61m 302 +\u001b[38;2;51;51;51mpython3 scratch/profile.py phases 4; python3 scratch/profile.py e2e 3   # -> scratch/profile_pass3.txt            \r\u001b[1B\u001b[38;2;36;138;61m 303 +\u001b[38;2;51;51;51m```                                                                                                               \r\u001b[1B\u001b[49m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 305 +\u001b[38;2;51;51;51m`scratch/` holds only benchmark/test helpers, the saved profiles, and earlier versions for A/B:                   \r\u001b[1B\u001b[38;2;36;138;61m 306 +\u001b[38;2;51;51;51m`run_v1.py` (first version), `run_v2.py` (after the first performance pass) and `run_v3.py`            "]
