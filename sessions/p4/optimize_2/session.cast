[384.789, "\u001b[H \u001b[3Galready \u001b[12Gt the hardwar\u001b[26G limit.\u001b[34GNext I'\u001b[44Gtest putting all weights into one buffer in\u001b[88Gforward-pass order, since the\r\u001b[2C\u001b[1Bfour sep\u001b[12Gra\u001b[15Ge arrays make each\u001b[34Glayer jump be\u001b[48Gween memory streams.\u001b[69G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gstrided\u001b[15Gviews\u001b[21Gweren't\u001b[29GC-contiguous,\u001b[43Gso\u001b[46GNumba\u001b[52Gfell\u001b[57Gback\u001b[62Gto\u001b[65Ga\u001b[67Gnon-vectorizing\u001b[83Gversion,\u001b[92Gand\u001b[96Gthe\u001b[100Gmachine\u001b[108Gis\u001b[111Gmore\r\u001b[1B \u001b[3Gloaded now,\u001b[15Gso that comparison is invalid.\u001b[46GI'\u001b[49G redoing it with contiguous per-lay\u001b[86G views from one flat buffer, each\r\u001b[3C\u001b[1Bayout\u001b[10Gmeasured in its own proce\u001b[36Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gsingle-buffer\u001b[21Glayout\u001b[28Gcame\u001b[33Gin\u001b[36Gwithin\u001b[43Gnoise,\u001b[50Gso\u001b[53GI'm\u001b[57Gdropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b["]
[384.79, "111Gsharing\r\u001b[1B \u001b[3Gt\u001b[7Gembedding w\u001b[19Gights, resetting\u001b[36Gonly the KV po\u001b[51Gitions the last command use\u001b[79G, and w\u001b[87Giting \u001b[94Gogits directly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExisting\u001b[12Gtests\u001b[18Gstill\u001b[24Gpass\u001b[29Gwith\u001b[34Gbitwise-identical\u001b[52Goutput,\u001b[60Gbut\u001b[64Gthe\u001b[68Gpartial\u001b[76Greset\u001b[82Gneeds\u001b[88Gits\u001b[92Gown\u001b[96Gtest:\u001b[102Gafter\u001b[108Ga\u001b[110Glong\r\u001b[1B \u001b[3Gcommand th\u001b[14Gn a\u001b[19Ghort\u001b[24Gone,\u001b[29Gthe cache must be all zeros and matc\u001b[66G a f\u001b[71Gesh p\u001b[77Goc\u001b[80Gss. I'm\u001b[88Gwriting\u001b[97Gha\u001b[100G tes\u001b[105G next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpartial\u001b[15Greset\u001b[21Gis\u001b[24Gcorrect,\u001b[33Gand\u001b[37Gthe\u001b[41Gonly\u001b[46Gremaining\u001b[56Gnon-matvec\u001b[67Gcost\u001b[72Gis\u001b[75Gattention\u001b[85Gand\u001b[89Gkey\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[1B \u001b[3Gtoken. I'm p\u001b[16Goto"]
[384.79, "\u001b[20Gyping a blocked key layout th\u001b[50Gt keeps posi\u001b[63Gions cont\u001b[73Gguous, w\u001b[82Gth\u001b[85Gthe\u001b[89Gb\u001b[91Gnchma\u001b[97Gk flushing caches\u001b[K\r\u001b[2C\u001b[1Bbetween calls.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mBenchmarking\u001b[16Gblocked\u001b[24Gkey-cache\u001b[34Glayout\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ cat > scratch/bench_kv.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m\"\"\"Key-ca\u001b[16Ghe layout: current (KV, hs, S) vs blocked (KV, S/B, hs, B). Store + attention per layer, caches cold.\"\"\"\r\u001b[5C\u001b[1Bimport os, sys, time, statistics\u001b[40Gmath\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mROOT =\u001b[15G.path.dirname(os.pa\u001b[35Gh.dirn\u001b[42Gme(os.path.abspath(__file__))); sys.path.insert(0, ROOT); os.chdir(ROOT)\r\u001b[5C\u001b[1B\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
