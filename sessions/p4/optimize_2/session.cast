[748.301, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe long-context FIXED\u001b[26Gruns\u001b[31Gare\u001b[35Gabout\u001b[41G5%\u001b[44Gfaster\u001b[51Gon\u001b[54Gboth\u001b[59Grounds\u001b[66G(300\u001b[71Gtokens:\u001b[79G2.60\u001b[84G\u2192\u001b[86G2.47\u001b[91Gs;\u001b[94G1024\u001b[99Gtokens:\u001b[107G10.40\u001b[113G\u2192\u001b[115G9.95\r\u001b[2C\u001b[1Bs).\u001b[7GI'm\u001b[11Gchecking\u001b[20Gthat\u001b[25Gthe\u001b[29Glong-context\u001b[42GFIXED\u001b[48Ganswers\u001b[56Gare\u001b[60Gfully\u001b[66Gidentical,\u001b[77Gthen\u001b[82Gprofiling\u001b[92Gthe\u001b[96Gend-to-end\u001b[107Gdev\u001b[111Gworkload\r\u001b[1B \u001b[3Gfor both \u001b[13Gersions.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Glong-context\u001b[20Ganswers\u001b[28Gmatch,\u001b[35Gand\u001b[39Gend-to-end\u001b[50Gdev\u001b[54Gtimings\u001b[62Gare\u001b[66Gwithin\u001b[73Gnoise\u001b[79Gbetween\u001b[87Gthe\u001b[91Gtwo\u001b[95Gversions.\u001b[105GI'm\u001b[109Gchecking\u001b[118Gthe\r\u001b[1B \u001b[3Gmemory savi\u001b[15Gg next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPeak memory dropped from\u001b[28G705\u001b[32GMB\u001b[35Gto\u001b[38G534\u001b"]
