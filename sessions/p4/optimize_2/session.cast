[410.014, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gstrided\u001b[15Gviews\u001b[21Gweren't\u001b[29GC-contiguous,\u001b[43Gso\u001b[46GNumba\u001b[52Gfell\u001b[57Gback\u001b[62Gto\u001b[65Ga\u001b[67Gnon-vectorizing\u001b[83Gversion,\u001b[92Gand\u001b[96Gthe\u001b[100Gmachine\u001b[108Gis\u001b[111Gmore\r\u001b[1B \u001b[3Gloaded now, so that c\u001b[25Gmparison is \u001b[38Gnvalid. I'm\u001b[50Gredoing it w\u001b[63Gth\u001b[66Gcontiguous per-layer views from on\u001b[102Gfl\u001b[105Gt buffer, each\r\u001b[2C\u001b[1Blayout measured \u001b[20Gn its\u001b[26Gown process.\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm\u001b[20Gnd \u001b[39m\u001b[K\r\u001b[2C\u001b[2BThe s\u001b[11Gle-buffer \u001b[22Gayout came in within noise, so I'm dropping it. I'm now doing three \u001b[91Gmall, safe\u001b[102Gchanges: sharing\r\u001b[2C\u001b[1Bthe embeddi\u001b[15Gg weigh\u001b[23Gs, resetting only the KV positi\u001b[55Gns the last\u001b[67Gcommand\u001b[75Gused, and writing logits directly.\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m p\u001b[20Gttern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[2B\u001b[39mExisting tests s\u001b[20Gill\u001b[24Gpass with bitwise-identic\u001b[50Gl output, bu\u001b[63G the part\u001b[73Gal rese\u001b[81G needs its own test: "]
[410.016, "after a\u001b[110Glong\u001b[K\r\u001b[2C\u001b[1Bc\u001b[5Gmmand then a short one, the cach\u001b[38G must be\u001b[47Gall zeros and match a fresh process. I'm writing that test next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpartial\u001b[15Greset\u001b[21Gis\u001b[24Gcorrect,\u001b[33Gand\u001b[37Gthe\u001b[41Gonly\u001b[46Gremaining\u001b[56Gnon-matvec\u001b[67Gcost\u001b[72Gis\u001b[75Gattention\u001b[85Gand\u001b[89Gkey\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[1B \u001b[3Gtoken.\u001b[10GI'\u001b[13G prototyping\u001b[26Ga blocked key layout\u001b[47Gthat ke\u001b[55Gps positions contiguou\u001b[78G, with the b\u001b[91Gnchmark flushing caches\u001b[K\r\u001b[2C\u001b[1Bb\u001b[5Gtween calls.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSingle samples are too noisy to judge. I'll\u001b[47Grepeat\u001b[54Geach\u001b[59Gmeasurement\u001b[71G9\u001b[73Gtimes\u001b[79Gwith\u001b[84Ga\u001b[86Gcache\u001b[92Gflush\u001b[98Gbefore\u001b[105Geach\u001b[110Gand\u001b[114Gtake\r\u001b[2C\u001b[1Bmedians:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[9G\u001b[22mshell command \r\u001b[5C\u001b[1B\u001b[3"]
[410.016, "9m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked keys are faster\u001b[27Gup\u001b[30Gto\u001b[33G~300\u001b[38Gpositions\u001b[48G(1.11\u20131.53\u00d7)\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[2C\u001b[1Bpositions. Trying larger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[21C\u001b[2B\u001b[38;2;102;102;102m2\u001b[39m\u001b[40;1H\u001b[38;3H"]
