[170.954, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[22m def strided(k,\u001b[19Gshape):\u001b[27G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   base = blk[:, offs[k]:]\u001b[32G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15Gas_strided(base,\u001b[32Gshape=(L,)\u001b[43G+\u001b[45Gshape,\u001b[52Gstrides=(per\u001b[65G*\u001b[67G4,)\u001b[71G+\u001b[73Gtuple(s\u001b[81Gfor\u001b[85Gs\u001b[87Gin\u001b[90Gnp.empty(shape,\u001b[106GF32).strides))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m Vqkv = strided(0, m.wqkv.shape[1:]);\u001b[41GVo = \u001b[47Gtrid\u001b[52Gd(1, \u001b[58G.wo.shape[1:]); V13 = strided(2, m\u001b[93Gw13.sha\u001b[101Ge[1:]);\u001b[109GV2 =\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m strided(3, m.w2.shape[1:])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mVcls\u001b[9G=\u001b[11Gflat[L\u001b[18G*\u001b[20Gper:].reshape(m.wcls.shape)\r\u001b[1B \u001b[2m\u2502\u001b[22m assert np.array_equal(Vqkv, m.wqkv)\u001b[40Gand\u001b[44Gnp.array_equal(V2,\u001b[63Gm.w2)\u001b[69Gand\u001b[73Gnp.array_equal(Vcls,\u001b[94Gm.wcls)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('layouts:\u001b[20Gper-layer\u001b[30Garrays',\u001b[39Gm.wqkv.flags['C_CONTIGUOUS'],\u001b[69G'\u001b[71Gflat\u001b[76Gviews\u001b[82GC-contig:',\r\u001b[1B \u001b[2m\u2502\u001b[22m Vqkv.flags['C_CONTIGUOUS'], '(inner per-layer slabs are contiguous)')\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m def r"]
[170.955, "un_cur():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mm.reset()\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8Gfor p, t in \u001b[21Gnume\u001b[26Gate(seq): m.fo\u001b[41Gward(t, p)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     return m.logits.copy()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Grun_flat():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     m.reset()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gp,\u001b[15Gt\u001b[17Gin\u001b[20Genumerate(seq):\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G run.forward(t, p, m.emb, m.rms_att, Vqkv, Vo, m.rms_ffn, V13, V2, m.rms_final, Vcls, m.key_cach\u001b[108G,\u001b[110G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m m.value_cache,\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mm.x,\u001b[29Gm.xb,\u001b[35Gm.xb2,\u001b[42Gm.qkv,\u001b[49Gm.h13,\u001b[56Gm.att,\u001b[63Gm.logits_buf,\u001b[77Gm.rope_c,\u001b[87Gm.rope_s,\u001b[97Gm.n_heads,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m m.n_kv_heads,\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mm.kv_dim,\u001b[34Gm.k_off,\u001b[43Gm.v_off,\u001b[52Gm.hidden_dim,\u001b[66Gm.h3_off)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G r\u001b[10Gturn m.logits.copy()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m a\u001b[6G= run_cur(); b\u001b[21G= run_flat(); print('identical:', np.array_\u001b[65Gqual(a, b))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mR\u001b[6G=\u001b[8G{'separate\u001b[19Garrays':\u001b[28G[],\u001b[32G'on"]
