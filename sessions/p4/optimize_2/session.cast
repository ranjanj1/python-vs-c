[158.353, "\u001b[H\u001b[3G-\u001b[5GL\u001b[7Gng contexts weren't profiled in detail, bec\u001b[51Guse the dev workloads stop\u001b[78Gat\u001b[81G82\u001b[84Gpositions.\r\u001b[4C\u001b[1BMemory us\u001b[15G i\u001b[19Gunchanged at about 536 MB of resid\u001b[54Gn\u001b[56G weights.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md\u001b[12Ghas\u001b[16Gthe\u001b[20Gbefore/after\u001b[33Gprofile\u001b[41Gtables,\u001b[49Gevery\u001b[55Gcommand\u001b[63Gand\u001b[67Gthe\u001b[71Gremaining\u001b[81Glimitations.\u001b[94GThe\u001b[98Gsupporting\u001b[109Gscripts\u001b[117Gand\r\u001b[2C\u001b[1Bsaved profiles are in \u001b[38;2;87;105;247mscratch/\u001b[39m, along\u001b[41Gwith \u001b[38;2;87;105;247mscratch/run_v1.py\u001b[39m, the previous vers\u001b[83Gon kept for comparison.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCrunched for 12m 20s \u00b7 done 3:23 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations "]
[158.354, "or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gremaining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLast\u001b[8Gpass\u001b[13Gleft\u001b[18Gthe\u001b[22Gmatrix\u001b[29Gkernels\u001b[37Gnear\u001b[42Gthe\u001b[46Gsingle-core\u001b[58Gbandwidth\u001b[68Gceiling,\u001b[77Gso\u001b[80GI'll\u001b[85Gstart\u001b[91Gby\u001b[94Gre-profiling\u001b[107Gthe\u001b[111Gwhole\r\u001b[1B \u001b[3Gse\u001b[6Gsion to find where the\u001b[29Gr\u001b[31Gmaining time goes, including the parts outside the forward pass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gtakes\u001b[17G1.1\u20132.6\u001b[25Gs,\u001b[28Gmostly\u001b[35Gfrom\u001b[40G\u001b[38;2;87;105;247mimport numba\u001b[53G\u001b[39mand\u001b[57Gweight\u001b[64Gpreparation,\u001b[77Gso\u001b[80GI'm\u001b[84Gsplitting\u001b[94Gthe\u001b[98Gweight\u001b[105Gstep\u001b[110Ginto\u001b[115Gfile\r\u001b[1B \u001b[3Gre\u001b[6Gds, page faults and the cop\u001b[34G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcheckpoint's\u001b[20Gpages\u001b[26Gsometimes\u001b[36Gfall\u001b[41Gou"]
