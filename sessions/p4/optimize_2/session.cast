[411.513, "\u001b[H\r\u001b[6C\u001b[4Bsingle-buff\u001b[19Gr\u001b[21Glayout came\u001b[33Gi\u001b[35G within nois\u001b[48G, so I'm dropping it. I'm now doing three small, safe ch\u001b[105Gnges: sharing\u001b[K\r\u001b[3C\u001b[1Bhe embedding weights,\u001b[26Gresetting\u001b[36Gonly the KV position\u001b[58Gthe last command used, and\u001b[85Gwriting logits directly.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mExisting\u001b[12Gtests\u001b[18Gstill\u001b[24Gpass\u001b[29Gwith\u001b[34Gbitwise-identical\u001b[52Goutput,\u001b[60Gbut\u001b[64Gthe\u001b[68Gpartial\u001b[76Greset\u001b[82Gneeds\u001b[88Gits\u001b[92Gown\u001b[96Gtest:\u001b[102Gafter\u001b[108Ga\u001b[110Glong\r\u001b[1B \u001b[3Gcommand then a\u001b[18Gshor\u001b[23G \u001b[25Gne, the cache must be\u001b[47Gall zeros and match a fresh process.\u001b[84GI'm writing that test next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gpartial\u001b[15Greset\u001b[21Gis\u001b[24Gcorrect,\u001b[33Gand\u001b[37Gthe\u001b[41Gonly\u001b[46Gremaining\u001b[56Gnon-matvec\u001b[67Gcost\u001b[72Gis\u001b[75Gattention\u001b[8"]
[411.515, "5Gand\u001b[89Gkey\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[1B \u001b[3Gtoken. I'm prototyping a blocked key layout that keeps positions contiguous, with the \u001b[90Genchmark flushing caches\r\u001b[2C\u001b[1Bbetween calls.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSingle samples are too noisy to judge. I'll repeat each measurement 9 times with a cache flush before each and take\u001b[K\r\u001b[2C\u001b[1Bmedians:\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Blocked keys are faster up to ~300 positions (1.11\u20131.53\u00d7) and bitwise identical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[1C\u001b[1B positions. Trying larger blocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Trying key\u001b[14Gblock\u001b[20Gsizes 64 and 128\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/^H = KV = 12; hs = 64; S = 1024; L = 12; B = 32$/H = KV = 12; hs = 64; S = 1024; L = 12; B = \u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b"]
