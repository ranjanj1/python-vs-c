[229.234, "\u001b[H\u001b[2G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Last\u001b[8Gpass left the matrix\u001b[29Gkernels\u001b[37Gnear\u001b[42Gthe\u001b[46Gsingle-core\u001b[58Gbandwidth\u001b[68Gceiling,\u001b[77Gso\u001b[80GI'll\u001b[85Gstart\u001b[91Gby\u001b[94Gre-profiling\u001b[107Gthe\u001b[111Gwhole\r\u001b[1C\u001b[1B session\u001b[11Gto\u001b[14Gfind wh\u001b[23Ge\u001b[25Gthe\u001b[29Gremaining\u001b[39Gtime\u001b[44Ggoes,\u001b[50Gincluding\u001b[60Gthe\u001b[64Gparts\u001b[70Goutside\u001b[78Gthe\u001b[82Gforward\u001b[90Gpass.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Startup takes 1.1\u20132.6\u001b[25Gs,\u001b[28Gmostly\u001b[35Gfrom\u001b[40G\u001b[38;2;87;105;247mimport numba\u001b[53G\u001b[39mand\u001b[57Gweight\u001b[64Gpreparation,\u001b[77Gso\u001b[80GI'm\u001b[84Gsplitting\u001b[94Gthe\u001b[98Gweight\u001b[105Gstep\u001b[110Ginto\u001b[115Gfile\r\u001b[1C\u001b[1B reads, page faults and\u001b[26Gthe copy\u001b[35G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gcheckpoint's pages sometim\u001b[34Gs fall out of the OS\u001b[55Gfile cache, taking up to 952 ms on the first touch, and\u001b[111Gthe rest\r\u001b[1C\u001b[1B of weight loading\u001b[21Gtakes\u001b[2"]
