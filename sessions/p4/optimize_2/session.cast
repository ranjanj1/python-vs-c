[411.31, "Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[2C\u001b[1Bpositions.\u001b[14GTrying\u001b[21Glarger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[28G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i '' 's/^H = KV = 12; hs = 64; S = 1024; L = 12; B = 32$/H = KV = 12; hs = 64; S = 1024; L = 12; B = \r\u001b[5C\u001b[1Bint(sys.argv[1]) if len(sys.argv) > 1 else 32/' scratch/bench_kv.py && grep -n \"^H = KV\" scratch/bench_kv.py && for\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mb in 64 128; do echo \"B=$b\"; python3 scratch/bench_kv.py $b; done\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto m"]
