[603.655, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlocked keys are faster\u001b[27Gup\u001b[30Gto\u001b[33G~300\u001b[38Gpositions\u001b[48G(1.11\u20131.53\u00d7)\u001b[61Gand\u001b[65Gbitwise\u001b[73Gidentical,\u001b[84Gbut\u001b[88Gabout\u001b[94G5%\u001b[97Gslower\u001b[104Gat\u001b[107G1000\r\u001b[2C\u001b[1Bpositions.\u001b[14GTrying\u001b[21Glarger\u001b[28Gblocks\u001b[35Gfor\u001b[39Ga\u001b[41Gbetter\u001b[48Gbalance:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock size 64 wins at\u001b[25Gevery\u001b[31Gcontext\u001b[39Glength\u001b[46Gtested,\u001b[54Gup\u001b[57Gto\u001b[60G1.59\u00d7\u001b[66Gfaster\u001b[73Gat\u001b[76G300\u001b[80Gpositions,\u001b[91Gso\u001b[94GI'm\u001b[98Gadopting\u001b[107Git.\u001b[111GAttention\r\u001b[2C\u001b[1Btakes\u001b[9Gabout\u001b[15Ghalf\u001b[20Gof\u001b[23Geach\u001b[28Gtoken's\u001b[36Gtime\u001b[41Gat\u001b[44Gposition\u001b[53G1000,\u001b[59Gbut\u001b[63Gdev\u001b[67Gworkloads\u001b[77Gstay\u001b[82Gunder\u001b[88G83\u001b[91Gpositions,\u001b[102Gso\u001b[105GI'll\u001b[110Gcheck\u001b[116Gwhat\r\u001b[1B \u001b[3Gdominates there.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSoftmax is roughly 11%\u001b[26Gof\u001b[29Gattention\u001b[39Gcost\u001b[44Gat\u001b[47G1000\u001b[52Gpositions,\u001b[63Gso\u001b[66GI'm\u001b[70Ggoing"]
[603.657, "\u001b[76Gwith\u001b[81Gthe\u001b[85Gblock-64\u001b[94Glayout\u001b[101Gand\u001b[105Gnoting\r\u001b[2C\u001b[1Blong-context\u001b[16Gcosts\u001b[22Gas\u001b[25Ga\u001b[27Glimitation,\u001b[39Gstarting\u001b[48Gin\u001b[51G\u001b[38;2;87;105;247mrun.py\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m2\u001b[22m shell commands \u001b[25G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass, and I'm\u001b[28Grebuilding\u001b[39Gthe\u001b[43Gprevious\u001b[52Gpass's\u001b[59Gversion\u001b[67Gby\u001b[70Greverting\u001b[80Gthis\u001b[85Gpass's\u001b[92Gedits\u001b[98Gso\u001b[101GI\u001b[103Gcan\u001b[107Grun\u001b[111Ga\u001b[113Gfair\u001b[118GA/B\r\u001b[2C\u001b[1Band\u001b[7Gconfirm\u001b[15Git\u001b[18Gmatches\u001b[26Gbitwise.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn the dev path the speedup\u001b[31Gis\u001b[34Gwithin\u001b[41Gnoise\u001b[47G(1.004\u00d7),\u001b[57Gas\u001b[60Gexpected\u001b[69Gat\u001b[72Gthese\u001b[78Gshort\u001b[84Gpositions,\u001b[95Gso\u001b[98GI'm\u001b[102Gmeasuring\u001b[112Gboth\r\u001b[2C\u001b[1Bversions\u001b[12Gend-to-end\u001b[23Gat\u001b[26Glonger\u001b[33Gcontexts\u001b[42Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe long-context\u001b[20GFIXED runs are abou"]
