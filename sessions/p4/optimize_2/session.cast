[381.774, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[39m No\u001b[6G-forward-pass overheads are all\u001b[38Gsmall\u001b[44G(dispatch,\u001b[55Gargmax,\u001b[63GKV\u001b[66Greset,\u001b[73Gand\u001b[77Gthe\u001b[81GLOGITS\u001b[88Gwrite),\u001b[96Gand\u001b[100Gthe\u001b[104Gkernels\u001b[112Gare\r\u001b[1C\u001b[1B already\u001b[11Gat the hardware limit. Next I'll test\u001b[49Gputting all weights into\u001b[74Gone\u001b[78Gbuffer in\u001b[88Gforward-pass order, since\u001b[114Gthe\u001b[K\r\u001b[1C\u001b[1B four separate\u001b[17Garrays\u001b[24Gmake\u001b[29Geach\u001b[34Glayer\u001b[40Gjump\u001b[45Gbetween\u001b[53Gmemory\u001b[60Gstreams.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gst\u001b[10Gided views weren't C-contiguous, so Numba fell back\u001b[62Gto a non-vectorizing version, and\u001b[96Gthe m\u001b[102Gchin\u001b[107G is more\r\u001b[1C\u001b[1B loaded now, so that comparison is\u001b[37Ginvalid. I'm redoing\u001b[58Git\u001b[61Gwith\u001b[66Gcontiguous\u001b[77Gper-layer\u001b[87Gviews\u001b[93Gfrom\u001b[98Gone\u001b[102Gflat\u001b[107Gbuffer,\u001b[115Geach\r\u001b[1C\u001b[1B layout\u001b[10Gmeasu\u001b[17Gd in\u001b[22Gits\u001b[26Gown process.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m"]
[381.775, "\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gsingle-buffer layout came in\u001b[36Gwithin\u001b[43Gnoise,\u001b[50Gso\u001b[53GI'm\u001b[57Gdropping\u001b[66Git.\u001b[70GI'm\u001b[74Gnow\u001b[78Gdoing\u001b[84Gthree\u001b[90Gsmall,\u001b[97Gsafe\u001b[102Gchanges:\u001b[111Gsharing\r\u001b[1C\u001b[1B the\u001b[7Gembedding\u001b[17Gweights, resetting only the\u001b[45GKV\u001b[48Gpositions\u001b[58Gthe\u001b[62Glast\u001b[67Gcommand\u001b[75Gused,\u001b[81Gand\u001b[85Gwriting\u001b[93Glogits\u001b[100Gdirectly.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, read \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Existing\u001b[12Gtests still\u001b[24Gpass with bitwise-identical\u001b[52Goutput,\u001b[60Gbut\u001b[64Gthe\u001b[68Gpartial\u001b[76Greset\u001b[82Gneeds\u001b[88Gits\u001b[92Gown\u001b[96Gtest:\u001b[102Gafter\u001b[108Ga\u001b[110Glong\r\u001b[1C\u001b[1B command\u001b[11Gthen\u001b[16Ga\u001b[18Gshort one, the cache must be all zeros and mat\u001b[65Gh a fre\u001b[73Gh\u001b[75Gprocess.\u001b[84GI'm\u001b[88Gwriting\u001b[96Gthat\u001b[101Gtest\u001b[106Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gpartial\u001b[15Greset "]
[381.776, "is correct, and the only remaining non-matvec cost is attention and key\u001b[93Gstorage\u001b[101Gat\u001b[104Gabout\u001b[110G0.3\u001b[114Gms\u001b[117Gper\r\u001b[1C\u001b[1B token.\u001b[10GI'm prototyping a blocked key layout that ke\u001b[55Gps positions\u001b[68Gcontiguous,\u001b[80Gwith\u001b[85Gthe\u001b[89Gbenchmark\u001b[99Gflushing\u001b[108Gcaches\r\u001b[1C\u001b[1B between\u001b[11Gcalls\u001b[17G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmark\u001b[14Gg blocked key-cache\u001b[34Glayout\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/bench_kv.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m\"\"\"Key-cache layout: current (KV, hs, S) vs blocked (KV, S/B, hs, B). Store + attention per layer, caches cold.\"\"\"\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport os, sys, time, statistics, math\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__))); sys.path.insert(0, ROOT); os.chdir(ROOT)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m\u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u273d\u001b[3G\u001b[38;2;223;127;95mNewspapering\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(6m 14s \u00b7 "]
