[278.258, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've settled the d\u001b[22Gsig\u001b[26G:\u001b[28Gweights st\u001b[39Gr\u001b[41Gd\u001b[43Gtransposed\u001b[54Gat\u001b[57Gload\u001b[62Gand\u001b[66Gcompiled\u001b[75Gas\u001b[78Gan\u001b[81Gunrolled\u001b[90Gaxpy,\u001b[96Gcached\u001b[103Gtransposed\u001b[114Gkeys,\r\u001b[2C\u001b[1Band\u001b[7Ga\u001b[9Gplain-Python\u001b[22Gtokenizer\u001b[32Gmirroring\u001b[42Gthe\u001b[46Greference.\u001b[57GWriting\u001b[65Grun.py\u001b[72Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m487\u001b[16G\u001b[22mlines to \u001b[1mrun.py\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then th"]
[278.259, "e line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to\u001b[32Ghold arrays (load, reshap\u001b[58G/transpose copi\u001b[74Gs, writing l\u001b[87Ggits).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes\u001b[22Gon\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRu"]
[278.26, "nning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[2C\u001b[1Bprompts,\u001b[12G64\u001b[15Gtokens.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass. Now\u001b[24GI'll\u001b[29Gconfirm\u001b[37Gthat\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[2C\u001b[1Bspeed.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
