[293.666, "\u001b[H     \u001b[38;2;51;51;51m\u001b[2m  5 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to hold arrays (load, reshape/transpose copies, writing logits).\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Quick check\u001b[15Gpasses\u001b[22Gon\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[1C\u001b[1B prompts, 64 tokens.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[3"]
[293.667, "8;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All checks pas\u001b[18G.\u001b[20GNow\u001b[24GI'll\u001b[29Gconfirm\u001b[37Gthat\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[1C\u001b[1B speed.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gonly\u001b[12Gfloat64 e\u001b[22Gtries are lit\u001b[36Gral con\u001b[44Gtants inside \u001b[38;2;87;105;247mF32(...)\u001b[39m casts. Re-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b[116Gsee\r\u001b[1C\u001b[1B all\u001b[7Gof \u001b[11Ghem\u001b[15Gplus the LLVM IR:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Inspect\u001b[12Gg types and LLVM IR withou\u001b[39G cache\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ NUMBA_CACHE_DIR=$(mktemp -d) python3 - <<'EOF' 2>&1 | tail -30\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport io, sys, re\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport run\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mm = run.Model('model.bin')\u001b[39m\u001b[K\r\u001b"]
