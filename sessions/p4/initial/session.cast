[128.122, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[20G\u001b[22macc[k]\u001b[27G+=\u001b[30Gw2[i,\u001b[36Gj0+k]*x[j0+k]\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[12Gs = np.float32(0.0)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[12Gfor k in range(16): s += acc[k]\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[12Gout[i] =\u001b[21Gs\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[4G\u001b[22m@njit\r\u001b[1B \u001b[2m\u2502\u001b[22m def mm_axpy(out, x, wt, n, d):\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     # transposed weights wt (n, d): out[i] = sum_j wt[j,i]*x[j], same j order as reference\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     for i in range(d): out[i] = np.float32(0.0)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     for j in range(n):\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         xj = x[j]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gi\u001b[18Gin\u001b[21Grange(d):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             out[i] += wt[j, i]*xj\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1B\u001b[22m \u001b[2m\u2502\u001b[22m for n, d\u001b[13Gin [(768, 2048), (768, 32000), (2048,\u001b[51G768)]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G rng = np.random.defaul\u001b[31G_rng(0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mw\u001b[10G=\u001b[12Grng.standard_normal(n*d).astype(np.float32)*np.float32(0.02)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     x = rng.standard_normal(n).astype(n"]
[128.126, "p.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mw2\u001b[11G=\u001b[13Gw.reshape(d,\u001b[26Gn);\u001b[30Gwt\u001b[33G=\u001b[35Gnp.ascontiguousarray(w2.T)\r\u001b[1B \u001b[2m\u2502\u001b[22m     ref = (w2.astype(np.float64) @ x.astype(np.float64))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G fo\u001b[11G f, W in\u001b[20G((m\u001b[24G_rows4,\u001b[32Gw),\u001b[36G(mm_rows8,\u001b[47Gw),\u001b[51G(mm_l16_u,\u001b[62Gw),\u001b[66G(mm_acc_arr,\u001b[79Gw2),\u001b[84G(mm_axpy,\u001b[94Gwt)):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout\u001b[16G=\u001b[18Gnp.zeros(d,\u001b[30Gnp.float32)\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G f(out,\u001b[19Gx, W, n,\u001b[28Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mt\u001b[14G=\u001b[16Gtime.perf_counter();\u001b[37GR\u001b[39G=\u001b[41G20\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16G_\u001b[18Gin\u001b[21Grange(R):\u001b[31Gf(out,\u001b[38Gx,\u001b[41GW,\u001b[44Gn,\u001b[47Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mdt\u001b[15G=\u001b[17G(time.perf_counter()-t)/R\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mprint(f\"{n}x{d}\u001b[28G{f.__name__:12s}\u001b[45G{dt*1e3:7.3f}\u001b[59Gms\u001b[63G{n*d*4/dt/1e9:6.1f}\u001b[83GGB/s\u001b[89Gerr\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m{np.abs(out-ref).max():.2e}\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/agentlab/pvc/p4\u001b[30G&&\u001b[33Gpython3\u001b[41Gscratch/bench_mm2.p"]
[128.129, "y\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/bench_mm2.py\u001b[73G\u001b[22mcommands\u001b[82Gin\u001b[85G\u001b[1m/Users/agentlab/pvc/p4\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
