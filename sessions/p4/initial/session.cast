[255.645, "2;24;54;145m''\u001b[38;2;51;51;51m:\r\u001b[1B\u001b[39m \u001b[38;2;51;51;51m\u001b[2m 479 \u001b[22m            \u001b[38;2;167;29;93mcontinue\u001b[28G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 480 \u001b[22m        \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m:\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 481 \u001b[22m            say(\u001b[38;2;24;54;145m'ERR unknown command'\u001b[38;2;51;51;51m)\r\u001b[1C\u001b[1B\u001b[2m 482 \u001b[22m    out.flush()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 483 \u001b[22m    sys.exit(\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m)\r\u001b[1B\u001b[39m \u001b[38;2;51;51;51m\u001b[2m 484 \u001b[8G\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 485 \u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 486 \u001b[22m\u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m __name__ == \u001b[38;2;24;54;145m'__main__'\u001b[38;2;51;51;51m:\r\u001b[1C\u001b[1B\u001b[2m 487 \u001b[22m    main()\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[255.646, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to create \u001b[1mrun.py\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
