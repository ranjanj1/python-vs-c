[103.092, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gj\u001b[18Gin\u001b[21Grange(0,\u001b[30Gn,\u001b[33G8):\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[12G    x0=x[j];x1=x[j+1];x2=x[j+2];x3=x[j+3];x4=x[j+4];x5=x[j+5];x6=x[j+6];x7=x[j+7]\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[12G    p0+=w[b0+j]*x0;p1+=w[b0+j+1]*x1;p2+=w[b0+j+2]*x2;p3+=w[b0+j+3]*x3;p4+=w[b0+j+4]*x4;p5+=w[b0+j+5]*x5;p6+=\r\u001b[1B \u001b[2m\u2502\u001b[22m w[b0+j+6]*x6;p7+=w[b0+j+7]*x7\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mq0+=w[b1+j]*x0;q1+=w[b1+j+1]*x1;q2+=w[b1+j+2]*x2;q3+=w[b1+j+3]*x3;q4+=w[b1+j+4]*x4;q5+=w[b1+j+5]*x5;q6+=\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mw[b1+j+6]*x6;q7+=w[b1+j+7]*x7\r\u001b[1B \u001b[2m\u2502\u001b[22m             r0+=w[b2+j]*x0;r1+=w[b2+j+1]*x1;r2+=w[b2+j+2]*x2;r3+=w[b2+j+3]*x3;r4+=w[b2+j+4]*x4;r5+=w[b2+j+5]*x5;r6+=\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m w[b2+j+6]*x6;r7+=w[b2+j+7]*x7\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m             s0+=w[b3+j]*x0;s1+=w[b3+j+1]*x1;s2+=w[b3+j+2]*x2;s3+=w[b3+j+3]*x3;s4+=w[b3+j+4]*x4;s5+=w[b3+j+5]*x5;s6+=\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m w[b3+j+6]*x6;s7+=w[b3+j+7]*x7\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         out[i]=((p0+p1)+(p2+p3))+((p4+p5)+(p6+p7))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22m"]
[103.093, "out[i+1]=((q0+q1)+(q2+q3))+((q4+q5)+(q6+q7))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         out[i+2]=((r0+r1)+(r2+r3))+((r4+r5)+(r6+r7))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout[i+3]=((s0+s1)+(s2+s3))+((s4+s5)+(s6+s7))\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     i += 4\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gn,\u001b[11Gd\u001b[13Gin\u001b[16G[(768,\u001b[23G2048),\u001b[30G(768,\u001b[36G32000),\u001b[44G(2048,\u001b[51G768)]:\r\u001b[1B \u001b[2m\u2502\u001b[22m     rng = np.rando\u001b[23G.default_rng(0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mw\u001b[10G=\u001b[12Grng.standard_normal(n*d).astype(np.float32)*np.float32(0.02)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mx\u001b[10G=\u001b[12Grng.standard_normal(n).astype(np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mref\u001b[12G=\u001b[14G(w.reshape(d,\u001b[28Gn).astype(np.float64)\u001b[50G@\u001b[52Gx.astype(np.float64))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gf\u001b[14Gin\u001b[17G(mm_naive,\u001b[28Gmm_lanes8,\u001b[39Gmm_lanes16,\u001b[51Gmm_rows4,\u001b[61Gmm_r4l8):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout\u001b[16G=\u001b[18Gnp.zeros(d,\u001b[30Gnp.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mf(out,\u001b[19Gx,\u001b[22Gw,\u001b[25Gn,\u001b[28Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mt\u001b[14G=\u001b[16Gtime.perf_counter();\u001b[37GR\u001b[39G=\u001b[4"]
[103.094, "1G20\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16G_\u001b[18Gin\u001b[21Grange(R):\u001b[31Gf(out,\u001b[38Gx,\u001b[41Gw,\u001b[44Gn,\u001b[47Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mdt\u001b[15G=\u001b[17G(time.perf_counter()-t)/R\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mprint(f\"{n}x{d}\u001b[28G{f.__name__:12s}\u001b[45G{dt*1e3:7.3f}\u001b[59Gms\u001b[63G{n*d*4/dt/1e9:6.1f}\u001b[83GGB/s\u001b[89Gerr\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m{np.abs(out-ref).max():.2e}\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/agentlab/pvc/p4\u001b[30G&&\u001b[33Gpython3\u001b[41Gscratch/bench_mm.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;"]
