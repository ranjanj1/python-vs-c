[299.015, "\u001b[H\r\u001b[38C\u001b[33B\u001b[38;2;153;153;153mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[299.117, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[39m\u001b[40;1H\u001b[38;3H"]
[299.157, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <t\u001b[52Gkenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, \u001b[67Ghen the line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\r\u001b[6C\u001b[1B\u001b[2m 7\u001b[10G\u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to hold arrays (load, reshape/transpose copies, writing logits).\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;5"]
[299.158, "1;51m math\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes on\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[2C\u001b[1Bprompts,\u001b[12G64\u001b[15Gtokens.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass. Now\u001b[24GI'll\u001b[29Gconfirm\u001b[37Gthat\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[2C\u001b[1Bspeed.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe only float64\u001b[20Ge\u001b[22Gtries are\u001b[32Gl\u001b[35Geral\u001b[41Gonstants\u001b[50Ginside\u001b[57G\u001b[38;2;87;105;247mF32(...)\u001b[66G\u001b[39mcasts.\u001b[73GRe-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b[116Gsee\r\u001b[1B  all of them plus the LLVM IR:\u001b[K\r\u001b[5C\u001b[1B\u001b"]
[299.159, "[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything is float32 with no fastmath flags,\u001b[49Gand\u001b[53Gthe\u001b[57Ghot\u001b[61Gloops\u001b[67Gare\u001b[71Gvectorized.\u001b[83GNow\u001b[87Gtiming\u001b[94Gstartup\u001b[102Gand\u001b[106Gper-token\r\u001b[2C\u001b[1Bthroughput:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[38;3H"]
[299.189, "\u001b[H\r\u001b[31B\u001b[38;2;102;102;102m \u001b[39m\u001b[40;1H\u001b[38;3H"]
