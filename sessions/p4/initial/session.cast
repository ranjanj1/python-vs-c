[325.398, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[6G\u001b[22m  for i in range(d): out[i] = F32(0.0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  j = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  while j + 2 <= n:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      x0=x[j];x1=x[j+1];\u001b[31Gw0=wt[j];w1=wt[j+1]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      for i in range(d):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m          v =\u001b[20Gout[i];\u001b[28Gv\u001b[30G+=\u001b[33Gw0[i]*x0;\u001b[43Gv\u001b[45G+=\u001b[48Gw1[i]*x1;\u001b[58Gout[i]\u001b[65G=\u001b[67Gv\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mj\u001b[14G+=\u001b[17G2\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     while j < n:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mxj\u001b[15G=\u001b[17Gx[j];\u001b[23Gwj\u001b[26G=\u001b[28Gwt[j]\r\u001b[1B \u001b[2m\u2502\u001b[22m     \u001b[9G   for i in ra\u001b[24Gge(d): ou\u001b[34G[i] += wj[i]*xj\u001b[50G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gj += 1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[22m # 12 layers worth of\u001b[25Gdistinct\u001b[34Gweights\u001b[42Gso\u001b[45Gcaches\u001b[52Gcan't\u001b[58Ghold\u001b[63Gthem\u001b[68G(real\u001b[74Gaccess\u001b[81Gpattern)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrng\u001b[8G=\u001b[10Gnp.random.default_rng(0)\r\u001b[1B \u001b[2m\u2502\u001b[22m for n, d in [(768, 768),\u001b[29G(768, 2048),\u001b[42G(2048, 768), (768, 32000)]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     L\u001b[10G=\u001b[12G1"]
