[353.393, "\u001b[H \u001b[2m\u2502\u001b[22m     \u001b[9G   x3\u001b[15G= x[j + 3]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gw0\u001b[15G= wt[j]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mw1\u001b[15G=\u001b[17Gwt[j\u001b[22G+\u001b[24G1]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         w2 = wt[j +\u001b[24G2]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mw3\u001b[15G=\u001b[17Gwt[j\u001b[22G+\u001b[24G3]\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     for i in range(d):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[16Gv\u001b[18G=\u001b[20Gout[i]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mv\u001b[18G+=\u001b[21Gw0[i]\u001b[27G*\u001b[29Gx0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             v += w1[i]\u001b[27G*\u001b[29Gx1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mv\u001b[18G+=\u001b[21Gw2[i]\u001b[27G*\u001b[29Gx2\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G    \u001b[12G    v += w3[\u001b[25G] * x3\u001b[32G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G  \u001b[10G    \u001b[15G o\u001b[18Gt[i] = v\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mj\u001b[14G+=\u001b[17G4\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     while j < n:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mxj\u001b[15G=\u001b[17Gx[j]\r\u001b[1B \u001b[2m\u2502\u001b[22m         wj =\u001b[17Gwt[j]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for\u001b[16Gi\u001b[18Gin\u001b[21Grange(d):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mout[i]\u001b[23G+=\u001b[26Gwj[i]\u001b[32G*\u001b[34Gxj\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         j += 1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1B\u001b[22m \u001b[2m\u2502\u001b[22m\u001b"]
[353.394, "[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'''\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s = s[:old_start] +\u001b[24Gnew\u001b[28G+\u001b[30Gs[old_end:]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace('\u001b[23Grmsnorm(x,\u001b[34Gx,\u001b[37Grms_final)\\n\u001b[53Gmatmul_t(logits,\u001b[70Gx,\u001b[73Gwcls)',\u001b[81G'\u001b[86Grmsnorm(x,\u001b[97Gx,\u001b[100Grms_final)\\n\r\u001b[1B \u001b[2m\u2502\u001b[22m matmul_t4(logits, x, wcls)')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('run.py',\u001b[19G'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mgrep\u001b[9G-n\u001b[12G\"matmul_t4(logits\"\u001b[31Grun.py\u001b[38G&&\u001b[41Gpython3\u001b[49Gscratch/speed.py\u001b[66G&&\u001b[69Gpython3\u001b[77Gcheck.py\u001b[86G--tokens\u001b[95G64\u001b[98G--prompts\u001b[108G3\u001b[110G--\u001b[113Gpython3\r\u001b[1B \u001b[2m\u2502\u001b[22m run.py\u001b[11G\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
