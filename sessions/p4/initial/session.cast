[454.539, "\u001b[H\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Throughput is up to about 100 tok/s and tests still pass; since the third run's dip\u001b[87Glooks\u001b[93Glike\u001b[98Gmachine\u001b[106Gnoise,\u001b[113GI'm\r\u001b[1C\u001b[1B re-timing, then testing edge cases.\u001b[K\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All edge c\u001b[14Gses check out,\u001b[29Gand\u001b[33Gthe\u001b[37Gcontext\u001b[45Gstop\u001b[50Gemits\u001b[56Gthe\u001b[60Gexpected\u001b[69Gtoken\u001b[75Gcount.\u001b[82GThroughput\u001b[93Gvaries\u001b[100Ga\u001b[102Glot\u001b[106Gbetween\u001b[114Gruns,\r\u001b[1C\u001b[1B so machine load is likely;\u001b[30GI'm\u001b[34Glooking\u001b[42Ginto\u001b[47Gthe\u001b[51G2.7s\u001b[56Gstartup\u001b[64Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Weight\u001b[10Gloading plus transposing\u001b[35Gtakes\u001b[41G1.9s\u001b[46Gof\u001b[49Gstartup.\u001b[58GTrying\u001b[65Ga\u001b[67Gsequential\u001b[78G\u001b[38;2;87;105;247mfromfile\u001b[87G\u001b[39mread\u001b[92Gin\u001b[95Gplace\u001b[101Gof\u001b[104Gthe\u001b[108Gmemmap,\u001b[116Gand\r\u001b[1C\u001b[1B diff"]
[454.54, "erent t\u001b[15Ganspose block sizes:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Time\u001b[8Gfile\u001b[13Gread and transpos\u001b[31G variants\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mimport time, numpy as np, run\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mfrom numba import njit\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m@njit(boundscheck=False)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mdef tr(dst, src, B):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mL, d, n = src.shape\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfor l in range(L):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102ms = src[l]; t = dst[l]\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mfor i0 in range(0, d, B):\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mi1 = min(i0 + B, d)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfor j0 in range(0, n, B):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mj1 = min(j0 + B, n)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mfor i in range(i0, i1):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mfo\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[3"]
