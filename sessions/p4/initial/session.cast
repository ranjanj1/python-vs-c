[260.9, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mLane-splitting didn't\u001b[25Gvectorize,\u001b[36Gbut\u001b[40G4\u001b[42Grows\u001b[47Gat\u001b[50Ga\u001b[52Gtime\u001b[57Ggave\u001b[62G3x,\u001b[66Gso\u001b[69GI'm\u001b[73Gtrying\u001b[80G8\u001b[82Grows,\u001b[88G2D\u001b[91Gindexing,\u001b[101Gunsigned\u001b[110Gindices,\r\u001b[2C\u001b[1Band\u001b[7Ga\u001b[9Gtransposed\u001b[20Gform\u001b[25Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe transposed axpy form\u001b[28Gis\u001b[31Gthe\u001b[35Gclear\u001b[41Gwinner\u001b[48Gat\u001b[51Gabout\u001b[57G48\u001b[60GGB/s\u001b[65Gand\u001b[69Gmatches\u001b[77Gthe\u001b[81Greference's\u001b[93Gerror.\u001b[100GI'm\u001b[104Gnow\u001b[108Gtiling\u001b[115Gthe\r\u001b[2C\u001b[1B32000-row\u001b[13Gclassifier\u001b[24Gand\u001b[28Gunrolling\u001b[38Gover\u001b[43Gj.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've settled the design:\u001b[28Gweights\u001b[36Gstored\u001b[43Gtransposed\u001b[54Gat\u001b[57Gload\u001b[62Gand\u001b[66Gcompiled\u001b[75Gas\u001b[78Gan\u001b[81Gunrolled\u001b[90Gaxpy,\u001b[96Gcached\u001b[103Gtransposed\u001b[114Gkeys,\r\u001b[2C\u001b[1Band\u001b[7Ga\u001b[9Gplain-Python\u001b[2"]
[260.901, "2Gtokenizer\u001b[32Gmirroring\u001b[42Gthe\u001b[46Greference.\u001b[57GWriting\u001b[65Grun.py\u001b[72Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m487\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mrun.py\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[7C\u001b[1B\u001b[2m5\r\u001b[7C\u001b[1B6\u001b[10G\u001b[22mCompute: every\u001b[25Garithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @nji\u001b[72G (nopython) function working\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[10G\u001b[22mon float32 NumPy arrays. "]
[260.902, "No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mNu\u001b[13GPy \u001b[38;2;167;29;93mis\u001b[19G\u001b[38;2;51;51;51mus\u001b[22Gd only to hold arrays\u001b[44G(load, reshape/transpose copies, writing logits).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[40;1H\u001b[38;3H"]
