[537.519, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mP4\u001b[6Gis\u001b[9Gimplemented\u001b[21Gin\u001b[24G\u001b[38;2;87;105;247mrun.py\u001b[31G\u001b[39mand\u001b[35Gpasses\u001b[42Gthe\u001b[46Gsupplied\u001b[55Gtests.\u001b[62GRun\u001b[66Git\u001b[69Gwith\u001b[74G\u001b[38;2;87;105;247mpython3 run.py model.bin tokenizer.bin\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTest results\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;87;105;247mpython3 check.py -- python3 run.py\u001b[40G\u001b[39m\u2192\u001b[42G\u001b[1mPASS\u001b[22m,\u001b[48Gmax\u001b[52Glogit\u001b[58Gerror\u001b[64G9.8e-6\u001b[71G(tolerance\u001b[82G5e-4).\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mpython3 check.py --tokens 64 --prompts 3 -- python3 run.py\u001b[64G\u001b[39m\u2192\u001b[66G\u001b[1mPASS\u001b[22m,\u001b[72Gmax\u001b[76Gerror\u001b[82G2.4e-5.\r\u001b[1B \u001b[3G- My own te\u001b[16Gs also passed:\u001b[K\r\u001b[2C\u001b[1B  - PIECE output matched\u001b[28Gevery\u001b[34Gpiece\u001b[40Gin\u001b[43Gthe\u001b[47Gfixtures.\r\u001b[4C\u001b[1B-\u001b[7GFIXED's\u001b[15Gargmaxes\u001b[24Gmatched\u001b[32GGENERATE's\u001b[43Goutput.\r\u001b[2C\u001b[1B  - Empty text,\u001b[19G\u001b[38;2;87;105;247mGENERATE 0\u001b[30G\u001b[39mand\u001b[34Ga\u001b[36G1016-token\u001b[47Gprompt\u001b[54Gbehaved\u001b[62Gas\u001b[65Gexpected.\u001b[75GThe\u001b[79G"]
[537.52, "long\u001b[84Gprompt\u001b[91Gstopped\u001b[99Gwith\u001b[104G\u001b[38;2;87;105;247mcontext\u001b[112G\u001b[39mafter\r\u001b[6C\u001b[1Bexactly\u001b[15Gthe\u001b[19G9\u001b[21Gnew\u001b[25Gtokens\u001b[32Gthe\u001b[36Greference\u001b[46Gwould\u001b[52Gproduce.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed:\u001b[10G\u001b[22mroughly\u001b[18G85\u2013100\u001b[25Gtokens/s\u001b[34Gfor\u001b[38Ggeneration\u001b[49Gand\u001b[53Gabout\u001b[59G1.4s\u001b[64Gto\u001b[67G\u001b[38;2;87;105;247mREADY\u001b[73G\u001b[39monce\u001b[78GNumba's\u001b[86Gcompile\u001b[94Gcache\u001b[100Gis\u001b[103Gwarm\u001b[108G(about\u001b[115G2.8s\r\u001b[1B \u001b[3Gon the first run).\u001b[22GTimings\u001b[30Gvaried\u001b[37Ga\u001b[39Glot\u001b[43Gbetween\u001b[51Gidentical\u001b[61Gruns\u001b[66G(62\u2013104\u001b[74Gtokens/s),\u001b[85Gapparently\u001b[96Gbecause\u001b[104Gof\u001b[107Gother\u001b[113Gload\u001b[118Gon\r\u001b[1B  the machine, so treat them as\u001b[33Grough.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5G\u001b[1mMatrix multiply:\u001b[22m each weight matrix is transposed once at load time and the loop runs over the\u001b[100Goutputs.\u001b[109GThis\r\u001b[4C\u001b[1Bvectorizes without fastmath and adds each output's\u001b[56Gterms\u001b[62Gin\u001b[65Gthe\u001b[69Gsame\u001b[74Gorder\u001b[80Gas\u001b[83G\u001b[38;2;87;105;247mmatmul\u001b[90G\u001b[39min\u001b[93G\u001b[38;2;87;105;247mrun.c\u001b["]
[537.521, "39m.\u001b[100GNo\u001b[103GBLAS,\u001b[109G\u001b[38;2;87;105;247mnp.dot\u001b[116G\u001b[39mor\u001b[119G\u001b[38;2;87;105;247m@\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[15G\u001b[22mkeys\u001b[20Gare\u001b[24Gstored\u001b[31Gtransposed\u001b[42Gper\u001b[46Ghead\u001b[51Gso\u001b[54Gattention\u001b[64Gscores\u001b[71Gvectorize\u001b[81Gwhile\u001b[87Gkeeping\u001b[95Gthe\u001b[99Greference's\u001b[111Gorder.\u001b[118GThe\r\u001b[4C\u001b[1Bcache is cleared\u001b[22Gand\u001b[26Gpositions\u001b[36Grestart\u001b[44Gat\u001b[47G0\u001b[49Gfor\u001b[53Gevery\u001b[59Gcommand.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrecision:\u001b[16G\u001b[22mI\u001b[18Gchecked\u001b[26Gthe\u001b[30Gcompiled\u001b[39Gtypes\u001b[45Gand\u001b[49Gthe\u001b[53Ggenerated\u001b[63GLLVM\u001b[68Gcode.\u001b[74GEverything\u001b[85Gis\u001b[88Gfloat32,\u001b[97Gwith\u001b[102Gno\u001b[105Gdouble\r\u001b[4C\u001b[1Barithmetic, no fast-math flags and no threads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSame work as \u001b[38;2;87;105;247mrun.c\u001b[39m:\u001b[22m the classifier runs at every position, including forced prompt tokens. The tokenizer reproduces\r\u001b[4C\u001b[1Bthe reference's encoding and decoding\u001b[43Grules.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (details in NOTES.md)\r\u001b[1B\u001b[22m\u001b[K\r\u001b[1B  - The transposed copy of the weights takes about 1 GB of memory at pea"]
[537.522, "k during\u001b[82Gloading.\u001b[91GThat\u001b[96Gincludes\u001b[105Gan\u001b[108Gextra\u001b[114G98\u001b[117GMB\r\u001b[4C\u001b[1Bfor\u001b[9Gthe\u001b[13Gclassifier,\u001b[25Gwhich\u001b[31Gshares\u001b[38Gits\u001b[42Gweights\u001b[50Gwith\u001b[55Gthe\u001b[59Gembedding\u001b[69Gtable.\r\u001b[1B \u001b[3G- Numba's compile cache is written to \u001b[38;2;87;105;247m__pycache__/\u001b[39m next\u001b[59Gto\u001b[62G\u001b[38;2;87;105;247mrun.py\u001b[39m.\u001b[70GWithout\u001b[78Git,\u001b[82Gstartup\u001b[90Gcompiles\u001b[99Gfor\u001b[103Ga\u001b[105Gfew\u001b[109Gseconds.\r\u001b[1B  -\u001b[K\u001b[40;1H\u001b[38;3H"]
