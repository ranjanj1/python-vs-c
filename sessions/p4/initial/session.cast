[289.154, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[39m\u001b[40;1H\u001b[38;3H"]
[289.272, "\u001b[H\r\u001b[4C\u001b[33B\u001b[38;2;245;149;117ms\u001b[8G\u001b[38;2;215;119;87mn\u001b[39m\u001b[40;1H\u001b[38;3H"]
[289.356, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m487\u001b[22m lines to \u001b[1mrun.py\u001b[22m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py\u001b[32G<checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokeniz\u001b[58Gr.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then th\u001b[74G line protoc\u001b[87Gl \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 6\u001b[10G\u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b"]
[289.358, "[5C\u001b[1B\u001b[2m  8 \u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to hold arrays (load, reshape/transpose copies, writing logits).\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m\u2026 +477 lines \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick\u001b[9Gcheck\u001b[15Gpasses\u001b[22Gon\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[1B \u001b[3Gprompts, 64 tokens.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All checks pass. Now I'll confirm that\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[2C\u001b[1Bspeed.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan"]
[289.358, " \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe only float64 entries are literal constants\u001b[50Ginside\u001b[57G\u001b[38;2;87;105;247mF32(...)\u001b[66G\u001b[39mcasts.\u001b[73GRe-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b[116Gsee\r\u001b[2C\u001b[1Ball of them plus the LLVM IR:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\u001b[40;1H\u001b[38;3H"]
[289.369, "\u001b[H\r\u001b[38C\u001b[33B\u001b[38;2;102;102;102mthought for 3s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
