[70.533, "\u001b[H\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mChecking\u001b[12Gtokenizer\u001b[22Gvocab\u001b[28Gedge\u001b[33Gcases\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -c \"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport struct\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102md=open('tokenizer.bin','rb').read()\r\u001b[5C\u001b[1Bmtl,=struct.unpack_from('i',d,0); o=4; voc=[]\r\u001b[5C\u001b[1Bfor i in range(32000):\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102ms,l=struct.unpack_from('fi',d,o); o+=8; voc.append(d[o:o+l]); o+=l\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mprint(mtl, o, len(d))\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport collections\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mc=collections.Counter(voc); print('dups',[(k,v) for k,v i\u2026\u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[70.534, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1B \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mCheck t\u001b[10Gkenizer vocab edge cases\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3 -c \"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport struct\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22md=open('tokenizer.bin','rb').read()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmtl,=struct.unpack_from('i',d,0); o=4; voc=[]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor i in range(32000):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22ms,l=struct.unpack_from('fi',d,o);\u001b[42Go+=8;\u001b[48Gvoc.append(d[o:o+l]);\u001b[70Go+=l\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp"]
[70.534, "rint(mtl,\u001b[15Go,\u001b[18Glen(d))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gcollections\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mc=collections.Counter(voc);\u001b[32Gprint('dups',[(k,v)\u001b[52Gfor\u001b[56Gk,v\u001b[60Gin\u001b[63Gc.items()\u001b[73Gif\u001b[76Gv>1][:10])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint([\u001b[12G(i,v)\u001b[18Gfor\u001b[22Gi,v\u001b[26Gin\u001b[29Genumerate(voc)\u001b[44Gif\u001b[47Gv.startswith(b'<0x')][:3],\u001b[74Gsum(v.startswith(b'<0x')\u001b[99Gfor\u001b[103Gv\u001b[105Gin\u001b[108Gvoc))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint([\u001b[12G(i,v)\u001b[18Gfor\u001b[22Gi,v\u001b[26Gin\u001b[29Genumerate(voc)\u001b[44Gif\u001b[47Gv.startswith(b'<0x')\u001b[68Gand\u001b[72Gnot\u001b[76G(len(v)==6\u001b[87Gand\u001b[91Gv.endswith(b'>'))])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint([\u001b[12G(i,v)\u001b[18Gfor\u001b[22Gi,v\u001b[26Gin\u001b[29Genumerate(voc)\u001b[44Gif\u001b[47Gb'\\x00'\u001b[55Gin\u001b[58Gv\u001b[60Gor\u001b[63Glen(v)==0])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(voc[:5])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[70.535, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G*\u001b[103G\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
