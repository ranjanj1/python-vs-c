[538.002, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mP4\u001b[6Gis\u001b[9Gimplemented\u001b[21Gin\u001b[24G\u001b[38;2;87;105;247mrun.py\u001b[31G\u001b[39mand\u001b[35Gpasses\u001b[42Gthe\u001b[46Gsupplied\u001b[55Gtests.\u001b[62GRun\u001b[66Git\u001b[69Gwith\u001b[74G\u001b[38;2;87;105;247mpython3 run.py model.bin tokenizer.bin\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTest results\r\u001b[1B\u001b[22m \u001b[3G- \u001b[38;2;87;105;247mpython3 check.py -- python3 run.py\u001b[39m \u2192\u001b[42G\u001b[1mPASS\u001b[22m, max logit error 9.8e-6 (tolerance 5e-4).\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mpython3 check.py --tokens 64 --prompts 3 -- python3 run.py\u001b[64G\u001b[39m\u2192\u001b[66G\u001b[1mPASS\u001b[22m,\u001b[72Gmax\u001b[76Gerror\u001b[82G2.4e-5.\r\u001b[2C\u001b[1B- My own tests\u001b[18Galso\u001b[23Gpassed:\r\u001b[2C\u001b[1B \u001b[5G- PIECE output matched every piece\u001b[40Gin the fixtures.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- FIXED's argmaxes matched GENERATE's output.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- Empty text, \u001b[38;2;87;105;247mGENERATE 0\u001b[39m and\u001b[34Ga\u001b[36G1016-token\u001b[47Gprompt\u001b[54Gbehaved\u001b[62Gas\u001b[65Gexpected.\u001b[75GThe\u001b[79Glong\u001b[84Gprompt\u001b[91Gstopped\u001b[99Gwith\u001b[104G\u001b[38;2;87;105;247mcontext\u001b[112G\u001b[39mafter\r\u001b[4C\u001b[1B \u001b[7Gexactly \u001b[16Ghe 9 new tok\u001b[29Gns the "]
[538.003, "reference would produce.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed:\u001b[22m roughly 85\u2013100 tokens/s\u001b[34Gfor generation and a\u001b[55Gout 1.4s to \u001b[38;2;87;105;247mREADY\u001b[39m once Numba's compile cache \u001b[101Gs warm (about 2.8s\r\u001b[2C\u001b[1Bon\u001b[6Gthe first run). Timings vari\u001b[35Gd a lot b\u001b[45Gt\u001b[47Geen identi\u001b[58Gal\u001b[61Gruns\u001b[66G(62\u2013104\u001b[74Gtokens/s),\u001b[85Gapparently\u001b[96Gbecause\u001b[104Gof\u001b[107Gother\u001b[113Gload\u001b[118Gon\r\u001b[2C\u001b[1Bthe\u001b[7Gmachine,\u001b[16Gso\u001b[19Gtreat\u001b[25Gthem\u001b[30Gas\u001b[33Grough.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mMatrix multiply:\u001b[22m each weight matrix\u001b[41Gis\u001b[44Gtransposed\u001b[55Gonce\u001b[60Gat\u001b[63Gload\u001b[68Gtime\u001b[73Gand\u001b[77Gthe\u001b[81Gloop\u001b[86Gruns\u001b[91Gover\u001b[96Gthe\u001b[100Goutputs.\u001b[109GThis\r\u001b[4C\u001b[1Bvectorizes\u001b[16Gwithout\u001b[24Gfastmath\u001b[33Gand\u001b[37Gadds\u001b[42Geach\u001b[47Goutput's\u001b[56Gterms\u001b[62Gin\u001b[65Gthe\u001b[69Gsame\u001b[74Gorder\u001b[80Gas\u001b[83G\u001b[38;2;87;105;247mmatmul\u001b[90G\u001b[39min\u001b[93G\u001b[38;2;87;105;247mrun.c\u001b[39m.\u001b[100GNo\u001b[103GBLAS,\u001b[109G\u001b[38;2;87;105;247mnp.dot\u001b[116G\u001b[39mor\u001b[119G\u001b[38;2;87;105;247m@\u001b[39m.\r\u001b[2C\u001b[1B- \u001b[1mKV cache"]
[538.004, ":\u001b[22m keys\u001b[20Gare\u001b[24Gstored\u001b[31Gtransposed\u001b[42Gper\u001b[46Ghead\u001b[51Gso\u001b[54Gattention\u001b[64Gscores\u001b[71Gvectorize\u001b[81Gwhile\u001b[87Gkeeping\u001b[95Gthe\u001b[99Greference's\u001b[111Gorder.\u001b[118GThe\r\u001b[2C\u001b[1B \u001b[5Gcache is cleared\u001b[22Gand pos\u001b[30Gtions restart\u001b[44Gat 0 f\u001b[51Gr every command.\u001b[68G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrecision:\u001b[16G\u001b[22mI c\u001b[20Gecked the compiled typ\u001b[43Gs and \u001b[50Ghe generated LLVM code.\u001b[74GEverything is float32, with no double\u001b[K\r\u001b[2C\u001b[1B \u001b[5Garithmetic, no\u001b[20Gfast-math flags and no threads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSame work as \u001b[38;2;87;105;247mrun.c\u001b[39m:\u001b[22m the classifi\u001b[38Gr runs at eve\u001b[52Gy positi\u001b[61Gn, including\u001b[74Gforced\u001b[81Gprompt\u001b[88Gtokens.\u001b[96GThe\u001b[100Gtokenizer\u001b[110Greproduces\r\u001b[2C\u001b[1B \u001b[5Gthe reference's encoding\u001b[30Gand decoding rules.\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitati\u001b[12Gns\u001b[15G(details in NOTES.md)\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gtransposed\u001b[20Gcopy\u001b[25Gof\u001b[28Gthe\u001b[32Gweights\u001b[40Gtakes\u001b[46Gabout\u001b[52G1\u001b[54GGB\u001b[57Gof\u001b[60Gmemory\u001b[67Gat\u001b[70Gpeak\u001b[75Gduring\u001b[82Gloading.\u001b[91GThat\u001b[96Gincludes"]
[538.005, "\u001b[105Gan\u001b[108Gextra\u001b[114G98\u001b[117GMB\r\u001b[2C\u001b[1B  for the classifier, which shares\u001b[38Gits\u001b[42Gweights\u001b[50Gwith\u001b[55Gthe\u001b[59Gembedding\u001b[69Gtable.\r\u001b[2C\u001b[1B-\u001b[5GNumba's\u001b[13Gcompile\u001b[21Gcache\u001b[27Gis\u001b[30Gwritten\u001b[38Gto\u001b[41G\u001b[38;2;87;105;247m__pycache__/\u001b[54G\u001b[39mnext\u001b[59Gto\u001b[62G\u001b[38;2;87;105;247mrun.py\u001b[39m.\u001b[70GWithout\u001b[78Git,\u001b[82Gstartup\u001b[90Gcompiles\u001b[99Gfor\u001b[103Ga\u001b[105Gfew\u001b[109Gseconds.\r\u001b[7C\u001b[1Bse prot\u001b[16Gcol\u001b[21Gases aren't defined in INTERFACE.md, so I chose:\u001b[70G\u001b[K\r\u001b[4C\u001b[1B- an empty piece prints \u001b[38;2;87;105;247mHEX \u001b[39m (tra\u001b[39Gling space, no byt\u001b[58Gs);\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- FIXED\u001b[13Gor LOGITS with more \u001b[34Gha\u001b[38G\u001b[38;2;87;105;247mseq\u001b[42Glen\u001b[39m ids processes \u001b[61Gnly the first \u001b[38;2;87;105;247mseq_len\u001b[39m;\u001b[K\r\u001b[2C\u001b[1B \u001b[5G-\u001b[40;1H\u001b[38;3H"]
[538.408, "\u001b[H\r\u001b[1B \u001b[3G\u001b[1mTest results\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mpython3 check.py -- python3 run.py\u001b[40G\u001b[39m\u2192\u001b[42G\u001b[1mPASS\u001b[22m,\u001b[48Gmax\u001b[52Glogit\u001b[58Gerror\u001b[64G9.8e-6\u001b[71G(tolerance\u001b[82G5e-4).\r\u001b[2C\u001b[1B- \u001b[38;2;87;105;247mpython3 check.py --tokens 64 --prompts 3 -- python3 run.py\u001b[64G\u001b[39m\u2192\u001b[66G\u001b[1mPASS\u001b[22m,\u001b[72Gmax\u001b[76Gerror\u001b[82G2.4e-5.\r\u001b[4C\u001b[1BMy own tests also passed:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- PIECE output matched every piece in the fixtures.\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- FIXED's argmaxes matched\u001b[32GGENERATE's\u001b[43Goutput.\r\u001b[6C\u001b[1BEmpty\u001b[13Gtext, \u001b[38;2;87;105;247mGENERATE 0\u001b[39m and\u001b[34Ga 1016-token\u001b[47Gprompt behaved\u001b[62Gas\u001b[65Gexpected.\u001b[75GThe\u001b[79Glong\u001b[84Gprompt\u001b[91Gstopped\u001b[99Gwith\u001b[104G\u001b[38;2;87;105;247mcontext\u001b[112G\u001b[39mafter\r\u001b[4C\u001b[1B \u001b[7Gexactly\u001b[15Gthe 9 new tokens\u001b[32Gthe reference would\u001b[52Gproduce.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed:\u001b[22m roughly 85\u2013100\u001b[31G/s fo\u001b[37G g\u001b[40Gn\u001b[42Gration and abo\u001b[57Gt 1.4s\u001b[64Gto\u001b[67G\u001b[38;2;87;105;247mREADY\u001b[73G\u001b[39monce\u001b[78GNumba's\u001b[86Gcompile\u001b[94Gcache\u001b[100Gis\u001b[103Gwarm\u001b["]
[538.41, "108G(about\u001b[115G2.8s\r\u001b[2C\u001b[1Bon\u001b[6Gthe\u001b[10Gfirst\u001b[16Grun).\u001b[22GTimings\u001b[30Gvaried\u001b[37Ga\u001b[39Glot\u001b[43Gbetween\u001b[51Gidentical\u001b[61Gruns\u001b[66G(62\u2013104\u001b[74Gtokens/s),\u001b[85Gapparently\u001b[96Gbecause\u001b[104Gof\u001b[107Gother\u001b[113Gload\u001b[118Gon\r\u001b[2C\u001b[1Bthe machine, so treat\u001b[26Ghem as rough.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works\u001b[16G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMatrix multiply:\u001b[22G\u001b[22meach\u001b[27Gweight\u001b[34Gmatrix\u001b[41Gis\u001b[44Gtransposed\u001b[55Gonce\u001b[60Gat\u001b[63Gload\u001b[68Gtime\u001b[73Gand\u001b[77Gthe\u001b[81Gloop\u001b[86Gruns\u001b[91Gover\u001b[96Gthe\u001b[100Goutputs.\u001b[109GThis\r\u001b[2C\u001b[1B  vectorizes\u001b[16Gwithout\u001b[24Gfastmath\u001b[33Gand\u001b[37Gadds\u001b[42Geach\u001b[47Goutput's\u001b[56Gterms\u001b[62Gin\u001b[65Gthe\u001b[69Gsame\u001b[74Gorder\u001b[80Gas\u001b[83G\u001b[38;2;87;105;247mmatmul\u001b[90G\u001b[39min\u001b[93G\u001b[38;2;87;105;247mrun.c\u001b[39m.\u001b[100GNo\u001b[103GBLAS,\u001b[109G\u001b[38;2;87;105;247mnp.dot\u001b[116G\u001b[39mor\u001b[119G\u001b[38;2;87;105;247m@\u001b[39m.\r\u001b[4C\u001b[1B\u001b[1mKV cache:\u001b[22m keys ar\u001b[23G stor\u001b[29Gd transposed per head \u001b[52Go attention scores vectoriz\u001b[81Gwhile keeping the reference's order.\u001b[118GThe\r\u001b[4C\u001b[1Bca\u001b[8Ghe \u001b[12Gs cleared and posi"]
[538.411, "\u001b[31Gions restart at\u001b[47G0 for every command.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mPre\u001b[9Gision:\u001b[22m I checked th\u001b[29G compiled types and the genera\u001b[60Ged LLVM code. Everything is float32, with no double\u001b[K\r\u001b[4C\u001b[1Barithmeti\u001b[15G, no fast-math flag\u001b[36Gand no threads.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mSame work as \u001b[38;2;87;105;247mrun.c\u001b[39m:\u001b[22m the class\u001b[35Gfier run\u001b[46Gt every position, including\u001b[74Gforced prompt\u001b[88Gtokens. The tokenizer reproduces\r\u001b[4C\u001b[1Bthe reference's encoding\u001b[30Gand deco\u001b[39Gi\u001b[41Gg\u001b[43Grul\u001b[47Gs.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (details in NOTES.md)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gtransposed\u001b[20Gcopy\u001b[25Gof\u001b[28Gthe\u001b[32Gweights\u001b[40Gtakes\u001b[46Gabout\u001b[52G1\u001b[54GGB\u001b[57Gof\u001b[60Gmemory\u001b[67Gat\u001b[70Gpeak\u001b[75Gduring\u001b[82Gloading.\u001b[91GThat\u001b[96Gincludes\u001b[105Gan\u001b[108Gextra\u001b[114G98\u001b[117GMB\r\u001b[2C\u001b[1B  for the classifier, which shares\u001b[38Gits\u001b[42Gweights\u001b[50Gwith\u001b[55Gthe\u001b[59Gembedding\u001b[69Gtable.\r\u001b[2C\u001b[1B-\u001b[5GNumba's\u001b[13Gcompile\u001b[21Gcache\u001b[27Gis\u001b[30Gwritten\u001b[38Gto\u001b[41G\u001b[38;2;87;105;247m__pycache__/\u001b[54G\u001b[39mnext\u001b[59Gto\u001b[62G\u001b[38;2;87;1"]
