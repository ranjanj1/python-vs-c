[439.223, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll edge cases check\u001b[24Gout,\u001b[29Gand\u001b[33Gthe\u001b[37Gcontext\u001b[45Gstop\u001b[50Gemits\u001b[56Gthe\u001b[60Gexpected\u001b[69Gtoken\u001b[75Gcount.\u001b[82GThroughput\u001b[93Gvaries\u001b[100Ga\u001b[102Glot\u001b[106Gbetween\u001b[114Gruns,\r\u001b[2C\u001b[1Bso\u001b[6Gmachine\u001b[14Gload\u001b[19Gis\u001b[22Glikely;\u001b[30GI'm\u001b[34Glooking\u001b[42Ginto\u001b[47Gthe\u001b[51G2.7s\u001b[56Gstartup\u001b[64Gnext.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -X importtime -c \"import numba\" 2>&1 | tail -1; python3 - <<'EOF'\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mimport time; t=time.time()\r\u001b[5C\u001b[1Bimport run; t1=time.time()\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mm = run.Model('model.bin'); t2=time.time()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mtk = run.Tokenizer('tokenizer.bin', m.vocab); t3=time.time()\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mm.forward(1,0); t4=time.time()\r\u001b[5C\u001b[1Bprint(f'import {t1-t:.2f} load {t2\u2026\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500"]
