[302.385, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat > scratch/timeit.py\u001b[28G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsubprocess,\u001b[23Gsys,\u001b[28Gtime\r\u001b[1B \u001b[2m\u2502\u001b[22m t0 =\u001b[9Gtime.time()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m p = subprocess.Popen([sys.executable,\u001b[42G'run.py',\u001b[52G'model.bin',\u001b[65G'tokenizer.bin'],\u001b[83Gstdin=subprocess.PIPE,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mstdout=subprocess.PIPE,\u001b[28Gtext=True,\u001b[39Gbufsize=1)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m assert p.stdout.readline().strip()\u001b[39G==\u001b[42G'READY'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('startup\u001b[19G%.2fs'\u001b[26G%\u001b[28G(time.time()\u001b[41G-\u001b[43Gt0))\r\u001b[1B \u001b[2m\u2502\u001b[22m for n in (64, 256, 1000):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     t\u001b[10G=\u001b[12Gtime.time();\u001b[25Gp.stdin.write(f'GENERATE\u001b[50G{n}\u001b[54GOnce\u001b[59Gupon\u001b[64Ga\u001b[66Gtime\\n'"]
[302.386, ");\u001b[76Gp.stdin.flush()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mk\u001b[10G=\u001b[12G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     while True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22ms\u001b[14G=\u001b[16Gp.stdout.readline()\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G    \u001b[12Gif s.startsw\u001b[25Gth('T '): k +=\u001b[40G1\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G  \u001b[10G  \u001b[13Glse: break\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mdt\u001b[11G=\u001b[13Gtime.time()\u001b[25G-\u001b[27Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(f'GENERATE\u001b[25G{n}:\u001b[30G{s.strip()}\u001b[42G{dt:.2f}s\u001b[53G{k/dt:.1f}\u001b[64Gtok/s')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp.stdin.write('QUIT\\n');\u001b[29Gp.stdin.flush();\u001b[46Gp.wait()\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 scratch/timeit.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command r"]
[302.387, "equires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 scratch/timeit.py\u001b[70G\u001b[22mcommands\u001b[79Gin\u001b[82G\u001b[1m/Users/agentlab/pvc/p4\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
