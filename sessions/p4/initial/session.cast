[439.772, "\u001b[H\r\u001b[2C\u001b[3B~70\u001b[7Gtok/s, 1.2s startup. Seeing if a different\u001b[50Gunroll factor helps \u001b[71Gn the real\u001b[82Gmatrix shapes:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m My helper \u001b[38;2;87;105;247mscratch/timeit.py\u001b[39m shadowed the stdlib \u001b[38;2;87;105;247mtimeit\u001b[39m module. Renaming it and\u001b[82Gre-running:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults match exactly across unroll factors. I'll use 2\u00d7 unroll\u001b[67Gfor\u001b[71Gthe\u001b[75Glayer\u001b[81Gmatrices\u001b[90G(~55\u001b[95GGB/s)\u001b[101Gand\u001b[105G4\u00d7\u001b[108Gfor\u001b[112Gthe\r\u001b[2C\u001b[1B32000-wide classifier, since each\u001b[37Gis\u001b[40Gfaster\u001b[47Gthere.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Throughput is\u001b[17Gup\u001b[20Gto\u001b[23Gabout\u001b[29G100\u001b[33Gtok/s\u001b[39Gand\u001b[43Gtests\u001b[49Gstill\u001b[55Gpass;\u001b[61Gsince\u001b[67Gthe\u001b[71Gthird\u001b[77Grun's\u001b[83Gdip\u001b[87Glooks\u001b[93Glike\u001b[98Gmachine\u001b[106Gnoise,\u001b[113GI'm\r\u001b[1"]
[439.773, "C\u001b[1B re-timing, then testing edge cases.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All edge cases check out, and\u001b[33Gthe\u001b[37Gcontext\u001b[45Gstop\u001b[50Gemits\u001b[56Gthe\u001b[60Gexpected\u001b[69Gtoken\u001b[75Gcount.\u001b[82GThroughput\u001b[93Gvaries\u001b[100Ga\u001b[102Glot\u001b[106Gbetween\u001b[114Gruns,\r\u001b[1C\u001b[1B so machine load is likely; I'm\u001b[34Glooking\u001b[42Ginto\u001b[47Gthe\u001b[51G2.7s\u001b[56Gstartup\u001b[64Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Profiling startup phases\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 -X importtime -c \"import numba\" 2>&1 | tail -1; python3 - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport time; t=time.time()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport run; t1=time.time()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mm = run.Model('model.bin'); t2=time.time()\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mtk = run.Tokenizer('tokenizer.bin', m.vocab); t3=time.time()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mm.forward(1,0); t4=time.time()\r\u001b[5C\u001b[1Bprint(f'import {t1-t:.2f"]
