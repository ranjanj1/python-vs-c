[268.774, "\u001b[H\r\u001b[30B\u001b[38;2;102;102;102m\u23fa\r\u001b[38C\u001b[3B\u001b[38;2;161;161;161mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[268.875, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2722\u001b[39G\u001b[38;2;157;157;157mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[268.991, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gtransposed axpy form is\u001b[31Gthe\u001b[35Gclear\u001b[41Gwinner\u001b[48Gat\u001b[51Gabout\u001b[57G48\u001b[60GGB/s\u001b[65Gand\u001b[69Gmatches\u001b[77Gthe\u001b[81Greference's\u001b[93Gerror.\u001b[100GI'm\u001b[104Gnow\u001b[108Gtiling\u001b[115Gthe\r\u001b[2C\u001b[1B32000-row\u001b[13Gclassifier\u001b[24Gand\u001b[28Gunrolling\u001b[38Gover\u001b[43Gj.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've settled the d\u001b[22Gsig\u001b[26G:\u001b[28Gweights st\u001b[39Gr\u001b[41Gd\u001b[43Gtransposed\u001b[54Gat\u001b[57Gload\u001b[62Gand\u001b[66Gcompiled\u001b[75Gas\u001b[78Gan\u001b[81Gunrolled\u001b[90Gaxpy,\u001b[96Gcached\u001b[103Gtransposed\u001b[114Gkeys,\r\u001b[2C\u001b[1Band\u001b[7Ga\u001b[9Gplain-Python\u001b[22Gtokenizer\u001b[32Gmirroring\u001b[42Gthe\u001b[46Greference.\u001b[57GWriting\u001b[65Grun.py\u001b[72Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m487\u001b[16G\u001b[22mlines to \u001b[1mrun.py\u001b[22m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3"]
[268.993, "\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  3 \u001b[22m\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to\u001b[32Ghold arrays (load, reshap\u001b[58G/transpose copi\u001b[74Gs, writing l\u001b[87Ggits).\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10"]
[268.993, "\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes\u001b[22Gon\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[2C\u001b[1Bprompts,\u001b[12G64\u001b[15Gtokens.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
[269.022, "\u001b[H\r\u001b[26C\u001b[33B\u001b[38;2;102;102;102m6\u001b[39G\u001b[38;2;153;153;153mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[269.083, "\u001b]0;\u25d1 Claude Code\u0007"]
[269.109, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[39m\u001b[40;1H\u001b[38;3H"]
[269.227, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[39m\u001b[40;1H\u001b[38;3H"]
[269.329, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u273b\u001b[27G\u001b[38;2;102;102;102m7\u001b[39G\u001b[38;2;157;157;157mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[269.388, "\u001b[H\r\u001b[31B\u001b[38;2;102;102;102m \u001b[39m\u001b[40;1H\u001b[38;3H"]
[269.434, "\u001b]0;\u2733 Claude Code\u0007"]
[269.44, "\u001b[H\r\u001b[2B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m487\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mrun.py\r\u001b[1B\u001b[22m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  3 \r\u001b[2C\u001b[1B\u001b[22m\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[5C\u001b[1B\u001b[2m  5 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads"]
[269.441, ".\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to hold arrays (load, reshape/transpose copies, writing logits).\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\u001b[22G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check\u001b[15Gpasses\u001b[22Gon\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[2C\u001b[1Bprompts, 64 tokens.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time python3 check.py --tokens 64 --prompts 3 -- python3 run.py\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[269.442, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mRun full validation check\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mtime \u001b[8Gython3\u001b[15Gcheck.py\u001b[24G--tokens\u001b[33G64\u001b[36G--prompts\u001b[46G3\u001b[48G--\u001b[51Gpython3\u001b[59Grun.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[269.443, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gtime\u001b[42Gpython3\u001b[50Gcheck.py\u001b[59G--tokens\u001b[68G64\u001b[71G--prompts\u001b[81G3\u001b[83G--\u001b[86Gpython3\u001b[94Grun.py\u001b[103G\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
[269.451, "\u001b[H\r\u001b[10C\u001b[21Bfull validation check\u001b[40;1H\u001b[35;2H"]
[269.997, "\u001b[H\r\u001b[21B\u001b[38;2;102;102;102m\u23fa\u001b[39m\u001b[40;1H\u001b[35;2H"]
[270.002, "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
[270.017, "\u001b]0;\u25d1 Claude Code\u0007"]
[270.025, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The transposed axpy form is the\u001b[35Gclear\u001b[41Gwinner\u001b[48Gat\u001b[51Gabout\u001b[57G48\u001b[60GGB/s\u001b[65Gand\u001b[69Gmatches\u001b[77Gthe\u001b[81Greference's\u001b[93Gerror.\u001b[100GI'm\u001b[104Gnow\u001b[108Gtiling\u001b[115Gthe\r\u001b[2C\u001b[1B32000-row classifier and unrolling\u001b[38Gover\u001b[43Gj.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've settled\u001b[16Gthe\u001b[20Gdesign:\u001b[28Gweights\u001b[36Gstored\u001b[43Gtransposed\u001b[54Gat\u001b[57Gload\u001b[62Gand\u001b[66Gcompiled\u001b[75Gas\u001b[78Gan\u001b[81Gunrolled\u001b[90Gaxpy,\u001b[96Gcached\u001b[103Gtransposed\u001b[114Gkeys,\r\u001b[2C\u001b[1Band a plain-Python tokenizer mirroring the reference. Writing run.py next.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m487\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mrun.py\r\u001b[6C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m 1\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\""]
[270.026, "\"P4 port of reference/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  3 \r\u001b[2C\u001b[1B\u001b[22m\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[5C\u001b[1B\u001b[2m  5 \r\u001b[1B\u001b[22m\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\u001b[101G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22mon float32 NumPy arrays. No BLAS (no np.dot / @), no fastmath, no parallel/threads.\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to hold arrays (load, reshape/transpose copies, writing logits).\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  9 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\u001b[39m\u001b"]
[270.028, "[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Quick check passes on the\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[1B  prompts, 64 tokens.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running full validation check\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ time python3 check.py --tokens 64 --prompts 3 -- python3 run.py\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[39m \u001b[38;2;219;123;91mHashing\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(4m 15s \u00b7 \u2193\u001b[39m \u001b[38;2;102;102;102m25.8k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G    \u001b[37G    \u001b[42G       \u001b[50G        \u001b[59G        \u001b[68G  \u001b[71G         \u001b[81G \u001b[83G  \u001b[86G       \u001b[94G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m"]
