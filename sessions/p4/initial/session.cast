[337.922, "\u001b[H\u001b[6G\u001b[38;2;51;51;51m\u001b[2m 10 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +477 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes on\u001b[25Gthe\u001b[29Gfirst\u001b[35Grun\u001b[39G(max\u001b[44Glogit\u001b[50Gerror\u001b[56G~1e-5\u001b[62Gagainst\u001b[70Ga\u001b[72G5e-4\u001b[77Gtolerance).\u001b[89GRunning\u001b[97Gthe\u001b[101Gfull\u001b[106Gcheck:\u001b[113Gall\r\u001b[2C\u001b[1Bprompts,\u001b[12G64\u001b[15Gtokens.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll checks pass. Now\u001b[24GI'll\u001b[29Gconfirm\u001b[37Gthat\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[2C\u001b[1Bspeed.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe only float64 entries\u001b[28Gare\u001b[32Gliteral\u001b[40Gconstants\u001b[50Ginside\u001b[57G\u001b[38;2;87;105;247mF32(...)\u001b[66G\u001b[39mcasts.\u001b[73GRe-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b["]
[337.924, "116Gsee\r\u001b[2C\u001b[1Ball\u001b[7Gof\u001b[10Gthem\u001b[15Gplus\u001b[20Gthe\u001b[24GLLVM\u001b[29GIR:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything is float32 with no fastmath flags,\u001b[49Gand\u001b[53Gthe\u001b[57Ghot\u001b[61Gloops\u001b[67Gare\u001b[71Gvectorized.\u001b[83GNow\u001b[87Gtiming\u001b[94Gstartup\u001b[102Gand\u001b[106Gper-token\r\u001b[2C\u001b[1Bthroughput:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m~70 tok/s, 1.2s startup. Seeing\u001b[35Gif\u001b[38Ga\u001b[40Gdifferent\u001b[50Gunroll\u001b[57Gfactor\u001b[64Ghelps\u001b[70Gon\u001b[73Gthe\u001b[77Greal\u001b[82Gmatrix\u001b[89Gshapes:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMy\u001b[6Ghelper\u001b[13G\u001b[38;2;87;105;247mscratch/timeit.py\u001b[31G\u001b[39mshadowed\u001b[40Gthe\u001b[44Gstdlib\u001b[51G\u001b[38;2;87;105;247mtimeit\u001b[58G\u001b[39mmodule.\u001b[66GRenaming\u001b[75Git\u001b[78Gand\u001b[82Gre-running:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[2C\u001b[2B\u001b[38;2;215;119;87mHash"]
