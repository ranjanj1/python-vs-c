[273.085, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gtransposed\u001b[18Gaxpy\u001b[23Gform\u001b[28Gis\u001b[31Gthe\u001b[35Gclear\u001b[41Gwinner\u001b[48Gat\u001b[51Gabout\u001b[57G48\u001b[60GGB/s\u001b[65Gand\u001b[69Gmatches\u001b[77Gthe\u001b[81Greference's\u001b[93Gerror.\u001b[100GI'm\u001b[104Gnow\u001b[108Gtiling\u001b[115Gthe\r\u001b[1B \u001b[3G32000-row classifier and\u001b[28Gunrolling over j.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mI've\u001b[8Gsettled\u001b[16Gthe\u001b[20Gdesign:\u001b[28Gweights\u001b[36Gstored\u001b[43Gtransposed\u001b[54Gat\u001b[57Gload\u001b[62Gand\u001b[66Gcompiled\u001b[75Gas\u001b[78Gan\u001b[81Gunrolled\u001b[90Gaxpy,\u001b[96Gcached\u001b[103Gtransposed\u001b[114Gkeys,\r\u001b[1B \u001b[3Gand a plain-Python tokeniz\u001b[30Gr mirroring the refer\u001b[52Gnce.\u001b[57GWriting run.\u001b[70Gy next.\u001b[78G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mWrite\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m487\u001b[22m lines\u001b[22Gto\u001b[25G\u001b[1mrun.py\r\u001b[1B\u001b[22m     \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P4 port of refere"]
[273.086, "nce/run.c (llama2.c): Numba nopython kernels on float32 arrays.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m INTERFACE.md.\r\u001b[7C\u001b[1B\u001b[2m5\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22mCompute: every arithmetic loop of the forward \u001b[38;2;167;29;93mpass\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m an @njit (nopython) function working\r\u001b[7C\u001b[1B\u001b[2m7\u001b[10G\u001b[22mon float32 NumPy arrays. No BLAS (no np.dot /\u001b[56G@), no f\u001b[65Gstmath,\u001b[73Gno \u001b[77Garallel/threads.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m8\u001b[10G\u001b[22mNumPy \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m used only to hold arrays (load, reshape/transpose copies, w\u001b[79Giting logits)\r\u001b[7C\u001b[1B\u001b[2m9\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m10\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\r\u001b[5C\u001b[1B\u001b[38;2;102;102;"]
