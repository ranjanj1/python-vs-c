[453.48, "m python3 - <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gtime,\u001b[17Gnumpy\u001b[23Gas\u001b[26Gnp,\u001b[30Grun\r\u001b[1B \u001b[2m\u2502\u001b[22m from numba import njit\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m@njit(boundscheck=False)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def tr(dst, src, B):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mL,\u001b[11Gd,\u001b[14Gn\u001b[16G=\u001b[18Gsrc.shape\r\u001b[1B \u001b[2m\u2502\u001b[22m     for l in\u001b[17Grange(L):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         s\u001b[14G= src[l]; t\u001b[26G= dst[l]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gi0\u001b[19Gin\u001b[22Grange(0,\u001b[31Gd,\u001b[34GB):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             i1 = min(i0\u001b[28G+\u001b[30GB,\u001b[33Gd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mfor\u001b[20Gj0\u001b[23Gin\u001b[26Grange(0,\u001b[35Gn,\u001b[38GB):\r\u001b[1B \u001b[2m\u2502\u001b[22m          \u001b[14G  \u001b[17G  \u001b[20Gj1\u001b[23G= min(j\u001b[31G + B, n)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m          \u001b[14G    \u001b[19G for i in range(i0,\u001b[39Gi1):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[24G\u001b[22mfor\u001b[28Gj\u001b[30Gin\u001b[33Grange(j0,\u001b[43Gj1):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                    \u001b[28Gt[j,\u001b[33Gi]\u001b[36G=\u001b[38Gs[i,\u001b[43Gj]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt=time.time();\u001b[19Ga\u001b[21G=\u001b[23Gnp.fromfile('model.bin',\u001b[48Gdtype='<f4',\u001b[61Goffset=28);\u001b[73Gpri"]
[453.481, "nt('fromfile\u001b[89G%.2f'\u001b[95G%\u001b[97G(time.time()-t))\r\u001b[1B \u001b[2m\u2502\u001b[22m src = a[32000*768+12*768:][:12*2048*768].reshape(12, 2048, 768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m dst = np.empty((12, 768, 2048), np.float32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtr(dst,\u001b[12Gsrc,\u001b[17G64)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for B in (16, 32, 64,\u001b[26G128):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mt=time.time();\u001b[23Gtr(dst,\u001b[31Gsrc,\u001b[36GB);\u001b[40Gprint(B,\u001b[49G'%.3f'\u001b[56G%\u001b[58G(time.time()-t))\r\u001b[1B \u001b[2m\u2502\u001b[22m t=time.time(); np.asco\u001b[27Gtiguousarray(src.transpose(0,2,1)); print('numpy %.3f' % (tim\u001b[89G.time()-t))\u001b[101G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you wan"]
