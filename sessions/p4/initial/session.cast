[538.572, "\u001b[H\u001b[5G\u001b[38;2;87;105;247mpython3 check.py --tokens 64 --prompts 3 -- python3 run.py\u001b[64G\u001b[39m\u2192\u001b[66G\u001b[1mPASS\u001b[22m,\u001b[72Gmax\u001b[76Gerror\u001b[82G2.4e-5.\r\u001b[2C\u001b[1B-\u001b[5GMy own tes\u001b[16Gs also passed:\u001b[K\r\u001b[6C\u001b[1BP\u001b[9GECE output matched every piece in\u001b[43Gthe fixtures.\r\u001b[6C\u001b[1BFIXED's argmaxes matched GENERATE's output.\u001b[K\r\u001b[4C\u001b[1B-\u001b[7GEmpty text,\u001b[19G\u001b[38;2;87;105;247mGENERATE 0\u001b[39m and a\u001b[36G1016-tok\u001b[45Gn prompt behaved\u001b[62Gas\u001b[65Gexpected.\u001b[75GThe\u001b[79Glong\u001b[84Gprompt\u001b[91Gstopped\u001b[99Gwith\u001b[104G\u001b[38;2;87;105;247mcontext\u001b[112G\u001b[39mafter\r\u001b[6C\u001b[1Bexactly\u001b[15Gthe\u001b[19G9\u001b[21Gnew\u001b[25Gtokens\u001b[32Gthe\u001b[36Greference\u001b[46Gwould\u001b[52Gproduce.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mSpeed:\u001b[10G\u001b[22mroughly 85\u2013100 tokens/s for generation and about 1.4s to \u001b[38;2;87;105;247mREADY\u001b[39m once Numba's compile cache i\u001b[102G warm (about 2.8s\u001b[K\r\u001b[2C\u001b[1Bon the f\u001b[12Grst\u001b[16Grun). Timings\u001b[30Gvaried a lot\u001b[43Gbetween\u001b[51Gidentical\u001b[61Gruns\u001b[66G(62\u2013104\u001b[74Gtokens/s),\u001b[85Gapparently\u001b[96Gbecause\u001b[104Gof\u001b[107Gother\u001b[113Gload\u001b[118Gon\r\u001b[2C\u001b[1Bthe\u001b[7Gmachine,\u001b[16"]
[538.572, "Gso\u001b[19Gtreat\u001b[25Gthem\u001b[30Gas\u001b[33Grough.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mHow it works\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMatrix multiply:\u001b[22m each weig\u001b[32Gt matrix is transposed once at load time and the loop runs over the\u001b[100Goutputs.\u001b[109GThis\u001b[K\r\u001b[2C\u001b[1B \u001b[5Gvectorizes without\u001b[24Gfastmath \u001b[35Gd adds\u001b[42Geach output's \u001b[58Grms in the \u001b[70Gam\u001b[73G order as \u001b[38;2;87;105;247mmatmul\u001b[39m in \u001b[38;2;87;105;247mrun.c\u001b[39m. No BLAS, \u001b[38;2;87;105;247mnp.dot\u001b[39m or \u001b[38;2;87;105;247m@\u001b[39m.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m k\u001b[17Gys are stored transpo\u001b[39Ged per head so attention scores\u001b[71Gvectorize\u001b[81Gwhile\u001b[87Gkeeping\u001b[95Gthe\u001b[99Greference's\u001b[111Gorder.\u001b[118GThe\r\u001b[2C\u001b[1B \u001b[5Gcache is cleared an\u001b[26Gpositions res\u001b[40Gart at 0\u001b[49Gfor\u001b[53Gevery command.\u001b[68G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mPrecision:\u001b[22m I checked the\u001b[30Gcompiled types and the\u001b[53Ggenerated\u001b[63GLLVM\u001b[68Gcode.\u001b[74GEverything\u001b[85Gis\u001b[88Gfloat32,\u001b[97Gwith\u001b[102Gno\u001b[105Gdouble\r\u001b[2C\u001b[1B \u001b[5Garithmetic, no fast-math flags and\u001b[40Gno threads.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSame work as \u001b["]
[538.573, "38;2;87;105;247mrun.c\u001b[39m:\u001b[22m the classifier runs at every\u001b[54Gposition,\u001b[64Gincluding\u001b[74Gforced\u001b[81Gprompt\u001b[88Gtokens.\u001b[96GThe\u001b[100Gtokenizer\u001b[110Greproduces\r\u001b[4C\u001b[1Bthe\u001b[9Greference's\u001b[21Gencoding\u001b[30Gand\u001b[34Gdecoding\u001b[43Grules.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (details in NOTES.md)\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[10Granspo\u001b[17Ged copy\u001b[25Gof t\u001b[30Ge weights tak\u001b[44Gs about 1 GB of \u001b[61Gemory at peak during\u001b[82Gloading.\u001b[91GThat\u001b[96Gincludes\u001b[105Gan\u001b[108Gextra\u001b[114G98\u001b[117GMB\r\u001b[2C\u001b[1B \u001b[5Gfor the\u001b[14Glassifier, wh\u001b[28Gch shar\u001b[36Gs\u001b[38Gits weights with the\u001b[59Gembedding table.\u001b[K\r\u001b[4C\u001b[1BNumba's compi\u001b[19Ge cache is written to\u001b[41G\u001b[38;2;87;105;247m__pycache__/\u001b[39m next to \u001b[38;2;87;105;247mrun.py\u001b[39m.\u001b[70GWithout\u001b[78Git,\u001b[82Gstartup\u001b[90Gcompiles\u001b[99Gfor\u001b[103Ga\u001b[105Gfew\u001b[109Gseconds.\r\u001b[2C\u001b[1B-\u001b[5GThese protocol cases aren't defined in\u001b[44GINTERFACE.md, \u001b[59Go I\u001b[63Gchose:\r\u001b[6C\u001b[1Ban empty\u001b[16Gpiece pr\u001b[25Gnts \u001b[38;2;87;105;247mHEX \u001b[39m (trailing space, n\u001b[53G byt\u001b[59G);\u001b[K\r\u001b[6C\u001b[1BFIXED or LOGITS wit\u001b[2"]
[538.573, "7G more\u001b[33Gthan \u001b[38;2;87;105;247mseq_len\u001b[39m ids processes only the\u001b[69Gfirst\u001b[75G\u001b[38;2;87;105;247mseq_len\u001b[39m;\r\u001b[6C\u001b[1Bif \u001b[38;2;87;105;247mmax\u001b[39m and \u001b[38;2;87;105;247mcontext\u001b[39m happen on the\u001b[40Gsame\u001b[45Gtoken,\u001b[52Git\u001b[55Greports\u001b[63G\u001b[38;2;87;105;247mmax\u001b[39m;\r\u001b[4C\u001b[1B-\u001b[7Gtoken\u001b[13Gids\u001b[17Gare\u001b[21Gnot\u001b[25Grange-checked.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BNOTES.md has the commands I ran and t\u001b[41Gese limitations.\u001b[58GThe benchmark\u001b[72Gand\u001b[76Gtest\u001b[81Ghelpers\u001b[89GI\u001b[91Gwrote\u001b[97Gare\u001b[101Gin\u001b[104G\u001b[38;2;87;105;247mscratch/\u001b[39m;\u001b[114G\u001b[38;2;87;105;247mrun.py\r\u001b[2C\u001b[1B\u001b[39mdoesn't\u001b[11Guse\u001b[15Gthem.\u001b[21GI\u001b[23Gdidn't\u001b[30Gtouch\u001b[36Gthe\u001b[40Gharness,\u001b[49Gfixtures\u001b[58Gor\u001b[61Grules.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mWorked for 8m 38s \u00b7\u001b[23Gdone 3:11 PM\u001b[39m\u001b[K\r\u001b[3B\u276f\u00a0\r\u001b[21C\u001b[2B\u001b[38;2;102;102;102m? for shortcuts\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
