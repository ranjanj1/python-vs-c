[325.58, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All\u001b[7Gchecks\u001b[14Gpass.\u001b[20GNow I'll\u001b[29Gconfirm\u001b[37Gthat\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[1C\u001b[1B speed.\u001b[12G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gonly float64 entries\u001b[28Gare\u001b[32Gliteral\u001b[40Gconstants\u001b[50Ginside\u001b[57G\u001b[38;2;87;105;247mF32(...)\u001b[66G\u001b[39mcasts.\u001b[73GRe-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b[116Gsee\r\u001b[1C\u001b[1B all\u001b[7Gof\u001b[10Gthem\u001b[15Gplus the LLVM IR:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything is float32\u001b[25Gw\u001b[27Gth \u001b[31Go fastma\u001b[40Gh\u001b[42Gflags, and the hot loops are vectorized. Now timing\u001b[94Gstartup\u001b[102Gand\u001b[106Gper-token\r\u001b[1C\u001b[1B throughput:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b["]
[325.581, "39m ~70\u001b[7Gtok/s, 1\u001b[16G2s st\u001b[23Gtup. Seei\u001b[33Gg if a different unroll factor helps on\u001b[73Gthe\u001b[77Greal\u001b[82Gmatrix\u001b[89Gshapes:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Comparing unroll\u001b[20Gfactors on\u001b[31Greal shapes\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > scratch/bench_unroll.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport numpy as np, time\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mfrom numba import njit\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mF32 = np.float32\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mimport run\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m@njit(boundscheck=False)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mdef mm8(out, x, wt):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mn = wt.shape[0]; d = wt.shape[1]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mfor i in range(d): out[i] = F32(0.0)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mj = 0\u001b[12G\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mwhile j + 8 <= n:\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mx0=x[j];x1=x[j+1];x2=x[j+2];x3=x[j+3];x4=x[\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u273d\u001b[39m \u001b[38"]
