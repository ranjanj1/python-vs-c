[438.885, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gonly\u001b[12Gfloat64\u001b[20Gentries\u001b[28Gare\u001b[32Gliteral\u001b[40Gconstants\u001b[50Ginside\u001b[57G\u001b[38;2;87;105;247mF32(...)\u001b[66G\u001b[39mcasts.\u001b[73GRe-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b[116Gsee\r\u001b[2C\u001b[1Ball\u001b[7Gof\u001b[10Gthem\u001b[15Gplus\u001b[20Gthe\u001b[24GLLVM\u001b[29GIR:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEveryt\u001b[10Ging is\u001b[17Gfloat32\u001b[25Gwith\u001b[30Gno\u001b[33Gfastmath\u001b[42Gflags,\u001b[49Gand\u001b[53Gthe\u001b[57Ghot\u001b[61Gloops\u001b[67Gare\u001b[71Gvectorized.\u001b[83GNow\u001b[87Gtiming\u001b[94Gstartup\u001b[102Gand\u001b[106Gper-token\r\u001b[2C\u001b[1Bthroughput:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m~70\u001b[7Gtok/s,\u001b[14G1.2s\u001b[19Gstartup.\u001b[28GSeeing\u001b[35Gif\u001b[38Ga\u001b[40Gdifferent\u001b[50Gunroll\u001b[57Gfactor\u001b[64Ghelps\u001b[70Gon\u001b[73Gthe\u001b[77Greal\u001b[82Gmatrix\u001b[89Gshapes:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMy\u001b[6Ghelper\u001b[13G\u001b[38;2;87;105;247m"]
[438.886, "scratch/timeit.py\u001b[31G\u001b[39mshadowed\u001b[40Gthe\u001b[44Gstdlib\u001b[51G\u001b[38;2;87;105;247mtimeit\u001b[58G\u001b[39mmodule.\u001b[66GRenaming\u001b[75Git\u001b[78Gand\u001b[82Gre-running:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults mat\u001b[15Gh exactly across\u001b[32Gunroll factors. I'll use\u001b[57G2\u00d7\u001b[60Gunroll\u001b[67Gfor\u001b[71Gthe\u001b[75Glayer\u001b[81Gmatrices\u001b[90G(~55\u001b[95GGB/s)\u001b[101Gand\u001b[105G4\u00d7\u001b[108Gfor\u001b[112Gthe\r\u001b[2C\u001b[1B32000-wide\u001b[14Gclassifier,\u001b[26Gsince\u001b[32Geach\u001b[37Gis\u001b[40Gfaster\u001b[47Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThroughput\u001b[14Gis up to about 100 tok/s\u001b[39Gand\u001b[43Gtests\u001b[49Gstill\u001b[55Gpass;\u001b[61Gsince\u001b[67Gthe\u001b[71Gthird\u001b[77Grun's\u001b[83Gdip\u001b[87Glooks\u001b[93Glike\u001b[98Gmachine\u001b[106Gnoise,\u001b[113GI'm\r\u001b[2C\u001b[1Bre-timing,\u001b[14Gthen\u001b[19Gtesting\u001b[27Gedge\u001b[32Gcases.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comm\u001b[20Gnd \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll edge cases check out, and the context\u001b[45Gs"]
