[152.57, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[16G\u001b[22mxj\u001b[19G=\u001b[21Gx[j]\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[12G    for i in range(i0,\u001b[35Gi1):\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[12G        out[i] += wt[j, i]*xj\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[12G    j +=\u001b[21G1\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[4G\u001b[22mdef\u001b[8Grun(f,\u001b[15Gargs,\u001b[21GR=30):\r\u001b[1B \u001b[2m\u2502\u001b[22m     f(*args)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     best = 1e9\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     for _ in range(3):\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         t = time.perf_counter()\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         for _ in range(R): f(*args)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbest\u001b[17G=\u001b[19Gmin(best,\u001b[29G(time.perf_counter()-t)/R)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     return best\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1B\u001b[22m \u001b[2m\u2502\u001b[22m for n, d\u001b[13Gin [(768, 768), (768, 2048), (2048, 768), (768,\u001b[61G32000)]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G rng = np.random.defaul\u001b[31G_rng(0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mw2\u001b[11G=\u001b[13G(rng.standard_normal(n*d).astype(np.float32)*np.float32(0.02)).reshape(d,\u001b[87Gn)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     x = rng.standard_normal(n).astype(np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mwt\u001b[1"]
[152.571, "1G=\u001b[13Gnp.ascontiguousarray(w2.T)\r\u001b[1B \u001b[2m\u2502\u001b[22m     out = np.zeros(d, np.float32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G base = None\u001b[20G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gname,\u001b[18Gf,\u001b[21Gextra\u001b[27Gin\u001b[30G[(\"axpy1\",\u001b[41Gaxpy1,\u001b[48G()),\u001b[53G(\"axpy4\",\u001b[63Gaxpy4,\u001b[70G()),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                    \u001b[31G(\"axpy4_T512\",\u001b[46Gaxpy4_tiled,\u001b[59G(512,)),\u001b[68G(\"axpy4_T1024\",\u001b[84Gaxpy4_tiled,\u001b[97G(1024,)),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m(\"axpy4_T2048\",\u001b[20Gaxpy4_tiled,\u001b[33G(2048,)),\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G          \u001b[18G    \u001b[23G    \u001b[28G  \u001b[31G(\"axpy8_T1024\", axpy8_tiled,\u001b[60G(1024,)), (\"axpy8_T2048\", axpy8_tiled, (2048,))]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         dt = run(f,\u001b[24G(out, x, wt, n, d)\u001b[43G+ extra)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gbase\u001b[20Gis\u001b[23GNone:\u001b[29Gbase\u001b[34G=\u001b[36Gout.copy()\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G print(f\"{n}x{\u001b[26G}\u001b[28G{name:12s}\u001b[39G{dt*1e3:7.3f}\u001b[53Gms\u001b[56G{n*d*4/dt/1e9:6.1f}\u001b[76GGB/s\u001b[81Gsame={np.array_equal(out,\u001b[107Gbase)}\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mcd\u001b[7G/Users/"]
