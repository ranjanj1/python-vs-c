[383.73, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Everything is floa\u001b[22G32 with no\u001b[33Gfastmath\u001b[42Gflags,\u001b[49Gand\u001b[53Gthe\u001b[57Ghot\u001b[61Gloops\u001b[67Gare\u001b[71Gvectorized.\u001b[83GNow\u001b[87Gtiming\u001b[94Gstartup\u001b[102Gand\u001b[106Gper-token\r\u001b[1C\u001b[1B th\u001b[6Goughput:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m ~70 tok/s, 1.2s star\u001b[24Gup. Seeing if a different\u001b[50Gunroll factor helps on\u001b[73Gthe real\u001b[82Gmatrix\u001b[89Gshapes:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m My help\u001b[11Gr \u001b[38;2;87;105;247mscratch/timeit.py\u001b[39m shadowed the\u001b[44Gstdlib\u001b[51G\u001b[38;2;87;105;247mtimeit\u001b[58G\u001b[39mmodule.\u001b[66GRenaming\u001b[75Git\u001b[78Gand\u001b[82Gre-running:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Results\u001b[11Gmatch exactly a\u001b[27Gros\u001b[31G unroll factors. I'll\u001b[53Guse 2"]
[383.731, "\u00d7\u001b[60Gunroll\u001b[67Gfor\u001b[71Gthe\u001b[75Glayer\u001b[81Gmatrices\u001b[90G(~55\u001b[95GGB/s)\u001b[101Gand\u001b[105G4\u00d7\u001b[108Gfor\u001b[112Gthe\r\u001b[1C\u001b[1B 32000-wide classifier,\u001b[26Gsince each is faster\u001b[47Gthere.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Throughput is up to about 100 tok/s and tests\u001b[49Gstill\u001b[55Gpass;\u001b[61Gsince\u001b[67Gthe\u001b[71Gthird\u001b[77Grun's\u001b[83Gdip\u001b[87Glooks\u001b[93Glike\u001b[98Gmachine\u001b[106Gnoise,\u001b[113GI'm\r\u001b[1C\u001b[1B re-tim\u001b[10Gng, th\u001b[17Gn testing\u001b[27Gedge cases.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Re-time and test protocol edge cases\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 scratch/speed.py; cat > scratch/edge.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport subprocess, sys, json, time\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mfx = json.load(open('fixtures.json'))\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mp = subprocess.Popen([sys.executable, 'run.py', 'model.bin', 'tokenizer.bin'], stdin=subprocess.PIPE, \u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mstdout=sub"]
