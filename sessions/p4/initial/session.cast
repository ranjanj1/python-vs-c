[439.224, "\"\u001b[44G2>&1\u001b[49G|\u001b[51Gtail\u001b[56G-1;\u001b[60Gpython3\u001b[68G-\u001b[70G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import time; t=time.time()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Grun;\u001b[16Gt1=time.time()\r\u001b[1B \u001b[2m\u2502\u001b[22m m = run.Model('model.bin'); t2=time.time()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m tk = run.Tok\u001b[18Giz\u001b[21Gr('tok\u001b[28Gnizer.bin',\u001b[40Gm.vocab);\u001b[50Gt3=time.time()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm.forward(1,0);\u001b[20Gt4=time.time()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print(f'import {t1-t:.2f}\u001b[30Gload\u001b[35G{t2-t1:.2f}\u001b[47Gtok\u001b[51G{t3-t2:.2f}\u001b[63Gfirst\u001b[69Gfwd\u001b[73G{t4-t3:.2f}')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m \u001b[5Gs\u001b[7G__pycach\u001b[16G__ | head\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15"]
