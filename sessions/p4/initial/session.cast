[328.597, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gchecks\u001b[14Gpass.\u001b[20GNow\u001b[24GI'll\u001b[29Gconfirm\u001b[37Gthat\u001b[42Gnothing\u001b[50Gin\u001b[53Gthe\u001b[57Gkernels\u001b[65Gsilently\u001b[74Gpromotes\u001b[83Gto\u001b[86Gfloat64\u001b[94G(rule\u001b[100G5),\u001b[104Gand\u001b[108Gmeasure\r\u001b[1B \u001b[3Gspeed.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gonly\u001b[12Gfloat64\u001b[20Gentries\u001b[28Gare\u001b[32Gliteral\u001b[40Gconstants\u001b[50Ginside\u001b[57G\u001b[38;2;87;105;247mF32(...)\u001b[66G\u001b[39mcasts.\u001b[73GRe-checking\u001b[85Gwith\u001b[90Gcaching\u001b[98Gdisabled\u001b[107Gso\u001b[110GI\u001b[112Gcan\u001b[116Gsee\r\u001b[1B \u001b[3Gall\u001b[8Gf them plus\u001b[20Gthe LLVM IR:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEverything\u001b[14Gis\u001b[17Gfloat32\u001b[25Gwith\u001b[30Gno\u001b[33Gfastmath\u001b[42Gflags,\u001b[49Gand\u001b[53Gthe\u001b[57Ghot\u001b[61Gloops\u001b[67Gare\u001b[71Gvectorized.\u001b[83GNow\u001b[87Gtiming\u001b[94Gstartup\u001b[102Gand\u001b[106Gper-token\r\u001b[1B \u001b[3Gthroug\u001b[10Gput:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K"]
[328.599, "\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m~70\u001b[7Gtok/s,\u001b[14G1.2s\u001b[19Gstartup.\u001b[28GSeeing\u001b[35Gif\u001b[38Ga\u001b[40Gdifferent\u001b[50Gunroll\u001b[57Gfactor\u001b[64Ghelps\u001b[70Gon\u001b[73Gthe\u001b[77Greal\u001b[82Gmatrix\u001b[89Gshapes:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mComparing\u001b[13Gunroll\u001b[20Gfactors\u001b[28Gon\u001b[31Greal\u001b[36Gshapes\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1B  \u23bf  $ cat > scratch/bench_unroll.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport numpy as np, time\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfrom numba import njit\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mF32 = np.float32\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mimport run\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m@njit(bo\u001b[16Gdscheck=False)\r\u001b[5C\u001b[1Bdef mm8(out, x, wt):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mn =\u001b[10Gwt.shape[0]; d = wt.shape[1]\r\u001b[5C\u001b[1Bfor\u001b[10Gi in range(d):\u001b[25Gout[i] = F32(0.0)\r\u001b[5C\u001b[1Bj =\u001b[10G0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mwhile j + 8 <= n:\r\u001b[5C\u001b[1Bx0=x[j];x1=x[j+1];x2=x[j+2];x3=x[j+3];x4=x[\u2026 (3s)\r\u001b[5C\u001b[1B(ctrl+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
