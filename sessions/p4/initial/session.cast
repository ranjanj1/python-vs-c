[484.76, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mResults mat\u001b[15Gh exactly across\u001b[32Gunroll factors. I'll use\u001b[57G2\u00d7\u001b[60Gunroll\u001b[67Gfor\u001b[71Gthe\u001b[75Glayer\u001b[81Gmatrices\u001b[90G(~55\u001b[95GGB/s)\u001b[101Gand\u001b[105G4\u00d7\u001b[108Gfor\u001b[112Gthe\r\u001b[2C\u001b[1B32000-wide\u001b[14Gclassifier,\u001b[26Gsince\u001b[32Geach\u001b[37Gis\u001b[40Gfaster\u001b[47Gthere.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThroughput\u001b[14Gis up to about 100 tok/s\u001b[39Gand\u001b[43Gtests\u001b[49Gstill\u001b[55Gpass;\u001b[61Gsince\u001b[67Gthe\u001b[71Gthird\u001b[77Grun's\u001b[83Gdip\u001b[87Glooks\u001b[93Glike\u001b[98Gmachine\u001b[106Gnoise,\u001b[113GI'm\r\u001b[2C\u001b[1Bre-timing,\u001b[14Gthen\u001b[19Gtesting\u001b[27Gedge\u001b[32Gcases.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll edge cases check out, and the co\u001b[40Gtext stop emit\u001b[56Gthe ex\u001b[63Gected token\u001b[75Gcount.\u001b[82GThroughput\u001b[93Gvaries\u001b[100Ga\u001b[102Glot\u001b[106Gbetween\u001b[114Gruns,\r\u001b[2C\u001b[1Bso\u001b[6Gmachine\u001b[14Gload\u001b[19Gis\u001b[22Glikely;\u001b[30GI'm\u001b[34Glooking\u001b[42Ginto\u001b[47Gthe\u001b[51G2.7s\u001b[56Gstartup"]
[484.761, "\u001b[64Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight loading \u001b[19Glus\u001b[23Gtransposing takes\u001b[41G1.9s\u001b[46Gof\u001b[49Gstartup.\u001b[58GTrying\u001b[65Ga\u001b[67Gsequential\u001b[78G\u001b[38;2;87;105;247mfromfile\u001b[87G\u001b[39mread\u001b[92Gin\u001b[95Gplace\u001b[101Gof\u001b[104Gthe\u001b[108Gmemmap,\u001b[116Gand\r\u001b[2C\u001b[1Bdifferent\u001b[13Gtranspose\u001b[23Gblock\u001b[29Gsizes:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9Gsize\u001b[14G16\u001b[17Gis\u001b[20Gabout\u001b[26G3\u00d7\u001b[29Gfaster\u001b[36Gthan\u001b[41G64,\u001b[45Gand\u001b[49G\u001b[38;2;87;105;247mfromfile\u001b[58G\u001b[39mreads\u001b[64Gthe\u001b[68Gwhole\u001b[74Gfile\u001b[79Gin\u001b[82G0.23s.\u001b[89GApplying\u001b[98Gboth:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Applying load speedup,\u001b[26Gre-time,\u001b[35Gre-check\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $\u001b[8Gpytho\u001b[14G3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ms\u001b[10Gopen('run.\u001b[21Gy').read()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ma\u001b[22Gmem\u001b[26Gap(path, dtype='<f4', mode='r', offset=28)\\n\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102"]
