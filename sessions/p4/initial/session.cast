[281.936, "\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mCheck for float64 promotion and fastmath flags\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mpython3 - <<'EOF' 2>&1 | tail -30\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport io, sys, re\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msys.argv=['x']\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport run\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm\u001b[6G= run.Model('model.bin')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm.forward(1,0);\u001b[20Grun.argmax(m.logits)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gf\u001b[10Gin\u001b[13G(run.forward,\u001b[27Grun.matmul_t,\u001b[41Grun.rmsnorm,\u001b[54Grun.softmax,\u001b[67Grun.argmax):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     buf = io.StringIO();\u001b[29Gf.inspect_types(file=buf);\u001b[56Gs\u001b[58G=\u001b[60Gbuf.getvalue()\r\u001b[1C\u001b[1B\u001b["]
[281.938, "2m\u2502\u001b[8G\u001b[22mhits\u001b[13G=\u001b[15Gsorted(set(l.strip()\u001b[36Gfor\u001b[40Gl\u001b[42Gin\u001b[45Gs.splitlines()\u001b[60Gif\u001b[63G'float64'\u001b[73Gin\u001b[76Gl\u001b[78Gand\u001b[82G'::'\u001b[87Gin\u001b[90Gl))\r\u001b[1B \u001b[2m\u2502\u001b[22m     print(f.py_func.__name__, 'float64 lines:', len(hits))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for\u001b[12Gh in hit\u001b[21G[:10]:\u001b[28Gprint('\u001b[38G',\u001b[41Gh[:160])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6Gfastmath\u001b[15Gflags\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for f in (run.forward,\u001b[27Grun.matmul_t):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mir\u001b[11G=\u001b[13Glist(f.inspect_llvm().values())[0]\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G print(f.py_func.__name__, 'fast flags:', le\u001b[52G(re.findal\u001b[63G(r'\\bfast\\b|\\bc\u001b[79Gntract\\b|\\breassoc\\b', ir)),\u001b[108G'vector\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ops:',\u001b[11Glen(re.findall(r'<\\d+\u001b[33Gx\u001b[35Gfloat>',\u001b[44Gir)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[281.938, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfile\u001b[9Gredirect\u001b[18Gin\u001b[21Gthis\u001b[26Gcommand\u001b[34Gcan't\u001b[40Gbe\u001b[43Gchecked\u001b[51Gbefore\u001b[58Git\u001b[61Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
