[117.335, "\u001b[H\u001b[2G\u001b[38;2;51;51;51m\u001b[2m 313 \u001b[22m                    say(\u001b[38;2;24;54;145m'T %d'\u001b[38;2;51;51;51m % nxt)\r\u001b[1B\u001b[39m \u001b[38;2;51;51;51m\u001b[2m 314 \u001b[22m                    count += \u001b[38;2;0;134;179m1\r\u001b[1B\u001b[39m \u001b[38;2;51;51;51m\u001b[2m 315 \u001b[22m                    token = nxt\u001b[39m\u001b[K\r\u001b[1B \u001b[38;2;51;51;51m\u001b[2m 316 \u001b[22m                    \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m count >= max_new:\r\u001b[1C\u001b[1B\u001b[2m 317 \u001b[22m                        reason = \u001b[38;2;24;54;145m'max'\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 318 \u001b[22m                        \u001b[38;2;167;29;93mbreak\r\u001b[1B\u001b[39m \u001b[38;2;51;51;51m\u001b[2m 319 \u001b[22m            say(\u001b[38;2;24;54;145m'DONE %d %s'\u001b[38;2;51;51;51m % (count, reason))\u001b[39m\u001b[K\r\u001b[1B \u001b[38;2;51;51;51m\u001b[2m 320 \u001b[22m        \u001b[38;2;167;29;93melif\u001b[38;2;51;51;51m cmd == \u001b[38;2;24;54;145m'FIXED'\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mor\u001b[38;2;51;51;51m cmd == \u001b[38;2;24;54;145m'LOGITS'\u001b[38;2;51;51;51m:\u001b[39m\u001b[K\r\u001b[1B \u001b[38;2;51;51;51m\u001b[2m 321 \u001b[22m            parts = rest.split()\u001b[39m\u001b[K\r\u001b[1B \u001b[38;2;51;51;51m\u001b[2m 322 \u001b[22m            \u001b"]
[117.335, "[38;2;167;29;93mif\u001b[38;2;51;51;51m cmd == \u001b[38;2;24;54;145m'LOGITS'\u001b[38;2;51;51;51m:\u001b[39m\u001b[K\r\u001b[1B \u001b[38;2;51;51;51m\u001b[2m 323 \u001b[22m                path, parts = parts[\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m], parts[\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m:]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 324 \u001b[22m            ids = [\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(t) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m parts]\r\u001b[1B\u001b[39m \u001b[38;2;51;51;51m\u001b[2m 325 \u001b[22m            model.reset()\u001b[39m\u001b[K\r\u001b[1B \u001b[38;2;51;51;51m\u001b[2m 326 \u001b[22m            n = \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(ids)\r\u001b[1C\u001b[1B\u001b[2m 327 \u001b[22m            \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m cmd == \u001b[38;2;24;54;145m'LOGITS'\u001b[38;2;51;51;51m:\r\u001b[1C\u001b[1B\u001b[2m 328 \u001b[22m                allv = np.empty((n, model.vocab_size), dtype=F32)\r\u001b[1C\u001b[1B\u001b[2m 329 \u001b[22m                \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m p, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\r\u001b[1C\u001b[1B\u001b[2m 330 \u001b[22m                    allv[p] = m"]
[117.336, "odel.forward(t, p)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 331 \u001b[22m                allv.astype(\u001b[38;2;24;54;145m'<f4'\u001b[38;2;51;51;51m, copy=\u001b[38;2;0;134;179mFalse\u001b[38;2;51;51;51m).tofile(path.decode(\u001b[38;2;24;54;145m'utf-8'\u001b[38;2;51;51;51m, \u001b[38;2;24;54;145m'surrogateescape'\u001b[38;2;51;51;51m))\r\u001b[1C\u001b[1B\u001b[2m 332 \u001b[22m                say(\u001b[38;2;24;54;145m'DONE %d'\u001b[38;2;51;51;51m % n)\r\u001b[1C\u001b[1B\u001b[2m 333 \u001b[22m            \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m:\r\u001b[1C\u001b[1B\u001b[2m 334 \u001b[22m                am = []\r\u001b[1C\u001b[1B\u001b[2m 335 \u001b[22m                \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m p, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\r\u001b[1C\u001b[1B\u001b[2m 336 \u001b[22m                    am.append(\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(np.argmax(model.forward(t, p))))\r\u001b[1C\u001b[1B\u001b[2m 337 \u001b[22m                say(\u001b[38;2;24;54;145m'DONE %d %s'\u001b[38;2;51;51;51m % (n, \u001b[38;2;24;54;145m' '\u001b[38;2;51;51;51m.join(\u001b[38;2;0;134;179mmap\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m, am))) \u001b[38;2;167;29;93mif"]
[117.336, "\u001b[38;2;51;51;51m am \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m \u001b[38;2;24;54;145m'DONE 0'\u001b[38;2;51;51;51m)\r\u001b[1C\u001b[1B\u001b[2m 338 \u001b[22m        \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m:\r\u001b[1C\u001b[1B\u001b[2m 339 \u001b[22m            sys.stderr.write(\u001b[38;2;24;54;145m'unknown command: %r\\n'\u001b[38;2;51;51;51m % raw)\r\u001b[1C\u001b[1B\u001b[2m 340 \u001b[22m    out.flush()\r\u001b[1C\u001b[1B\u001b[2m 341 \u001b[22m    sys.exit(\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m)\r\u001b[1C\u001b[1B\u001b[2m 342 \r\u001b[1C\u001b[1B 343 \r\u001b[1C\u001b[1B 344 \u001b[22m\u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m __name__ == \u001b[38;2;24;54;145m'__main__'\u001b[38;2;51;51;51m:\r\u001b[1C\u001b[1B\u001b[2m 345 \u001b[22m    main()\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to create \u001b[1mrun.py\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;"]
[117.337, "105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
