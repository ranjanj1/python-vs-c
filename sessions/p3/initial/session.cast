[118.12, "\u001b[H\r\u001b[14B\u001b[38;2;44;122;57m\u23fa\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote\u001b[12G\u001b[1m345\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mrun.py\r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  2 \u001b[22m\u001b[38;2;24;54;145m\"\"\"P3 port of llama2.c (reference/run.c): NumPy float32 arrays, native BLAS via np.dot / np.matmul.\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  3 \r\u001b[5C\u001b[1B  4 \u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m INTERFACE.md on stdi\r\u001b[5C\u001b[1B\u001b[2m    \u001b[22mn.\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\r\u001b[5C\u001b[1B\u001b[2m  7 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m struct\r\u001b[5C\u001b[1B\u001b[2m  8 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m sys\r\u001b[5C\u001b[1B\u001b[2m  9 \r\u001b[5C\u001b[1B\u001b[22m\u001b[38;2;102;102;102m\u2026 +336 lines \r\u001b[28C\u001b[7B2\u001b[31G2\u001b[39m\u001b[40;1H\u001b[38;3H"]
