[138.071, "\u001b[H     \u001b[38;2;51;51;51m\u001b[2m  1 \u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P3 port of llama2.c (reference/run.c): NumPy float32 arrays, native BLAS via np.dot / np.matmul.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m INTERFACE.md on stdi\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[22mn.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\r\u001b[7C\u001b[1B\u001b[2m7\u001b[17G\u001b[22mstruct\r\u001b[7C\u001b[1B\u001b[2m8\u001b[18G\u001b[22mys\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +336 lines \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22ml"]
[138.072, "ine\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 334 \u001b[22m                 am = []\r\u001b[8C\u001b[1B\u001b[2m5\u001b[28G\u001b[22m\u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m p, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\r\u001b[8C\u001b[1B\u001b[2m6\u001b[28G\u001b[22m   \u001b[32Gam.append(\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(np.argmax(model.forward(t, p))))\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 337 -\u001b[38;2;51;51;51m                say('DONE %d %s' % (n, ' '.join(map(str, am))) if am else 'DONE 0')                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 337 +\u001b[38;2;51;51;51m                say(\u001b[38;2;24;54;145m' '\u001b[38;2;51;51;51m.join([\u001b[38;2;24;54;145m'DONE'\u001b[38;2;51;51;51m, \u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(n)] + [\u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(a) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m a \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m am]))                                \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 338 \u001b[22m         \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m:\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m9\u001b[20G\u001b[22m    sys.stderr.write(\u001b[38;2;24;54;145"]
[138.073, "m'unknown command: %r\\n'\u001b[38;2;51;51;51m % raw)\r\u001b[7C\u001b[1B\u001b[2m40\u001b[16G\u001b[22mout.flush()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick\u001b[9Gcheck\u001b[15Gpasses.\u001b[23GNow\u001b[27Gthe\u001b[31Gfull\u001b[36Gcheck\u001b[42G(all\u001b[47Gprompts,\u001b[56G64\u001b[59Gtokens)\u001b[67Gplus\u001b[72Gedge-case\u001b[82Gprobes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11Gfull\u001b[16Gcheck\u001b[22Gand\u001b[26Gprobing\u001b[34Gedge\u001b[39Gcommands\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ time python3 check.py --tokens 64 --prompts 3 -- python3 run.py; printf 'PIECE 1 9038\\nPIECE 9038 3\\nPIECE 5 \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m13\\nFIXED 1 9038 2501\\nFIXED\\nGENERATE 0 hi\\nGENERATE 5 \\nENCODE\\nQUIT\\n'\u001b[80G| python3 run.py model.bin tokenizer.bin;\r\u001b[5C\u001b[1Becho \"exit $?\" (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(\u001b[8Gtrl+b to\u001b[17Grun in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
