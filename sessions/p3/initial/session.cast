[170.805, "\u001b[H\u001b[8G\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage: python3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m INTERFACE.md on stdi\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[22mn.\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m6\u001b[17G\u001b[22mmath\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m7\u001b[18G\u001b[22mtruct\r\u001b[7C\u001b[1B\u001b[2m8\u001b[10G\u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m sys\r\u001b[5C\u001b[1B\u001b[2m  9 \u001b[22m\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +336 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[39m \u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[28G\u001b[22mam = []\u001b[39m\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m5\u001b[28G\u001b[22m\u001b[38;2;167;29;93mfor\u001b[32G\u001b[38;2;51;51;51mp, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 336 \u001b[22m                "]
[170.805, "     am.append(\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(np.argmax(model.forward(t, p))))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 337 -\u001b[38;2;51;51;51m                say('DONE %d %s' % (n, ' '.join(map(str, am))) if am else 'DONE 0')                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 337 +\u001b[38;2;51;51;51m                say(\u001b[38;2;24;54;145m' '\u001b[38;2;51;51;51m.join([\u001b[38;2;24;54;145m'DONE'\u001b[38;2;51;51;51m, \u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(n)] + [\u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(a) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m a \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m am]))                                \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m8\u001b[20G\u001b[22m\u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m:\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m39\u001b[16G\u001b[22m        sys.stderr.write(\u001b[38;2;24;54;145m'unknown command: %r\\n'\u001b[38;2;51;51;51m % raw)\r\u001b[5C\u001b[1B\u001b[2m 340 \u001b[22m     out.flush()\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick\u001b[9Gcheck\u001b[15Gpasses.\u001b[23GNow\u001b["]
[170.806, "27Gthe\u001b[31Gfull\u001b[36Gcheck\u001b[42G(all\u001b[47Gprompts,\u001b[56G64\u001b[59Gtokens)\u001b[67Gplus\u001b[72Gedge-case\u001b[82Gprobes.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Testing context-limit stop\u001b[30Gpolicy\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ \u001b[9Gython3 - <<'EOF'\r\u001b[5C\u001b[1Bimport subprocess\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp=subprocess.Popen(['python3','run.py','model.bin','tokenizer.bin'],stdin=subprocess.PIPE,stdout=subprocess.PIPE,te\r\u001b[5C\u001b[1Bxt=True)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp.stdout.readline()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mtxt=' '\u001b[14Gjo\u001b[17Gn([\u001b[21Gcat']*1020)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp.stdin.write('ENCODE '+txt+'\\n');p.stdin.flush();n=len(p.stdout.readline().split())-1;pri\u2026\u001b[39m\u001b[40;1H\u001b[38;3H"]
