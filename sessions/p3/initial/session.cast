[147.741, "\u2026 +336 lines \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[28G\u001b[22mam\u001b[31G= []\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 335 \u001b[22m                 \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m p, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 336 \u001b[22m                     am.append(\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(np.argmax(model.forward(t, p))))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 337 -\u001b[38;2;51;51;51m                say('DONE %d %s' % (n, ' '.join(map(str, am))) if am else 'DONE 0')                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 337 +\u001b[38;2;51;51;51m                say(\u001b[38;2;24;54;145m' '\u001b[38;2;51;51;51m.join([\u001b[38;2;24;54;145m'DONE'\u001b[38;2;51;51;51m, \u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(n)] + [\u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(a) \u001b[38;2;167;29;93mfor\u001b[38;2;51;"]
