[172.503, "\u001b[H\u001b[6G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mWrote \u001b[1m345\u001b[16G\u001b[22mlines\u001b[22Gto\u001b[25G\u001b[1mrun.py\r\u001b[7C\u001b[1B\u001b[22m\u001b[38;2;51;51;51m\u001b[2m1\u001b[10G\u001b[22m\u001b[38;2;150;152;150m#!/usr/bin/env python3\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m2\u001b[10G\u001b[22m\u001b[38;2;24;54;145m\"\"\"P3 port of llama2.c (reference/run.c): NumPy float32 arrays, native BLAS via np.dot / np.matmul.\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m3\u001b[10G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[10G\u001b[22mUsage:\u001b[17Gp\u001b[19Gthon3 run.py <checkpoint.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m> <tokenizer.\u001b[38;2;0;134;179mbin\u001b[38;2;51;51;51m>, then the line protocol \u001b[38;2;167;29;93mfrom\u001b[38;2;51;51;51m INTERFACE.md on stdi\r\u001b[7C\u001b[1B\u001b[2m \u001b[10G\u001b[22mn.\r\u001b[5C\u001b[1B\u001b[2m  5 \u001b[22m\u001b[38;2;24;54;145m\"\"\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m  6 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m math\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;51;51;51m\u001b[2m  7 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m struct\r\u001b[1B\u001b[39m     \u001b[38;2;51;51;51m\u001b[2m  8 \u001b[22m\u001b[38;2;167;29;93mimport\u001b[38;2;51;51;51m sys\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 9 \u001b[22m\u001b[3"]
[172.505, "9m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m\u2026 +336 lines \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line, removed \u001b[1m1\u001b[22m line\u001b[K\r\u001b[8C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m4\u001b[20G\u001b[22m        am = []\r\u001b[8C\u001b[1B\u001b[2m5\u001b[24G\u001b[22m    \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m p, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m36\u001b[16G\u001b[22m                am.append(\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(np.argmax(model.forward(t, p))))\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 337 -\u001b[38;2;51;51;51m                say('DONE %d %s' % (n, ' '.join(map(str, am))) if am else 'DONE 0')                   \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 337 +\u001b[38;2;51;51;51m                say(\u001b[38;2;24;54;145m' '\u001b[38;2;51;51;51m.join([\u001b[38;2;24;54;145m'DONE'\u001b[38;2;51;51;51m, \u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(n)] + [\u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(a) \u001b[38;2;167;29;93mfor"]
