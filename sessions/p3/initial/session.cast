[134.6, "\u001b[H\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m1\u001b[22m line,\u001b[20Gremoved\u001b[28G\u001b[1m1\u001b[30G\u001b[22mline\r\u001b[1B     \u001b[38;2;51;51;51m\u001b[2m 334 \u001b[22m                 am = []\r\u001b[6C\u001b[1B\u001b[2m335 \u001b[22m                 \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m p, t \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179menumerate\u001b[38;2;51;51;51m(ids):\r\u001b[6C\u001b[1B\u001b[2m336 \u001b[22m                     am.append(\u001b[38;2;0;134;179mint\u001b[38;2;51;51;51m(np.argmax(model.forward(t, p))))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 337 -\u001b[38;2;51;51;51m                say('DONE %d %s' % (n, ' '.join(map(str, am))) if am else 'DONE 0')                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 337 +\u001b[38;2;51;51;51m                say(\u001b[38;2;24;54;145m' '\u001b[38;2;51;51;51m.join([\u001b[38;2;24;54;145m'DONE'\u001b[38;2;51;51;51m, \u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(n)] + [\u001b[38;2;0;134;179mstr\u001b[38;2;51;51;51m(a) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m a \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m am]))      "]
[134.601, "                          \r\u001b[6C\u001b[1B\u001b[49m\u001b[2m338 \u001b[22m         \u001b[38;2;167;29;93melse\u001b[38;2;51;51;51m:\r\u001b[6C\u001b[1B\u001b[2m339 \u001b[22m             sys.stderr.write(\u001b[38;2;24;54;145m'unknown command: %r\\n'\u001b[38;2;51;51;51m % raw)\r\u001b[6C\u001b[1B\u001b[2m340 \u001b[22m     out.flush()\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mQuick check passes.\u001b[23GNow\u001b[27Gthe\u001b[31Gfull\u001b[36Gcheck\u001b[42G(all\u001b[47Gprompts,\u001b[56G64\u001b[59Gtokens)\u001b[67Gplus\u001b[72Gedge-case\u001b[82Gprobes.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[4C\u001b[1B\u001b[38;2;102;102;102m $ time python3 check.py --tokens 64 --prompts 3 -- python3 run.py; printf 'PIECE 1 9038\\nPIECE 9038 3\\nPIECE 5 \r\u001b[5C\u001b[1B13\\nFIXED 1 9038 2501\\nFIXED\\nGENERATE 0 hi\\nGENERATE 5 \\nENCODE\\nQUIT\\n' | python3 run.py model.bin tokenizer.bin;\r\u001b[5C\u001b[1Becho \"exit $?\"\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[134.602, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mRun full check and probe edge commands\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mtime\u001b[9Gpython3\u001b[17Gcheck.py\u001b[26G--tokens\u001b[35G64\u001b[38G--prompts\u001b[48G3\u001b[50G--\u001b[53Gpython3\u001b[61Grun.py;\u001b[69Gprintf\u001b[76G'PIECE\u001b[83G1\u001b[85G9038\\nPIECE\u001b[97G9038"]
[134.603, "\u001b[102G3\\nPIECE\u001b[111G5\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m 13\\nFIXED 1 9038 2501\\nFIXED\\nGENERATE\u001b[43G0\u001b[45Ghi\\nGENERATE\u001b[58G5\u001b[60G\\nENCODE\\nQUIT\\n'\u001b[78G|\u001b[80Gpython3\u001b[88Grun.py\u001b[95Gmodel.bin\u001b[105Gtokenizer.bin;\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mecho\u001b[9G\"exit\u001b[15G$?\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mtime python3 check.py --tokens 64 --prompts 3 -- python3 run.py, python3 run.py \r\u001b[6C\u001b[1Bmodel.bin tokenizer.bin\u001b[22m,\u001b[32Gand\u001b[36G\u001b[1m\"ec"]
[134.603, "ho \\\"exit $?\\\"\"\u001b[55G\u001b[22mcommands\u001b[64Gin\u001b[67G\u001b[1m/Users/agentlab/pvc/p3\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
[134.612, "\u001b[H\r\u001b[10C\u001b[16Bfull che\u001b[20Gk and probing\u001b[34Gedge\u001b[39Gcommands\u001b[40;1H\u001b[34;2H"]
