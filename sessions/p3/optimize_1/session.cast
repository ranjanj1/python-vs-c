[225.573, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmuls\u001b[11Gare\u001b[15Gnow\u001b[19G10.4\u001b[24Gms\u001b[27Gof\u001b[30G10.9\u001b[35Gms;\u001b[39Gonly\u001b[44G~0.5\u001b[49Gms\u001b[52Gis\u001b[55Goverhead.\u001b[65GAll\u001b[69Gscalars\u001b[77Gand\u001b[81Gbuffers\u001b[89Gstay\u001b[94Gfloat32.\u001b[103GNow\u001b[107Gchecking\u001b[116Gthe\r\u001b[1B \u001b[3GPy\u001b[6Ghon-sid\u001b[15Gcosts: tokeniz\u001b[30Gr encode\u001b[39Gon long prompts, a\u001b[58Gd\u001b[60Gs\u001b[62Gartup.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > pr\u001b[17Gf/tok.py <<'EOF'\r\u001b[5C\u001b[1Bimport sys, time\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102msys.path.insert(0, sys.argv[1])\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mfrom run import Tokenizer\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mt=time.perf_counter(); tk=Tokenizer('tokenizer.bin',32000); print('tok load %.3fs'%(time.perf_counter()-t))\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mfor txt in ['O\u001b[21Gce upon a time', 'The little dog was sad because he could not find his re\u2026\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[225.574, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mTime\u001b[7Gtokenizer enco\u001b[22Ge and numpy import\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m cat > prof/tok.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import sys, time\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msys.path.in"]
[225.575, "sert(0,\u001b[23Gsys.argv[1])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m from run import Tokenizer\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt=time.perf_counter();\u001b[27Gtk=Tokenizer('tokenizer.bin',32000);\u001b[64Gprint('tok\u001b[75Gload\u001b[80G%.3fs'%(time.perf_counter()-t))\r\u001b[1B \u001b[2m\u2502\u001b[22m for tx\u001b[11G in ['Once\u001b[22Gupon\u001b[27Ga time', 'The\u001b[41Glitt\u001b[46Ge dog was\u001b[56Gsad because he could no\u001b[80G find his red ball\u001b[101Gywh\u001b[105Gre in\u001b[111Gthe\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m house', '\u001b[14G'.join(['cat']*1020),\u001b[36G'Lily\u001b[42Gwent\u001b[47Gto\u001b[50Gthe\u001b[54Gpark\u001b[59Gand\u001b[63Gplayed\u001b[70Gwith\u001b[75Gher\u001b[79Gfriends.\u001b[88G'*60]:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mb=txt.encode();\u001b[24Gt=time.perf_counter();\u001b[47Gids=tk.encode(b);\u001b[65Gprint(len(b),'bytes',len(ids),'ids\u001b[100G%.2f\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ms'%((time.perf_counter()-t)*1e3))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 prof/tok.py\u001b[24G.;\u001b[27Gtime python3 -c \"import numpy\"\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[225.575, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mcat, python3 prof/tok.py .\u001b[22m, and \u001b[1m\"time python3 -c \\\"import numpy\\\"\"\u001b[103G\u001b[22mcommands\u001b[112Gin\r\u001b[6C\u001b[1B\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
