[6.916, "\u001b[H\u001b[3G\u001b[1mHow it follows the rules\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mModel and precision:\u001b[26G\u001b[22mit\u001b[29Greads\u001b[35Gthe\u001b[39Gcheckpoint\u001b[50Gthe\u001b[54Gsame\u001b[59Gway\u001b[63G\u001b[38;2;87;105;247mrun.c\u001b[69G\u001b[39mdoes\u001b[74Gand\u001b[78Gloads\u001b[84Gthe\u001b[88Gweights\u001b[96Gonce\u001b[101Gas\u001b[104GNumPy\u001b[110Gfloat32.\u001b[119GIt\r\u001b[2C\u001b[1B  processes one token per\u001b[29Gposition,\u001b[39Gwith\u001b[44Gseparate\u001b[53Gmatrix-vector\u001b[67Gproducts\u001b[76Gdone\u001b[81Gthrough\u001b[89G\u001b[38;2;87;105;247mnp.dot\u001b[96G\u001b[39m(which\u001b[103Gcalls\u001b[109GApple's\r\u001b[2C\u001b[1B \u001b[5GAccelerate library).\u001b[26GEve\u001b[30Gy layer runs and full logits\u001b[59Gare\u001b[63Gcomputed at every step. Nothing is \u001b[99Gonverted to float64,\u001b[K\r\u001b[4C\u001b[1Bno threads are started,\u001b[29Gand no thread counts are set.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m every command starts at po\u001b[42Gition 0 with a cleared cach\u001b[70G.\u001b[72GThe cache is stored per atte\u001b[101Gtion head\u001b[111Gso each\u001b[K\r\u001b[4C\u001b[1Bhead's data sit\u001b[21G tog\u001b[26Gther in memo\u001b[39Gy.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTokeniz\u001b[13Gr:\u001b[22m a b\u001b[20Gte-for-byte port of the reference \u001b[38;2;87;105;247mencode\u001b[39m an\u001b[65"]
[6.918, "G\u001b[38;2;87;105;247mdecode\u001b[39m. Input is\u001b[82Gread as raw bytes and only the final\r\u001b[4C\u001b[1Bn\u001b[7Gwline is removed, so leading, t\u001b[39Gailing\u001b[46Gand\u001b[50Grepeated\u001b[59Gspaces\u001b[66Gand\u001b[70Gtabs\u001b[75Gare\u001b[79Gkept.\r\u001b[4C\u001b[1B\u001b[1mGENERATE stop rules:\u001b[22m prompt tokens\u001b[40Gar\u001b[44Gforced, then each \u001b[63Gew token is the\u001b[79Ghigh\u001b[84Gst-sco\u001b[91Ging on\u001b[98G,\u001b[100Gwith the\u001b[109Glowest index\r\u001b[4C\u001b[1Bwinn\u001b[11Gg\u001b[13Gties. I tested\u001b[28Gall three endings:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;87;105;247mstop\u001b[39m when the model picks\u001b[38G 1, which is not printed.\u001b[K\r\u001b[4C\u001b[1B- \u001b[38;2;87;105;247mmax\u001b[39m af\u001b[14Ger \u001b[38;2;87;105;247mmax_new\u001b[39m tokens. If that limit\u001b[47Gand\u001b[51Gthe\u001b[55Gcontext\u001b[63Glimit\u001b[69Gare\u001b[73Ghit\u001b[77Gtogether,\u001b[87G\u001b[38;2;87;105;247mmax\u001b[91G\u001b[39mis\u001b[94Greported.\r\u001b[6C\u001b[1B\u001b[38;2;87;105;247mcontext\u001b[39m at s\u001b[20Gq_len (1,024) positions: a 1,021-\u001b[54Goken prompt\u001b[66Ggave\u001b[71G\u001b[38;2;87;105;247mDONE 4 context\u001b[39m,\u001b[87Gwhich\u001b[93Gmatches\u001b[101Gthe\u001b[105Greference.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (also in \u001b[38;2;87;105;247mNOTES.m"]
[6.919, "d\u001b[39m)\u001b[34G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mINTERFACE.md\u001b[18G\u001b[39mdoesn't\u001b[26Gsay\u001b[30Gwhat\u001b[35G\u001b[38;2;87;105;247mPIECE\u001b[41G\u001b[39mshould\u001b[48Gprint\u001b[54Gwhen\u001b[59Gthe\u001b[63Gpiece\u001b[69Gdecodes\u001b[77Gto\u001b[80Gnothing\u001b[88G(for\u001b[93Gexample\u001b[101Gthe\u001b[105Gzero\u001b[110Gbyte).\u001b[117GI\r\u001b[2C\u001b[1B  print \u001b[38;2;87;105;247mHEX \u001b[39m with an empty hex\u001b[34Gstring\u001b[41Gand\u001b[45Ga\u001b[47Gtrailing\u001b[56Gspace;\u001b[63Gthe\u001b[67Gfinal\u001b[73Ggate\u001b[78Gmay\u001b[82Gexpect\u001b[89Gsomething\u001b[99Gdifferent.\r\u001b[4C\u001b[1BThe sums are\u001b[18Gadded in \u001b[28G different order than the\u001b[54GC loops,\u001b[63Gwhi\u001b[67Gh\u001b[69Gcauses the\u001b[80G~1e-5 dif\u001b[90Ge\u001b[92Gences. If two top\u001b[110Gscores\u001b[117Gare\r\u001b[4C\u001b[1Balmost tied, \u001b[20Ge chosen token could\u001b[41Gi\u001b[43G princip\u001b[52Ge differ from the reference.\u001b[K\r\u001b[4C\u001b[1B\u001b[38;2;87;105;247mFIXED\u001b[39m and \u001b[38;2;87;105;247mLOGITS\u001b[39m with\u001b[27Gmore than 1,024 ids \u001b[48Gren't\u001b[54Gsupp\u001b[59Grted.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GSpeed is roughly\u001b[22G13 ms per token; that's a rough\u001b[54Gf\u001b[56Ggure\u001b[66Gon\u001b[71Gun that includes\u001b[88Gload\u001b[93Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe harne\u001b[13Gs"]
[6.92, ", fixtures, rul\u001b[30Gs\u001b[32Gand reference\u001b[47Gre \u001b[51Gnchan\u001b[57Ged.\u001b[61GThe c\u001b[67Gmmands\u001b[74GI ran and a \u001b[87Gumm\u001b[91Gry of the\u001b[101Gchanges\u001b[109Gare\u001b[113Grecorded\r\u001b[2C\u001b[1Bin\u001b[6G\u001b[38;2;87;105;247mNOTES.md\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCogitated for 3m 1s \u00b7 done 3:42 PM\r\u001b[2B\u001b[48;2;240;240;240m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplem\u001b[10Gn\u001b[12Gations or other ports. R\u001b[37Gcord profiling evidence, changes, tests and remai\u001b[87Ging lim\u001b[95Gta\u001b[98Gion\u001b[102G in\u001b[106GNOTES.md.\u001b[39m \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Running \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
