[173.505, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[16G\u001b[22m#\u001b[18Gffn\u001b[22Grmsnorm\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G        \u001b[16Gss = one / np.\u001b[31Gqrt(vecdot(x, x) /\u001b[50Gfdim + \u001b[58Gps)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G         \u001b[16Gmultiply(x,\u001b[28Gss,\u001b[32Gout=xb)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mmultiply(rms_ffn,\u001b[34Gxb,\u001b[38Gout=xb)\r\u001b[1B \u001b[2m\u2502\u001b[22m             vecdot(w1, xb, out=hb)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mvecdot(w3,\u001b[27Gxb,\u001b[31Gout=hb2)\r\u001b[1B \u001b[2m\u2502\u001b[22m             # SwiGLU: hb = hb * (1 / (1 + exp(-hb))) * hb2\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m             np.negative(hb, out=xs_h) if False else None\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m             sig = exp(np.negative(hb))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22msig\u001b[20G+=\u001b[23Gone\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             np.divide(one,\u001b[31Gsig,\u001b[36Gout=sig)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mhb\u001b[19G*=\u001b[22Gsig\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G   \u001b[15G hb *= hb2\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G      \u001b[14G  vecdot(w2,\u001b[27Ghb, out=xb)\u001b[39G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mx\u001b[18G+=\u001b[21Gxb\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mss\u001b[15G=\u001b[17Gone\u001b[21G/\u001b[23Gnp.sqrt(vecdot"]
