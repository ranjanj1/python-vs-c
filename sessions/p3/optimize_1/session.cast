[40.936, "\u001b[H\u001b[7G\u001b[38;2;87;105;247mcontext\u001b[39m at seq_len (1,024) positions: a\u001b[47G1,021-toke\u001b[58G prompt gave \u001b[38;2;87;105;247mDONE 4 context\u001b[87G\u001b[39mwhich matches the\u001b[105Greference.\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (also in \u001b[38;2;87;105;247mNOTES.md\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;87;105;247mINTERFACE.md\u001b[39m doesn't say what\u001b[35G\u001b[38;2;87;105;247mPIECE\u001b[41G\u001b[39mshould\u001b[48Gprint\u001b[54Gwhen\u001b[59Gthe\u001b[63Gpiece\u001b[69Gdecodes\u001b[77Gto\u001b[80Gnothing\u001b[88G(for\u001b[93Gexample\u001b[101Gthe\u001b[105Gzero\u001b[110Gbyte).\u001b[117GI\r\u001b[2C\u001b[1B \u001b[5Gprint \u001b[38;2;87;105;247mHEX \u001b[39m with a\u001b[23G empt\u001b[30Ghex string\u001b[41Gand a tra\u001b[51Gling space;\u001b[63Gth\u001b[66G final gate may expect s\u001b[91Gmething diff\u001b[104Grent.\u001b[110G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe sums are added\u001b[24Gin a different order\u001b[45Gthan the C\u001b[56Gloops,\u001b[63Gw\u001b[65Gich c\u001b[71Guses the ~1\u001b[83G-5 differ\u001b[93Gnces.\u001b[99GIf two top\u001b[110Gscores\u001b[117Gare\r\u001b[2C\u001b[1B \u001b[5Galmo\u001b[10Gt tied,\u001b[18Gthe chosen\u001b[29Gtoken could in principl\u001b[54Gdiffer from t\u001b[68Ge ref\u001b[74Grenc\u001b[79G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mFIXED\u001b[39m and \u001b[38;2;"]
[40.937, "87;105;247mLOGITS\u001b[22G\u001b[39mwith more than 1,024 ids aren't\u001b[54Gsuppo\u001b[60Gted.\u001b[K\r\u001b[4C\u001b[1BSpeed\u001b[11Gis roughly\u001b[22G13 ms per\u001b[33Goken; that's a \u001b[49Gough\u001b[54Gfigure from\u001b[66Gone\u001b[70Grun\u001b[74Gthat\u001b[79Gincludes\u001b[88Gload\u001b[93Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gharness,\u001b[16Gfixtures,\u001b[26Grules\u001b[32Gand\u001b[36Greference\u001b[46Gare\u001b[50Gunchanged.\u001b[61GThe\u001b[65Gcommands\u001b[74GI\u001b[76Gran\u001b[80Gand\u001b[84Ga\u001b[86Gsummary\u001b[94Gof\u001b[97Gthe\u001b[101Gchanges\u001b[109Gare\u001b[113Grecorded\r\u001b[2C\u001b[1Bin \u001b[38;2;87;105;247mNOTES.md\u001b[39m.\u001b[16G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCogitated for 3m 1s \u00b7 done 3:42 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gre"]
[40.938, "maining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mProfiling\u001b[13Gmatmul\u001b[20Gvs\u001b[23Goverhead\u001b[32Gcomponents\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cat > prof/parts.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport sys, time, cProfile, pstats\r\u001b[5C\u001b[1Bsys.path.insert(0, sys.argv[1])\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mimport numpy as np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfrom ru\u001b[14G import\u001b[22GTransformer\r\u001b[5C\u001b[1Bm=Transfor\u001b[17Ger('model.bin')\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mdef bench(f,n=50):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mf(); t=time.perf_counter()\r\u001b[6C\u001b[1Bor _ in rang\u001b[20G(n): f()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mreturn (time.perf_counter()-t)/n*1e3\r\u001b[5C\u001b[1Bx=np.ones(768,np.fl\u001b[26Gat\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
