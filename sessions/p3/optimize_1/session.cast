[393.277, "m\u001b[48;2;220;255;220m3\u001b[28G\u001b[38;2;51;51;51m\u001b[48;2;178;255;178mc = cand\u001b[48;2;220;255;220m(i, k) \u001b[44G  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 284 +\u001b[38;2;51;51;51m                \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mnot\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mNone\u001b[38;2;51;51;51m:                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 285 +\u001b[38;2;51;51;51m                    hpush(heap, c)                                                                    \r\u001b[8C\u001b[1B\u001b[49m\u001b[2m6\u001b[20G\u001b[22mout =\u001b[26G[]\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 287 \u001b[22m         i = \u001b[38;2;0;134;179m0\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;51;51;51m\u001b[2m 288 \u001b[22m         \u001b[38;2;167;29;93mwhile\u001b[38;2;51;51;51m i < n:\r\u001b[2B\u001b[39m \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gheap\u001b[12Gmerge\u001b[18Gmatches\u001b[26Gthe\u001b[30Goriginal\u001b[39Goutput\u001b[46Gon\u001b[49G3,009\u001b[55Gcases\u001b[61Gand\u001b[65Gruns\u001b[70G150\u00d7\u001b[75Gfaster\u001b[82Gon\u001b[85Glong\u001b[90Gprompt"]
[393.277, "s.\u001b[99GNext\u001b[104GI'll\u001b[109Gtry\u001b[113Gfusing\r\u001b[2C\u001b[1Bthe Q/K/V and W1/W3 matmuls\u001b[31Ginto\u001b[36Gsingle\u001b[43Gcalls\u001b[49Gto\u001b[52Gcut\u001b[56Gcall\u001b[61Goverhead.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping\u001b[12Gthe\u001b[16Gfusing\u001b[23Gstep,\u001b[29Gsince\u001b[35Git\u001b[38Gsaves\u001b[44Gonly\u001b[49Gabout\u001b[55G0.3\u001b[59Gms\u001b[62Gper\u001b[66Gtoken\u001b[72Gbut\u001b[76Gadds\u001b[81Groughly\u001b[89G270\u001b[93GMB\u001b[96Gof\u001b[99Gweight\u001b[106Gcopies\u001b[113Gat\u001b[116Gload.\r\u001b[1B \u001b[3GNext I'll run the\u001b[21Gfull check\u001b[33Gedge cas\u001b[42Gs, and an end-to-end\u001b[63Gcomparison\u001b[74Gagainst\u001b[82Gthe\u001b[86Gsaved\u001b[92Gv1.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEnd-to-end results are\u001b[26Gnoisy\u001b[32G(new\u001b[37GGENERATE\u001b[46Gran\u001b[50G2.81\u001b[55Gs\u001b[57Gand\u001b[61G3.41\u001b[66Gs\u001b[68Gin\u001b[71Gtwo\u001b[75Gruns).\u001b[82GI'll\u001b[87Gre-run\u001b[94Gthe\u001b[98Gforward\u001b[106Gmicrobenchmark\r\u001b[2C\u001b[1Bseveral times, alternating old and new, for\u001b[47Ga\u001b[49Gfairer\u001b[56Gcomparison:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3"]
