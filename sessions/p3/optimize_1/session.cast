[146.061, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[22m import time, numpy as\u001b[26Gnp\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrng=\u001b[9Gp.random.def\u001b[22Gult_rng(0)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def bench(f,n=300):\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m   for\u001b[12G_ in range(5): f()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   t=time.perf_coun\u001b[25Ger()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   for _\u001b[14Gin range(n): f()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15G(time.perf_counter()-t)/n*1e6\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m H,hs,S=12,64,1024\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m kc=rng.standard_normal((H,S,hs),dtype=np.float32);\u001b[55Gvc=rng.standard_normal((H,S,hs),dtype=np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mq=rng.standard_normal(H*hs,dtype=np.float32);\u001b[50Gs=np.float32(8.0)\r\u001b[1B \u001b[2m\u2502\u001b[22m for T in (80,1024):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mdef\u001b[12Ga1():\r\u001b[1B \u001b[2m\u2502\u001b[22m         qh=q.reshape(H,1,hs); att=np.matmul(qh,kc[:,:T,:].transpose(0,2,1)); att/=s\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         att-=att.max(axis=-1,keepdims=True); np.exp(att,out=att);\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m att/=att.sum(axis=-1,keepdims=True,dtype=np.float32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[1"]
[146.063, "2G\u001b[22mreturn\u001b[19Gnp.matmul(att,vc[:,:T,:])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     def a2():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mqh=q.reshape(H,hs);\u001b[32Gatt=np.vecdot(kc[:,:T,:],qh[:,None,:]);\u001b[72Gatt/=s\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G att-=att.\u001b[22Gax(axis=-\u001b[32G,keepdims=True); np.exp(att,out=att);\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m att/=att.sum(axis=-1,keepdims=True,dtype=np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gnp.matmul(att[:,None,:],vc[:,:T,:])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     def a3():\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mqh=q.reshape(H,hs,1);\u001b[34Gatt=np.matmul(kc[:,:T,:],qh)[...,0];\u001b[71Gatt/=s\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G att-=att.max(axis=-1,k\u001b[35Gepdims=True); np.exp(att,out=att);\u001b[70G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m att/=at\u001b[12G.sum(axis=-1,ke\u001b[28Gpdims=Tru\u001b[38G,dtype=np.float32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gnp.matmul(att[:,None,:],vc[:,:T,:])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print(T, 'a1 %.0fus\u001b[28Ga2\u001b[31G%.0fus\u001b[38Ga3\u001b[41G%.0fus'%(bench(a1),bench(a2),bench(a3)),\u001b[82Gnp.abs(a1()-a2()).max(),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mnp.abs(a1()-a3()).max())\r\u001b[1B \u001b"]
[146.063, "[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 prof/attn.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 prof/attn.py\u001b[65G\u001b[22mcommands\u001b[74Gin\u001b[77G\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel "]
