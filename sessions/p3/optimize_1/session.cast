[102.59, "\u001b[H\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mComparing BLAS kernels against\u001b[34Graw read bandwidth\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat >> prof/bw.py <<'EOF'\u001b[39m\u001b[K\r\u001b[4C\u001b[1B \u001b[38;2;102;102;102mprint('--- more')\u001b[39m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[38;2;102;102;102mo_=np.empty(d,np.float32)\u001b[32G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B \u001b[5G \u001b[38;2;102;102;102mmore={\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m'einsum ij,j':lambda:[np.einsum('ij,j->i',W,x,out=o_) for W in Ws],\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m'einsum optimize':lambda:[np.einsum('ij,j->i',W,x,out=o_,optimize=True) for W in Ws],\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[6G\u001b[38;2;102;102;102m'vecdot':lambda:[np.vecdot(W,x,out=o_) for W in Ws],\r\u001b[5C\u001b[1B'matvec':lamb\u2026\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[102.591, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1B \u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1B \u001b[38;2;102;102;102mTest non-BLAS NumPy matvec paths\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat >> prof/bw.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('---\u001b[15Gmore')\r\u001b[1B \u001b[2m\u2502\u001b[22m o_=np.empty(d,np.float32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m more={\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m'einsum\u001b[13Gij,j':lambda:[np.einsum('ij,j->i',W,x,out=o_)\u001b[59Gfor\u001b[63GW\u001b[65Gin\u001b[68GWs],\r\u001b[1B \u001b[2m\u2502\u001b[22m  'einsum\u001b[13Goptimize':\u001b[24Gambd\u001b[29G:[np.einsum('ij,j->\u001b[49G',W,x,out=o"]
[102.592, "_,optimize=True)\u001b[77Gfor\u001b[81GW\u001b[83Gin\u001b[86GWs],\r\u001b[1B \u001b[2m\u2502\u001b[22m  'vecdot':lambda:[np.vecdot(W,x,out=o_)\u001b[44Gfor\u001b[48GW\u001b[50Gin\u001b[53GWs],\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m'matvec':lambda:[np.matvec(W,x,out=o_)\u001b[44Gfor\u001b[48GW\u001b[50Gin\u001b[53GWs],\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m'einsum WT j,ji':lambda:[np.einsum('j,ji->i',x,W,out=o_)\u001b[62Gfor\u001b[66GW\u001b[68Gin\u001b[71GWT],\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m}\u001b[6G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor k,f in more.items():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  try: print('%-18s %.0f\u001b[31GGB/s'%(k,\u001b[41Ggb/bench(f,30)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  except Exception as e:\u001b[31Gprint(k,'ERR',e)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mr=np.einsum('ij,j->i',Ws[0],x); print('einsum\u001b[50Gerr',\u001b[56Gnp.abs(r-Ws[0]@x).max())\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3 prof/bw.py 2>&1 | sed -n '/more/,$p'\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[102.593, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
