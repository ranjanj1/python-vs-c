[210.545, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mcat\u001b[8G>\u001b[10Gprof/parts2.py\u001b[25G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsys,\u001b[16Gtime\r\u001b[1B \u001b[2m\u2502\u001b[22m sys.path.insert(0, sys.argv[1])\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m import numpy as np\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m from run import Transformer\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm=Transformer('model.bin')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def bench(f,n=60):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mf();\u001b[13Gt=time.perf_counter()\r\u001b[1B \u001b[2m\u2502\u001b[22m     for _ in range(n):\u001b[27Gf()\u001b[31G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G return (time.pe\u001b[24Gf_counter()-t)/n*1e3\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mx=np.ones(768,np.float32);\u001b[31Gh=np.ones(2048,np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m o768=np.empty(768,np.float32);\u001b[35Go2048=np.empty(2048,np.float32);\u001b[68Go32k=np.empty(32000,np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gmats():\r\u001b[1B \u001b[2m\u2502\u001b[22m     for (ra,wq,wk,wv,wo,rf,w1,w3,w2) in\u001b[44Gm.layers:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         np.vec\u001b[19Got(wq,x,out=o768);np.vecdot(wk,x,out=o768.reshape(12,64));np.vecdot(wv,x,out=o768.reshape(12,64));np.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mvecdo"]
[210.546, "t(wo,x,out=o768)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         np.vecdot(w1,x,out=o2048);np.vecdot(w3,x,out=o2048);np.vecdot(w2,h,out=o768)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mnp.vecdot(m.wcls,x,out=o32k)\r\u001b[1B \u001b[2m\u2502\u001b[22m mt=bench(mat\u001b[17G)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m m.reset()\u001b[14G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gp\u001b[10Gin\u001b[13Grange(80):\u001b[24Gm.forward(5,p)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ft=bench(lambda: m.forward(5,80))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint('matmuls\u001b[19G%.2f\u001b[24Gms,\u001b[28Gforward@80\u001b[39G%.2f\u001b[44Gms,\u001b[48Goverhead\u001b[57G%.2f\u001b[62Gms'%(mt,ft,ft-mt))\r\u001b[1B \u001b[2m\u2502\u001b[22m # dtype audit\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import numpy\u001b[17Gas _n\u001b[23G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22morig=_np.ndarray\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m x=m.x; print('ss dtype', _np.vecdot(x,x).dtype,\u001b[52G(m.one/_np.sqrt(_np.vecdot(x,x)/m.fdim+m.eps)).dtype,\u001b[106Gm.rope.dtype,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm.logits.dtype)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 pr\u001b[15Gf/parts2.py .\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
