[446.792, "out 0.3 ms per token but \u001b[77Gdd\u001b[80G roughly 270 MB\u001b[96Gof\u001b[99Gweight\u001b[106Gcopies\u001b[113Gat\u001b[116Gload.\r\u001b[2C\u001b[1BNext\u001b[8GI'll\u001b[13Grun\u001b[17Gthe\u001b[21Gfull\u001b[26Gcheck,\u001b[33Gedge\u001b[38Gcases,\u001b[45Gand\u001b[49Gan\u001b[52Gend-to-end\u001b[63Gcomparison\u001b[74Gagainst\u001b[82Gthe\u001b[86Gsaved\u001b[92Gv1.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEnd-to-end results are noisy (new GENERATE r\u001b[48Gn 2.81 s and 3.41 s\u001b[68Gin\u001b[71Gtwo\u001b[75Gruns).\u001b[82GI'll\u001b[87Gre-run\u001b[94Gthe\u001b[98Gforward\u001b[106Gmicrobenchmark\r\u001b[2C\u001b[1Bseveral\u001b[11Gtimes,\u001b[18Galternating\u001b[30Gold\u001b[34Gand\u001b[38Gnew,\u001b[43Gfor\u001b[47Ga\u001b[49Gfairer\u001b[56Gcomparison:\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Interleaved forward benchmark old vs new\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i\u001b[14Gin 1 2\u001b[21G3; do echo \"v1: $(python3 prof/bench.py prof | tr '\\n' ' ')\"; echo \"new: $(python3 prof/bench.py . |\r\u001b[5C\u001b[1Btr '\\n'\u001b[14G' ')\";\u001b[21Gdone\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
