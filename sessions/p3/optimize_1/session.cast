[253.304, "                                                           \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 279 +\u001b[38;2;51;51;51m            p = prv[i]                                                                                \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 280 +\u001b[38;2;51;51;51m            before = \u001b[38;2;0;134;179mlen\u001b[38;2;51;51;51m(heap)                                                                        \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 281 +\u001b[38;2;51;51;51m            \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m p >= \u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m:                                                                                \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 282 +\u001b[38;2;51;51;51m                push(p, i)                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 283 +\u001b[38;2;51;51;51m            \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m k < n:                                                                "]
