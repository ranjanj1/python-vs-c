[57.455, "\u001b[H\u001b[5G- \u001b[38;2;87;105;247mmax\u001b[11G\u001b[39mafter\u001b[17G\u001b[38;2;87;105;247mmax_new\u001b[25G\u001b[39mtokens.\u001b[33GIf\u001b[36Gthat\u001b[41Glimit\u001b[47Gand\u001b[51Gthe\u001b[55Gcontext\u001b[63Glimit\u001b[69Gare\u001b[73Ghit\u001b[77Gtogether,\u001b[87G\u001b[38;2;87;105;247mmax\u001b[91G\u001b[39mis\u001b[94Greported.\r\u001b[4C\u001b[1B- \u001b[38;2;87;105;247mcontext\u001b[39m at seq_len (1,024) positions: a 1,021-token prompt gave \u001b[38;2;87;105;247mDONE 4 context\u001b[39m, which\u001b[93Gmatches\u001b[101Gthe\u001b[105Greference.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations (also in \u001b[38;2;87;105;247mNOTES.md\u001b[39m)\r\u001b[1B\u001b[22m  - \u001b[38;2;87;105;247mINTERFACE.md\u001b[39m doesn't say what \u001b[38;2;87;105;247mPIECE\u001b[39m should print when the piece decodes to nothing (for example the zero byte). I\u001b[K\r\u001b[1C\u001b[1B   print \u001b[38;2;87;105;247mHEX \u001b[16G\u001b[39mwith\u001b[21Gan\u001b[24Gempty\u001b[30Ghex\u001b[34Gstring\u001b[41Gand\u001b[45Ga\u001b[47Gtrailing\u001b[56Gspace;\u001b[63Gthe\u001b[67Gfinal\u001b[73Ggate\u001b[78Gmay\u001b[82Gexpect\u001b[89Gsomething\u001b[99Gdifferent.\r\u001b[1C\u001b[1B - The sums are added in a different order than the C loops, which causes the ~1e-5\u001b[86Gdifferences.\u001b[99GIf\u001b[102Gtwo\u001b[106Gtop\u001b[110Gscores\u001b[11"]
[57.456, "7Gare\r\u001b[1C\u001b[1B   almost tied, the chosen token could\u001b[41Gin\u001b[44Gprinciple\u001b[54Gdiffer\u001b[61Gfrom\u001b[66Gthe\u001b[70Greference.\r\u001b[1B  - \u001b[38;2;87;105;247mFIXED\u001b[39m and \u001b[38;2;87;105;247mLOGITS\u001b[39m with more than 1,024 ids aren't supported.\u001b[K\r\u001b[1C\u001b[1B - Speed is roughly 13 ms per token;\u001b[39Gthat's\u001b[46Ga\u001b[48Grough\u001b[54Gfigure\u001b[61Gfrom\u001b[66Gone\u001b[70Grun\u001b[74Gthat\u001b[79Gincludes\u001b[88Gload\u001b[93Gtime.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B The harness, fixtures, \u001b[27Gules and\u001b[36Greference\u001b[46Gare\u001b[50Gunchanged.\u001b[61GThe\u001b[65Gcommands\u001b[74GI\u001b[76Gran\u001b[80Gand\u001b[84Ga\u001b[86Gsummary\u001b[94Gof\u001b[97Gthe\u001b[101Gchanges\u001b[109Gare\u001b[113Grecorded\r\u001b[1C\u001b[1B in \u001b[38;2;87;105;247mNOTES.md\u001b[39m.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mCogitated for 3m 1s \u00b7 done 3:42 PM\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirement"]
[57.457, "s. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchma\u001b[11Gking matvec layouts and shapes\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/variants.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mimport time, numpy as np\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mrng=np.random.default_rng(0)\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mdef bench(f,n=200):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mfor _ in range(5): f()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mt=time.perf_counter()\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mfor _ in range(n): f()\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mreturn (time.perf_counter()-t)/n*1e6\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mL=12\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mfor (d,n) in [(768,768),(2048,768),(768,2048),(2304,768),(4096,768),(32000,768)]:\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m\u2026\u001b[39m\u001b[K\r\u001b"]
