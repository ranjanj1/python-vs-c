[258.236, "7C\u001b[1B\u001b[38;2;36;138;61m90\u001b[24G\u001b[38;2;51;51;51m    new = heap[before:]                                                                   \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m91\u001b[28G\u001b[38;2;167;29;93mdel\u001b[38;2;51;51;51m heap[before:]\r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m92\u001b[24G\u001b[38;2;51;51;51m    \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m e \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m new:                                              \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m93\u001b[24G\u001b[38;2;51;51;51m \u001b[26G \u001b[28G    hpush(heap, e)                                                                    \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m94\u001b[20G\u001b[38;2;51;51;51mout\u001b[24G= []                                                                                      \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m5\u001b[20G\u001b[38;2;51;51;51mi\u001b[22G=\u001b[24G\u001b[38;2;0;134;179m0\u001b[38;2;51;51;51m                                                                                         \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m6\u001b[20G\u001b[38;2;167;29;93mwhile\u001b[38;2;51;51;51m i < n:             \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m7\u001b[24G\u001b[38;2;51;51;51mout.append(t"]
[258.237, "ok[i])                                                                        \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m8\u001b[24G\u001b[38;2;51;51;51mi\u001b[26G=\u001b[28Gnxt[i]         \u001b[44G  \r\u001b[8C\u001b[1B\u001b[38;2;36;138;61m9\u001b[20G\u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m out                                                                                    \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m300\u001b[20G\u001b[38;2;51;51;51m \u001b[22G \u001b[24G                                                                                          \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m301\u001b[20G\u001b[38;2;51;51;51m                                                                                              \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 302 \u001b[22m \u001b[38;2;150;152;150m# ----------------------------------------------------------------------------\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 303 \u001b[22m \u001b[38;2;150;152;150m# command loop\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat push/re-push step is clumsy; simplifying it:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1m"]
[258.237, "Update\u001b[22m(run.py)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[39m \u001b[38;2;87;105;247m\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mrun.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;102;102;102m\u2026\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[258.238, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Do you want to make this edit to \u001b[1mrun.py\u001b[22m?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to \u001b[1maccept edits (auto-approve file edits and common file commands)\u001b[22m for this session \u001b[1m(shift+tab)\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
[258.252, "\u001b[H\u001b[7G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m300\u001b[28G\u001b[38;2;51;51;51m       \u001b[36G  \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61m301\u001b[24G\u001b[38;2;51;51;51m                                                                                          \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 302 \u001b[22m \u001b[38;2;150;152;150m# ----------------------------------------------------------------------------\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 303 \u001b[22m \u001b[38;2;150;152;150m# command loop\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 304 \u001b[22m \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThat push/re-push step is clumsy; simplifying it:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[258.253, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mEdit file\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mrun.py\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 255 \u001b[22m         nxt = \u001b[38;2;0;134;179mlist\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, n + \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m))      \u001b[38;2;150;152;150m# nxt[i] == n means no right neighbour\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 256 \u001b[22m         prv = \u001b[38;2;0;134;179mlist\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(-\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, n - \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m))\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 257 \u001b[22m         alive = [\u001b"]
[258.254, "[38;2;0;134;179mTrue\u001b[38;2;51;51;51m] * n\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 258 -\u001b[38;2;51;51;51m        heap = []                                                                                                 \r\u001b[1B\u001b[38;2;207;34;46m 259 -\u001b[38;2;51;51;51m                                                                                                                  \r\u001b[1B\u001b[38;2;207;34;46m 260 -\u001b[38;2;51;51;51m        def push(i, j):                                                                                           \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 258 +\u001b[38;2;51;51;51m        \u001b[38;2;167;29;93mdef\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mcand\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mi, j\u001b[38;2;51;51;51m):                                                                                           \r\u001b[1B\u001b[49m\u001b[2m 259 \u001b[22m     \u001b[12G       tid = lookup.get(vocab[tok[i]] + vocab[tok[j]], -\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m)\r\u001b[1B\u001b[2m 260 \u001b[22m     \u001b[12G       \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m tid != -"]
[258.256, "\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m scores[tid] > floor:\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 263 -\u001b[38;2;51;51;51m                \u001b[48;2;255;199;199mheap.append\u001b[48;2;255;220;220m(\u001b[48;2;255;199;199m(\u001b[48;2;255;220;220m-scores[tid], i, j, tok[i], tok[j], tid)\u001b[48;2;255;199;199m)\u001b[48;2;255;220;220m                                            \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 261 +\u001b[38;2;51;51;51m                \u001b[38;2;167;29;93m\u001b[48;2;178;255;178mreturn\u001b[38;2;51;51;51m \u001b[48;2;220;255;220m(-scores[tid], i, j, tok[i], tok[j], tid)                                                  \r\u001b[1B\u001b[38;2;36;138;61m 262 +\u001b[38;2;51;51;51m            \u001b[38;2;167;29;93mreturn\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mNone\u001b[38;2;51;51;51m                                                                                           \r\u001b[1B\u001b[49m\u001b[2m 263 \u001b[22m \u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 265 -\u001b[38;2;51;51;51m        for i in range(n - 1):                                           "]
[258.257, "                                         \r\u001b[1B\u001b[38;2;207;34;46m 266 -\u001b[38;2;51;51;51m            push(i, i + 1)                                                                                        \r\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 264 +\u001b[38;2;51;51;51m        heap = [c \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m (cand(i, i + \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m) \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m i \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(n - \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m)) \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m c \u001b[38;2;167;29;93mis\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mnot\u001b[38;2;51;51;51m \u001b[38;2;0;134;179mNone\u001b[38;2;51;51;51m]                               \r\u001b[1B\u001b[49m\u001b[2m 265 \u001b[22m         heapq.heapify(heap)\r\u001b[1B\u001b[2m 266 \u001b[22m         hpush, hpop = heapq.heappush, heapq.heappop\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 267 \u001b[22m         \u001b[38;2;167;29;93mwhile\u001b[38;2;51;51;51m heap:\u001b[39m\u001b[40;1H\u001b[36;2H"]
