[259.0, "lifying it:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;44;122;57m\u23fa\u001b[3G\u001b[39m\u001b[1mUpdate\u001b[22m(run.py)\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf \u00a0\u001b[39mAdded \u001b[1m4\u001b[22m lines, removed \u001b[1m6\u001b[22m lines\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 255 \u001b[22m         nxt = \u001b[38;2;0;134;179mlist\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, n + \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m))      \u001b[38;2;150;152;150m# nxt[i] == n means no right neighbour\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 256 \u001b[22m         prv = \u001b[38;2;0;134;179mlist\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mrange\u001b[38;2;51;51;51m(-\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m, n - \u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m))\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 257 \u001b[22m         alive = [\u001b[38;2;0;134;179mTrue\u001b[38;2;51;51;51m] * n\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 258 -\u001b[38;2;51;51;51m        heap = []                                                                                     \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 259 -\u001b[38;2;51;51;51m                                "]
[259.001, "                                                                      \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m 260 -\u001b[38;2;51;51;51m        def push(i, j):                                                                               \r\u001b[7C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m58\u001b[20G\u001b[38;2;167;29;93mdef\u001b[38;2;51;51;51m \u001b[38;2;121;93;163mcand\u001b[38;2;51;51;51m(\u001b[38;2;0;134;179mi, j\u001b[38;2;51;51;51m):\r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 259 \u001b[22m             tid = lookup.get(vocab[tok[i]] + vocab[tok[j]], -\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 260 \u001b[22m             \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m tid != -\u001b[38;2;0;134;179m1\u001b[38;2;51;51;51m \u001b[38;2;167;29;93mand\u001b[38;2;51;51;51m scores[tid] > floor:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m 263 -\u001b[38;2;51;51;51m                \u001b[48;2;255;199;199mheap.append\u001b[48;2;255;220;220m(\u001b[48;2;255;199;199m(\u001b[48;2;255;220;220m-scores[tid], i, j, tok[i], tok[j], tid)\u001b[48;2;255;199;199m)\u001b[48;2;255;220;220m                                \r\u001b[6C\u001b[1B\u001b[38;2;36;138;61"]
