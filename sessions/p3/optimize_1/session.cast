[4.119, "\u001b[1B \u001b[5GAccelerate library).\u001b[26GEve\u001b[30Gy layer runs and full logits\u001b[59Gare\u001b[63Gcomputed at every step. Nothing is \u001b[99Gonverted to float64,\u001b[K\r\u001b[4C\u001b[1Bno threads are started,\u001b[29Gand no thread counts are set.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mKV cache:\u001b[22m every command starts at po\u001b[42Gition 0 with a cleared cach\u001b[70G.\u001b[72GThe cache is stored per atte\u001b[101Gtion head\u001b[111Gso each\u001b[K\r\u001b[4C\u001b[1Bhead's data sit\u001b[21G tog\u001b[26Gther in memo\u001b[39Gy.\u001b[K\r\u001b[4C\u001b[1B\u001b[1mTokeniz\u001b[13Gr:\u001b[22m a b\u001b[20Gte-for-byte port of the reference \u001b[38;2;87;105;247mencode\u001b[39m an\u001b[65G\u001b[38;2;87;105;247mdecode\u001b[39m. Input is\u001b[82Gread as raw bytes and only the final\r\u001b[4C\u001b[1Bn\u001b[7Gwline is removed, so leading, t\u001b[39Gailing\u001b[46Gand\u001b[50Grepeated\u001b[59Gspaces\u001b[66Gand\u001b[70Gtabs\u001b[75Gare\u001b[79Gkept.\r\u001b[4C\u001b[1B\u001b[1mGENERATE stop rules:\u001b[22m prompt tokens\u001b[40Gar\u001b[44Gforced, then each \u001b[63Gew token is the\u001b[79Ghigh\u001b[84Gst-sco\u001b[91Ging on\u001b[98G,\u001b[100Gwith the\u001b[109Glowest index\r\u001b[4C\u001b[1Bwinn\u001b[11Gg\u001b[13Gties. I tested\u001b[28Gall three endings:\u001b[K\r\u001b[2C\u001b[1B \u001b[5G- \u001b[38;2;87;105;247mstop"]
