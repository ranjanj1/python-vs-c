[626.088, "\u001b[H\u001b[3Gsupplied\u001b[12Gprompts.\u001b[21GEncoding\u001b[30Glong\u001b[35Gprompts\u001b[43Gis\u001b[46Gnow\u001b[50Gabout\u001b[56G150\u00d7\u001b[61Gfaster.\u001b[69GBoth\u001b[74G\u001b[38;2;87;105;247mcheck.py\u001b[83G\u001b[39mruns\u001b[88Gstill\u001b[94Gpass,\u001b[100Gthe\u001b[104Gquick\u001b[110Gone\u001b[114Gand\r\u001b[2C\u001b[1Bthe full one (3 prompts,\u001b[28G64\u001b[31Gtokens),\u001b[40Gwith\u001b[45Ga\u001b[47Glargest\u001b[55Glogit\u001b[61Gerror\u001b[67Gof\u001b[70G2.7e-5\u001b[77Gagainst\u001b[85Gthe\u001b[89G5e-4\u001b[94Glimit.\r\u001b[2B \u001b[3G\u001b[1mWhat the profiling showed\u001b[29G\u001b[22m\u001b[K\r\u001b[2C\u001b[1B- In the\u001b[12Gfirst version, the matrix-vector pr\u001b[48Gducts \u001b[55Gook 12.4 ms of the\u001b[74G13.5 ms per token. Th\u001b[96Gt's\u001b[100Greading the 438 MB\u001b[119Gof\r\u001b[2C\u001b[1B  weights at\u001b[16Gabout 35 GB/s,\u001b[31Gs\u001b[33G speed\u001b[40Gis limited by memory\u001b[61Greads, not arithmet\u001b[81Gc.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GNumPy's\u001b[13G\u001b[38;2;87;105;247mnp.vecdot\u001b[23G\u001b[39mreads\u001b[29Gthe\u001b[33Gsame\u001b[38Gweights\u001b[46Gat\u001b[49G43\u201347\u001b[55GGB/s,\u001b[61Gversus\u001b[68Gabout\u001b[74G35\u001b[77GGB/s\u001b[82Gfor\u001b[86GAccelerate's\u001b[99Gmatrix-vector\u001b[113Groutine\r\u001b[2C\u001b[1B  (\u001b[38;2;87;105;247mnp.dot\u001b[39m). It does the same\u001b[32Grow-by-row\u001b[43Gfloat32\u001b[51Gdot\u001b[55Gp"]
[626.09, "roducts\u001b[64Gwith\u001b[69Gabout\u001b[75Gthe\u001b[79Gsame\u001b[84Grounding\u001b[93Gerror.\r\u001b[4C\u001b[1BThe prompt \u001b[17Gok\u001b[20Gnizer took\u001b[31Gtime proportional to the square of the\u001b[70Gprompt length: 770 ms for a 1,021-token prompt,\u001b[K\r\u001b[5C\u001b[1Bh\u001b[8Gc\u001b[10G cos\u001b[15Gs as much\u001b[25Gas about\u001b[34G70 forward passes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChanges\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. All matrix-vector products now use \u001b[38;2;87;105;247mnp.vecdot\u001b[39m,\u001b[52Gstill as separat\u001b[70Gcalls with \u001b[83Ge\u001b[85Gsame \u001b[91Ghapes.\u001b[98GThat part of each token\r\u001b[4C\u001b[1B went\u001b[11Gfrom 12.4 ms to 10.4 ms.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6GK\u001b[8Gand\u001b[12GV\u001b[14Gare\u001b[18Gwritten\u001b[26Gdirectly\u001b[35Ginto\u001b[40Gtheir\u001b[46Gslot\u001b[51Gin\u001b[54Gthe\u001b[58Gcache,\u001b[65Gand\u001b[69Gthe\u001b[73Gposition\u001b[82Grotation\u001b[91G(RoPE)\u001b[98Gis\u001b[101Gdone\u001b[106Gthere\u001b[112Gas\u001b[115Ga\r\u001b[2C\u001b[1B   float32\u001b[14Gcomplex\u001b[22Gmultiply\u001b[31Gusing\u001b[37Gthe\u001b[41Greference\u001b[51Gformula.\u001b[60GI\u001b[62Galso\u001b[67Gremoved\u001b[75Gtemporary\u001b[85Garrays\u001b[92Gand\u001b[96Gextra\u001b[102Gcalls.\u001b[109GOther\r\u001b[2C\u001b[1B  \u001b[6Gper-token work fell from about\u001b[37G1.1\u001b[41Gms to 0.5 m\u001b[53G, and everythi"]
[626.09, "ng\u001b[70Gstay\u001b[76Gfloat32.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GThe tokenizer's merge step now\u001b[37Gpicks\u001b[43Gmerges\u001b[50Gfrom\u001b[55Ga\u001b[57Gpriority\u001b[66Gqueue,\u001b[73Gin\u001b[76Gexactly\u001b[84Gthe\u001b[88Gorder\u001b[94Gthe\u001b[98Greference\u001b[108Gloop\u001b[113Gpicks\r\u001b[2C\u001b[1B  \u001b[6Gthem.\u001b[12GIt gave \u001b[21Gdentical token ids\u001b[40Gon 3,009 \u001b[50Gest\u001b[54Ginputs. A 1,021-token prompt now encodes in\u001b[98G4.8 ms instead of 770\r\u001b[5C\u001b[1Bms.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOver the full command protocol (best of\u001b[43G2 \u001b[46Gun\u001b[49G), the total went from 22.9 s to 18.7 s. The\u001b[94G1,021-tok\u001b[105G prompt\u001b[113Grun\u001b[K\r\u001b[2C\u001b[1Bdropp\u001b[9Gd from 16.3 s to 13.0 s.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mCombining weight matrices:\u001b[22m merging\u001b[40GQ/K/V a\u001b[48Gd W1/W3\u001b[56Gin\u001b[59Go single calls saves \u001b[81Gnly about 0.3 ms per token. It wo\u001b[115Gld\r\u001b[2C\u001b[1B  need about\u001b[16G270 MB\u001b[23Gof\u001b[26Gcopying\u001b[34Gat\u001b[37Gload,\u001b[43Gwhich\u001b[49Gloses\u001b[55Gon\u001b[58Gshort\u001b[64Gruns.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTransposed weights:\u001b[25G\u001b[22msimilar\u001b[33Gspeed,\u001b[40Gbut\u001b[44G5\u20137\u00d7\u001b[49Gmore\u001b[54Grounding\u001b[63Gerror.\r\u001b[2C"]
[626.091, "\u001b[1B- \u001b[1mProcessing the whole prompt at once:\u001b[42G\u001b[22mreading\u001b[50Gthe\u001b[54Gweights\u001b[62Gonce\u001b[67Gper\u001b[71Gprompt\u001b[78Ginstead\u001b[86Gof\u001b[89Gonce\u001b[94Gper\u001b[98Gtoken\u001b[104Gwould\u001b[110Gbe\u001b[113Gmuch\r\u001b[4C\u001b[1Bfaster.\u001b[13GI\u001b[15Gdidn't\u001b[22Gdo\u001b[25Git\u001b[28Gbecause\u001b[36Gthe\u001b[40Grules\u001b[46Grequire\u001b[54Gbatch\u001b[60Gsize\u001b[65G1\u001b[67Gand\u001b[71Gthe\u001b[75Greference's\u001b[87Gcache-filling\u001b[101Gorder.\u001b[108GIf\u001b[111Gyou\u001b[115Gread\r\u001b[2C\u001b[1B \u001b[5Gthe rules differently, that is the\u001b[40Gmain remaining speedup; it's your\u001b[74Gc\u001b[76Gll.\u001b[80G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitati\u001b[12Gns\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[K\u001b[40;1H\u001b[38;3H"]
