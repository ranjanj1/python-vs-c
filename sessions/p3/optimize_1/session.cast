[297.207, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6GEnd-to-end protocol timing on the development prompts (fixtures.json): startup, GENERATE 64, LOGITS, long prompt.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport subprocess, sys, time, json, tempfile, os\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprog = sys.argv[1:]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfx = json.load(open('fixtures.json'))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt0 = time.perf_counter()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mp\u001b[6G= subprocess.Popen(prog + ['model.bin', 'tokenizer.bin'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtext=True, bufsize=1)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert p.stdout.readline().strip() == 'READY'; t_ready = time.perf_counter() - t0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef run(cmd):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  p.stdin.write(cmd + '\\n'); p.stdin.flush(); out = []\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  while True:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      s = p.stdout.readline().strip(); out.append(s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m      if s.startswith('DONE'): return out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mres = {'ready"]
[297.208, "': t_ready}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt\u001b[6G= time.perf_counter(); outs = [run('GENERATE 64 ' + pr['text']) for pr in fx['prompts']]; res['generate3x64']\u001b[116G=\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtime.perf_counter() - t\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22massert all([int(s[2:]) for s in o[:-1]] == pr['ids'] for o, pr in zip(outs, fx['prompts']))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mwith tempfile.TemporaryDirectory()\u001b[39Gas\u001b[42Gd:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m  t = time.perf_counter();\u001b[33G[run(f'LOGITS\u001b[47G{d}/l.f32\u001b[57G'\u001b[59G+\u001b[61G'\u001b[63G'.join(map(str,\u001b[79Gpr['seq'])))\u001b[92Gfor\u001b[96Gpr\u001b[99Gin\u001b[102Gfx['prompts']];\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mres['logits3'] = time.perf_counter()\u001b[41G-\u001b[43Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mlong\u001b[9G=\u001b[11G'\u001b[13G'.join(['cat']\u001b[28G*\u001b[30G1020)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m t = time.perf_counter();\u001b[29Go\u001b[31G=\u001b[33Grun('GENERATE\u001b[47G50\u001b[50G'\u001b[52G+\u001b[54Glong);\u001b[61Gres['long_prompt_1021']\u001b[85G=\u001b[87Gtime.perf_counter()\u001b[107G-\u001b[109Gt;\u001b[112Gassert\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mo[-1]\u001b[10G==\u001b[13G'DONE\u001b[19G4\u001b[21Gcontext',\u001b[31Go[-1]\r\u001b[1B \u001b[2m\u2502\u001b[22m p.std"]
[297.209, "in.writ\u001b[17G('QUIT\\n'); p.std\u001b[36G.flush();\u001b[46Gp.wait(); res['total'] = time.perf_c\u001b[83Gunter() - t0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print(' '.join('%s=%.2fs' % kv for kv in re\u001b[48G.items()), 'exit', p.returncode)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for i in 1 2; do echo\u001b[26G\"v1:\u001b[32G$(python3\u001b[42Gprof/e2e.py\u001b[54Gpython3\u001b[62Gprof/run_v1.py)\";\u001b[80Gecho\u001b[85G\"new:\u001b[91G$(python3\u001b[101Gprof/e2e.py\u001b[113Gpython3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrun.py)\";\u001b[14Gdone\r\u001b[1B \u001b[2m\u2502\u001b[22m pytho\u001b[10G3\u001b[12Gc\u001b[15Gck.py -- python3 run.py | tail -1; python3 check.py --tokens\u001b[76G64 --prompts\u001b[89G3 -- python3 run.py\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m printf 'PIECE 1 9038\\nPIECE 9038 3\\nPIECE 5 13\\nFIXED 1 9038 2501\\nFIXED\\nGENERATE 0 hi\\nGENERATE\u001b[102G5\u001b[104G\\nENCODE\\nENCODE\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22mleading\u001b[13Gspace\\nQUIT\\n'\u001b[28G|\u001b[30Gpython3\u001b[38Grun.py\u001b[45Gmodel.bin\u001b[55Gtokenizer.bin;\u001b[70Gecho\u001b[75G\"exit\u001b[81G$?\"\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[297.21, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
