[612.68, "\u001b[H\u001b[6G\u001b[38;2;207;34;46m\u001b[48;2;255;220;220m  39 -\u001b[38;2;51;51;51m  empty hex string (trailing space). INTERFACE.md does not pin this down.                             \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  40 -\u001b[38;2;51;51;51m- Summation order differs from the C scalar loops (BLAS sgemv/sdot, NumPy pairwise sums), so logits   \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  41 -\u001b[38;2;51;51;51m  differ from the reference by ~1e-5 (well inside the 5e-4 tolerance); argmax near-ties could in princ\r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m     -\u001b[38;2;51;51;51miple flip.                                                                                            \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  42 -\u001b[38;2;51;51;51m- Argmax with NaN logits would follow NumPy (first NaN) rather than C's comparison semantics; not expe\r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m     -\u001b[38;2;51;51;51mcted.                                                                                                 \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m  43 -\u001b[38;2;51;51;51m- FIXED/LOGITS with more id"]
[612.681, "s than seq_len is not supported (the reference would overrun its cache too)\r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m     -\u001b[38;2;51;51;51m.                                                                                                     \u001b[49m\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m  44 -\u001b[38;2;51;51;51m- Rough speed on this machine: ~13 ms/token including Python overhead (238 generated tokens + load in \r\u001b[5C\u001b[1B\u001b[38;2;207;34;46m     -\u001b[38;2;51;51;51m~3.6 s).                                                                                              \r\u001b[2C\u001b[1B\u001b[49m\u001b[39m   \u001b[38;2;207;34;46m\u001b[48;2;255;220;220m  45 -\u001b[38;2;51;51;51m- Harness, fixtures, rules and reference were not modified. Only check.py's public inputs were used.  \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 114 +\u001b[38;2;51;51;51m## Remaining limitations                                                                              \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 115 +\u001b[38;2;51;51;51"]
