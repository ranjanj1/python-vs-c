[183.149, "[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNumPy's\u001b[11Gown\u001b[15GSIMD\u001b[20Gloops\u001b[26Gbeat\u001b[31GAccelerate's\u001b[44Gsgemv\u001b[50Gon\u001b[53Gthese\u001b[59Gtransposed\u001b[70Gweights,\u001b[79Gat\u001b[82Gabout\u001b[88G48\u001b[91GGB/s\u001b[96Gagainst\u001b[104G36\u001b[107GGB/s,\u001b[113Gand\u001b[117Gthe\r\u001b[1B \u001b[3Gaccumulation order match\u001b[28Gs the reference\u001b[44Gloop.\u001b[50GI'm checking all the real \u001b[77Ghapes nex\u001b[87G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mvecdot\u001b[10G\u001b[39mreaches\u001b[18Gabout\u001b[24G43\u201347\u001b[30GGB/s\u001b[35Gwith\u001b[40Gno\u001b[43Glayout\u001b[50Gchange\u001b[57Gor\u001b[60Gextra\u001b[66Gload\u001b[71Gcost,\u001b[77Gand\u001b[81Gits\u001b[85Gerror\u001b[91Gis\u001b[94Gclose\u001b[100Gto\u001b[103Ggemv's\u001b[110Gwhile\r\u001b[1B \u001b[3Gtranspos\u001b[12Gd einsum's is 5\u2013\u001b[29G\u00d7 larger. Next I'll measur\u001b[57Gnon-matmu\u001b[67G overhead\u001b[78Gt short and long c\u001b[97Gntexts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gis\u001b[16Galready\u001b[24Gnear\u001b[29Gmemory\u001b[36Gspeed\u001b[42G(~120\u001b[48G\u00b5s/l"]
