[211.208, ";2;102;102;102mfrom run import Transformer\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mm=Transformer('model.bin')\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mdef bench(f,n=60):\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mf(); t=time.perf_counter()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mfor _ in range(n): f()\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mreturn (time.perf_counter()-t)/n*1e3\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mx=np.ones(768,np.float32); h=np.ones(20\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[39m \u001b[38;2;241;145;113mZigzagging\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(3m 20s \u00b7 \u2193\u001b[27G14.0k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G   \u001b[40G   \u001b[44G                        \u001b[69G        \u001b[78G  \u001b[81G                      \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
