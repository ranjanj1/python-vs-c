[124.735, "\u001b[H\u001b[5G \u001b[38;2;102;102;102mreturn (time.perf_counter()-t)/n\u001b[39G\u001b[39m\u001b[K\r\u001b[4C\u001b[1B \u001b[38;2;102;102;102mfor (d,n,L) in [(768,768,48),(2048,768,24),(768,2048,12),(32000,768,1)]:\u001b[39m\u001b[K\r\u001b[4C\u001b[1B \u001b[38;2;102;102;102mWs=[rng.standard_norm\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mBenchmark matvec variants at real model shapes\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[124.737, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat > prof/shapes.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m im\u001b[7Gort\u001b[11Gtime, numpy as np\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrng=np.random.default_rng(0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m d\u001b[6Gf be\u001b[11Gch(f,n=60):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  for _ in\u001b[17Grange(3):\u001b[27Gf()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mt=time.perf_counter()\r\u001b[1B \u001b[2m\u2502\u001b[22m     for _ in range(n): f()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15G(time.perf_counter()-t)/n\r\u001b[1B \u001b[2m\u2502\u001b[22m for (d,n,L) in [(768,768,48),(2048,768,24),(768,2048,12),(32000,768,1)]:\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     Ws=[rng.standard_normal((d,n),dtype=np.float32) for _ in range(L)]\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     WT=[np.ascontiguousarray(W.T) for W in Ws]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mx=rng.standard_normal(n,dtype=np.float32);\u001b[51Go=np.empty(d,np.float32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     gb=d*n*4"]
[124.738, "*L/1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mr={'gemv':lambda:[np.dot(W,x,out=o)\u001b[44Gfor\u001b[48GW\u001b[50Gin\u001b[53GWs],\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G'v\u001b[14Gcdot':lambda:[np.vecdot(W,x,out=o) for W in Ws],\u001b[63G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G    'einsumT':lambda:[np.einsum('j,ji->i',x,W,out=o)\u001b[60Gfor\u001b[64GW\u001b[66Gin\u001b[69GWT]}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint((d,n,L),\u001b[23G'\u001b[25G'.join('%s\u001b[36G%.0fGB/s'%(k,gb/bench(f))\u001b[62Gfor\u001b[66Gk,f\u001b[70Gin\u001b[73Gr.items()))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     W=Ws[0].astype(np.float64);\u001b[36Gref=W@x.astype(np.float64)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint('\u001b[18Gerrs',\u001b[25G'gemv\u001b[31G%.2e'%np.abs(np.dot(Ws[0],x)-ref).max(),\u001b[72G'vecdot\r\u001b[1B \u001b[2m\u2502\u001b[22m %.2e\u001b[9G%np.abs(np.vecdot(Ws[0],x)-ref).max(), 'ei\u001b[52GsumT %.2e'%n\u001b[65G.abs(np.ein\u001b[77Gum('j,ji->i',x,WT[0])-ref).max())\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/shapes.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[124.738, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
