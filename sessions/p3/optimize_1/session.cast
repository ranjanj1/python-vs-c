[450.433, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe heap merge matches the original output on 3,009 cases and runs 150\u00d7 faster on long prompts. Next I'll try fusing\r\u001b[2C\u001b[1Bthe Q/K/V and W1/W3 matmuls into single calls to cut call overhead.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping the fusing step, since it saves only about 0.3 ms per token but adds roughly 270 MB of weight copies at\u001b[116Gload.\r\u001b[2C\u001b[1BNext I'll run the full check,\u001b[33Gedge\u001b[38Gcases,\u001b[45Gand\u001b[49Gan\u001b[52Gend-to-end\u001b[63Gcomparison\u001b[74Gagainst\u001b[82Gthe\u001b[86Gsaved\u001b[92Gv1.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEnd-to-end results are\u001b[26Gnoisy\u001b[32G(new\u001b[37GGENERATE\u001b[46Gran\u001b[50G2.81\u001b[55Gs\u001b[57Gand\u001b[61G3.41\u001b[66Gs\u001b[68Gin\u001b[71Gtwo\u001b[75Gruns).\u001b[82GI'll\u001b[87Gre-run\u001b[94Gthe\u001b[98Gforward\u001b[106Gmicrobenchmark\r\u001b[2C\u001b[1Bseveral\u001b[11Gti"]
