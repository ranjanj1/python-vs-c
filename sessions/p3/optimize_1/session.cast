[106.398, "\u001b[H\u001b[3G\u001b[1mLimitations (also in \u001b[38;2;87;105;247mNOTES.md\u001b[39m)\r\u001b[2C\u001b[1B\u001b[22m- \u001b[38;2;87;105;247mINTERFACE.md\u001b[39m doesn't say what\u001b[35G\u001b[38;2;87;105;247mPIECE\u001b[41G\u001b[39mshould\u001b[48Gprint\u001b[54Gwhen\u001b[59Gthe\u001b[63Gpiece\u001b[69Gdecodes\u001b[77Gto\u001b[80Gnothing\u001b[88G(for\u001b[93Gexample\u001b[101Gthe\u001b[105Gzero\u001b[110Gbyte).\u001b[117GI\r\u001b[2C\u001b[1B \u001b[5Gprint \u001b[38;2;87;105;247mHEX \u001b[39m with a\u001b[23G empt\u001b[30Ghex string\u001b[41Gand a tra\u001b[51Gling space;\u001b[63Gth\u001b[66G final gate may expect s\u001b[91Gmething diff\u001b[104Grent.\u001b[110G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe sums are added\u001b[24Gin a different order\u001b[45Gthan the C\u001b[56Gloops,\u001b[63Gw\u001b[65Gich c\u001b[71Guses the ~1\u001b[83G-5 differ\u001b[93Gnces.\u001b[99GIf two top\u001b[110Gscores\u001b[117Gare\r\u001b[2C\u001b[1B \u001b[5Galmo\u001b[10Gt tied,\u001b[18Gthe chosen\u001b[29Gtoken could in principl\u001b[54Gdiffer from t\u001b[68Ge ref\u001b[74Grenc\u001b[79G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[38;2;87;105;247mFIXED\u001b[39m and \u001b[38;2;87;105;247mLOGITS\u001b[22G\u001b[39mwith more than 1,024 ids aren't\u001b[54Gsuppo\u001b[60Gted.\u001b[K\r\u001b[4C\u001b[1BSpeed\u001b[11Gis roughly\u001b[22G13 ms per\u001b[33Goken; that's a \u001b[49Gough\u001b[54Gfigure from\u001b[66Gone\u001b[70Grun\u001b[74Gth"]
[106.399, "at\u001b[79Gincludes\u001b[88Gload\u001b[93Gtime.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Gharness,\u001b[16Gfixtures,\u001b[26Grules\u001b[32Gand\u001b[36Greference\u001b[46Gare\u001b[50Gunchanged.\u001b[61GThe\u001b[65Gcommands\u001b[74GI\u001b[76Gran\u001b[80Gand\u001b[84Ga\u001b[86Gsummary\u001b[94Gof\u001b[97Gthe\u001b[101Gchanges\u001b[109Gare\u001b[113Grecorded\r\u001b[2C\u001b[1Bin \u001b[38;2;87;105;247mNOTES.md\u001b[39m.\u001b[16G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[3GCogitated for 3m 1s \u00b7 done 3:42 PM\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gremaining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmuls\u001b[11Gare\u001b[15G~12.4\u001b[2"]
[106.399, "1Gms\u001b[24Gof\u001b[27Gthe\u001b[31G13.5\u001b[36Gms\u001b[39Gforward,\u001b[48Gall\u001b[52Grunning\u001b[60Gat\u001b[63G~35\u001b[67GGB/s\u001b[72Gregardless\u001b[83Gof\u001b[86Glayout.\u001b[94GLet\u001b[98Gme\u001b[101Gcheck\u001b[107Gwhether\u001b[115Gthat's\r\u001b[1B \u001b[3Gthe memory ceiling or a\u001b[27GBLAS-kernel\u001b[39Glimit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mTesting\u001b[11Gnon-BLAS\u001b[20GNumPy\u001b[26Gmatvec\u001b[33Gpaths\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cat >> prof/bw.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mprin\u001b[11G('--- more')\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mo_=\u001b[10Gp.empty(d,np.float32)\r\u001b[5C\u001b[1Bmore={\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m'einsum ij,j':lambda:[np.einsum('ij,j->i',W,x,out=o_) for W in Ws],\r\u001b[13C\u001b[1Boptimize':l\u001b[26Gmbda:[np.einsum('ij,j->i'\u001b[52GW,x,\u001b[57Gut=o_,opt\u001b[67Gmize=True) for W in Ws],\r\u001b[6C\u001b[1Bvecdot':lambda:[np.vecdot(W,x,out=o_) for W in Ws],\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102mmatvec\u001b[19G\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
