[226.114, "\u001b[H\r\u001b[2C\u001b[2BNumPy'\u001b[11Gown\u001b[15GSIMD loops beat Accelerate's\u001b[44Gsgemv on thes\u001b[58G tr\u001b[62Gnsposed weights, at about 48 GB/s against 36\u001b[107GGB/s, and the\r\u001b[2C\u001b[1Baccumulation \u001b[17Grder\u001b[22Gmatches th\u001b[33G ref\u001b[38Gre\u001b[41Gce loo\u001b[48G. I'm checking all the\u001b[71Greal\u001b[76Gshapes\u001b[83Gnext.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mvecdot\u001b[39m reaches about\u001b[24G43\u201347\u001b[30GGB/s\u001b[35Gwith\u001b[40Gno\u001b[43Glayout\u001b[50Gchange\u001b[57Gor\u001b[60Gextra\u001b[66Gload\u001b[71Gcost,\u001b[77Gand\u001b[81Gits\u001b[85Gerror\u001b[91Gis\u001b[94Gclose\u001b[100Gto\u001b[103Ggemv's\u001b[110Gwhile\r\u001b[2C\u001b[1Btransposed einsum's is 5\u20137\u00d7 larger.\u001b[39GNext\u001b[44GI'll\u001b[49Gmeasure\u001b[57Gnon-matmul\u001b[68Goverhead\u001b[77Gat\u001b[80Gshort\u001b[86Gand\u001b[90Glong\u001b[95Gcontexts.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m sh\u001b[12Gll command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gis\u001b[16Galready\u001b[24Gnear\u001b[29Gmemory\u001b[36Gspeed\u001b[42G(~120\u001b[48G\u00b5s/layer\u001b[57Gat\u001b[60G1,024\u001b[66Gpositions).\u001b[78GThe\u001b[82Gchanges\u001b[90Gto\u001b[93Gmake\u001b[9"]
[226.115, "8Gare\u001b[102G\u001b[38;2;87;105;247mvecdot\u001b[109G\u001b[39mfor\u001b[113Gthe\r\u001b[1B  matvecs, plus less per-op overhead in RoPE, SwiGLU and rmsnorm. Editing \u001b[38;2;87;105;247mrun.py\u001b[39m:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m 20% faster (13.8 \u2192 11.0 ms/token) and still passing. Next I'll confirm everything stays float32 and see how much\u001b[K\r\u001b[1C\u001b[1B non-matmul overhead is left.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Matmuls are now 10.4 ms\u001b[27Gof 10.9 ms; only ~0.5 ms \u001b[53Gs overhead. All scalars \u001b[78Gnd bu\u001b[84Gfers stay float32. Now checking\u001b[116Gthe\r\u001b[1C\u001b[1B Python-side\u001b[15Gcosts:\u001b[22Gtokenizer \u001b[33Gncode on long pr\u001b[50Gmpts,\u001b[56Gan\u001b[60Gstartup.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Time\u001b[8Gtokenizer encode and numpy impor\u001b[41G\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/tok.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport sys, "]
[226.116, "time\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102msys.path.insert(0, sys.argv[1])\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mfrom run import Tokenizer\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mt=time.perf_counter(); tk=Tokenizer('tokenizer.bin',32000); print('tok load %.3fs'%(time.perf_counter()-t))\r\u001b[5C\u001b[1Bfor txt in ['Once upon a time', 'The little dog was sad because he could not find his re\u2026\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2733\u001b[39m \u001b[38;2;215;119;87mZigzagging\u2026 \u001b[38;2;102;102;102m(3m 35s \u00b7 \u2193\u001b[27G15.3k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[39m\u001b[K\r\u001b[6C\u001b[1B                      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[226.117, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
