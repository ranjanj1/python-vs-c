[10.237, "mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mBenchmark forward pass on fixture workloads\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mmkdir -p prof\u001b[18G&& cat > prof/bench.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gsys,\u001b[16Gtime,\u001b[22Gjson\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m sys.path.insert(0, sys.argv[1])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import numpy as np\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfrom run impor\u001b[19G Transformer, Tokenizer\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m t0=time.perf_counter(); m=Transforme\u001b[41G('model.bin');\u001b[56Gtk=Tokenizer('tok\u001b[74Gnizer.bin',\u001b[86Gm.vocab_size); print('load\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m%.3"]
[10.237, "fs'%(\u001b[14Gme.perf_\u001b[23Gounter()-t0))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m fx=json.load(open('fixtures.jso\u001b[36G'))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for pr\u001b[12Gn\u001b[14Gfx['prompts']:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mseq=pr['seq'];\u001b[23Gm.reset()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G t=time.perf_counte\u001b[27G()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  for p,tok\u001b[18Gin\u001b[21Genumerate(seq):\u001b[37Gm.forward(tok,p)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mdt=time.perf_counter()-t;\u001b[34Gprint('%d\u001b[44Gpositions:\u001b[55G%.2f\u001b[60Gms/token'%(len(seq),dt/len(seq)*1e3))\r\u001b[1B \u001b[2m\u2502\u001b[22m m.reset(); t=time.perf_counter()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gp\u001b[10Gin\u001b[13Grange(1024):\u001b[26Gm.forward(5,p)\r\u001b[1B \u001b[2m\u2502\u001b[22m print('1024 positions: %.2f ms/token'%((time.perf_counter()-t)/1024*1e3))\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 prof/bench.py .\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[10.238, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m Parser skipped input between\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
