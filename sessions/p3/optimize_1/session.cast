[107.85, "\u001b[3G\u001b[39mMatmuls are ~12.4 ms of\u001b[27Gthe 13.5 ms\u001b[39Gforward,\u001b[48Gall\u001b[52Grunning\u001b[60Gat\u001b[63G~35\u001b[67GGB/s\u001b[72Gregardless\u001b[83Gof\u001b[86Glayout.\u001b[94GLet\u001b[98Gme\u001b[101Gcheck\u001b[107Gwhether\u001b[115Gthat's\r\u001b[2C\u001b[1Bthe\u001b[7Gmemory\u001b[14Gceiling\u001b[22Gor\u001b[25Ga\u001b[27GBLAS-kernel\u001b[39Glimit.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Testing non-BLAS NumPy matvec paths\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ ca\u001b[11G >> prof/bw.py <<'EOF'\r\u001b[5C\u001b[1Bpri\u001b[10Gt('--- more')\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mo_=np.empty(d,np.float32)\r\u001b[5C\u001b[1Bmore={\u001b[39m\u001b[K\r\u001b[13C\u001b[1B\u001b[38;2;102;102;102mij,j':lambd\u001b[26G:[np.einsum('ij,j->i',W,x\u001b[52Gout=\u001b[57G_) for W \u001b[67Gn Ws],\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;2;102;102;102meinsum optimize':lambda:[np.einsum('ij,j->i',W,x,out=o_,optimize=True) for W in Ws],\r\u001b[6C\u001b[1Bvecdot\u001b[19Gda:[np.vecdot(W,x,out=o_) for W in Ws],\r\u001b[5C\u001b[1B'matvec':lamb\u2026\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
