[624.256, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u00b7\u001b[4G\u001b[38;2;245;149;117mi\u001b[7G\u001b[38;2;215;119;87ma\u001b[42G\u001b[38;2;177;177;177mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
