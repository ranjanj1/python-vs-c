[394.349, "\u001b[H\u001b[6G\u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 285 +\u001b[38;2;51;51;51m                    hpush(heap, c)                                                                    \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 286 \u001b[22m         out = []\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 287 \u001b[22m         i = \u001b[38;2;0;134;179m0\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;51;51;51m\u001b[2m 288 \u001b[22m         \u001b[38;2;167;29;93mwhile\u001b[38;2;51;51;51m i < n:\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe heap merge matches the original output on 3,009 cases and runs 150\u00d7 faster on long prompts. Next I'll try fusing\r\u001b[2C\u001b[1Bthe Q/K/V and W1/W3 matmuls into single calls to cut call overhead.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping the fusing step,\u001b[29Gsince\u001b[35Git\u001b[38Gsaves\u001b[44Gonly\u001b[49Gabout\u001b[55G0.3\u001b[59Gms\u001b[62Gper\u001b[66Gtoken\u001b[72Gbut\u001b[76Gadds\u001b[81Groughly\u001b[89G270\u001b[93GMB\u001b[96Gof\u001b[99Gweight\u001b[106Gcopies\u001b[113Gat\u001b[116"]
[394.35, "Gload.\r\u001b[2C\u001b[1BNext I'll run the full\u001b[26Gcheck,\u001b[33Gedge\u001b[38Gcases,\u001b[45Gand\u001b[49Gan\u001b[52Gend-to-end\u001b[63Gcomparison\u001b[74Gagainst\u001b[82Gthe\u001b[86Gsaved\u001b[92Gv1.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mEnd-to-end\u001b[14Gresults\u001b[22Gare\u001b[26Gnoisy\u001b[32G(new\u001b[37GGENERATE\u001b[46Gran\u001b[50G2.81\u001b[55Gs\u001b[57Gand\u001b[61G3.41\u001b[66Gs\u001b[68Gin\u001b[71Gtwo\u001b[75Gruns).\u001b[82GI'll\u001b[87Gre-run\u001b[94Gthe\u001b[98Gforward\u001b[106Gmicrobenchmark\r\u001b[1B \u001b[3Gseveral times,\u001b[18Gal\u001b[21Gernating\u001b[31Gld a\u001b[36Gd new, for a\u001b[49Gfairer comparison:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mInterleaved\u001b[15Gforward\u001b[23Gbenchmark\u001b[33Gold\u001b[37Gvs\u001b[40Gnew\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2 3; do echo \"v1: $(python3 prof/bench.py prof | tr '\\n' ' ')\"; echo \"new: $(python3 prof/bench.py . |\r\u001b[5C\u001b[1Btr '\\n' ' ')\"; done\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
