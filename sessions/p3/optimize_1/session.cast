[93.51, "e supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mrema\u001b[8Gning budget. Preserve the\u001b[34Ginterface and correctness requirements. Do not use hidden evaluation inputs, external \r\u001b[2C\u001b[1Bimpleme\u001b[11Gtations or oth\u001b[27G ports. Record profiling \u001b[53Gvid\u001b[57Gnce, changes, tests\u001b[77Gand\u001b[81Gremaining limitations\u001b[105G NOTES.md.\u001b[39m     \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m4\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mMatmuls\u001b[11Gare\u001b[15G~12.4\u001b[21Gms\u001b[24Gof\u001b[27Gthe\u001b[31G13.5\u001b[36Gms\u001b[39Gforward,\u001b[48Gall\u001b[52Grunning\u001b[60Gat\u001b[63G~35\u001b[67GGB/s\u001b[72Gregardless\u001b[83Gof\u001b[86Glayout.\u001b[94GLet\u001b[98Gme\u001b[101Gcheck\u001b[107Gwhether\u001b[115Gthat's\r\u001b[1B \u001b[3Gthe memory ceiling or a\u001b[27GBLAS-kernel\u001b[39Glimit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mComparing\u001b[13GBLAS\u001b[18Gkernels\u001b[26Gagainst\u001b[34Graw\u001b[38Gread\u001b[43Gbandwidth\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cat > prof/bw.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mimport time, num\u001b[25Gas np"]
[93.51, "\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mrng=np.random.default_rng(0)\r\u001b[5C\u001b[1Bdef bench(f,n=100):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor\u001b[10G_ in range(5): f()\r\u001b[5C\u001b[1Bt=time.pe\u001b[16Gf_counter()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor _ in \u001b[16Gange(\u001b[22G): f()\r\u001b[5C\u001b[1Breturn (time.perf_counter()-t)/n\r\u001b[5C\u001b[1Bd,n=4096,768; L=12\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mWs=[rng.standard_normal((d,n),dtype=np.float32) for _ in range(L)]\r\u001b[6C\u001b[1BT\u001b[10Gnp.a\u001b[15Gco\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
