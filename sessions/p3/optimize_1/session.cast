[57.256, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mcat > prof/variants.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport time, numpy as\u001b[26Gnp\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrng=np.random.default_rng(0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def bench(f,n=200):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   for _ in range(5): f()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m   t=time.perf_counter()\u001b[30G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \u001b[5G   for _\u001b[14Gin r\u001b[19Gng\u001b[22G(n):\u001b[27Gf()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m   re\u001b[11Gurn (time.perf_counter()-t)/n*1e6\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m L=12\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for (\u001b[10G,n)\u001b[14Gin [(768,768),(2048,768),(768,2048),(2304,768),(4096,768),(32000,768)]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mWs=[rng.standard_normal((d,n),dtype=np.float32)\u001b[56Gfor\u001b[60G_\u001b[62Gin\u001b[65Grange(L\u001b[73Gif\u001b[76Gd<32000\u001b[84Gelse\u001b[89G1)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G x=rng.standard_norma\u001b[29G(n,dtype=np.float32); o=np.empty(d,np.float3"]
[57.257, "2)\u001b[76G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G  WT=[np\u001b[15Gascontiguousarray(W.T)\u001b[38Gfor\u001b[42GW\u001b[44Gin\u001b[47GWs]\u001b[52G#\u001b[54G(n,d)\u001b[60GC-contig\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mr={}\r\u001b[1B \u001b[2m\u2502\u001b[22m     r['dot(W,x)']=bench(lambda:[np.dot(W,x,out=o)\u001b[54Gfor\u001b[58GW\u001b[60Gin\u001b[63GWs])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mr['matmul(W,x)']=bench(lambda:[np.matmul(W,x,out=o)\u001b[60Gfor\u001b[64GW\u001b[66Gin\u001b[69GWs])\r\u001b[1B \u001b[2m\u2502\u001b[22m     r['dot(x,WT)']=bench(lambda:[np.dot(x,W,out=o) for W in WT])\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     r['dot(x,W.T)']=bench(lambda:[np.dot(x,W.T,out=o) for W in Ws])\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m     gb=d*n*4*len(Ws)/1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint((d,n),\u001b[21G{k:'%.0fus\u001b[32G%.0fGB/s'%(v,\u001b[46Ggb/(v*1e-6))\u001b[59Gfor\u001b[63Gk,v\u001b[67Gin\u001b[70Gr.items()})\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 prof/variants.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[57.258, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
