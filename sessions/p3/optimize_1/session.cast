[179.778, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m NumPy's own SIMD loops beat Accelerate's sgemv on these transposed weights, at about 48 GB/s against 36 GB/s, and the\u001b[K\r\u001b[1B  accumulation order matches the reference loop. I'm checking all the real shapes next.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[38;2;87;105;247mvecdot\u001b[10G\u001b[39mreaches\u001b[18Gabout\u001b[24G43\u201347\u001b[30GGB/s\u001b[35Gwith\u001b[40Gno\u001b[43Glayout\u001b[50Gchange\u001b[57Gor\u001b[60Gextra\u001b[66Gload\u001b[71Gcost,\u001b[77Gand\u001b[81Gits\u001b[85Gerror\u001b[91Gis\u001b[94Gclose\u001b[100Gto\u001b[103Ggemv's\u001b[110Gwhile\r\u001b[1B \u001b[3Gtransposed einsum's is 5\u20137\u00d7\u001b[31Glarger.\u001b[39GNext I'll meas\u001b[54Gre \u001b[58Gon-matmul overh\u001b[74Gad at \u001b[81Ghort\u001b[86Gand long cont\u001b[100Gxts.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gis\u001b[16Galready\u001b[24Gnear\u001b[29Gmemory\u001b[36Gspeed\u001b[42G(~120\u001b[48G\u00b5s/layer\u001b[57Gat\u001b[60G1,024\u001b[66Gpositions).\u001b[78GThe\u001b[82Gchanges\u001b[90Gto\u001b[93Gmake\u001b[98Gare\u001b[102G\u001b[38;2;87;105;247mvec"]
[179.779, "dot\u001b[109G\u001b[39mfor\u001b[113Gthe\r\u001b[1B \u001b[3Gmatvec\u001b[10G, plus less per-op overh\u001b[35Gad in RoPE, SwiGLU and rmsnorm. E\u001b[69Gitin\u001b[74G \u001b[38;2;87;105;247mrun.py\u001b[39m:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mApplying\u001b[12Gvecdot/complex-RoPE\u001b[32Grewrite,\u001b[41Gbenchmarking,\u001b[55Grunning\u001b[63Gcheck\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ sed -i\u001b[15G'' -e 's/reshape(n_kv_heads, kv_mul, hs)/reshape(n_kv_heads, self.kv_mul, hs)/' -e 's/self.inv_dim = \r\u001b[5C\u001b[1BF32(dim)/self.fdim = F32(dim)/' -e 's/fdim, sqrt_hs = self.one, self.eps, self.inv_dim, self.sqrt_hs/fdim, sqrt_hs \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m= self.one, self.eps, self.fdim, self.sqrt_hs/' run.py && grep -n \"fdim\\|k\u2026\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
