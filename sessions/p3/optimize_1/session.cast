[253.306, "          \r\u001b[1B\u001b[39m\u001b[49m \u001b[3G   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 289 +\u001b[38;2;51;51;51m            \u001b[38;2;167;29;93mif\u001b[38;2;51;51;51m m:                                                                                     \u001b[39m\u001b[49m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 290 +\u001b[38;2;51;51;51m                new = heap[before:]                                                                   \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 291 +\u001b[38;2;51;51;51m                \u001b[38;2;167;29;93mdel\u001b[38;2;51;51;51m heap[before:]                                                                     \r\u001b[2C\u001b[1B\u001b[39m\u001b[49m   \u001b[38;2;36;138;61m\u001b[48;2;220;255;220m 292 +\u001b[38;2;51;51;51m                \u001b[38;2;167;29;93mfor\u001b[38;2;51;51;51m e \u001b[38;2;167;29;93min\u001b[38;2;51;51;51m new:                                                                         \r\u001b[5C\u001b[1B\u001b[38;2;36;138;61m 293 +\u001b[38;2;51;51;51m                    hpush(heap, e)                                                                    \r\u001b[1B\u001b[49m\u001b[39m \u001b[3G   \u001b[38;2;36"]
