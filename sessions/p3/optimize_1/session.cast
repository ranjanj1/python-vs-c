[450.695, ";0;0;0m\u23fa\u001b[3G\u001b[39mThe heap merge\u001b[18Gma\u001b[21Gches the\u001b[31Grigi\u001b[36Gal output on\u001b[49G3,009 cases and runs\u001b[70G150\u00d7\u001b[75Gfaster\u001b[82Gon\u001b[85Glong\u001b[90Gprompts.\u001b[99GNext\u001b[104GI'll\u001b[109Gtry\u001b[113Gfusing\r\u001b[2C\u001b[1Bthe\u001b[7GQ/K/V\u001b[13Gand\u001b[17GW1/W3\u001b[23Gmatmuls\u001b[31Ginto\u001b[36Gsingle\u001b[43Gcalls\u001b[49Gto\u001b[52Gcut\u001b[56Gcall\u001b[61Goverhead.\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mSkipping the fusing step, since it saves only about 0.3 ms per token but\u001b[76Gadds\u001b[81Groughly\u001b[89G270\u001b[93GMB\u001b[96Gof\u001b[99Gweight\u001b[106Gcopies\u001b[113Gat\u001b[116Gload.\r\u001b[2C\u001b[1BNext\u001b[8GI'll\u001b[13Grun\u001b[17Gthe\u001b[21Gfull\u001b[26Gcheck,\u001b[33Gedge\u001b[38Gcases,\u001b[45Gand\u001b[49Gan\u001b[52Gend-to-end\u001b[63Gcomparison\u001b[74Gagainst\u001b[82Gthe\u001b[86Gsaved\u001b[92Gv1.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m End-to-end results are noisy (new GENERATE\u001b[46Gran\u001b[50G2.81\u001b[55Gs\u001b[57Gand\u001b[61G3.41\u001b[66Gs\u001b[68Gin\u001b[71Gtwo\u001b[75Gruns).\u001b[82GI'll\u001b[87Gre-run\u001b[94Gthe\u001b[98Gforward\u001b[106Gmicrobe"]
