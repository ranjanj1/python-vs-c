[497.142, "ocked\u001b[105Glayout\u001b[112Gof\r\u001b[2C\u001b[1Bcontiguous column blocks\u001b[28Gwith\u001b[33Gone\u001b[37Ggemv\u001b[42Gper\u001b[46Gblock\u001b[52Gand\u001b[56Gpartial\u001b[64Gsums\u001b[69Gadded,\u001b[76Gat\u001b[79Gthe\u001b[83Greal\u001b[88Gshapes.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe batched\u001b[15Gblock\u001b[21Ggemv\u001b[26Gruns\u001b[31Gabout\u001b[37G25%\u001b[41Gfaster\u001b[48Gthan\u001b[53Gvecdot,\u001b[61Gat\u001b[64G53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[2C\u001b[1Bchecking\u001b[12Gwhether\u001b[20Ga\u001b[22Gstrided\u001b[30Gview\u001b[35Gwithout\u001b[43Gcopying\u001b[51Gperforms\u001b[60Gas\u001b[63Gwell\u001b[68Gand\u001b[72Gwhat\u001b[77Gthe\u001b[81Gload-time\u001b[91Greorganisation\u001b[106Gcosts\u001b[112Gbefore\u001b[119GI\r\u001b[2C\u001b[1Bcommit.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided\u001b[11Gviews dr\u001b[20Gp to\u001b[25G34\u001b[28GGB/s,\u001b[34Gso\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[2C\u001b[1Bswitching\u001b[13Gto\u001b[16Ga\u001b[1"]
[497.143, "8Gread-only\u001b[28Gmemmap\u001b[35Gthat\u001b[40Gcopies\u001b[47Gstraight\u001b[56Ginto\u001b[61Gthe\u001b[65Gblocked\u001b[73Glayout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[1B \u001b[3Gabout 2 ms per token.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead\u001b[8G\u001b[1m1\u001b[10G\u001b[22mfile, \u001b[17Ga\u001b[19G \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses with the same error level. Benchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\u001b[40;1H\u001b[38;3H"]
