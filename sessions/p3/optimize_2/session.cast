[1027.392, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOn the original layout,\u001b[27Geinsum\u001b[34Gwins\u001b[39Gup\u001b[42Gto\u001b[45GT\u2248750\u001b[51Gand\u001b[55Gtransposed\u001b[66Gvecdot\u001b[73Gwins\u001b[78Gbeyond\u001b[85Gthat,\u001b[91Gso\u001b[94GI'll\u001b[99Gkeep\u001b[104Gboth\u001b[109GV\u001b[111Glayouts\r\u001b[2C\u001b[1Band\u001b[7Gchoose\u001b[14Gper\u001b[18Gstep,\u001b[24Geinsum\u001b[31Gbelow\u001b[37GT=768\u001b[43Gand\u001b[47Gvecdot\u001b[54Gfrom\u001b[59Gthere.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCost\u001b[8Grises\u001b[14Gsteadily\u001b[23Gwith\u001b[28Gposition\u001b[37G(8.6\u201310.0\u001b[47Gms\u001b[50Gfor\u001b[54Gv3\u001b[57Gversus\u001b[64G10.6\u201313.2\u001b[74Gms\u001b[77Gfor\u001b[81Gv2).\u001b[86GSince\u001b[92Gcheck.py\u001b[101Gonly\u001b[106Gcovers\r\u001b[2C\u001b[1Bpositions up to 25 on\u001b[25Gthis\u001b[30Gmodel,\u001b[37GI'm\u001b[41Gverifying\u001b[51Gmore\u001b[56Gwidely\u001b[63Gagainst\u001b[71Gthe\u001b[75Gv1\u001b[78Gimplementation\u001b[93Gon\u001b[96Gfull\u001b[101G1,024-position\r\u001b[2C\u001b[1Blogits\u001b[10Gand\u001b[14Gsynthetic\u001b[24GGQA\u001b[28Gand\u001b[32Gunshared-classifier\u001b[52Gcheckpoints.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll configurations match\u001b"]
[1027.393, "[28Gv1\u001b[31Gwith\u001b[36Glogit\u001b[42Gdifferences\u001b[54Gunder\u001b[60G2.3e-5\u001b[67Gand\u001b[71Gno\u001b[74Gargmax\u001b[81Gmismatches.\u001b[93GFusing\u001b[100Gthe\u001b[104Gprojections\u001b[116Gnow\r\u001b[2C\u001b[1Bcosts\u001b[9Gnothing\u001b[17Gextra\u001b[23Gsince\u001b[29Gthe\u001b[33Gloader\u001b[40Gcopies\u001b[47Geverything\u001b[58Ganyway,\u001b[66Gso\u001b[69GI'm\u001b[73Gchecking\u001b[82Gwhether\u001b[90Git\u001b[93Gspeeds\u001b[100Gup\u001b[103Gblocked\u001b[111Ggemv.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusion saves ~0.11 ms/token (~1.3%).\u001b[40GIt's\u001b[45Gsmall,\u001b[52Gbut\u001b[56Git's\u001b[61Gfree\u001b[66Gat\u001b[69Gload\u001b[74Gand\u001b[78Gactually\u001b[87Gremoves\u001b[95Gcalls,\u001b[102Gso\u001b[105GI'll\u001b[110Gimplement\r\u001b[2C\u001b[1Bit:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusion saves ~0.15 ms/token,\u001b[32Ga\u001b[34Gd correctness\u001b[48Gis\u001b[51Gunchanged\u001b[61Gon\u001b[64Gall\u001b[68Gmodels.\u001b[76GQuick\u001b[82Gtuning\u001b[89Gcheck\u001b[95Gof\u001b[98Gblock\u001b[104Gsize\u001b[109G(128\u001b[114Gvs\u001b[117G256\r\u001b[1B  vs 384) in place:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r"]
[1027.394, "\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock 128 is slightly\u001b[25Gfaster\u001b[32G(~1%),\u001b[39Gand\u001b[43G384\u001b[47Gis\u001b[50Gmuch\u001b[55Gslower,\u001b[63Gconsistent\u001b[74Gwith\u001b[79Ggemv\u001b[84Gdropping\u001b[93Goff\u001b[97Gits\u001b[101Gfast\u001b[106Gpath\u001b[111Gabove\r\u001b[2C\u001b[1B256-float rows. Checking 64 and 192 as well:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[40;1H\u001b[38;3H"]
