[393.802, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gcuts\u001b[21Gthe\u001b[25Gweighted\u001b[34Gsum\u001b[38Gfrom\u001b[43G2.05\u001b[48Gto\u001b[51G0.85\u001b[56Gms\u001b[59Gat\u001b[62GT=1000.\u001b[70GIt\u001b[73Gcosts\u001b[79Gabout\u001b[85G+35\u001b[89G\u00b5s/token\u001b[98Gat\u001b[101GT=81,\u001b[107Ga\u001b[109G0.3%\u001b[114Gloss\u001b[119Gon\r\u001b[1B \u001b[3Gshort contexts against a ~10% gain\u001b[38Gat long ones, so I'll \u001b[61Gake it. Implementing:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses.\u001b[11GComparing\u001b[21Glong-context\u001b[34Gcost\u001b[39Gdirectly\u001b[48G(min-of-N\u001b[58Gper-token\u001b[68Gtime\u001b[73Gat\u001b[76Gpositions\u001b[86Gnear\u001b[91G1,000):\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gwins\u001b[21Gat\u001b[24G999\u001b[28Gbut\u001b[32Gloses\u001b[38Gat\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[1B \u001b[3Gconflicts;\u001b[14GI'm testing padded strides\u001b[41Gnext.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b"]
[393.803, "[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding\u001b[11Gdidn't\u001b[18Ghelp,\u001b[24Gand\u001b[28Gvecdot's\u001b[37Gcost\u001b[42Gisn't\u001b[48Gmonotonic\u001b[58Gin\u001b[61GT,\u001b[64Gwhich\u001b[70Gsuggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[1B \u001b[3Gscanning dot spe\u001b[20Gd ag\u001b[25Ginst row length next, since the weight\u001b[64Gmatvec\u001b[71G may be\u001b[79Gaffect\u001b[86Gd too.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's\u001b[16Ggemv\u001b[21Ghits\u001b[26G58\u201360\u001b[32GGB/s\u001b[37Gon\u001b[40Gshort\u001b[46Grows\u001b[51Gversus\u001b[58G27\u201339\u001b[64Gon\u001b[67Glonger\u001b[74Gones,\u001b[80Gso\u001b[83GI'm\u001b[87Gtesting\u001b[95Ga\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[1B \u001b[3Gcontiguous colu\u001b[19Gn\u001b[21Gblocks with one\u001b[37Ggemv per\u001b[46Gblock and partial\u001b[64Gsums added, at the\u001b[83Greal shapes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mBenchmarking\u001b[16Gcolumn-blocked\u001b[31Ggemv\u001b[36Gat\u001b[39Gmodel\u001b[45Gshapes\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1C\u001b[1B \u23bf  $ cat > prof/blocked.py <"]
[393.803, "<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m#\u001b[8GColumn-blocked w\u001b[25Gights: W (d,n) stored as (n/b, d, b) contiguous blocks; y = sum_k Wk @ x[k*b:(k+1)*b].\r\u001b[5C\u001b[1Bimp\u001b[10Grt time, numpy as np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mF = np.float32; \u001b[23Gc\u001b[25G= time.perf_counter; rng = np.random.default_rng(0)\r\u001b[5C\u001b[1Bdef\u001b[10Gbench(f, n=20,\u001b[25Gr=5):\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor\u001b[10G_ in range(\u001b[22G):\u001b[25Gf()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mbest = 1e9\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor _ \u2026 (3s)\r\u001b[5C\u001b[1B(ctrl+b to run in background)\u001b[39m\u001b[40;1H\u001b[38;3H"]
