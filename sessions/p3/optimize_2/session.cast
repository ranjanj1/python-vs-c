[276.842, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gmatvecs\u001b[18Gtake\u001b[23Gnearly\u001b[30Gall\u001b[34Gof\u001b[37Gthe\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[1B \u001b[3Glayer,\u001b[10Gagainst\u001b[18G17 \u00b5s benchm\u001b[31Grked alone), probably fr\u001b[56Gm a cold\u001b[65GKV cache or per-head BLAS overhead.\u001b[101GI'm testing\u001b[113Gthe\r\u001b[2C\u001b[1Bb\u001b[5Gtched v\u001b[13Griants directly inside\u001b[36Gthe live f\u001b[47Grward\u001b[53Gpass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gruns\u001b[18Gat\u001b[21G3.2\u001b[25Gms/token\u001b[34Gat\u001b[37Gposition\u001b[46G999,\u001b[51Gabout\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[1B \u001b[3Gmicrobenchmark. I'm split\u001b[29Ging it into sc\u001b[44Gres, softmax\u001b[57Gand weight\u001b[68Gd\u001b[70Gsum\u001b[74Gnext.\u001b[80G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b["]
[276.842, "7Gweighted\u001b[16Gsum\u001b[20G(att\u001b[25G@\u001b[27GV)\u001b[30Gis\u001b[33Gthe\u001b[37Gbottleneck\u001b[48Gat\u001b[51Gabout\u001b[57G17\u001b[60GGB/s,\u001b[66Gbecause\u001b[74GV's\u001b[78G(t,\u001b[82Gd)\u001b[85Glayout\u001b[92Gforces\u001b[99Ga\u001b[101Gpoorly\u001b[108Gshaped\r\u001b[1B \u001b[3Gtransposed gemv.\u001b[20GI'm storing V transpos\u001b[43Gd per he\u001b[52Gd as\u001b[57G(head, d, t) so it becomes contiguous row\u001b[99Gdot p\u001b[105Goducts, then\r\u001b[3C\u001b[1Besting.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gcuts\u001b[21Gthe\u001b[25Gweighted\u001b[34Gsum\u001b[38Gfrom\u001b[43G2.05\u001b[48Gto\u001b[51G0.85\u001b[56Gms\u001b[59Gat\u001b[62GT=1000.\u001b[70GIt\u001b[73Gcosts\u001b[79Gabout\u001b[85G+35\u001b[89G\u00b5s/token\u001b[98Gat\u001b[101GT=81,\u001b[107Ga\u001b[109G0.3%\u001b[114Gloss\u001b[119Gon\r\u001b[1B \u001b[3Gshort contexts against a ~10% gain\u001b[38Gat long ones, so I'll \u001b[61Gake it. Implementing:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses.\u001b[11GComparing\u001b[21Glong-context\u001b[34Gcost\u001b[39Gdirectly\u001b[48G(min-of-N\u001b[58Gper-t"]
[276.843, "oken\u001b[68Gtime\u001b[73Gat\u001b[76Gpositions\u001b[86Gnear\u001b[91G1,000):\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mComparing\u001b[13Gper-token\u001b[23Gtime\u001b[28Gacross\u001b[35Gpositions,\u001b[46Gv2\u001b[49Gvs\u001b[52Gnew\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1B  \u23bf  $ cat > prof/long.py <<'EOF'\u001b[35G\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m#\u001b[8GPer-token forward time (min of repeats) at several positions, after filling the cache.\r\u001b[5C\u001b[1Bimpo\u001b[11Gt sys,\u001b[18Gtime, importlib\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102msys.path.insert(0, sys.argv[1]); mod = importlib.import_module(sys.argv[2])\r\u001b[5C\u001b[1Bm = mod.Transformer('model.bin')\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mfor\u001b[10Gp in \u001b[18Gge(1000): m.forward(5 + p % 300,\u2026 (3s)\r\u001b[5C\u001b[1B(ctrl+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
