[1028.162, "\u001b[H\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAll\u001b[7Gconfigurations\u001b[22Gmatch\u001b[28Gv1\u001b[31Gwith\u001b[36Glogit\u001b[42Gdifferences\u001b[54Gunder\u001b[60G2.3e-5\u001b[67Gand\u001b[71Gno\u001b[74Gargmax\u001b[81Gmismatches.\u001b[93GFusing\u001b[100Gthe\u001b[104Gprojections\u001b[116Gnow\r\u001b[2C\u001b[1Bcosts nothing extra since\u001b[29Gthe\u001b[33Gloader\u001b[40Gcopies\u001b[47Geverything\u001b[58Ganyway,\u001b[66Gso\u001b[69GI'm\u001b[73Gchecking\u001b[82Gwhether\u001b[90Git\u001b[93Gspeeds\u001b[100Gup\u001b[103Gblocked\u001b[111Ggemv.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFus\u001b[7Gon\u001b[10Gsave\u001b[15G ~0.11 ms/toke\u001b[30G (~1.3%). It's \u001b[46Gmall,\u001b[52Gbut it's free\u001b[66Gat\u001b[69Gload\u001b[74Gand\u001b[78Gactually\u001b[87Gremoves\u001b[95Gcalls,\u001b[102Gso\u001b[105GI'll\u001b[110Gimplement\r\u001b[2C\u001b[1Bit:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFu\u001b[6Gion saves ~0.15 m\u001b[24G/token, and co\u001b[39Grectn\u001b[46Gs is unchanged on all models. Qu\u001b[79Gck\u001b[82Gtuning check of "]
[1028.163, "block size (128 \u001b[115Gs\u001b[117G256\r\u001b[2C\u001b[1Bvs\u001b[6G384)\u001b[11Gin\u001b[14Gplace:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9G128\u001b[13Gis\u001b[16Gslightly\u001b[25Gfaster\u001b[32G(~1%),\u001b[39Gand\u001b[43G384\u001b[47Gis\u001b[50Gmuch\u001b[55Gslower,\u001b[63Gconsistent\u001b[74Gwith\u001b[79Ggemv\u001b[84Gdropping\u001b[93Goff\u001b[97Gits\u001b[101Gfast\u001b[106Gpath\u001b[111Gabove\r\u001b[2C\u001b[1B256-float\u001b[13Grows.\u001b[19GChecking\u001b[28G64\u001b[31Gand\u001b[35G192\u001b[39Gas\u001b[42Gwell:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mTesting\u001b[11Gblock\u001b[17Gsizes\u001b[23G64\u001b[26Gand\u001b[30G192\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for b in 64 192 128; do python3 prof/blocksize.py $b; done\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
