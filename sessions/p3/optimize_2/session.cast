[725.522, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[12G\u001b[22mself.value_cache\u001b[29G=\u001b[31Gnp.zeros((L,\u001b[44Gn_kv_heads,\u001b[56Gseq_len,\u001b[65Ghs),\u001b[70Gdtype=F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         self.value_cache_t\u001b[31G=\u001b[33Gnp.zeros((L,\u001b[46Gn_kv_heads,\u001b[58Ghs,\u001b[62Gseq_len),\u001b[72Gdtype=F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mself.wsum_switch\u001b[29G=\u001b[31G768\"\"\"),\r\u001b[1B \u001b[2m\u2502\u001b[22m (\"      \u001b[13G    \u001b[18Gself.v\u001b[25Glue_cache[:, :, :, :self.used] = 0\",\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \"          \u001b[17G self.value_cache[:, :, :self.used, :]\u001b[56G= 0\\n\u001b[73Gself.value_cache_t[:,\u001b[95G:,\u001b[98G:,\u001b[101G:self.used]\u001b[113G=\u001b[115G0\"),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m(\"\"\"\u001b[20Gvc\u001b[23G=\u001b[25Gself.value_cache[l]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             kslot =\u001b[24Gkc[:,\u001b[30Gpos,\u001b[35G:]\"\"\",\u001b[42G\"\"\"\u001b[57Gvc\u001b[60G=\u001b[62Gself.value_cache[l]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mvct\u001b[20G=\u001b[22Gself.value_cache_t[l]\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     \u001b[13G   kslot = kc[:, pos, :]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G        vslot =\u001b[24Gvc[:, pos, \u001b[36G]\"\"\"),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m(\"\"\"\u001b[20Gadd_reduce(p_kv_h,\u001b[39Gaxis=0,\u001b[47Gout=vc[:,\u001b[57G:,\u001b[60Gpos])"]
[725.524, "\u001b[67G#\u001b[69Gv\u001b[71Glikewise\u001b[80G(strided\u001b[89Gcolumn\u001b[96Gof\u001b[99Gthe\u001b[103Gtransposed\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m cache)\"\"\",\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m\"\"\"\u001b[20Gadd_reduce(p_kv_h,\u001b[39Gaxis=0,\u001b[47Gout=vslot)\u001b[67G#\u001b[69Gv\u001b[71Glikewise\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G vct[:,\u001b[23G:, pos] = vslot\"\"\"),\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m (\"\"\"    \u001b[13G  \u001b[16G    vecdot(vc[:, None, :, :T], att[:, :, None, :],\u001b[67Gout=xb.reshape(qg.shape))\"\"\",\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m\"\"\"\u001b[20Gif\u001b[23GT\u001b[25G<\u001b[27Gwsum_switch:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 np.einsum('hmt,htd->hmd',\u001b[46Gatt,\u001b[51Gvc[:,\u001b[57G:T,\u001b[61G:],\u001b[65Gout=xb.reshape(qg.shape))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22melse:\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G     vec\u001b[24Got(vct[:,\u001b[34GN\u001b[36Gne, :, :T], att[:, :, None,\u001b[64G:], out=xb.reshape(qg.sh\u001b[89Gpe))\"\"\"),\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m (\"\"\"     \u001b[14G  rot = self.rope[pos]\u001b[37G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mT\u001b[14G=\u001b[16Gpos\u001b[20G+\u001b[22G1\"\"\",\u001b[28G\"\"\"\u001b[39Grot\u001b[43G=\u001b[45Gself.rope[pos]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         wsum_switch\u001b[24G=\u001b[26Gself.wsum_switch\r\u001b[1C\u001b["]
[725.525, "1B\u001b[2m\u2502\u001b[12G\u001b[22mT\u001b[14G=\u001b[16Gpos\u001b[20G+\u001b[22G1\"\"\"),\r\u001b[1B \u001b[2m\u2502\u001b[22m ]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for a,\u001b[11Gb\u001b[13Gin rep:\u001b[21G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Gs.count(a)\u001b[26G==\u001b[29G1,\u001b[32Ga\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     s = s.replace(a,\u001b[25Gb)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mopen('run.py',\u001b[19G'w').write(s)\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 check.py --tokens 64 --prompts\u001b[43G3 -- python3 run.py | tail\u001b[70G-1;\u001b[74Gcp\u001b[77Grun.py\u001b[84Gprof/run_v3b.py;\u001b[101Gfor\u001b[105Gi\u001b[107Gin\u001b[110G1\u001b[112G2;\u001b[115Gdo\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/long.py\u001b[25Gprof\u001b[30Grun_v2;\u001b[38Gpython3\u001b[46Gprof/long.py\u001b[59G.\u001b[61Grun;\u001b[66Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b["]
