[704.776, "\u001b[H\r\u001b[2C\u001b[33B\u001b[38;2;245;149;117mCascading\u2026\u001b[19G\u001b[38;2;102;102;102m30\u001b[39m\u001b[40;1H\u001b[38;3H"]
[704.844, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token\u001b[13Gtime\u001b[18Gdrops\u001b[24Gabout\u001b[30G20%:\u001b[35G\u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[1B \u001b[3Gto ~0.37\u20130.87 s. I'll profile the loader to win that back:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfirst\u001b[13Gcall\u001b[18Gincludes\u001b[27Gfirst-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[1B \u001b[3Geach strategy in its own p\u001b[30Gocess:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gblocked\u001b[15Gload\u001b[20Gis\u001b[23Gonly\u001b[28Gabout\u001b[34G0.10\u001b[39Gs\u001b[41Gwith\u001b[46Gmemmap\u001b[53Gand\u001b[57G0.075\u001b[63Gs\u001b[65Gwith\u001b[70Gchunked\u001b[78Greadinto,\u001b[88Gagainst\u001b[96G0.055\u001b[102Gs\u001b[104Gfor\u001b[108Gplain\r\u001b[1B \u001b[3Gfromfile, so that overhead doesn't explain\u001b[46Gthe 0.37\u20130.87 s seen earlie"]
[704.845, "r. I'm measuring t\u001b[92Gme-to-READY\u001b[104Gdi\u001b[107Gectly next.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gblocked\u001b[15Gloader\u001b[22Gadds\u001b[27G~37\u001b[31Gms\u001b[34Gto\u001b[37Gstartup\u001b[45G(0.113\u001b[52G\u2192\u001b[54G0.150\u001b[60Gs).\u001b[64GSince\u001b[70Gchunked\u001b[78G\u001b[38;2;87;105;247mreadinto\u001b[87G\u001b[39mwas\u001b[91Gfaster\u001b[98Gthan\u001b[103Gmemmap\u001b[110Gin\u001b[113Gfresh\r\u001b[1B \u001b[3Gprocesses, I'll switch the loader\u001b[37Gto i\u001b[42G:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup\u001b[11Gis\u001b[14Gnow\u001b[18Gwithin\u001b[25Gabout\u001b[31G20\u001b[34Gms\u001b[37Gof\u001b[40Gv2,\u001b[44Gand\u001b[48Gthe\u001b[52Gattention\u001b[62Gweighted\u001b[71Gsum's\u001b[77Gcost\u001b[82Glooks\u001b[88Glike\u001b[93Ga\u001b[95Gprefetch\u001b[104Gproblem\u001b[112Gfrom\u001b[117Gthe\r\u001b[1B \u001b[3Gs\u001b[5Grided\u001b[11GV layout. I'm\u001b[25Gsweeping\u001b[34Gthe candid\u001b[45Gte\u001b[48Glayou\u001b[54Gs over T w\u001b[65Gt\u001b[67G a cold ca\u001b[78Ghe next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mSweeping\u001b[12Gweighted-sum\u001b[25Gvariants\u001b[34Gover\u001b[39Gcontext\u001b[47Gl"]
[704.845, "ength\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ cat > prof/wsum_sweep.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m#\u001b[8GAt\u001b[11Gention weighted sum, 12 layers, cold cache: (t,d) layout via matmul / einsum vs (d,t) layout via vecdot.\r\u001b[5C\u001b[1Bimport \u001b[15Gme, numpy as np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mF = np.float32; \u001b[23Gc\u001b[25G= time.perf_counter; rng = np.random.default_rng(0)\r\u001b[5C\u001b[1BL, H, hs, S = 12, 12, 64, 1024\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mjunk = np.ones(64\u001b[24G* 102\u001b[30G * \u2026 (3s)\r\u001b[5C\u001b[1B(ctrl+b to run in\u001b[24Gbackground)\u001b[39m\u001b[40;1H\u001b[38;3H"]
[704.901, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2733\u001b[39m\u001b[40;1H\u001b[38;3H"]
