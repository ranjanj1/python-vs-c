[649.895, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe batched block gemv\u001b[26Gruns\u001b[31Gabout\u001b[37G25%\u001b[41Gfaster\u001b[48Gthan\u001b[53Gvecdot,\u001b[61Gat\u001b[64G53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[2C\u001b[1Bchecking\u001b[12Gwhether\u001b[20Ga\u001b[22Gstrided\u001b[30Gview\u001b[35Gwithout\u001b[43Gcopying\u001b[51Gperforms\u001b[60Gas\u001b[63Gwell\u001b[68Gand\u001b[72Gwhat\u001b[77Gthe\u001b[81Gload-time\u001b[91Greorganisation\u001b[106Gcosts\u001b[112Gbefore\u001b[119GI\r\u001b[1B \u001b[3Gcommit.\u001b[11G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided views drop to 34 GB/s, so\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[2C\u001b[1Bswitching\u001b[13Gto\u001b[16Ga\u001b[18Gread-only\u001b[28Gmemmap\u001b[35Gthat\u001b[40Gcopies\u001b[47Gstraight\u001b[56Ginto\u001b[61Gthe\u001b[65Gblocked\u001b[73Glayout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[1B \u001b[3Gabout 2 ms per token.\u001b[K\r\u001b[3C\u001b[2B\u001b[38;2;102;102;102mead \u001b[1m1\u001b[22m fi\u001b[13Ge, ran \u001b[1m1\u001b[22m shell comma"]
[649.897, "nd \r\u001b[3C\u001b[2B\u001b[39masses with the same\u001b[24Gerror\u001b[30Glevel. Benchmarking against v2, alternating runs:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token\u001b[13Gtime\u001b[18Gdrops\u001b[24Gabout\u001b[30G20%:\u001b[35G\u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[1B \u001b[3Gto ~0.37\u20130.87 s. I'll profile \u001b[34Ghe loader\u001b[44Gto win\u001b[51Gthat back:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The first call includes first-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[2C\u001b[1Beach strategy in its own process:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[9G\u001b[22mshell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe blocked load is only\u001b[28Gabout\u001b[34G0.10\u001b[39Gs\u001b[41Gwith\u001b[46Gmemmap\u001b[53Gand\u001b[57G0.075\u001b[63Gs\u001b[65Gwit"]
[649.898, "h\u001b[70Gchunked\u001b[78Greadinto,\u001b[88Gagainst\u001b[96G0.055\u001b[102Gs\u001b[104Gfor\u001b[108Gplain\r\u001b[2C\u001b[1Bfromfile, so that overhead doesn't explain the 0.37\u20130.87 s seen earlier.\u001b[76GI'm\u001b[80Gmeasuring\u001b[90Gtime-to-READY\u001b[104Gdirectly\u001b[113Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[29C\u001b[2B\u001b[38;2;102;102;102m9\u001b[39m\u001b[40;1H\u001b[38;3H"]
