[889.597, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m''',\u001b[9G'''\u001b[24Gvct\u001b[28G=\u001b[30Gself.value_cache_t[l]\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G m\u001b[18Gtmul(wqkv, xb_\u001b[33G, \u001b[36Gut=p_qkv3)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m          \u001b[14G  add_reduce(p_qkv, axis=0, out=qkv)\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[22m             # RoPE on\u001b[26Gq\u001b[28Gand\u001b[32Gk,\u001b[35Gthen\u001b[40Gstore\u001b[46Gk\u001b[48Gand\u001b[52Gv\u001b[54Gat\u001b[57Gthis\u001b[62Gposition\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mmultiply(qc,\u001b[29Grot,\u001b[34Gout=qc)\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G  \u001b[14G  multiply(kcx, rot, out=kcx)\u001b[44G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G \u001b[13G   kc[:, pos, :] = k\u001b[34G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mvc[:,\u001b[22Gpos,\u001b[27G:]\u001b[30G=\u001b[32Gv\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             vct[:, :,\u001b[26Gpos]\u001b[31G=\u001b[33Gv\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'''),\r\u001b[1B \u001b[2m\u2502\u001b[22m (''' \u001b[10G        \u001b[19G matmul(wo, xb_s, out=p_\u001b[44G)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G      \u001b[14G  add_reduce(p_o[:, :,\u001b[37G0], axis=0, out=xb2)''', '''\u001b[77Gmatmul(wo,\u001b[88Gxb_s,\u001b[94Gout=p_o3)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22madd_reduce(p_o,\u001b[32Gaxis=0,\u001b[40Gout=xb2)'''),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[2"]
[889.598, "2m ('''            matmul(w1,\u001b[31Gxb_s,\u001b[37Gout=p_h)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22madd_reduce(p_h[:,\u001b[34G:,\u001b[37G0],\u001b[41Gaxis=0,\u001b[49Gout=hb)\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8G     \u001b[14G  m\u001b[18Gtmul(\u001b[24G3, xb_\u001b[31G, out=p_h)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         \u001b[13G  \u001b[16Gadd_reduce(p_h[:, :\u001b[37G0],\u001b[41Gaxis=0, out=hb2)''', '''     \u001b[71G   \u001b[75G  matmul(w13, xb_s, out=p_h133)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m      \u001b[10G   \u001b[14G  add_reduce(p_h13, axis=0, out=h13)'''),\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m('''\u001b[20Gmatmul(w2,\u001b[31Ghb_s,\u001b[37Gout=p_d)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             add_reduce(p_d[:,\u001b[34G:,\u001b[37G0],\u001b[41Gaxis=0,\u001b[49Gout=xb)''',\u001b[61G'''\u001b[76Gmatmul(w2,\u001b[87Ghb_s,\u001b[93Gout=p_d3)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22madd_reduce(p_d,\u001b[32Gaxis=0,\u001b[40Gout=xb)'''),\r\u001b[1B \u001b[2m\u2502\u001b[22m ]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for a, b \u001b[15G r\u001b[18Gp:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22massert\u001b[15Gs.count(a)\u001b[26G==\u001b[29G1,\u001b[32Ga\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     s = s.replace(a,\u001b[25Gb)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace(\"\u001b[27Gself.h13\u001b[36G=\u001b[38Gnp.zeros\",\u001b[49G\"\u001b[58Gqd\u001b[61G=\u001b[63Gn_heads\u001b[7"]
