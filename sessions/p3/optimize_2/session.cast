[652.495, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided\u001b[11Gviews\u001b[17Gdrop\u001b[22Gto\u001b[25G34\u001b[28GGB/s,\u001b[34Gso\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[1B \u001b[3Gswitch\u001b[14Go a\u001b[18Gread-only memmap that copies\u001b[47Gstraight\u001b[56Ginto\u001b[61Gthe\u001b[65Gblocked\u001b[73Glayout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[1B  about 2 ms per token.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m \u001b[23Ghell command\u001b[36G\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses with the same error\u001b[30Glevel.\u001b[37GBenchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m Per-token time drops about 20%: \u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m. But load went from ~0.12\u20130.22 s\u001b[K\r\u001b[1C\u001b[1B to ~0.37\u20130.87\u001b[17Gs.\u001b[20GI'll\u001b[25Gprofile\u001b[33Gthe\u001b[37Gloader\u001b[44Gto\u001b[47Gwin\u001b[51Gthat\u001b[56"]
[652.497, "Gback:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mR\u001b[5Gn \u001b[1m1\u001b[22m shell\u001b[15Gc\u001b[17Gmmand \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The first call includes first-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[1C\u001b[1B each strategy in its own process:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gblocked load is \u001b[24Gnly about\u001b[34G0.10\u001b[39Gs\u001b[41Gwith\u001b[46Gmemmap\u001b[53Gand\u001b[57G0.075\u001b[63Gs\u001b[65Gwith\u001b[70Gchunked\u001b[78Greadinto,\u001b[88Gagainst\u001b[96G0.055\u001b[102Gs\u001b[104Gfor\u001b[108Gplain\r\u001b[1C\u001b[1B fromfile, so that overh\u001b[27Gad d\u001b[32Gesn't explain the\u001b[50G0.37\u20130.87 s seen earl\u001b[72Ger. I'm m\u001b[82Ga\u001b[84Guring time-to-READY directly next.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Measuring \u001b[14Gime \u001b[19Go READY for v2 and new\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/ready.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m# Wall time from process start to READ"]
[652.498, "Y (min/median of N fresh starts).\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport subprocess, sys, time, statistics\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mprog = sys.argv[1:]; ts = []\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102mfor _ in range(7):\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mt = time.perf_counter()\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mp = subprocess.Popen(prog + ['model.bin', 'tokenizer.bin'], stdin=subprocess.PIPE, s\u2026\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u00b7\u001b[39m \u001b[38;2;226;130;98mCascading\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(10m 39s \u00b7 \u2193\u001b[27G34.1k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\u001b[39m\u001b[K\r\u001b[6C\u001b[1B      \u001b[14G        \u001b[23G  \u001b[26G                      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
