[705.178, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token time drops about 20%: \u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[2C\u001b[1Bto\u001b[6G~0.37\u20130.87\u001b[17Gs.\u001b[20GI'll\u001b[25Gprofile\u001b[33Gthe\u001b[37Gloader\u001b[44Gto\u001b[47Gwin\u001b[51Gthat\u001b[56Gback:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe first call includes fi\u001b[30Gst-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[2C\u001b[1Beach\u001b[8Gstrategy\u001b[17Gin\u001b[20Gits\u001b[24Gown\u001b[28Gprocess:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe blocked load is only about 0.10 s with\u001b[46Gmemmap and 0.075 s with chunked readinto, aga\u001b[92Gnst 0.055 s\u001b[104Gfo\u001b[107G plain\u001b[K\r\u001b[2C\u001b[1Bfromfile,\u001b[13Gso\u001b[16Gthat\u001b[21Goverhead\u001b[30Gdoesn't\u001b[38Gexplain\u001b[46Gthe\u001b[50G0.37\u20130.87\u001b[60Gs\u001b[62Gseen\u001b[67Gearlier.\u001b[76GI'm\u001b"]
[705.179, "[80Gmeasuring\u001b[90Gtime-to-READY\u001b[104Gdirectly\u001b[113Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe blocked loader adds ~37 ms to\u001b[37Gstar\u001b[42Gup\u001b[45G(0.113\u001b[52G\u2192\u001b[54G0.150\u001b[60Gs).\u001b[64GSince\u001b[70Gchunked\u001b[78G\u001b[38;2;87;105;247mreadinto\u001b[87G\u001b[39mwas\u001b[91Gfaster\u001b[98Gthan\u001b[103Gmemmap\u001b[110Gin\u001b[113Gfresh\r\u001b[2C\u001b[1Bprocesses,\u001b[14GI'll\u001b[19Gswitch\u001b[26Gthe\u001b[30Gloader\u001b[37Gto\u001b[40Git:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mS\u001b[5Gartup\u001b[11Gis now within\u001b[25Gabout 20\u001b[34Gms of v2, \u001b[45Gnd\u001b[48Gthe a\u001b[54Gtention we\u001b[65Gg\u001b[67Gted sum's \u001b[78Gost looks\u001b[88Glike\u001b[93Ga\u001b[95Gprefetch\u001b[104Gproblem\u001b[112Gfrom\u001b[117Gthe\r\u001b[2C\u001b[1Bstrided\u001b[11GV\u001b[13Glayout.\u001b[21GI'm\u001b[25Gsweeping\u001b[34Gthe\u001b[38Gcandidate\u001b[48Glayouts\u001b[56Gover\u001b[61GT\u001b[63Gwith\u001b[68Ga\u001b[70Gcold\u001b[75Gcache\u001b[81Gnext.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Sweeping weighted-sum variants over context\u001b[47Glength\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $\u001b[8Gca\u001b[11G > prof/wsum_sweep.py "]
[705.179, "<<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m# Atten\u001b[15Gon weighted sum, 12 layers, cold cache: (t,d) layout via matmul / einsum vs (d,t) layout via vecdot.\r\u001b[5C\u001b[1Bimport time, num\u001b[23Gy\u001b[25Gas np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mF = np.float32; pc = time.perf_counter; rng = np.random.default_rng(0)\r\u001b[5C\u001b[1BL, H, hs, S = 12,\u001b[24G12, 6\u001b[30G, 1024\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mjunk = np.ones(64\u001b[24G* 1024 * \u2026\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
