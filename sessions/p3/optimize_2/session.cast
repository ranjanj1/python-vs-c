[370.913, "\u001b[H\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mScanning dot throughput\u001b[27Gversus\u001b[34Grow\u001b[38Glength\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/dotlen.py <<'EOF'\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102m# vecdot throughput vs row length (cold-ish: 48 MB working set > caches), fixed total bytes.\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mimport time, numpy as np\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mF = np.float32; pc = time.perf_counter\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mtot = 12\u001b[15G* 1024 * 1024 # floats (48 MB)\r\u001b[5C\u001b[1Bfor n in (64, 128, 256, 300, 384, 512, 600, 700, 768, 800, 1000, 1024, \u2026\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: auto "]
[370.914, "mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mSc\u001b[7Gdot throughput versus row length\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m c\u001b[6Gt > prof/dotlen.py\u001b[25G<<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m # vecd\u001b[11Gt throughput vs row length\u001b[38G(co\u001b[42Gd-ish: 48\u001b[52GMB\u001b[55Gworking set >\u001b[69Gcach\u001b[74Gs), fixed\u001b[84Gtotal\u001b[90Gbytes.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gtime,\u001b[17Gnumpy\u001b[23Gas\u001b[26Gnp\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m F = np.float32; pc = time.perf_counter\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mtot\u001b[8G=\u001b[10G12\u001b[13G*\u001b[15G1024\u001b[20G*\u001b[22G1024\u001b[28G#\u001b[30Gfloats\u001b[37G(48\u001b[41GMB)\r\u001b[1B \u001b[2m\u2502\u001b[22m for n in (64, 128, 256, 300, 384, "]
[370.915, "512, 600,\u001b[48G700, 768,\u001b[58G800, 1000, 1024, 1536, 2048, 4096):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mrows\u001b[13G=\u001b[15Gtot\u001b[19G//\u001b[22Gn;\u001b[25GW\u001b[27G=\u001b[29Gnp.ones((rows,\u001b[44Gn),\u001b[48GF);\u001b[52Gx\u001b[54G=\u001b[56Gnp.ones(n,\u001b[67GF);\u001b[71Go\u001b[73G=\u001b[75Gnp.empty(rows,\u001b[90GF)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     best = 1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gr\u001b[14Gin\u001b[17Grange(5):\r\u001b[1B \u001b[2m\u2502\u001b[22m         t\u001b[14G=\u001b[16Gpc(); np.vecdo\u001b[31G(W, x,\u001b[38Gout=o); best = min(best, pc()\u001b[68G-\u001b[70Gt)\u001b[73G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     best2\u001b[14G= 1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gr\u001b[14Gin\u001b[17Grange(5):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         t = pc(); np.dot(W,\u001b[32Gx,\u001b[35Gout=o);\u001b[43Gbest2\u001b[49G=\u001b[51Gmin(best2,\u001b[62Gpc()\u001b[67G-\u001b[69Gt)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint('n=%5d\u001b[22Gvecdot\u001b[29G%5.1f\u001b[35GGB/s\u001b[42Ggemv\u001b[47G%5.1f\u001b[53GGB/s'\u001b[59G%\u001b[61G(n,\u001b[65Gtot\u001b[69G*\u001b[71G4\u001b[73G/\u001b[75Gbest\u001b[80G/\u001b[82G1e9,\u001b[87Gtot\u001b[91G*\u001b[93G4\u001b[95G/\u001b[97Gbest2\u001b[103G/\u001b[105G1e9))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m pytho\u001b[10G3\u001b[12Gprof/dotlen.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[370.915, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 prof/dotlen.py\u001b[67G\u001b[22mcommands\u001b[76Gin\u001b[79G\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
