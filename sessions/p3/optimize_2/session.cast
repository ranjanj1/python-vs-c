[185.365, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[5G\u001b[22m'scores_einsum':\u001b[22Glambda\u001b[29Gqg,\u001b[33Gkc,\u001b[37GT,\u001b[40Gatt:\u001b[45Gnp.einsum('hqd,htd->hqt',\u001b[71Gqg,\u001b[75Gkc[:,\u001b[81G:T,\u001b[85G:],\u001b[89Gout=att),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m'scores_perhead_gemv':\u001b[28Glambda\u001b[35Gqg,\u001b[39Gkc,\u001b[43GT,\u001b[46Gatt:\u001b[51G[np.dot(kc[h,\u001b[65G:T],\u001b[70Gqg[h,\u001b[76G0],\u001b[80Gout=att[h,\u001b[91G0])\u001b[95Gfor\u001b[99Gh\u001b[101Gin\u001b[104Grange(H)],\r\u001b[1B \u001b[2m\u2502\u001b[22m }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m WVARS = {\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m'wsum_matmul':\u001b[20Glambda\u001b[27Gatt,\u001b[32Gvc,\u001b[36GT,\u001b[39Gout:\u001b[44Gnp.matmul(att,\u001b[59Gvc[:,\u001b[65G:T,\u001b[69G:],\u001b[73Gout=out),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  'wsum_einsum': lambda\u001b[27Gatt,\u001b[32Gvc,\u001b[36GT,\u001b[39Gout:\u001b[44Gnp.einsum('hqt,htd->hqd',\u001b[70Gatt,\u001b[75Gvc[:,\u001b[81G:T,\u001b[85G:],\u001b[89Gout=out),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m'wsum_perhead_gemv':\u001b[26Glambda\u001b[33Gatt,\u001b[38Gvc,\u001b[42GT,\u001b[45Gout:\u001b[50G[np.dot(att[h,\u001b[65G0],\u001b[69Gvc[h,\u001b[75G:T],\u001b[80Gout=out[h,\u001b[91G0])\u001b[95Gfor\u001b[99Gh\u001b[101Gin\u001b[104Grange(H)],\r\u001b[1B \u001b[2m\u2502\u001b[22m }\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for p in range(\u001b[20G000): m.forward(5 + p % 300, p)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b["]
[185.366, "4G\u001b[22mqg\u001b[7G=\u001b[9Gm.qg.copy();\u001b[22Gs\u001b[24G=\u001b[26Gm.sqrt_hs\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for T in (81, 1000):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22matt\u001b[12G=\u001b[14Gnp.empty((H,\u001b[27G1,\u001b[30GT),\u001b[34GF32);\u001b[40Gout\u001b[44G=\u001b[46Gnp.empty((H,\u001b[59G1,\u001b[62Ghs),\u001b[67GF32)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G def timei\u001b[18G(fn):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gbest = 1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gr\u001b[18Gin\u001b[21Grange(5):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             tot = 0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mfor\u001b[20Gl\u001b[22Gin\u001b[25Grange(12):\r\u001b[1B \u001b[2m\u2502\u001b[22m        \u001b[12G  \u001b[15G     junk.\u001b[26Gax() \u001b[32G# evict\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m            \u001b[16G    t =\u001b[24Gpc(); fn(l); tot +=\u001b[44Gpc()\u001b[49G-\u001b[51Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mbest\u001b[21G=\u001b[23Gmin(best,\u001b[33Gtot)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         return best\u001b[24G*\u001b[26G1e3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mr\u001b[10G=\u001b[12G{k:\u001b[16Gtimeit(lambda\u001b[30Gl,\u001b[33Gf=f:\u001b[38Gf(qg,\u001b[44Gm.key_cache[l],\u001b[60GT,\u001b[63Gatt))\u001b[69Gfor\u001b[73Gk,\u001b[76Gf\u001b[78Gin\u001b[81GVARS.items()}\r\u001b[1B \u001b[2m\u2502\u001b[22m     np.matmul(qg, m.key_cache[0][:, :T, :].transpose(0, 2, 1), out=att)\u001b[K\r\u001b[1C\u001b[1"]
[185.367, "B\u001b[2m\u2502\u001b[22m     def soft(l):\u001b[21G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G \u001b[13G = a\u001b[18Gt.copy(); a /= s;\u001b[36Ga -= a.max(axis=-1, keepdims=True);\u001b[72Gnp.exp(a,\u001b[82Gout=a);\u001b[90Ga\u001b[92G/=\u001b[95Ga.sum(axis=-1,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mkeepdims=True,\u001b[19Gdtype=F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     r['softmax(+copy)']\u001b[28G=\u001b[30Gtimeit(soft)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mr.update({k:\u001b[21Gtimeit(lambda\u001b[35Gl,\u001b[38Gf=f:\u001b[43Gf(att,\u001b[50Gm.value_cache[l],\u001b[68GT,\u001b[71Gout))\u001b[77Gfor\u001b[81Gk,\u001b[84Gf\u001b[86Gin\u001b[89GWVARS.items()})\r\u001b[1B \u001b[2m\u2502\u001b[22m     pri\u001b[12Gt('T=%d (12 layers, cold):' % T, ' '.join('%s %.3f' % kv for kv in r.items()))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/attn_split.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
