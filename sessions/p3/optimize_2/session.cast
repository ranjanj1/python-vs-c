[494.185, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding\u001b[11Gdidn't\u001b[18Ghelp,\u001b[24Gand\u001b[28Gvecdot's\u001b[37Gcost\u001b[42Gisn't\u001b[48Gmonotonic\u001b[58Gin\u001b[61GT,\u001b[64Gwhich\u001b[70Gsuggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[1B \u001b[3Gscanning dot spe\u001b[20Gd ag\u001b[25Ginst row length next, since the weight\u001b[64Gmatvec\u001b[71G may be\u001b[79Gaffect\u001b[86Gd too.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's\u001b[16Ggemv\u001b[21Ghits\u001b[26G58\u201360\u001b[32GGB/s\u001b[37Gon\u001b[40Gshort\u001b[46Grows\u001b[51Gversus\u001b[58G27\u201339\u001b[64Gon\u001b[67Glonger\u001b[74Gones,\u001b[80Gso\u001b[83GI'm\u001b[87Gtesting\u001b[95Ga\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[1B \u001b[3Gcontiguous colu\u001b[19Gn\u001b[21Gblocks with one\u001b[37Ggemv per\u001b[46Gblock and partial\u001b[64Gsums added, at the\u001b[83Greal shapes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gbatched\u001b[15Gblock\u001b[21Ggemv\u001b["]
[494.185, "26Gruns\u001b[31Gabout\u001b[37G25%\u001b[41Gfaster\u001b[48Gthan\u001b[53Gvecdot,\u001b[61Gat\u001b[64G53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[1B \u001b[3Gc\u001b[6Gcking whether a strided view without copying performs as well and what the load-time reorgani\u001b[101Gtion c\u001b[108Gsts before\u001b[119GI\r\u001b[3C\u001b[1Bommit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided\u001b[11Gviews\u001b[17Gdrop\u001b[22Gto\u001b[25G34\u001b[28GGB/s,\u001b[34Gso\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[1B \u001b[3Gswitching to a \u001b[19Gead-\u001b[24Gnly\u001b[28Gmemmap that \u001b[41Gopies straight \u001b[57Gnt\u001b[60G the blocked layout,\u001b[81Gke\u001b[84Gping load \u001b[95Go \u001b[98Gne p\u001b[103Gss and saving\u001b[K\r\u001b[2C\u001b[1Babout 2 ms per\u001b[18Gtoken.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mImplement\u001b[13Gcolumn-blocked\u001b[28Gweights\u001b[36Gand\u001b[40Gmatvecs,\u001b[49Grun\u001b[53Gfull\u001b[58Gcheck\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1B  \u23bf  $ python3 - <<"]
[494.186, "'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102ms\u001b[8G= ope\u001b[14G('run.py').read()\r\u001b[5C\u001b[1Ba\u001b[10Gs.i\u001b[14Gdex(\" data = np.fromfile(path, dtype='<f4', offset=28)\")\r\u001b[5C\u001b[1Bb\u001b[20G# RoPE\u001b[27Grotation table\")\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102ms\u001b[11G[:a] + '''\u001b[22G# Read \u001b[30Ghe checkpoint through a read-only memory map and copy every matrix once into a\r\u001b[5C\u001b[1B#\u001b[8Gcolumn-blocked layout (see blocked() / matvec\u2026 (3s)\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m(ctr\u001b[11G+b to run in background)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
