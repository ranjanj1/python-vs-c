[141.027, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u273b\u001b[39m \u001b[38;2;102;102;102mCrunched for 10m 11s \u00b7 done 3:53 PM\u001b[39m\u001b[K\r\u001b[2B\u001b[48;2;240;240;240m\u001b[38;2;102;102;102m\u276f \u001b[38;2;0;0;0mProfile this implementation on the supplied development workloads. Improve performance within the same rules and \u001b[39m     \r\u001b[1B  \u001b[38;2;0;0;0mremaining budget. Preserve the interface and correctness requirements. Do not use hidden evaluation inputs, external \u001b[39m \r\u001b[1B  \u001b[38;2;0;0;0mimplementations or other ports. Record profiling evidence, changes, tests and remaining limitations in NOTES.md.\u001b[39m      \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStarting\u001b[12Gfrom\u001b[17Gthe\u001b[21Gcurrent\u001b[29Gstate,\u001b[36GI'll\u001b[41Gre-profile\u001b[52Gto\u001b[55Gsee\u001b[59Gwhere\u001b[65Gthe\u001b[69Gremaining\u001b[79G~11\u001b[83Gms/token\u001b[92Ggoes\u001b[97Gand\u001b[101Glook\u001b[106Gfor\u001b[110Ganything\r\u001b[1B \u001b[3Gleft besid\u001b[14Gs the weight-str\u001b[32Gming flo\u001b[41Gr.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTimings\u001b[11Gare\u001b[15Gnoisy,\u001b[22Gso\u001b[2"]
[141.028, "5GI'm\u001b[29Gmeasuring\u001b[39Gcomponents\u001b[50Gin-process\u001b[61Gwith\u001b[66Gmin-of-N.\u001b[76GAttention\u001b[86Gcost\u001b[91Grises\u001b[97Gwith\u001b[102Gcontext\u001b[110G(12.7\r\u001b[1B \u001b[3Gms/token vs\u001b[15G~11.1 at ~80), so I'm checking attention layouts next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcurrent\u001b[15Gattention\u001b[25Glayout\u001b[32Gis\u001b[35Galready\u001b[43Gthe\u001b[47Gfastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[1B \u001b[3Go\u001b[12Gand startup precisely using min-of-N:\u001b[50G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Overhead is about 1.1 ms per token (10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan\r\u001b[2C\u001b[1Binstrumented copy of the forward pass:\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39"]
[141.029, "mWeight matvecs take nearly all of the\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[2C\u001b[1Blayer, against 17 \u00b5s benchmarked\u001b[36Galone),\u001b[44Gprobably\u001b[53Gfrom\u001b[58Ga\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-head\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[2C\u001b[1Bbatched variants directly\u001b[29Ginside\u001b[36Gthe\u001b[40Glive\u001b[45Gforward\u001b[53Gpass.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand\u2026\r\u001b[25C\u001b[2B\u001b[38;2;102;102;102m8\u001b[28G6\u001b[39m\u001b[40;1H\u001b[38;3H"]
