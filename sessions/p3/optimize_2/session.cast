[801.566, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gbl\u001b[10Gcked\u001b[15Gload\u001b[20Gis only about 0.10 s\u001b[41Gwith\u001b[46Gmemmap\u001b[53Gand\u001b[57G0.075\u001b[63Gs\u001b[65Gwith\u001b[70Gchunked\u001b[78Greadinto,\u001b[88Gagainst\u001b[96G0.055\u001b[102Gs\u001b[104Gfor\u001b[108Gplain\r\u001b[1C\u001b[1B fromfile, so that ove\u001b[25Ghead\u001b[30Gdoesn't exp\u001b[42Gain\u001b[46Gthe 0.37\u20130.87 s seen earlier. I'm measuring time-to-READY directly\u001b[113Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The blocked loader adds ~37 ms to startup (0.113 \u2192 0.150 s).\u001b[64GSince\u001b[70Gchunked\u001b[78G\u001b[38;2;87;105;247mreadinto\u001b[87G\u001b[39mwas\u001b[91Gfaster\u001b[98Gthan\u001b[103Gmemmap\u001b[110Gin\u001b[113Gfresh\r\u001b[1C\u001b[1B proce\u001b[9Gses, I'll sw\u001b[22Gtch the\u001b[30Gloader to it:\u001b[44G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Startup\u001b[11Gis\u001b[14Gnow within about 20 ms of v2, and the attention weighted \u001b[72Gum's cost looks li"]
[801.568, "ke a\u001b[95Gprefetch\u001b[104Gproblem from the\r\u001b[1C\u001b[1B strided\u001b[11GV\u001b[13Glayout.\u001b[21GI'm\u001b[25Gsweeping the ca\u001b[41Gdid\u001b[45Gte layouts over T with a c\u001b[72Gld cache\u001b[81Gnext.\u001b[87G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m On\u001b[6Gthe original layou\u001b[25G, einsum wins up\u001b[42Gto\u001b[45GT\u2248750\u001b[51Gand\u001b[55Gtransposed\u001b[66Gvecdot\u001b[73Gwins\u001b[78Gbeyond\u001b[85Gthat,\u001b[91Gso\u001b[94GI'll\u001b[99Gkeep\u001b[104Gboth\u001b[109GV\u001b[111Glayouts\r\u001b[1C\u001b[1B and\u001b[7Gchoose \u001b[16Gr step\u001b[24Geinsum below\u001b[37GT=768\u001b[43Gand\u001b[47Gvecdot\u001b[54Gfrom\u001b[59Gthere.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Cost\u001b[8Grises steadily wit\u001b[27G position (8.6\u201310.0\u001b[47Gms\u001b[50Gfor v3 versus 10.6\u201313.2\u001b[74Gms\u001b[77Gfor\u001b[81Gv2).\u001b[86GSince\u001b[92Gcheck.py\u001b[101Gonly\u001b[106Gcovers\r\u001b[1C\u001b[1B positions\u001b[13Gup\u001b[16Gto 25 on this\u001b[30Gmodel, I'm verifying more widely against\u001b[71Gthe\u001b[75Gv1\u001b[78Gimplementation\u001b[93Gon\u001b[96Gfull\u001b[101G1,024-position\r\u001b[1C\u001b[1B logits\u001b"]
