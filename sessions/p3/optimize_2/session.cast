[418.952, "\u001b[H\u001b[2G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Transposed V wins at 999 but loses at 300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[1B  conflicts; I'm testing padded strides next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Padding didn't help, and vecdot's\u001b[37Gcost\u001b[42Gisn't\u001b[48Gmonotonic\u001b[58Gin\u001b[61GT,\u001b[64Gwhich\u001b[70Gsuggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[1C\u001b[1B scanning dot speed against\u001b[30Grow\u001b[34Glength\u001b[41Gnext,\u001b[47Gsince\u001b[53Gthe\u001b[57Gweight\u001b[64Gmatvecs\u001b[72Gmay\u001b[76Gbe\u001b[79Gaffected\u001b[88Gtoo.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Accelerate'\u001b[15G gemv hits 58\u201360 GB/s\u001b[37Gon\u001b[40Gshort\u001b[46Grows\u001b[51Gversus\u001b[58G27\u201339\u001b[64Gon\u001b[67Glonger\u001b[74Gones,\u001b[80Gso\u001b[83GI'm\u001b[87Gtesting\u001b[95Ga\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[1C\u001b[1B contiguo\u001b[12Gs column\u001b[21Gblocks\u001b[28"]
[418.953, "Gwith\u001b[33Gone\u001b[37Ggemv\u001b[42Gper\u001b[46Gblock\u001b[52Gand\u001b[56Gpartial\u001b[64Gsums\u001b[69Gadded,\u001b[76Gat\u001b[79Gthe\u001b[83Greal\u001b[88Gshapes.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The batched block gemv\u001b[26Gruns about 25% faster than vecdot,\u001b[61Gat 53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[1C\u001b[1B checking whether a strided view with\u001b[40Gut copying performs\u001b[60Gas\u001b[63Gwell\u001b[68Gand\u001b[72Gwhat\u001b[77Gthe\u001b[81Gload-time\u001b[91Greorganisation\u001b[106Gcosts\u001b[112Gbefore\u001b[119GI\r\u001b[1C\u001b[1B commi\u001b[9G.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Testing strided-view\u001b[25Glocks and reorg\u001b[41Gload cost\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/blocked2.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G \u001b[6G\u001b[38;2;102;102;102mimport time, numpy as np\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G \u001b[6G\u001b[38;2;102;102;102mF = np.float32; pc = time.perf_counter; rng = np.random.default_rng(0)\u001b[77G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mdef bench(f, n=20, r=5):\u001b[39m\u001b[K\r\u001b[1C\u001b[1"]
