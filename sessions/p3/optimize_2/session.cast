[1247.973, "\u001b[H\u001b[3G  \u001b[6GTime to READY rose by about 25 ms (0.113\u001b[47G\u2192 ~0.14 s), wh\u001b[62Gch pays for itself af\u001b[85Gr\u001b[87Groughly 12 \u001b[100Gkens.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mTwo copies of the V cache.\u001b[22m V is \u001b[39Gtored both as (position, dim) and as (dim, positi\u001b[89Gn). The weighted\u001b[106Gsum\u001b[110Guses\u001b[115G\u001b[38;2;87;105;247meinsum\r\u001b[2C\u001b[1B\u001b[39m  \u001b[6Gon the first copy below 768 po\u001b[37Giti\u001b[41Gns and \u001b[38;2;87;105;247mvecdot\u001b[39m \u001b[56Gn \u001b[59Ghe second\u001b[69Gfrom 768 up\u001b[82Gwhere my sweep\u001b[97Gfound the cros\u001b[112Gover.\u001b[K\r\u001b[5C\u001b[1BBoth add over positions\u001b[30Gin order, as the reference does.\u001b[K\r\u001b[2C\u001b[1B4.\u001b[6G\u001b[1mFused matrices.\u001b[22m Q, K and V, and W1 and W3, are \u001b[54Gow\u001b[57Gstacked\u001b[65Gat\u001b[68Gload\u001b[73Gat\u001b[76Gno\u001b[79Gextra\u001b[85Gcost,\u001b[91Gwhich\u001b[97Gsaves\u001b[103Gabout\u001b[109G0.15\u001b[114Gms\u001b[117Gper\r\u001b[2C\u001b[1B  \u001b[6Gtoken.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mResults (milliseconds per token, best run, alternated with last round's code)\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B\u250c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500"]
[1247.975, "\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\r\u001b[2C\u001b[1B\u2502  position  \u2502  80   \u2502  300  \u2502  600  \u2502  999  \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 last round \u2502 10.62 \u2502 11.23 \u2502 12.15 \u2502 13.23 \u2502\r\u001b[2C\u001b[1B\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\r\u001b[2C\u001b[1B\u2502 now        \u2502 8.43  \u2502 8.91  \u2502 9.80  \u2502 9.83  \u2502\r\u001b[2C\u001b[1B\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2534\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOver\u001b[8Gthe\u001b[12Gfull\u001b[17Gcommand\u001b[25Gprotocol\u001b[34G(best\u001b[40Gof\u001b[43G2),\u001b[47Gthe\u001b[51Gtotal\u001b[57Gwent\u001b[62Gfrom\u001b[67G18.71\u001b[73Gs\u001b[75Gto\u001b[78G15.12\u001b[84Gs,\u001b[87Gand\u001b[91Gthe\u001b[95G1,021-token\u001b[107Gprompt\u001b[114Gfrom\r\u001b[2C\u001b[1B13.06 s to 10.54 s. Compared with the \u001b[42Girst\u001b[47Gversi\u001b[53Gn, th\u001b[59G forward pass\u001b[73Gis about 40% f\u001b[88Gst"]
[1247.977, "er.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mTests\r\u001b[2C\u001b[1B\u001b[22m- I compared\u001b[16Gthe\u001b[20Gnew\u001b[24Gcode\u001b[29Gagainst\u001b[37Gthe\u001b[41Gplain\u001b[47Gfirst-round\u001b[59Gversion\u001b[67Gover\u001b[72Gall\u001b[76G1,024\u001b[82Gpositions\u001b[92Gof\u001b[95Gthe\u001b[99Greal\u001b[104Gmodel,\u001b[111Gcovering\r\u001b[2C\u001b[1B \u001b[5Gboth V-cache paths. I also used\u001b[39Gree ra\u001b[46Gdom \u001b[51Gynthetic models, which test grouped-query at\u001b[96Gention (few\u001b[108Gr KV h\u001b[115Gads\u001b[K\r\u001b[4C\u001b[1Bthan\u001b[10Gquery heads), a separate ou\u001b[38Gput matrix,\u001b[50Gand sizes\u001b[60Gthat don't divide int\u001b[82G blocks. Logi\u001b[96Gs d\u001b[100Gffer by at most\u001b[K\r\u001b[4C\u001b[1B2.3e-5, and the top token never differs.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe edge-case answers are\u001b[31Gbyt\u001b[35G-i\u001b[38Gentical\u001b[46Gto\u001b[49Gthe\u001b[53Gfirst\u001b[59Gversion,\u001b[68Gand\u001b[72Gboth\u001b[77Gstop\u001b[82Grules\u001b[88Gstill\u001b[94Gbehave\u001b[101Gas\u001b[104Gbefore.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\r\u001b[2C\u001b[1B\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GAbout\u001b[11G0.95\u001b[16Gms\u001b[19Gper\u001b[23Gtoken\u001b[29Gis\u001b[32Gleft\u001b[37Goutside\u001b[45Gthe\u001b[49Gweight\u001b[56Greads:\u001b[63Groughly\u001b[71G0.55\u001b[76Gms\u001b[79Gof\u001b[82Gattention\u001b[92Gslowed\u001b[99Gby\u001b[102Gthe\u001b[106Gcol"]
[1247.978, "d\u001b[111Gcache,\u001b[118Gand\r\u001b[2C\u001b[1B \u001b[5Gmany small\u001b[16GNumPy calls.\u001b[29GFurther\u001b[37Ggains ther\u001b[50Gould be \u001b[59G few percent at mo\u001b[78Gt.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GBlock size\u001b[16G128 and the switc\u001b[34G at 768 positions are tuned to this machine's Accelerate\u001b[91Glibrary.\u001b[100GElsewhere\u001b[110Gthey\u001b[115Gmight\r\u001b[2C\u001b[1B \u001b[5Gnot be th\u001b[16Gfastest\u001b[24Gc\u001b[26Goice, but \u001b[37Ghe results stay correct.\u001b[62G\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gs\u001b[11Gcond\u001b[16GV copy uses 37 MB more memory.\u001b[K\u001b[40;1H\u001b[38;3H"]
