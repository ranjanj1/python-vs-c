[498.872, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gwins\u001b[21Gat\u001b[24G999\u001b[28Gbut\u001b[32Gloses\u001b[38Gat\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[1B \u001b[3Gconf\u001b[8Gicts; I'm test\u001b[23Gng\u001b[26Gpadded strides nex\u001b[45G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding\u001b[11Gdidn't\u001b[18Ghelp,\u001b[24Gand\u001b[28Gvecdot's\u001b[37Gcost\u001b[42Gisn't\u001b[48Gmonotonic\u001b[58Gin\u001b[61GT,\u001b[64Gwhich\u001b[70Gsuggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[1B \u001b[3Gscanning dot speed against row length\u001b[41Gnex\u001b[45G, since\u001b[53Gthe weigh\u001b[64Gmatvecs may be affected too.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's gemv hits\u001b[26G58\u201360\u001b[32GGB/s\u001b[37Gon\u001b[40Gshort\u001b[46Grows\u001b[51Gversus\u001b[58G27\u201339\u001b[64Gon\u001b[67Glonger\u001b[74Gones,\u001b[80Gso\u001b[83GI'm\u001b[87Gtesting\u001b[95Ga\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[2C\u001b[1Bcontiguous\u001b[14Gcol"]
[498.873, "umn\u001b[21Gblocks\u001b[28Gwith\u001b[33Gone\u001b[37Ggemv\u001b[42Gper\u001b[46Gblock\u001b[52Gand\u001b[56Gpartial\u001b[64Gsums\u001b[69Gadded,\u001b[76Gat\u001b[79Gthe\u001b[83Greal\u001b[88Gshapes.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gbatched\u001b[15Gblock\u001b[21Ggemv\u001b[26Gruns\u001b[31Gabout\u001b[37G25%\u001b[41Gfaster\u001b[48Gthan\u001b[53Gvecdot,\u001b[61Gat\u001b[64G53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[2C\u001b[1Bchecking whether a strided view without\u001b[43Gcopying\u001b[51Gperforms\u001b[60Gas\u001b[63Gwell\u001b[68Gand\u001b[72Gwhat\u001b[77Gthe\u001b[81Gload-time\u001b[91Greorganisation\u001b[106Gcosts\u001b[112Gbefore\u001b[119GI\r\u001b[2C\u001b[1Bcommit.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Strided views drop to 34 GB/s, so blocks must be contiguous, and reorganising the checkpoint costs about 0.3 s. I'm\u001b[K\r\u001b[2C\u001b[1Bswitching to a read-only memmap that copies straight into the blocked layout, keeping load to one pass and saving\u001b[K\r\u001b[2C\u001b[1Babout\u001b[9G2\u001b[11Gms\u001b[14Gper\u001b[18Gtok"]
[498.876, "en.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Passes with the same error level. Benchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Benchmarking blocked version agai\u001b[37Gst v2\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2; do python3 prof/long.py prof run_v2; python3 prof/long.py . run; done; for i in 1 2; do echo \"v2: \r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102m$(python3 prof/bench.py prof run_v2 | tr '\\n' ' ')\"; echo \"new: $(python3 prof/bench.py . run | tr '\\n' ' ')\"; done\r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2733\u001b[3G\u001b[38;2;245;149;117mCascading\u2026\u001b[38;2;215;119;87m \u001b[38;2;102;102;102m(8m 7s \u00b7 \u2193\u001b[25G31.0k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
