[1234.008, "\u001b[H\u001b[2G\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[4G\u001b[22m##\u001b[7GWhat\u001b[12Gis\u001b[15Gimplemented\u001b[27G(run.py)\"\"\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m s = s.replace(\"\"\"  `memory_map_weights`\u001b[44G(including\u001b[55Gskipping\u001b[64Gthe\u001b[68Glegacy\u001b[75Gfreq_cis\u001b[84Gtables).\u001b[93GLoaded\u001b[100Gonce\u001b[105Gwith\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m`np.fromfile`\u001b[18Gas\u001b[21Gfloat32.\r\u001b[1B \u001b[2m\u2502\u001b[22m - Forward pass per tok\u001b[27Gn, per position, batch 1, all layers, float32\u001b[74Ghroughout (dtype audit\u001b[97Gin `prof/par\u001b[110Gs2.py`):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   rmsnorm\u001b[14G(1e-5,\u001b[21G`w*(ss*x)`),\u001b[34Gseparate\u001b[43Gfloat32\u001b[51Gmatvecs,\u001b[60GRoPE\"\"\",\u001b[69G\"\"\"\u001b[74G`memory_map_weights`\u001b[95G(including\u001b[106Gskipping\u001b[115Gthe\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mlegacy\u001b[11Gfreq_cis\u001b[20Gtables).\u001b[29GStreamed\u001b[38Gonce\u001b[43Gand\u001b[47Gstored\u001b[54Gas\u001b[57Gfloat32\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   column blocks (QKV\u001b[25Gand\u001b[29GW1|W3\u001b[35Gstacked\u001b[43Gper\u001b[47Glayer);\u001b[55Gthe\u001b[59Gshared\u001b[66Gembedding\u001b[76Grows\u001b[81Gare\u001b[85Gread\u001b[90Gfrom\u001b[95Gthe\u001b[99Gblocked\u001b[107Gclassifier.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-\u001b[6GForward\u001b[14Gpass\u001b[19Gper\u001b[23Gtoken,\u001b[30Gpe"]
[1234.008, "r\u001b[34Gposition,\u001b[44Gbatch\u001b[50G1,\u001b[53Gall\u001b[57Glayers,\u001b[65Gfloat32\u001b[73Gthroughout\u001b[84G(dtype\u001b[91Gaudit\u001b[97Gin\u001b[100G`prof/parts2.py`):\r\u001b[1B \u001b[2m\u2502\u001b[22m   rmsnorm (1e-5,\u001b[21G`w*(s\u001b[27G*x)`), blocked float32 matv\u001b[55Gcs (batched g\u001b[69Gmv\u001b[72G+ partial-sum r\u001b[88Gduce), RoPE\"\"\")\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace(\"\"\"-\u001b[23GKV\u001b[26Gcache:\u001b[33Gfloat32,\u001b[42G(layer,\u001b[50Gkv_head,\u001b[59Gseq_len,\u001b[68Ghead_size).\u001b[80GEach\u001b[85Gcommand\u001b[93Gzeroes\u001b[100Gthe\u001b[104Gpositions\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m written by\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mthe\u001b[10Gprevious\u001b[19Gcommand\u001b[27Gand\u001b[31Gstarts\u001b[38Gat\u001b[41Gposition\u001b[50G0.\"\"\",\u001b[57G\"\"\"-\u001b[62GKV\u001b[65Gcache:\u001b[72Gfloat32.\u001b[81GK\u001b[83Gis\u001b[86G(layer,\u001b[94Gkv_head,\u001b[103Gseq_len,\r\u001b[1B \u001b[2m\u2502\u001b[22m \u001b[6Gad_size); V is kept\u001b[26Gas (\u2026,\u001b[33Gseq_len, head_size) and\u001b[57G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   (\u2026, head_size, seq_len) with identica\u001b[44G con\u001b[49Gents. Each command zeroes the \u001b[80Gositi\u001b[86Gns writ\u001b[94Gen by the\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   previous command and st\u001b[30Grts at position\u001b[46G0.\"\"\")\r\u001b[1C\u001b[1B\u001b[2m\u2502"]
[1234.009, "\u001b[4G\u001b[22ms\u001b[6G=\u001b[8Gs.replace(\"\"\"-\u001b[23GStill\u001b[29Gmemory-bandwidth\u001b[46Gbound:\u001b[53G~10.4\u001b[59Gms/token\u001b[68Gis\u001b[71Gspent\u001b[77Gstreaming\u001b[87G438\u001b[91GMB\u001b[94Gof\u001b[97Gfloat32\u001b[105Gweights\u001b[113Gat\u001b[116G~42\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m GB/s\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mthrough\u001b[14GNumPy/Accelerate\u001b[31Gkernels.\u001b[40GWithout\u001b[48Gcompiled\u001b[57Gcode\u001b[62Gor\u001b[65Gbatching,\u001b[75GI\u001b[77Gfound\u001b[83Gnothing\u001b[91Gin\u001b[94GNumPy\u001b[100Gthat\u001b[105Gstreams\r\u001b[1B \u001b[2m\u2502\u001b[22m fas\u001b[8Ger.\"\"\",\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m \"\"\"-\u001b[9GStill memory-bandwidth bound: ~7.4 ms/token streams\u001b[61G438\u001b[65GMB of float32 weights\u001b[87Gat ~59 GB/\u001b[98G,\u001b[100Gabout this\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22mmachine's\u001b[16Gsingle-thread\u001b[30Gread\u001b[35Gspeed.\u001b[42GFurther\u001b[50Gper-token\u001b[60Ggains\u001b[66Gwould\u001b[72Ghave\u001b[77Gto\u001b[80Gcome\u001b[85Gfrom\u001b[90Gthe\u001b[94Gremaining\u001b[104G~0.95\u001b[110Gms\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   (cold-cache\u001b[18Gattention\u001b[28G~0.55\u001b[34Gms\u001b[37Gat\u001b[40Gshort\u001b[46Gcontext,\u001b[55G~25\u001b[59Gsmall\u001b[65GNumPy\u001b[71Gcalls\u001b[77Gper\u001b[81Glayer).\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m-\u001b[6GThe\u001b[10Gspeedups\u001b[19Grely\u001b[24Gon\u001b[27Gmeasured"]
[1234.01, "\u001b[36Gproperties\u001b[47Gof\u001b[50Gthis\u001b[55Gmachine's\u001b[65GAccelerate\u001b[76Gbuild:\u001b[83Gthe\u001b[87Gshort-row\u001b[97Ggemv\u001b[102Gfast\u001b[107Gpath,\r\u001b[1B \u001b[2m\u2502\u001b[22m   block size 128,\u001b[22Gand the\u001b[30GV-layout switch at T\u001b[51G=\u001b[53G768. On a different BLAS or CPU these choices may\u001b[103Gno\u001b[107Gbe\u001b[110Gop\u001b[113Gimal\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[6G\u001b[22m(results\u001b[15Gwould\u001b[21Gstill\u001b[27Gbe\u001b[30Gcorrect).\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m - Memory: +37 MB for\u001b[25Gthe\u001b[29Gsecond\u001b[36GV-cache\u001b[44Glayout.\u001b[52GStartup\u001b[60Gis\u001b[63G~25\u001b[67Gms\u001b[70Gslower\u001b[77Gthan\u001b[82Ground\u001b[88G2\u001b[90Gbecause\u001b[98Gof\u001b[101Gthe\u001b[105Gblock\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mreorganisation.\"\"\")\r\u001b[1B \u001b[2m\u2502\u001b[22m \u001b[5Gpen('NOTES.md', 'w').write(s)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m grep -c \"\" NOTES.md; \u001b[26Grep -n \"Round 3\" NOTES.md\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[1234.01, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gaborted\u001b[17G(timeout,\u001b[27Gresource\u001b[36Glimit,\u001b[43Gor\u001b[46Gover-length)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
