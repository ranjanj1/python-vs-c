[28.387, "\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done\u001b[22m\u001b[K\r\u001b[4C\u001b[1B\u001b[1mCombining weight matrices:\u001b[22m merg\u001b[37Gng Q/K/V\u001b[46Gand W1/W3 into single calls saves only about 0.3 ms per\u001b[102Gtoken. It would\u001b[K\r\u001b[4C\u001b[1Bneed about 270 MB of copying\u001b[34Gat\u001b[37Gload,\u001b[43Gwhich\u001b[49Gloses\u001b[55Gon\u001b[58Gshort\u001b[64Gruns.\r\u001b[4C\u001b[1B\u001b[1mTransposed weights:\u001b[25G\u001b[22msimilar sp\u001b[36Ged,\u001b[40Gbut 5\u20137\u00d7 more rounding error.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mProcessing the whole prompt at once:\u001b[42G\u001b[22mreading\u001b[50Gthe\u001b[54Gweights\u001b[62Gonce\u001b[67Gper\u001b[71Gprompt\u001b[78Ginstead\u001b[86Gof\u001b[89Gonce\u001b[94Gper\u001b[98Gtoken\u001b[104Gwould\u001b[110Gbe\u001b[113Gmuch\r\u001b[4C\u001b[1Bfaster.\u001b[13GI\u001b[15Gdidn't\u001b[22Gdo\u001b[25Git\u001b[28Gbecause\u001b[36Gthe\u001b[40Grules\u001b[46Grequire\u001b[54Gbatch\u001b[60Gsize\u001b[65G1\u001b[67Gand\u001b[71Gthe\u001b[75Greference's\u001b[87Gcache-filling\u001b[101Gorder.\u001b[108GIf\u001b[111Gyou\u001b[115Gread\r\u001b[2C\u001b[1B  the rules differently, th\u001b[31Gt is the main remain\u001b[52Gng spe\u001b[59Gdup; it's your call.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\r\u001b[2C\u001b[1B\u001b[22m-\u001b[5GThe\u001b[9Gspeed\u001b[15Gis\u001b[18Gnow\u001b[22Gset\u001b[26Gby\u001b[29Gmemory:\u001b[37Gabout\u001b[43G10.4\u001b[48Gms\u001b[51Gp"]
