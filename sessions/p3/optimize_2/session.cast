[1053.403, "K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFu\u001b[6Gion saves ~0.11 m\u001b[24G/token (~1.3%).\u001b[40GIt's \u001b[46Gmall, but it's free\u001b[66Gat\u001b[69Gload and actually remove\u001b[94G calls, so I'll implement\r\u001b[2C\u001b[1Bit:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusion\u001b[10Gsaves\u001b[16G~0.15\u001b[22Gms/token,\u001b[32Gand\u001b[36Gcorrectness\u001b[48Gis\u001b[51Gunchanged\u001b[61Gon\u001b[64Gall\u001b[68Gmodels.\u001b[76GQuick\u001b[82Gtuning\u001b[89Gcheck\u001b[95Gof\u001b[98Gblock\u001b[104Gsize\u001b[109G(128\u001b[114Gvs\u001b[117G256\r\u001b[2C\u001b[1Bvs\u001b[6G384)\u001b[11Gin\u001b[14Gplace:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock 128 is slightly\u001b[25Gfaster\u001b[32G(~1%),\u001b[39Gand\u001b[43G384\u001b[47Gis\u001b[50Gmuch\u001b[55Gslower,\u001b[63Gconsistent\u001b[74Gwith\u001b[79Ggemv\u001b[84Gdropping\u001b[93Goff\u001b[97Gits\u001b[101Gfast\u001b[106Gpath\u001b[111Gabove\r\u001b[2C\u001b[1B256-float\u001b[13Grows.\u001b[19GChecking\u001b[28G64\u001b[31Gand\u001b[35G192\u001b[39Gas\u001b[42Gwell:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;"]
