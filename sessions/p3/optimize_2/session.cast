[1098.266, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusion\u001b[10Gsaves\u001b[16G~0.15\u001b[22Gms/token,\u001b[32Gand\u001b[36Gcorrectness\u001b[48Gis\u001b[51Gunchanged\u001b[61Gon\u001b[64Gall\u001b[68Gmodels.\u001b[76GQuick\u001b[82Gtuning\u001b[89Gcheck\u001b[95Gof\u001b[98Gblock\u001b[104Gsize\u001b[109G(128\u001b[114Gvs\u001b[117G256\r\u001b[1B \u001b[3Gvs 384) in place:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock\u001b[9G128\u001b[13Gis\u001b[16Gslightly\u001b[25Gfaster\u001b[32G(~1%),\u001b[39Gand\u001b[43G384\u001b[47Gis\u001b[50Gmuch\u001b[55Gslower,\u001b[63Gconsistent\u001b[74Gwith\u001b[79Ggemv\u001b[84Gdropping\u001b[93Goff\u001b[97Gits\u001b[101Gfast\u001b[106Gpath\u001b[111Gabove\r\u001b[1B \u001b[3G256-float\u001b[13Grow\u001b[17G. C\u001b[21Gecking 64 and 192\u001b[40Gs well:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m192\u001b[7Gis\u001b[10Gslow\u001b[15Gonly\u001b[20Gbecause\u001b[28G2048\u001b[33Gisn't\u001b[39Gdivisible\u001b[49Gby\u001b[52Git,\u001b[56Gso\u001b[59GW2\u001b[62Gfalls\u001b[68Gback\u001b[73Gto\u001b[76Ga\u001b[78Gsingle\u001b[85Gblock.\u001b[92GI'll\u001b[97Gput"]
[1098.267, "\u001b[101G128\u001b[105Gfirst\u001b[111Gin\u001b[114Gthe\r\u001b[1B \u001b[3Gpreference list:\u001b[20G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mNext,\u001b[9Gquantifying\u001b[21Gwhat's\u001b[28Gleft\u001b[33Gat\u001b[36Gposition\u001b[45G80:\u001b[49Gblocked-weight\u001b[64Gmatvecs\u001b[72Galone\u001b[78Gversus\u001b[85Gthe\u001b[89Gfull\u001b[94Gforward.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gweight\u001b[14Gmatvecs\u001b[22Gnow\u001b[26Ghit\u001b[30G59\u001b[33GGB/s,\u001b[39Gpast\u001b[44Gthe\u001b[48G~56\u001b[52GGB/s\u001b[57Gplain-read\u001b[68Gceiling,\u001b[77Gso\u001b[80Gthe\u001b[84Gremaining\u001b[94G~0.95\u001b[100Gms/token\u001b[109Gis\u001b[112Gmostly\r\u001b[1B \u001b[3Gcache-cold\u001b[14Gat\u001b[17Gentio\u001b[23G and small NumPy calls with little \u001b[59Geft to gain. I'm st\u001b[79Gpping opt\u001b[89Gm\u001b[91Gsation and moving\u001b[109Gon\u001b[112Gt\u001b[114G\u001b[K\r\u001b[2C\u001b[1Bend-to-en\u001b[15Gnd edge-c\u001b[25Gse\u001b[28Gvalidation.\u001b[40G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mEnd-to-end\u001b[14Gtiming,\u001b[22Gchecks,\u001b[30Gedge-case\u001b[40Gdiff\u001b[45Gvs\u001b[48Gv1\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B "]
