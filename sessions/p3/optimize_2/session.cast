[890.592, "[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All configurations match v1\u001b[31Gwith l\u001b[38Ggit differences\u001b[54Gunder\u001b[60G2.3e-5\u001b[67Gand\u001b[71Gno\u001b[74Gargmax\u001b[81Gmismatches.\u001b[93GFusing\u001b[100Gthe\u001b[104Gprojections\u001b[116Gnow\r\u001b[1C\u001b[1B costs\u001b[9Gnothing ext\u001b[21Ga since the loader cop\u001b[44Ges everyt\u001b[54Ging\u001b[58Ganyway,\u001b[66Gso\u001b[69GI'm\u001b[73Gchecking\u001b[82Gwhether\u001b[90Git\u001b[93Gspeeds\u001b[100Gup\u001b[103Gblocked\u001b[111Ggemv.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Fusion\u001b[10Gsaves\u001b[16G~0.11 ms/token\u001b[31G(~1.3%). It's small,\u001b[52Gbut\u001b[56Git's\u001b[61Gfree\u001b[66Gat\u001b[69Gload\u001b[74Gand\u001b[78Gactually\u001b[87Gremoves\u001b[95Gcalls,\u001b[102Gso\u001b[105GI'll\u001b[110Gimplement\r\u001b[1C\u001b[1B it:\u001b[16G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Rewire\u001b[10Gforward\u001b[18Gto\u001b[21Gfused\u001b[27Gbuffers,\u001b[36Gcheck,\u001b[43Gverify,\u001b[51Gbenchmark\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ python3 - <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102ms = open('run.py').read()\u001b[32G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mrep = "]
