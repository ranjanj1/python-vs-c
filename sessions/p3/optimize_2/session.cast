[678.574, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses\u001b[10Gwith\u001b[15Gthe\u001b[19Gsame\u001b[24Gerror\u001b[30Glevel.\u001b[37GBenchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token time drops about 20%: \u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[2C\u001b[1Bto\u001b[6G~0.37\u20130.87\u001b[17Gs.\u001b[20GI'll\u001b[25Gprofile\u001b[33Gthe\u001b[37Gloader\u001b[44Gto\u001b[47Gwin\u001b[51Gthat\u001b[56Gback:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe first call includes fi\u001b[30Gst-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[2C\u001b[1Beach\u001b[8Gstrategy\u001b[17Gin\u001b[20Gits\u001b[24Gown\u001b[28Gprocess:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell co"]
