[151.488, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[8G\u001b[22mx,\u001b[11Gxb,\u001b[15Gxb2,\u001b[20Ghb,\u001b[24Ghb2\u001b[28G=\u001b[30Gself.x,\u001b[38Gself.xb,\u001b[47Gself.xb2,\u001b[57Gself.hb,\u001b[66Gself.hb2\r\u001b[1B \u001b[2m\u2502\u001b[22m     q, qc, qg = self.q, self.qc, self.qg;\u001b[46Grot\u001b[50G=\u001b[52Gself.rope[pos];\u001b[68GT\u001b[70G=\u001b[72Gpos\u001b[76G+\u001b[78G1;\u001b[81GtA\u001b[84G=\u001b[86G0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mx[:]\u001b[13G=\u001b[15Gself.tok_emb[token]\r\u001b[1B \u001b[2m\u2502\u001b[22m     for l, (rms_att, wq, wk, wv, wo, rms_ffn, w1, w3, w2) in enumerate(self.layers):\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         ss = one / np.sqrt(vecdot(x, x) / fdim + eps); multiply(x, ss, out=xb); multiply(rms_att, xb, out=xb)\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         kc = self.key_cache[l]; vc = self.value_cache[l]; kslot = kc[:, pos, :]\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mvecdot(wq,\u001b[23Gxb,\u001b[27Gout=q);\u001b[35Gvecdot(wk,\u001b[46Gxb,\u001b[50Gout=kslot);\u001b[62Gvecdot(wv,\u001b[73Gxb,\u001b[77Gout=vc[:,\u001b[87Gpos,\u001b[92G:])\r\u001b[1B \u001b[2m\u2502\u001b[22m        \u001b[12Gmultiply(qc, ro\u001b[28G, ou\u001b[33G=qc); kcx = kslot.view(np.complex64); \u001b[72Gult\u001b[76Gply(kcx, rot, out=kcx)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G    t0 = pc(); at\u001b[26Gn(qg, kc, vc, T,"]
[151.49, " xb,\u001b[47Gsqrt_hs);\u001b[57GtA\u001b[60G+=\u001b[63Gpc()\u001b[68G-\u001b[70Gt0\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mvecdot(wo,\u001b[23Gxb,\u001b[27Gout=xb2);\u001b[37Gx\u001b[39G+=\u001b[42Gxb2\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         ss = one / np.sqrt(vecdot(x,\u001b[41Gx)\u001b[44G/\u001b[46Gfdim\u001b[51G+\u001b[53Geps);\u001b[59Gmultiply(x,\u001b[71Gss,\u001b[75Gout=xb);\u001b[84Gmultiply(rms_ffn,\u001b[102Gxb,\u001b[106Gout=xb)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mvecdot(w1,\u001b[23Gxb,\u001b[27Gout=hb);\u001b[36Gvecdot(w3,\u001b[47Gxb,\u001b[51Gout=hb2)\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G sig = exp(np.negative(hb)); sig += one; n\u001b[54G.divide(one, sig, out=sig); hb *= \u001b[89Gig; hb *= hb2\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[13Gecdot(w2, hb, out=xb); x += xb\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15GtA\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for p in range(1000):\u001b[26Gm.forward(5\u001b[38G+\u001b[40Gp\u001b[42G%\u001b[44G300,\u001b[49Gp)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gpos\u001b[12Gin\u001b[15G(80,\u001b[20G999):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G res = {}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for\u001b[12Gvar\u001b[16Gin ('cur', 'vecdot', 'einsum'):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22ma\u001b[14G=\u001b[16Gmake(var);\u001b[27Gbest\u001b[32G=\u001b[34G1e9\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for r in range(5"]
[151.491, "):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22ms\u001b[18G=\u001b[20Gsum(fwd(m,\u001b[31G5,\u001b[34Gpos,\u001b[39Ga)\u001b[42Gfor\u001b[46G_\u001b[48Gin\u001b[51Grange(20))\u001b[62G/\u001b[64G20;\u001b[68Gbest\u001b[73G=\u001b[75Gmin(best,\u001b[85Gs)\r\u001b[1B \u001b[2m\u2502\u001b[22m        \u001b[12Gres[var]\u001b[21G= best\u001b[28G* 1e3\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     # num\u001b[14Gri\u001b[17Gal agreem\u001b[27Gnt of the \u001b[38Gttention\u001b[47Goutput\u001b[54Gfor\u001b[58Gone\u001b[62Glayer\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint('pos',\u001b[21Gpos,\u001b[26G'\u001b[28G'.join('%s\u001b[39G%.3f\u001b[44Gms'\u001b[48G%\u001b[50Gkv\u001b[53Gfor\u001b[57Gkv\u001b[60Gin\u001b[63Gres.items()))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m qg = m.qg.copy(); kc\u001b[25G=\u001b[27Gm.key_cache[3];\u001b[43Gvc\u001b[46G=\u001b[48Gm.value_cache[3];\u001b[66Gouts\u001b[71G=\u001b[73G{}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gvar\u001b[12Gin\u001b[15G('cur',\u001b[23G'vecdot',\u001b[33G'einsum'):\r\u001b[1B \u001b[2m\u2502\u001b[22m     xb = np.empty(768, F32); make(var)(qg,\u001b[47Gkc, vc, 900, x\u001b[62G, m.sqrt_hs); outs[var] = xb\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print('m\u001b[13Gx diff vs cur:', {k: float(np.abs(v - outs['cur']).max()) for k, v in outs.items()})\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/attn_insitu.py\r\u001b[1B\u001b[38;2;175;17"]
[151.492, "5;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
