[244.457, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTh\u001b[6G current at\u001b[18Gen\u001b[21Gion layout is already the fastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[2C\u001b[1Boverhead\u001b[12Gand\u001b[16Gstartup\u001b[24Gprecisely\u001b[34Gusing\u001b[40Gmin-of-N:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOverhead is ab\u001b[18Gut\u001b[21G1.1 ms\u001b[28Gpe\u001b[31G token (10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan\r\u001b[2C\u001b[1Binstrumented\u001b[16Gcopy\u001b[21Gof\u001b[24Gthe\u001b[28Gforward\u001b[36Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gmatvecs\u001b[18Gtake nearly \u001b[31Gll of the 10.85 ms per t\u001b[56Gken, but\u001b[65Gattention is far slower in the real\u001b[101Gloop (48 \u00b5s\u001b[113Gper\r\u001b[2C\u001b[1Bl\u001b[5Gyer, ag\u001b[13Ginst 17 \u00b5s benchmarked\u001b[36Galone), pr\u001b[47Gbably\u001b[53Gfrom a\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-he"]
[244.458, "ad\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[2C\u001b[1Bbatched\u001b[11Gvariants\u001b[20Gdirectly\u001b[29Ginside\u001b[36Gthe\u001b[40Glive\u001b[45Gforward\u001b[53Gpass.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention runs at 3.2 ms/\u001b[29Goken at positi\u001b[44Gn 999, about\u001b[57G22 GB/s ov\u001b[68Gr\u001b[70Gthe\u001b[74G72 MB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[2C\u001b[1Bmicrobenchmark.\u001b[19GI'm\u001b[23Gsplitting\u001b[33Git\u001b[36Ginto\u001b[41Gscores,\u001b[49Gsoftmax\u001b[57Gand\u001b[61Gweighted\u001b[70Gsum\u001b[74Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe weighted sum\u001b[20G(att @ V) is the bottl\u001b[43Gneck at \u001b[52Gbout\u001b[57G17 GB/s, because V's (t, d) layout forces\u001b[99Ga poo\u001b[105Gly shaped\u001b[K\r\u001b[3C\u001b[1Bransposed\u001b[14Ggemv.\u001b[20GI'm\u001b[24Gstoring\u001b[32GV\u001b[34Gtransposed\u001b[45Gper\u001b[49Ghead\u001b[54Gas\u001b[57G(head,\u001b[64Gd,\u001b[67Gt)\u001b[70Gso\u001b[73Git\u001b[76Gbecomes\u001b[84Gcontiguous\u001b[95Grow\u001b[99Gdot\u001b[103Gproducts,\u001b[113Gthen\r\u001b[2C\u001b[1Btesting.\r\u001b[1B\u001b[K"]
[244.459, "\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell\u001b[15Gcommand \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed V cuts the weighted sum from 2.05 to 0.85 ms at T=1000. It costs about\u001b[85G+35\u001b[89G\u00b5s/token\u001b[98Gat\u001b[101GT=81,\u001b[107Ga\u001b[109G0.3%\u001b[114Gloss\u001b[119Gon\r\u001b[2C\u001b[1Bshort contexts against a\u001b[28G~10%\u001b[33Ggain\u001b[38Gat\u001b[41Glong\u001b[46Gones,\u001b[52Gso\u001b[55GI'll\u001b[60Gtake\u001b[65Git.\u001b[69GImplementing:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m4\u001b[29G6\u001b[39m\u001b[40;1H\u001b[38;3H"]
