[272.947, "\u001b[H\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mComparing\u001b[13Gper-token\u001b[23Gtime\u001b[28Gacross\u001b[35Gpositions,\u001b[46Gv2\u001b[49Gvs\u001b[52Gnew\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/long.py <<'EOF'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102m# Per-token forward time (min of repeats) at several positions, after filling the cache.\r\u001b[5C\u001b[1Bimport sys, time, importlib\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102msys.path.insert(0, sys.argv[1]); mod = importlib.import_module(sys.argv[2])\r\u001b[5C\u001b[1Bm = mod.Transformer('model.bin')\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mfor p in range(1000): m.forward(5 + p % 300,\u2026\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\r\u001b[1C\u001b[1B\u001b[39mTip: au"]
[272.948, "to mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mCompare per-token time across positions, v2 vs new\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat > prof/long.py\u001b[23G<<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6GPer-token\u001b[16Gforward\u001b[24Gtime\u001b[29G(min\u001b[34Gof\u001b[37Grepeats)\u001b[46Gat\u001b[49Gseveral\u001b[57Gpositions,\u001b[68Gafter\u001b[74Gfilling\u001b[82Gthe\u001b[86Gcache.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import sys, time, importlib\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msys.path.insert(0,\u001b[23Gsys.argv[1]);\u001b[37Gmod\u001b[41G=\u001b[43Gimportlib.import_module(sys.argv[2])\r\u001b[1B \u001b[2m\u2502\u001b[22m m = mod.Tran\u001b[17Gformer('model.bin')\u001b[37G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for \u001b[9"]
[272.949, "G in range(1000): m.forward(5 + p % 300,\u001b[49Gp)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m ou\u001b[7G = []\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gpos\u001b[12Gin\u001b[15G(80,\u001b[20G300,\u001b[25G600,\u001b[30G999):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     best = 1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gr\u001b[14Gin\u001b[17Grange(5):\r\u001b[1B \u001b[2m\u2502\u001b[22m         t\u001b[14G=\u001b[16Gtime.perf_coun\u001b[32Gr()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   for _\u001b[18Gin range(15): m.forw\u001b[39Grd(7, p\u001b[47Gs)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbest\u001b[17G=\u001b[19Gmin(best,\u001b[29G(time.perf_counter()\u001b[50G-\u001b[52Gt)\u001b[55G/\u001b[57G15)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     out.append('pos %d %.2f ms' % (pos, best\u001b[49G*\u001b[51G1e3))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mprint(sys.argv[2]\u001b[22G+\u001b[24G':\u001b[27G'\u001b[29G+\u001b[31G'\u001b[33G|\u001b[35G'.join(out))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gi\u001b[10Gin\u001b[13G1\u001b[15G2;\u001b[18Gdo\u001b[21Gpython3\u001b[29Gprof/long.py\u001b[42Gprof\u001b[47Grun_v2;\u001b[55Gpython3\u001b[63Gprof/long.py\u001b[76G.\u001b[78Grun;\u001b[83Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[272.95, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
