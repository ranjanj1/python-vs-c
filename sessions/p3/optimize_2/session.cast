[367.891, "\u001b[H\r\u001b[33B\u001b[38;2;215;119;87m\u2736\u001b[39m\u001b[40;1H\u001b[38;3H"]
[367.913, "\u001b[H\r\u001b[102C\u001b[35B\u001b[K\u001b[40;1H\u001b[38;3H"]
[367.95, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gruns\u001b[18Gat\u001b[21G3.2\u001b[25Gms/token\u001b[34Gat\u001b[37Gposition\u001b[46G999,\u001b[51Gabout\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[2C\u001b[1Bmicrobenchmark. I'm splitting\u001b[33Git\u001b[36Ginto\u001b[41Gscores,\u001b[49Gsoftmax\u001b[57Gand\u001b[61Gweighted\u001b[70Gsum\u001b[74Gnext.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe weighted\u001b[16Gsum\u001b[20G(att\u001b[25G@\u001b[27GV)\u001b[30Gis\u001b[33Gthe\u001b[37Gbottleneck\u001b[48Gat\u001b[51Gabout\u001b[57G17\u001b[60GGB/s,\u001b[66Gbecause\u001b[74GV's\u001b[78G(t,\u001b[82Gd)\u001b[85Glayout\u001b[92Gforces\u001b[99Ga\u001b[101Gpoorly\u001b[108Gshaped\r\u001b[2C\u001b[1Btransposed\u001b[14Ggemv.\u001b[20GI'm\u001b[24Gstoring\u001b[32GV\u001b[34Gtransposed\u001b[45Gper\u001b[49Ghead\u001b[54Gas\u001b[57G(head,\u001b[64Gd,\u001b[67Gt)\u001b[70Gso\u001b[73Git\u001b[76Gbecomes\u001b[84Gcontiguous\u001b[95Grow\u001b[99Gdot\u001b[103Gproducts,\u001b[113Gthen\r\u001b[2C\u001b[1Btesting.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r"]
[367.952, "\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gcuts\u001b[21Gthe\u001b[25Gweighted\u001b[34Gsum\u001b[38Gfrom\u001b[43G2.05\u001b[48Gto\u001b[51G0.85\u001b[56Gms\u001b[59Gat\u001b[62GT=1000.\u001b[70GIt\u001b[73Gcosts\u001b[79Gabout\u001b[85G+35\u001b[89G\u00b5s/token\u001b[98Gat\u001b[101GT=81,\u001b[107Ga\u001b[109G0.3%\u001b[114Gloss\u001b[119Gon\r\u001b[2C\u001b[1Bshort contexts against a ~10% gain at long ones,\u001b[52Gso\u001b[55GI'll\u001b[60Gtake\u001b[65Git.\u001b[69GImplementing:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \u001b[48G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses. Comparing long-context\u001b[34Gcost\u001b[39Gdirectly\u001b[48G(min-of-N\u001b[58Gper-token\u001b[68Gtime\u001b[73Gat\u001b[76Gpositions\u001b[86Gnear\u001b[91G1,000):\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gwins\u001b[21Gat\u001b[24G999\u001b[28Gbut\u001b[32Gloses\u001b[38Gat\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[1B \u001b[3Gco\u001b[6Gflicts; I'm\u001b[18Gtesting padded\u001b[33Gstrides\u001b[41Gnext.\u001b[K\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;"]
[367.952, "102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding didn't help, and vecdot's cost isn't monotonic in T, which suggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[2C\u001b[1Bscanning dot speed against row length\u001b[41Gnext,\u001b[47Gsince\u001b[53Gthe\u001b[57Gweight\u001b[64Gmatvecs\u001b[72Gmay\u001b[76Gbe\u001b[79Gaffected\u001b[88Gtoo.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[26C\u001b[2B\u001b[38;2;102;102;102m8\u001b[29G5\u001b[39m\u001b[40;1H\u001b[38;3H"]
[367.963, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 6s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
