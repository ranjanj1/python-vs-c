[652.288, "\u001b[H\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mMeasuring time to\u001b[21GREADY for\u001b[31Gv2 and new\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/ready.py <<'EOF'\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102m# Wall time from process start to READY (min/median of N fresh starts).\r\u001b[5C\u001b[1Bimport subprocess, sys, time, statistics\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mprog = sys.argv[1:]; ts = []\r\u001b[5C\u001b[1Bfor _ in range(7):\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mt = time.perf_counter()\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mp = subprocess.Popen(prog + ['model.bin', 'tokenizer.bin'], stdin=subprocess.PIPE, s\u2026\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b["]
[652.289, "K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mMeasure time to READY for v2 and new\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat > prof/ready.py\u001b[24G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6GWall\u001b[11Gtime\u001b[16Gfrom\u001b[21Gprocess\u001b[29Gstart\u001b[35Gto\u001b[38GREADY\u001b[44G(min/median\u001b[56Gof\u001b[59GN\u001b[61Gfresh\u001b[67Gstarts).\r\u001b[1B \u001b[2m\u2502\u001b[22m import subprocess, sys, \u001b[29Gime, statistics\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m prog = sys.argv[1:];\u001b[25Gts = []\u001b[33G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8G_\u001b[10Gin\u001b[13Grange(7):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     t = time.perf_counter()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp\u001b[10G=\u001b[12G"]
[652.29, "subprocess.Popen(prog\u001b[34G+\u001b[36G['model.bin',\u001b[50G'tokenizer.bin'],\u001b[68Gstdin=subprocess.PIPE,\u001b[91Gstdout=subprocess.PIPE,\r\u001b[1B \u001b[2m\u2502\u001b[22m t\u001b[6Gxt=True)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8Gassert p.stdout.readline().strip()\u001b[43G==\u001b[46G'READY';\u001b[55Gts.append(time.perf_counter()\u001b[85G-\u001b[87Gt)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mp.stdin.write('QUIT\\n');\u001b[33Gp.stdin.flush();\u001b[50Gp.wait()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print('%s: READY min\u001b[25G%.3fs\u001b[31Gmedian\u001b[38G%.3fs'\u001b[45G%\u001b[47G(prog[-1],\u001b[58Gmin(ts),\u001b[67Gstatistics.median(ts)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m python3 prof/ready.py pyth\u001b[31Gn3\u001b[34Gprof/run_v2.py; python3 prof/ready.py python3 run.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[652.291, "\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mThis\u001b[7Gcommand\u001b[15Grequires\u001b[24Gapproval\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1BDo\u001b[5Gyou\u001b[9Gwant\u001b[14Gto\u001b[17Gproceed?\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and don't ask again for \u001b[1mcat, python3 prof/ready.py python3 prof/run_v2.py\u001b[22m, and \u001b[1mpython3 prof/ready.py python3 \r\u001b[6C\u001b[1Brun.py\u001b[14G\u001b[22mcommands\u001b[23Gin\u001b[26G\u001b[1m/Users/agentlab/pvc/p3\u001b[103G\u001b[22m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[34;2H"]
[652.469, "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
