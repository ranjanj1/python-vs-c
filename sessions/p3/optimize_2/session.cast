[642.705, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Strided views drop to 34 GB/s, so\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[2C\u001b[1Bswitching to a read-only memmap that copies straight into the blocked layout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[2C\u001b[1Babout 2 ms per token.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses with the same error level. Benchmarking against v2, alternating\u001b[74Gruns:\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[39m Per-token time drops about 20%: \u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m. But load went from ~0.12\u20130.22 s\u001b[K\r\u001b[1C\u001b[1B to ~0.37\u20130.87\u001b[17Gs.\u001b[20GI'll\u001b[25Gprofile\u001b[33Gthe\u001b[37Gloader\u001b[44Gto\u001b[47Gwin\u001b[51Gthat\u001b[56Gbac"]
[642.706, "k:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan\u001b[7G\u001b[1m1\u001b[22m s\u001b[11Ge\u001b[13Gl command \u001b[39m\u001b[K\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The first ca\u001b[16Gl includes first-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[1C\u001b[1B each strategy in its\u001b[24Gown\u001b[28Gp\u001b[30Gocess:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Time each load strategy in\u001b[30Gfresh\u001b[36Gprocesses\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/load1.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m# One load strategy per fresh process: python3 prof/load1.py A|B|fromfile\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport sys, time\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G \u001b[6G\u001b[38;2;102;102;102mt0 = time.perf_counter()\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G \u001b[6G\u001b[38;2;102;102;102msys.argv = [sys.argv[0]] + sys.argv[1:]\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mimport numpy as np\u001b[25G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mexec(open('prof/load.py').read().split(\"for name, fn in\")[0])\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b"]
