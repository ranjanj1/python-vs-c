[851.727, "2G\u001b[22mt\u001b[14G=\u001b[16Gpc()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for _ in range(n):\u001b[31Gf()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbest\u001b[17G=\u001b[19Gmin(best,\u001b[29G(pc()\u001b[35G-\u001b[37Gt)\u001b[40G/\u001b[42Gn)\r\u001b[1B \u001b[2m\u2502\u001b[22m     return best * 1e3\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m sep = [[rng.standard_normal((nb, d, b), d\u001b[46Gype=F) for d in (D, D, D, H\u001b[74G, Hd)]\u001b[81Gfor _\u001b[87Gin\u001b[90Grange(L)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfus\u001b[8G=\u001b[10G[[np.concatenate(s[:3],\u001b[34Gaxis=1),\u001b[43Gnp.concatenate(s[3:],\u001b[65Gaxis=1)]\u001b[74Gfor\u001b[78Gs\u001b[80Gin\u001b[83Gsep]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m xs = rng.standard_normal((nb,\u001b[34Gb,\u001b[37G1),\u001b[41Gdtype=F)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpD\u001b[7G=\u001b[9Gnp.empty((nb,\u001b[23GD,\u001b[26G1),\u001b[30GF);\u001b[34GpH\u001b[37G=\u001b[39Gnp.empty((nb,\u001b[53GHd,\u001b[57G1),\u001b[61GF);\u001b[65Go\u001b[67G=\u001b[69Gnp.empty(D,\u001b[81GF);\u001b[85Goh\u001b[88G=\u001b[90Gnp.empty(Hd,\u001b[103GF)\r\u001b[1B \u001b[2m\u2502\u001b[22m p3 = np.empty((nb, 3 *\u001b[27GD, 1),\u001b[34GF); p2 = np.empty((nb, 2 * Hd, 1), F);\u001b[73Go3 =\u001b[78Gnp.empty(3 *\u001b[91GD,\u001b[94GF); o2 = np.empty(2 * Hd,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m F)\u001b[7G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8Gs():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for w"]
[851.727, "q, wk, wv,\u001b[24Gw1,\u001b[28Gw3\u001b[31Gin\u001b[34Gsep:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gw\u001b[18Gin\u001b[21G(wq,\u001b[26Gwk,\u001b[30Gwv):\u001b[35Gnp.matmul(w,\u001b[48Gxs,\u001b[52Gout=pD);\u001b[61Gnp.add.reduce(pD[:,\u001b[81G:,\u001b[84G0],\u001b[88Gaxis=0,\u001b[96Gout=o)\r\u001b[1B \u001b[2m\u2502\u001b[22m    \u001b[8G    for w in (w1, w3): np.matmul(w, xs, out=pH);\u001b[57Gnp.add.reduce(pH[:,\u001b[77G:, 0], axis=0,\u001b[92Gout=oh)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def f():\u001b[13G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for wqkv, w13 in fus:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mnp.matmul(wqkv,\u001b[28Gxs,\u001b[32Gout=p3);\u001b[41Gnp.add.reduce(p3[:,\u001b[61G:,\u001b[64G0],\u001b[68Gaxis=0,\u001b[76Gout=o3)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         np.matmul(w13,\u001b[27Gxs,\u001b[31Gout=p2);\u001b[40Gnp.add.reduce(p2[:,\u001b[60G:,\u001b[63G0],\u001b[67Gaxis=0,\u001b[75Gout=o2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8G_\u001b[10Gin\u001b[13Grange(2):\u001b[23Gprint('separate\u001b[39G%.3f\u001b[44Gms\u001b[49Gfused\u001b[55G%.3f\u001b[60Gms'\u001b[64G%\u001b[66G(bench(s),\u001b[77Gbench(f)))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m py\u001b[7Gho\u001b[10G3 prof/fuse2.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[851.728, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 prof/fuse2.py\u001b[66G\u001b[22mcommands\u001b[75Gin\u001b[78G\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
