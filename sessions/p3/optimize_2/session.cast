[495.174, "\u001b[H\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gwins\u001b[21Gat\u001b[24G999\u001b[28Gbut\u001b[32Gloses\u001b[38Gat\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[2C\u001b[1Bconflicts;\u001b[14GI'm\u001b[18Gtesting\u001b[26Gpadded\u001b[33Gstrides\u001b[41Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding didn't h\u001b[20Glp, \u001b[25Gnd vecdot's cost isn't monotonic in T,\u001b[64Gwhich \u001b[71Guggests\u001b[79Gdot sp\u001b[86Ged depends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[2C\u001b[1Bscanning\u001b[12Gdot\u001b[16Gspeed\u001b[22Gagainst\u001b[30Grow\u001b[34Glength\u001b[41Gnext,\u001b[47Gsince\u001b[53Gthe\u001b[57Gweight\u001b[64Gmatvecs\u001b[72Gmay\u001b[76Gbe\u001b[79Gaffected\u001b[88Gtoo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's ge\u001b[19Gv\u001b[21Ghits 58\u201360 GB/s\u001b[37Gon short\u001b[46Grows versus 27\u201339\u001b[64Gon longer ones, so\u001b[83GI'm testing a\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[2C\u001b[1Bcontiguous\u001b[14Gcolumn\u001b[21Gblocks\u001b[2"]
[495.174, "8Gwith\u001b[33Gone\u001b[37Ggemv\u001b[42Gper\u001b[46Gblock\u001b[52Gand\u001b[56Gpartial\u001b[64Gsums\u001b[69Gadded,\u001b[76Gat\u001b[79Gthe\u001b[83Greal\u001b[88Gshapes.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mT\u001b[6G batched block gemv runs about 25% faster than vecdot, at 53\u201358 GB/s against 43\u201347, with the \u001b[101Gme err\u001b[108Gr. I'm\u001b[K\r\u001b[3C\u001b[1Bhecking\u001b[12Gwhether\u001b[20Ga\u001b[22Gstrided\u001b[30Gview\u001b[35Gwithout\u001b[43Gcopying\u001b[51Gperforms\u001b[60Gas\u001b[63Gwell\u001b[68Gand\u001b[72Gwhat\u001b[77Gthe\u001b[81Gload-time\u001b[91Greorganisation\u001b[106Gcosts\u001b[112Gbefore\u001b[119GI\r\u001b[2C\u001b[1Bcommit.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided views d\u001b[19Gop t\u001b[24G 34\u001b[28GGB/s, so blo\u001b[41Gks must be cont\u001b[57Ggu\u001b[60Gus, and reorganising\u001b[81Gth\u001b[84G checkpoin\u001b[95G c\u001b[98Gsts \u001b[103Gbout 0.3 s. I'm\r\u001b[2C\u001b[1Bswitching to a\u001b[18Gread-only\u001b[28Gmemmap\u001b[35Gthat\u001b[40Gcopies\u001b[47Gstraight\u001b[56Ginto\u001b[61Gthe\u001b[65Gblocked\u001b[73Glayout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110"]
