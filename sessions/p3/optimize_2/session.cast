[151.954, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Timings\u001b[11Gare\u001b[15Gnoisy, so I'm measuring components in-process with min-of-N. A\u001b[78Gtention cost rise\u001b[96G wi\u001b[100Gh\u001b[102Gcontex\u001b[109G (12.7\r\u001b[1C\u001b[1B ms/token\u001b[12Gvs\u001b[15G~11.1 at ~80), so I'm \u001b[38Ghecking attention layouts next.\u001b[70G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gcurrent at\u001b[18Gention layout is already the\u001b[47Gfastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[1C\u001b[1B overhead\u001b[12Gand startup \u001b[25Grecisely using min-of-N:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Overhead is\u001b[15Gabout\u001b[21G1.1\u001b[25Gms\u001b[28Gper\u001b[32Gtoken\u001b[38G(10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan"]
[151.955, "\r\u001b[1C\u001b[1B instrume\u001b[12Gted copy of the \u001b[35G pass:\u001b[42G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Weight\u001b[10Gmatvecs take nearly all\u001b[34Gof the\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[1C\u001b[1B layer,\u001b[10Gagainst\u001b[18G17\u001b[21G\u00b5s b\u001b[26Gnchmarked\u001b[36Galone),\u001b[44Gprobably\u001b[53Gfrom\u001b[58Ga\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-head\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[1C\u001b[1B batched\u001b[11Gvariants\u001b[20Gdirectly inside the live forward pass.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Compari\u001b[11Gg attention variants inside r\u001b[41Gal forward loop\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/attn_insitu.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m# Time attention variants inside the real forward loop (cold KV cache after weight streaming).\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport sys, time\u001b[23G\u001b[39m\u001b[K\r\u001b[1C\u001b"]
