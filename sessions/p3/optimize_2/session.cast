[676.536, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses\u001b[10Gwith\u001b[15Gthe\u001b[19Gsame\u001b[24Gerror\u001b[30Glevel.\u001b[37GBenchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token\u001b[13Gtime\u001b[18Gdrops\u001b[24Gabout\u001b[30G20%:\u001b[35G\u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[1B \u001b[3Gto ~0.37\u20130.87 s. I'll profile the loader to win that back:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfirst\u001b[13Gcall\u001b[18Gincludes\u001b[27Gfirst-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[1B \u001b[3Geach strategy in its own p\u001b[30Gocess:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gblocked\u001b[15Gload\u001b[20Gis\u001b[23Gonl"]
[676.536, "y\u001b[28Gabout\u001b[34G0.10\u001b[39Gs\u001b[41Gwith\u001b[46Gmemmap\u001b[53Gand\u001b[57G0.075\u001b[63Gs\u001b[65Gwith\u001b[70Gchunked\u001b[78Greadinto,\u001b[88Gagainst\u001b[96G0.055\u001b[102Gs\u001b[104Gfor\u001b[108Gplain\r\u001b[1B \u001b[3Gfromfile, so that overhead doesn't explain\u001b[46Gthe 0.37\u20130.87 s seen earlier. I'm measuring t\u001b[92Gme-to-READY\u001b[104Gdi\u001b[107Gectly next.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gblocked\u001b[15Gloader\u001b[22Gadds\u001b[27G~37\u001b[31Gms\u001b[34Gto\u001b[37Gstartup\u001b[45G(0.113\u001b[52G\u2192\u001b[54G0.150\u001b[60Gs).\u001b[64GSince\u001b[70Gchunked\u001b[78G\u001b[38;2;87;105;247mreadinto\u001b[87G\u001b[39mwas\u001b[91Gfaster\u001b[98Gthan\u001b[103Gmemmap\u001b[110Gin\u001b[113Gfresh\r\u001b[1B \u001b[3Gprocesses, I'll switch the loader\u001b[37Gto i\u001b[42G:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mSwitching\u001b[13Gto\u001b[16Gchunked\u001b[24Greadinto\u001b[33Gloader,\u001b[41Gchecking,\u001b[51Gtime\u001b[56Gstartup\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ python3 - <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102ms\u001b[8G= ope\u001b[14G('run.py').read()\r\u001b[5C\u001b[1Ba\u001b[10Gs.i\u001b[14Gdex(\" # Read the checkpoint through a rea"]
