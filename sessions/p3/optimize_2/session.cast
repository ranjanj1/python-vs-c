[977.62, "\u001b[H\u001b[6G\u001b[38;2;102;102;102mimport sys, time\r\u001b[5C\u001b[1Bsys.path.insert(0, '.')\r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mimport run\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mb = int(sys.argv[1]); run.block_size = lambda n: b if n % b == 0 else n\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102mm = run.Transformer('model.bin')\r\u001b[2C\u001b[1B\u001b[39m   \u001b[38;2;102;102;102mfor p in\u001b[15Grange\u2026\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mCompare co\u001b[13Gumn block\u001b[23Gsizes in situ\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[977.621, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m ca\u001b[8G> prof/blocksize.py\u001b[28G<<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m # In-situ forward\u001b[22Gtime at\u001b[30Gp\u001b[32Gsition 80 / 600 for different colum\u001b[68G-block\u001b[75Gsizes (monkeypatched).\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import sys, tim\u001b[20G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22msys.path.insert(0,\u001b[23G'.')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m import run\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mb\u001b[6G=\u001b[8Gint(sys.argv[1]);\u001b[26Grun.block_size\u001b[41G=\u001b[43Glambda\u001b[50Gn:\u001b[53Gb\u001b[55Gif\u001b[58Gn\u001b[60G%\u001b[62Gb\u001b[64G==\u001b[67G0\u001b[69Gelse\u001b[74Gn\r\u001b[1B \u001b[2m\u2502\u001b[22m m = run.Transf\u001b[19Grmer('model.b\u001b[33Gn')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for p in rang\u001b[18G(600): m.forward(5 + p % 300, p)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mres\u001b[8G=\u001b[10G[]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for pos in (80, 599):"]
[977.622, "\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mbest\u001b[13G=\u001b[15G1e9\r\u001b[1B \u001b[2m\u2502\u001b[22m     for r in range(5):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[12Gt\u001b[14G=\u001b[16Gtime.perf_counter()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16G_\u001b[18Gin\u001b[21Grange(15):\u001b[32Gm.forward(7,\u001b[45Gpos)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         best = min(best, (time.perf_counter()\u001b[50G-\u001b[52Gt)\u001b[55G/\u001b[57G15)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mres.append('pos\u001b[24G%d\u001b[27G%.2f\u001b[32Gms'\u001b[36G%\u001b[38G(pos,\u001b[44Gbest\u001b[49G*\u001b[51G1e3))\r\u001b[1B \u001b[2m\u2502\u001b[22m pr\u001b[7Gnt('block %d: ' % b + ' | '.join(res))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gi\u001b[10Gin\u001b[13G1\u001b[15G2;\u001b[18Gdo\u001b[21Gfor\u001b[25Gb\u001b[27Gin\u001b[30G128\u001b[34G256\u001b[38G384;\u001b[43Gdo\u001b[46Gpython3\u001b[54Gprof/blocksize.py\u001b[72G$b;\u001b[76Gdone;\u001b[82Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[977.622, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
