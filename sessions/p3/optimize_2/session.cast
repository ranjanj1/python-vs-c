[452.343, "\u001b[H\r\u001b[2C\u001b[1BPasses. Compar\u001b[19Gg\u001b[21Glong-context co\u001b[37Gt directly (mi\u001b[52G-of-N per-\u001b[63Goken\u001b[68Gtime\u001b[73Gat positions\u001b[86Gnear 1,000):\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV\u001b[16Gwins\u001b[21Gat\u001b[24G999\u001b[28Gbut\u001b[32Gloses\u001b[38Gat\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[1B \u001b[3Gconflicts; I\u001b[16Gm\u001b[18Gt\u001b[20Gsting padde\u001b[32G stride\u001b[40G next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding\u001b[11Gdidn't\u001b[18Ghelp,\u001b[24Gand\u001b[28Gvecdot's\u001b[37Gcost\u001b[42Gisn't\u001b[48Gmonotonic\u001b[58Gin\u001b[61GT,\u001b[64Gwhich\u001b[70Gsuggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[1B \u001b[3Gs\u001b[5Ganning dot\u001b[16Gspeed against row length nex\u001b[45G, since the weight\u001b[64Gmatvecs may be affected too.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1"]
