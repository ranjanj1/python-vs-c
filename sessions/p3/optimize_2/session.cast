[490.597, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m#\r\u001b[1B \u001b[2m\u2502\u001b[22m # run\u001b[10Gc's m\u001b[16Gtmul(x\u001b[23Gut, x, W, n, d)\u001b[39Gcompu\u001b[45Ges\u001b[48Gxout[i] =\u001b[58Gsum_j W[i, j] * x[j] for a row-major (d,\u001b[99Gn)\u001b[102GW.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6GAccelerate's\u001b[19Gsgemv\u001b[25Gstreams\u001b[33Gmemory\u001b[40Gfastest\u001b[48Gwhen\u001b[53Grows\u001b[58Gare\u001b[62Gshort\u001b[68G(measured\u001b[78G53-58\u001b[84GGB/s\u001b[89Gfor\u001b[93G128-256\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m # floats vs ~45 GB/s\u001b[25Gfor\u001b[29Grow-wise\u001b[38Gdots\u001b[43Gover\u001b[48G768-2048\u001b[57Gfloats),\u001b[66Gso\u001b[69Geach\u001b[74GW\u001b[76Gis\u001b[79Gstored\u001b[86Gas\u001b[89Gn/b\u001b[93Gcontiguous\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6Gcolumn\u001b[13Gblocks\u001b[20GW_k\u001b[24G=\u001b[26GW[:,\u001b[31Gk*b:(k+1)*b]\u001b[44Gof\u001b[47Gshape\u001b[53G(d,\u001b[57Gb).\u001b[61GThe\u001b[65Gproduct\u001b[73Gis\u001b[76Gthen\u001b[81Gone\u001b[85Gbatched\u001b[93Gfloat32\r\u001b[1B \u001b[2m\u2502\u001b[22m # gemv per matrix (np.matmul \u001b[34Gv\u001b[36Gr\u001b[38Gthe blocks)\u001b[54Ga\u001b[56Gfloat32\u001b[64Gsum\u001b[68Gof the n/b par\u001b[83Gial results:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m # the same mul\u001b[19Giply-adds over \u001b[35Ghe same float32\u001b[51Gweights,\u001b[60Ggrouped\u001b[68Gin\u001b[71Gblocks\u001b[78Gof\u001b[81Gb.\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b"]
[490.598, "[22m def block_size(n):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gb\u001b[14Gin\u001b[17G(256,\u001b[23G128,\u001b[28G192,\u001b[33G384,\u001b[38G96,\u001b[42G64,\u001b[46G32):\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G \u001b[13Gf n % b ==\u001b[24G0 and n > b:\u001b[37G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12G   \u001b[16Greturn b\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15Gn\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1B\u001b[22m \u001b[2m\u2502\u001b[22m def blocked(w, b):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \"\"\"(..., d, n) weights -> contiguous (..., n/b,\u001b[56Gd, b) col\u001b[67Gn\u001b[69Gblocks\u001b[76G(one copy).\"\"\"\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22m*lead,\u001b[15Gd,\u001b[18Gn\u001b[20G=\u001b[22Gw.shape\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     nb = n // b\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mv\u001b[10G=\u001b[12Gw.reshape(*lead,\u001b[29Gd,\u001b[32Gnb,\u001b[36Gb)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G return\u001b[15Gnp.ascontiguou\u001b[30Garray(np.moveaxis(v, -2, -3))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6G----------------------------------------------------------------------------\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m # Transformer model\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m''')\r\u001b[1B \u001b[2m\u2502\u001b[22m open('run.py', "]
