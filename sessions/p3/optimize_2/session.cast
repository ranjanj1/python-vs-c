[399.592, "\u001b[H\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed V cuts the weighted sum\u001b[38Gfrom 2.05 to 0.85 ms a\u001b[61G T=1000. It costs about\u001b[85G+35\u001b[89G\u00b5s/token\u001b[98Gat\u001b[101GT=81,\u001b[107Ga\u001b[109G0.3%\u001b[114Gloss\u001b[119Gon\r\u001b[2C\u001b[1Bshort\u001b[9Gcontexts\u001b[18Gagainst\u001b[26Ga\u001b[28G~10%\u001b[33Ggain\u001b[38Gat\u001b[41Glong\u001b[46Gones,\u001b[52Gso\u001b[55GI'll\u001b[60Gtake\u001b[65Git.\u001b[69GImplementing:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses.\u001b[11GComparing\u001b[21Glong-context\u001b[34Gcost\u001b[39Gdirectly\u001b[48G(min-of-N\u001b[58Gper-token\u001b[68Gtime\u001b[73Gat\u001b[76Gpositions\u001b[86Gnear\u001b[91G1,000):\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTransposed\u001b[14GV wins at 999 but loses at\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[2C\u001b[1Bconflicts;\u001b[14GI'm\u001b[18Gtesting\u001b[26Gpadded\u001b[33Gstrides\u001b[41Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1"]
[399.593, "m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding didn't h\u001b[20Glp, \u001b[25Gnd vecdot's cost isn't monotonic in T,\u001b[64Gwhich \u001b[71Guggests\u001b[79Gdot sp\u001b[86Ged depends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[2C\u001b[1Bscanning\u001b[12Gdot\u001b[16Gspeed\u001b[22Gagainst\u001b[30Grow\u001b[34Glength\u001b[41Gnext,\u001b[47Gsince\u001b[53Gthe\u001b[57Gweight\u001b[64Gmatvecs\u001b[72Gmay\u001b[76Gbe\u001b[79Gaffected\u001b[88Gtoo.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's ge\u001b[19Gv\u001b[21Ghits 58\u201360 GB/s\u001b[37Gon short\u001b[46Grows versus 27\u201339\u001b[64Gon longer ones, so\u001b[83GI'm testing a\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[2C\u001b[1Bcontiguous\u001b[14Gcolumn\u001b[21Gblocks\u001b[28Gwith\u001b[33Gone\u001b[37Ggemv\u001b[42Gper\u001b[46Gblock\u001b[52Gand\u001b[56Gpartial\u001b[64Gsums\u001b[69Gadded,\u001b[76Gat\u001b[79Gthe\u001b[83Greal\u001b[88Gshapes.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Benchmarking column-blocked gemv at\u001b[39Gmodel\u001b[45Gshapes\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $\u001b[8Gcat > prof/block\u001b[25Gd.py <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m# C\u001b[10Glumn-blocked weights: W (d,n) stored "]
