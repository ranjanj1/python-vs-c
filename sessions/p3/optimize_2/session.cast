[186.361, "\u001b[H\u001b[2G\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The c\u001b[9Grren\u001b[14G attention layout\u001b[32Gis already the f\u001b[49Gstest (~52 GB/s\u001b[65Gat 1,024 positions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[1C\u001b[1B overhead a\u001b[14Gd startup precisely using min-of-N:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Overhead is about 1.1 ms pe\u001b[31G token\u001b[38G(10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan\r\u001b[1C\u001b[1B instrume\u001b[12Gted copy of the\u001b[28Gforward\u001b[36Gpass:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Weight\u001b[10Gmatvecs\u001b[18Gtake \u001b[24Gearly all\u001b[34Gof\u001b[37Gthe\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[1C\u001b[1B layer,\u001b["]
[186.362, "10Gagains\u001b[17G 17 \u00b5s\u001b[24Gbenchmarked\u001b[36Galone),\u001b[44Gprobably\u001b[53Gfrom\u001b[58Ga\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-head\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[1C\u001b[1B batched\u001b[11Gvariants\u001b[20Gdirectly inside\u001b[36Gthe\u001b[40Glive\u001b[45Gforward\u001b[53Gpass.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Attention runs at 3.2 ms/token\u001b[34Gat\u001b[37Gposition\u001b[46G999,\u001b[51Gabout\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[1C\u001b[1B microbenchmark. I'm splitting\u001b[33Git into scores, softmax and weighted sum next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Splitting cold-cache\u001b[24Gattention\u001b[34Gcost\u001b[39Gby\u001b[42Gstage\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/attn_split.py <<'EOF'\u001b[41G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102m# Split in-situ attention cost (cold KV cache) into scores / softmax / weighted-sum, and try alternatives.\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimpo"]
