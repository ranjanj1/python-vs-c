[869.106, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22m('''(see\u001b[13Gblocked_matvec\u001b[28Gnotes\u001b[34Gabove)''',\u001b[45G'''(see\u001b[53Gblock_size()\u001b[66Gnotes\u001b[72Gabove).\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     # Matrices applied\u001b[31Gto\u001b[35Ghe s\u001b[40Gme input are stacked along the o\u001b[73Gtput\u001b[78Grows, so\u001b[87Gthey run as one\u001b[103G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         #\u001b[14Gblocked matvec:\u001b[30G[wq; wk; wv] (dim\u001b[48G+\u001b[50G2*kv_dim\u001b[59Grows)\u001b[65Gand\u001b[69G[w1;\u001b[74Gw3]\u001b[78G(2*hidden_dim\u001b[92Grows).'''),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m('''\u001b[20Gwq\u001b[23G=\u001b[25Grd.blocked(L,\u001b[39Gn_heads\u001b[47G*\u001b[49Ghs,\u001b[53Gdim,\u001b[58Gbd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             wk = rd.blocked(L,\u001b[35Gkv_dim,\u001b[43Gdim,\u001b[48Gbd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mwv\u001b[19G=\u001b[21Grd.blocked(L,\u001b[35Gkv_dim,\u001b[43Gdim,\u001b[48Gbd)\r\u001b[1B \u001b[2m\u2502\u001b[22m ''', ''' \u001b[14G   \u001b[18G      qd = n_head\u001b[37G* hs\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m       \u001b[11G \u001b[13G   wqkv\u001b[21G= np.empty((L, dim // bd, qd + 2 *\u001b[56Gk\u001b[58G_dim, bd), F32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mrd.blocked(L,\u001b[30Gqd,\u001b[34Gdim,\u001b[39Gbd,\u001b[43Gout=wqkv[:,\u001b[55G:,\u001b[58G:qd])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             rd.bl"]
