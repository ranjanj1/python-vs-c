[498.562, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's\u001b[16Ggemv\u001b[21Ghits\u001b[26G58\u201360\u001b[32GGB/s\u001b[37Gon\u001b[40Gshort\u001b[46Grows\u001b[51Gversus\u001b[58G27\u201339\u001b[64Gon\u001b[67Glonger\u001b[74Gones,\u001b[80Gso\u001b[83GI'm\u001b[87Gtesting\u001b[95Ga\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[1B \u001b[3Gcontiguous\u001b[14Gcolumn\u001b[21Gblocks\u001b[28Gwi\u001b[31Gh \u001b[34Gn\u001b[36G gemv per block and\u001b[56Gpartial\u001b[64Gsums added, at the real shapes.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gbatched\u001b[15Gblock\u001b[21Ggemv\u001b[26Gruns\u001b[31Gabout\u001b[37G25%\u001b[41Gfaster\u001b[48Gthan\u001b[53Gvecdot,\u001b[61Gat\u001b[64G53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[1B \u001b[3Gchecking whether a stri\u001b[27Ged view without copying performs as well and what the load-time r\u001b[93Gorganisation costs\u001b[112Gbefore\u001b[119GI\r\u001b[2C\u001b[1Bcommit.\u001b[K\r\u001b[2C\u001b[4BStrid\u001b[9Gd views drop to 34 GB/s, so\u001b[37Gblocks must be contiguous,\u001b[64Ga\u001b[66Gd reorganising the checkpoint costs about 0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[2C\u001b[1Bswi\u001b[7Gching to a read-\u001b[24Gnly"]
[498.563, "\u001b[28Gmemmap that co\u001b[43Gies straight\u001b[56Ginto the blocke\u001b[72G layout, keeping load to\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[2C\u001b[1Babout\u001b[9G2\u001b[11Gms\u001b[14Gper\u001b[18Gtoken.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses wit\u001b[14G \u001b[18G s\u001b[21Gme error\u001b[30Glevel. Benchmarking against v2, altern\u001b[69Gting runs:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mBenchmarking\u001b[16Gblocked\u001b[24Gversion\u001b[32Gagainst\u001b[40Gv2\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2; do python3 prof/long.py prof run_v2; python3 prof/long.py . run; done; for i in 1 2; do echo \"v2: \r\u001b[5C\u001b[1B$(python3 prof/bench.py prof run_v2 | tr '\\n' ' ')\"; echo \"new: $(python3 prof/bench.py . run | tr '\\n' ' ')\"; done\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[498.564, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mBenchmark blocked\u001b[20Gversion\u001b[28Gagainst\u001b[36Gv2\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m \u001b[2m\u2502\u001b[22m for i\u001b[10Gin 1\u001b[15G2; do python3 prof/\u001b[35Gong.py prof run_v2; python3 prof/long.py . run;\u001b[83Gdone;\u001b[89Gfor\u001b[93Gi\u001b[95Gin\u001b[98G1\u001b[100G2;\u001b[103Gdo\u001b[106Gecho\u001b[111G\"v2:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m$(python3\u001b[14Gprof/bench.py\u001b[28Gprof\u001b[33Grun_v2\u001b[40G|\u001b[42Gtr\u001b[45G'\\n'\u001b["]
[498.565, "50G'\u001b[52G')\";\u001b[57Gecho\u001b[62G\"new:\u001b[68G$(python3\u001b[78Gprof/bench.py\u001b[92G.\u001b[94Grun\u001b[98G|\u001b[100Gtr\u001b[103G'\\n'\u001b[108G'\u001b[110G')\";\u001b[115Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mA\u001b[4Gfor\u001b[8Gor\u001b[11Gselect\u001b[18Gloop\u001b[23Gin\u001b[26Gthis\u001b[31Gcommand\u001b[39Gcan't\u001b[45Gbe\u001b[48Gchecked\u001b[56Gbefore\u001b[63Git\u001b[66Gruns\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[103G\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b"]
