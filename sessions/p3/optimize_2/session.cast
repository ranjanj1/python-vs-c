[501.889, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPadding didn't help,\u001b[24Gand\u001b[28Gvecdot's\u001b[37Gcost\u001b[42Gisn't\u001b[48Gmonotonic\u001b[58Gin\u001b[61GT,\u001b[64Gwhich\u001b[70Gsuggests\u001b[79Gdot\u001b[83Gspeed\u001b[89Gdepends\u001b[97Gon\u001b[100Grow\u001b[104Glength.\u001b[112GI'm\r\u001b[2C\u001b[1Bscanning\u001b[12Gdot\u001b[16Gspeed\u001b[22Gagainst\u001b[30Grow\u001b[34Glength\u001b[41Gnext,\u001b[47Gsince\u001b[53Gthe\u001b[57Gweight\u001b[64Gmatvecs\u001b[72Gmay\u001b[76Gbe\u001b[79Gaffected\u001b[88Gtoo.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAccelerate's gemv hits\u001b[26G58\u201360\u001b[32GGB/s\u001b[37Gon\u001b[40Gshort\u001b[46Grows\u001b[51Gversus\u001b[58G27\u201339\u001b[64Gon\u001b[67Glonger\u001b[74Gones,\u001b[80Gso\u001b[83GI'm\u001b[87Gtesting\u001b[95Ga\u001b[97Gblocked\u001b[105Glayout\u001b[112Gof\r\u001b[2C\u001b[1Bcontiguous\u001b[14Gcolumn\u001b[21Gblocks\u001b[28Gwith\u001b[33Gone\u001b[37Ggemv\u001b[42Gper\u001b[46Gblock\u001b[52Gand\u001b[56Gpartial\u001b[64Gsums\u001b[69Gadded,\u001b[76Gat\u001b[79Gthe\u001b[83Greal\u001b[88Gshapes.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe batched block gemv\u001b[26Gruns\u001b[31Gab"]
[501.89, "out\u001b[37G25%\u001b[41Gfaster\u001b[48Gthan\u001b[53Gvecdot,\u001b[61Gat\u001b[64G53\u201358\u001b[70GGB/s\u001b[75Gagainst\u001b[83G43\u201347,\u001b[90Gwith\u001b[95Gthe\u001b[99Gsame\u001b[104Gerror.\u001b[111GI'm\r\u001b[2C\u001b[1Bchecking\u001b[12Gwhether\u001b[20Ga\u001b[22Gstrided\u001b[30Gview\u001b[35Gwithout\u001b[43Gcopying\u001b[51Gperforms\u001b[60Gas\u001b[63Gwell\u001b[68Gand\u001b[72Gwhat\u001b[77Gthe\u001b[81Gload-time\u001b[91Greorganisation\u001b[106Gcosts\u001b[112Gbefore\u001b[119GI\r\u001b[1B \u001b[3Gcommit.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided views drop to\u001b[25G34\u001b[28GGB/s,\u001b[34Gso\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[2C\u001b[1Bswitching\u001b[13Gto\u001b[16Ga\u001b[18Gread-only\u001b[28Gmemmap\u001b[35Gthat\u001b[40Gcopies\u001b[47Gstraight\u001b[56Ginto\u001b[61Gthe\u001b[65Gblocked\u001b[73Glayout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[1B \u001b[3Gabout 2\u001b[11Gms per t\u001b[20Gken.\u001b[25G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses with the s"]
