[75.709, "ining limitations in NOTES.md.\u001b[39m      \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Sta\u001b[7Gting from the current \u001b[30Gta\u001b[33Ge, I'll\u001b[41Gre-profile to see where the remaining ~11 ms/token goes and look\u001b[106Gfor\u001b[110Ganything\r\u001b[1C\u001b[1B left\u001b[8Gbesides the\u001b[20Gweight-streaming\u001b[37Gfloor.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Timings\u001b[11Gare noisy, so I'm measuring components in-proces\u001b[60G wi\u001b[64Gh mi\u001b[69G-of-N. Attention cost rises with\u001b[102Gcontext\u001b[110G(12.7\r\u001b[1C\u001b[1B ms/tok\u001b[10Gn\u001b[12Gvs ~11.1\u001b[21Gat\u001b[24G~80),\u001b[30Gso\u001b[33GI'm\u001b[37Gchecking\u001b[46Gattention\u001b[56Glayouts\u001b[64Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmarking attention\u001b[26Glayouts\u001b[34Gat\u001b[37Gseveral\u001b[45Gcontext\u001b[53Glengths\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/attn2.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport time, numpy as np\u001b[31G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mrng=np.random.default_rng(0)\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mdef bench(f"]
