[154.968, "\u001b[H\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTimings\u001b[11Gare\u001b[15Gnoisy,\u001b[22Gso\u001b[25GI'm\u001b[29Gmeasuring\u001b[39Gcomponents\u001b[50Gin-process\u001b[61Gwith\u001b[66Gmin-of-N.\u001b[76GAttention\u001b[86Gcost\u001b[91Grises\u001b[97Gwith\u001b[102Gcontext\u001b[110G(12.7\r\u001b[1B \u001b[3Gms/token vs\u001b[15G~11.1 at ~80), so I'm checking a\u001b[48Gtention layouts next.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcurrent\u001b[15Gattention\u001b[25Glayout\u001b[32Gis\u001b[35Galready\u001b[43Gthe\u001b[47Gfastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[1B \u001b[3Gov\u001b[6Grhead and s\u001b[18Gar\u001b[21Gup precisely using min-of-N:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOverhead\u001b[12Gis\u001b[15Gabout\u001b[21G1.1\u001b[25Gms\u001b[28Gper\u001b[32Gtoken\u001b[38G(10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gse"]
[154.969, "ction\u001b[107Gwith\u001b[112Gan\r\u001b[1B \u001b[3Ginstrumented c\u001b[18Gpy\u001b[21Gof the\u001b[28Gfo\u001b[31Gward pass:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gmatvecs\u001b[18Gtake\u001b[23Gnearly\u001b[30Gall\u001b[34Gof\u001b[37Gthe\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[1B \u001b[3Glayer,\u001b[10Gagainst\u001b[18G17 \u00b5s benchm\u001b[31Grked alone), probably fr\u001b[56Gm a cold\u001b[65GKV cache or per-head BLAS overhead.\u001b[101GI'm testing\u001b[113Gthe\r\u001b[2C\u001b[1Bb\u001b[5Gtched v\u001b[13Griants directly inside\u001b[36Gthe live f\u001b[47Grward\u001b[53Gpass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mComparing\u001b[13Gattention\u001b[23Gvariants\u001b[32Ginside\u001b[39Greal\u001b[44Gforward\u001b[52Gloop\u001b[38;2;102;102;102m \u00b7 3s\r\u001b[1C\u001b[1B \u23bf  $ cat > prof/attn_insitu.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1B     \u001b[38;2;102;102;102m#\u001b[8GTime attention variants inside the real forward loop (cold KV cache after weight streaming).\r\u001b[5C\u001b[1Bimport\u001b[13Gsys, \u001b[20Gme\u001b[39m\u001b[K"]
