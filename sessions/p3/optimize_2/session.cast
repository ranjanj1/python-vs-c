[662.865, "\u001b[H\r\u001b[1B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStrided\u001b[11Gviews dr\u001b[20Gp to\u001b[25G34\u001b[28GGB/s,\u001b[34Gso\u001b[37Gblocks\u001b[44Gmust\u001b[49Gbe\u001b[52Gcontiguous,\u001b[64Gand\u001b[68Greorganising\u001b[81Gthe\u001b[85Gcheckpoint\u001b[96Gcosts\u001b[102Gabout\u001b[108G0.3\u001b[112Gs.\u001b[115GI'm\r\u001b[2C\u001b[1Bswitching\u001b[13Gto\u001b[16Ga\u001b[18Gread-only\u001b[28Gmemmap\u001b[35Gthat\u001b[40Gcopies\u001b[47Gstraight\u001b[56Ginto\u001b[61Gthe\u001b[65Gblocked\u001b[73Glayout,\u001b[81Gkeeping\u001b[89Gload\u001b[94Gto\u001b[97Gone\u001b[101Gpass\u001b[106Gand\u001b[110Gsaving\r\u001b[2C\u001b[1Babout 2 ms per token.\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \u001b[37G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses with the same\u001b[24Gerror\u001b[30Glevel.\u001b[37GBenchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token\u001b[13Gtime\u001b[18Gdrops\u001b[24Gabout\u001b[30G20%:\u001b[35G\u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfro"]
[662.867, "m\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[2C\u001b[1Bto ~0.37\u20130.87 s. I'll\u001b[25Gprofile\u001b[33Gthe\u001b[37Gloader\u001b[44Gto\u001b[47Gwin\u001b[51Gthat\u001b[56Gback:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gfirst\u001b[13Gcall\u001b[18Gincludes\u001b[27Gfirst-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[2C\u001b[1Beach strategy in its\u001b[24Gown\u001b[28Gprocess:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gblocked\u001b[15Gload\u001b[20Gis\u001b[23Gonly\u001b[28Gabout\u001b[34G0.10\u001b[39Gs\u001b[41Gwith\u001b[46Gmemmap\u001b[53Gand\u001b[57G0.075\u001b[63Gs\u001b[65Gwith\u001b[70Gchunked\u001b[78Greadinto,\u001b[88Gagainst\u001b[96G0.055\u001b[102Gs\u001b[104Gfor\u001b[108Gplain\r\u001b[1B \u001b[3Gfromfile,\u001b[13Gso that\u001b[21Goverhead doesn't\u001b[38Gexplain\u001b[46Gthe\u001b[50G0.37\u20130.87\u001b[60Gs\u001b[62Gseen\u001b[67Gearlier.\u001b[76GI'm\u001b[80Gmeasuring\u001b[90Gtime-to-READY\u001b[104Gdirectly\u001b[113Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command\u001b[23G\u001b[39m\u001b[K\r\u001b[5C"]
