[672.484, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[12G\u001b[22mwhile\u001b[18Ggot\u001b[22G<\u001b[24Glen(mv):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             n = self.f.readinto(mv[got:])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mif\u001b[19Gnot\u001b[23Gn:\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G     \u001b[17G   raise EOFError('checkpoint is truncated')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         \u001b[13G  \u001b[16Ggot += n\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mdef\u001b[12Gplain(self,\u001b[24G*shape):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         a = np.empty(shape, F32)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mself.fill(a)\r\u001b[1B \u001b[2m\u2502\u001b[22m      \u001b[10G  return\u001b[19Ga\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\r\u001b[1C\u001b[1B\u2502\u001b[22m     def blocked(self,\u001b[26Glead,\u001b[32Gd,\u001b[35Gn,\u001b[38Gb):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22m\"\"\"lead\u001b[20Grow-major\u001b[30G(d,\u001b[34Gn)\u001b[37Gmatrices\u001b[46G->\u001b[49Gcontiguous\u001b[60G(lead,\u001b[67Gn/b,\u001b[72Gd,\u001b[75Gb)\u001b[78Gcolumn\u001b[85Gblocks.\"\"\"\r\u001b[1B \u001b[2m\u2502\u001b[22m         nb = n // b\u001b[24G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m  \u001b[6G      out = np.empty((lead, nb, d, b), F32)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mrows\u001b[17G=\u001b[19Gmax(1,\u001b[26Gself.CHUNK\u001b[37G//\u001b[40Gn)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for l in range(lead):\r\u001b[1C\u001b[1B\u001b[2m"]
[672.485, "\u2502\u001b[16G\u001b[22mfor\u001b[20Gr\u001b[22Gin\u001b[25Grange(0,\u001b[34Gd,\u001b[37Grows):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G     \u001b[13G    \u001b[18G  k = min(rows, d - r)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8G        \u001b[17G  \u001b[20Gbuf\u001b[24G= self.scratch[:k\u001b[42G*\u001b[44Gn]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mself.fill(buf)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 out[l,\u001b[27G:,\u001b[30Gr:r\u001b[34G+\u001b[36Gk,\u001b[39G:]\u001b[42G=\u001b[44Gbuf.reshape(k,\u001b[59Gnb,\u001b[63Gb).transpose(1,\u001b[79G0,\u001b[82G2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gout\r\u001b[1B \u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m'''\u001b[8G+\u001b[10Gs[b:]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m open('run.py', 'w').write(s)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mEOF\r\u001b[1B \u001b[2m\u2502\u001b[22m grep -n \"memm\u001b[18Gp\\|def blocked\\|blocked(\" run\u001b[48Gpy | head; python3 \u001b[68Ghe\u001b[71Gk.py --tokens 64 --prompts\u001b[98G3 --\u001b[103Gpython3 run.py |\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m tail -1; python3 prof/ready.py py\u001b[38Ghon3 prof/run_v2.py;\u001b[59Gpython3\u001b[67Gprof/ready.py\u001b[81Gpython3\u001b[89Grun.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[672.486, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45G*\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
[673.499, "\u001b(B\u000f\u001b[?2004h\u001b[?1000h\u001b[?1002h\u001b[?1003h\u001b[?1006h"]
