[801.139, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[12G\u001b[22mworst\u001b[18G=\u001b[20Gmax(worst,\u001b[31Gfloat(np.abs(la\u001b[47G-\u001b[49Glb).max()));\u001b[62Garg_mismatch\u001b[75G+=\u001b[78Gint(np.argmax(la)\u001b[96G!=\u001b[99Gnp.argmax(lb))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22m#\u001b[10Gsecond\u001b[17Gcommand\u001b[25Gmust\u001b[30Gstart\u001b[36Gclean:\u001b[43Grerun\u001b[49Ga\u001b[51Gprefix\u001b[58Gafter\u001b[64Greset\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G a.reset(); b.res\u001b[25Gt()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8Gfo\u001b[11G p, t\u001b[20Genumerate(ids[:20]):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mla\u001b[15G=\u001b[17Ga.forward(t,\u001b[30Gp).copy();\u001b[41Glb\u001b[44G=\u001b[46Gb.forward(t,\u001b[59Gp);\u001b[63Gworst\u001b[69G=\u001b[71Gmax(worst,\u001b[82Gfloat(np.abs(la\u001b[98G-\u001b[100Glb).max()))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     print('%-34s positions\u001b[31G%4d\u001b[36Gmax\u001b[40G|dlogit|\u001b[49G%.2e\u001b[55Gargmax\u001b[62Gmismatches\u001b[73G%d'\u001b[77G%\u001b[79G(tag,\u001b[85Glen(ids),\u001b[95Gworst,\u001b[102Garg_mismatch))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mrng\u001b[8G=\u001b[10Gnp.random.default_rng(0)\r\u001b[1B \u001b[2m\u2502\u001b[22m ids = [1] + list(rng.integers(3, 32000, 1023))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m c\u001b[7Gpar\u001b[11G('m\u001b[15Gdel.bin', ids,\u001b[30G'r\u001b[33Gal model, 1024 random ids')\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22md"]
[801.14, "ef\u001b[8Gsynth(name,\u001b[20Gdim,\u001b[25Ghid,\u001b[30GL,\u001b[33GH,\u001b[36GKVH,\u001b[41GV,\u001b[44GS,\u001b[47Gshared):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     hs = dim // H; kv\u001b[26G=\u001b[28Gdim\u001b[32G*\u001b[34GKVH\u001b[38G//\u001b[41GH\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mparts\u001b[14G=\u001b[16G[rng.standard_normal(V\u001b[39G*\u001b[41Gdim)\u001b[46G*\u001b[48G0.5,\u001b[53G1\u001b[55G+\u001b[57G0.1\u001b[61G*\u001b[63Grng.standard_normal(L\u001b[85G*\u001b[87Gdim),\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G  rng.standard_normal(L * dim\u001b[45G* dim)\u001b[52G/\u001b[54Gnp.sqrt(dim), rng.stan\u001b[77Gard_normal(L * dim *\u001b[98Gkv) / np.sqrt(dim),\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m          \u001b[14G   rng.s\u001b[23Gandard_n\u001b[32Grmal(L * dim\u001b[45G*\u001b[47Gkv)\u001b[51G/\u001b[53Gnp.sqrt(dim),\u001b[67Grng.standard_normal(L\u001b[89G*\u001b[91Gdim\u001b[95G*\u001b[97Gdim)\u001b[102G/\u001b[104Gnp.sqrt(dim),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[17G\u001b[22m1\u001b[19G+\u001b[21G0.1\u001b[25G*\u001b[27Grng.standard_normal(L\u001b[49G*\u001b[51Gdim),\u001b[57Grng.standard_normal(L\u001b[79G*\u001b[81Gdim\u001b[85G*\u001b[87Ghid)\u001b[92G/\u001b[94Gnp.sqrt(dim),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m              rng.standard_normal(L\u001b[39G*\u001b[41Ghid\u001b[45G*\u001b[47Gdim)\u001b[52G/\u001b[54Gnp.sqrt(hid),\u001b[68Grng.standard_normal(L\u001b[90G*\u001b[92Gdim\u001b[96G*\u001b[98Ghid)\u001b[103G/"]
[801.141, "\u001b[105Gnp.sqrt(dim),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[17G\u001b[22m1\u001b[19G+\u001b[21G0.1\u001b[25G*\u001b[27Grng.standard_normal(dim),\u001b[53Gnp.zeros(S\u001b[64G*\u001b[66Ghs)]\r\u001b[1B \u001b[2m\u2502\u001b[22m     if\u001b[11Gnot shared: parts.append(rng.standard_normal(V * dim) * 0.5)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     path\u001b[13G= 'prof/synth/%s.bin' % name\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mwith\u001b[13Gopen(path,\u001b[24G'wb')\u001b[30Gas\u001b[33Gf:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         f.write(struct.pack('<7i',\u001b[39Gdim,\u001b[44Ghid,\u001b[49GL,\u001b[52GH,\u001b[55GKVH,\u001b[60GV\u001b[62Gif\u001b[65Gshared\u001b[72Gelse\u001b[77G-V,\u001b[81GS))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mf.write(np.concatenate(parts).astype('<f4').tobytes())\r\u001b[1B \u001b[2m\u2502\u001b[22m  \u001b[6G  return p\u001b[17Gth, V, S\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for arg\u001b[12G in [('gqa_unshared', 128, 384, 2,\u001b[47G8, 2, 512, 900, False),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[17G\u001b[22m('odd_dims',\u001b[30G288,\u001b[35G768,\u001b[40G3,\u001b[43G6,\u001b[46G6,\u001b[49G1000,\u001b[55G820,\u001b[60GTrue),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m              ('mqa_odd',\u001b[29G120,\u001b[34G200,\u001b[39G2,\u001b[42G4,\u001b[45G1,\u001b[48G300,\u001b[53G800,\u001b[58GFalse)]:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mpath,\u001b[14GV,\u001b[17GS\u001b[19G=\u001b[21Gsynth(*args)\r\u001b[1B \u001b[2m"]
[801.142, "\u2502\u001b[22m    \u001b[8Gcompare(p\u001b[18Gth, [1] +\u001b[28Gli\u001b[31Gt(rng.integers(3, V, S\u001b[54G- 1)), '%s (dim %d hid\u001b[77G%d H %d KV %d)' % (args[0], args[1],\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m args[2],\u001b[13Gargs[4],\u001b[22Gargs[5]))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/verify.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mParser\u001b[9Gskipped\u001b[17Ginput\u001b[23Gbetween\u001b[31Gtop-level\u001b[41Gstatements\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;"]
