[978.44, "\u001b[H\u001b[6G\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mCost rises steadily with position (8.6\u201310.0\u001b[47Gms\u001b[50Gfor\u001b[54Gv3\u001b[57Gversus\u001b[64G10.6\u201313.2\u001b[74Gms\u001b[77Gfor\u001b[81Gv2).\u001b[86GSince\u001b[92Gcheck.py\u001b[101Gonly\u001b[106Gcovers\r\u001b[2C\u001b[1Bpositions up to 25\u001b[22Gon\u001b[25Gthis\u001b[30Gmodel,\u001b[37GI'm\u001b[41Gverifying\u001b[51Gmore\u001b[56Gwidely\u001b[63Gagainst\u001b[71Gthe\u001b[75Gv1\u001b[78Gimplementation\u001b[93Gon\u001b[96Gfull\u001b[101G1,024-position\r\u001b[2C\u001b[1Blogits\u001b[10Gand\u001b[14Gsynthetic\u001b[24GGQA\u001b[28Gand\u001b[32Gunshared-classifier\u001b[52Gcheckpoints.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m All configurations match v1 with logit\u001b[42Gdifferences\u001b[54Gunder\u001b[60G2.3e-5\u001b[67Gand\u001b[71Gno\u001b[74Gargmax\u001b[81Gmismatches.\u001b[93GFusing\u001b[100Gthe\u001b[104Gprojections\u001b[116Gnow\r\u001b[1B  costs nothing extra since the loader copies everything anyway, so I'm checking whether it speeds up blocked gemv.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell comma"]
[978.441, "nd \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Fusion saves ~0.11 ms/token\u001b[31G(~1.3%).\u001b[40GIt's\u001b[45Gsmall,\u001b[52Gbut\u001b[56Git's\u001b[61Gfree\u001b[66Gat\u001b[69Gload\u001b[74Gand\u001b[78Gactually\u001b[87Gremoves\u001b[95Gcalls,\u001b[102Gso\u001b[105GI'll\u001b[110Gimplement\r\u001b[1C\u001b[1B it:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Fusion\u001b[10Gsaves\u001b[16G~0.15\u001b[22Gms/token,\u001b[32Gand\u001b[36Gcorrectness\u001b[48Gis\u001b[51Gunchanged\u001b[61Gon\u001b[64Gall\u001b[68Gmodels.\u001b[76GQuick\u001b[82Gtuning\u001b[89Gcheck\u001b[95Gof\u001b[98Gblock\u001b[104Gsize\u001b[109G(128\u001b[114Gvs\u001b[117G256\r\u001b[1C\u001b[1B vs 384) in place:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[39m Comparing column block sizes\u001b[32Gin\u001b[35Gsitu\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/blocksize.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m# In-situ forward time at position 80 / 600 for different column-block sizes (monkeypatched).\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport sys, time\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102msys.path.insert(0, '.')\u001b[39m\u001b[K\r\u001b[1C\u001b["]
