[390.701, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[12G\u001b[22mt\u001b[14G=\u001b[16Gpc()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         for _ in range(n):\u001b[31Gf()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mbest\u001b[17G=\u001b[19Gmin(best,\u001b[29G(pc()\u001b[35G-\u001b[37Gt)\u001b[40G/\u001b[42Gn)\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G return best\u001b[20G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for (d, n, L) in [(768, 768, 48), (2048,\u001b[45G768, 24), (768, 2048\u001b[67G12), (32000, 768, 1)]:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     Ws =\u001b[13G[rng.standard_normal((d,\u001b[38Gn),\u001b[42Gdtype=F)\u001b[51Gfor\u001b[55G_\u001b[57Gin\u001b[60Grange(L)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mx\u001b[10G=\u001b[12Grng.standard_normal(n,\u001b[35Gdtype=F);\u001b[45Go\u001b[47G=\u001b[49Gnp.empty(d,\u001b[61GF);\u001b[65Ggb\u001b[68G=\u001b[70Gd\u001b[72G*\u001b[74Gn\u001b[76G*\u001b[78G4\u001b[80G*\u001b[82GL\u001b[84G/\u001b[86G1e9\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     res = {'vecdot':\u001b[25Gbench(lambda:\u001b[39G[np.vecdot(W,\u001b[53Gx,\u001b[56Gout=o)\u001b[63Gfor\u001b[67GW\u001b[69Gin\u001b[72GWs])}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gb\u001b[14Gin\u001b[17G(128,\u001b[23G192,\u001b[28G256,\u001b[33G384):\r\u001b[1B \u001b[2m\u2502\u001b[22m         if n % b: continue\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   nb = n // b\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mBs\u001b[15G=\u001b[17G[np.ascontiguousarray(W.reshape(d,\u001b[52Gnb,\u001b[56G"]
[390.703, "b).transpose(1,\u001b[72G0,\u001b[75G2))\u001b[79Gfor\u001b[83GW\u001b[85Gin\u001b[88GWs]\u001b[93G#\u001b[95G(nb,\u001b[100Gd,\u001b[103Gb)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         xs = x.reshape(nb, b); tmp = np.empty((nb,\u001b[55Gd),\u001b[59GF)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mdef\u001b[16Gblk(Bs=Bs,\u001b[27Gxs=xs,\u001b[34Gtmp=tmp,\u001b[43Gnb=nb):\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G     for B i\u001b[24G Bs:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[20G\u001b[22mfor\u001b[24Gk\u001b[26Gin\u001b[29Grange(nb):\u001b[40Gnp.dot(B[k],\u001b[53Gxs[k],\u001b[60Gout=tmp[k])\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m                 np.add.reduce(tmp,\u001b[39Gaxis=0,\u001b[47Gout=o)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mdef\u001b[16Gblk_vd(Bs=Bs,\u001b[30Gxs=xs,\u001b[37Gtmp=tmp):\r\u001b[1B \u001b[2m\u2502\u001b[22m          \u001b[14G \u001b[16Gfor B in Bs:\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m          \u001b[14G   \u001b[18G  np.matmul(B,\u001b[33Gxs[:, :, None],\u001b[49Gout=tmp[:,\u001b[60G:,\u001b[63GNone]);\u001b[71Gnp.add.reduce(tmp,\u001b[90Gaxis=0,\u001b[98Gout=o)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mres['gemv\u001b[22Gb=%d'\u001b[28G%\u001b[30Gb]\u001b[33G=\u001b[35Gbench(blk)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         res['bmm b=%d'\u001b[27G%\u001b[29Gb]\u001b[32G=\u001b[34Gbench(blk_vd)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mBs[0]\u001b[18Gis\u001b[21Gnot\u001b[25GNone\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G y ="]
[390.703, " Non\u001b[20G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gf\u001b[14Gr\u001b[16Gk in r\u001b[23Gnge(nb): np.dot(Bs[0][k], xs[k], out=tmp[k])\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22merr\u001b[16G=\u001b[18Gnp.abs(tmp.sum(0,\u001b[36Gdtype=F)\u001b[45G-\u001b[47GWs[0].astype(np.float64)\u001b[72G@\u001b[74Gx.astype(np.float64)).max()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         res['err b=%d'\u001b[27G%\u001b[29Gb]\u001b[32G=\u001b[34Gerr\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint((d,\u001b[18Gn),\u001b[22G'\u001b[24G'.join(('%s\u001b[36G%.0fGB/s'\u001b[46G%\u001b[48G(k,\u001b[52Ggb\u001b[55G/\u001b[57Gv))\u001b[61Gif\u001b[64Gnot\u001b[68Gk.startswith('err')\u001b[88Gelse\u001b[93G'%s\u001b[97G%.1e'\u001b[103G%\u001b[105G(k,\u001b[109Gv)\u001b[112Gfor\u001b[116Gk,\u001b[119Gv\r\u001b[1B \u001b[2m\u2502\u001b[22m in r\u001b[9Gs.items()))\u001b[21G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/blocked.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[390.704, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
