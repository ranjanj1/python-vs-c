[700.997, "\u001b[H\r\u001b[1B\u001b[38;2;87;105;247m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[1mBash command\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1B\u001b[22m \u001b[38;2;102;102;102mSweep weighted-sum variants over context length\u001b[50G\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat"]
[700.998, " > prof/wsum_sweep.py\u001b[29G<<'EOF'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m#\u001b[6GAttention\u001b[16Gweighted\u001b[25Gsum,\u001b[30G12\u001b[33Glayers,\u001b[41Gcold\u001b[46Gcache:\u001b[53G(t,d)\u001b[59Glayout\u001b[66Gvia\u001b[70Gmatmul\u001b[77G/\u001b[79Geinsum\u001b[86Gvs\u001b[89G(d,t)\u001b[95Glayout\u001b[102Gvia\u001b[106Gvecdot.\r\u001b[1B \u001b[2m\u2502\u001b[22m import time, numpy as np\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m F\u001b[6G= np.float32;\u001b[20Gpc =\u001b[25Gtime.p\u001b[32Grf_counter;\u001b[44Grng = np.random.default_rng(0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mL,\u001b[7GH,\u001b[10Ghs,\u001b[14GS\u001b[16G=\u001b[18G12,\u001b[22G12,\u001b[26G64,\u001b[30G1024\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m junk = np.ones(64 *\u001b[24G1024\u001b[29G*\u001b[31G1024\u001b[36G//\u001b[39G4,\u001b[42GF)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mV\u001b[6G=\u001b[8Grng.standard_normal((L,\u001b[32GH,\u001b[35GS,\u001b[38Ghs),\u001b[43Gdtype=F);\u001b[53GVt\u001b[56G=\u001b[58Gnp.ascontiguousarray(V.transpose(0,\u001b[94G1,\u001b[97G3,\u001b[100G2))\r\u001b[1B \u001b[2m\u2502\u001b[22m d\u001b[6Gf timeit(fn):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8Gbest = 1e9\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gr\u001b[14Gin\u001b[17Grange(7):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         tot = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gl\u001b[18Gin\u001b[21Grange(L):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G       \u001b[15G junk.max();\u001b["]
[700.999, "28Gt = pc(); fn(l); tot += pc()\u001b[57G- t\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         best = min(best, tot)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15Gbest\u001b[20G*\u001b[22G1e3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print('   T  matmul(t,d)\u001b[30Geinsum(t,d)\u001b[43Gvecdot(d,t)')\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8GT\u001b[10Gin\u001b[13Grange(100,\u001b[24G1025,\u001b[30G100):\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G att = rng.random((H, 1, T), dtype=F); out =\u001b[52Gnp.empty((H, 1, hs), F)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     a = timeit(lambda\u001b[26Gl: np.matmul(at\u001b[42G,\u001b[44GV[l][:,\u001b[52G:T,\u001b[56G:],\u001b[60Gout=out))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mb\u001b[10G=\u001b[12Gtimeit(lambda\u001b[26Gl:\u001b[29Gnp.einsum('hqt,htd->hqd',\u001b[55Gatt,\u001b[60GV[l][:,\u001b[68G:T,\u001b[72G:],\u001b[76Gout=out))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     c = timeit(lambda\u001b[26Gl:\u001b[29Gnp.vecdot(Vt[l][:,\u001b[48GNone,\u001b[54G:,\u001b[57G:T],\u001b[62Gatt[:,\u001b[69G:,\u001b[72GNone,\u001b[78G:],\u001b[82Gout=out))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint('%4d\u001b[20G%10.3f\u001b[28G%11.3f\u001b[36G%11.3f'\u001b[44G%\u001b[46G(T,\u001b[50Ga,\u001b[53Gb,\u001b[56Gc))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 prof/wsum_sweep.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c"]
[701.0, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 prof/wsum_sweep.py\u001b[71G\u001b[22mcommands\u001b[80Gin\u001b[83G\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
