[357.914, "\u001b[H\u001b[2G\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Attention runs at 3.2 ms/token at position 999, about\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[1B  microbenchmark. I'm splitting it into scores, softmax and weighted sum next.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The weighted sum\u001b[20G(att\u001b[25G@ V) is the bo\u001b[40Gtleneck\u001b[48Gat about 17 GB/s, because V's\u001b[78G(t,\u001b[82Gd)\u001b[85Glayout\u001b[92Gforces\u001b[99Ga\u001b[101Gpoorly\u001b[108Gshaped\r\u001b[1C\u001b[1B transposed\u001b[14Ggemv. I'm storing V transposed\u001b[45Gper\u001b[49Ghead\u001b[54Gas\u001b[57G(head,\u001b[64Gd,\u001b[67Gt)\u001b[70Gso\u001b[73Git\u001b[76Gbecomes\u001b[84Gcontiguous\u001b[95Grow\u001b[99Gdot\u001b[103Gproducts,\u001b[113Gthen\r\u001b[1C\u001b[1B testing.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Transposed V cuts the weig\u001b[30Gted sum from\u001b[43G2.05 \u001b[49Go 0\u001b[53G85 ms\u001b[59Gat T=1000. It costs\u001b[79Gabout +35 \u00b5s/token at T=81,\u001b[107Ga"]
[357.915, " 0.3%\u001b[114Gloss on\r\u001b[1C\u001b[1B shor\u001b[9Gcontexts\u001b[18Gagainst\u001b[26Ga\u001b[28G~10%\u001b[33Ggain\u001b[38Gat\u001b[41Glong\u001b[46Gones,\u001b[52Gso\u001b[55GI'll\u001b[60Gtake\u001b[65Git.\u001b[69GImplementing:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mSearched for \u001b[1m1\u001b[22m pattern, ran \u001b[1m1\u001b[22m shell command \r\u001b[1C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Passes.\u001b[11GComparing\u001b[21Glong-context\u001b[34Gcost\u001b[39Gdirectly\u001b[48G(min-of-N\u001b[58Gper-token\u001b[68Gtime\u001b[73Gat\u001b[76Gpositions\u001b[86Gnear\u001b[91G1,000):\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Transposed V wins at 999\u001b[28Gbut\u001b[32Gloses\u001b[38Gat\u001b[41G300\u2013600,\u001b[50Gand\u001b[54GI\u001b[56Gsuspect\u001b[64Gthe\u001b[68G4\u001b[70GKB\u001b[73Gpower-of-two\u001b[86Grow\u001b[90Gstride\u001b[97Gis\u001b[100Gcausing\u001b[108Gcache\r\u001b[1C\u001b[1B conflicts; I'm testing padded strides\u001b[41Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Benchmarking V\u001b[18Glayout\u001b[25Gand\u001b[29Grow\u001b[33Gpadding\u001b[41Gvs\u001b[44Gcontext\u001b[52Glength\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/vstride.py <<'EOF'\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102m#"]
[357.915, " Weighted-sum cost (12 layers, cold cache) vs context length for V layouts / row padding.\r\u001b[1C\u001b[1B\u001b[39m \u001b[6G\u001b[38;2;102;102;102mimport time, numpy as np\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102mF = np.float32; pc = time.perf_counter; rng = np.random.default_rng(0)\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mL, H, hs, S = 12, 12, 64, 1024\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mjunk = np.ones(64 * 1024 * 1024 // 4, F)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mV = rng.\u2026\u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;215;119;87m\u2736\u001b[3GCascading\u2026 \u001b[38;2;102;102;102m(5m 49s \u00b7 \u2193\u001b[26G17.5k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G      \u001b[103G\u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
