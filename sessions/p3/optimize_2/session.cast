[128.658, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[22m \u001b[5G     \u001b[11G ss = one / \u001b[24Gp.sqrt(vecdot(x, x) /\u001b[46Gfdim + eps); multiply(x, ss, out=xb); multiply(rms_ffn, xb, out=xb)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22m   \u001b[12Gt6\u001b[15G=\u001b[17Gpc()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mvecdot(w1,\u001b[23Gxb,\u001b[27Gout=hb);\u001b[36Gvecdot(w3,\u001b[47Gxb,\u001b[51Gout=hb2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m   \u001b[7G     t7 = pc()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         sig = exp(np.negative(hb));\u001b[40Gs\u001b[42Gg += one; \u001b[53Gp.divide(on\u001b[65G, sig, out=sig); hb *= sig; hb *=\u001b[99Ghb2\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m        \u001b[12Gt8\u001b[15G=\u001b[17Gpc()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mvecdot(w2,\u001b[23Ghb,\u001b[27Gout=xb)\r\u001b[1B \u001b[2m\u2502\u001b[22m         t9 = pc()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mx\u001b[14G+=\u001b[17Gxb\r\u001b[1B \u001b[2m\u2502\u001b[22m         t10 = pc()\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m         for k, v in (('rmsnorm1', t1-t0), ('qkv', t2-t1), ('rope', t3-t2), ('attn', t4-t3), ('wo', t5-t4),\u001b[K\r\u001b[1B \u001b[2m\u2502\u001b[22m ('res+rmsnorm2', t6-t5), ('w1w3', t7-t6), ('swiglu', t8-t7), ('w2', t9-t8), ('res', t10-t9)):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22macc[k]\u001b[23G=\u001b[25Gacc.get(k,\u001b[36G0)\u001b[39G+\u001b[41Gv\r\u001b[1"]
[128.659, "B \u001b[2m\u2502\u001b[22m     t0 = pc()\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m    \u001b[8Gss = one / np.sqr\u001b[26G(vecdot(x,\u001b[37Gx) / fdim\u001b[47G+\u001b[49Geps);\u001b[55Gmultiply(x,\u001b[67Gss,\u001b[71Gout=x);\u001b[79Gmultiply(self.rms_final,\u001b[104Gx,\u001b[107Gout=x)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mt1\u001b[11G=\u001b[13Gpc();\u001b[19Gvecdot(self.wcls,\u001b[37Gx,\u001b[40Gout=self.logits);\u001b[58Gt2\u001b[61G=\u001b[63Gpc()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     acc['final_norm']\u001b[26G=\u001b[28Gacc.get('final_norm',\u001b[50G0)\u001b[53G+\u001b[55Gt1\u001b[58G-\u001b[60Gt0;\u001b[64Gacc['classifier']\u001b[82G=\u001b[84Gacc.get('classifier',\u001b[106G0)\u001b[109G+\u001b[111Gt2\u001b[114G-\u001b[116Gt1\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gp\u001b[10Gin\u001b[13Grange(80):\u001b[24Gm.forward(5,\u001b[37Gp)\r\u001b[1B \u001b[2m\u2502\u001b[22m best =\u001b[11GNone\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for r in range(7):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22macc\u001b[12G=\u001b[14G{}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for _ in range(30):\u001b[28Gfwd(m,\u001b[35G5,\u001b[38G80,\u001b[42Gacc)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22macc\u001b[12G=\u001b[14G{k:\u001b[18Gv\u001b[20G/\u001b[22G30\u001b[25G*\u001b[27G1e3\u001b[31Gfor\u001b[35Gk,\u001b[38Gv\u001b[40Gin\u001b[43Gacc.items()}\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G best =\u001b[16Gcc if best is None\u001b[35Ge\u001b[37Gs\u001b[39G {k: min(best[k], acc[k])\u001b[6"]
[128.66, "5Gfor k in\u001b[74Gacc}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m tot = sum(be\u001b[18G.values())\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gk,\u001b[11Gv\u001b[13Gin\u001b[16Gsorted(best.items(),\u001b[37Gkey=lambda\u001b[48Gkv:\u001b[52G-kv[1]):\u001b[61Gprint('%-14s\u001b[74G%.3f\u001b[79Gms'\u001b[83G%\u001b[85G(k,\u001b[89Gv))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m print('sum %.2f ms;\u001b[24Gnon-matmul\u001b[35G%.3f\u001b[40Gms'\u001b[44G%\u001b[46G(tot,\u001b[52Gsum(v\u001b[58Gfor\u001b[62Gk,\u001b[65Gv\u001b[67Gin\u001b[70Gbest.items()\u001b[83Gif\u001b[86Gk\u001b[88Gin\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m('rmsnorm1','rope','attn','res+rmsnorm2','swiglu','res','final_norm'))))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m py\u001b[7Ghon3 prof/sections.py\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to pr"]
[128.661, "oceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 prof/sections.py\u001b[69G\u001b[22mcommands\u001b[78Gin\u001b[81G\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
