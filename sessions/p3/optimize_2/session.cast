[177.483, "\u001b[H\r\u001b[6C\u001b[33B\u001b[38;2;245;149;117ma\u001b[10G\u001b[38;2;215;119;87mn\u001b[41G\u001b[38;2;173;173;173mthinking with high effort\u001b[39m\u001b[40;1H\u001b[38;3H"]
[177.532, "\u001b[H\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStarting from the current\u001b[29Gstate,\u001b[36GI'll\u001b[41Gre-profile\u001b[52Gto\u001b[55Gsee\u001b[59Gwhere\u001b[65Gthe\u001b[69Gremaining\u001b[79G~11\u001b[83Gms/token\u001b[92Ggoes\u001b[97Gand\u001b[101Glook\u001b[106Gfor\u001b[110Ganything\r\u001b[2C\u001b[1Bleft\u001b[8Gbesides\u001b[16Gthe\u001b[20Gweight-streaming\u001b[37Gfloor.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTimings are noisy, so\u001b[25GI'm\u001b[29Gmeasuring\u001b[39Gcomponents\u001b[50Gin-process\u001b[61Gwith\u001b[66Gmin-of-N.\u001b[76GAttention\u001b[86Gcost\u001b[91Grises\u001b[97Gwith\u001b[102Gcontext\u001b[110G(12.7\r\u001b[2C\u001b[1Bms/token\u001b[12Gvs\u001b[15G~11.1\u001b[21Gat\u001b[24G~80),\u001b[30Gso\u001b[33GI'm\u001b[37Gchecking\u001b[46Gattention\u001b[56Glayouts\u001b[64Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe current attention\u001b[25Glayout\u001b[32Gis\u001b[35Galready\u001b[43Gthe\u001b[47Gfastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[2C\u001b[1Boverhead\u001b[12Gand\u001b[16Gstartup\u001b[24Gprecisely\u001b[34Gusing\u001b[40Gmin-of-N:\r\u001b[1"]
[177.534, "B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOverhead is about 1.1\u001b[25Gms\u001b[28Gper\u001b[32Gtoken\u001b[38G(10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan\r\u001b[2C\u001b[1Binstrumented\u001b[16Gcopy\u001b[21Gof\u001b[24Gthe\u001b[28Gforward\u001b[36Gpass:\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[24G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gmatvecs\u001b[18Gtake\u001b[23Gnearly\u001b[30Gall\u001b[34Gof\u001b[37Gthe\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[1B \u001b[3Glayer, a\u001b[12Gainst 17 \u00b5s benchmarked alon\u001b[41G),\u001b[44Gprob\u001b[49Gbly from\u001b[58Ga\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-head\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[1B  batched variants directly inside the live\u001b[45Gforward\u001b[53Gpass.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b["]
[177.534, "1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention runs at 3.2\u001b[25Gms/token\u001b[34Gat\u001b[37Gposition\u001b[46G999,\u001b[51Gabout\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[2C\u001b[1Bmicrobenchmark. I'm splitting it into\u001b[41Gscores,\u001b[49Gsoftmax\u001b[57Gand\u001b[61Gweighted\u001b[70Gsum\u001b[74Gnext.\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell command\u2026\u001b[K\r\u001b[28C\u001b[2B\u001b[38;2;102;102;102m8\u001b[39m\u001b[40;1H\u001b[38;3H"]
[177.545, "\u001b[H\r\u001b[40C\u001b[33B\u001b[38;2;102;102;102mthought for 6s)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
