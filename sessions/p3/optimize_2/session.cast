[170.387, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTimings are\u001b[15Gnoisy, so I'm measuring componen\u001b[48Gs in-process with min-of-N.\u001b[76GAttention\u001b[86Gcost\u001b[91Grises\u001b[97Gwith\u001b[102Gcontext\u001b[110G(12.7\r\u001b[2C\u001b[1Bms/token\u001b[12Gvs\u001b[15G~11.1\u001b[21Gat\u001b[24G~80),\u001b[30Gso\u001b[33GI'm\u001b[37Gchecking\u001b[46Gattention\u001b[56Glayouts\u001b[64Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTh\u001b[6G current at\u001b[18Gen\u001b[21Gion layout is already the fastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[2C\u001b[1Boverhead\u001b[12Gand\u001b[16Gstartup\u001b[24Gprecisely\u001b[34Gusing\u001b[40Gmin-of-N:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOverhead is ab\u001b[18Gut\u001b[21G1.1 ms\u001b[28Gpe\u001b[31G token (10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan"]
[170.388, "\r\u001b[2C\u001b[1Binstrumented\u001b[16Gcopy\u001b[21Gof\u001b[24Gthe\u001b[28Gforward\u001b[36Gpass:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gmatvecs\u001b[18Gtake nearly \u001b[31Gll of the 10.85 ms per t\u001b[56Gken, but\u001b[65Gattention is far slower in the real\u001b[101Gloop (48 \u00b5s\u001b[113Gper\r\u001b[2C\u001b[1Bl\u001b[5Gyer, ag\u001b[13Ginst 17 \u00b5s benchmarked\u001b[36Galone), pr\u001b[47Gbably\u001b[53Gfrom a\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-head\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[2C\u001b[1Bbatched\u001b[11Gvariants\u001b[20Gdirectly\u001b[29Ginside\u001b[36Gthe\u001b[40Glive\u001b[45Gforward\u001b[53Gpass.\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B Comparing attention variants inside real\u001b[44Gforward\u001b[52Gloop\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $\u001b[8Gcat > prof/attn_insitu.py <<'EOF'\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102m# Time\u001b[13Gatten\u001b[20Gon variants inside the real forward loop (cold KV cache after weight streaming).\r\u001b[5C\u001b[1Bimport sys, time\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[38;2;102;102;102msys.path.insert(0, '.')\r\u001b[5C\u001b[1Bimport \u001b[14Gumpy as\u001b[22Gnp\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[3"]
