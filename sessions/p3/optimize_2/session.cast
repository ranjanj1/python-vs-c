[214.342, "\u001b[H\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mTimings\u001b[11Gare\u001b[15Gnoisy,\u001b[22Gso\u001b[25GI'm\u001b[29Gmeasuring\u001b[39Gcomponents\u001b[50Gin-process\u001b[61Gwith\u001b[66Gmin-of-N.\u001b[76GAttention\u001b[86Gcost\u001b[91Grises\u001b[97Gwith\u001b[102Gcontext\u001b[110G(12.7\r\u001b[2C\u001b[1Bms/token vs ~11.1 at\u001b[24G~80),\u001b[30Gso\u001b[33GI'm\u001b[37Gchecking\u001b[46Gattention\u001b[56Glayouts\u001b[64Gnext.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gcurrent\u001b[15Gattention\u001b[25Glayout\u001b[32Gis\u001b[35Galready\u001b[43Gthe\u001b[47Gfastest\u001b[55G(~52\u001b[60GGB/s\u001b[65Gat\u001b[68G1,024\u001b[74Gpositions).\u001b[86GNext\u001b[91GI'll\u001b[96Gmeasure\u001b[104Gthe\u001b[108Gnon-matmul\r\u001b[2C\u001b[1Boverhead and startup\u001b[24Gprecisely\u001b[34Gusing\u001b[40Gmin-of-N:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOverhead\u001b[12Gis\u001b[15Gabout\u001b[21G1.1\u001b[25Gms\u001b[28Gper\u001b[32Gtoken\u001b[38G(10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan\r\u001b[2C\u001b[1Binstrumented copy of\u001b[24Gthe\u001b[28Gforward\u001b[36G"]
[214.344, "pass:\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeig\u001b[8Gt matvecs take nearly all of the 10.85 ms per token,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[2C\u001b[1Blayer,\u001b[10Gagainst\u001b[18G17\u001b[21G\u00b5s\u001b[24Gbenchmarked\u001b[36Galone),\u001b[44Gprobably\u001b[53Gfrom\u001b[58Ga\u001b[60Gcold\u001b[65GKV\u001b[68Gcache\u001b[74Gor\u001b[77Gper-head\u001b[86GBLAS\u001b[91Goverhead.\u001b[101GI'm\u001b[105Gtesting\u001b[113Gthe\r\u001b[2C\u001b[1Bbatched variants directly\u001b[29Ginside\u001b[36Gthe\u001b[40Glive\u001b[45Gforward\u001b[53Gpass.\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gruns\u001b[18Gat\u001b[21G3.2\u001b[25Gms/token\u001b[34Gat\u001b[37Gposition\u001b[46G999,\u001b[51Gabout\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[1B \u001b[3Gmicrobe\u001b[11Gchmark. I'm splitting it into scores,\u001b[49Gsoftmax\u001b[57Gand\u001b[61Gweighted\u001b[70Gsum\u001b[74Gnext.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b["]
[214.345, "22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe weighted sum (att @ V)\u001b[30Gis\u001b[33Gthe\u001b[37Gbottleneck\u001b[48Gat\u001b[51Gabout\u001b[57G17\u001b[60GGB/s,\u001b[66Gbecause\u001b[74GV's\u001b[78G(t,\u001b[82Gd)\u001b[85Glayout\u001b[92Gforces\u001b[99Ga\u001b[101Gpoorly\u001b[108Gshaped\r\u001b[2C\u001b[1Btransposed gemv. I'm storing\u001b[32GV\u001b[34Gtransposed\u001b[45Gper\u001b[49Ghead\u001b[54Gas\u001b[57G(head,\u001b[64Gd,\u001b[67Gt)\u001b[70Gso\u001b[73Git\u001b[76Gbecomes\u001b[84Gcontiguous\u001b[95Grow\u001b[99Gdot\u001b[103Gproducts,\u001b[113Gthen\r\u001b[2C\u001b[1Btesting.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mRunning \u001b[1m1\u001b[22m shell\u001b[19Gcommand\u2026\r\u001b[2B\u001b[38;2;215;119;87m\u00b7\u001b[3G\u001b[38;2;245;149;117mCas\u001b[38;2;215;119;87mcading\u2026 \u001b[27G\u001b[38;2;102;102;102m3\u001b[29G0\u001b[41G\u001b[38;2;177;177;177mthinking with high effort\u001b[38;2;102;102;102m)\u001b[39m\u001b[K\u001b[40;1H\u001b[38;3H"]
