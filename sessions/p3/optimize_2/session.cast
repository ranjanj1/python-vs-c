[221.612, "\u001b[H\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mOverhead\u001b[12Gis\u001b[15Gabout\u001b[21G1.1\u001b[25Gms\u001b[28Gper\u001b[32Gtoken\u001b[38G(10%),\u001b[45Gmore\u001b[50Gthan\u001b[55Gthe\u001b[59Gearlier\u001b[67Gestimate.\u001b[77GI'll\u001b[82Gbreak\u001b[88Git\u001b[91Gdown\u001b[96Gby\u001b[99Gsection\u001b[107Gwith\u001b[112Gan\r\u001b[1B \u001b[3Ginstrumented c\u001b[18Gpy\u001b[21Gof the\u001b[28Gfo\u001b[31Gward pass:\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mWeight\u001b[10Gmatvecs\u001b[18Gtake\u001b[23Gnearly\u001b[30Gall\u001b[34Gof\u001b[37Gthe\u001b[41G10.85\u001b[47Gms\u001b[50Gper\u001b[54Gtoken,\u001b[61Gbut\u001b[65Gattention\u001b[75Gis\u001b[78Gfar\u001b[82Gslower\u001b[89Gin\u001b[92Gthe\u001b[96Greal\u001b[101Gloop\u001b[106G(48\u001b[110G\u00b5s\u001b[113Gper\r\u001b[1B \u001b[3Glayer,\u001b[10Gagainst\u001b[18G17 \u00b5s benchm\u001b[31Grked alone), probably fr\u001b[56Gm a cold\u001b[65GKV cache or per-head BLAS overhead.\u001b[101GI'm testing\u001b[113Gthe\r\u001b[2C\u001b[1Bb\u001b[5Gtched v\u001b[13Griants directly inside\u001b[36Gthe live f\u001b[47Grward\u001b[53Gpass.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b["]
[221.613, "39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mAttention\u001b[13Gruns\u001b[18Gat\u001b[21G3.2\u001b[25Gms/token\u001b[34Gat\u001b[37Gposition\u001b[46G999,\u001b[51Gabout\u001b[57G22\u001b[60GGB/s\u001b[65Gover\u001b[70Gthe\u001b[74G72\u001b[77GMB\u001b[80Gof\u001b[83GK/V,\u001b[88Gmore\u001b[93Gthan\u001b[98Gtwice\u001b[104Gthe\u001b[108Gwarm\r\u001b[1B \u001b[3Gmicrobenchmark. I'm split\u001b[29Ging it into sc\u001b[44Gres, softmax\u001b[57Gand weight\u001b[68Gd\u001b[70Gsum\u001b[74Gnext.\u001b[80G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gweighted\u001b[16Gsum\u001b[20G(att\u001b[25G@\u001b[27GV)\u001b[30Gis\u001b[33Gthe\u001b[37Gbottleneck\u001b[48Gat\u001b[51Gabout\u001b[57G17\u001b[60GGB/s,\u001b[66Gbecause\u001b[74GV's\u001b[78G(t,\u001b[82Gd)\u001b[85Glayout\u001b[92Gforces\u001b[99Ga\u001b[101Gpoorly\u001b[108Gshaped\r\u001b[1B \u001b[3Gtransposed gemv.\u001b[20GI'm storing V transpos\u001b[43Gd per he\u001b[52Gd as\u001b[57G(head, d, t) so it becomes contiguous row\u001b[99Gdot p\u001b[105Goducts, then\r\u001b[3C\u001b[1Besting.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m \u001b[3G\u001b[39mTesting\u001b[11Gtransposed\u001b[22GV\u001b[24Gcache\u001b[30Gfor\u001b[34Gweighted\u001b[43Gsum\u001b[38;2;102;102;102m \u00b7 2s\r\u001b[1C\u001b[1B \u23bf  $ cat >> prof/attn_split.py <<'EOF'\u001b[39m\u001b["]
