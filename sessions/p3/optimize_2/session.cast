[696.973, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPasses\u001b[10Gwith\u001b[15Gthe\u001b[19Gsame\u001b[24Gerror\u001b[30Glevel.\u001b[37GBenchmarking\u001b[50Gagainst\u001b[58Gv2,\u001b[62Galternating\u001b[74Gruns:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mPer-token time drops about 20%: \u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[2C\u001b[1Bto\u001b[6G~0.37\u20130.87\u001b[17Gs.\u001b[20GI'll\u001b[25Gprofile\u001b[33Gthe\u001b[37Gloader\u001b[44Gto\u001b[47Gwin\u001b[51Gthat\u001b[56Gback:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe first call includes fi\u001b[30Gst-touch\u001b[39Gpage\u001b[44Gfaults\u001b[51Gon\u001b[54Gfresh\u001b[60Gmemory,\u001b[68Gso\u001b[71Gthis\u001b[76Gcomparison\u001b[87Gneeds\u001b[93Gfresh\u001b[99Gprocesses.\u001b[110GMeasuring\r\u001b[2C\u001b[1Beach\u001b[8Gstrategy\u001b[17Gin\u001b[20Gits\u001b[24Gown\u001b[28Gprocess:\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b["]
[696.974, "22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe blocked load is only about 0.10 s with\u001b[46Gmemmap and 0.075 s with chunked readinto, aga\u001b[92Gnst 0.055 s\u001b[104Gfo\u001b[107G plain\u001b[K\r\u001b[2C\u001b[1Bfromfile,\u001b[13Gso\u001b[16Gthat\u001b[21Goverhead\u001b[30Gdoesn't\u001b[38Gexplain\u001b[46Gthe\u001b[50G0.37\u20130.87\u001b[60Gs\u001b[62Gseen\u001b[67Gearlier.\u001b[76GI'm\u001b[80Gmeasuring\u001b[90Gtime-to-READY\u001b[104Gdirectly\u001b[113Gnext.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe blocked loader adds ~37 ms to\u001b[37Gstar\u001b[42Gup\u001b[45G(0.113\u001b[52G\u2192\u001b[54G0.150\u001b[60Gs).\u001b[64GSince\u001b[70Gchunked\u001b[78G\u001b[38;2;87;105;247mreadinto\u001b[87G\u001b[39mwas\u001b[91Gfaster\u001b[98Gthan\u001b[103Gmemmap\u001b[110Gin\u001b[113Gfresh\r\u001b[2C\u001b[1Bprocesses,\u001b[14GI'll\u001b[19Gswitch\u001b[26Gthe\u001b[30Gloader\u001b[37Gto\u001b[40Git:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mStartup is now within about 20 ms of v2, and the attention weighted sum's\u001b[77Gcost\u001b[82Glooks\u001b[88Glike\u001b[93Ga\u001b[95Gprefetch\u001b[104Gproblem\u001b[112Gfrom"]
