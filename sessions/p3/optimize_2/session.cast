[701.826, "\u001b[H\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Per-token time\u001b[18Gdrops\u001b[24Gabout\u001b[30G20%:\u001b[35G\u001b[1m10.8 \u2192 8.8 ms at position 80, 13.4 \u2192 10.4 ms at 999\u001b[22m.\u001b[88GBut\u001b[92Gload\u001b[97Gwent\u001b[102Gfrom\u001b[107G~0.12\u20130.22\u001b[118Gs\r\u001b[1C\u001b[1B to ~0.37\u20130.87 s. I'll profile the loader to win that back:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The firs\u001b[12G call \u001b[19Gnclu\u001b[24Ge\u001b[26G first-touch page faults on fresh memory, so this comparison nee\u001b[91Gs fresh processes. Measuring\r\u001b[1C\u001b[1B each s\u001b[10Grategy\u001b[17Gin its ow\u001b[27G process:\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The blocked lo\u001b[18Gd is only about 0.10 \u001b[40G with m\u001b[48Gmmap\u001b[53Gand 0.075 s with chunked readinto, against 0.055 s\u001b[104Gfor\u001b[108Gplain\r\u001b[1C\u001b[1B fromfile, so that\u001b[21Goverhead\u001b[30Gdoesn't\u001b[38Gexplain\u001b[46Gthe\u001b[50G0.37\u20130.87\u001b[60Gs\u001b[62Gseen\u001b[67Gearlier.\u001b[76GI'm\u001b[80Gmeasuring\u001b[90Gtime-to-READY\u001b[104Gdirectly\u001b[113Gnext."]
[701.827, "\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The\u001b[7Gblocked loader \u001b[23Gdds ~37\u001b[31Gms\u001b[34Gto\u001b[37Gstartup\u001b[45G(0.113\u001b[52G\u2192\u001b[54G0.150\u001b[60Gs).\u001b[64GSince\u001b[70Gchunked\u001b[78G\u001b[38;2;87;105;247mreadinto\u001b[87G\u001b[39mwas\u001b[91Gfaster\u001b[98Gthan\u001b[103Gmemmap\u001b[110Gin\u001b[113Gfresh\r\u001b[1C\u001b[1B processes,\u001b[14GI'll switch the\u001b[30Gloader to it:\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1C\u001b[1B \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Sta\u001b[7Gtup is now within about 2\u001b[33G ms\u001b[37Gof\u001b[40Gv2,\u001b[44Gand\u001b[48Gthe\u001b[52Gattention\u001b[62Gweighted\u001b[71Gsum's\u001b[77Gcost\u001b[82Glooks\u001b[88Glike\u001b[93Ga\u001b[95Gprefetch\u001b[104Gproblem\u001b[112Gfrom\u001b[117Gthe\r\u001b[1C\u001b[1B strided V layout. I'\u001b[24G sweeping the candidate layouts over T with\u001b[68Ga cold cache\u001b[81Gnext.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m Sweeping\u001b[12Gweigh\u001b[18Ged-sum variants over con\u001b[43Gex\u001b[46G length\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ cat > prof/wsum_sweep.py <<'EOF'\u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[6G\u001b[38;2;102;102;102m# A"]
[701.828, "ttention weighted sum, 12 layers, cold cache: (t,d) layout via matmul / einsum vs (d,t) layout via vecdot.\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mimport time, numpy as np\r\u001b[1C\u001b[1B\u001b[39m \u001b[4G  \u001b[38;2;102;102;102mF = np.float32; pc = time.perf_counter; rng = np.random.default_rng(0)\r\u001b[1B\u001b[39m     \u001b[38;2;102;102;102mL, H, hs, S = 12, 12, 64, 1024\u001b[39m\u001b[K\r\u001b[1C\u001b[1B    \u001b[38;2;102;102;102mjunk = np.ones(64 * 1024 * \u2026\r\u001b[2B\u001b[38;2;215;119;87m\u273b\u001b[39m \u001b[38;2;215;119;87mCascading\u2026 \u001b[38;2;102;102;102m(11m 27s \u00b7 \u2193\u001b[27G38.1k tokens)\r\u001b[1B  \u23bf \u00a0Tip: Use /btw to ask a quick side question without interrupting Claude's current work\r\u001b[3C\u001b[1B\u001b[39m       \u001b[12G   \u001b[16G     \u001b[22G   \u001b[26G     \u001b[32G   \u001b[36G   \u001b[40G   \u001b[44G                          \u001b[71G        \u001b[80G  \u001b[83G                    \u001b[38;2;102;102;102m\u25cf high \u00b7 /effort\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[701.829, "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1B\u001b[38;2;102;102;102m\u276f\u00a0\u001b[39m\u001b[7m \u001b[27m\u001b[K\r\u001b[1B\u001b[38;2;138;138;138m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\r\u001b[1C\u001b[1B\u001b[39m \u001b[38;2;102;102;102m\u23f8 manual mode on \u00b7\u001b[22Gesc to interrupt\u001b[39m\u001b[40;1H\u001b[38;3H"]
