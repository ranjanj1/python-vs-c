[1095.183, "\u001b[H\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRead \u001b[1m1\u001b[22m file, ran \u001b[1m2\u001b[22m shell commands \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mFusion\u001b[10Gsaves\u001b[16G~0.15\u001b[22Gms/token,\u001b[32Gand\u001b[36Gcorrectness\u001b[48Gis\u001b[51Gunchanged\u001b[61Gon\u001b[64Gall\u001b[68Gmodels.\u001b[76GQuick\u001b[82Gtuning\u001b[89Gcheck\u001b[95Gof\u001b[98Gblock\u001b[104Gsize\u001b[109G(128\u001b[114Gvs\u001b[117G256\r\u001b[2C\u001b[1Bvs 384) in place:\u001b[K\r\u001b[2B \u001b[3G\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mBlock 128 is slightly faster (~1%), and\u001b[43G384\u001b[47Gis\u001b[50Gmuch\u001b[55Gslower,\u001b[63Gconsistent\u001b[74Gwith\u001b[79Ggemv\u001b[84Gdropping\u001b[93Goff\u001b[97Gits\u001b[101Gfast\u001b[106Gpath\u001b[111Gabove\r\u001b[2C\u001b[1B256-float\u001b[13Grows.\u001b[19GChecking\u001b[28G64\u001b[31Gand\u001b[35G192\u001b[39Gas\u001b[42Gwell:\r\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39m192 is slow only because 2048 isn't divisible by it, so W2 falls back to a single block. I'll put 128 first\u001b[111Gin\u001b[114Gthe\r\u001b[2C\u001b[1Bpreference list:\u001b[K\r\u001b[2B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[2"]
[1095.184, "2m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m Next, quantifying what's left at position 80: blocked-weight matvecs alone versus\u001b[85Gthe\u001b[89Gfull\u001b[94Gforward.\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B  \u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[39m The weight\u001b[14Gmatvecs now hit 59 GB/s, \u001b[40Gast \u001b[46Ge ~56 GB/s\u001b[57Gplain-read\u001b[68Gceiling,\u001b[77Gso\u001b[80Gthe\u001b[84Gremaining\u001b[94G~0.95\u001b[100Gms/token\u001b[109Gis\u001b[112Gmostly\r\u001b[1C\u001b[1B cache-cold attention\u001b[24Gand small NumPy calls\u001b[46Gwith little\u001b[58Gleft to gain. I'm\u001b[76Gstopping optimisation a\u001b[100Gd\u001b[102Gmoving\u001b[109Gon\u001b[112Gto\r\u001b[1C\u001b[1B end-to-end and\u001b[18Gedge-case validation.\u001b[K\r\u001b[1C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m\u23fa\u001b[39m End-to-end timing, checks, edge-case diff vs\u001b[48Gv1\u001b[K\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2; do echo \"v2: $(python3 prof/e2e.py python3 prof/run_v2.py)\"; echo \"new: $(python3 prof/e2e.py \u001b[39m\u001b[K\r\u001b[1C\u001b[1B \u001b[4G  \u001b[38;2;102;102;102mpython3 run.py)\"; done; python3 prof/ready.py python3 run.py\r\u001b[1C\u001b[1B\u001b[39m \u001b["]
