[1094.349, "\u001b[H\r\u001b[2C\u001b[3BNext, qu\u001b[12Gntifying what's left at position\u001b[45G80: blocked-weight matvecs alo\u001b[76Ge\u001b[78Gversus the full forward.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;102;102;102mRan \u001b[1m1\u001b[22m shell command \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;0;0;0m\u23fa\u001b[3G\u001b[39mThe\u001b[7Gweight\u001b[14Gmatvecs\u001b[22Gnow\u001b[26Ghit\u001b[30G59\u001b[33GGB/s,\u001b[39Gpast\u001b[44Gthe\u001b[48G~56\u001b[52GGB/s\u001b[57Gplain-read\u001b[68Gceiling,\u001b[77Gso\u001b[80Gthe\u001b[84Gremaining\u001b[94G~0.95\u001b[100Gms/token\u001b[109Gis\u001b[112Gmostly\r\u001b[1B \u001b[3Gcache-cold attention and small NumPy calls with\u001b[51Glittle left to gain. I'm\u001b[76Gstopping optimisati\u001b[96Gn\u001b[98Gand mov\u001b[106Gng\u001b[109Gon to\u001b[K\r\u001b[2C\u001b[1Bend-to-end\u001b[14Gand \u001b[19Gdge-case\u001b[28Gvalidation.\r\u001b[2B\u001b[38;2;102;102;102m\u23fa\u001b[3G\u001b[39mEnd-to-end timing, checks,\u001b[30Gedge-case\u001b[40Gdiff\u001b[45Gvs\u001b[48Gv1\r\u001b[1B\u001b[38;2;102;102;102m  \u23bf  $ for i in 1 2; do echo \"v2: $(python3 prof/e2e.py python3 prof/run_v2.py)\"; echo \"new: $(python3 prof/e2e.py \r\u001b[1B\u001b[39m \u001b[3G   \u001b[38;2;102;102;102mpython3 run.py)\"; done; python3 prof/ready.py python3 run.py\u001b[39m\u001b[K\r\u001b[2C\u001b[1B   \u001b[38;2;102;102;102mpy"]
