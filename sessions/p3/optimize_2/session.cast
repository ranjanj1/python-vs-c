[99.445, "\u2502\u001b[22m     for (wq,wk,wv,wo,w1,w3,w2)\u001b[35Gin\u001b[38GW:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mnp.vecdot(wq,x,out=o768);np.vecdot(wk,x,out=o768);np.vecdot(wv,x,out=o768);np.vecdot(wo,x,out=o768)\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G np.vecdot(w1,x,out=o2048);np.vecdot(w3,x,out=o2048);np.vecdot(w2,h,ou\u001b[82G=\u001b[84G768)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     np.vecdot(m.wcls,x,out=\u001b[32G32k)\u001b[37G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mm.reset()\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for p in range(80):\u001b[24Gm.forward(5,p)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mmt=bench(mats);\u001b[20Gft=bench(lambda:\u001b[37Gm.forward(5,80))\r\u001b[1B \u001b[2m\u2502\u001b[22m print('min: matmuls %.2f ms, forward@80 %.2\u001b[48G ms, overhead %.2f ms'%(mt,ft,ft-mt\u001b[84G)\u001b[86G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gi\u001b[10Gin\u001b[13G1\u001b[15G2;\u001b[18Gdo\u001b[21Gpython3\u001b[29Gprof/over.py\u001b[42G.\u001b[44Grun;\u001b[49Gdone\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
