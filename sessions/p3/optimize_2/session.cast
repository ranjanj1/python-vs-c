[357.833, "\u001b[H\u001b[2G\u001b[1mTip: auto mode handles these prompts for you \u2014 choose \"switch to auto mode\" below\r\u001b[1C\u001b[1B\u001b[22m\u001b[38;2;102;102;102mBenchmark V layout and row padding vs context length\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[22m cat >\u001b[10Gprof/vstride.py <<'EOF'\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m # Weighted-sum cost (12 layers,\u001b[36Gcold cache) vs context\u001b[59Glength\u001b[66Gfor\u001b[70GV\u001b[72Glayouts\u001b[80G/\u001b[82Grow\u001b[86Gpadding.\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mimport\u001b[11Gtime,\u001b[17Gnumpy\u001b[23Gas\u001b[26Gnp\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m F = np.float32; pc =\u001b[25Gtime.perf_counter;\u001b[44Grng\u001b[48G=\u001b[50Gnp.random.default_rng(0)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mL,\u001b[7GH,\u001b[10Ghs,\u001b[14GS\u001b[16G=\u001b[18G12,\u001b[22G12,\u001b[26G64,\u001b[30"]
[357.834, "G1024\r\u001b[1B \u001b[2m\u2502\u001b[22m junk = \u001b[12Gp.o\u001b[16Ges(64 * 1024 * 1024 // 4, F)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m V = rng.st\u001b[15Gndard_normal((L, H, S, hs), dtype=F)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mlayouts\u001b[12G=\u001b[14G{'matmul(t,d)':\u001b[30GNone}\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for pad in (0, 16, 32,\u001b[27G64):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mvt\u001b[11G=\u001b[13Gnp.zeros((L,\u001b[26GH,\u001b[29Ghs,\u001b[33GS\u001b[35G+\u001b[37Gpad),\u001b[43GF);\u001b[47Gvt[...,\u001b[55G:S]\u001b[59G=\u001b[61GV.transpose(0,\u001b[76G1,\u001b[79G3,\u001b[82G2);\u001b[86Glayouts['vecdot(d,t)\u001b[107Gpad%d'\u001b[114G%\u001b[116Gpad]\r\u001b[1B \u001b[2m\u2502\u001b[22m = vt\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def tim\u001b[12Git(fn):\u001b[20G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     best\u001b[13G=\u001b[15G1e9\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gr\u001b[14Gin\u001b[17Grange(7):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         tot = 0\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mfor\u001b[16Gl\u001b[18Gin\u001b[21Grange(L):\r\u001b[1B \u001b[2m\u2502\u001b[22m          \u001b[14G \u001b[16Gj\u001b[18Gnk.max(); t = pc();\u001b[39Gn(l); tot += pc() -\u001b[59Gt\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G   b\u001b[14Gs\u001b[16G = min(best, tot)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mreturn\u001b[15Gbest\u001b[20G*\u001b[22G1e3\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m for T in (100, 300, 600, 800"]
[357.835, ", 999):\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22matt\u001b[12G=\u001b[14Grng.random((H,\u001b[29G1,\u001b[32GT),\u001b[36Gdtype=F);\u001b[46Gout\u001b[50G=\u001b[52Gnp.empty((H,\u001b[65G1,\u001b[68Ghs),\u001b[73GF)\r\u001b[1B \u001b[2m\u2502\u001b[22m     res = {}\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mfor\u001b[12Gk,\u001b[15Gvt\u001b[18Gin\u001b[21Glayouts.items():\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         if vt is None:\u001b[27Gres[k]\u001b[34G=\u001b[36Gtimeit(lambda\u001b[50Gl:\u001b[53Gnp.matmul(att,\u001b[68GV[l][:,\u001b[76G:T,\u001b[80G:],\u001b[84Gout=out))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22melse:\u001b[18Gres[k]\u001b[25G=\u001b[27Gtimeit(lambda\u001b[41Gl,\u001b[44Gvt=vt:\u001b[51Gnp.vecdot(vt[l][:,\u001b[70GNone,\u001b[76G:,\u001b[79G:T],\u001b[84Gatt[:,\u001b[91G:,\u001b[94GNone,\u001b[100G:],\u001b[104Gout=out))\r\u001b[1B \u001b[2m\u2502\u001b[22m     \u001b[9Grint('T=%4d\u001b[21G' % T + ' '.join('%s %.3f' %\u001b[50Gkv for kv in res.items()))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gprof/vstride.py\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[357.835, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39mContains\u001b[11Gbrace\u001b[17Gwith\u001b[22Gquote\u001b[28Gcharacter\u001b[38G(expansion\u001b[49Gobfuscation)\r\u001b[1B\u001b[K\r\u001b[1B Do you want to proceed?\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;87;105;247m\u276f\u001b[4G\u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\r\u001b[1B\u001b[39m   \u001b[38;2;102;102;102m2. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[36;2H"]
