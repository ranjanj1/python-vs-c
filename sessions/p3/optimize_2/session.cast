[1094.35, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1C\u001b[1B\u001b[39m\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gi\u001b[10Gin\u001b[13G1\u001b[15G2;\u001b[18Gdo\u001b[21Gecho\u001b[26G\"v2:\u001b[32G$(python3\u001b[42Gprof/e2e.py\u001b[54Gpython3\u001b[62Gprof/run_v2.py)\";\u001b[80Gecho\u001b[85G\"new:\u001b[91G$(python3\u001b[101Gprof/e2e.py\u001b[113Gpython3\r\u001b[1B \u001b[2m\u2502\u001b[22m run.py)\"; done; python3\u001b[28Gprof/ready.py python3 run.py\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mpython3\u001b[12Gcheck.py\u001b[21G--\u001b[24Gpython3\u001b[32Grun.py\u001b[39G|\u001b[41Gtail\u001b[46G-1;\u001b[50Gpython3\u001b[58Gcheck.py\u001b[67G--tokens\u001b[76G64\u001b[79G--prompts\u001b[89G3\u001b[91G--\u001b[94Gpython3\u001b[102Grun.py\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m printf 'PIECE 1 9038\\nPIECE\u001b[32G9038\u001b[37G3\\nPIECE\u001b[46G5\u001b[48G13\\nFIXED\u001b[58G1\u001b[60G9038\u001b[65G2501\\nFIXED\\nGENERATE\u001b[87G0\u001b[89Ghi\\nGENERATE\u001b[102G5\u001b[104G\\nENCODE\\nENCODE\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[5G\u001b[22mleading\u001b[13Gspace\\nQUIT\\n'\u001b[28G|\u001b[30Gpython3\u001b[38Grun.py\u001b[45Gmodel.bin\u001b[55Gtokenizer.bin\u001b[69G>\u001b[71Gprof/edge_new.txt;\u001b[90Gecho\u001b[95G\"exit\u001b[101G$?\"\r\u001b[1B \u001b[2m\u2502\u001b[22m printf 'PIECE 1 9038\\nPIECE 9038 3"]
