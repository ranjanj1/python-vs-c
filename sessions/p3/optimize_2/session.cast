[4.672, "\u001b[H\u001b[3G  \u001b[6Gper-token work fell from about\u001b[37G1.1\u001b[41Gms to 0.5 m\u001b[53G, and everything\u001b[70Gstay\u001b[76Gfloat32.\u001b[85G\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6GThe tokenizer's merge step now\u001b[37Gpicks\u001b[43Gmerges\u001b[50Gfrom\u001b[55Ga\u001b[57Gpriority\u001b[66Gqueue,\u001b[73Gin\u001b[76Gexactly\u001b[84Gthe\u001b[88Gorder\u001b[94Gthe\u001b[98Greference\u001b[108Gloop\u001b[113Gpicks\r\u001b[2C\u001b[1B  \u001b[6Gthem.\u001b[12GIt gave \u001b[21Gdentical token ids\u001b[40Gon 3,009 \u001b[50Gest\u001b[54Ginputs. A 1,021-token prompt now encodes in\u001b[98G4.8 ms instead of 770\r\u001b[5C\u001b[1Bms.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BOver the full command protocol (best of\u001b[43G2 \u001b[46Gun\u001b[49G), the total went from 22.9 s to 18.7 s. The\u001b[94G1,021-tok\u001b[105G prompt\u001b[113Grun\u001b[K\r\u001b[2C\u001b[1Bdropp\u001b[9Gd from 16.3 s to 13.0 s.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mNot done\r\u001b[2C\u001b[1B\u001b[22m- \u001b[1mCombining weight matrices:\u001b[22m merging\u001b[40GQ/K/V a\u001b[48Gd W1/W3\u001b[56Gin\u001b[59Go single calls saves \u001b[81Gnly about 0.3 ms per token. It wo\u001b[115Gld\r\u001b[2C\u001b[1B  need about\u001b[16G270 MB\u001b[23Gof\u001b[26Gcopying\u001b[34Gat\u001b[37Gload,\u001b[43Gwhich\u001b[49Gloses\u001b[55Gon\u001b[58Gshort\u001b[64Gruns.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mTransposed weights:"]
[4.674, "\u001b[25G\u001b[22msimilar\u001b[33Gspeed,\u001b[40Gbut\u001b[44G5\u20137\u00d7\u001b[49Gmore\u001b[54Grounding\u001b[63Gerror.\r\u001b[2C\u001b[1B- \u001b[1mProcessing the whole prompt at once:\u001b[42G\u001b[22mreading\u001b[50Gthe\u001b[54Gweights\u001b[62Gonce\u001b[67Gper\u001b[71Gprompt\u001b[78Ginstead\u001b[86Gof\u001b[89Gonce\u001b[94Gper\u001b[98Gtoken\u001b[104Gwould\u001b[110Gbe\u001b[113Gmuch\r\u001b[2C\u001b[1B \u001b[5Gfaster. I didn't do it because the\u001b[40Grules\u001b[46Grequire batch size 1 and the refere\u001b[82Gce's cache-filling order. If you read\r\u001b[4C\u001b[1Bth\u001b[8G rules differently, that is the main remaining\u001b[55Gspeedup;\u001b[64Git'\u001b[68G your\u001b[74Gcall.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mLimitations\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe speed\u001b[15Gis \u001b[19Gow\u001b[22Gset by memory: about 10.4 ms p\u001b[53Gr token go\u001b[64Gs to reading the weights at around 42 GB/s\u001b[109G found\u001b[K\r\u001b[4C\u001b[1Bnothing in NumPy that reads\u001b[33Gthem faster.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5GThe\u001b[9Gmachine\u001b[17Ggot\u001b[21Gnoisy\u001b[27Gduring\u001b[34Gthis\u001b[39Ground,\u001b[46Gwith\u001b[51Grun-to-run\u001b[62Gswings\u001b[69Gof\u001b[72Gup\u001b[75Gto\u001b[78G\u00b130%.\u001b[84GThe\u001b[88Gfigures\u001b[96Gabove\u001b[102Gare\u001b[106Gbest-of\u001b[114Gruns\u001b[119Gor\r\u001b[2C\u001b[1B  old and new\u001b[17Gruns\u001b[22Galternated"]
