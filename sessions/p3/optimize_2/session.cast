[218.371, "1B\u001b[2m\u2502\u001b[20G\u001b[22mjunk.max();\u001b[32Gt\u001b[34G=\u001b[36Gpc();\u001b[42Gfn(l);\u001b[49Gtot\u001b[53G+=\u001b[56Gpc()\u001b[61G-\u001b[63Gt\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             best = min(best,\u001b[33Gtot)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mreturn\u001b[19Gbest\u001b[24G*\u001b[26G1e3\r\u001b[1B \u001b[2m\u2502\u001b[22m     a = timeit(lambda l: np.matmul(at\u001b[42G, m.value_cache[l][:, :T, :], out=out))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b[9G = timeit(la\u001b[22Gbda l: np.vecdot(vt[l][:, :, :T], att,\u001b[61Gout=out2))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mc\u001b[10G=\u001b[12Gtimeit(lambda\u001b[26Gl:\u001b[29Gnp.matmul(vt[l][:,\u001b[48G:,\u001b[51G:T],\u001b[56Gatt.transpose(0,\u001b[73G2,\u001b[76G1),\u001b[80Gout=out.transpose(0,\u001b[101G2,\u001b[104G1)))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     np.matmul(att, m.value_cache[5][:,\u001b[43G:T,\u001b[47G:],\u001b[51Gout=out);\u001b[61Gnp.vecdot(vt[5][:,\u001b[80G:,\u001b[83G:T],\u001b[88Gatt,\u001b[93Gout=out2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22mprint('T=%d\u001b[20Gwsum\u001b[25Gmatmul(t,d)\u001b[37G%.3f\u001b[42Gms\u001b[45G|\u001b[47Gvecdot\u001b[54Gon\u001b[57G(d,t)\u001b[63G%.3f\u001b[68Gms\u001b[71G|\u001b[73Gmatmul\u001b[80Gon\u001b[83G(d,t)\u001b[89G%.3f\u001b[94Gms\u001b[97G|\u001b[99Gmaxdiff\u001b[107G%.2e'\u001b[113G%\u001b[115G(T,\r\u001b[1B \u001b[2m\u2502\u001b[22m a,\u001b[7Gb, c, np.abs(ou\u001b[23G[:,\u001b[27G0]\u001b"]
[218.373, "[30G- out2).max()))\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m py\u001b[7Ghon3\u001b[12Gprof/attn_split.py\u001b[31G|\u001b[33Gsed\u001b[37G-n\u001b[40G'/transposed/,$p'\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[26G\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon\u2019t\u001b[22Gask\u001b[26Gagain\u001b[32Gfor:\u001b[37Gpython3\u001b[45Gprof/attn_split.py\r\u001b[1B   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEs"]
