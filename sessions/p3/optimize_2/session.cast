[632.19, "\u001b[H\u001b[2G\u001b[2m\u2502\u001b[4G\u001b[22mpath\u001b[9G=\u001b[11G'model.bin'\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdim,\u001b[9Ghid,\u001b[14GL,\u001b[17GH,\u001b[20GKVH,\u001b[25GV,\u001b[28GS\u001b[30G=\u001b[32Gstruct.unpack('<7i',\u001b[53Gopen(path,\u001b[64G'rb').read(28));\u001b[81GV\u001b[83G=\u001b[85Gabs(V)\r\u001b[1B \u001b[2m\u2502\u001b[22m mats =\u001b[11G[('emb', 1, V, \u001b[27Gim)] + [('rm\u001b[40G', 0, L, dim)] + [(k, 1, L * a, b) for\u001b[79Gk, a, b in (('wq', dim, dim), ('wk\u001b[114G,\u001b[116Gdim,\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m dim), ('wv', dim,\u001b[22Gdim), ('w\u001b[32G', dim, dim))]\u001b[47G+ [('rms', 0, L,\u001b[64Gdim), ('w1', 1, L * hi\u001b[87G, dim),\u001b[95G('w2',\u001b[102G1,\u001b[105GL\u001b[107G*\u001b[109Gdim,\u001b[114Ghid),\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22m('w3',\u001b[11G1,\u001b[14GL\u001b[16G*\u001b[18Ghid,\u001b[23Gdim)]\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m def A():  # memmap +\u001b[25Gascontiguousarray\u001b[43Gof\u001b[46Ga\u001b[48Gmoved-axis\u001b[59Gview\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[8G\u001b[22md\u001b[10G=\u001b[12Gnp.memmap(path,\u001b[28Gdtype='<f4',\u001b[41Gmode='r',\u001b[51Goffset=28);\u001b[63Goff\u001b[67G=\u001b[69G0;\u001b[72Gout\u001b[76G=\u001b[78G[]\r\u001b[1B \u001b[2m\u2502\u001b[22m     for name, blk, r,\u001b[26Gc in mats:\u001b[37G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         v\u001b[14G= d[off:off +\u001b[28Gr * c].reshape(r,\u001b[46Gc); off += r * c"]
[632.191, "\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout.append(blocked(v,\u001b[34Gblock_size(c))\u001b[49Gif\u001b[52Gblk\u001b[56Gelse\u001b[61Gnp.array(v))\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     return out\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mdef\u001b[8GB():\u001b[14G#\u001b[16Gsequential\u001b[27Greadinto\u001b[36Gof\u001b[39G~4\u001b[42GMB\u001b[45Gchunks\u001b[52Ginto\u001b[57Ga\u001b[59Gscratch\u001b[67Gbuffer,\u001b[75Gthen\u001b[80Gcopy\u001b[85Ginto\u001b[90Gthe\u001b[94Gblocked\u001b[102Gdestination\r\u001b[1B \u001b[2m\u2502\u001b[22m   \u001b[7G out = []; f = open(path, 'rb', bu\u001b[42Gfering=0);\u001b[53Gf.seek(28)\u001b[64G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     scratch = np.empty(4 * 1024 * 1024\u001b[43G// 4, F)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     for\u001b[12Gname,\u001b[18Gblk,\u001b[23Gr,\u001b[26Gc\u001b[28Gin\u001b[31Gmats:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mif\u001b[15Gnot\u001b[19Gblk:\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             a = np.empty((r,\u001b[33Gc),\u001b[37GF);\u001b[41Gf.readinto(a);\u001b[56Gout.append(a);\u001b[71Gcontinue\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mb\u001b[14G=\u001b[16Gblock_size(c);\u001b[31Gnb\u001b[34G=\u001b[36Gc\u001b[38G//\u001b[41Gb\r\u001b[1B \u001b[2m\u2502\u001b[22m       \u001b[11G d\u001b[14Gst\u001b[17G= n\u001b[21G.empty((nb, r, b), F)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m         rows = m\u001b[21Gx(1, scratch.size // c)\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     \u001b["]
[632.192, "9G \u001b[11G for i\u001b[18Gin range(0,\u001b[30Gr,\u001b[33Grows):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[16G\u001b[22mn\u001b[18G=\u001b[20Gmin(rows,\u001b[30Gr\u001b[32G-\u001b[34Gi);\u001b[38Gbuf\u001b[42G=\u001b[44Gscratch[:n\u001b[55G*\u001b[57Gc];\u001b[61Gf.readinto(buf)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m             dest[:, i:i + n, :] =\u001b[38Gbuf.reshape(n,\u001b[53Gnb,\u001b[57Gb).transpose(1,\u001b[73G0,\u001b[76G2)\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[12G\u001b[22mout.append(dest)\r\u001b[1B \u001b[2m\u2502\u001b[22m     return\u001b[15Gout\u001b[19G\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mfor\u001b[8Gname,\u001b[14Gfn\u001b[17Gin\u001b[20G(('A\u001b[25Gmemmap+copy',\u001b[39GA),\u001b[43G('B\u001b[47Greadinto\u001b[56Gchunks',\u001b[65GB),\u001b[69G('A\u001b[73Gmemmap+copy',\u001b[87GA),\u001b[91G('B\u001b[95Greadinto\u001b[104Gchunks',\u001b[113GB)):\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m     t = pc(); r = fn();\u001b[28Gprint('%-18s\u001b[41G%.3fs'\u001b[48G%\u001b[50G(name,\u001b[57Gpc()\u001b[62G-\u001b[64Gt));\u001b[69Gdel\u001b[73Gr\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[4G\u001b[22mt\u001b[6G=\u001b[8Gpc();\u001b[14Ga\u001b[16G=\u001b[18Gnp.fromfile(path,\u001b[36Gdtype=F,\u001b[45Goffset=28);\u001b[57Gprint('plain\u001b[70Gfromfile\u001b[83G%.3fs'\u001b[90G%\u001b[92G(pc()\u001b[98G-\u001b[100Gt))\r\u001b[1B \u001b[2m\u2502\u001b[22m EOF\u001b[K\r\u001b[1C\u001b[1B\u001b[2m\u2502\u001b[22m python3 prof/load.py\u001b[25G\u001b[K\r\u001b[1B\u001b[38;2;175;175;175m\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c"]
[632.193, "\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\u254c\r\u001b[1B\u001b[39m This command requires approval\r\u001b[2B Do you want to proceed?\u001b[K\r\u001b[1B \u001b[38;2;87;105;247m\u276f\u001b[39m \u001b[38;2;102;102;102m1. \u001b[38;2;87;105;247mYes\u001b[39m\u001b[K\r\u001b[3C\u001b[1B\u001b[38;2;102;102;102m2. \u001b[39mYes,\u001b[12Gand\u001b[16Gdon't\u001b[22Gask\u001b[26Gagain\u001b[32Gfor\u001b[36G\u001b[1mcat\u001b[40G\u001b[22mand\u001b[44G\u001b[1mpython3 prof/load.py\u001b[65G\u001b[22mcommands\u001b[74Gin\u001b[77G\u001b[1m/Users/agentlab/pvc/p3\r\u001b[1B\u001b[22m   \u001b[38;2;102;102;102m3. \u001b[39mYes, and switch to auto mode\u001b[38;2;102;102;102m \u00b7 auto mode handles these prompts for you\u001b[39m\u001b[K\r\u001b[1B   \u001b[38;2;102;102;102m4. \u001b[39mNo\r\u001b[1B\u001b[K\r\u001b[1C\u001b[1B\u001b[38;2;102;102;102mEsc to cancel \u00b7 Tab\u001b[22Gto amend\u001b[39m\u001b[K\u001b[40;1H\u001b[35;2H"]
